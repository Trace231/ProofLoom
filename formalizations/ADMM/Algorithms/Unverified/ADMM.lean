import Mathlib.Analysis.Convex.Basic
import Mathlib.Analysis.InnerProductSpace.PiL2
import Mathlib.Data.Finset.Basic
import Mathlib.Order.Filter.Extr
import Mathlib.Topology.Algebra.Module.Basic
import SOptLib.Glue.Algebra
import SOptLib.Layer0.ConvexFOC

/-!
Phase 0 object model for FOML Section 3.7, Theorem 3.10.

The source algorithm is deterministic ADMM for
`min { f x + g y : x in X, y in Y, A x + B y = b }`.
The update rules (3.7.2)--(3.7.4) are modeled by an explicit generated-sequence
object carrying the two subproblem minimization properties and multiplier
recurrence, avoiding any hidden minimizer-existence theorem not stated by the source.
-/

noncomputable section

namespace ADMM

open scoped BigOperators

abbrev XSpace (p : ℕ) := EuclideanSpace ℝ (Fin p)
abbrev YSpace (q : ℕ) := EuclideanSpace ℝ (Fin q)
abbrev MSpace (m : ℕ) := EuclideanSpace ℝ (Fin m)

/-- Source.json `setup.problem`: `min_{x in X, y in Y} { f(x)+g(y): Ax+By=b }`. -/
structure Setup (p q m : ℕ) where
  /-- Source.json `assumptions.convex_problem_class`: functions in the linearly constrained
  convex problem. -/
  f : XSpace p → ℝ
  g : YSpace q → ℝ
  /-- Source.json `setup.variable_space`: `X subset R^p`, `Y subset R^q`. -/
  X : Set (XSpace p)
  Y : Set (YSpace q)
  /-- Source.json `assumptions.closed_convex_sets`: `X` and `Y` are closed convex sets. -/
  convex_X : Convex ℝ X
  convex_Y : Convex ℝ Y
  closed_X : IsClosed X
  closed_Y : IsClosed Y
  /-- Source.json `assumptions.convex_problem_class`: the objective is convex over the
  displayed domains. -/
  convexOn_f : ConvexOn ℝ X f
  convexOn_g : ConvexOn ℝ Y g
  /-- Source.json `assumptions.linear_data`: `A`, `B`, and `b` are the linear constraint data. -/
  A : XSpace p →ₗ[ℝ] MSpace m
  B : YSpace q →ₗ[ℝ] MSpace m
  b : MSpace m
  /-- Source.json `assumptions.penalty_positive`: ADMM uses penalty parameter `rho > 0`. -/
  rho : ℝ
  rho_pos : 0 < rho
  /-- Source.json `algorithm_spec.initialization`: `(y_0, lambda_0) in Y x R^m`. -/
  y0 : {y : YSpace q // y ∈ Y}
  lambda0 : MSpace m
  /-- Source.json `assumptions.primal_dual_solution_exists`: an optimal solution
  `(x^*, y^*)` and associated multiplier `lambda^*` exist. -/
  xStar : {x : XSpace p // x ∈ X}
  yStar : {y : YSpace q // y ∈ Y}
  lambdaStar : MSpace m
  star_feasible : A xStar + B yStar = b
  star_primal_optimal :
    ∀ x ∈ X, ∀ y ∈ Y, A x + B y = b → f xStar + g yStar ≤ f x + g y
  star_lagrange_multiplier :
    ∀ x ∈ X, ∀ y ∈ Y,
      f xStar + g yStar + inner ℝ lambdaStar (A xStar + B yStar - b) ≤
        f x + g y + inner ℝ lambdaStar (A x + B y - b)

variable {p q m : ℕ}

/-- Source.json `setup.problem`, constraint residual `Ax + By - b` for (3.7.1). -/
def residual (S : Setup p q m) (x : XSpace p) (y : YSpace q) : MSpace m :=
  S.A x + S.B y - S.b

/-- Source.json `setup.problem`, objective `f(x) + g(y)` in (3.7.1). -/
def objective (S : Setup p q m) (x : XSpace p) (y : YSpace q) : ℝ :=
  S.f x + S.g y

/-- Augmented Lagrangian penalty term used in Source.json `algorithm_spec.steps[0..1]`. -/
def augmentedTerm (S : Setup p q m) (lambda : MSpace m) (r : MSpace m) : ℝ :=
  inner ℝ lambda r + (S.rho / 2) * ‖r‖ ^ 2

/-- Source.json `algorithm_spec.steps[0]`, the objective minimized in (3.7.2). -/
def xSubproblemObjective (S : Setup p q m) (yPrev : YSpace q) (lambdaPrev : MSpace m)
    (x : XSpace p) : ℝ :=
  S.f x + augmentedTerm S lambdaPrev (residual S x yPrev)

/-- Source.json `algorithm_spec.steps[1]`, the objective minimized in (3.7.3). -/
def ySubproblemObjective (S : Setup p q m) (xCur : XSpace p) (lambdaPrev : MSpace m)
    (y : YSpace q) : ℝ :=
  S.g y + augmentedTerm S lambdaPrev (residual S xCur y)

structure State (S : Setup p q m) where
  y : {y : YSpace q // y ∈ S.Y}
  lambda : MSpace m

structure Iterate (S : Setup p q m) where
  x : {x : XSpace p // x ∈ S.X}
  y : {y : YSpace q // y ∈ S.Y}
  lambda : MSpace m

def initialState (S : Setup p q m) : State S where
  y := S.y0
  lambda := S.lambda0

/-- Source.json `algorithm_spec.steps[2]`, equation (3.7.4):
`lambda_t = lambda_{t-1} + rho (A x_t + B y_t - b)`. -/
def multiplierUpdate (S : Setup p q m) (lambdaPrev : MSpace m)
    (xCur : XSpace p) (yCur : YSpace q) : MSpace m :=
  lambdaPrev + S.rho • residual S xCur yCur

def Iterate.toState {S : Setup p q m} (z : Iterate S) : State S where
  y := z.y
  lambda := z.lambda

/-- Source.json `main_theorem.statement_math`: "`z_t`, `t = 1, ..., k`, be the sequence
generated by ADMM".  This records the source semantics directly instead of totalizing
the argmin subproblems from unstated global solvability assumptions.  The index `n`
represents the paper iteration `t = n + 1`; `state n` is `(y_{t-1}, lambda_{t-1})`. -/
structure GeneratedSequence (S : Setup p q m) where
  state : ℕ → State S
  iterate : ℕ → Iterate S
  initial_state : state 0 = initialState S
  x_minimizes :
    ∀ n : ℕ,
      IsMinOn (xSubproblemObjective S (state n).y (state n).lambda) S.X (iterate n).x
  y_minimizes :
    ∀ n : ℕ,
      IsMinOn (ySubproblemObjective S (iterate n).x (state n).lambda) S.Y (iterate n).y
  lambda_update :
    ∀ n : ℕ,
      (iterate n).lambda =
        multiplierUpdate S (state n).lambda (iterate n).x (iterate n).y
  state_succ :
    ∀ n : ℕ, state (n + 1) = (iterate n).toState

/-- Equation (3.7.2) as the x-subproblem minimization property of a generated sequence. -/
theorem iterate_x_update (S : Setup p q m) (R : GeneratedSequence S) (n : ℕ) :
    IsMinOn (xSubproblemObjective S (R.state n).y (R.state n).lambda) S.X
      (R.iterate n).x :=
  R.x_minimizes n

/-- Equation (3.7.3) as the y-subproblem minimization property of a generated sequence. -/
theorem iterate_y_update (S : Setup p q m) (R : GeneratedSequence S) (n : ℕ) :
    IsMinOn (ySubproblemObjective S (R.iterate n).x (R.state n).lambda) S.Y
      (R.iterate n).y :=
  R.y_minimizes n

/-- Equation (3.7.4) as the multiplier recurrence of a generated sequence. -/
theorem iterate_multiplier_update (S : Setup p q m) (R : GeneratedSequence S) (n : ℕ) :
    (R.iterate n).lambda =
      (R.state n).lambda + S.rho • residual S (R.iterate n).x (R.iterate n).y := by
  simpa [multiplierUpdate] using R.lambda_update n

theorem generated_initial_state (S : Setup p q m) (R : GeneratedSequence S) :
    R.state 0 = initialState S :=
  R.initial_state

theorem generated_state_succ (S : Setup p q m) (R : GeneratedSequence S) (n : ℕ) :
    R.state (n + 1) = (R.iterate n).toState :=
  R.state_succ n

/-- Source.json `algorithm_spec.definitions.iterate_tuple`: `z_t = (x_t, y_t, lambda_t)`.
The primal coordinates are domain points, matching `x in X` and `y in Y` in (3.7.1). -/
structure Point (S : Setup p q m) where
  x : {x : XSpace p // x ∈ S.X}
  y : {y : YSpace q // y ∈ S.Y}
  lambda : MSpace m

def Iterate.toPoint {S : Setup p q m} (z : Iterate S) : Point S where
  x := z.x
  y := z.y
  lambda := z.lambda

def starPoint (S : Setup p q m) : Point S where
  x := S.xStar
  y := S.yStar
  lambda := S.lambdaStar

/-- Source.json `algorithm_spec.definitions.primal_dual_gap_Q`, equation (3.7.5). -/
def gap (S : Setup p q m) (zt z : Point S) : ℝ :=
  S.f zt.x + S.g zt.y + inner ℝ z.lambda (residual S zt.x zt.y) -
    (S.f z.x + S.g z.y + inner ℝ zt.lambda (residual S z.x z.y))

def averageX (S : Setup p q m) (R : GeneratedSequence S) (k : ℕ) : XSpace p :=
  (1 / (k : ℝ)) • ∑ i : Fin k, ((R.iterate i.1).x : XSpace p)

def averageY (S : Setup p q m) (R : GeneratedSequence S) (k : ℕ) : YSpace q :=
  (1 / (k : ℝ)) • ∑ i : Fin k, ((R.iterate i.1).y : YSpace q)

def averageLambda (S : Setup p q m) (R : GeneratedSequence S) (k : ℕ) : MSpace m :=
  (1 / (k : ℝ)) • ∑ i : Fin k, (R.iterate i.1).lambda

/-- Convexity bridge for the source output `bar x_k`.
Source.json `algorithm_spec.output` defines the uniform average of ADMM iterates; membership
in `X` is derived from convexity of `X` and iterate membership. -/
theorem averageX_mem (S : Setup p q m) (R : GeneratedSequence S) (k : ℕ) (hk : 0 < k) :
    averageX S R k ∈ S.X := by
  classical
  unfold averageX
  rw [Finset.smul_sum]
  refine S.convex_X.sum_mem ?h_nonneg ?h_sum ?h_mem
  · intro i hi
    positivity
  · simp [Finset.sum_const, Fintype.card_fin]
    field_simp [show (k : ℝ) ≠ 0 by exact_mod_cast (ne_of_gt hk)]
  · intro i hi
    exact (R.iterate i.1).x.property

/-- Convexity bridge for the source output `bar y_k`.
Source.json `algorithm_spec.output` defines the uniform average of ADMM iterates; membership
in `Y` is derived from convexity of `Y` and iterate membership. -/
theorem averageY_mem (S : Setup p q m) (R : GeneratedSequence S) (k : ℕ) (hk : 0 < k) :
    averageY S R k ∈ S.Y := by
  classical
  unfold averageY
  rw [Finset.smul_sum]
  refine S.convex_Y.sum_mem ?h_nonneg ?h_sum ?h_mem
  · intro i hi
    positivity
  · simp [Finset.sum_const, Fintype.card_fin]
    field_simp [show (k : ℝ) ≠ 0 by exact_mod_cast (ne_of_gt hk)]
  · intro i hi
    exact (R.iterate i.1).y.property

/-- Source.json `algorithm_spec.output`: `bar z_k = sum_{t=1}^k z_t / k`.
For the paper-facing output, `hk : 0 < k` supplies the nonempty average and the primal
coordinates are returned as domain points. -/
def averagePoint (S : Setup p q m) (R : GeneratedSequence S) (k : ℕ) (hk : 0 < k) :
    Point S where
  x := ⟨averageX S R k, averageX_mem S R k hk⟩
  y := ⟨averageY S R k, averageY_mem S R k hk⟩
  lambda := averageLambda S R k

private theorem smooth_augmented_argmin_variational_inequality
    {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F]
    {X : Set E} {h : E → ℝ}
    (hconv : ConvexOn ℝ X h) (L : E →ₗ[ℝ] F) (c lambda : F)
    {rho : ℝ} (hrho : 0 < rho) (z u : {x : E // x ∈ X})
    (hmin :
      IsMinOn
        (fun v : E =>
          h v + inner ℝ lambda (L v + c) + (rho / 2) * ‖L v + c‖ ^ 2)
        X z) :
    h z - h u + inner ℝ (lambda + rho • (L z + c)) (L ((z : E) - (u : E))) ≤ 0 := by
  classical
  let d : F := L u - L z
  let r : F := L z + c
  let G : ℝ := inner ℝ (lambda + rho • r) d
  let C : ℝ := (rho / 2) * ‖d‖ ^ 2
  have hC_nonneg : 0 ≤ C := by
    dsimp [C]
    exact mul_nonneg (div_nonneg (le_of_lt hrho) (by norm_num)) (sq_nonneg _)
  have hdir :
      ∀ t : ℝ, 0 < t → t ≤ 1 → h z - h u ≤ G + C * t := by
    intro t htpos htle
    have htI : t ∈ Set.Icc (0 : ℝ) 1 := ⟨le_of_lt htpos, htle⟩
    let yseg : E := AffineMap.lineMap z.1 u.1 t
    have hyseg : yseg ∈ X := hconv.1.lineMap_mem z.2 u.2 htI
    have hminseg :
        h z + inner ℝ lambda (L z + c) + (rho / 2) * ‖L z + c‖ ^ 2 ≤
          h yseg + inner ℝ lambda (L yseg + c) + (rho / 2) * ‖L yseg + c‖ ^ 2 := by
      simpa using hmin hyseg
    have hhseg :
        h yseg - h z ≤ t * (h u - h z) := by
      have hconv_seg :=
        hconv.2 z.2 u.2 (sub_nonneg.mpr htle) (le_of_lt htpos) (by ring)
      have hline : (1 - t) • (z : E) + t • (u : E) = yseg := by
        simp [yseg, AffineMap.lineMap_apply_module]
      change
        h ((1 - t) • (z : E) + t • (u : E)) ≤
          (1 - t) • h z + t • h u at hconv_seg
      rw [hline] at hconv_seg
      simp [smul_eq_mul] at hconv_seg
      nlinarith
    have hleft :
        t * (h z - h u) ≤
          (inner ℝ lambda (L yseg + c) + (rho / 2) * ‖L yseg + c‖ ^ 2) -
            (inner ℝ lambda (L z + c) + (rho / 2) * ‖L z + c‖ ^ 2) := by
      nlinarith [hminseg, hhseg]
    have hy_res : L yseg + c = r + t • d := by
      dsimp [yseg, r, d]
      simp [AffineMap.lineMap_apply_module, map_add, map_smul]
      module
    have hsmooth :
        (inner ℝ lambda (L yseg + c) + (rho / 2) * ‖L yseg + c‖ ^ 2) -
            (inner ℝ lambda (L z + c) + (rho / 2) * ‖L z + c‖ ^ 2) ≤
          t * G + C * t ^ 2 := by
      have hinner :
          inner ℝ lambda (L yseg + c) - inner ℝ lambda (L z + c) =
            t * inner ℝ lambda d := by
        rw [hy_res]
        dsimp [r]
        rw [← inner_sub_right]
        simp [inner_smul_right]
      have hnorm :
          ‖L yseg + c‖ ^ 2 - ‖L z + c‖ ^ 2 =
            2 * t * inner ℝ r d + t ^ 2 * ‖d‖ ^ 2 := by
        rw [hy_res]
        rw [norm_add_sq_real]
        simp [norm_smul, Real.norm_eq_abs, abs_of_nonneg (le_of_lt htpos),
          inner_smul_right, real_inner_comm]
        ring
      apply le_of_eq
      calc
        (inner ℝ lambda (L yseg + c) + (rho / 2) * ‖L yseg + c‖ ^ 2) -
            (inner ℝ lambda (L z + c) + (rho / 2) * ‖L z + c‖ ^ 2)
            =
          (inner ℝ lambda (L yseg + c) - inner ℝ lambda (L z + c)) +
            (rho / 2) * (‖L yseg + c‖ ^ 2 - ‖L z + c‖ ^ 2) := by
          ring
        _ = t * G + C * t ^ 2 := by
          rw [hinner, hnorm]
          dsimp [G, C]
          simp [inner_add_left, inner_smul_left]
          ring
    have hcomb : t * (h z - h u) ≤ t * G + C * t ^ 2 :=
      hleft.trans hsmooth
    nlinarith [hcomb, htpos]
  have hlimit : h z - h u ≤ G := by
    refine le_of_forall_pos_le_add ?_
    intro eps heps
    let t : ℝ := eps / (C + eps + 1)
    have hden_pos : 0 < C + eps + 1 := by nlinarith
    have htpos : 0 < t := by
      dsimp [t]
      positivity
    have htle : t ≤ 1 := by
      dsimp [t]
      rw [div_le_one hden_pos]
      nlinarith [hC_nonneg, le_of_lt heps]
    have hCt : C * t ≤ eps := by
      dsimp [t]
      rw [← mul_div_assoc]
      rw [div_le_iff₀ hden_pos]
      nlinarith [hC_nonneg, le_of_lt heps]
    have hdir_t := hdir t htpos htle
    linarith
  have hG :
      inner ℝ (lambda + rho • (L z + c)) (L ((z : E) - (u : E))) = -G := by
    dsimp [G, d, r]
    rw [map_sub]
    have hneg : L (z : E) - L (u : E) = -(L (u : E) - L (z : E)) := by
      abel
    rw [hneg, inner_neg_right]
  linarith

theorem ADMM_subproblem_optimality (S : Setup p q m) (R : GeneratedSequence S) (n : ℕ)
    (x : {x : XSpace p // x ∈ S.X}) (y : {y : YSpace q // y ∈ S.Y}) :
    S.f (R.iterate n).x - S.f x +
        inner ℝ
          ((R.state n).lambda +
            S.rho • (S.A (R.iterate n).x + S.B (R.state n).y - S.b))
          (S.A (((R.iterate n).x : XSpace p) - (x : XSpace p))) ≤ 0 ∧
      S.g (R.iterate n).y - S.g y +
        inner ℝ
          ((R.state n).lambda +
            S.rho • residual S (R.iterate n).x (R.iterate n).y)
          (S.B (((R.iterate n).y : YSpace q) - (y : YSpace q))) ≤ 0 := by
  constructor
  · have hxmin :
        IsMinOn
          (fun v : XSpace p =>
            S.f v +
              inner ℝ (R.state n).lambda (S.A v + (-S.b + S.B (R.state n).y)) +
                (S.rho / 2) * ‖S.A v + (-S.b + S.B (R.state n).y)‖ ^ 2)
          S.X (R.iterate n).x := by
      convert R.x_minimizes n using 1
      ext v
      unfold xSubproblemObjective augmentedTerm residual
      have hres : S.A v + S.B (R.state n).y - S.b =
          S.A v + (-S.b + S.B (R.state n).y) := by
        abel
      rw [hres]
      ring
    have hx :=
      smooth_augmented_argmin_variational_inequality
        (hconv := S.convexOn_f) (L := S.A) (c := -S.b + S.B (R.state n).y)
        (lambda := (R.state n).lambda) S.rho_pos (R.iterate n).x x hxmin
    simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hx
  · have hymin :
        IsMinOn
          (fun v : YSpace q =>
            S.g v +
              inner ℝ (R.state n).lambda (S.B v + (-S.b + S.A (R.iterate n).x)) +
                (S.rho / 2) * ‖S.B v + (-S.b + S.A (R.iterate n).x)‖ ^ 2)
          S.Y (R.iterate n).y := by
      convert R.y_minimizes n using 1
      ext v
      unfold ySubproblemObjective augmentedTerm residual
      have hres : S.A (R.iterate n).x + S.B v - S.b =
          S.B v + (-S.b + S.A (R.iterate n).x) := by
        abel
      rw [hres]
      ring
    have hy :=
      smooth_augmented_argmin_variational_inequality
        (hconv := S.convexOn_g) (L := S.B) (c := -S.b + S.A (R.iterate n).x)
        (lambda := (R.state n).lambda) S.rho_pos (R.iterate n).y y hymin
    simpa [residual, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hy

private theorem admm_multiplier_residual_eq
    (S : Setup p q m) (R : GeneratedSequence S) (n : ℕ) :
    residual S (R.iterate n).x (R.iterate n).y =
      (1 / S.rho) • ((R.iterate n).lambda - (R.state n).lambda) := by
  have hrho_ne : S.rho ≠ 0 := ne_of_gt S.rho_pos
  have hmul := iterate_multiplier_update S R n
  rw [hmul]
  simp [sub_eq_add_neg, smul_add, smul_smul, hrho_ne]

private theorem admm_multiplier_polarization
    {E : Type*} [SeminormedAddCommGroup E] [InnerProductSpace ℝ E]
    {rho : ℝ} (hrho : rho ≠ 0) (lambdaPrev lambdaT lambda : E) :
    inner ℝ (lambda - lambdaT) ((1 / rho) • (lambdaT - lambdaPrev)) =
      (1 / (2 * rho)) *
        (‖lambdaPrev - lambda‖ ^ 2 - ‖lambdaT - lambda‖ ^ 2 -
          ‖lambdaT - lambdaPrev‖ ^ 2) := by
  have hnorm := norm_sub_sq_real (lambdaT - lambda) (lambdaT - lambdaPrev)
  have hvec : (lambdaT - lambda) - (lambdaT - lambdaPrev) = lambdaPrev - lambda := by
    abel
  rw [hvec] at hnorm
  rw [inner_smul_right]
  have hinner :
      inner ℝ (lambda - lambdaT) (lambdaT - lambdaPrev) =
        (1 / 2) *
          (‖lambdaPrev - lambda‖ ^ 2 - ‖lambdaT - lambda‖ ^ 2 -
            ‖lambdaT - lambdaPrev‖ ^ 2) := by
    have hneg :
        inner ℝ (lambda - lambdaT) (lambdaT - lambdaPrev) =
          -inner ℝ (lambdaT - lambda) (lambdaT - lambdaPrev) := by
      have hvec' : lambda - lambdaT = -(lambdaT - lambda) := by
        abel
      rw [hvec', inner_neg_left]
    rw [hneg]
    nlinarith [hnorm]
  rw [hinner]
  field_simp [hrho]

private theorem admm_primal_cross_term_identity
    (S : Setup p q m) (x xt : XSpace p) (yprev yt : YSpace q) :
    2 * inner ℝ (S.B (yt - yprev)) (S.A (xt - x)) =
      ‖residual S x yprev‖ ^ 2 - ‖residual S x yt‖ ^ 2 +
        ‖residual S xt yt‖ ^ 2 -
          ‖S.A xt + S.B yprev - S.b‖ ^ 2 := by
  let a : MSpace m := S.A (xt - x)
  let c : MSpace m := S.B (yt - yprev)
  let r : MSpace m := residual S x yprev
  have hres_x_yt : residual S x yt = r + c := by
    dsimp [r, c, residual]
    rw [map_sub]
    abel
  have hres_xt_yt : residual S xt yt = r + a + c := by
    dsimp [r, a, c, residual]
    rw [map_sub, map_sub]
    abel
  have hres_xt_yprev : S.A xt + S.B yprev - S.b = r + a := by
    dsimp [r, a, residual]
    rw [map_sub]
    abel
  rw [hres_x_yt, hres_xt_yt, hres_xt_yprev]
  rw [norm_add_sq_real r c, norm_add_sq_real r a]
  have hswap : r + a + c = (r + c) + a := by abel
  rw [hswap, norm_add_sq_real (r + c) a]
  rw [norm_add_sq_real r c]
  simp [inner_add_left, inner_add_right, real_inner_comm, a, c, r, map_sub]
  ring

private theorem admm_substituted_gap_expansion
    (S : Setup p q m) (R : GeneratedSequence S) (n : ℕ) (z : Point S) :
    gap S (R.iterate n).toPoint z ≤
      inner ℝ (z.lambda - (R.iterate n).lambda)
        (residual S (R.iterate n).x (R.iterate n).y) +
        S.rho *
          inner ℝ
            (S.B (((R.iterate n).y : YSpace q) - ((R.state n).y : YSpace q)))
            (S.A (((R.iterate n).x : XSpace p) - (z.x : XSpace p))) := by
  obtain ⟨hx, hy⟩ := ADMM_subproblem_optimality S R n z.x z.y
  have hmul := iterate_multiplier_update S R n
  have hx_arg :
      (R.state n).lambda +
          S.rho • (S.A (R.iterate n).x + S.B (R.state n).y - S.b) =
        (R.iterate n).lambda +
          S.rho • S.B (((R.state n).y : YSpace q) - ((R.iterate n).y : YSpace q)) := by
    rw [hmul]
    unfold residual
    rw [map_sub]
    module
  have hx_sub :
      S.f (R.iterate n).x - S.f z.x +
        inner ℝ
          ((R.iterate n).lambda +
            S.rho • S.B (((R.state n).y : YSpace q) - ((R.iterate n).y : YSpace q)))
          (S.A (((R.iterate n).x : XSpace p) - (z.x : XSpace p))) ≤ 0 := by
    simpa [hx_arg] using hx
  have hy_sub :
      S.g (R.iterate n).y - S.g z.y +
        inner ℝ (R.iterate n).lambda
          (S.B (((R.iterate n).y : YSpace q) - (z.y : YSpace q))) ≤ 0 := by
    simpa [hmul] using hy
  have hx_bound :
      S.f (R.iterate n).x - S.f z.x ≤
        -inner ℝ
          ((R.iterate n).lambda +
            S.rho • S.B (((R.state n).y : YSpace q) - ((R.iterate n).y : YSpace q)))
          (S.A (((R.iterate n).x : XSpace p) - (z.x : XSpace p))) := by
    linarith
  have hy_bound :
      S.g (R.iterate n).y - S.g z.y ≤
        -inner ℝ (R.iterate n).lambda
          (S.B (((R.iterate n).y : YSpace q) - (z.y : YSpace q))) := by
    linarith
  have hx_bound_map :
      S.f (R.iterate n).x - S.f z.x ≤
        -inner ℝ
          ((R.iterate n).lambda +
            S.rho • (S.B (R.state n).y - S.B (R.iterate n).y))
          (S.A (R.iterate n).x - S.A z.x) := by
    simpa [map_sub] using hx_bound
  have hy_bound_map :
      S.g (R.iterate n).y - S.g z.y ≤
        -inner ℝ (R.iterate n).lambda
          (S.B (R.iterate n).y - S.B z.y) := by
    simpa [map_sub] using hy_bound
  calc
    gap S (R.iterate n).toPoint z
        ≤ -inner ℝ
              ((R.iterate n).lambda +
                S.rho • S.B (((R.state n).y : YSpace q) - ((R.iterate n).y : YSpace q)))
              (S.A (((R.iterate n).x : XSpace p) - (z.x : XSpace p))) -
            inner ℝ (R.iterate n).lambda
              (S.B (((R.iterate n).y : YSpace q) - (z.y : YSpace q))) +
            inner ℝ z.lambda (residual S (R.iterate n).x (R.iterate n).y) -
            inner ℝ (R.iterate n).lambda (residual S z.x z.y) := by
      unfold gap
      simp [Iterate.toPoint]
      linarith [hx_bound_map, hy_bound_map]
    _ =
      inner ℝ (z.lambda - (R.iterate n).lambda)
        (residual S (R.iterate n).x (R.iterate n).y) +
        S.rho *
          inner ℝ
            (S.B (((R.iterate n).y : YSpace q) - ((R.state n).y : YSpace q)))
            (S.A (((R.iterate n).x : XSpace p) - (z.x : XSpace p))) := by
      unfold residual
      simp [map_sub, inner_add_left, inner_add_right, inner_sub_left, inner_sub_right,
        inner_smul_left, inner_smul_right]
      ring

theorem ADMM_oneStepGapBound (S : Setup p q m) (R : GeneratedSequence S) (n : ℕ)
    (z : Point S) :
    gap S (R.iterate n).toPoint z ≤
      (1 / (2 * S.rho)) *
          (‖(R.state n).lambda - z.lambda‖ ^ 2 -
            ‖(R.iterate n).lambda - z.lambda‖ ^ 2) +
        (S.rho / 2) *
          (‖residual S z.x (R.state n).y‖ ^ 2 -
            ‖residual S z.x (R.iterate n).y‖ ^ 2 -
            ‖S.A (R.iterate n).x + S.B (R.state n).y - S.b‖ ^ 2) := by
  have hgap := admm_substituted_gap_expansion S R n z
  have hres := admm_multiplier_residual_eq S R n
  have hgap_inc :
      gap S (R.iterate n).toPoint z ≤
        inner ℝ (z.lambda - (R.iterate n).lambda)
          ((1 / S.rho) • ((R.iterate n).lambda - (R.state n).lambda)) +
          S.rho *
            inner ℝ
              (S.B (((R.iterate n).y : YSpace q) - ((R.state n).y : YSpace q)))
              (S.A (((R.iterate n).x : XSpace p) - (z.x : XSpace p))) := by
    simpa [hres] using hgap
  have hpol :=
    admm_multiplier_polarization (ne_of_gt S.rho_pos)
      (R.state n).lambda (R.iterate n).lambda z.lambda
  have hcross :=
    admm_primal_cross_term_identity S (z.x : XSpace p) ((R.iterate n).x : XSpace p)
      ((R.state n).y : YSpace q) ((R.iterate n).y : YSpace q)
  have hcross_scaled :
      S.rho *
          inner ℝ
            (S.B (((R.iterate n).y : YSpace q) - ((R.state n).y : YSpace q)))
            (S.A (((R.iterate n).x : XSpace p) - (z.x : XSpace p))) =
        (S.rho / 2) *
          (‖residual S z.x (R.state n).y‖ ^ 2 -
            ‖residual S z.x (R.iterate n).y‖ ^ 2 +
            ‖residual S (R.iterate n).x (R.iterate n).y‖ ^ 2 -
            ‖S.A (R.iterate n).x + S.B (R.state n).y - S.b‖ ^ 2) := by
    rw [← hcross]
    ring
  have hres_norm :
      ‖residual S (R.iterate n).x (R.iterate n).y‖ ^ 2 =
        (1 / S.rho) ^ 2 *
          ‖(R.iterate n).lambda - (R.state n).lambda‖ ^ 2 := by
    rw [hres, norm_smul]
    rw [Real.norm_eq_abs, abs_of_pos (one_div_pos.mpr S.rho_pos)]
    ring
  calc
    gap S (R.iterate n).toPoint z
        ≤ inner ℝ (z.lambda - (R.iterate n).lambda)
            ((1 / S.rho) • ((R.iterate n).lambda - (R.state n).lambda)) +
          S.rho *
            inner ℝ
              (S.B (((R.iterate n).y : YSpace q) - ((R.state n).y : YSpace q)))
              (S.A (((R.iterate n).x : XSpace p) - (z.x : XSpace p))) := hgap_inc
    _ =
      (1 / (2 * S.rho)) *
          (‖(R.state n).lambda - z.lambda‖ ^ 2 -
            ‖(R.iterate n).lambda - z.lambda‖ ^ 2 -
            ‖(R.iterate n).lambda - (R.state n).lambda‖ ^ 2) +
        (S.rho / 2) *
          (‖residual S z.x (R.state n).y‖ ^ 2 -
            ‖residual S z.x (R.iterate n).y‖ ^ 2 +
            ‖residual S (R.iterate n).x (R.iterate n).y‖ ^ 2 -
            ‖S.A (R.iterate n).x + S.B (R.state n).y - S.b‖ ^ 2) := by
      rw [hpol, hcross_scaled]
    _ =
      (1 / (2 * S.rho)) *
          (‖(R.state n).lambda - z.lambda‖ ^ 2 -
            ‖(R.iterate n).lambda - z.lambda‖ ^ 2) +
        (S.rho / 2) *
          (‖residual S z.x (R.state n).y‖ ^ 2 -
            ‖residual S z.x (R.iterate n).y‖ ^ 2 -
            ‖S.A (R.iterate n).x + S.B (R.state n).y - S.b‖ ^ 2) := by
      rw [hres_norm]
      field_simp [ne_of_gt S.rho_pos]
      ring

private theorem admm_feasible_residual_same_x_eq_B_sub
    (S : Setup p q m) {x : XSpace p} {y y' : YSpace q}
    (h : residual S x y = 0) :
    residual S x y' = S.B (y' - y) := by
  unfold residual at h ⊢
  rw [map_sub]
  calc
    S.A x + S.B y' - S.b =
        (S.A x + S.B y - S.b) + (S.B y' - S.B y) := by
      abel
    _ = S.B y' - S.B y := by
      rw [h]
      simp

private theorem admm_telescoped_one_step_with_residual_sum
    (S : Setup p q m) (R : GeneratedSequence S) (k : ℕ) (z : Point S) :
    (∑ i : Fin k, gap S (R.iterate i.1).toPoint z) ≤
      (1 / (2 * S.rho)) *
          (‖S.lambda0 - z.lambda‖ ^ 2 - ‖(R.state k).lambda - z.lambda‖ ^ 2) +
        (S.rho / 2) *
          (‖residual S z.x S.y0‖ ^ 2 -
            ‖residual S z.x (R.state k).y‖ ^ 2 -
            ∑ i : Fin k, ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2) := by
  classical
  have hstep_sum :
      (∑ i : Fin k, gap S (R.iterate i.1).toPoint z) ≤
        ∑ i : Fin k,
          ((1 / (2 * S.rho)) *
              (‖(R.state i.1).lambda - z.lambda‖ ^ 2 -
                ‖(R.iterate i.1).lambda - z.lambda‖ ^ 2) +
            (S.rho / 2) *
              (‖residual S z.x (R.state i.1).y‖ ^ 2 -
                ‖residual S z.x (R.iterate i.1).y‖ ^ 2 -
                ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2)) := by
    refine Finset.sum_le_sum ?_
    intro i hi
    exact ADMM_oneStepGapBound S R i.1 z
  have hiter_lambda :
      ∀ i : Fin k, (R.iterate i.1).lambda = (R.state (i.1 + 1)).lambda := by
    intro i
    simpa [Iterate.toState] using
      (congrArg State.lambda (generated_state_succ S R i.1)).symm
  have hiter_y :
      ∀ i : Fin k, (R.iterate i.1).y = (R.state (i.1 + 1)).y := by
    intro i
    simpa [Iterate.toState] using
      (congrArg State.y (generated_state_succ S R i.1)).symm
  have hsum_state :
      (∑ i : Fin k,
          ((1 / (2 * S.rho)) *
              (‖(R.state i.1).lambda - z.lambda‖ ^ 2 -
                ‖(R.iterate i.1).lambda - z.lambda‖ ^ 2) +
            (S.rho / 2) *
              (‖residual S z.x (R.state i.1).y‖ ^ 2 -
                ‖residual S z.x (R.iterate i.1).y‖ ^ 2 -
                ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2))) =
        (∑ i : Fin k,
          ((1 / (2 * S.rho)) *
              (‖(R.state i.1).lambda - z.lambda‖ ^ 2 -
                ‖(R.state (i.1 + 1)).lambda - z.lambda‖ ^ 2) +
            (S.rho / 2) *
              (‖residual S z.x (R.state i.1).y‖ ^ 2 -
                ‖residual S z.x (R.state (i.1 + 1)).y‖ ^ 2 -
                ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2))) := by
    refine Finset.sum_congr rfl ?_
    intro i hi
    simp [hiter_lambda i, hiter_y i]
  have hinit_lambda : (R.state 0).lambda = S.lambda0 := by
    simpa [initialState] using congrArg State.lambda (generated_initial_state S R)
  have hinit_y : (R.state 0).y = S.y0 := by
    simpa [initialState] using congrArg State.y (generated_initial_state S R)
  have hlam_tel :
      (∑ i : Fin k,
          (‖(R.state i.1).lambda - z.lambda‖ ^ 2 -
            ‖(R.state (i.1 + 1)).lambda - z.lambda‖ ^ 2)) =
        ‖S.lambda0 - z.lambda‖ ^ 2 - ‖(R.state k).lambda - z.lambda‖ ^ 2 := by
    simpa [hinit_lambda] using
      (sum_fin_adjacent_sub_eq_sub k
        (fun n : ℕ => ‖(R.state n).lambda - z.lambda‖ ^ 2))
  have hy_tel :
      (∑ i : Fin k,
          (‖residual S z.x (R.state i.1).y‖ ^ 2 -
            ‖residual S z.x (R.state (i.1 + 1)).y‖ ^ 2)) =
        ‖residual S z.x S.y0‖ ^ 2 -
          ‖residual S z.x (R.state k).y‖ ^ 2 := by
    simpa [hinit_y] using
      (sum_fin_adjacent_sub_eq_sub k
        (fun n : ℕ => ‖residual S z.x (R.state n).y‖ ^ 2))
  have hsum_eval :
      (∑ i : Fin k,
          ((1 / (2 * S.rho)) *
              (‖(R.state i.1).lambda - z.lambda‖ ^ 2 -
                ‖(R.state (i.1 + 1)).lambda - z.lambda‖ ^ 2) +
            (S.rho / 2) *
              (‖residual S z.x (R.state i.1).y‖ ^ 2 -
                ‖residual S z.x (R.state (i.1 + 1)).y‖ ^ 2 -
                ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2))) =
        (1 / (2 * S.rho)) *
            (‖S.lambda0 - z.lambda‖ ^ 2 - ‖(R.state k).lambda - z.lambda‖ ^ 2) +
          (S.rho / 2) *
            (‖residual S z.x S.y0‖ ^ 2 -
              ‖residual S z.x (R.state k).y‖ ^ 2 -
              ∑ i : Fin k, ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2) := by
    calc
      (∑ i : Fin k,
          ((1 / (2 * S.rho)) *
              (‖(R.state i.1).lambda - z.lambda‖ ^ 2 -
                ‖(R.state (i.1 + 1)).lambda - z.lambda‖ ^ 2) +
            (S.rho / 2) *
              (‖residual S z.x (R.state i.1).y‖ ^ 2 -
                ‖residual S z.x (R.state (i.1 + 1)).y‖ ^ 2 -
                ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2))) =
          (1 / (2 * S.rho)) *
              (∑ i : Fin k,
                (‖(R.state i.1).lambda - z.lambda‖ ^ 2 -
                  ‖(R.state (i.1 + 1)).lambda - z.lambda‖ ^ 2)) +
            (S.rho / 2) *
              (∑ i : Fin k,
                (‖residual S z.x (R.state i.1).y‖ ^ 2 -
                  ‖residual S z.x (R.state (i.1 + 1)).y‖ ^ 2 -
                  ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2)) := by
        rw [Finset.sum_add_distrib]
        rw [← Finset.mul_sum, ← Finset.mul_sum]
      _ = (1 / (2 * S.rho)) *
            (‖S.lambda0 - z.lambda‖ ^ 2 - ‖(R.state k).lambda - z.lambda‖ ^ 2) +
          (S.rho / 2) *
            ((∑ i : Fin k,
                (‖residual S z.x (R.state i.1).y‖ ^ 2 -
                  ‖residual S z.x (R.state (i.1 + 1)).y‖ ^ 2)) -
              ∑ i : Fin k,
                ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2) := by
        rw [hlam_tel, Finset.sum_sub_distrib]
      _ = (1 / (2 * S.rho)) *
            (‖S.lambda0 - z.lambda‖ ^ 2 - ‖(R.state k).lambda - z.lambda‖ ^ 2) +
          (S.rho / 2) *
            (‖residual S z.x S.y0‖ ^ 2 -
              ‖residual S z.x (R.state k).y‖ ^ 2 -
              ∑ i : Fin k, ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2) := by
        rw [hy_tel]
  calc
    (∑ i : Fin k, gap S (R.iterate i.1).toPoint z)
        ≤ ∑ i : Fin k,
          ((1 / (2 * S.rho)) *
              (‖(R.state i.1).lambda - z.lambda‖ ^ 2 -
                ‖(R.iterate i.1).lambda - z.lambda‖ ^ 2) +
            (S.rho / 2) *
              (‖residual S z.x (R.state i.1).y‖ ^ 2 -
                ‖residual S z.x (R.iterate i.1).y‖ ^ 2 -
                ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2)) := hstep_sum
    _ = ∑ i : Fin k,
          ((1 / (2 * S.rho)) *
              (‖(R.state i.1).lambda - z.lambda‖ ^ 2 -
                ‖(R.state (i.1 + 1)).lambda - z.lambda‖ ^ 2) +
            (S.rho / 2) *
              (‖residual S z.x (R.state i.1).y‖ ^ 2 -
                ‖residual S z.x (R.state (i.1 + 1)).y‖ ^ 2 -
                ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2)) := hsum_state
    _ = (1 / (2 * S.rho)) *
          (‖S.lambda0 - z.lambda‖ ^ 2 - ‖(R.state k).lambda - z.lambda‖ ^ 2) +
        (S.rho / 2) *
          (‖residual S z.x S.y0‖ ^ 2 -
            ‖residual S z.x (R.state k).y‖ ^ 2 -
            ∑ i : Fin k, ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2) := hsum_eval

theorem ADMM_telescopedGapBound (S : Setup p q m) (R : GeneratedSequence S) (k : ℕ) (hk : 0 < k)
    (z : Point S) (hz_feasible : residual S z.x z.y = 0) :
    (∑ i : Fin k, gap S (R.iterate i.1).toPoint z) ≤
      (1 / (2 * S.rho)) *
          (‖S.lambda0 - z.lambda‖ ^ 2 - ‖(R.state k).lambda - z.lambda‖ ^ 2) +
        (S.rho / 2) *
          (‖S.B ((S.y0 : YSpace q) - (z.y : YSpace q))‖ ^ 2 -
            ‖S.B (((R.state k).y : YSpace q) - (z.y : YSpace q))‖ ^ 2) := by
  classical
  have htel := admm_telescoped_one_step_with_residual_sum S R k z
  have hres0 :
      residual S z.x S.y0 = S.B ((S.y0 : YSpace q) - (z.y : YSpace q)) :=
    admm_feasible_residual_same_x_eq_B_sub S (x := z.x) (y := z.y) (y' := S.y0)
      hz_feasible
  have hresk :
      residual S z.x (R.state k).y =
        S.B (((R.state k).y : YSpace q) - (z.y : YSpace q)) :=
    admm_feasible_residual_same_x_eq_B_sub S (x := z.x) (y := z.y)
      (y' := (R.state k).y) hz_feasible
  have hsum_nonneg :
      0 ≤ ∑ i : Fin k,
        ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2 := by
    refine Finset.sum_nonneg ?_
    intro i hi
    exact sq_nonneg _
  have hrho_half_nonneg : 0 ≤ S.rho / 2 := by
    exact div_nonneg (le_of_lt S.rho_pos) (by norm_num)
  calc
    (∑ i : Fin k, gap S (R.iterate i.1).toPoint z)
        ≤ (1 / (2 * S.rho)) *
            (‖S.lambda0 - z.lambda‖ ^ 2 - ‖(R.state k).lambda - z.lambda‖ ^ 2) +
          (S.rho / 2) *
            (‖residual S z.x S.y0‖ ^ 2 -
              ‖residual S z.x (R.state k).y‖ ^ 2 -
              ∑ i : Fin k,
                ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2) := htel
    _ ≤ (1 / (2 * S.rho)) *
            (‖S.lambda0 - z.lambda‖ ^ 2 - ‖(R.state k).lambda - z.lambda‖ ^ 2) +
          (S.rho / 2) *
            (‖S.B ((S.y0 : YSpace q) - (z.y : YSpace q))‖ ^ 2 -
              ‖S.B (((R.state k).y : YSpace q) - (z.y : YSpace q))‖ ^ 2) := by
      rw [hres0, hresk]
      have hdrop :
          ‖S.B ((S.y0 : YSpace q) - (z.y : YSpace q))‖ ^ 2 -
              ‖S.B (((R.state k).y : YSpace q) - (z.y : YSpace q))‖ ^ 2 -
              (∑ i : Fin k,
                ‖S.A (R.iterate i.1).x + S.B (R.state i.1).y - S.b‖ ^ 2) ≤
            ‖S.B ((S.y0 : YSpace q) - (z.y : YSpace q))‖ ^ 2 -
              ‖S.B (((R.state k).y : YSpace q) - (z.y : YSpace q))‖ ^ 2 := by
        nlinarith
      have hscaled := mul_le_mul_of_nonneg_left hdrop hrho_half_nonneg
      nlinarith

private theorem admm_gap_star_nonneg (S : Setup p q m) (zt : Point S) :
    0 ≤ gap S zt (starPoint S) := by
  have hstar_res : residual S S.xStar S.yStar = 0 := by
    unfold residual
    rw [S.star_feasible]
    abel
  have hlag :=
    S.star_lagrange_multiplier zt.x zt.x.property zt.y zt.y.property
  have hlag' :
      S.f S.xStar + S.g S.yStar ≤
        S.f zt.x + S.g zt.y + inner ℝ S.lambdaStar (residual S zt.x zt.y) := by
    have hstar_aff : S.A S.xStar + S.B S.yStar - S.b = 0 := by
      simpa [residual] using hstar_res
    have hlag0 :
        S.f S.xStar + S.g S.yStar + inner ℝ S.lambdaStar 0 ≤
          S.f zt.x + S.g zt.y + inner ℝ S.lambdaStar (residual S zt.x zt.y) := by
      simpa [residual, hstar_aff] using hlag
    simpa using hlag0
  unfold gap
  simp [starPoint, hstar_res]
  linarith

theorem ADMM_multiplierDisplacementBound (S : Setup p q m) (R : GeneratedSequence S) (k : ℕ)
    (hk : 0 < k) :
    ‖(R.state k).lambda - S.lambda0‖ ≤
      2 * ‖S.lambda0 - S.lambdaStar‖ + S.rho * ‖S.B (S.y0 - S.yStar)‖ := by
  classical
  let zstar : Point S := starPoint S
  have hzstar_feasible : residual S zstar.x zstar.y = 0 := by
    dsimp [zstar, starPoint]
    unfold residual
    rw [S.star_feasible]
    abel
  have htel := ADMM_telescopedGapBound S R k hk zstar hzstar_feasible
  have hsum_nonneg :
      0 ≤ ∑ i : Fin k, gap S (R.iterate i.1).toPoint zstar := by
    refine Finset.sum_nonneg ?_
    intro i hi
    exact admm_gap_star_nonneg S (R.iterate i.1).toPoint
  have ht_sq :
      ‖(R.state k).lambda - S.lambdaStar‖ ^ 2 ≤
        ‖S.lambda0 - S.lambdaStar‖ ^ 2 +
          S.rho ^ 2 * ‖S.B ((S.y0 : YSpace q) - (S.yStar : YSpace q))‖ ^ 2 := by
    have hrhs_nonneg :
        0 ≤
          (1 / (2 * S.rho)) *
              (‖S.lambda0 - zstar.lambda‖ ^ 2 -
                ‖(R.state k).lambda - zstar.lambda‖ ^ 2) +
            (S.rho / 2) *
              (‖S.B ((S.y0 : YSpace q) - (zstar.y : YSpace q))‖ ^ 2 -
                ‖S.B (((R.state k).y : YSpace q) - (zstar.y : YSpace q))‖ ^ 2) :=
      le_trans hsum_nonneg htel
    dsimp [zstar, starPoint] at hrhs_nonneg
    have hterminal_nonneg :
        0 ≤ ‖S.B (((R.state k).y : YSpace q) - (S.yStar : YSpace q))‖ ^ 2 :=
      sq_nonneg _
    have hrho_pos : 0 < 2 * S.rho := by
      exact mul_pos (by norm_num) S.rho_pos
    have hscaled :
        0 ≤
          (‖S.lambda0 - S.lambdaStar‖ ^ 2 -
              ‖(R.state k).lambda - S.lambdaStar‖ ^ 2) +
            S.rho ^ 2 *
              (‖S.B ((S.y0 : YSpace q) - (S.yStar : YSpace q))‖ ^ 2 -
                ‖S.B (((R.state k).y : YSpace q) - (S.yStar : YSpace q))‖ ^ 2) := by
      have hmul := mul_nonneg (le_of_lt hrho_pos) hrhs_nonneg
      have hrho_ne : S.rho ≠ 0 := ne_of_gt S.rho_pos
      field_simp [hrho_ne] at hmul
      simpa [map_sub] using hmul
    nlinarith [hscaled, hterminal_nonneg, sq_nonneg S.rho]
  have ht_norm :
      ‖(R.state k).lambda - S.lambdaStar‖ ≤
        ‖S.lambda0 - S.lambdaStar‖ +
          S.rho * ‖S.B ((S.y0 : YSpace q) - (S.yStar : YSpace q))‖ := by
    have hright_nonneg :
        0 ≤ ‖S.lambda0 - S.lambdaStar‖ +
          S.rho * ‖S.B ((S.y0 : YSpace q) - (S.yStar : YSpace q))‖ := by
      exact add_nonneg (norm_nonneg _)
        (mul_nonneg (le_of_lt S.rho_pos) (norm_nonneg _))
    have htarget_sq :
        ‖(R.state k).lambda - S.lambdaStar‖ ^ 2 ≤
          (‖S.lambda0 - S.lambdaStar‖ +
            S.rho * ‖S.B ((S.y0 : YSpace q) - (S.yStar : YSpace q))‖) ^ 2 := by
      have hcross :
          0 ≤ 2 * ‖S.lambda0 - S.lambdaStar‖ *
            (S.rho * ‖S.B ((S.y0 : YSpace q) - (S.yStar : YSpace q))‖) := by
        exact mul_nonneg
          (mul_nonneg (by norm_num) (norm_nonneg _))
          (mul_nonneg (le_of_lt S.rho_pos) (norm_nonneg _))
      nlinarith [ht_sq, hcross]
    have habs := sq_le_sq.mp htarget_sq
    have hright_nonneg' :
        0 ≤ ‖S.lambda0 - S.lambdaStar‖ +
          S.rho * ‖S.B (S.y0 : YSpace q) - S.B (S.yStar : YSpace q)‖ := by
      simpa [map_sub] using hright_nonneg
    simpa [abs_of_nonneg (norm_nonneg _), abs_of_nonneg hright_nonneg'] using habs
  have htri :
      ‖(R.state k).lambda - S.lambda0‖ ≤
        ‖(R.state k).lambda - S.lambdaStar‖ + ‖S.lambda0 - S.lambdaStar‖ := by
    calc
      ‖(R.state k).lambda - S.lambda0‖ =
          ‖((R.state k).lambda - S.lambdaStar) + (S.lambdaStar - S.lambda0)‖ := by
        congr 1
        abel
      _ ≤ ‖(R.state k).lambda - S.lambdaStar‖ + ‖S.lambdaStar - S.lambda0‖ :=
        norm_add_le _ _
      _ = ‖(R.state k).lambda - S.lambdaStar‖ + ‖S.lambda0 - S.lambdaStar‖ := by
        rw [norm_sub_rev S.lambdaStar S.lambda0]
  nlinarith [htri, ht_norm]

private theorem state_lambda_telescope_eq_rho_sum_residuals
    (S : Setup p q m) (R : GeneratedSequence S) (k : ℕ) :
    S.rho • (∑ i : Fin k, residual S (R.iterate i.1).x (R.iterate i.1).y) =
      (R.state k).lambda - S.lambda0 := by
  classical
  have hstep :
      ∀ n : ℕ,
        (R.state (n + 1)).lambda =
          (R.state n).lambda + S.rho • residual S (R.iterate n).x (R.iterate n).y := by
    intro n
    calc
      (R.state (n + 1)).lambda = ((R.iterate n).toState).lambda := by
        exact congrArg State.lambda (generated_state_succ S R n)
      _ = (R.iterate n).lambda := rfl
      _ = (R.state n).lambda + S.rho • residual S (R.iterate n).x (R.iterate n).y := by
        exact iterate_multiplier_update S R n
  have hinit : (R.state 0).lambda = S.lambda0 := by
    simpa [initialState] using congrArg State.lambda (generated_initial_state S R)
  have hinc :
      (∑ i : Fin k, ((R.state (i.1 + 1)).lambda - (R.state i.1).lambda)) =
        (R.state k).lambda - (R.state 0).lambda := by
    let f : ℕ → MSpace m := fun n => (R.state n).lambda
    have hdrop := sum_fin_adjacent_sub_eq_sub k f
    change
      (∑ i : Fin k, (f (i.1 + 1) - f i.1)) = f k - f 0
    calc
      (∑ i : Fin k, (f (i.1 + 1) - f i.1)) =
          - (∑ i : Fin k, (f i.1 - f (i.1 + 1))) := by
        rw [← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl ?_
        intro i hi
        abel
      _ = -(f 0 - f k) := by rw [hdrop]
      _ = f k - f 0 := by
        abel
  calc
    S.rho • (∑ i : Fin k, residual S (R.iterate i.1).x (R.iterate i.1).y) =
        ∑ i : Fin k, S.rho • residual S (R.iterate i.1).x (R.iterate i.1).y := by
      rw [Finset.smul_sum]
    _ = ∑ i : Fin k, ((R.state (i.1 + 1)).lambda - (R.state i.1).lambda) := by
      refine Finset.sum_congr rfl ?_
      intro i hi
      rw [hstep i.1]
      abel
    _ = (R.state k).lambda - (R.state 0).lambda := hinc
    _ = (R.state k).lambda - S.lambda0 := by
      rw [hinit]

private theorem residual_average_eq_average_residuals
    (S : Setup p q m) (R : GeneratedSequence S) (k : ℕ) (hk : 0 < k) :
    residual S (averagePoint S R k hk).x (averagePoint S R k hk).y =
      (1 / (k : ℝ)) • ∑ i : Fin k, residual S (R.iterate i.1).x (R.iterate i.1).y := by
  classical
  have hk_ne : (k : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hk)
  simp [residual, averagePoint, averageX, averageY,
    Finset.smul_sum, Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_const,
    Fintype.card_fin, hk_ne]
  rw [← Finset.smul_sum, ← Finset.smul_sum]
  simp [smul_add, smul_sub, smul_smul, hk_ne]
  rw [← Nat.cast_smul_eq_nsmul ℝ k S.b, smul_smul]
  field_simp [hk_ne]
  simp

theorem ADMM_averagedFeasibilityIdentity (S : Setup p q m) (R : GeneratedSequence S) (k : ℕ)
    (hk : 0 < k) :
    residual S (averagePoint S R k hk).x (averagePoint S R k hk).y +
        (1 / (S.rho * (k : ℝ))) • (S.lambda0 - (R.state k).lambda) = 0 := by
  classical
  have hk_ne : (k : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hk)
  have hrho_ne : S.rho ≠ 0 := ne_of_gt S.rho_pos
  have htel := state_lambda_telescope_eq_rho_sum_residuals S R k
  have havg := residual_average_eq_average_residuals S R k hk
  have hneg : S.lambda0 - (R.state k).lambda =
      -((R.state k).lambda - S.lambda0) := by
    abel
  have hcoef : (k : ℝ)⁻¹ * S.rho⁻¹ * S.rho = (k : ℝ)⁻¹ := by
    field_simp [hrho_ne]
  rw [havg, hneg, ← htel]
  simp [smul_smul, hcoef]

private theorem admm_average_objective_le_average_iterate_objective
    (S : Setup p q m) (R : GeneratedSequence S) (k : ℕ) (hk : 0 < k) :
    S.f (averagePoint S R k hk).x + S.g (averagePoint S R k hk).y ≤
      (1 / (k : ℝ)) *
        (∑ i : Fin k, (S.f (R.iterate i.1).x + S.g (R.iterate i.1).y)) := by
  classical
  have hk_pos : 0 < (k : ℝ) := by exact_mod_cast hk
  have hk_ne : (k : ℝ) ≠ 0 := ne_of_gt hk_pos
  have hweights_nonneg :
      ∀ i ∈ (Finset.univ : Finset (Fin k)), 0 ≤ (fun _ : Fin k => 1 / (k : ℝ)) i := by
    intro i hi
    exact div_nonneg zero_le_one (le_of_lt hk_pos)
  have hweights_sum :
      ∑ i ∈ (Finset.univ : Finset (Fin k)), (fun _ : Fin k => 1 / (k : ℝ)) i = 1 := by
    simp [Finset.sum_const, Fintype.card_fin, hk_ne]
  have hf_avg :
      S.f (averagePoint S R k hk).x ≤
        (1 / (k : ℝ)) * ∑ i : Fin k, S.f (R.iterate i.1).x := by
    have hJ :=
      S.convexOn_f.map_sum_le
        (t := (Finset.univ : Finset (Fin k)))
        (w := fun _ : Fin k => 1 / (k : ℝ))
        (p := fun i : Fin k => ((R.iterate i.1).x : XSpace p))
        hweights_nonneg hweights_sum
        (fun i hi => (R.iterate i.1).x.property)
    simpa [averagePoint, averageX, Finset.smul_sum, Finset.mul_sum, smul_eq_mul,
      mul_comm, mul_left_comm, mul_assoc] using hJ
  have hg_avg :
      S.g (averagePoint S R k hk).y ≤
        (1 / (k : ℝ)) * ∑ i : Fin k, S.g (R.iterate i.1).y := by
    have hJ :=
      S.convexOn_g.map_sum_le
        (t := (Finset.univ : Finset (Fin k)))
        (w := fun _ : Fin k => 1 / (k : ℝ))
        (p := fun i : Fin k => ((R.iterate i.1).y : YSpace q))
        hweights_nonneg hweights_sum
        (fun i hi => (R.iterate i.1).y.property)
    simpa [averagePoint, averageY, Finset.smul_sum, Finset.mul_sum, smul_eq_mul,
      mul_comm, mul_left_comm, mul_assoc] using hJ
  calc
    S.f (averagePoint S R k hk).x + S.g (averagePoint S R k hk).y
        ≤ (1 / (k : ℝ)) * ∑ i : Fin k, S.f (R.iterate i.1).x +
          (1 / (k : ℝ)) * ∑ i : Fin k, S.g (R.iterate i.1).y :=
      add_le_add hf_avg hg_avg
    _ = (1 / (k : ℝ)) *
        (∑ i : Fin k, (S.f (R.iterate i.1).x + S.g (R.iterate i.1).y)) := by
      rw [Finset.sum_add_distrib]
      ring

theorem ADMM_objectiveResidualBound (S : Setup p q m) (R : GeneratedSequence S) (k : ℕ)
    (hk : 0 < k) :
    S.f (averagePoint S R k hk).x + S.g (averagePoint S R k hk).y -
        S.f S.xStar - S.g S.yStar ≤
      (1 / (2 * (k : ℝ))) *
        ((1 / S.rho) * ‖S.lambda0‖ ^ 2 + S.rho * ‖S.B (S.y0 - S.yStar)‖ ^ 2) := by
  classical
  let z0 : Point S := { x := S.xStar, y := S.yStar, lambda := 0 }
  have hk_pos : 0 < (k : ℝ) := by exact_mod_cast hk
  have hk_ne : (k : ℝ) ≠ 0 := ne_of_gt hk_pos
  have hrho_ne : S.rho ≠ 0 := ne_of_gt S.rho_pos
  have hstar_res : residual S S.xStar S.yStar = 0 := by
    unfold residual
    rw [S.star_feasible]
    abel
  have hz0_feasible : residual S z0.x z0.y = 0 := by
    simpa [z0] using hstar_res
  let avgObj : ℝ := S.f (averagePoint S R k hk).x + S.g (averagePoint S R k hk).y
  let starObj : ℝ := S.f S.xStar + S.g S.yStar
  let sumObj : ℝ := ∑ i : Fin k, (S.f (R.iterate i.1).x + S.g (R.iterate i.1).y)
  have havg_obj : avgObj ≤ (1 / (k : ℝ)) * sumObj := by
    dsimp [avgObj, sumObj]
    exact admm_average_objective_le_average_iterate_objective S R k hk
  have hmul_avg : (k : ℝ) * avgObj ≤ sumObj := by
    have hmul :=
      mul_le_mul_of_nonneg_left havg_obj (le_of_lt hk_pos)
    have hscale : (k : ℝ) * ((1 / (k : ℝ)) * sumObj) = sumObj := by
      field_simp [hk_ne]
    nlinarith
  have hsum_gap_eq :
      (∑ i : Fin k, gap S (R.iterate i.1).toPoint z0) =
        sumObj - (k : ℝ) * starObj := by
    dsimp [sumObj, starObj, z0]
    simp [gap, Iterate.toPoint, hstar_res, Finset.sum_add_distrib, Finset.sum_sub_distrib,
      Finset.sum_const, Fintype.card_fin]
    ring
  have hgap_lower :
      (k : ℝ) * (avgObj - starObj) ≤
        ∑ i : Fin k, gap S (R.iterate i.1).toPoint z0 := by
    rw [hsum_gap_eq]
    nlinarith
  have htel := ADMM_telescopedGapBound S R k hk z0 hz0_feasible
  have htel_simp :
      (∑ i : Fin k, gap S (R.iterate i.1).toPoint z0) ≤
        (1 / (2 * S.rho)) *
            (‖S.lambda0‖ ^ 2 - ‖(R.state k).lambda‖ ^ 2) +
          (S.rho / 2) *
            (‖S.B ((S.y0 : YSpace q) - (S.yStar : YSpace q))‖ ^ 2 -
              ‖S.B (((R.state k).y : YSpace q) - (S.yStar : YSpace q))‖ ^ 2) := by
    simpa [z0, sub_zero] using htel
  let C : ℝ :=
    (1 / (2 * S.rho)) * ‖S.lambda0‖ ^ 2 +
      (S.rho / 2) * ‖S.B ((S.y0 : YSpace q) - (S.yStar : YSpace q))‖ ^ 2
  have hterminal_drop :
      (1 / (2 * S.rho)) *
          (‖S.lambda0‖ ^ 2 - ‖(R.state k).lambda‖ ^ 2) +
        (S.rho / 2) *
          (‖S.B ((S.y0 : YSpace q) - (S.yStar : YSpace q))‖ ^ 2 -
            ‖S.B (((R.state k).y : YSpace q) - (S.yStar : YSpace q))‖ ^ 2) ≤ C := by
    dsimp [C]
    have hcoef_lambda : 0 ≤ 1 / (2 * S.rho) := by
      exact div_nonneg zero_le_one (mul_nonneg (by norm_num) (le_of_lt S.rho_pos))
    have hcoef_y : 0 ≤ S.rho / 2 := by
      exact div_nonneg (le_of_lt S.rho_pos) (by norm_num)
    have hlambda_terminal : 0 ≤ ‖(R.state k).lambda‖ ^ 2 := sq_nonneg _
    have hy_terminal :
        0 ≤ ‖S.B (((R.state k).y : YSpace q) - (S.yStar : YSpace q))‖ ^ 2 :=
      sq_nonneg _
    nlinarith [mul_nonneg hcoef_lambda hlambda_terminal,
      mul_nonneg hcoef_y hy_terminal]
  have hgap_upper :
      (∑ i : Fin k, gap S (R.iterate i.1).toPoint z0) ≤ C :=
    htel_simp.trans hterminal_drop
  have hmul_bound : (k : ℝ) * (avgObj - starObj) ≤ C :=
    hgap_lower.trans hgap_upper
  have hscaled :
      (1 / (k : ℝ)) * ((k : ℝ) * (avgObj - starObj)) ≤
        (1 / (k : ℝ)) * C :=
    mul_le_mul_of_nonneg_left hmul_bound (div_nonneg zero_le_one (le_of_lt hk_pos))
  have hobj_bound : avgObj - starObj ≤ (1 / (k : ℝ)) * C := by
    have hleft :
        (1 / (k : ℝ)) * ((k : ℝ) * (avgObj - starObj)) = avgObj - starObj := by
      field_simp [hk_ne]
    calc
      avgObj - starObj =
          (1 / (k : ℝ)) * ((k : ℝ) * (avgObj - starObj)) := hleft.symm
      _ ≤ (1 / (k : ℝ)) * C := hscaled
  dsimp [avgObj, starObj, C] at hobj_bound ⊢
  calc
    S.f (averagePoint S R k hk).x + S.g (averagePoint S R k hk).y -
        S.f S.xStar - S.g S.yStar =
        S.f (averagePoint S R k hk).x + S.g (averagePoint S R k hk).y -
          (S.f S.xStar + S.g S.yStar) := by
      ring
    _ ≤ (1 / (k : ℝ)) *
        ((1 / (2 * S.rho)) * ‖S.lambda0‖ ^ 2 +
          (S.rho / 2) * ‖S.B ((S.y0 : YSpace q) - (S.yStar : YSpace q))‖ ^ 2) := hobj_bound
    _ = (1 / (2 * (k : ℝ))) *
        ((1 / S.rho) * ‖S.lambda0‖ ^ 2 + S.rho * ‖S.B (S.y0 - S.yStar)‖ ^ 2) := by
      field_simp [hrho_ne, hk_ne]

theorem ADMM_feasibilityResidualBound (S : Setup p q m) (R : GeneratedSequence S) (k : ℕ)
    (hk : 0 < k) :
    ‖residual S (averagePoint S R k hk).x (averagePoint S R k hk).y‖ ≤
      (1 / (k : ℝ)) *
        ((2 / S.rho) * ‖S.lambda0 - S.lambdaStar‖ + ‖S.B (S.y0 - S.yStar)‖) := by
  classical
  have hk_ne : (k : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hk)
  have hk_pos : 0 < (k : ℝ) := by exact_mod_cast hk
  have hrho_ne : S.rho ≠ 0 := ne_of_gt S.rho_pos
  have hden_pos : 0 < S.rho * (k : ℝ) := mul_pos S.rho_pos hk_pos
  have hcoef_nonneg : 0 ≤ 1 / (S.rho * (k : ℝ)) :=
    div_nonneg zero_le_one (le_of_lt hden_pos)
  have hident := ADMM_averagedFeasibilityIdentity S R k hk
  have hdisp := ADMM_multiplierDisplacementBound S R k hk
  have hres :
      residual S (averagePoint S R k hk).x (averagePoint S R k hk).y =
        (1 / (S.rho * (k : ℝ))) • ((R.state k).lambda - S.lambda0) := by
    have hneg : S.lambda0 - (R.state k).lambda =
        -((R.state k).lambda - S.lambda0) := by
      abel
    rw [hneg, smul_neg] at hident
    calc
      residual S (averagePoint S R k hk).x (averagePoint S R k hk).y =
          (residual S (averagePoint S R k hk).x (averagePoint S R k hk).y +
              -((1 / (S.rho * (k : ℝ))) • ((R.state k).lambda - S.lambda0))) +
            (1 / (S.rho * (k : ℝ))) • ((R.state k).lambda - S.lambda0) := by
        abel
      _ = 0 + (1 / (S.rho * (k : ℝ))) • ((R.state k).lambda - S.lambda0) := by
        rw [hident]
      _ = (1 / (S.rho * (k : ℝ))) • ((R.state k).lambda - S.lambda0) := by
        simp
  calc
    ‖residual S (averagePoint S R k hk).x (averagePoint S R k hk).y‖ =
        (1 / (S.rho * (k : ℝ))) * ‖(R.state k).lambda - S.lambda0‖ := by
      rw [hres, norm_smul]
      rw [Real.norm_eq_abs, abs_of_nonneg hcoef_nonneg]
    _ ≤ (1 / (S.rho * (k : ℝ))) *
          (2 * ‖S.lambda0 - S.lambdaStar‖ +
            S.rho * ‖S.B (S.y0 - S.yStar)‖) :=
      mul_le_mul_of_nonneg_left hdisp hcoef_nonneg
    _ = (1 / (k : ℝ)) *
        ((2 / S.rho) * ‖S.lambda0 - S.lambdaStar‖ + ‖S.B (S.y0 - S.yStar)‖) := by
      field_simp [hrho_ne, hk_ne]

end ADMM

