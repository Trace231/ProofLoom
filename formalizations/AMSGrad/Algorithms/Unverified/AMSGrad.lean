private theorem oldHeadCounterexample_alphaSchedule :
    ∀ t ∈ Finset.Icc 1 1,
      IsTheorem4StepSizeAt oldHeadCounterexampleSetup t
        (oldHeadCounterexampleSetup.alpha_t t) := by
  intro t ht
  have ht' : t = 1 :=
    le_antisymm (Finset.mem_Icc.mp ht).2 (Finset.mem_Icc.mp ht).1
  subst t
  refine ⟨1, ?_, ?_, ?_⟩
  · simp
  · exact ⟨by norm_num, by norm_num⟩
  · exact ⟨by norm_num, by norm_num [oldHeadCounterexampleSetup]⟩

private theorem oldHeadCounterexample_beta1t_le :
    ∀ t ∈ Finset.Icc 1 1,
      oldHeadCounterexampleSetup.beta1t t ≤ beta1 oldHeadCounterexampleSetup := by
  intro t ht
  simp [oldHeadCounterexampleSetup, beta1]

/-- Formal Step-0 falsity witness for the retired unguarded extension head.

At `d = 0`, all coordinate quotient and projection-domain obligations are
vacuous, so a well-defined horizon run exists even with `β₂ = 4`.  The old
head would then produce an `IsTheorem4Bound`, whose relational RHS necessarily
contains a square root of `1 - β₂ = -3`, impossible over the reals. -/
theorem AMSGrad_theorem4_wellDefinedRunOnHorizon_extension_oldHead_false :
    ¬ AMSGrad_theorem4_wellDefinedRunOnHorizon_extension_oldHead := by
  intro hold
  rcases hold oldHeadCounterexampleSetup 1 oldHeadCounterexampleRun
      (by norm_num) oldHeadCounterexample_wellDefined
      oldHeadCounterexample_boundedGradients
      oldHeadCounterexample_alphaSchedule oldHeadCounterexample_beta1t_le with
    ⟨B, hB, _hreg⟩
  rcases theorem4Bound_exposes_oneMinusBeta2_sqrt
      oldHeadCounterexampleSetup oldHeadCounterexampleRun 1 B hB with
    ⟨sqrtOneMinusBeta2, hsqrtOneMinusBeta2⟩
  have hsq_nonneg : 0 ≤ sqrtOneMinusBeta2 ^ 2 :=
    sq_nonneg sqrtOneMinusBeta2
  have hsq_neg_raw : sqrtOneMinusBeta2 ^ 2 = 1 - (4 : ℝ) := by
    simpa [oldHeadCounterexampleSetup] using hsqrtOneMinusBeta2.2
  have hsq_neg : sqrtOneMinusBeta2 ^ 2 = -3 := by
    linarith
  linarith

/-- Retired pre-parameter-domain extension head.

This is the exact shape after the RHS compatibility correction but before the
source-backed sign-domain hypothesis `Theorem4ParameterDomainOnHorizon` was
added.  It is recorded only so the false-statement refactor has a formal
Step-0 target for the theorem head that allowed negative step sizes. -/
def AMSGrad_theorem4_wellDefinedRunOnHorizon_extension_preParameterDomainHead :
    Prop :=
  ∀ {d : ℕ} (setup : Setup d) (T : ℕ)
    (run : Run setup)
    (_hT : 1 ≤ T)
    (_h_corrected_extension_run : WellDefinedRunOnHorizon setup run T)
    (_h_rhs_compat : totalizedRHSCompatibilityObligation setup run T)
    (_h_grad_bound_T : BoundedGradientsOnHorizon setup T)
    (_h_alpha_schedule_T :
      ∀ t ∈ Finset.Icc 1 T, IsTheorem4StepSizeAt setup t (setup.alpha_t t))
    (_h_beta1t_le_T :
      ∀ t ∈ Finset.Icc 1 T, setup.beta1t t ≤ beta1 setup),
    ∃ B, IsTheorem4Bound setup run T B ∧
      regretAgainstInfimum setup run T ≤ B

private noncomputable def preDomainUnit : CoordinateSpace 1 :=
  EuclideanSpace.basisFun (Fin 1) ℝ 0

private theorem preDomainUnit_apply_zero : preDomainUnit 0 = 1 := by
  simp [preDomainUnit, EuclideanSpace.basisFun_apply]

private noncomputable def preDomainGradient : CoordinateSpace 1 :=
  (InnerProductSpace.toDual ℝ (CoordinateSpace 1)).symm
    ((innerSL ℝ) preDomainUnit)

private theorem preDomainGradient_eq_unit :
    preDomainGradient = preDomainUnit := by
  apply ext_inner_right ℝ
  intro v
  exact InnerProductSpace.toDual_symm_apply (𝕜 := ℝ)
    (E := CoordinateSpace 1) (x := v)
    (y := (innerSL ℝ) preDomainUnit)

private theorem preDomainLinear_hasGradientAt (x : CoordinateSpace 1) :
    HasGradientAt (fun y : CoordinateSpace 1 => inner ℝ preDomainUnit y)
      preDomainUnit x := by
  have hgrad :
      HasGradientAt (fun y : CoordinateSpace 1 => inner ℝ preDomainUnit y)
        preDomainGradient x :=
    (((innerSL ℝ) preDomainUnit).hasFDerivAt (x := x)).hasGradientAt
  simpa [preDomainGradient_eq_unit] using hgrad

private theorem inner_hasGradientAt_self (g x : CoordinateSpace 1) :
    HasGradientAt (fun y : CoordinateSpace 1 => inner ℝ g y) g x := by
  let rg : CoordinateSpace 1 :=
    (InnerProductSpace.toDual ℝ (CoordinateSpace 1)).symm ((innerSL ℝ) g)
  have hrg : rg = g := by
    apply ext_inner_right ℝ
    intro v
    exact InnerProductSpace.toDual_symm_apply (𝕜 := ℝ)
      (E := CoordinateSpace 1) (x := v) (y := (innerSL ℝ) g)
  have hgrad :
      HasGradientAt (fun y : CoordinateSpace 1 => inner ℝ g y) rg x :=
    (((innerSL ℝ) g).hasFDerivAt (x := x)).hasGradientAt
  simpa [hrg] using hgrad

private theorem preDomainLinear_eval (x : CoordinateSpace 1) :
    inner ℝ preDomainUnit x = x 0 := by
  simpa [preDomainUnit] using
    EuclideanSpace.basisFun_inner (Fin 1) ℝ x 0

private theorem linftyNorm_zero_dim1 :
    linftyNorm (0 : CoordinateSpace 1) = 0 := by
  simp [linftyNorm]

private theorem linftyNorm_preDomainUnit :
    linftyNorm preDomainUnit = 1 := by
  rw [linftyNorm, Pi.norm_def]
  simp [preDomainUnit, EuclideanSpace.basisFun_apply]

private theorem singleton_weightedProjectionArgmin_preDomainUnit
    (metric : MatrixSpace 1) (trial : CoordinateSpace 1) :
    IsWeightedProjectionArgmin ({preDomainUnit} : Set (CoordinateSpace 1))
      metric trial preDomainUnit := by
  refine ⟨by simp, ?_⟩
  rw [isMinOn_univ_iff]
  intro z
  have hz : (⟨preDomainUnit, by simp⟩ :
      {z : CoordinateSpace 1 // z ∈ ({preDomainUnit} : Set (CoordinateSpace 1))}) = z := by
    apply Subtype.ext
    exact (Set.mem_singleton_iff.mp z.2).symm
  rw [← hz]

private theorem diagonalMatrix_dim1_posDef (a : ℝ) (ha : 0 < a) :
    IsPositiveDefiniteMatrix
      (diagonalMatrix (WithLp.toLp 2 (fun _ : Fin 1 => a) : CoordinateSpace 1)) := by
  constructor
  · intro i j
    fin_cases i
    fin_cases j
    simp [diagonalMatrix]
  · intro x hx
    have hx0 : x 0 ≠ 0 := by
      intro hzero
      apply hx
      ext i
      fin_cases i
      simpa using hzero
    have hquad :
        matrixQuadraticForm
          (diagonalMatrix
            (WithLp.toLp 2 (fun _ : Fin 1 => a) : CoordinateSpace 1)) x =
          a * (x 0) ^ 2 := by
      simp [matrixQuadraticForm, matrixVec, diagonalMatrix, Fin.sum_univ_one,
        pow_two, mul_assoc]
      ring
    rw [hquad]
    exact mul_pos ha (sq_pos_of_ne_zero hx0)

