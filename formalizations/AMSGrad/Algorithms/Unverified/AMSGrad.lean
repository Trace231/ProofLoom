private theorem preDomain_rawProjectedUpdate
    (t : ℕ) (state : State 1) (m : CoordinateSpace 1) :
    IsAlgorithm2ProjectedUpdate preDomainCounterexampleSetup t state m
      preDomainVhat preDomainUnit := by
  let sqrtVhat : CoordinateSpace 1 := preDomainSqrtVhat
  let direction : CoordinateSpace 1 :=
    WithLp.toLp 2
      (fun i : Fin 1 => scalarQuotient (m i) (Real.sqrt (3 / 4 : ℝ)))
  let trial : CoordinateSpace 1 :=
    state.x - preDomainCounterexampleSetup.alpha_t t • direction
  refine ⟨sqrtVhat, direction, trial, ?_, ?_, rfl, ?_⟩
  · exact isCoordSqrt_const_dim1 (3 / 4) (Real.sqrt (3 / 4))
      preDomain_sqrt_three_four
  · intro i
    fin_cases i
    dsimp [sqrtVhat, direction, preDomainSqrtVhat]
    exact (isScalarQuotient_scalarQuotient
      (m 0) (Real.sqrt (3 / 4 : ℝ))
      (ne_of_gt preDomain_sqrt_three_four_pos)).2
  · exact preDomain_displayedProjection
      (amsgradProjectionMetricFromSqrt sqrtVhat) trial

private theorem preDomain_checkedProjectedUpdate
    (t : ℕ) (state : State 1) (m : CoordinateSpace 1) :
    IsWellDefinedProjectedUpdate preDomainCounterexampleSetup t state m
      preDomainVhat preDomainUnit := by
  let sqrtVhat : CoordinateSpace 1 := preDomainSqrtVhat
  let direction : CoordinateSpace 1 :=
    WithLp.toLp 2
      (fun i : Fin 1 => scalarQuotient (m i) (Real.sqrt (3 / 4 : ℝ)))
