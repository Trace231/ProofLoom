private theorem preDomain_sqrt_three_four :
    IsScalarSqrt (3 / 4 : ℝ) (Real.sqrt (3 / 4 : ℝ)) := by
  exact ⟨Real.sqrt_nonneg _, Real.sq_sqrt (by norm_num)⟩

private theorem preDomain_sqrt_three_four_pos :
    0 < Real.sqrt (3 / 4 : ℝ) := by
  have hsq := (preDomain_sqrt_three_four).2
  have hnonneg := (preDomain_sqrt_three_four).1
  nlinarith

