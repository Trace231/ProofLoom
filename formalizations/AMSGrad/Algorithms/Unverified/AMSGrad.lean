private noncomputable def preDomainCounterexampleSetup : Setup 1 where
  F := {preDomainUnit}
  x₁ := ⟨preDomainUnit, by simp⟩
  f := fun t x =>
    if t = 1 then inner ℝ preDomainUnit x else inner ℝ preDomainSqrtVhat x
  alpha_t := fun _ => -1
  alpha := -1
  beta1t := fun _ => 0
  beta2 := 1 / 4
  Dinf := 0
  Ginf := 1
  h_loss_convex := by
    intro t
    constructor
    · exact convex_singleton preDomainUnit
    · intro x hx y hy a b ha hb hab
      rw [Set.mem_singleton_iff.mp hx, Set.mem_singleton_iff.mp hy]
      have hline : a • preDomainUnit + b • preDomainUnit = preDomainUnit := by
        rw [← add_smul, hab, one_smul]
      rw [hline]
      by_cases ht : t = 1
      · simp [ht, ← add_mul, hab]
      · simp [ht, ← add_mul, hab]
  hF_convex := by
    exact convex_singleton preDomainUnit
  h_diameter := by
    intro x hx y hy
    rw [Set.mem_singleton_iff.mp hx, Set.mem_singleton_iff.mp hy]
    simpa [linftyNorm_zero_dim1]
  h_gamma_lt_one := by
    refine ⟨(1 / 2 : ℝ), 0, ?_, ?_, ?_⟩
    · exact ⟨by norm_num, by norm_num⟩
    · exact ⟨by norm_num, by norm_num [beta1]⟩
    · norm_num

