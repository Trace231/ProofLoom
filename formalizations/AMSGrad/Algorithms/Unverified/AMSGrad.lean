private theorem amsgrad_mSeq_coord_abs_le_geometric_history {d : ℕ}
    (setup : Setup d) (run : Run setup) (T : ℕ)
    (hdom : Theorem4ParameterDomainOnHorizon setup T)
    (hbeta_le : ∀ t ∈ Finset.Icc 1 T, setup.beta1t t ≤ beta1 setup)
    (hbeta_den : beta1 setup < 1 ∧
      ∀ t ∈ Finset.Icc 1 T, 0 < 1 - setup.beta1t t) :
    ∀ t ∈ Finset.Icc 1 T, ∀ i : Fin d,
      |mSeq setup run t i| ≤
        ∑ j ∈ Finset.Icc 1 t,
          (beta1 setup) ^ (t - j) * |gSeq setup run j i| := by
  intro t ht i
  induction t with
  | zero =>
      simp at ht
  | succ n ih =>
      cases n with
      | zero =>
          have ht1 : 1 ∈ Finset.Icc 1 T := by simpa using ht
          have hrec :
              mSeq setup run 1 i =
                (1 - setup.beta1t 1) * gSeq setup run 1 i := by
            have hvec := mSeq_succ_eq setup run 0
            have hcoord := congrArg (fun x : CoordinateSpace d => x i) hvec
            simpa [firstMoment, mSeq, stateSeq_zero, initialState] using hcoord
          have hb_nonneg : 0 ≤ beta1 setup := by
            simpa [beta1] using
              theorem4ParameterDomain_beta1t_nonneg setup T 1 hdom ht1
          have hone_nonneg : 0 ≤ 1 - beta1 setup := by
            nlinarith [hbeta_den.1]
          have hone_le : 1 - beta1 setup ≤ 1 := by
            nlinarith [hb_nonneg]
          calc
            |mSeq setup run 1 i|
                = (1 - beta1 setup) * |gSeq setup run 1 i| := by
                  have hcoeff :
                      1 - setup.beta1t 1 = 1 - beta1 setup := by
                    simp [beta1]
                  calc
                    |mSeq setup run 1 i|
                        = |(1 - setup.beta1t 1) *
                            gSeq setup run 1 i| := by rw [hrec]
                    _ = |1 - beta1 setup| *
                          |gSeq setup run 1 i| := by
                          rw [hcoeff, abs_mul]
                    _ = (1 - beta1 setup) *
                          |gSeq setup run 1 i| := by
                          rw [abs_of_nonneg hone_nonneg]
            _ ≤ 1 * |gSeq setup run 1 i| := by
                  exact mul_le_mul_of_nonneg_right hone_le (abs_nonneg _)
            _ = ∑ j ∈ Finset.Icc 1 1,
                  (beta1 setup) ^ (1 - j) * |gSeq setup run j i| := by
                  simp
      | succ n =>
          have htcur : n + 2 ∈ Finset.Icc 1 T := by simpa using ht
          have htprev : n + 1 ∈ Finset.Icc 1 T := by
            have htb := Finset.mem_Icc.mp htcur
            exact Finset.mem_Icc.mpr ⟨by omega, by omega⟩
          have hrec :
              mSeq setup run (n + 2) i =
                setup.beta1t (n + 2) * mSeq setup run (n + 1) i +
                  (1 - setup.beta1t (n + 2)) *
                    gSeq setup run (n + 2) i := by
            have hvec := mSeq_succ_eq setup run (n + 1)
            have hcoord := congrArg (fun x : CoordinateSpace d => x i) hvec
            simpa [firstMoment] using hcoord
          have hb_t_nonneg : 0 ≤ setup.beta1t (n + 2) :=
            theorem4ParameterDomain_beta1t_nonneg setup T (n + 2) hdom htcur
          have hb_global_nonneg : 0 ≤ beta1 setup := by
            have hmem1 : 1 ∈ Finset.Icc 1 T := by
              have htb := Finset.mem_Icc.mp htcur
              exact Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
            simpa [beta1] using
              theorem4ParameterDomain_beta1t_nonneg setup T 1 hdom hmem1
          have hone_t_nonneg : 0 ≤ 1 - setup.beta1t (n + 2) :=
            le_of_lt (hbeta_den.2 (n + 2) htcur)
          have hone_t_le_one : 1 - setup.beta1t (n + 2) ≤ 1 := by
            nlinarith [hb_t_nonneg]
          have hprev := ih htprev
          have hsum_shift :
              setup.beta1t (n + 2) *
                  (∑ j ∈ Finset.Icc 1 (n + 1),
                    (beta1 setup) ^ (n + 1 - j) *
                      |gSeq setup run j i|) ≤
                ∑ j ∈ Finset.Icc 1 (n + 1),
                    (beta1 setup) ^ (n + 2 - j) *
                      |gSeq setup run j i| := by
            calc
              setup.beta1t (n + 2) *
                  (∑ j ∈ Finset.Icc 1 (n + 1),
                    (beta1 setup) ^ (n + 1 - j) *
                      |gSeq setup run j i|)
                  = ∑ j ∈ Finset.Icc 1 (n + 1),
                      setup.beta1t (n + 2) *
                        ((beta1 setup) ^ (n + 1 - j) *
                          |gSeq setup run j i|) := by
                    rw [Finset.mul_sum]
              _ ≤ ∑ j ∈ Finset.Icc 1 (n + 1),
                    (beta1 setup) ^ (n + 2 - j) *
                      |gSeq setup run j i| := by
                    refine Finset.sum_le_sum ?_
                    intro j hj
                    have hjb := Finset.mem_Icc.mp hj
                    have hpow_shift : n + 2 - j = (n + 1 - j) + 1 := by
                      omega
                    have hterm_nonneg :
                        0 ≤ (beta1 setup) ^ (n + 1 - j) *
                          |gSeq setup run j i| := by
                      exact mul_nonneg
                        (pow_nonneg hb_global_nonneg (n + 1 - j))
                        (abs_nonneg _)
                    calc
                      setup.beta1t (n + 2) *
                          ((beta1 setup) ^ (n + 1 - j) *
                            |gSeq setup run j i|)
                          ≤ beta1 setup *
                              ((beta1 setup) ^ (n + 1 - j) *
                                |gSeq setup run j i|) := by
                            exact mul_le_mul_of_nonneg_right
                              (hbeta_le (n + 2) htcur) hterm_nonneg
                      _ = (beta1 setup) ^ (n + 2 - j) *
                            |gSeq setup run j i| := by
                            rw [hpow_shift, pow_succ]
                            ring
          have htop_le :
              (1 - setup.beta1t (n + 2)) *
                  |gSeq setup run (n + 2) i| ≤
                |gSeq setup run (n + 2) i| := by
            calc
              (1 - setup.beta1t (n + 2)) *
                  |gSeq setup run (n + 2) i|
                  ≤ 1 * |gSeq setup run (n + 2) i| := by
                    exact mul_le_mul_of_nonneg_right hone_t_le_one
                      (abs_nonneg _)
              _ = |gSeq setup run (n + 2) i| := by ring
          calc
            |mSeq setup run (n + 2) i|
                ≤ setup.beta1t (n + 2) * |mSeq setup run (n + 1) i| +
                    (1 - setup.beta1t (n + 2)) *
                      |gSeq setup run (n + 2) i| := by
                  rw [hrec]
                  calc
                    |setup.beta1t (n + 2) * mSeq setup run (n + 1) i +
                        (1 - setup.beta1t (n + 2)) *
                          gSeq setup run (n + 2) i|
                        ≤ |setup.beta1t (n + 2) *
                            mSeq setup run (n + 1) i| +
                          |(1 - setup.beta1t (n + 2)) *
                            gSeq setup run (n + 2) i| := abs_add_le _ _
                    _ = setup.beta1t (n + 2) *
                          |mSeq setup run (n + 1) i| +
                        (1 - setup.beta1t (n + 2)) *
                          |gSeq setup run (n + 2) i| := by
                          rw [abs_mul, abs_mul,
                            abs_of_nonneg hb_t_nonneg,
                            abs_of_nonneg hone_t_nonneg]
            _ ≤ setup.beta1t (n + 2) *
                  (∑ j ∈ Finset.Icc 1 (n + 1),
                    (beta1 setup) ^ (n + 1 - j) *
                      |gSeq setup run j i|) +
                (1 - setup.beta1t (n + 2)) *
                  |gSeq setup run (n + 2) i| := by
                  simpa [add_comm, add_left_comm, add_assoc] using
                    add_le_add_right
                      (mul_le_mul_of_nonneg_left hprev hb_t_nonneg)
                      ((1 - setup.beta1t (n + 2)) *
                        |gSeq setup run (n + 2) i|)
            _ ≤ ∑ j ∈ Finset.Icc 1 (n + 1),
                    (beta1 setup) ^ (n + 2 - j) *
                      |gSeq setup run j i| +
                |gSeq setup run (n + 2) i| := by
                  exact add_le_add hsum_shift htop_le
            _ = ∑ j ∈ Finset.Icc 1 (n + 2),
                    (beta1 setup) ^ (n + 2 - j) *
                      |gSeq setup run j i| := by
                  rw [Finset.sum_Icc_succ_top (by omega : 1 ≤ n + 2)]
                  simp

/-- Weighted Cauchy-Schwarz numerator estimate in Appendix D Eq. (17).

Pre-searched candidates considered and rejected: Mathlib's
`Real.sum_mul_le_sqrt_mul_sqrt` supplies the raw finite Cauchy inequality but
does not include the AMSGrad geometric-tail budget; SOptLib weighted-window and
finite-sum hits target stochastic integrals or active predecessor counts rather
than this deterministic scalar history.  This helper packages the exact
source step `(\sum β₁^{t-j}|g_j|)^2 ≤ (1/(1-β₁))\sum β₁^{t-j}g_j^2`. -/
private theorem amsgrad_weighted_geometric_cauchy_sq
    (beta : ℝ) (hbeta_nonneg : 0 ≤ beta) (hbeta_lt : beta < 1)
    (t : ℕ) (g : ℕ → ℝ) :
    (∑ j ∈ Finset.Icc 1 t, beta ^ (t - j) * |g j|) ^ 2 ≤
      (1 / (1 - beta)) *
        (∑ j ∈ Finset.Icc 1 t, beta ^ (t - j) * (g j) ^ 2) := by
  let s := Finset.Icc 1 t
  let w : ℕ → ℝ := fun j => beta ^ (t - j)
  have hw_nonneg : ∀ j, 0 ≤ w j := fun j => pow_nonneg hbeta_nonneg _
  have hsumw_nonneg : 0 ≤ ∑ j ∈ s, w j := by
    exact Finset.sum_nonneg (fun j _hj => hw_nonneg j)
  have hsumg_nonneg : 0 ≤ ∑ j ∈ s, w j * (g j) ^ 2 := by
    exact Finset.sum_nonneg (fun j _hj =>
      mul_nonneg (hw_nonneg j) (sq_nonneg _))
  have hleft_nonneg :
      0 ≤ ∑ j ∈ s, w j * |g j| := by
    exact Finset.sum_nonneg (fun j _hj =>
      mul_nonneg (hw_nonneg j) (abs_nonneg _))
  have hcs_raw :=
    Real.sum_mul_le_sqrt_mul_sqrt s
      (fun j => Real.sqrt (w j))
      (fun j => Real.sqrt (w j) * |g j|)
  have hleft_eq :
      (∑ j ∈ s, Real.sqrt (w j) *
          (Real.sqrt (w j) * |g j|)) =
        ∑ j ∈ s, w j * |g j| := by
    refine Finset.sum_congr rfl ?_
    intro j _hj
    rw [← mul_assoc, ← sq]
    rw [Real.sq_sqrt (hw_nonneg j)]
  have hfirst_eq :
      (∑ j ∈ s, (Real.sqrt (w j)) ^ 2) =
        ∑ j ∈ s, w j := by
    refine Finset.sum_congr rfl ?_
    intro j _hj
    exact Real.sq_sqrt (hw_nonneg j)
  have hsecond_eq :
      (∑ j ∈ s, (Real.sqrt (w j) * |g j|) ^ 2) =
        ∑ j ∈ s, w j * (g j) ^ 2 := by
    refine Finset.sum_congr rfl ?_
    intro j _hj
    rw [mul_pow, sq_abs, Real.sq_sqrt (hw_nonneg j)]
  have hcs :
      (∑ j ∈ s, w j * |g j|) ≤
        Real.sqrt (∑ j ∈ s, w j) *
          Real.sqrt (∑ j ∈ s, w j * (g j) ^ 2) := by
    simpa [hleft_eq, hfirst_eq, hsecond_eq] using hcs_raw
  have hsquared :
      (∑ j ∈ s, w j * |g j|) ^ 2 ≤
        (∑ j ∈ s, w j) * (∑ j ∈ s, w j * (g j) ^ 2) := by
    have hrhs_nonneg :
        0 ≤ Real.sqrt (∑ j ∈ s, w j) *
          Real.sqrt (∑ j ∈ s, w j * (g j) ^ 2) := by
      exact mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
    have habs :
        |((∑ j ∈ s, w j * |g j|) : ℝ)| ≤
          |(Real.sqrt (∑ j ∈ s, w j) *
            Real.sqrt (∑ j ∈ s, w j * (g j) ^ 2) : ℝ)| := by
      simpa [abs_of_nonneg hleft_nonneg, abs_of_nonneg hrhs_nonneg] using hcs
    have hsq_le := sq_le_sq.2 habs
    calc
      (∑ j ∈ s, w j * |g j|) ^ 2
          ≤ (Real.sqrt (∑ j ∈ s, w j) *
              Real.sqrt (∑ j ∈ s, w j * (g j) ^ 2)) ^ 2 := hsq_le
      _ = (∑ j ∈ s, w j) * (∑ j ∈ s, w j * (g j) ^ 2) := by
          rw [mul_pow, Real.sq_sqrt hsumw_nonneg,
            Real.sq_sqrt hsumg_nonneg]
  have hgeom :
      (∑ j ∈ s, w j) ≤ 1 / (1 - beta) := by
    have hrewrite :
        (∑ j ∈ s, w j) =
          ∑ k ∈ Finset.range t, beta ^ k := by
      dsimp [s, w]
      by_cases ht_pos : 1 ≤ t
      · have hbij :
            (∑ j ∈ Finset.Icc 1 t, beta ^ (t - j)) =
              ∑ k ∈ Finset.range t, beta ^ k := by
          refine Finset.sum_bij (fun j _hj => t - j) ?_ ?_ ?_ ?_
          · intro j hj
            have hjb := Finset.mem_Icc.mp hj
            change t - j ∈ Finset.range t
            exact Finset.mem_range.mpr (by omega)
          · intro a ha b hb hab
            have hab' : t - a = t - b := hab
            have ha_le : a ≤ t := (Finset.mem_Icc.mp ha).2
            have hb_le : b ≤ t := (Finset.mem_Icc.mp hb).2
            omega
          · intro k hk
            have hk_lt : k < t := Finset.mem_range.mp hk
            refine ⟨t - k, ?_, ?_⟩
            · change t - k ∈ Finset.Icc 1 t
              exact Finset.mem_Icc.mpr ⟨by omega, by omega⟩
            · change t - (t - k) = k
              exact Nat.sub_sub_self (Nat.le_of_lt hk_lt)
          · intro j hj
            rfl
        exact hbij
      · have ht_zero : t = 0 := by omega
        subst t
        simp
    rw [hrewrite]
    exact amsgrad_geometric_range_sum_le beta hbeta_nonneg hbeta_lt t
  calc
    (∑ j ∈ Finset.Icc 1 t, beta ^ (t - j) * |g j|) ^ 2
        = (∑ j ∈ s, w j * |g j|) ^ 2 := by rfl
    _ ≤ (∑ j ∈ s, w j) * (∑ j ∈ s, w j * (g j) ^ 2) := hsquared
    _ ≤ (1 / (1 - beta)) * (∑ j ∈ s, w j * (g j) ^ 2) := by
        exact mul_le_mul_of_nonneg_right hgeom hsumg_nonneg
    _ = (1 / (1 - beta)) *
        (∑ j ∈ Finset.Icc 1 t, beta ^ (t - j) * (g j) ^ 2) := by
        rfl

/-- Appendix D Eq. (17) denominator transport for one coordinate and one
history index.

No SOptLib match: checked the pre-searched recursive-process, mirror-step,
block-iterate, and independence candidates, searched `sqrt denominator
transport square vhat beta gamma`, and scanned the local Cauchy/sqrt helpers;
none align with the paper's scalar conversion from
`(1 - β₂) β₂^k g_j^2 ≤ \hat v_t` and `√β₂ * γ = β₁` to the literal
Eq. (17) summand bound. -/
private theorem amsgrad_eq17_denominator_transport
    {beta1 beta2 sqrtBeta2 gamma sqrtOneMinus V g : ℝ} (k : ℕ)
    (hsqrtBeta2 : IsScalarSqrt beta2 sqrtBeta2)
    (hgamma : IsScalarQuotient beta1 sqrtBeta2 gamma)
    (hsqrtOneMinus : IsScalarSqrt (1 - beta2) sqrtOneMinus)
    (hgamma_nonneg : 0 ≤ gamma)
    (hV_pos : 0 < V)
    (hsqrtOneMinus_pos : 0 < sqrtOneMinus)
    (hv : (1 - beta2) * beta2 ^ k * g ^ 2 ≤ V ^ 2) :
    beta1 ^ k * g ^ 2 / V ≤ gamma ^ k * |g| / sqrtOneMinus := by
  have hsqrtBeta2_nonneg : 0 ≤ sqrtBeta2 := hsqrtBeta2.1
  have hbase_nonneg :
      0 ≤ sqrtOneMinus * sqrtBeta2 ^ k * |g| := by
    exact mul_nonneg
      (mul_nonneg (le_of_lt hsqrtOneMinus_pos)
        (pow_nonneg hsqrtBeta2_nonneg k))
      (abs_nonneg g)
  have hV_nonneg : 0 ≤ V := le_of_lt hV_pos
  have hpow_sq :
      (sqrtBeta2 ^ k) ^ 2 = (sqrtBeta2 ^ 2) ^ k := by
    induction k with
    | zero =>
        simp
    | succ k ih =>
        simp [pow_succ, mul_pow, ih, pow_two]
        ring
  have hsq_identity :
      (sqrtOneMinus * sqrtBeta2 ^ k * |g|) ^ 2 =
        (1 - beta2) * beta2 ^ k * g ^ 2 := by
    rw [mul_pow, mul_pow, sq_abs, hpow_sq, hsqrtOneMinus.2,
      hsqrtBeta2.2]
  have hbase_sq_le : (sqrtOneMinus * sqrtBeta2 ^ k * |g|) ^ 2 ≤ V ^ 2 := by
    simpa [hsq_identity] using hv
  have habs_le : |(sqrtOneMinus * sqrtBeta2 ^ k * |g|)| ≤ |V| := by
    exact sq_le_sq.mp hbase_sq_le
  have hbase_le : sqrtOneMinus * sqrtBeta2 ^ k * |g| ≤ V := by
    simpa [abs_of_nonneg hbase_nonneg, abs_of_nonneg hV_nonneg] using habs_le
  have hratio_le : sqrtBeta2 ^ k * |g| / V ≤ 1 / sqrtOneMinus := by
    field_simp [ne_of_gt hV_pos, ne_of_gt hsqrtOneMinus_pos]
    nlinarith [hbase_le]
  have hcoef_nonneg : 0 ≤ gamma ^ k * |g| := by
    exact mul_nonneg (pow_nonneg hgamma_nonneg k) (abs_nonneg g)
  calc
    beta1 ^ k * g ^ 2 / V
        = gamma ^ k * |g| * (sqrtBeta2 ^ k * |g| / V) := by
          rw [← hgamma.2, mul_pow, ← sq_abs g]
          field_simp [ne_of_gt hV_pos]
    _ ≤ gamma ^ k * |g| * (1 / sqrtOneMinus) := by
          exact mul_le_mul_of_nonneg_left hratio_le hcoef_nonneg
    _ = gamma ^ k * |g| / sqrtOneMinus := by
          field_simp [ne_of_gt hsqrtOneMinus_pos]

/-- Horizon-indexed coordinate form of the generated second-moment recursion.

SOptLib candidates considered: stochastic-oracle second-moment lemmas bound
integrals or residual variances, while Appendix D Eq. (17) needs the literal
Algorithm 2 coordinate recurrence
`v_t,i = β₂ v_{t-1,i} + (1-β₂) g_t,i^2`. -/
private theorem vSeq_coord_eq_on_horizon {d : ℕ}
    (setup : Setup d) (run : Run setup) (T : ℕ) :
    ∀ t ∈ Finset.Icc 1 T, ∀ i : Fin d,
      vSeq setup run t i =
        setup.beta2 * vSeq setup run (t - 1) i +
          (1 - setup.beta2) * (gSeq setup run t i) ^ 2 := by
  intro t ht i
  have ht_ge_one : 1 ≤ t := (Finset.mem_Icc.mp ht).1
  have ht_succ : (t - 1) + 1 = t := Nat.sub_add_cancel ht_ge_one
  have hv_t :
      vSeq setup run t =
        secondMoment setup (stateSeq setup run (t - 1)) (gSeq setup run t) := by
    simpa [ht_succ] using vSeq_succ_eq setup run (t - 1)
  calc
    vSeq setup run t i
        = secondMoment setup (stateSeq setup run (t - 1))
            (gSeq setup run t) i := by rw [hv_t]
    _ = setup.beta2 * vSeq setup run (t - 1) i +
          (1 - setup.beta2) * (gSeq setup run t i) ^ 2 := by
          simp [secondMoment, coordSquare, vSeq]

/-- Long-term memory dominates the current second moment at each coordinate.

SOptLib candidates considered: the available triangular/telescope helpers do
not expose AMSGrad's coordinatewise `max(\hat v_{t-1}, v_t)` update.  This is
the source-local bridge from Algorithm 2 long-term memory to the denominator
lower bound used in Appendix D Eq. (17). -/
private theorem vSeq_le_vhatSeq_on_horizon {d : ℕ}
    (setup : Setup d) (run : Run setup) (T : ℕ) :
    ∀ t ∈ Finset.Icc 1 T, ∀ i : Fin d,
      vSeq setup run t i ≤ vhatSeq setup run t i := by
  intro t ht i
  have ht_ge_one : 1 ≤ t := (Finset.mem_Icc.mp ht).1
  have ht_succ : (t - 1) + 1 = t := Nat.sub_add_cancel ht_ge_one
  have hvhat_t :
      vhatSeq setup run t =
        longTermMemory (stateSeq setup run (t - 1)) (vSeq setup run t) := by
    simpa [ht_succ] using vhatSeq_succ_eq setup run (t - 1)
  calc
    vSeq setup run t i
        ≤ (longTermMemory (stateSeq setup run (t - 1))
            (vSeq setup run t)) i := by
          simp [longTermMemory, coordMax]
    _ = vhatSeq setup run t i := by
          exact congrArg (fun z : CoordinateSpace d => z i) hvhat_t.symm

/-- Nonnegativity of the generated second-moment coordinates on a finite
horizon.

SOptLib candidates considered: stochastic-oracle second-moment bounds concern
integrals of random residuals; Appendix D Eq. (17) needs the deterministic
Algorithm 2 recurrence with nonnegative coefficients `β₂` and `1-β₂`. -/
private theorem vSeq_coord_nonneg_on_horizon {d : ℕ}
    (setup : Setup d) (run : Run setup) (T : ℕ)
    (hbeta2_nonneg : 0 ≤ setup.beta2)
    (honeMinusBeta2_nonneg : 0 ≤ 1 - setup.beta2) :
    ∀ t, t ≤ T → ∀ i : Fin d, 0 ≤ vSeq setup run t i := by
  intro t
  induction t with
  | zero =>
      intro _ht i
      simp [vSeq, stateSeq_zero, initialState]
  | succ n ih =>
      intro hle i
      have ht_mem : n + 1 ∈ Finset.Icc 1 T :=
        Finset.mem_Icc.mpr ⟨Nat.succ_pos n, hle⟩
      have hrec := vSeq_coord_eq_on_horizon setup run T (n + 1) ht_mem i
      have hprev_nonneg : 0 ≤ vSeq setup run n i := ih (by omega) i
      have hbeta_part : 0 ≤ setup.beta2 * vSeq setup run n i :=
        mul_nonneg hbeta2_nonneg hprev_nonneg
      have hgrad_part :
          0 ≤ (1 - setup.beta2) * (gSeq setup run (n + 1) i) ^ 2 :=
        mul_nonneg honeMinusBeta2_nonneg (sq_nonneg _)
      rw [hrec]
      exact add_nonneg hbeta_part hgrad_part

/-- A single gradient-history square is retained in the generated
second-moment sequence with its geometric `β₂` weight.

SOptLib candidates considered: finite weighted second-moment and oracle
variance lemmas are probabilistic or normalized-budget statements.  Appendix D
Eq. (17) needs the literal deterministic unroll consequence
`(1-β₂)β₂^(t-j)g_j,i^2 ≤ v_t,i` from Algorithm 2. -/
private theorem vSeq_coord_lower_single_history_term {d : ℕ}
    (setup : Setup d) (run : Run setup) (T : ℕ)
    (hbeta2_nonneg : 0 ≤ setup.beta2)
    (honeMinusBeta2_nonneg : 0 ≤ 1 - setup.beta2) :
    ∀ t ∈ Finset.Icc 1 T, ∀ j ∈ Finset.Icc 1 t, ∀ i : Fin d,
      (1 - setup.beta2) * setup.beta2 ^ (t - j) *
          (gSeq setup run j i) ^ 2 ≤
        vSeq setup run t i := by
  intro t ht
  induction t with
  | zero =>
      simp at ht
  | succ n ih =>
      intro j hj i
      cases n with
      | zero =>
          have hj_eq : j = 1 := by
            have hj_bounds := Finset.mem_Icc.mp hj
            omega
          subst j
          have hrec := vSeq_coord_eq_on_horizon setup run T 1 ht i
          have hv0 : vSeq setup run 0 i = 0 := by
            simp [vSeq, stateSeq_zero, initialState]
          rw [hrec, hv0]
          ring_nf
          exact le_rfl
      | succ n =>
          have hcur_eq : n.succ.succ = n + 2 := rfl
          have hprev_mem : n + 1 ∈ Finset.Icc 1 T := by
            have ht_bounds := Finset.mem_Icc.mp ht
            exact Finset.mem_Icc.mpr ⟨by omega, by omega⟩
          have hrec :=
            vSeq_coord_eq_on_horizon setup run T (n + 2) (by simpa using ht) i
          have hrec' :
              vSeq setup run (n + 2) i =
                setup.beta2 * vSeq setup run (n + 1) i +
                  (1 - setup.beta2) * (gSeq setup run (n + 2) i) ^ 2 := by
            simpa using hrec
          by_cases hj_top : j = n + 2
          · subst j
            have hprev_nonneg :
                0 ≤ setup.beta2 * vSeq setup run (n + 1) i := by
              exact mul_nonneg hbeta2_nonneg
                (vSeq_coord_nonneg_on_horizon setup run T
                  hbeta2_nonneg honeMinusBeta2_nonneg (n + 1)
                  (Finset.mem_Icc.mp hprev_mem).2 i)
            rw [hrec']
            have hpow : setup.beta2 ^ (n + 2 - (n + 2)) = 1 := by
              norm_num
            rw [hpow]
            nlinarith [hprev_nonneg]
          · have hj_prev : j ∈ Finset.Icc 1 (n + 1) := by
              have hj_bounds := Finset.mem_Icc.mp hj
              exact Finset.mem_Icc.mpr ⟨hj_bounds.1, by omega⟩
            have hih := ih hprev_mem j hj_prev i
            have hshift :
                n + 2 - j = (n + 1 - j) + 1 := by
              have hj_bounds := Finset.mem_Icc.mp hj
              omega
            have hterm_shift :
                (1 - setup.beta2) * setup.beta2 ^ (n + 2 - j) *
                    (gSeq setup run j i) ^ 2 =
                  setup.beta2 *
                    ((1 - setup.beta2) * setup.beta2 ^ (n + 1 - j) *
                      (gSeq setup run j i) ^ 2) := by
              rw [hshift, pow_succ]
              ring
            have hscaled :
                setup.beta2 *
                    ((1 - setup.beta2) * setup.beta2 ^ (n + 1 - j) *
                      (gSeq setup run j i) ^ 2) ≤
                  setup.beta2 * vSeq setup run (n + 1) i :=
              mul_le_mul_of_nonneg_left hih hbeta2_nonneg
            have hgrad_nonneg :
                0 ≤ (1 - setup.beta2) * (gSeq setup run (n + 2) i) ^ 2 :=
              mul_nonneg honeMinusBeta2_nonneg (sq_nonneg _)
            calc
              (1 - setup.beta2) * setup.beta2 ^ (n + 2 - j) *
                  (gSeq setup run j i) ^ 2
                  = setup.beta2 *
                      ((1 - setup.beta2) * setup.beta2 ^ (n + 1 - j) *
                        (gSeq setup run j i) ^ 2) := hterm_shift
              _ ≤ setup.beta2 * vSeq setup run (n + 1) i := hscaled
              _ ≤ setup.beta2 * vSeq setup run (n + 1) i +
                    (1 - setup.beta2) * (gSeq setup run (n + 2) i) ^ 2 := by
                    exact le_add_of_nonneg_right hgrad_nonneg
              _ = vSeq setup run (n + 2) i := by
                    rw [hrec']

/-- Trial-square expansion in the theorem's ambient inner-product notation.

This is a notational corollary of
`amsgrad_projection_trial_square_expansion_on_horizon`; the only extra bridge
is `coordinate_inner_eq_sum`, proved from `PiLp.inner_apply`.  It remains below
the full Eq. (15) statement because it has not yet substituted the first-moment
recursion or applied the Young/Cauchy bound to the previous-momentum term. -/
private theorem amsgrad_projection_trial_square_expansion_inner_on_horizon {d : ℕ}
    (setup : Setup d) (run : Run setup) (T : ℕ)
    (xStar : CoordinateSpace d)
    (hwell : WellDefinedRunOnHorizon setup run T)
    (hxStar : xStar ∈ setup.F) :
    ∀ t ∈ Finset.Icc 1 T,
      ∃ sqrtVhat direction,
        IsCoordSqrt (vhatSeq setup run t) sqrtVhat ∧
        IsCoordQuotient (mSeq setup run t) sqrtVhat direction ∧
        (∑ i, sqrtVhat i * ((xSeq setup run (t + 1) - xStar) i) ^ 2) ≤
          (∑ i, sqrtVhat i * ((xSeq setup run t - xStar) i) ^ 2) -
            2 * setup.alpha_t t *
              inner ℝ (mSeq setup run t) (xSeq setup run t - xStar) +
            (setup.alpha_t t) ^ 2 *
              (∑ i, sqrtVhat i * (direction i) ^ 2) := by
  intro t ht
  rcases amsgrad_projection_trial_square_expansion_on_horizon
      setup run T xStar hwell hxStar t ht with
    ⟨sqrtVhat, direction, hsqrt, hquot, hle⟩
  refine ⟨sqrtVhat, direction, hsqrt, hquot, ?_⟩
  simpa [coordinate_inner_eq_sum] using hle

/-- Pointwise projection/momentum inequality before the Young/Cauchy
absorption of the previous-momentum term.

This is the front algebra of Appendix D Eq. (15): it combines the checked
projection square expansion with the first-moment recursion and divides by the
positive `2 * α_t * (1-β₁t)`.  It is intentionally below the full Eq. (15)
helper because the final paper step still has to bound
`-β₁t/(1-β₁t) * ⟪m_{t-1}, x_t-x*⟫` by the standard coordinate Young term. -/
private theorem amsgrad_projection_pre_young_bound_on_horizon {d : ℕ}
    (setup : Setup d) (run : Run setup) (T : ℕ)
    (xStar : CoordinateSpace d)
    (hwell : WellDefinedRunOnHorizon setup run T)
    (hxStar : xStar ∈ setup.F)
    (hdom : Theorem4ParameterDomainOnHorizon setup T)
    (hbeta_den : beta1 setup < 1 ∧
      ∀ t ∈ Finset.Icc 1 T, 0 < 1 - setup.beta1t t) :
    ∀ t ∈ Finset.Icc 1 T,
      ∃ sqrtVhat direction,
        IsCoordSqrt (vhatSeq setup run t) sqrtVhat ∧
        IsCoordQuotient (mSeq setup run t) sqrtVhat direction ∧
        inner ℝ (gSeq setup run t) (xSeq setup run t - xStar) ≤
          ((∑ i, sqrtVhat i * ((xSeq setup run t - xStar) i) ^ 2) -
              (∑ i, sqrtVhat i * ((xSeq setup run (t + 1) - xStar) i) ^ 2)) /
              (2 * setup.alpha_t t * (1 - setup.beta1t t)) +
            (setup.alpha_t t *
                (∑ i, sqrtVhat i * (direction i) ^ 2)) /
              (2 * (1 - setup.beta1t t)) -
            (setup.beta1t t / (1 - setup.beta1t t)) *
              inner ℝ (mSeq setup run (t - 1)) (xSeq setup run t - xStar) := by
  intro t ht
  rcases amsgrad_projection_trial_square_expansion_inner_on_horizon
      setup run T xStar hwell hxStar t ht with
    ⟨sqrtVhat, direction, hsqrt, hquot, hproj_expansion⟩
  refine ⟨sqrtVhat, direction, hsqrt, hquot, ?_⟩
  let y : CoordinateSpace d := xSeq setup run t - xStar
  let beta : ℝ := setup.beta1t t
  let alpha : ℝ := setup.alpha_t t
  let A : ℝ := ∑ i, sqrtVhat i * ((xSeq setup run t - xStar) i) ^ 2
  let N : ℝ := ∑ i, sqrtVhat i * ((xSeq setup run (t + 1) - xStar) i) ^ 2
  let C : ℝ := ∑ i, sqrtVhat i * (direction i) ^ 2
  let M : ℝ := inner ℝ (mSeq setup run t) y
  let P : ℝ := inner ℝ (mSeq setup run (t - 1)) y
  let G : ℝ := inner ℝ (gSeq setup run t) y
  have halpha : 0 < alpha := by
    exact theorem4ParameterDomain_alpha_t_pos setup T t hdom ht
  have hden : 0 < 1 - beta := by
    exact hbeta_den.2 t ht
  have hproj_expansion' : N ≤ A - 2 * alpha * M + alpha ^ 2 * C := by
    simpa [A, N, C, M, y, alpha] using hproj_expansion
  have hmrec : M = beta * P + (1 - beta) * G := by
    simpa [M, P, G, y, beta] using
      mSeq_inner_eq_on_horizon setup run T t ht y
  have htwoalpha_pos : 0 < 2 * alpha := by nlinarith
  have hM_mul : M * (2 * alpha) ≤ A - N + alpha ^ 2 * C := by
    nlinarith
  have hM_bound : M ≤ (A - N + alpha ^ 2 * C) / (2 * alpha) := by
    exact (le_div_iff₀ htwoalpha_pos).2 hM_mul
  have hG_scaled :
      (1 - beta) * G ≤
        (A - N + alpha ^ 2 * C) / (2 * alpha) - beta * P := by
    nlinarith
  have hG_bound :
      G ≤ ((A - N + alpha ^ 2 * C) / (2 * alpha) - beta * P) /
          (1 - beta) := by
    exact (le_div_iff₀ hden).2 (by
      simpa [mul_comm] using hG_scaled)
  have halpha_ne : alpha ≠ 0 := ne_of_gt halpha
  have hden_ne : 1 - beta ≠ 0 := ne_of_gt hden
  calc
    inner ℝ (gSeq setup run t) (xSeq setup run t - xStar)
        = G := by simp [G, y]
    _ ≤ ((A - N + alpha ^ 2 * C) / (2 * alpha) - beta * P) /
          (1 - beta) := hG_bound
    _ = (A - N) / (2 * alpha * (1 - beta)) +
          (alpha * C) / (2 * (1 - beta)) -
          (beta / (1 - beta)) * P := by
          field_simp [halpha_ne, hden_ne]
    _ = ((∑ i, sqrtVhat i * ((xSeq setup run t - xStar) i) ^ 2) -
              (∑ i, sqrtVhat i * ((xSeq setup run (t + 1) - xStar) i) ^ 2)) /
              (2 * setup.alpha_t t * (1 - setup.beta1t t)) +
            (setup.alpha_t t *
                (∑ i, sqrtVhat i * (direction i) ^ 2)) /
              (2 * (1 - setup.beta1t t)) -
            (setup.beta1t t / (1 - setup.beta1t t)) *
              inner ℝ (mSeq setup run (t - 1)) (xSeq setup run t - xStar) := by
          simp [A, N, C, P, alpha, beta, y]

/-- Pointwise Appendix D Eq. (15) after Young/Cauchy absorption of the
previous-momentum cross term.

SOptLib candidates considered: `mirror_descent_sum_bound_of_three_point_and_young`
matches the broad mirror-descent theme but is too abstract for the AMSGrad
diagonal RHS; `scaled_linear_inner_quadratic_le_square_over_denominator` and
`inner_sub_sub_bregman_le_half_dual_sq` do not expose the coordinate quotient
witnesses.  This helper is therefore the local source-form Eq. (15) bridge,
specializing the proved pre-Young AMSGrad projection inequality and the
coordinate Young lemma above. -/
private theorem amsgrad_projection_young_bound_on_horizon {d : ℕ}
    (setup : Setup d) (run : Run setup) (T : ℕ)
    (xStar : CoordinateSpace d)
    (hwell : WellDefinedRunOnHorizon setup run T)
    (hxStar : xStar ∈ setup.F)
    (hdom : Theorem4ParameterDomainOnHorizon setup T)
    (hbeta_den : beta1 setup < 1 ∧
      ∀ t ∈ Finset.Icc 1 T, 0 < 1 - setup.beta1t t) :
    ∀ t ∈ Finset.Icc 1 T,
      ∃ sqrtVhat direction,
        IsCoordSqrt (vhatSeq setup run t) sqrtVhat ∧
        IsCoordQuotient (mSeq setup run t) sqrtVhat direction ∧
        inner ℝ (gSeq setup run t) (xSeq setup run t - xStar) ≤
          ((∑ i, sqrtVhat i * ((xSeq setup run t - xStar) i) ^ 2) -
              (∑ i, sqrtVhat i * ((xSeq setup run (t + 1) - xStar) i) ^ 2)) /
              (2 * setup.alpha_t t * (1 - setup.beta1t t)) +
            (setup.alpha_t t *
                (∑ i, sqrtVhat i * (direction i) ^ 2)) /
              (2 * (1 - setup.beta1t t)) +
            (setup.beta1t t * setup.alpha_t t *
                (∑ i, (mSeq setup run (t - 1) i) ^ 2 / sqrtVhat i)) /
              (2 * (1 - setup.beta1t t)) +
            (setup.beta1t t *
                (∑ i, sqrtVhat i * ((xSeq setup run t - xStar) i) ^ 2)) /
              (2 * setup.alpha_t t * (1 - setup.beta1t t)) := by
  intro t ht
  rcases amsgrad_projection_pre_young_bound_on_horizon
      setup run T xStar hwell hxStar hdom hbeta_den t ht with
    ⟨sqrtVhat, direction, hsqrt, hquot, hpre⟩
  refine ⟨sqrtVhat, direction, hsqrt, hquot, ?_⟩
  let y : CoordinateSpace d := xSeq setup run t - xStar
  let metricDrop : ℝ :=
    ((∑ i, sqrtVhat i * ((xSeq setup run t - xStar) i) ^ 2) -
      (∑ i, sqrtVhat i * ((xSeq setup run (t + 1) - xStar) i) ^ 2)) /
      (2 * setup.alpha_t t * (1 - setup.beta1t t))
  let currentMomentum : ℝ :=
    (setup.alpha_t t * (∑ i, sqrtVhat i * (direction i) ^ 2)) /
      (2 * (1 - setup.beta1t t))
  let previousRaw : ℝ :=
    - (setup.beta1t t / (1 - setup.beta1t t)) *
      inner ℝ (mSeq setup run (t - 1)) y
  let previousMomentum : ℝ :=
    (setup.beta1t t * setup.alpha_t t *
      (∑ i, (mSeq setup run (t - 1) i) ^ 2 / sqrtVhat i)) /
      (2 * (1 - setup.beta1t t))
  let betaMetric : ℝ :=
    (setup.beta1t t *
      (∑ i, sqrtVhat i * ((xSeq setup run t - xStar) i) ^ 2)) /
      (2 * setup.alpha_t t * (1 - setup.beta1t t))
  have halpha : 0 < setup.alpha_t t :=
    theorem4ParameterDomain_alpha_t_pos setup T t hdom ht
  have hbeta : 0 ≤ setup.beta1t t :=
    theorem4ParameterDomain_beta1t_nonneg setup T t hdom ht
  have hden : 0 < 1 - setup.beta1t t := hbeta_den.2 t ht
  have hsqrt_pos : ∀ i : Fin d, 0 < sqrtVhat i := by
    intro i
    exact lt_of_le_of_ne (hsqrt i).1 (Ne.symm (hquot i).1)
  have hyoung :
      previousRaw ≤ previousMomentum + betaMetric := by
    simpa [previousRaw, previousMomentum, betaMetric, y] using
      coordinate_scaled_negative_inner_young_bound
        (d := d) (alpha := setup.alpha_t t) (beta := setup.beta1t t)
        (sqrtV := sqrtVhat) (m := mSeq setup run (t - 1)) (y := y)
        halpha hbeta hden hsqrt_pos
  have hpre' :
      inner ℝ (gSeq setup run t) (xSeq setup run t - xStar) ≤
        metricDrop + currentMomentum + previousRaw := by
    unfold metricDrop currentMomentum previousRaw y
    convert hpre using 1
    ring
  calc
    inner ℝ (gSeq setup run t) (xSeq setup run t - xStar)
        ≤ metricDrop + currentMomentum + previousRaw := hpre'
    _ ≤ metricDrop + currentMomentum + previousMomentum + betaMetric := by
        linarith
    _ =
        ((∑ i, sqrtVhat i * ((xSeq setup run t - xStar) i) ^ 2) -
              (∑ i, sqrtVhat i * ((xSeq setup run (t + 1) - xStar) i) ^ 2)) /
              (2 * setup.alpha_t t * (1 - setup.beta1t t)) +
            (setup.alpha_t t *
                (∑ i, sqrtVhat i * (direction i) ^ 2)) /
              (2 * (1 - setup.beta1t t)) +
            (setup.beta1t t * setup.alpha_t t *
                (∑ i, (mSeq setup run (t - 1) i) ^ 2 / sqrtVhat i)) /
              (2 * (1 - setup.beta1t t)) +
            (setup.beta1t t *
                (∑ i, sqrtVhat i * ((xSeq setup run t - xStar) i) ^ 2)) /
              (2 * setup.alpha_t t * (1 - setup.beta1t t)) := by
        simp [metricDrop, currentMomentum, previousMomentum, betaMetric]

/-- Coordinatewise uniqueness for the relational square-root witnesses used in
Algorithm 2 and the Theorem 4 RHS.

No SOptLib match: searched `coordinate square root uniqueness nonnegative sq
eq` and `Real sqrt unique nonnegative square equal`; the hits are unrelated
moment/norm infrastructure.  Mathlib's `sq_eq_sq_iff_eq_or_eq_neg` gives the
needed scalar split, and the nonnegativity fields in `IsScalarSqrt` rule out
the negative branch. -/
private theorem coord_sqrt_unique {d : ℕ} {v r s : CoordinateSpace d} :
    IsCoordSqrt v r → IsCoordSqrt v s → r = s := by
  intro hr hs
  ext i
  exact congrFun
    (_root_.fun_eq_of_forall_nonneg_sq_eq
      (r := fun i => r i) (s := fun i => s i)
      (fun i => (hr i).1)
      (fun i => (hs i).1)
      (fun i => by rw [(hr i).2, (hs i).2])) i

/-- Scalar finite-window telescope used by Appendix D Eq. (18).

SOptLib candidates considered: `sum_weighted_sub_mul_le_first_sub_tail` is the
closest telescope primitive, but its summand has the form
`c_t * (V_{t-1} - beta_t * V_t)` and does not expose the AMSGrad
`(1 + β₁t)` current-coordinate coefficient created by adding the metric and
beta-metric terms; `sum_Icc_sub_succ` and
`sum_range_sub_succ_le_first_of_last_nonneg` telescope only plain successive
differences.  This helper records the source-specific Eq. (18) scalar
coefficient step: carry the negative terminal tail, use the nonincreasing
`β₁t` schedule to control the middle coefficient, then bound squared
coordinate distances by `D2`. -/
private theorem amsgrad_metric_beta_telescope_scalar
    (a beta y : ℕ → ℝ) (T : ℕ) (D2 betaMax : ℝ)
    (hT : 1 ≤ T)
    (hy_nonneg : ∀ t, 1 ≤ t → t ≤ T + 1 → 0 ≤ y t)
    (hy_le : ∀ t, 1 ≤ t → t ≤ T → y t ≤ D2)
    (ha_nonneg : ∀ t, 1 ≤ t → t ≤ T → 0 ≤ a t)
    (ha_mono : ∀ t, 2 ≤ t → t ≤ T → a (t - 1) ≤ a t)
    (hbeta_nonneg : ∀ t, 1 ≤ t → t ≤ T → 0 ≤ beta t)
    (hbeta_le : ∀ t, 1 ≤ t → t ≤ T → beta t ≤ betaMax)
    (hbeta_mono : ∀ t, 2 ≤ t → t ≤ T → beta t ≤ beta (t - 1))
    (hbetaMax_lt : betaMax < 1) :
    (∑ t ∈ Finset.Icc 1 T, (
        a t * (y t - y (t + 1)) / (1 - beta t) +
          beta t * a t * y t / (1 - beta t))) ≤
      D2 / (1 - betaMax) *
        (a T + ∑ t ∈ Finset.Icc 1 T, beta t * a t) := by
  classical
  have hdenMax_pos : 0 < 1 - betaMax := by linarith
  have hD2_nonneg : 0 ≤ D2 := by
    exact le_trans (hy_nonneg 1 (by norm_num) (Nat.le_trans hT (Nat.le_succ T)))
      (hy_le 1 (by norm_num) hT)
  have hstrong : ∀ k, (hk1 : 1 ≤ k) → k ≤ T →
      (∑ t ∈ Finset.Icc 1 k, (
          a t * (y t - y (t + 1)) / (1 - beta t) +
            beta t * a t * y t / (1 - beta t))) ≤
        D2 / (1 - betaMax) *
            (a k + ∑ t ∈ Finset.Icc 1 k, beta t * a t) -
          a k * y (k + 1) / (1 - beta k) := by
    intro k hk1
    induction k, hk1 using Nat.le_induction with
    | base =>
        intro hkT
        have ha1 : 0 ≤ a 1 := ha_nonneg 1 (by norm_num) hkT
        have hb1 : 0 ≤ beta 1 := hbeta_nonneg 1 (by norm_num) hkT
        have hb1_le : beta 1 ≤ betaMax := hbeta_le 1 (by norm_num) hkT
        have hden1_pos : 0 < 1 - beta 1 := by linarith
        have hy1_le : y 1 ≤ D2 := hy_le 1 (by norm_num) hkT
        have hy1_nonneg : 0 ≤ y 1 :=
          hy_nonneg 1 (by norm_num) (Nat.le_trans hkT (Nat.le_succ T))
        have hrecip : (1 : ℝ) / (1 - beta 1) ≤ 1 / (1 - betaMax) := by
          exact one_div_le_one_div_of_le hdenMax_pos (by linarith)
        have hmain :
            a 1 * y 1 / (1 - beta 1) +
                beta 1 * a 1 * y 1 / (1 - beta 1) ≤
              D2 / (1 - betaMax) * (a 1 + beta 1 * a 1) := by
          have hpart1 :
              a 1 * y 1 / (1 - beta 1) ≤
                D2 / (1 - betaMax) * a 1 := by
            have hcoef : a 1 * ((1 : ℝ) / (1 - beta 1)) ≤
                a 1 * (1 / (1 - betaMax)) :=
              mul_le_mul_of_nonneg_left hrecip ha1
            calc
              a 1 * y 1 / (1 - beta 1)
                  = (a 1 * ((1 : ℝ) / (1 - beta 1))) * y 1 := by ring
              _ ≤ (a 1 * (1 / (1 - betaMax))) * y 1 := by
                  exact mul_le_mul_of_nonneg_right hcoef hy1_nonneg
              _ ≤ (a 1 * (1 / (1 - betaMax))) * D2 := by
                  exact mul_le_mul_of_nonneg_left hy1_le (by positivity)
              _ = D2 / (1 - betaMax) * a 1 := by ring
          have hpart2 :
              beta 1 * a 1 * y 1 / (1 - beta 1) ≤
                D2 / (1 - betaMax) * (beta 1 * a 1) := by
            have hba_nonneg : 0 ≤ beta 1 * a 1 := mul_nonneg hb1 ha1
            have hcoef : beta 1 * a 1 * ((1 : ℝ) / (1 - beta 1)) ≤
                beta 1 * a 1 * (1 / (1 - betaMax)) :=
              mul_le_mul_of_nonneg_left hrecip hba_nonneg
            calc
              beta 1 * a 1 * y 1 / (1 - beta 1)
                  = (beta 1 * a 1 * ((1 : ℝ) / (1 - beta 1))) * y 1 := by
                    ring
              _ ≤ (beta 1 * a 1 * (1 / (1 - betaMax))) * y 1 := by
                  exact mul_le_mul_of_nonneg_right hcoef hy1_nonneg
              _ ≤ (beta 1 * a 1 * (1 / (1 - betaMax))) * D2 := by
                  exact mul_le_mul_of_nonneg_left hy1_le (by positivity)
              _ = D2 / (1 - betaMax) * (beta 1 * a 1) := by ring
          nlinarith [hpart1, hpart2]
        have hbase_goal :
            a 1 * (y 1 - y (1 + 1)) / (1 - beta 1) +
                beta 1 * a 1 * y 1 / (1 - beta 1) ≤
              D2 / (1 - betaMax) * (a 1 + beta 1 * a 1) -
                a 1 * y (1 + 1) / (1 - beta 1) := by
          calc
            a 1 * (y 1 - y (1 + 1)) / (1 - beta 1) +
                beta 1 * a 1 * y 1 / (1 - beta 1)
                = (a 1 * y 1 / (1 - beta 1) +
                    beta 1 * a 1 * y 1 / (1 - beta 1)) -
                  a 1 * y (1 + 1) / (1 - beta 1) := by ring
            _ ≤ D2 / (1 - betaMax) * (a 1 + beta 1 * a 1) -
                  a 1 * y (1 + 1) / (1 - beta 1) := by
                exact sub_le_sub_right hmain _
        simpa [Finset.Icc_self] using hbase_goal
    | succ n hn ih =>
        intro hsuccT
        have hnT : n ≤ T := Nat.le_trans (Nat.le_succ n) hsuccT
        have hsum_split :
            (∑ t ∈ Finset.Icc 1 (n + 1), (
                a t * (y t - y (t + 1)) / (1 - beta t) +
                  beta t * a t * y t / (1 - beta t))) =
              (∑ t ∈ Finset.Icc 1 n, (
                a t * (y t - y (t + 1)) / (1 - beta t) +
                  beta t * a t * y t / (1 - beta t))) +
                (a (n + 1) * (y (n + 1) - y (n + 2)) /
                    (1 - beta (n + 1)) +
                  beta (n + 1) * a (n + 1) * y (n + 1) /
                    (1 - beta (n + 1))) := by
          rw [Finset.sum_Icc_succ_top (Nat.le_succ_of_le hn)]
        rw [hsum_split]
        have hih := ih hnT
        have hden_n_pos : 0 < 1 - beta n := by
          have hb_le := hbeta_le n hn hnT
          linarith
        have hden_succ_pos : 0 < 1 - beta (n + 1) := by
          have hb_le := hbeta_le (n + 1) (Nat.le_succ_of_le hn) hsuccT
          linarith
        have ha_n_nonneg : 0 ≤ a n := ha_nonneg n hn hnT
        have ha_succ_nonneg : 0 ≤ a (n + 1) :=
          ha_nonneg (n + 1) (Nat.le_succ_of_le hn) hsuccT
        have hb_succ_nonneg : 0 ≤ beta (n + 1) :=
          hbeta_nonneg (n + 1) (Nat.le_succ_of_le hn) hsuccT
        have ha_step : a n ≤ a (n + 1) := by
          have hpred : n + 1 - 1 = n := Nat.succ_sub_one n
          simpa [hpred] using
            ha_mono (n + 1) (Nat.succ_le_succ hn) hsuccT
        have hb_step : beta (n + 1) ≤ beta n :=
          hbeta_mono (n + 1) (Nat.succ_le_succ hn) hsuccT
        have hrecip_step :
            (1 : ℝ) / (1 - beta n) ≥ 1 / (1 - beta (n + 1)) := by
          have hden_le : 1 - beta n ≤ 1 - beta (n + 1) := by linarith
          exact one_div_le_one_div_of_le hden_n_pos hden_le
        have hrecip_succ_global :
            (1 : ℝ) / (1 - beta (n + 1)) ≤ 1 / (1 - betaMax) := by
          exact one_div_le_one_div_of_le hdenMax_pos
            (by
              have := hbeta_le (n + 1) (Nat.le_succ_of_le hn) hsuccT
              linarith)
        have hdelta_nonneg :
            0 ≤ (a (n + 1) - a n) + beta (n + 1) * a (n + 1) := by
          nlinarith [ha_step, mul_nonneg hb_succ_nonneg ha_succ_nonneg]
        have hcoeff_le :
            a (n + 1) / (1 - beta (n + 1)) +
                beta (n + 1) * a (n + 1) / (1 - beta (n + 1)) -
              a n / (1 - beta n) ≤
            ((a (n + 1) - a n) + beta (n + 1) * a (n + 1)) /
              (1 - betaMax) := by
          have hneg_transport :
              a n / (1 - beta (n + 1)) ≤ a n / (1 - beta n) := by
            have hcoef := mul_le_mul_of_nonneg_left hrecip_step ha_n_nonneg
            simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using hcoef
          have hlocal :
              a (n + 1) / (1 - beta (n + 1)) +
                  beta (n + 1) * a (n + 1) / (1 - beta (n + 1)) -
                a n / (1 - beta n) ≤
              ((a (n + 1) - a n) + beta (n + 1) * a (n + 1)) /
                (1 - beta (n + 1)) := by
            calc
              a (n + 1) / (1 - beta (n + 1)) +
                    beta (n + 1) * a (n + 1) / (1 - beta (n + 1)) -
                  a n / (1 - beta n)
                  ≤ a (n + 1) / (1 - beta (n + 1)) +
                      beta (n + 1) * a (n + 1) / (1 - beta (n + 1)) -
                    a n / (1 - beta (n + 1)) := by
                    linarith
              _ = ((a (n + 1) - a n) +
                    beta (n + 1) * a (n + 1)) /
                  (1 - beta (n + 1)) := by ring
          have hglobal :
              ((a (n + 1) - a n) + beta (n + 1) * a (n + 1)) /
                (1 - beta (n + 1)) ≤
              ((a (n + 1) - a n) + beta (n + 1) * a (n + 1)) /
                (1 - betaMax) := by
            have hcoef := mul_le_mul_of_nonneg_left hrecip_succ_global
              hdelta_nonneg
            simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using hcoef
          exact le_trans hlocal hglobal
        have hy_succ_nonneg : 0 ≤ y (n + 1) :=
          hy_nonneg (n + 1) (Nat.le_succ_of_le hn)
            (Nat.le_trans hsuccT (Nat.le_succ T))
        have hy_succ_le : y (n + 1) ≤ D2 :=
          hy_le (n + 1) (Nat.le_succ_of_le hn) hsuccT
        have hmiddle :
            (a (n + 1) / (1 - beta (n + 1)) +
                beta (n + 1) * a (n + 1) / (1 - beta (n + 1)) -
              a n / (1 - beta n)) * y (n + 1) ≤
            D2 / (1 - betaMax) *
              ((a (n + 1) - a n) + beta (n + 1) * a (n + 1)) := by
          have hmul1 := mul_le_mul_of_nonneg_right hcoeff_le hy_succ_nonneg
          have hmul2 := mul_le_mul_of_nonneg_left hy_succ_le
            (div_nonneg hdelta_nonneg (le_of_lt hdenMax_pos))
          calc
            (a (n + 1) / (1 - beta (n + 1)) +
                beta (n + 1) * a (n + 1) / (1 - beta (n + 1)) -
              a n / (1 - beta n)) * y (n + 1)
                ≤ ((a (n + 1) - a n) +
                    beta (n + 1) * a (n + 1)) /
                    (1 - betaMax) * y (n + 1) := hmul1
            _ ≤ ((a (n + 1) - a n) +
                    beta (n + 1) * a (n + 1)) /
                    (1 - betaMax) * D2 := hmul2
            _ = D2 / (1 - betaMax) *
                  ((a (n + 1) - a n) +
                    beta (n + 1) * a (n + 1)) := by ring
        rw [Finset.sum_Icc_succ_top (Nat.le_succ_of_le hn)]
        calc
          (∑ t ∈ Finset.Icc 1 n,
              (a t * (y t - y (t + 1)) / (1 - beta t) +
                beta t * a t * y t / (1 - beta t))) +
              (a (n + 1) * (y (n + 1) - y (n + 2)) /
                  (1 - beta (n + 1)) +
                beta (n + 1) * a (n + 1) * y (n + 1) /
                  (1 - beta (n + 1)))
              ≤ (D2 / (1 - betaMax) *
                    (a n + ∑ t ∈ Finset.Icc 1 n, beta t * a t) -
                  a n * y (n + 1) / (1 - beta n)) +
                (a (n + 1) * (y (n + 1) - y (n + 2)) /
                    (1 - beta (n + 1)) +
                  beta (n + 1) * a (n + 1) * y (n + 1) /
                    (1 - beta (n + 1))) := by
                  simpa [add_comm, add_left_comm, add_assoc] using
                    add_le_add_right hih
                      (a (n + 1) * (y (n + 1) - y (n + 2)) /
                        (1 - beta (n + 1)) +
                      beta (n + 1) * a (n + 1) * y (n + 1) /
                        (1 - beta (n + 1)))
          _ = D2 / (1 - betaMax) *
                  (a n + ∑ t ∈ Finset.Icc 1 n, beta t * a t) +
                (a (n + 1) / (1 - beta (n + 1)) +
                    beta (n + 1) * a (n + 1) /
                      (1 - beta (n + 1)) -
                  a n / (1 - beta n)) * y (n + 1) -
                a (n + 1) * y (n + 2) /
                  (1 - beta (n + 1)) := by
                  ring
          _ ≤ D2 / (1 - betaMax) *
                  (a n + ∑ t ∈ Finset.Icc 1 n, beta t * a t) +
                D2 / (1 - betaMax) *
                  (a (n + 1) - a n +
                    beta (n + 1) * a (n + 1)) -
                a (n + 1) * y (n + 2) /
                  (1 - beta (n + 1)) := by
                  simpa [add_comm, add_left_comm, add_assoc] using
                    sub_le_sub_right
                      (add_le_add_left hmiddle
                        (D2 / (1 - betaMax) *
                          (a n + ∑ t ∈ Finset.Icc 1 n, beta t * a t)))
                      (a (n + 1) * y (n + 2) /
                        (1 - beta (n + 1)))
          _ = D2 / (1 - betaMax) *
                  (a (n + 1) +
                    (∑ t ∈ Finset.Icc 1 n, beta t * a t +
                      beta (n + 1) * a (n + 1))) -
                a (n + 1) * y (n + 1 + 1) /
                  (1 - beta (n + 1)) := by
                  ring
  have htail_nonneg :
      0 ≤ a T * y (T + 1) / (1 - beta T) := by
    have haT : 0 ≤ a T := ha_nonneg T hT le_rfl
    have hyT : 0 ≤ y (T + 1) := hy_nonneg (T + 1) (Nat.le_succ_of_le hT) le_rfl
    have hdenT : 0 < 1 - beta T := by
      have hb_le := hbeta_le T hT le_rfl
      linarith
    exact div_nonneg (mul_nonneg haT hyT) (le_of_lt hdenT)
  have h := hstrong T hT le_rfl
  nlinarith [h, htail_nonneg]

set_option maxHeartbeats 1200000

/-- Extension-only corrected AMSGrad Theorem 4 statement.

Source-boundary citation: `book/ICLR2018/AMSGrad.json#/main_theorem/statement_math`
states: "`Let {x_t} and {v_t} be the sequences obtained from Algorithm 2`" and
"`For x_t generated using the AMSGRAD (Algorithm 2), we have the following
bound on the regret`".  The added `WellDefinedRunOnHorizon` argument is the
explicit corrected boundary for PDF Section 2 notation-domain facts; the added
`totalizedRHSCompatibilityObligation` argument is the extension-only domain
boundary for the displayed Theorem 4 RHS quotients and square roots.  Neither
is a primitive assumption in the paper theorem.

This is not the unqualified paper theorem: it consumes
`WellDefinedRunOnHorizon`, the explicit corrected Algorithm 2 boundary carrying
the ordinary quotient and `Π_{F,A}` notation-domain facts that are absent from
the paper theorem assumptions, and `totalizedRHSCompatibilityObligation`, the
explicit corrected RHS compatibility boundary needed to construct
`IsTheorem4Bound` witnesses.  It also consumes
`Theorem4ParameterDomainOnHorizon`, the source-backed horizon sign boundary
needed for the regret inequality: positive step sizes and nonnegative
first-moment weights.  Finally, it consumes the explicit horizon-local
nonincreasing `β₁t` schedule required by the PDF Section 4 convergence-proof
prose and by the Appendix D Eq. (18) metric/beta telescope.  Round-31 scalar
exploration found oscillating schedules satisfying only `0 ≤ β₁t` and
`β₁t ≤ β₁` for which that planned telescope fails, so this extension boundary
must expose the schedule regularity rather than asking tactics to prove the
false old bridge.  Downstream proof work must not treat this as an A-level
original Theorem 4 formalization. -/
theorem AMSGrad_theorem4_wellDefinedRunOnHorizon_extension {d : ℕ}
    (setup : Setup d) (T : ℕ)
    (run : Run setup)
    (hT : 1 ≤ T)
    (h_corrected_extension_run : WellDefinedRunOnHorizon setup run T)
    (h_rhs_compat : totalizedRHSCompatibilityObligation setup run T)
    (h_parameter_domain_T : Theorem4ParameterDomainOnHorizon setup T)
    (h_grad_bound_T : BoundedGradientsOnHorizon setup T)
    (h_alpha_schedule_T :
      ∀ t ∈ Finset.Icc 1 T, IsTheorem4StepSizeAt setup t (setup.alpha_t t))
    (h_beta1t_le_T :
      ∀ t ∈ Finset.Icc 1 T, setup.beta1t t ≤ beta1 setup)
    (h_beta1t_nonincreasing_T :
      ∀ t ∈ Finset.Icc 2 T, setup.beta1t t ≤ setup.beta1t (t - 1)) :
    ∃ B, IsTheorem4Bound setup run T B ∧
      regretAgainstInfimum setup run T ≤ B := by
  rcases theorem4Bound_exists_of_rhsCompatibility
      setup run T hT h_corrected_extension_run h_rhs_compat with
    ⟨B, hB⟩
  refine ⟨B, hB, ?_⟩
  apply regretAgainstInfimum_le_of_uniform_comparator_bound setup run T B
  intro xStar hxStar
  have hconv := convex_regret_le_gradient_sum setup run T xStar
    h_corrected_extension_run hxStar
  have hbeta_den := amsgrad_beta1_lt_one_and_den_pos setup run T B hT
    h_parameter_domain_T h_beta1t_le_T hB
  have h_beta1t_nonincreasing_boundary :
      (∀ t ∈ Finset.Icc 2 T, setup.beta1t t ≤ setup.beta1t (t - 1)) :=
    h_beta1t_nonincreasing_T
  have hdiam_coord :
      ∀ t ∈ Finset.Icc 1 T, ∀ i : Fin d,
        (xSeq setup run t i - xStar i) ^ 2 ≤ setup.Dinf ^ 2 := by
    intro t ht i
    exact linfty_diameter_coord_sq_le setup
      (xSeq_mem_F_on_horizon setup run T t h_corrected_extension_run ht)
      hxStar i
  have hpoint_young :=
    amsgrad_projection_young_bound_on_horizon
      setup run T xStar h_corrected_extension_run hxStar
      h_parameter_domain_T hbeta_den
  rcases hB with
    ⟨sqrtT, sqrtBeta2, gamma, sqrtOneMinusBeta2, sqrtOnePlusLogT,
      firstCoeff, secondCoeff, thirdTerm, terminalVhatSqrt, adaptiveVhatSqrt,
      adaptiveTerm, historyNorm, hsqrtT, hsqrtBeta2, hgamma,
      hsqrtOneMinusBeta2, hsqrtOnePlusLogT, hterminal, hadaptive, hhistory,
      hgamma_lt, hfirst, hsecond, hadaptiveTerm, hthird, hB_eq⟩
  have hpoint_aligned :
      ∀ t ∈ Finset.Icc 1 T,
        ∃ direction,
          IsCoordQuotient (mSeq setup run t) (adaptiveVhatSqrt t) direction ∧
          inner ℝ (gSeq setup run t) (xSeq setup run t - xStar) ≤
            ((∑ i, adaptiveVhatSqrt t i * ((xSeq setup run t - xStar) i) ^ 2) -
                (∑ i, adaptiveVhatSqrt t i *
                  ((xSeq setup run (t + 1) - xStar) i) ^ 2)) /
                (2 * setup.alpha_t t * (1 - setup.beta1t t)) +
              (setup.alpha_t t *
                  (∑ i, adaptiveVhatSqrt t i * (direction i) ^ 2)) /
                (2 * (1 - setup.beta1t t)) +
              (setup.beta1t t * setup.alpha_t t *
                  (∑ i, (mSeq setup run (t - 1) i) ^ 2 /
                    adaptiveVhatSqrt t i)) /
                (2 * (1 - setup.beta1t t)) +
              (setup.beta1t t *
                  (∑ i, adaptiveVhatSqrt t i *
                    ((xSeq setup run t - xStar) i) ^ 2)) /
                (2 * setup.alpha_t t * (1 - setup.beta1t t)) := by
    intro t ht
    rcases hpoint_young t ht with
      ⟨sqrtVhat, direction, hsqrt, hquot, hle⟩
    have hsqrt_eq : sqrtVhat = adaptiveVhatSqrt t :=
      coord_sqrt_unique hsqrt (hadaptive t ht)
    subst sqrtVhat
    exact ⟨direction, hquot, hle⟩
  choose directionAt hquotAt hpointAt using hpoint_aligned
  have hT_mem : T ∈ Finset.Icc 1 T := Finset.mem_Icc.mpr ⟨hT, le_rfl⟩
  have hadaptive_terminal_eq : adaptiveVhatSqrt T = terminalVhatSqrt :=
    coord_sqrt_unique (hadaptive T hT_mem) hterminal
  let eq15RHS : (t : ℕ) → t ∈ Finset.Icc 1 T → ℝ := fun t ht =>
    ((∑ i, adaptiveVhatSqrt t i * ((xSeq setup run t - xStar) i) ^ 2) -
        (∑ i, adaptiveVhatSqrt t i *
          ((xSeq setup run (t + 1) - xStar) i) ^ 2)) /
        (2 * setup.alpha_t t * (1 - setup.beta1t t)) +
      (setup.alpha_t t *
          (∑ i, adaptiveVhatSqrt t i * (directionAt t ht i) ^ 2)) /
        (2 * (1 - setup.beta1t t)) +
      (setup.beta1t t * setup.alpha_t t *
          (∑ i, (mSeq setup run (t - 1) i) ^ 2 / adaptiveVhatSqrt t i)) /
        (2 * (1 - setup.beta1t t)) +
      (setup.beta1t t *
          (∑ i, adaptiveVhatSqrt t i *
            ((xSeq setup run t - xStar) i) ^ 2)) /
        (2 * setup.alpha_t t * (1 - setup.beta1t t))
  have hsum_eq15 :
      (∑ t ∈ Finset.Icc 1 T,
        inner ℝ (gSeq setup run t) (xSeq setup run t - xStar)) ≤
        ∑ t ∈ Finset.Icc 1 T,
          if ht : t ∈ Finset.Icc 1 T then eq15RHS t ht else 0 := by
    refine Finset.sum_le_sum ?_
    intro t ht
    simpa [eq15RHS, ht] using hpointAt t ht
  refine le_trans hconv ?_
  rw [hB_eq]
  refine le_trans hsum_eq15 ?_
  let metricDrop : (t : ℕ) → t ∈ Finset.Icc 1 T → ℝ := fun t ht =>
    ((∑ i, adaptiveVhatSqrt t i * ((xSeq setup run t - xStar) i) ^ 2) -
        (∑ i, adaptiveVhatSqrt t i *
          ((xSeq setup run (t + 1) - xStar) i) ^ 2)) /
        (2 * setup.alpha_t t * (1 - setup.beta1t t))
  let currentMomentum : (t : ℕ) → t ∈ Finset.Icc 1 T → ℝ := fun t ht =>
    (setup.alpha_t t *
        (∑ i, adaptiveVhatSqrt t i * (directionAt t ht i) ^ 2)) /
      (2 * (1 - setup.beta1t t))
  let previousMomentum : (t : ℕ) → t ∈ Finset.Icc 1 T → ℝ := fun t _ht =>
    (setup.beta1t t * setup.alpha_t t *
        (∑ i, (mSeq setup run (t - 1) i) ^ 2 /
          adaptiveVhatSqrt t i)) /
      (2 * (1 - setup.beta1t t))
  let betaMetric : (t : ℕ) → t ∈ Finset.Icc 1 T → ℝ := fun t _ht =>
    (setup.beta1t t *
        (∑ i, adaptiveVhatSqrt t i *
          ((xSeq setup run t - xStar) i) ^ 2)) /
      (2 * setup.alpha_t t * (1 - setup.beta1t t))
  let metricDropSum : ℝ := ∑ t ∈ Finset.Icc 1 T,
    if ht : t ∈ Finset.Icc 1 T then metricDrop t ht else 0
  let currentMomentumSum : ℝ := ∑ t ∈ Finset.Icc 1 T,
    if ht : t ∈ Finset.Icc 1 T then currentMomentum t ht else 0
  let previousMomentumSum : ℝ := ∑ t ∈ Finset.Icc 1 T,
    if ht : t ∈ Finset.Icc 1 T then previousMomentum t ht else 0
  let betaMetricSum : ℝ := ∑ t ∈ Finset.Icc 1 T,
    if ht : t ∈ Finset.Icc 1 T then betaMetric t ht else 0
  have hsplit_point : ∀ t ∈ Finset.Icc 1 T,
      (if ht : t ∈ Finset.Icc 1 T then eq15RHS t ht else 0) =
        (if ht : t ∈ Finset.Icc 1 T then metricDrop t ht else 0) +
          (if ht : t ∈ Finset.Icc 1 T then currentMomentum t ht else 0) +
          (if ht : t ∈ Finset.Icc 1 T then previousMomentum t ht else 0) +
          (if ht : t ∈ Finset.Icc 1 T then betaMetric t ht else 0) := by
    intro t ht
    simp only [dif_pos ht]
    dsimp [eq15RHS, metricDrop, currentMomentum, previousMomentum, betaMetric]
  have hsplit :
      (∑ t ∈ Finset.Icc 1 T,
        if ht : t ∈ Finset.Icc 1 T then eq15RHS t ht else 0) =
        metricDropSum + currentMomentumSum + previousMomentumSum +
          betaMetricSum := by
    calc
      (∑ t ∈ Finset.Icc 1 T,
        if ht : t ∈ Finset.Icc 1 T then eq15RHS t ht else 0)
          = ∑ t ∈ Finset.Icc 1 T,
              ((if ht : t ∈ Finset.Icc 1 T then metricDrop t ht else 0) +
                (if ht : t ∈ Finset.Icc 1 T then currentMomentum t ht
                  else 0) +
                (if ht : t ∈ Finset.Icc 1 T then previousMomentum t ht
                  else 0) +
                (if ht : t ∈ Finset.Icc 1 T then betaMetric t ht else 0)) := by
              refine Finset.sum_congr rfl ?_
              intro t ht
              exact hsplit_point t ht
      _ = metricDropSum + currentMomentumSum + previousMomentumSum +
            betaMetricSum := by
              simp only [Finset.sum_add_distrib]
              dsimp [metricDropSum, currentMomentumSum, previousMomentumSum,
                betaMetricSum]
  rw [hsplit]
  have hvhat_mono_step :
      ∀ t ∈ Finset.Icc 2 T, ∀ i : Fin d,
        vhatSeq setup run (t - 1) i ≤ vhatSeq setup run t i := by
    intro t ht i
    have ht_ge_one : 1 ≤ t :=
      le_trans (by norm_num : 1 ≤ 2) (Finset.mem_Icc.mp ht).1
    have ht_pred_succ : (t - 1) + 1 = t :=
      Nat.sub_add_cancel ht_ge_one
    have hvhat_eq :
        vhatSeq setup run t =
          longTermMemory (stateSeq setup run (t - 1)) (vSeq setup run t) := by
      simpa [ht_pred_succ] using vhatSeq_succ_eq setup run (t - 1)
    calc
      vhatSeq setup run (t - 1) i
          = (stateSeq setup run (t - 1)).vhat i := rfl
      _ ≤ (longTermMemory (stateSeq setup run (t - 1))
            (vSeq setup run t)) i := by
          simp [longTermMemory, coordMax]
      _ = vhatSeq setup run t i := by
          exact congrArg (fun z : CoordinateSpace d => z i) hvhat_eq.symm
  have hadaptive_sqrt_mono_step :
      ∀ t ∈ Finset.Icc 2 T, ∀ i : Fin d,
        adaptiveVhatSqrt (t - 1) i ≤ adaptiveVhatSqrt t i := by
    intro t ht i
    have ht_low : 2 ≤ t := (Finset.mem_Icc.mp ht).1
    have ht_high : t ≤ T := (Finset.mem_Icc.mp ht).2
    have ht_mem : t ∈ Finset.Icc 1 T := by
      exact Finset.mem_Icc.mpr ⟨by omega, ht_high⟩
    have ht_pred_mem : t - 1 ∈ Finset.Icc 1 T := by
      exact Finset.mem_Icc.mpr ⟨by omega, by omega⟩
    have hprev := hadaptive (t - 1) ht_pred_mem i
    have hcur := hadaptive t ht_mem i
    have hsq :
        (adaptiveVhatSqrt (t - 1) i) ^ 2 ≤
          (adaptiveVhatSqrt t i) ^ 2 := by
      rw [hprev.2, hcur.2]
      exact hvhat_mono_step t ht i
    have habs := (sq_le_sq.mp hsq)
    simpa [abs_of_nonneg hprev.1, abs_of_nonneg hcur.1] using habs
  have halpha_base_pos : 0 < setup.alpha :=
    theorem4ParameterDomain_alpha_pos setup T hT h_parameter_domain_T
      h_alpha_schedule_T
  have hstep_sqrt_pos_eq :
      ∀ t ∈ Finset.Icc 1 T,
        ∃ sqrtTime, 0 < sqrtTime ∧ sqrtTime * setup.alpha_t t =
          setup.alpha := by
    intro t ht
    rcases h_alpha_schedule_T t ht with
      ⟨sqrtTime, _hsqrtTime_eq, hsqrtTime, hquot⟩
    have ht_real_pos : 0 < (t : ℝ) := by
      exact_mod_cast
        (Nat.lt_of_lt_of_le Nat.zero_lt_one (Finset.mem_Icc.mp ht).1)
    have hsqrtTime_pos : 0 < sqrtTime := by
      nlinarith [hsqrtTime.1, hsqrtTime.2, ht_real_pos]
    exact ⟨sqrtTime, hsqrtTime_pos, hquot.2⟩
  have hinv_lr :
      ∀ t ∈ Finset.Icc 2 T, ∀ i : Fin d,
        adaptiveVhatSqrt (t - 1) i / setup.alpha_t (t - 1) ≤
          adaptiveVhatSqrt t i / setup.alpha_t t := by
    intro t ht i
    have ht_low : 2 ≤ t := (Finset.mem_Icc.mp ht).1
    have ht_high : t ≤ T := (Finset.mem_Icc.mp ht).2
    have ht_mem : t ∈ Finset.Icc 1 T :=
      Finset.mem_Icc.mpr ⟨by omega, ht_high⟩
    have ht_pred_mem : t - 1 ∈ Finset.Icc 1 T :=
      Finset.mem_Icc.mpr ⟨by omega, by omega⟩
    rcases hstep_sqrt_pos_eq (t - 1) ht_pred_mem with
      ⟨sqrtPrevStep, hsqrtPrevStep_pos, hstepPrev_eq⟩
    rcases hstep_sqrt_pos_eq t ht_mem with
      ⟨sqrtCurStep, hsqrtCurStep_pos, hstepCur_eq⟩
    have halpha_prev_pos : 0 < setup.alpha_t (t - 1) := by
      nlinarith [hsqrtPrevStep_pos, hstepPrev_eq, halpha_base_pos]
    have halpha_cur_pos : 0 < setup.alpha_t t := by
      nlinarith [hsqrtCurStep_pos, hstepCur_eq, halpha_base_pos]
    rcases h_alpha_schedule_T (t - 1) ht_pred_mem with
      ⟨sqrtPrev, _hsqrtPrev_eq, hsqrtPrev, hquotPrev⟩
    rcases h_alpha_schedule_T t ht_mem with
      ⟨sqrtCur, _hsqrtCur_eq, hsqrtCur, hquotCur⟩
    have hsqrtPrev_le_sqrtCur : sqrtPrev ≤ sqrtCur := by
      have hsq_le : sqrtPrev ^ 2 ≤ sqrtCur ^ 2 := by
        rw [hsqrtPrev.2, hsqrtCur.2]
        exact_mod_cast (Nat.sub_le t 1)
      have habs := (sq_le_sq.mp hsq_le)
      simpa [abs_of_nonneg hsqrtPrev.1, abs_of_nonneg hsqrtCur.1] using habs
    have hb_nonneg : 0 ≤ adaptiveVhatSqrt t i :=
      (hadaptive t ht_mem i).1
    have hv_le : adaptiveVhatSqrt (t - 1) i ≤ adaptiveVhatSqrt t i :=
      hadaptive_sqrt_mono_step t ht i
    have hprod_le :
        adaptiveVhatSqrt (t - 1) i * sqrtPrev ≤
          adaptiveVhatSqrt t i * sqrtCur := by
      calc
        adaptiveVhatSqrt (t - 1) i * sqrtPrev
            ≤ adaptiveVhatSqrt t i * sqrtPrev := by
              exact mul_le_mul_of_nonneg_right hv_le hsqrtPrev.1
        _ ≤ adaptiveVhatSqrt t i * sqrtCur := by
              exact mul_le_mul_of_nonneg_left hsqrtPrev_le_sqrtCur hb_nonneg
    have hprev_ratio_eq :
        adaptiveVhatSqrt (t - 1) i / setup.alpha_t (t - 1) =
          adaptiveVhatSqrt (t - 1) i * sqrtPrev / setup.alpha := by
      rw [← hquotPrev.2]
      field_simp [hquotPrev.1, ne_of_gt halpha_prev_pos]
    have hcur_ratio_eq :
        adaptiveVhatSqrt t i / setup.alpha_t t =
          adaptiveVhatSqrt t i * sqrtCur / setup.alpha := by
      rw [← hquotCur.2]
      field_simp [hquotCur.1, ne_of_gt halpha_cur_pos]
    calc
      adaptiveVhatSqrt (t - 1) i / setup.alpha_t (t - 1)
          = adaptiveVhatSqrt (t - 1) i * sqrtPrev / setup.alpha := hprev_ratio_eq
      _ ≤ adaptiveVhatSqrt t i * sqrtCur / setup.alpha := by
          exact div_le_div_of_nonneg_right hprod_le (le_of_lt halpha_base_pos)
      _ = adaptiveVhatSqrt t i / setup.alpha_t t := hcur_ratio_eq.symm
  have hsecond_eq :
      secondCoeff = setup.Dinf ^ 2 / (2 * (1 - beta1 setup)) := by
    rw [eq_div_iff hsecond.1]
    simpa [mul_comm] using hsecond.2
  have hadaptiveTerm_eq :
      ∀ t ∈ Finset.Icc 1 T, ∀ i : Fin d,
        adaptiveTerm t i =
          setup.beta1t t * adaptiveVhatSqrt t i / setup.alpha_t t := by
    intro t ht i
    have hq := hadaptiveTerm t ht i
    rw [eq_div_iff hq.1]
    simpa [mul_comm] using hq.2
  have hbetaMetric_expand :
      ∀ t (ht : t ∈ Finset.Icc 1 T),
        betaMetric t ht =
          ∑ i, (setup.beta1t t *
              (adaptiveVhatSqrt t i * ((xSeq setup run t - xStar) i) ^ 2)) /
            (2 * setup.alpha_t t * (1 - setup.beta1t t)) := by
    intro t ht
    dsimp [betaMetric]
    rw [← Finset.sum_div]
    congr 1
    rw [Finset.mul_sum]
  have hbeta_recip_le :
      ∀ t ∈ Finset.Icc 1 T,
        (1 : ℝ) / (1 - setup.beta1t t) ≤ 1 / (1 - beta1 setup) := by
    intro t ht
    have hden_global : 0 < 1 - beta1 setup := by
      nlinarith [hbeta_den.1]
    have hle_den : 1 - beta1 setup ≤ 1 - setup.beta1t t := by
      nlinarith [h_beta1t_le_T t ht]
    exact one_div_le_one_div_of_le hden_global hle_den
  have hbetaMetric_coord_le :
      ∀ t (ht : t ∈ Finset.Icc 1 T) (i : Fin d),
        (setup.beta1t t *
            (adaptiveVhatSqrt t i * ((xSeq setup run t - xStar) i) ^ 2)) /
          (2 * setup.alpha_t t * (1 - setup.beta1t t)) ≤
        (setup.Dinf ^ 2 / (2 * (1 - beta1 setup))) *
          (setup.beta1t t * adaptiveVhatSqrt t i / setup.alpha_t t) := by
    intro t ht i
    let b := setup.beta1t t
    let a := adaptiveVhatSqrt t i
    let dsq := ((xSeq setup run t - xStar) i) ^ 2
    let D2 := setup.Dinf ^ 2
    let alpha := setup.alpha_t t
    have halpha : 0 < alpha := by
      dsimp [alpha]
      exact theorem4ParameterDomain_alpha_t_pos setup T t h_parameter_domain_T ht
