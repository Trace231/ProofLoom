            (1 / (1 - beta1 setup)) *
              (∑ j ∈ Finset.Icc 1 t,
                beta1 setup ^ (t - j) * (gSeq setup run j i) ^ 2) :=
        le_trans hm_sq_le_history_sq hcauchy
      have hsum_transport :
          (∑ j ∈ Finset.Icc 1 t,
            beta1 setup ^ (t - j) * (gSeq setup run j i) ^ 2) /
              (adaptiveVhatSqrt t i) ≤
            ∑ j ∈ Finset.Icc 1 t,
              gamma ^ (t - j) * |gSeq setup run j i| /
                sqrtOneMinusBeta2 := by
        calc
          (∑ j ∈ Finset.Icc 1 t,
            beta1 setup ^ (t - j) * (gSeq setup run j i) ^ 2) /
              (adaptiveVhatSqrt t i)
              = ∑ j ∈ Finset.Icc 1 t,
                  (beta1 setup ^ (t - j) *
                    (gSeq setup run j i) ^ 2) /
                    (adaptiveVhatSqrt t i) := by
                  rw [← Finset.sum_div]
          _ ≤ ∑ j ∈ Finset.Icc 1 t,
                gamma ^ (t - j) * |gSeq setup run j i| /
                  sqrtOneMinusBeta2 := by
                exact Finset.sum_le_sum hterm_transport
      have hbeta_recip_nonneg :
          0 ≤ (1 / (1 - beta1 setup) : ℝ) := by
        positivity
      have hcore_unscaled :
          (mSeq setup run t i) ^ 2 / (adaptiveVhatSqrt t i) ≤
            (1 / (1 - beta1 setup)) *
              (∑ j ∈ Finset.Icc 1 t,
                gamma ^ (t - j) * |gSeq setup run j i| /
                  sqrtOneMinusBeta2) := by
        calc
          (mSeq setup run t i) ^ 2 / (adaptiveVhatSqrt t i)
              ≤ ((1 / (1 - beta1 setup)) *
                  (∑ j ∈ Finset.Icc 1 t,
                    beta1 setup ^ (t - j) *
                      (gSeq setup run j i) ^ 2)) /
                    (adaptiveVhatSqrt t i) := by
                  exact div_le_div_of_nonneg_right hm_sq_cauchy
                    (le_of_lt hden_pos)
          _ = (1 / (1 - beta1 setup)) *
                ((∑ j ∈ Finset.Icc 1 t,
                    beta1 setup ^ (t - j) *
                      (gSeq setup run j i) ^ 2) /
                    (adaptiveVhatSqrt t i)) := by
                  ring
          _ ≤ (1 / (1 - beta1 setup)) *
                (∑ j ∈ Finset.Icc 1 t,
                  gamma ^ (t - j) * |gSeq setup run j i| /
                    sqrtOneMinusBeta2) := by
                  exact mul_le_mul_of_nonneg_left hsum_transport
                    hbeta_recip_nonneg
      have hsum_gamma_div :
          (∑ j ∈ Finset.Icc 1 t,
            gamma ^ (t - j) * |gSeq setup run j i| /
              sqrtOneMinusBeta2) =
            (∑ j ∈ Finset.Icc 1 t,
              gamma ^ (t - j) * |gSeq setup run j i|) /
              sqrtOneMinusBeta2 := by
        rw [Finset.sum_div]
      have halpha_t_nonneg : 0 ≤ setup.alpha_t t := by
        exact le_of_lt
          (theorem4ParameterDomain_alpha_t_pos setup T t
            h_parameter_domain_T ht)
      calc
        setup.alpha_t t *
            ((mSeq setup run t i) ^ 2 / (adaptiveVhatSqrt t i))
            ≤ setup.alpha_t t *
                ((1 / (1 - beta1 setup)) *
                  ((∑ j ∈ Finset.Icc 1 t,
                    gamma ^ (t - j) * |gSeq setup run j i|) /
                    sqrtOneMinusBeta2)) := by
              rw [← hsum_gamma_div]
              exact mul_le_mul_of_nonneg_left hcore_unscaled
                halpha_t_nonneg
        _ = c * ((1 / Real.sqrt (t : ℝ)) *
              ∑ j ∈ Finset.Icc 1 t,
                gamma ^ (t - j) * |gSeq setup run j i|) := by
              dsimp [c]
              rw [← _hsqrtTime_eq]
              field_simp [ne_of_gt hden_global_pos,
                ne_of_gt hsqrtOneMinus_pos, halpha_quot.1]
              calc
                (setup.alpha_t t *
                    ∑ x ∈ Finset.Icc 1 t,
                      gamma ^ (t - x) * |gSeq setup run x i|) *
                    sqrtTime
                    = (∑ x ∈ Finset.Icc 1 t,
                        gamma ^ (t - x) * |gSeq setup run x i|) *
                        (sqrtTime * setup.alpha_t t) := by
                        ring
                _ = (∑ x ∈ Finset.Icc 1 t,
                        gamma ^ (t - x) * |gSeq setup run x i|) *
                        setup.alpha := by
                        rw [halpha_quot.2]
    have hcore_to_triangular :
        coreMomentumSum ≤
          c * (∑ i : Fin d,
            ∑ t ∈ Finset.Icc 1 T,
              ∑ j ∈ Finset.Icc 1 t,
                (1 / Real.sqrt (t : ℝ)) * gamma ^ (t - j) *
                  |gSeq setup run j i|) := by
      dsimp [coreMomentumSum]
      calc
        (∑ t ∈ Finset.Icc 1 T,
          setup.alpha_t t *
            (∑ i, (mSeq setup run t i) ^ 2 / adaptiveVhatSqrt t i))
            = ∑ t ∈ Finset.Icc 1 T,
                ∑ i,
                  setup.alpha_t t *
                    ((mSeq setup run t i) ^ 2 /
                      adaptiveVhatSqrt t i) := by
              refine Finset.sum_congr rfl ?_
              intro t ht
              rw [Finset.mul_sum]
        _ ≤ ∑ t ∈ Finset.Icc 1 T,
              ∑ i,
                c * ((1 / Real.sqrt (t : ℝ)) *
                  ∑ j ∈ Finset.Icc 1 t,
                    gamma ^ (t - j) * |gSeq setup run j i|) := by
              exact Finset.sum_le_sum (fun t ht =>
                Finset.sum_le_sum (fun i _hi => hpoint_eq17 t ht i))
        _ = c * (∑ i : Fin d,
            ∑ t ∈ Finset.Icc 1 T,
              ∑ j ∈ Finset.Icc 1 t,
                (1 / Real.sqrt (t : ℝ)) * gamma ^ (t - j) *
                  |gSeq setup run j i|) := by
              rw [Finset.sum_comm]
              simp [Finset.mul_sum, mul_assoc, mul_left_comm, mul_comm]
    calc
      coreMomentumSum
          ≤ c * (∑ i : Fin d,
            ∑ t ∈ Finset.Icc 1 T,
              ∑ j ∈ Finset.Icc 1 t,
                (1 / Real.sqrt (t : ℝ)) * gamma ^ (t - j) *
                  |gSeq setup run j i|) := hcore_to_triangular
      _ ≤ c * ((1 / (1 - gamma)) *
            (sqrtOnePlusLogT * (∑ i, historyNorm i))) := by
          exact mul_le_mul_of_nonneg_left htriangular_history_to_norm hc_nonneg
      _ = setup.alpha * sqrtOnePlusLogT /
            ((1 - beta1 setup) * (1 - gamma) *
              sqrtOneMinusBeta2) *
            (∑ i, historyNorm i) := by
          dsimp [c]
          field_simp [ne_of_gt hden_global_pos, ne_of_gt hgamma_den_pos,
            ne_of_gt hsqrtOneMinus_pos]
  have hmomentum_le_third :
      currentMomentumSum + previousMomentumSum ≤ thirdTerm :=
    le_trans hmomentum_le_scaled_core
      (hcore_scaled_le_third_of_core_bound hcore_le_history)
  calc
    metricDropSum + currentMomentumSum + previousMomentumSum + betaMetricSum
        = (metricDropSum + betaMetricSum) +
            (currentMomentumSum + previousMomentumSum) := by
          ring
    _ ≤ (firstCoeff * (∑ i, terminalVhatSqrt i) +
            secondCoeff * (∑ t ∈ Finset.Icc 1 T, ∑ i, adaptiveTerm t i)) +
          thirdTerm := by
          exact add_le_add hmetric_beta_bound hmomentum_le_third
    _ = firstCoeff * (∑ i, terminalVhatSqrt i) +
          secondCoeff * (∑ t ∈ Finset.Icc 1 T, ∑ i, adaptiveTerm t i) +
          thirdTerm := by
          ring

/-- Legacy source-boundary obligation for the displayed Theorem 4 RHS evaluated
on the globally checked generated Algorithm 2 `Run` adapter.

This is intentionally marked global/legacy because it depends on the all-time
generated-step solvability obligation needed to build a `Run`.  The
source-facing generated theorem below uses the horizon-local
`GeneratedAlgorithm2RHSCompatibilityObligation` instead. -/
private def GeneratedAlgorithm2GlobalRHSCompatibilityObligation {d : ℕ}
    (setup : Setup d)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvability setup) (T : ℕ) : Prop :=
  totalizedRHSCompatibilityObligation setup
    (wellDefinedAlgorithm2GeneratedRun setup hsolv) T

/-- Legacy generated-process AMSGrad Theorem 4 extension through the global
`Run` adapter.

This theorem preserves the existing proof adapter, but it is not the
source-facing generated Theorem 4 boundary: its head still contains the
all-time `WellDefinedAlgorithm2GeneratedSolvability` required by the legacy
`Run` type. -/
private theorem AMSGrad_theorem4_generatedAlgorithm2_globalSolvability_extension {d : ℕ}
    (setup : Setup d) (T : ℕ)
    (h_generated_solvable : WellDefinedAlgorithm2GeneratedSolvability setup)
    (hT : 1 ≤ T)
    (h_generated_rhs_compat :
      GeneratedAlgorithm2GlobalRHSCompatibilityObligation setup
        h_generated_solvable T)
    (h_parameter_domain_T : Theorem4ParameterDomainOnHorizon setup T)
    (h_grad_bound_T : BoundedGradientsOnHorizon setup T)
    (h_alpha_schedule_T :
      ∀ t ∈ Finset.Icc 1 T, IsTheorem4StepSizeAt setup t (setup.alpha_t t))
    (h_beta1t_le_T :
      ∀ t ∈ Finset.Icc 1 T, setup.beta1t t ≤ beta1 setup)
    (h_beta1t_nonincreasing_T :
      ∀ t ∈ Finset.Icc 2 T, setup.beta1t t ≤ setup.beta1t (t - 1)) :
    ∃ B,
      IsTheorem4Bound setup
          (wellDefinedAlgorithm2GeneratedRun setup h_generated_solvable) T B ∧
        regretAgainstInfimum setup
          (wellDefinedAlgorithm2GeneratedRun setup h_generated_solvable) T ≤ B := by
  exact AMSGrad_theorem4_wellDefinedRunOnHorizon_extension
    setup T (wellDefinedAlgorithm2GeneratedRun setup h_generated_solvable) hT
    (wellDefinedAlgorithm2GeneratedRun_wellDefinedOnHorizon setup
      h_generated_solvable T)
    h_generated_rhs_compat
    h_parameter_domain_T h_grad_bound_T h_alpha_schedule_T
    h_beta1t_le_T h_beta1t_nonincreasing_T

