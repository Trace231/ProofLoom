/-!
# AMSGrad

Object-layer formalization of Algorithm 2 and Theorem 4 from Reddi, Kale, and
Kumar, *On the Convergence of Adam and Beyond* (ICLR 2018).

This file is intentionally pre-proof: it defines the paper objects that later
proofs should use.  Algorithm 2's gradient, first moment, second moment,
long-term memory, weighted projection relation, and run sequence are
source-facing objects, not theorem-local proof conveniences.
-/

open scoped BigOperators
open scoped Gradient

namespace SGD.AMSGrad

/-- Paper coordinate space `ℝ^d`, represented by Mathlib's finite Euclidean
space. -/
abbrev CoordinateSpace (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-- Paper matrix space `ℝ^{d×d}` used for the weighted projection notation
`Π_{F,A}`.

No SOptLib match: searched `positive definite matrix weighted norm projection`
and scanned `SOptLib.Model.Prox`, `SOptLib.Layer0.ConvexFOC`, and weighted
algebra helpers; they model prox/Bregman argmins or finite weighted sums, not
the Appendix G positive-definite matrix metric `Q ∈ S_+^d`. -/
abbrev MatrixSpace (d : ℕ) := Fin d → Fin d → ℝ

/-- The `ℓ∞` norm used in the paper's bounded-diameter and bounded-gradient
assumptions.

SOptLib candidates considered: objective/diameter helpers such as
`objectiveGapRadius` and `carrierBregmanDivergence` are problem-neutral
optimization objects, while Theorem 4 uses the literal coordinate supremum
`‖·‖∞` on `ℝ^d`; this local definition records that paper-specific norm. -/
noncomputable def linftyNorm {d : ℕ} (x : CoordinateSpace d) : ℝ :=
  ‖fun i : Fin d => x i‖

/-- Coordinatewise square, matching Algorithm 2's `g_t^2`. -/
def coordSquare {d : ℕ} (x : CoordinateSpace d) : CoordinateSpace d :=
  WithLp.toLp 2 (fun i : Fin d => (x i) ^ 2)

/-- Coordinatewise maximum, matching Algorithm 2's
`\hat v_t = max(\hat v_{t-1}, v_t)`. -/
def coordMax {d : ℕ} (x y : CoordinateSpace d) : CoordinateSpace d :=
  WithLp.toLp 2 (fun i : Fin d => max (x i) (y i))

/-- Matrix-vector multiplication for the paper's finite `d × d` matrices. -/
noncomputable def matrixVec {d : ℕ}
    (Q : MatrixSpace d) (x : CoordinateSpace d) : CoordinateSpace d :=
  WithLp.toLp 2 (fun i : Fin d => ∑ j, Q i j * x j)

/-- Quadratic form `xᵀQx` associated with a paper metric matrix. -/
noncomputable def matrixQuadraticForm {d : ℕ}
    (Q : MatrixSpace d) (x : CoordinateSpace d) : ℝ :=
  ∑ i, x i * (matrixVec Q x i)

/-- Paper domain `S_+^d`: symmetric positive definite matrices.

No SOptLib match: searched `positive definite matrix weighted norm projection`,
`Matrix PosDef sqrt weighted norm`, and scanned `SOptLib.Model.Norms` plus
`SOptLib.Layer0.ConvexFOC`; the hits expose inner-product/argmin bridges but no
paper-facing finite matrix cone `S_+^d` for Appendix G Lemma 4. -/
def IsPositiveDefiniteMatrix {d : ℕ} (Q : MatrixSpace d) : Prop :=
  (∀ i j, Q i j = Q j i) ∧
    ∀ x : CoordinateSpace d, x ≠ 0 → 0 < matrixQuadraticForm Q x

/-- Diagonal matrix generated by a coordinate vector, used for Algorithm 2's
`√\hat V_t` projection metric. -/
def diagonalMatrix {d : ℕ} (diag : CoordinateSpace d) : MatrixSpace d :=
  fun i j => if i = j then diag i else 0

/-- Weighted norm `‖Q^(1/2)x‖`, represented as `sqrt (xᵀQx)` on the source
domain `Q ∈ S_+^d`.

SOptLib candidates considered: `Euclidean.dualNorm`, PiLp coordinate pairing,
and weighted finite-sum lemmas describe unrelated norm or aggregation objects;
Appendix G needs the literal positive-definite matrix norm from
`Q ∈ S_+^d`. -/
noncomputable def positiveDefiniteWeightedNorm {d : ℕ}
    (Q : MatrixSpace d) (x : CoordinateSpace d) : ℝ :=
  Real.sqrt (matrixQuadraticForm Q x)

/-- On the paper's domain `Q ∈ S_+^d`, the weighted norm has the expected
square `xᵀQx`. -/
theorem positiveDefiniteWeightedNorm_sq {d : ℕ}
    (Q : MatrixSpace d) (hQ : IsPositiveDefiniteMatrix Q)
    (x : CoordinateSpace d) :
    positiveDefiniteWeightedNorm Q x ^ 2 = matrixQuadraticForm Q x := by
  have hQpos : Matrix.PosDef (Q : Matrix (Fin d) (Fin d) ℝ) := by
    refine Matrix.PosDef.of_dotProduct_mulVec_pos ?_ ?_
    · exact Matrix.IsHermitian.ext fun i j => by
        simpa using (hQ.1 i j).symm
    · intro v hv
      have hv_coord : (WithLp.toLp 2 v : CoordinateSpace d) ≠ 0 := by
        intro hzero
        apply hv
        ext i
        exact congr_fun (congr_arg WithLp.ofLp hzero) i
      simpa [matrixQuadraticForm, matrixVec, dotProduct, Matrix.mulVec] using
        hQ.2 (WithLp.toLp 2 v : CoordinateSpace d) hv_coord
  have hnonneg : 0 ≤ matrixQuadraticForm Q x := by
    simpa [matrixQuadraticForm, matrixVec, dotProduct, Matrix.mulVec] using
      hQpos.posSemidef.dotProduct_mulVec_nonneg (WithLp.ofLp x)
  simpa [positiveDefiniteWeightedNorm] using Real.sq_sqrt hnonneg

/-- Relational square-root semantics for source expressions.

No SOptLib match: searched "checked quotient denominator nonzero division
parameter choices" and "partial quotient division relation denominator"; the
hits are AC-SA ratio lemmas or output-weight denominator facts, not the
AMSGrad paper's literal real square-root domain boundary from Algorithm 2 and
Theorem 4. -/
def IsScalarSqrt (value root : ℝ) : Prop :=
  realSqrtSpec value root

/-- Coordinatewise relational square-root semantics for `√v`.

No SOptLib match: searched "partial quotient division relation denominator"
and scanned the returned ParameterChoices/Iterates denominator helpers; none
models the paper's coordinatewise square-root vector in Algorithm 2. -/
def IsCoordSqrt {d : ℕ} (x sqrtx : CoordinateSpace d) : Prop :=
  coordinateRealSqrtSpec x sqrtx

/-- Raw displayed quotient equation for a source expression `num / den`, before
adding Lean's nonzero-denominator well-definedness side condition.

No SOptLib match: searched "coordinatewise quotient relation denominator
division" and checked the reusable denominator hits from `Model.ParameterChoices`
and `Model.Iterates`; they are schedule/output denominator bridges, not the
paper's displayed Algorithm 2 elementwise quotient equation. -/
def IsScalarDisplayedQuotient (num den quot : ℝ) : Prop :=
  den * quot = num

/-- Coordinatewise raw displayed quotient equation for `x / y`, kept separate
from the checked nonzero-denominator interpretation. -/
def IsCoordDisplayedQuotient {d : ℕ}
    (num den quot : CoordinateSpace d) : Prop :=
  ∀ i, IsScalarDisplayedQuotient (num i) (den i) (quot i)

/-- Checked scalar quotient for a source expression `num / den`.

The PDF's notation section defines ordinary elementwise division, but Theorem 4
does not state generated denominator nonzero as an assumption.  This checked
predicate is therefore a well-definedness boundary, not part of the
unqualified Algorithm 2 run object. -/
def IsScalarQuotient (num den quot : ℝ) : Prop :=
  den ≠ 0 ∧ den * quot = num

/-- A checked scalar quotient realizes the raw displayed quotient equation. -/
theorem isScalarDisplayedQuotient_of_isScalarQuotient
    (num den quot : ℝ) (h : IsScalarQuotient num den quot) :
    IsScalarDisplayedQuotient num den quot := by
  exact h.2

/-- Checked scalar quotient alias retained for proof-side code that names the
well-defined quotient obligation explicitly. -/
def IsScalarQuotientWellDefined (num den quot : ℝ) : Prop :=
  IsScalarQuotient num den quot

/-- Coordinatewise relational quotient semantics for `x / y`.

No SOptLib match: searched "checked quotient denominator nonzero division
parameter choices" and "partial quotient division relation denominator"; the
available quotient lemmas are theorem-level algebraic bridges and do not
define the AMSGrad coordinatewise source object. -/
def IsCoordQuotient {d : ℕ}
    (num den quot : CoordinateSpace d) : Prop :=
  ∀ i, IsScalarQuotient (num i) (den i) (quot i)

/-- A checked coordinate quotient realizes the raw displayed coordinate
quotient equation. -/
theorem isCoordDisplayedQuotient_of_isCoordQuotient {d : ℕ}
    (num den quot : CoordinateSpace d) (h : IsCoordQuotient num den quot) :
    IsCoordDisplayedQuotient num den quot := by
  intro i
  exact isScalarDisplayedQuotient_of_isScalarQuotient (num i) (den i) (quot i) (h i)

/-- Coordinatewise checked quotient obligation for the displayed AMSGrad
division, retained as a compatibility name for proof-side code. -/
def IsCoordQuotientWellDefined {d : ℕ}
    (num den quot : CoordinateSpace d) : Prop :=
  IsCoordQuotient num den quot

/-- Canonical scalar quotient value for the displayed real quotient.

The source-facing predicates above carry denominator well-definedness; this
value is only the computed Lean representative of the paper quotient once that
domain has been exposed. -/
noncomputable def scalarQuotient (num den : ℝ) : ℝ :=
  num / den

/-- The canonical Lean quotient value satisfies the checked quotient relation
once its denominator is nonzero. -/
theorem isScalarQuotient_scalarQuotient
    (num den : ℝ) (hden : den ≠ 0) :
    IsScalarQuotient num den (scalarQuotient num den) := by
  refine ⟨hden, ?_⟩
  rw [scalarQuotient]
  field_simp [hden]

/-- Weighted projection objective for the paper operation
`Π_{F,A}(y) = arg min_{x∈F} ‖A^(1/2)(x-y)‖`.

SOptLib candidates considered: `blockMirrorUpdate`, mirror/prox declarations,
and conditional-gradient iterate updates all model different update families;
none is the positive-definite matrix weighted Euclidean projection `Π_{F,A}`
from ICLR 2018 Section 2 and Appendix G Lemma 4. -/
noncomputable def weightedProjectionObjective {d : ℕ}
    (metric : MatrixSpace d) (y x : CoordinateSpace d) : ℝ :=
  SOptLib.positiveDefiniteFiniteMatrixWeightedNorm metric (x - y)

/-- Positive-definite metric domain for a weighted projection, matching the
paper's notation `A ∈ S_+^d`.

No SOptLib match: searched "algorithm domain obligation denominator positive
definite" and the reusable hits were output-denominator or unrelated
positive-time facts.  This local predicate records the AMSGrad-specific
projection-domain side condition printed in the definition of `Π_{F,A}`. -/
def IsWeightedProjectionDomain {d : ℕ}
    (metric : MatrixSpace d) : Prop :=
  IsPositiveDefiniteMatrix metric

/-- Argmin core of the displayed weighted projection
`Π_{F,A}(y) = arg min_{x∈F} ‖A^(1/2)(x-y)‖`.

No SOptLib match: searched "weighted projection argmin feasible set" and
"argmin minimizer selected optimizer feasible set", and checked
`SOptLib.Model.Prox` / `SOptLib.Model.Objective`; prox selectors require
compact/existence inputs or model mirror objectives, while the AMSGrad paper
states the literal matrix-weighted projection as an argmin in Section 2. -/
def IsWeightedProjectionArgmin {d : ℕ} (F : Set (CoordinateSpace d))
    (metric : MatrixSpace d) (y x : CoordinateSpace d) : Prop :=
  SOptLib.parameterizedFeasibleArgmin weightedProjectionObjective F metric y x

/-- Relational form of the displayed weighted projection
`Π_{F,A}(y) = arg min_{x∈F} ‖A^(1/2)(x-y)‖`, including the source notation
domain `A ∈ S_+^d`. -/
def IsWeightedProjection {d : ℕ} (F : Set (CoordinateSpace d))
    (metric : MatrixSpace d) (y x : CoordinateSpace d) : Prop :=
  IsWeightedProjectionDomain metric ∧
    IsWeightedProjectionArgmin F metric y x

/-- Raw displayed weighted-projection equation for `Π_{F,A}(y)`, before adding
the notation-domain side condition `A ∈ S_+^d`.

No SOptLib match: searched "weighted projection argmin positive definite
matrix" and "projection argmin feasible set"; reusable prox/mirror selectors
carry different objective structure or extra existence hypotheses, while this
file needs the literal AMSGrad Section 2 projection argmin core with the
positive-definite domain separated as a checked obligation. -/
def IsDisplayedWeightedProjection {d : ℕ} (F : Set (CoordinateSpace d))
    (metric : MatrixSpace d) (y x : CoordinateSpace d) : Prop :=
  IsWeightedProjectionArgmin F metric y x

/-- A checked weighted projection realizes the raw displayed projection
equation. -/
theorem isDisplayedWeightedProjection_of_isWeightedProjection {d : ℕ}
    (F : Set (CoordinateSpace d)) (metric : MatrixSpace d)
    (y x : CoordinateSpace d)
    (h : IsWeightedProjection F metric y x) :
    IsDisplayedWeightedProjection F metric y x := by
  exact h.2

/-- Paper-level setup data and stated assumptions for AMSGrad Theorem 4.

Source citations: `book/ICLR2018/AMSGrad.json#/setup/problem` states the
online regret problem; `#/setup/variable_space` states `x_t ∈ F`; assumptions
`#/assumptions/0` through `#/assumptions/5` state convex losses, convex feasible
set use, bounded `ℓ∞` diameter, bounded gradients, the `α_t = α / √t`
schedule, and the beta/gamma schedule.  The PDF notation paragraph in Section 2
defines `F`'s bounded diameter by `‖x-y‖∞ ≤ D∞`.

The recursive objects of Algorithm 2 are not setup fields: `g_t`, `m_t`, `v_t`,
`\hat v_t`, and `x_t` are supplied by the displayed algorithmic relation below;
the corrected theorem-facing run boundary is separate because Algorithm 2's
printed quotient/projection has notation domains not listed in Theorem 4's
assumptions. -/
structure Setup (d : ℕ) where
  /-- Feasible set `F ⊂ ℝ^d`.

  Source: `book/ICLR2018/AMSGrad.json#/setup/variable_space`:
  "`x_t ∈ F`, where `F ∈ ℝ^d` is the feasible set of points". -/
  F : Set (CoordinateSpace d)
  /-- Initial point `x_1 ∈ F`.

  Source: `book/ICLR2018/AMSGrad.json#/algorithm_spec/initialization`:
  "`x_1∈F, m_0=0, v_0=0, \hat v_0=0`". -/
  x₁ : {x : CoordinateSpace d // x ∈ F}
  /-- Online convex losses `f_t`.

  Source: `book/ICLR2018/AMSGrad.json#/setup/problem`: online regret
  compares `∑ f_t(x_t)` against `min_{x∈F} ∑ f_t(x)`. -/
  f : ℕ → CoordinateSpace d → ℝ
  /-- Algorithm 2 step-size input sequence `{α_t}_{t=1}^T`.

  Source: `book/ICLR2018/AMSGrad.json#/algorithm_spec/parameters/0`:
  "`{α_t}_{t=1}^T`". -/
  alpha_t : ℕ → ℝ
  /-- Base stepsize parameter in `α_t = α / √t`.

  Source: `book/ICLR2018/AMSGrad.json#/assumptions/4`:
  "`α_t = α/√t`". -/
  alpha : ℝ
  /-- First-moment schedule `β_{1t}`.

  Source: `book/ICLR2018/AMSGrad.json#/algorithm_spec/parameters/1`:
  "`{β_{1t}}_{t=1}^T`". -/
  beta1t : ℕ → ℝ
  /-- Second-moment parameter `β_2`.

  Source: `book/ICLR2018/AMSGrad.json#/algorithm_spec/parameters/2`:
  "`β_2`". -/
  beta2 : ℝ
  /-- Diameter constant `D_∞`.

  Source: `book/ICLR2018/AMSGrad.json#/assumptions/2`:
  "`‖x-y‖_∞ ≤ D_∞` for all `x,y∈F`". -/
  Dinf : ℝ
  /-- Gradient bound constant `G_∞`.

  Source: `book/ICLR2018/AMSGrad.json#/assumptions/3`:
  "`‖∇ f_t(x)‖_∞ ≤ G_∞` for all `t∈[T]` and `x∈F`". -/
  Ginf : ℝ
  /-- The paper assumes convex losses in the online convex setting.

  Source: `book/ICLR2018/AMSGrad.json#/assumptions/0`: convexity of
  `f_t` is used in the regret proof. -/
  h_loss_convex : ∀ t, ConvexOn ℝ F (f t)
  /-- The auxiliary projection lemma and OCO setup use a convex feasible set.

  Source: `book/ICLR2018/AMSGrad.json#/assumptions/1`:
  "convex feasible set `F ⊂ ℝ^d`". -/
  hF_convex : Convex ℝ F
  /-- `F` has bounded `ℓ∞` diameter `D_∞`.

  Source: `book/ICLR2018/AMSGrad.json#/assumptions/2`:
  "`‖x-y‖_∞ ≤ D_∞` for all `x,y∈F`". -/
  h_diameter :
    ∀ x ∈ F, ∀ y ∈ F, linftyNorm (x - y) ≤ Dinf
  /-- Theorem 4 assumes `γ = β_1 / √β_2 < 1`.

  Source: `book/ICLR2018/AMSGrad.json#/assumptions/5`:
  "`β_1=β_11`, `β_{1t}≤β_1`, and `γ=β_1/√β_2<1`". -/
  h_gamma_lt_one :
    ∃ sqrtBeta2 gamma,
      IsScalarSqrt beta2 sqrtBeta2 ∧
      IsScalarQuotient (beta1t 1) sqrtBeta2 gamma ∧
      gamma < 1

/-- Theorem 4 notation `β_1 = β_11`, defined from the schedule rather than
stored as a duplicate setup field.

Source: `book/ICLR2018/AMSGrad.json#/assumptions/5`:
"`β_1=β_11`, `β_{1t}≤β_1`, and `γ=β_1/√β_2<1`". -/
def beta1 {d : ℕ} (setup : Setup d) : ℝ :=
  setup.beta1t 1

/-- Algorithm 2 state after a loop boundary: current iterate, first moment,
second moment, and long-term maximum memory.

Source: `book/ICLR2018/AMSGrad.json#/algorithm_spec/initialization` gives
`x_1∈F, m_0=0, v_0=0, \hat v_0=0`, and
`#/algorithm_spec/steps/1` through `#/algorithm_spec/steps/4` update `m_t`,
`v_t`, `\hat v_t`, and `x_{t+1}`.

Backfilled through `SOptLib.AdaptiveMomentState`, the reusable Adam-family
state interface for the Algorithm 2 tuple `(x_t,m_t,v_t,\hat v_t)`. -/
abbrev State (d : ℕ) := SOptLib.AdaptiveMomentState (CoordinateSpace d)

namespace State

/-- Compatibility projection for existing proof code that names `State.x`
explicitly. -/
def x {d : ℕ} (state : State d) : CoordinateSpace d :=
  SOptLib.AdaptiveMomentState.x state

/-- The compatibility projection is the staged adaptive-moment state projection. -/
@[simp]
theorem x_eq {d : ℕ} (state : State d) :
    State.x state = SOptLib.AdaptiveMomentState.x state := by
  rfl

end State

/-- Initial Algorithm 2 state: `x_1 ∈ F`, `m_0 = 0`, `v_0 = 0`,
and `\hat v_0 = 0`.

Source: `book/ICLR2018/AMSGrad.json#/algorithm_spec/initialization`:
"`x_1∈F, m_0=0, v_0=0, \hat v_0=0`". -/
def initialState {d : ℕ} (setup : Setup d) : State d :=
  SOptLib.AdaptiveMomentState.initial setup.x₁.1

/-- Source-facing gradient realization in the full-information online setting:
`g_t = ∇ f_t(x_t)`.

Source: `book/ICLR2018/AMSGrad.json#/algorithm_spec/steps/0`:
"`g_t=∇ f_t(x_t)`".

SOptLib candidates considered: `finiteAverageObjective_hasGradientAt` and the
`gradientWithin` bridges prove gradients for other objective models or carrier
charts.  AMSGrad Algorithm 2 uses the literal pointwise gradient of the
revealed loss, so this local relation records the realization boundary instead
of relying on Mathlib's total `∇` fallback outside differentiability. -/
def IsGradientAtState {d : ℕ} (setup : Setup d)
    (t : ℕ) (state : State d) (g : CoordinateSpace d) : Prop :=
  HasGradientAt (setup.f t) g state.x

/-- First-moment update
`m_t = β_{1t} m_{t-1} + (1-β_{1t}) g_t`.

Source: `book/ICLR2018/AMSGrad.json#/algorithm_spec/steps/1`. -/
noncomputable def firstMoment {d : ℕ} (setup : Setup d) (t : ℕ)
    (state : State d) (g : CoordinateSpace d) : CoordinateSpace d :=
  SOptLib.AdaptiveMomentState.firstMoment setup.beta1t t state g

/-- Second-moment update
`v_t = β_2 v_{t-1} + (1-β_2) g_t^2`.

Source: `book/ICLR2018/AMSGrad.json#/algorithm_spec/steps/2`. -/
noncomputable def secondMoment {d : ℕ} (setup : Setup d)
    (state : State d) (g : CoordinateSpace d) : CoordinateSpace d :=
  SOptLib.AdaptiveMomentState.secondMoment coordSquare setup.beta2 state g

/-- Long-term memory update
`\hat v_t = max(\hat v_{t-1}, v_t)`.

Source: `book/ICLR2018/AMSGrad.json#/algorithm_spec/steps/3`. -/
def longTermMemory {d : ℕ} (state : State d)
    (v : CoordinateSpace d) : CoordinateSpace d :=
  SOptLib.AdaptiveMomentState.longTermMemory coordMax state v

/-- Theorem 4 step-size schedule value `α / √t`.

Source: `book/ICLR2018/AMSGrad.json#/assumptions/4`:
"`α_t = α/√t`".

No SOptLib match: searched `step size alpha sqrt t AMSGrad` and checked the
pre-searched parameter-choice candidates; they model variance-balanced or
accelerated schedules, not the literal AMSGrad Theorem 4 schedule.  Algorithm
2 itself uses the free input sequence `setup.alpha_t`; this definition is only
the Theorem 4 specialization. -/
noncomputable def theorem4StepSizeAt {d : ℕ} (setup : Setup d) (t : ℕ) : ℝ :=
  scalarQuotient setup.alpha (Real.sqrt (t : ℝ))

/-- Compatibility alias for the Theorem 4 step-size schedule value. -/
noncomputable def stepSizeAt {d : ℕ} (setup : Setup d) (t : ℕ) : ℝ :=
  theorem4StepSizeAt setup t

/-- Checked Theorem 4 step-size schedule boundary for `α_t = α / √t`.

Source: `book/ICLR2018/AMSGrad.json#/assumptions/4`:
"`α_t = α/√t`".

The source statement only uses this at positive paper times.  Algorithm 2's
run relation refers to the free input `setup.alpha_t`; this relation is the
source-stated extra hypothesis in Theorem 4. -/
def IsTheorem4StepSizeAt {d : ℕ} (setup : Setup d) (t : ℕ) (alpha_t : ℝ) : Prop :=
  ∃ sqrtTime, sqrtTime = Real.sqrt (t : ℝ) ∧ IsScalarSqrt (t : ℝ) sqrtTime ∧
    IsScalarQuotient setup.alpha sqrtTime alpha_t

/-- Horizon-local parameter-domain assumptions used by the Theorem 4 proof.

Source context: `book/ICLR2018/AMSGrad.json#/assumptions/4` states
`α_t = α/√t`, while Algorithm 1 in the PDF uses positive step-size notation
`{α_t > 0}` and Algorithm 2 takes a step-size sequence `{α_t}`.  The beta
schedule is source-stated in `book/ICLR2018/AMSGrad.json#/assumptions/5`, and
the PDF Section 3 describes Adam-style beta parameters as lying in `[0,1)`.
Appendix D, Eq. (15)--(18), then divides by `2α_t(1-β_{1t})` and treats
`β_{1t}` as a nonnegative momentum weight.

No SOptLib match: searched `step size positive parameter domain nonnegative
momentum schedule beta` and checked `SOptLib.stepSize_pos`; the reusable hit
only preserves positivity for an already positive generic schedule and does not
record the AMSGrad-specific horizon-local beta-one domain. -/
def Theorem4ParameterDomainOnHorizon {d : ℕ}
    (setup : Setup d) (T : ℕ) : Prop :=
  SOptLib.finiteHorizonStepMomentumDomain setup.alpha_t setup.beta1t T


/-- The reconstructed Theorem 4 parameter boundary exposes positive step sizes
on the active horizon. -/
theorem theorem4ParameterDomain_alpha_t_pos {d : ℕ}
    (setup : Setup d) (T t : ℕ)
    (hdom : Theorem4ParameterDomainOnHorizon setup T)
    (ht : t ∈ Finset.Icc 1 T) :
    0 < setup.alpha_t t :=
  hdom.1 t ht

/-- The reconstructed Theorem 4 parameter boundary exposes nonnegative
first-moment weights on the active horizon. -/
theorem theorem4ParameterDomain_beta1t_nonneg {d : ℕ}
    (setup : Setup d) (T t : ℕ)
    (hdom : Theorem4ParameterDomainOnHorizon setup T)
    (ht : t ∈ Finset.Icc 1 T) :
    0 ≤ setup.beta1t t :=
  hdom.2 t ht

/-- The corrected Theorem 4 beta-one schedule boundary exposes the decreasing
schedule used by the Appendix D metric/beta telescope. -/
theorem theorem4Beta1NonincreasingOnHorizon_step {d : ℕ}
    (setup : Setup d) (T t : ℕ)
    (hmono : (∀ t ∈ Finset.Icc 2 T, setup.beta1t t ≤ setup.beta1t (t - 1)))
    (ht : t ∈ Finset.Icc 2 T) :
    setup.beta1t t ≤ setup.beta1t (t - 1) :=
  hmono t ht

/-- Under the Theorem 4 schedule relation, the horizon-local positive
step-size boundary rules out a negative base stepsize. -/
theorem theorem4ParameterDomain_alpha_pos {d : ℕ}
    (setup : Setup d) (T : ℕ)
    (hT : 1 ≤ T)
    (hdom : Theorem4ParameterDomainOnHorizon setup T)
    (hschedule :
      ∀ t ∈ Finset.Icc 1 T, IsTheorem4StepSizeAt setup t (setup.alpha_t t)) :
    0 < setup.alpha := by
  have hmem : 1 ∈ Finset.Icc 1 T := Finset.mem_Icc.mpr ⟨le_rfl, hT⟩
  have hstep_pos : 0 < setup.alpha_t 1 :=
    theorem4ParameterDomain_alpha_t_pos setup T 1 hdom hmem
  rcases hschedule 1 hmem with ⟨sqrtTime, _hsqrtTime_eq, hsqrtTime, hquot⟩
  have hsqrtTime_pos : 0 < sqrtTime := by
    have hsqrtTime_nonneg : 0 ≤ sqrtTime := hsqrtTime.1
    have hsqrtTime_sq : sqrtTime ^ 2 = (1 : ℝ) := by
      simpa using hsqrtTime.2
    nlinarith
  have halpha_eq : setup.alpha = sqrtTime * setup.alpha_t 1 := hquot.2.symm
  rw [halpha_eq]
  exact mul_pos hsqrtTime_pos hstep_pos

/-- Compatibility name for the Theorem 4 step-size schedule relation. -/
def IsStepSizeAt {d : ℕ} (setup : Setup d) (t : ℕ) (alpha_t : ℝ) : Prop :=
  IsTheorem4StepSizeAt setup t alpha_t

/-- Diagonal metric used in Algorithm 2's weighted projection once the
coordinate square root of `\hat v_t` is fixed.

The pre-searched step-size and projection candidates do not model the
source-specific `√\hat V_t = diag(√\hat v_t)` object; this definition keeps the
matrix metric tied to the relational square-root witness used by the projected
update. -/
def amsgradProjectionMetricFromSqrt {d : ℕ}
    (sqrtVhat : CoordinateSpace d) : MatrixSpace d :=
  diagonalMatrix sqrtVhat

/-- Internal displayed-syntax trial point relation for the Algorithm 2
subexpression `x_t - α_t m_t / √\hat v_t`.

No SOptLib match: searched `checked quotient denominator nonzero division
parameter choices`, `partial quotient division relation denominator`, and
scanned `SOptLib.Model.ParameterChoices`; existing quotient helpers are
schedule-specific proof bridges, while AMSGrad needs the coordinatewise
Algorithm 2 trial-point expression.

This is not a theorem-facing source semantics for ordinary division.  It records
only the printed coordinate equation for a quotient-bearing subexpression of
the projected update.  Nonzero-denominator facts live only in
`IsWellDefinedAMSGradTrialPoint` and the finite-horizon corrected boundary
`WellDefinedRunOnHorizon`.  The older unqualified compatibility alias was
removed so this raw relation cannot be classified as an original-paper
theorem boundary by name.

Signature-contract classification: internal helper for Algorithm 2 displayed
syntax.  Do not use this declaration as the checked ordinary-division meaning
of the paper update in a theorem-facing statement. -/
def IsDisplayedAMSGradTrialPoint {d : ℕ} (setup : Setup d)
    (t : ℕ) (state : State d) (m vhat y : CoordinateSpace d) : Prop :=
  ∃ sqrtVhat direction,
    IsCoordSqrt vhat sqrtVhat ∧
    IsCoordDisplayedQuotient m sqrtVhat direction ∧
    y = state.x - setup.alpha_t t • direction

/-- Extension-only checked AMSGrad trial point, with the same displayed
quotient plus the nonzero-denominator side condition required to interpret
ordinary division.

This is not a primitive Algorithm 2 object: the paper prints
`m_t / √\hat v_t`, while neither the book JSON nor PDF Theorem 4 states the
generated nonzero-denominator fact as an assumption.

Signature-contract classification: corrected extension helper.  Any theorem
that consumes this predicate is proving a checked well-definedness extension,
not the unqualified original Algorithm 2 boundary. -/
def IsWellDefinedAMSGradTrialPoint {d : ℕ} (setup : Setup d)
    (t : ℕ) (state : State d) (m vhat y : CoordinateSpace d) : Prop :=
  ∃ sqrtVhat direction,
    IsCoordSqrt vhat sqrtVhat ∧
    IsCoordQuotient m sqrtVhat direction ∧
    y = state.x - setup.alpha_t t • direction

/-- Internal displayed Algorithm 2 projected-update syntax.

Source citation: `book/ICLR2018/AMSGrad.json#/algorithm_spec/steps/4` displays
`x_{t+1}=Π_{F,√\hat V_t}(x_t-α_t m_t/√\hat v_t)`.

This is the relation used by `Run`; it states the displayed update with the
same square-root witness in the quotient and in the metric
`Π_{F,√\hat V_t}`.  It is not a theorem-facing source semantics for Algorithm
2, because it records only the printed quotient/projection shape and omits the
ordinary-division denominator and `A ∈ S_+^d` notation domains from the PDF
Section 2 notation paragraph, which defines `a/b` as elementwise division and
`Π_{F,A}` only for `A ∈ S_+^d`.
The corrected theorem-facing boundary is `WellDefinedRunOnHorizon`.

Signature-contract classification: internal displayed-run update syntax.  This
declaration is the raw printed Algorithm 2 equation and is not the checked
source-boundary semantics for theorem-facing use. -/
def IsDisplayedAlgorithm2ProjectedUpdate {d : ℕ} (setup : Setup d)
    (t : ℕ) (state : State d) (m vhat xnext : CoordinateSpace d) : Prop :=
  ∃ sqrtVhat direction trial,
    IsCoordSqrt vhat sqrtVhat ∧
    IsCoordDisplayedQuotient m sqrtVhat direction ∧
    trial = state.x - setup.alpha_t t • direction ∧
    IsDisplayedWeightedProjection setup.F
      (amsgradProjectionMetricFromSqrt sqrtVhat) trial xnext

/-- Internal compatibility alias for the displayed Algorithm 2 projected update.

This alias keeps the older name available, but its semantics are exactly
`IsDisplayedAlgorithm2ProjectedUpdate`: raw printed quotient/projection syntax
without the denominator and `S_+^d` notation-domain facts.  The corrected
theorem-facing boundary is `IsWellDefinedProjectedUpdate`/
`WellDefinedRunOnHorizon`. -/
abbrev IsAlgorithm2ProjectedUpdate {d : ℕ} (setup : Setup d)
    (t : ℕ) (state : State d) (m vhat xnext : CoordinateSpace d) : Prop :=
  IsDisplayedAlgorithm2ProjectedUpdate setup t state m vhat xnext

/-- Internal compatibility name for the displayed projected AMSGrad point
`Π_{F,√\hat V_t}(x_t - α_t m_t / √\hat v_t)`.

This compatibility name is intentionally the raw Algorithm 2 relation, not the
checked domain contract, and must not be used as theorem-facing source
semantics. -/
def IsProjectedUpdate {d : ℕ} (setup : Setup d)
    (t : ℕ) (state : State d) (m vhat xnext : CoordinateSpace d) : Prop :=
  IsAlgorithm2ProjectedUpdate setup t state m vhat xnext

/-- Checked projected AMSGrad point.

This relation records the same square-root witness in the quotient and metric
and includes the source notation domains from Section 2: ordinary coordinate
division requires nonzero denominators, and `Π_{F,A}` is defined there for
`A ∈ S_+^d`.  It is a proof-side compatibility boundary, not the unqualified
Algorithm 2 run relation.

Signature-contract classification: corrected extension update relation.  It is
the visible checked boundary required by the audit and must not be reported as
the original paper's unchecked Algorithm 2 update. -/
def IsWellDefinedProjectedUpdate {d : ℕ} (setup : Setup d)
    (t : ℕ) (state : State d) (m vhat xnext : CoordinateSpace d) : Prop :=
  SOptLib.IsCheckedAdaptiveProjectedUpdate
    setup.F (setup.alpha_t t) state.x m vhat xnext
    IsCoordSqrt IsCoordQuotient
    amsgradProjectionMetricFromSqrt IsWeightedProjection


/-- Any corrected well-defined projected AMSGrad update carries the displayed
quotient and projection-notation domains. -/
theorem projectedUpdate_domainObligation_of_isWellDefinedProjectedUpdate {d : ℕ}
    (setup : Setup d) (t : ℕ) (state : State d)
    (m vhat xnext : CoordinateSpace d)
    (hupdate : IsWellDefinedProjectedUpdate setup t state m vhat xnext) :
    ∃ sqrtVhat,
      IsCoordSqrt vhat sqrtVhat ∧
        (∀ i, sqrtVhat i ≠ 0) ∧
        IsWeightedProjectionDomain (amsgradProjectionMetricFromSqrt sqrtVhat) := by
  rcases hupdate with ⟨sqrtVhat, direction, trial, hsqrt, hquot, htrial, hproj⟩
  refine ⟨sqrtVhat, hsqrt, ?_, hproj.1⟩
  intro i
  exact (hquot i).1

/-- Compatibility theorem: a checked projected update realizes the raw
displayed projected-update relation.

This bridge goes only from the explicit corrected boundary to the internal
displayed syntax.  There is intentionally no converse theorem from `Run` or
`IsAlgorithm2ProjectedUpdate` to checked denominator/projection-domain facts. -/
theorem isProjectedUpdate_of_isWellDefinedProjectedUpdate {d : ℕ}
    (setup : Setup d) (t : ℕ) (state : State d)
    (m vhat xnext : CoordinateSpace d)
    (hupdate : IsWellDefinedProjectedUpdate setup t state m vhat xnext) :
    IsProjectedUpdate setup t state m vhat xnext := by
  rcases hupdate with ⟨sqrtVhat, direction, trial, hsqrt, hquot, htrial, hproj⟩
  exact ⟨sqrtVhat, direction, trial, hsqrt,
    isCoordDisplayedQuotient_of_isCoordQuotient m sqrtVhat direction hquot,
    htrial,
    isDisplayedWeightedProjection_of_isWeightedProjection setup.F
      (amsgradProjectionMetricFromSqrt sqrtVhat) trial xnext hproj⟩

/-- One full Algorithm 2 loop relation, run at paper time `t = n + 1`.

This is an internal displayed-syntax relation: it computes `g_t`, `m_t`,
`v_t`, and `\hat v_t` definitionally, and relates `x_{t+1}` to the printed
quotient-bearing weighted projection without the Section 2 denominator and
`S_+^d` notation domains.  The corrected theorem-facing one-step object is
`IsWellDefinedNextState`. -/
noncomputable def IsNextState {d : ℕ} (setup : Setup d)
    (n : ℕ) (state : State d) (g : CoordinateSpace d) (next : State d) : Prop :=
  let t := n + 1
  let m := firstMoment setup t state g
  let v := secondMoment setup state g
  let vhat := longTermMemory state v
  IsGradientAtState setup t state g ∧
    next.m = m ∧ next.v = v ∧ next.vhat = vhat ∧
    IsAlgorithm2ProjectedUpdate setup t state m vhat next.x

/-- Extension-only corrected well-defined Algorithm 2 loop relation, run at
paper time `t = n + 1`.

This is the theorem-facing corrected one-step object for the source-boundary
gap identified in Algorithm 2: it uses the same generated `g_t`, `m_t`, `v_t`,
and `\hat v_t`, but the projected update is interpreted with an ordinary
coordinate quotient (`IsCoordQuotient`) and a weighted projection in the
paper's notation domain (`IsWeightedProjection`).

No SOptLib match: checked `recursiveProcess_succ_eq_sample_update`,
`BlockIterateState`/`blockMirrorUpdate`, and `mirrorStep_minimizes_of_update`;
they provide generic recursion, block-prox, or mirror-step transport, not the
Algorithm 2 AMSGrad tuple update with the shared square-root witness in both
the quotient and `Π_{F,√\hat V_t}`. -/
noncomputable def IsWellDefinedNextState {d : ℕ} (setup : Setup d)
    (n : ℕ) (state : State d) (g : CoordinateSpace d) (next : State d) : Prop :=
  let t := n + 1
  let m := firstMoment setup t state g
  let v := secondMoment setup state g
  let vhat := longTermMemory state v
  IsGradientAtState setup t state g ∧
    next.m = m ∧ next.v = v ∧ next.vhat = vhat ∧
    IsWellDefinedProjectedUpdate setup t state m vhat next.x

/-- Candidate pairs `(g_t, state_t)` for one displayed Algorithm 2 step from a
given loop-boundary state.

This is the object-level replacement for treating the next state as primitive
run data: the admissible values are exactly those satisfying the canonical
one-step relation `IsNextState`.  The selected definitions below choose from
this set when it is nonempty and expose that choice through spec theorems. -/
noncomputable def displayedStepCandidates {d : ℕ} (setup : Setup d)
    (n : ℕ) (state : State d) : Set (CoordinateSpace d × State d) :=
  {p | IsNextState setup n state p.1 p.2}

/-- Candidate pairs `(g_t, state_t)` for one checked, well-defined Algorithm 2
step from a given loop-boundary state. -/
noncomputable def wellDefinedStepCandidates {d : ℕ} (setup : Setup d)
    (n : ℕ) (state : State d) : Set (CoordinateSpace d × State d) :=
  {p | IsWellDefinedNextState setup n state p.1 p.2}

/-- Fallback state used only to totalize the selected displayed step outside
its existence domain.

The source semantics are supplied by `displayedStepCandidates` and the spec
theorem `algorithm2StepChoice_spec_of_exists`; this default is never a paper
claim. -/
noncomputable def defaultNextState {d : ℕ} (setup : Setup d)
    (n : ℕ) (state : State d) : State d :=
  let g : CoordinateSpace d := 0
  let t := n + 1
  let m := firstMoment setup t state g
  let v := secondMoment setup state g
  let vhat := longTermMemory state v
  { x := state.x, m := m, v := v, vhat := vhat }

/-- Fallback pair used only to totalize `algorithm2StepChoice` outside its
existence domain. -/
noncomputable def defaultStepChoice {d : ℕ} (setup : Setup d)
    (n : ℕ) (state : State d) : CoordinateSpace d × State d :=
  (0, defaultNextState setup n state)

/-- Canonically selected displayed Algorithm 2 one-step choice.

When the displayed one-step relation is solvable, this is a `Classical.choose`
selection from the exact candidate set.  The fallback branch is deliberately
exposed by the accompanying spec theorem instead of being used as paper
semantics. -/
noncomputable def algorithm2StepChoice {d : ℕ} (setup : Setup d)
    (n : ℕ) (state : State d) : CoordinateSpace d × State d :=
  by
    classical
    exact
      if h : (displayedStepCandidates setup n state).Nonempty then
        Classical.choose h
      else
        defaultStepChoice setup n state

/-- Gradient component of the selected displayed Algorithm 2 step. -/
noncomputable def algorithm2StepGradient {d : ℕ} (setup : Setup d)
    (n : ℕ) (state : State d) : CoordinateSpace d :=
  (algorithm2StepChoice setup n state).1

/-- Next-state component of the selected displayed Algorithm 2 step. -/
noncomputable def algorithm2NextState {d : ℕ} (setup : Setup d)
    (n : ℕ) (state : State d) : State d :=
  (algorithm2StepChoice setup n state).2

/-- The selected displayed Algorithm 2 step satisfies the one-step relation
whenever that relation is solvable. -/
theorem algorithm2StepChoice_spec_of_exists {d : ℕ} (setup : Setup d)
    (n : ℕ) (state : State d)
    (h : (displayedStepCandidates setup n state).Nonempty) :
    IsNextState setup n state
      (algorithm2StepGradient setup n state)
      (algorithm2NextState setup n state) := by
  have hmem :
      algorithm2StepChoice setup n state ∈ displayedStepCandidates setup n state := by
    rw [algorithm2StepChoice, dif_pos h]
    exact Classical.choose_spec h
  simpa [displayedStepCandidates, algorithm2StepGradient, algorithm2NextState] using hmem

/-- Canonically selected checked Algorithm 2 one-step choice.

This is the well-defined counterpart of `algorithm2StepChoice`: it selects from
the checked relation carrying the quotient and weighted-projection notation
domains. -/
noncomputable def wellDefinedAlgorithm2StepChoice {d : ℕ} (setup : Setup d)
    (n : ℕ) (state : State d) : CoordinateSpace d × State d :=
  by
    classical
    exact
      if h : (wellDefinedStepCandidates setup n state).Nonempty then
        Classical.choose h
      else
        defaultStepChoice setup n state

/-- Gradient component of the selected checked Algorithm 2 step. -/
noncomputable def wellDefinedAlgorithm2StepGradient {d : ℕ} (setup : Setup d)
    (n : ℕ) (state : State d) : CoordinateSpace d :=
  (wellDefinedAlgorithm2StepChoice setup n state).1

/-- Next-state component of the selected checked Algorithm 2 step. -/
noncomputable def wellDefinedAlgorithm2NextState {d : ℕ} (setup : Setup d)
    (n : ℕ) (state : State d) : State d :=
  (wellDefinedAlgorithm2StepChoice setup n state).2

/-- The selected checked Algorithm 2 step satisfies the checked one-step
relation whenever that relation is solvable. -/
theorem wellDefinedAlgorithm2StepChoice_spec_of_exists {d : ℕ} (setup : Setup d)
    (n : ℕ) (state : State d)
    (h : (wellDefinedStepCandidates setup n state).Nonempty) :
    IsWellDefinedNextState setup n state
      (wellDefinedAlgorithm2StepGradient setup n state)
      (wellDefinedAlgorithm2NextState setup n state) := by
  have hmem :
      wellDefinedAlgorithm2StepChoice setup n state ∈
        wellDefinedStepCandidates setup n state := by
    exact choiceOrDefault_mem_of_nonempty
      (wellDefinedStepCandidates setup n state)
      (defaultStepChoice setup n state) h
  simpa [wellDefinedStepCandidates, wellDefinedAlgorithm2StepGradient,
    wellDefinedAlgorithm2NextState] using hmem

/-- Generated displayed Algorithm 2 state sequence obtained by recursively
applying the selected canonical one-step update from the paper initialization.

This is the canonical object-layer sequence.  The legacy `Run` structure below
is retained as a compatibility view for the existing proof infrastructure. -/
noncomputable def algorithm2GeneratedState {d : ℕ}
    (setup : Setup d) : ℕ → State d
  | 0 => initialState setup
  | n + 1 => algorithm2NextState setup n (algorithm2GeneratedState setup n)

/-- Generated displayed Algorithm 2 gradient sequence associated with
`algorithm2GeneratedState`.  Time `0` is outside the paper loop and is
totalized by `0`. -/
noncomputable def algorithm2GeneratedGradient {d : ℕ}
    (setup : Setup d) (t : ℕ) : CoordinateSpace d :=
  if _ : 1 ≤ t then
    algorithm2StepGradient setup (t - 1) (algorithm2GeneratedState setup (t - 1))
  else
    0

theorem algorithm2GeneratedState_zero {d : ℕ} (setup : Setup d) :
    algorithm2GeneratedState setup 0 = initialState setup := rfl

theorem algorithm2GeneratedState_succ {d : ℕ} (setup : Setup d) (n : ℕ) :
    algorithm2GeneratedState setup (n + 1) =
      algorithm2NextState setup n (algorithm2GeneratedState setup n) := rfl

/-- The generated displayed sequence satisfies Algorithm 2 at step `n` whenever
the selected one-step relation is solvable at the generated state. -/
theorem algorithm2GeneratedState_succ_spec_of_exists {d : ℕ}
    (setup : Setup d) (n : ℕ)
    (h :
      (displayedStepCandidates setup n (algorithm2GeneratedState setup n)).Nonempty) :
    IsNextState setup n (algorithm2GeneratedState setup n)
      (algorithm2GeneratedGradient setup (n + 1))
      (algorithm2GeneratedState setup (n + 1)) := by
  simpa [algorithm2GeneratedGradient, Nat.succ_eq_add_one] using
    algorithm2StepChoice_spec_of_exists setup n
      (algorithm2GeneratedState setup n) h

/-- Generated checked Algorithm 2 state sequence obtained by recursively
applying the selected well-defined one-step update. -/
noncomputable def wellDefinedAlgorithm2GeneratedState {d : ℕ}
    (setup : Setup d) : ℕ → State d
  | 0 => initialState setup
  | n + 1 =>
      wellDefinedAlgorithm2NextState setup n
        (wellDefinedAlgorithm2GeneratedState setup n)

/-- Generated checked Algorithm 2 gradient sequence associated with
`wellDefinedAlgorithm2GeneratedState`. -/
noncomputable def wellDefinedAlgorithm2GeneratedGradient {d : ℕ}
    (setup : Setup d) (t : ℕ) : CoordinateSpace d :=
  if _ : 1 ≤ t then
    wellDefinedAlgorithm2StepGradient setup (t - 1)
      (wellDefinedAlgorithm2GeneratedState setup (t - 1))
  else
    0

theorem wellDefinedAlgorithm2GeneratedState_zero {d : ℕ} (setup : Setup d) :
    wellDefinedAlgorithm2GeneratedState setup 0 = initialState setup := rfl

theorem wellDefinedAlgorithm2GeneratedState_succ {d : ℕ} (setup : Setup d)
    (n : ℕ) :
    wellDefinedAlgorithm2GeneratedState setup (n + 1) =
      wellDefinedAlgorithm2NextState setup n
        (wellDefinedAlgorithm2GeneratedState setup n) := rfl

/-- The generated checked sequence satisfies the checked Algorithm 2 relation
at step `n` whenever that relation is solvable at the generated state. -/
theorem wellDefinedAlgorithm2GeneratedState_succ_spec_of_exists {d : ℕ}
    (setup : Setup d) (n : ℕ)
    (h :
      (wellDefinedStepCandidates setup n
        (wellDefinedAlgorithm2GeneratedState setup n)).Nonempty) :
    IsWellDefinedNextState setup n
      (wellDefinedAlgorithm2GeneratedState setup n)
      (wellDefinedAlgorithm2GeneratedGradient setup (n + 1))
      (wellDefinedAlgorithm2GeneratedState setup (n + 1)) := by
  simpa [wellDefinedAlgorithm2GeneratedGradient, Nat.succ_eq_add_one] using
    wellDefinedAlgorithm2StepChoice_spec_of_exists setup n
      (wellDefinedAlgorithm2GeneratedState setup n) h

/-- Source-boundary proof obligation for solvability of every checked
Algorithm 2 step along the generated state sequence.

The paper defines the next iterate by the displayed weighted projection update;
Lean must additionally justify existence of the selected gradient/projection
object and the quotient/projection notation domains.  This is deliberately a
`Prop` obligation rather than an unconditional theorem: neither the book JSON
nor PDF Theorem 4 states generated quotient denominators, projection-domain
facts, or gradient-realization existence for arbitrary setups. -/
def WellDefinedAlgorithm2GeneratedSolvability {d : ℕ}
    (setup : Setup d) : Prop :=
  ∀ n,
    (wellDefinedStepCandidates setup n
      (wellDefinedAlgorithm2GeneratedState setup n)).Nonempty

/-- Finite-horizon source-boundary proof obligation for checked solvability of
the generated Algorithm 2 process.

Theorem 4 is stated on a fixed paper horizon `T`: Algorithm 2 runs for
`t = 1, ..., T`, and the theorem assumes only the sequences obtained on that
horizon.  This predicate is therefore the generated-process boundary that
matches the theorem statement; the all-time
`WellDefinedAlgorithm2GeneratedSolvability` predicate is retained only for
legacy adapters that must manufacture a global `Run`. -/
def WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon {d : ℕ}
    (setup : Setup d) (T : ℕ) : Prop :=
  ∀ n, n + 1 ∈ Finset.Icc 1 T →
    (wellDefinedStepCandidates setup n
      (wellDefinedAlgorithm2GeneratedState setup n)).Nonempty

/-- The generated checked Algorithm 2 sequence satisfies the checked one-step
recursion whenever the named source-boundary solvability obligation is
available.

This is the theorem-facing replacement for carrying the Algorithm 2 update as
a theorem-local hypothesis or arbitrary run witness, without asserting the
missing domain facts for every setup. -/
theorem wellDefinedAlgorithm2GeneratedState_succ_spec {d : ℕ}
    (setup : Setup d)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvability setup) (n : ℕ) :
    IsWellDefinedNextState setup n
      (wellDefinedAlgorithm2GeneratedState setup n)
      (wellDefinedAlgorithm2GeneratedGradient setup (n + 1))
      (wellDefinedAlgorithm2GeneratedState setup (n + 1)) := by
  exact wellDefinedAlgorithm2GeneratedState_succ_spec_of_exists setup n
    (hsolv n)

/-- The generated checked Algorithm 2 sequence satisfies the checked one-step
recursion on a finite theorem horizon whenever the horizon-local generated
solvability obligation is available. -/
theorem wellDefinedAlgorithm2GeneratedState_succ_spec_on_horizon {d : ℕ}
    (setup : Setup d) (T n : ℕ)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (hn : n + 1 ∈ Finset.Icc 1 T) :
    IsWellDefinedNextState setup n
      (wellDefinedAlgorithm2GeneratedState setup n)
      (wellDefinedAlgorithm2GeneratedGradient setup (n + 1))
      (wellDefinedAlgorithm2GeneratedState setup (n + 1)) := by
  exact wellDefinedAlgorithm2GeneratedState_succ_spec_of_exists setup n
    (hsolv n hn)

/-- Internal displayed-syntax sequence following the printed Algorithm 2
recurrences.

Source citation: `book/ICLR2018/AMSGrad.json#/algorithm_spec` gives
initialization `x_1∈F, m_0=0, v_0=0, \hat v_0=0` and the loop equations for
`g_t`, `m_t`, `v_t`, `\hat v_t`, and the projected update.

The paper theorem quantifies over `{x_t}` and `{v_t}` obtained from Algorithm
2, but the printed update contains ordinary division and weighted projection
notation whose generated denominator and `S_+^d` domain facts are not stated in
Theorem 4.  This object therefore records only the displayed raw syntax.  It is
internal compatibility scaffolding and must not be treated as the A-level
source semantics for Theorem 4; use `WellDefinedRunOnHorizon` for the
corrected extension boundary. -/
structure DisplayedRun {d : ℕ} (setup : Setup d) where
  state : ℕ → State d
  g : ℕ → CoordinateSpace d
  initial : state 0 = initialState setup
  step : ∀ n, IsNextState setup n (state n) (g (n + 1)) (state (n + 1))

/-- Compatibility alias for older proof-side code.

`Run` is deliberately an alias for `DisplayedRun`, the raw displayed-syntax
sequence. It is not classified as the original paper's fully well-defined
Algorithm 2 generated sequence; downstream paper theorem work must use the
explicit corrected boundary `WellDefinedRunOnHorizon`. -/
abbrev Run {d : ℕ} (setup : Setup d) := DisplayedRun setup

/-- Algorithm 2 state sequence carried by a displayed-syntax run.

Source-facing classification: selector for `Run`, which is the raw displayed
Algorithm 2 recursion.  It does not add denominator or projection-domain facts;
those remain visible only through `WellDefinedRunOnHorizon`. -/
def stateSeq {d : ℕ} (setup : Setup d) (run : Run setup) : ℕ → State d :=
  run.state

/-- Paper iterate `x_t` for positive paper time, read from the generated state
sequence.

Source-facing classification: raw displayed-run selector.  The selector itself
is canonical Algorithm 2 notation, but theorem-facing checked semantics must
come from `WellDefinedRunOnHorizon`, not from this accessor. -/
def xSeq {d : ℕ} (setup : Setup d) (run : Run setup)
    (t : ℕ) : CoordinateSpace d :=
  (stateSeq setup run (t - 1)).x

/-- Generated first-moment sequence `m_t`.

Source-facing classification: raw displayed-run selector for Algorithm 2's
first-moment component. -/
def mSeq {d : ℕ} (setup : Setup d) (run : Run setup)
    (t : ℕ) : CoordinateSpace d :=
  (stateSeq setup run t).m

/-- Generated second-moment sequence `v_t`.

Source-facing classification: raw displayed-run selector for Algorithm 2's
second-moment component. -/
def vSeq {d : ℕ} (setup : Setup d) (run : Run setup)
    (t : ℕ) : CoordinateSpace d :=
  (stateSeq setup run t).v

/-- Generated long-term memory sequence `\hat v_t`.

Source-facing classification: raw displayed-run selector.  Nonzero square-root
denominator and positive-definite metric facts for this sequence are not
derived from the selector; they are exactly the corrected-boundary obligations
recorded by `RunDomainObligations`. -/
def vhatSeq {d : ℕ} (setup : Setup d) (run : Run setup)
    (t : ℕ) : CoordinateSpace d :=
  (stateSeq setup run t).vhat

/-- Generated gradient history `g_t = ∇f_t(x_t)`.

Source: `book/ICLR2018/AMSGrad.json#/algorithm_spec/steps/0` states
`g_t=∇f_t(x_t)`, and `#/algorithm_spec/parameters/3` introduces the history
notation `g_{1:t}=[g_1 ... g_t]`.  This selector is generated from `Run`; it
is not a primitive setup field. -/
def gSeq {d : ℕ} (setup : Setup d) (run : @Run d setup)
    (t : ℕ) : CoordinateSpace d :=
  run.g t

/-- Extension-only horizon-local domain facts required to interpret the
displayed Algorithm 2 quotient and projection notation as checked real division
and a projection with metric in `S_+^d`.

The PDF defines these notation domains in Section 2, but Theorem 4 does not
state them as assumptions for the generated run.  Consequently this predicate is
not implied by `Run`, has no unconditional bridge from `Run`, and is consumed
only by corrected/extension declarations. -/
def RunDomainObligations {d : ℕ} (setup : Setup d) (run : Run setup)
    (T : ℕ) : Prop :=
  ∀ t ∈ Finset.Icc 1 T,
    ∃ sqrtVhat,
      IsCoordSqrt (vhatSeq setup run t) sqrtVhat ∧
        (∀ i, sqrtVhat i ≠ 0) ∧
        IsWeightedProjectionDomain (amsgradProjectionMetricFromSqrt sqrtVhat)

/-- Extension-only finite-horizon compatibility view of the checked Algorithm
2 boundary.

Source-boundary citation: `book/ICLR2018/AMSGrad.json#/algorithm_spec/steps/4`
prints the quotient/projection update; the PDF Section 2 notation paragraph
defines vector division and `Π_{F,A}` for `A ∈ S_+^d`; neither
`book/ICLR2018/AMSGrad.json#/main_theorem/statement_math` nor PDF Theorem 4
lists generated nonzero denominators or generated positive-definite projection
metrics as theorem assumptions.

This is an extension-side/proof-side corrected boundary: it adds the quotient
denominator and positive-definite projection-domain facts that are not part of
the unqualified displayed `Run`. Any theorem consuming this predicate must be
classified as extension-only, not as the original Theorem 4 statement. -/
def WellDefinedRunOnHorizon {d : ℕ} (setup : Setup d) (run : Run setup)
    (T : ℕ) : Prop :=
  RunDomainObligations setup run T ∧
    ∀ n, n + 1 ∈ Finset.Icc 1 T →
      let t := n + 1
      let state := stateSeq setup run n
      let g := gSeq setup run t
      let m := firstMoment setup t state g
      let v := secondMoment setup state g
      let vhat := longTermMemory state v
      IsWellDefinedProjectedUpdate setup t state m vhat (stateSeq setup run (n + 1)).x

/-- Global checked Algorithm 2 run predicate.

Unlike `WellDefinedRunOnHorizon`, this is not a finite-horizon contract passed
into the paper theorem.  It states that a run is the checked Algorithm 2
process at every generated step; horizon-local views are derived from it. -/
def IsWellDefinedAlgorithm2Run {d : ℕ} (setup : Setup d) (run : Run setup) : Prop :=
  ∀ n,
    IsWellDefinedNextState setup n (stateSeq setup run n)
      (gSeq setup run (n + 1)) (stateSeq setup run (n + 1))

/-- A globally checked Algorithm 2 run supplies the corrected finite-horizon
well-definedness view required by the legacy proof infrastructure. -/
theorem wellDefinedRunOnHorizon_of_isWellDefinedAlgorithm2Run {d : ℕ}
    (setup : Setup d) (run : Run setup) (T : ℕ)
    (hrun : IsWellDefinedAlgorithm2Run setup run) :
    WellDefinedRunOnHorizon setup run T := by
  constructor
  · intro t ht
    have ht_pos : 1 ≤ t := (Finset.mem_Icc.mp ht).1
    let n := t - 1
    have hn_succ : n + 1 = t := Nat.sub_add_cancel ht_pos
    have hstep := hrun n
    rcases hstep with ⟨_hgrad, _hm, _hv, hvhat, hupdate⟩
    subst n
    have hdomain_expr :
        ∃ sqrtVhat,
          IsCoordSqrt
              (longTermMemory (stateSeq setup run (t - 1))
                (secondMoment setup (stateSeq setup run (t - 1))
                  (gSeq setup run (t - 1 + 1)))) sqrtVhat ∧
            (∀ i, sqrtVhat i ≠ 0) ∧
            IsWeightedProjectionDomain
              (amsgradProjectionMetricFromSqrt sqrtVhat) := by
      exact
        projectedUpdate_domainObligation_of_isWellDefinedProjectedUpdate
          setup (t - 1 + 1) (stateSeq setup run (t - 1))
          (firstMoment setup (t - 1 + 1) (stateSeq setup run (t - 1))
            (gSeq setup run (t - 1 + 1)))
          (longTermMemory (stateSeq setup run (t - 1))
            (secondMoment setup (stateSeq setup run (t - 1))
              (gSeq setup run (t - 1 + 1))))
          (stateSeq setup run (t - 1 + 1)).x
          (by simpa [IsWellDefinedNextState, stateSeq, hn_succ] using hupdate)
    rw [← hn_succ]
    change ∃ sqrtVhat,
      IsCoordSqrt (stateSeq setup run (t - 1 + 1)).vhat sqrtVhat ∧
        (∀ i, sqrtVhat i ≠ 0) ∧
        IsWeightedProjectionDomain (amsgradProjectionMetricFromSqrt sqrtVhat)
    rw [hvhat]
    exact hdomain_expr
  · intro n hn
    have hstep := hrun n
    rcases hstep with ⟨_hgrad, _hm, _hv, _hvhat, hupdate⟩
    simpa [IsWellDefinedNextState] using hupdate

/-- A corrected one-step update is also a raw displayed one-step update.

This is a one-way internal bridge from the extension-only checked semantics to
the raw displayed syntax.  The converse would assert generated denominator and
`S_+^d` facts that are not stated in Theorem 4. -/
theorem isNextState_of_isWellDefinedNextState {d : ℕ} (setup : Setup d)
    (n : ℕ) (state : State d) (g : CoordinateSpace d) (next : State d)
    (hstep : IsWellDefinedNextState setup n state g next) :
    IsNextState setup n state g next := by
  rcases hstep with ⟨hgrad, hm, hv, hvhat, hupdate⟩
  exact ⟨hgrad, hm, hv, hvhat,
    isProjectedUpdate_of_isWellDefinedProjectedUpdate setup (n + 1) state
      (firstMoment setup (n + 1) state g)
      (longTermMemory state (secondMoment setup state g)) next.x hupdate⟩

/-- The canonical generated checked Algorithm 2 process, exposed as a `Run`
adapter only so the existing proof infrastructure can be reused.

The state and gradient components are the generated definitions
`wellDefinedAlgorithm2GeneratedState` and
`wellDefinedAlgorithm2GeneratedGradient`; the `Run` wrapper is not primitive
input data. -/
private noncomputable def wellDefinedAlgorithm2GeneratedRun {d : ℕ}
    (setup : Setup d)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvability setup) : Run setup where
  state := wellDefinedAlgorithm2GeneratedState setup
  g := wellDefinedAlgorithm2GeneratedGradient setup
  initial := wellDefinedAlgorithm2GeneratedState_zero setup
  step := by
    intro n
    exact isNextState_of_isWellDefinedNextState setup n
      (wellDefinedAlgorithm2GeneratedState setup n)
      (wellDefinedAlgorithm2GeneratedGradient setup (n + 1))
      (wellDefinedAlgorithm2GeneratedState setup (n + 1))
      (wellDefinedAlgorithm2GeneratedState_succ_spec setup hsolv n)

/-- The generated checked Algorithm 2 process satisfies the global checked-run
predicate by construction from the explicit generated-step solvability
obligation. -/
private theorem wellDefinedAlgorithm2GeneratedRun_isWellDefined {d : ℕ}
    (setup : Setup d)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvability setup) :
    IsWellDefinedAlgorithm2Run setup
      (wellDefinedAlgorithm2GeneratedRun setup hsolv) := by
  intro n
  simpa [IsWellDefinedAlgorithm2Run, stateSeq, gSeq,
    wellDefinedAlgorithm2GeneratedRun] using
    wellDefinedAlgorithm2GeneratedState_succ_spec setup hsolv n

/-- Horizon-local checked well-definedness is derived for the generated
Algorithm 2 process from the explicit generated-step solvability obligation,
rather than being accepted as a hidden unconditional fact. -/
private theorem wellDefinedAlgorithm2GeneratedRun_wellDefinedOnHorizon {d : ℕ}
    (setup : Setup d)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvability setup) (T : ℕ) :
    WellDefinedRunOnHorizon setup
      (wellDefinedAlgorithm2GeneratedRun setup hsolv) T :=
  wellDefinedRunOnHorizon_of_isWellDefinedAlgorithm2Run setup
    (wellDefinedAlgorithm2GeneratedRun setup hsolv) T
    (wellDefinedAlgorithm2GeneratedRun_isWellDefined setup hsolv)

theorem stateSeq_zero {d : ℕ} (setup : Setup d) (run : Run setup) :
    stateSeq setup run 0 = initialState setup := by
  exact run.initial

theorem stateSeq_succ_isNextState {d : ℕ} (setup : Setup d)
    (run : Run setup) (n : ℕ) :
    IsNextState setup n (stateSeq setup run n) (gSeq setup run (n + 1))
      (stateSeq setup run (n + 1)) := by
  simpa [stateSeq, gSeq] using run.step n

/-- The generated gradient sequence realizes Algorithm 2's
`g_t = ∇ f_t(x_t)` at positive paper times. -/
theorem gSeq_succ_isGradientAtState {d : ℕ} (setup : Setup d)
    (run : Run setup) (n : ℕ) :
    IsGradientAtState setup (n + 1) (stateSeq setup run n)
      (gSeq setup run (n + 1)) := by
  simpa [stateSeq, gSeq, IsNextState] using (run.step n).1

/-- The generated sequence satisfies Algorithm 2's first-moment equation. -/
theorem mSeq_succ_eq {d : ℕ} (setup : Setup d) (run : Run setup) (n : ℕ) :
    mSeq setup run (n + 1) =
      firstMoment setup (n + 1) (stateSeq setup run n)
        (gSeq setup run (n + 1)) := by
  simpa [stateSeq, gSeq, mSeq, IsNextState] using (run.step n).2.1

/-- The generated sequence satisfies Algorithm 2's second-moment equation. -/
theorem vSeq_succ_eq {d : ℕ} (setup : Setup d) (run : Run setup) (n : ℕ) :
    vSeq setup run (n + 1) =
      secondMoment setup (stateSeq setup run n)
        (gSeq setup run (n + 1)) := by
  simpa [stateSeq, gSeq, vSeq, IsNextState] using (run.step n).2.2.1

/-- The generated sequence satisfies Algorithm 2's long-term-memory equation. -/
theorem vhatSeq_succ_eq {d : ℕ} (setup : Setup d) (run : Run setup) (n : ℕ) :
    vhatSeq setup run (n + 1) =
      longTermMemory (stateSeq setup run n) (vSeq setup run (n + 1)) := by
  have hv := (run.step n).2.2.1
  have hvhat := (run.step n).2.2.2.1
  simpa [stateSeq, vSeq, vhatSeq, IsNextState, hv] using hvhat

/-- The generated sequence satisfies Algorithm 2's displayed projected-update
relation. -/
theorem xSeq_succ_isAlgorithm2ProjectedUpdate {d : ℕ} (setup : Setup d)
    (run : Run setup) (n : ℕ) :
    IsAlgorithm2ProjectedUpdate setup (n + 1) (stateSeq setup run n)
      (mSeq setup run (n + 1)) (vhatSeq setup run (n + 1))
      (xSeq setup run (n + 2)) := by
  have hm := (run.step n).2.1
  have hvhat := (run.step n).2.2.2.1
  simpa [stateSeq, xSeq, mSeq, vhatSeq, IsNextState, hm, hvhat] using
    (run.step n).2.2.2.2

/-- A checked generated projected-update step exposes Algorithm 2's quotient
and projection-notation domains.

This theorem deliberately requires the checked update as an explicit
compatibility hypothesis; those facts are not extracted from a plain `Run`. -/
theorem xSeq_succ_projectedUpdate_domainObligation {d : ℕ} (setup : Setup d)
    (run : Run setup) (n : ℕ)
    (hwell :
      IsWellDefinedProjectedUpdate setup (n + 1) (stateSeq setup run n)
        (mSeq setup run (n + 1)) (vhatSeq setup run (n + 1))
        (xSeq setup run (n + 2))) :
    ∃ sqrtVhat,
      IsCoordSqrt (vhatSeq setup run (n + 1)) sqrtVhat ∧
        (∀ i, sqrtVhat i ≠ 0) ∧
        IsWeightedProjectionDomain (amsgradProjectionMetricFromSqrt sqrtVhat) := by
  exact projectedUpdate_domainObligation_of_isWellDefinedProjectedUpdate
    setup (n + 1) (stateSeq setup run n)
    (mSeq setup run (n + 1)) (vhatSeq setup run (n + 1))
    (xSeq setup run (n + 2)) hwell

/-- Extract the displayed quotient/projection-domain obligations from an
explicit checked-run compatibility hypothesis. -/
theorem runDomainObligations_of_wellDefinedRunOnHorizon {d : ℕ}
    (setup : Setup d) (run : Run setup) (T : ℕ)
    (hwell : WellDefinedRunOnHorizon setup run T) :
    RunDomainObligations setup run T := by
  exact hwell.1

/-- Extract a checked projected-update step from an explicit finite-horizon
well-definedness hypothesis. -/
theorem wellDefinedProjectedUpdate_of_wellDefinedRunOnHorizon {d : ℕ}
    (setup : Setup d) (run : Run setup) (T n : ℕ)
    (hwell : WellDefinedRunOnHorizon setup run T)
    (hn : n + 1 ∈ Finset.Icc 1 T) :
    let t := n + 1
    let state := stateSeq setup run n
    let g := gSeq setup run t
    let m := firstMoment setup t state g
    let v := secondMoment setup state g
    let vhat := longTermMemory state v
    IsWellDefinedProjectedUpdate setup t state m vhat (stateSeq setup run (n + 1)).x := by
  exact hwell.2 n hn

/-- Comparator regret used in the proof of Theorem 4 before selecting a best
fixed comparator.

Source: `book/ICLR2018/AMSGrad.json#/setup/problem`:
`R_T = ∑_{t=1}^T f_t(x_t) - min_{x∈F} ∑_{t=1}^T f_t(x)`.

Signature-contract classification: internal comparator-value helper.  It is
not the final paper-facing regret boundary because it takes an explicit
comparator point instead of modeling the displayed minimum/infimum boundary. -/
noncomputable def regretAgainst {d : ℕ} (setup : Setup d)
  (run : Run setup) (T : ℕ) (xStar : CoordinateSpace d) : ℝ :=
  ((Finset.Icc 1 T).sum fun t => setup.f t (xSeq setup run t)) -
    ((Finset.Icc 1 T).sum fun t => setup.f t xStar)

/-- Best-fixed-point predicate for the paper's
`min_{x∈F} ∑_{t=1}^T f_t(x)` expression.

Source: `book/ICLR2018/AMSGrad.json#/setup/problem` uses a minimum over
`x∈F`; this predicate is the attainment condition for that displayed
minimum, not an extra Setup assumption. -/
def IsBestFixedComparator {d : ℕ} (setup : Setup d)
  (T : ℕ) (xStar : {x : CoordinateSpace d // x ∈ setup.F}) : Prop :=
  IsMinOn (fun x : {x : CoordinateSpace d // x ∈ setup.F} =>
    (Finset.Icc 1 T).sum fun t => setup.f t x.1) Set.univ xStar

/-- Feasible fixed-comparator objective values in the paper regret
`min_{x∈F} ∑_{t=1}^T f_t(x)`.

Source: `book/ICLR2018/AMSGrad.json#/setup/problem` displays the comparator
as `min_{x∈F} ∑ f_t(x)`.  The value set exposes the source comparator domain
without assuming an attained minimizer.

SOptLib candidates considered: `ObjectiveMinimum` and
`objectiveMinimum_exists_of_isCompact_continuousOn` require an attained
minimum/compact-continuous hypotheses not stated in AMSGrad Theorem 4; this
local value set keeps the paper's finite-horizon comparator expression without
selecting an unsupported optimizer. -/
noncomputable def fixedComparatorValues {d : ℕ} (setup : Setup d)
    (T : ℕ) : Set ℝ :=
  (fun x : {x : CoordinateSpace d // x ∈ setup.F} =>
    (Finset.Icc 1 T).sum fun t => setup.f t x.1) '' Set.univ

/-- Infimum-form corrected fixed feasible value for the paper regret boundary.

The source writes a minimum over `F`; because neither the JSON nor PDF states
attainment assumptions, the Lean object records the value side directly as the
infimum of feasible finite-horizon values and leaves attainment only as the
separate predicate `IsBestFixedComparator` when a later proof has it.

Source boundary: `book/ICLR2018/AMSGrad.json#/setup/problem` states
`min_{x∈F} ∑ f_t(x)`, while PDF Theorem 4 assumes bounded diameter and bounded
gradients but does not state compactness/closedness/continuity/attainment for
that minimum.  Therefore this declaration is a corrected boundary object, not
the original minimum notation itself. -/
noncomputable def fixedComparatorInfimumValue {d : ℕ}
    (setup : Setup d) (T : ℕ) : ℝ :=
  sInf (fixedComparatorValues setup T)

/-- If the finite-horizon comparator is attained,
`fixedComparatorInfimumValue` agrees with the paper's selected minimum value. -/
theorem fixedComparatorInfimumValue_eq_of_isBest {d : ℕ} (setup : Setup d)
    (T : ℕ) (xStar : {x : CoordinateSpace d // x ∈ setup.F})
    (hStar : IsBestFixedComparator setup T xStar) :
    fixedComparatorInfimumValue setup T =
      (Finset.Icc 1 T).sum fun t => setup.f t xStar.1 := by
  let φ : {x : CoordinateSpace d // x ∈ setup.F} → ℝ :=
    fun x => (Finset.Icc 1 T).sum fun t => setup.f t x.1
  have hmin : ∀ y, φ xStar ≤ φ y := by
    intro y
    exact ((isMinOn_univ_iff).1 hStar) y
  have hmem : φ xStar ∈ φ '' Set.univ := ⟨xStar, Set.mem_univ _, rfl⟩
  have hnonempty : (φ '' Set.univ).Nonempty := ⟨φ xStar, hmem⟩
  have hlower : ∀ y ∈ φ '' Set.univ, φ xStar ≤ y := by
    intro y hy
    rcases hy with ⟨z, -, rfl⟩
    exact hmin z
  have hbdd : BddBelow (φ '' Set.univ) := ⟨φ xStar, hlower⟩
  unfold fixedComparatorInfimumValue fixedComparatorValues
  change sInf (φ '' Set.univ) = φ xStar
  exact le_antisymm (csInf_le hbdd hmem) (le_csInf hnonempty hlower)

/-- Corrected infimum-form regret boundary corresponding to the paper's
`R_T` when comparator attainment has not yet been derived.

Source boundary: `book/ICLR2018/AMSGrad.json#/setup/problem` uses a minimum
over `F`; this infimum-form regret is the explicit correction used by the
extension theorem until `fixedComparatorInfimumValue_eq_of_isBest` supplies an
attainment bridge. -/
noncomputable def regretAgainstInfimum {d : ℕ}
    (setup : Setup d) (run : Run setup)
    (T : ℕ) : ℝ :=
  ((Finset.Icc 1 T).sum fun t => setup.f t (xSeq setup run t)) -
    fixedComparatorInfimumValue setup T

/-- Coordinate-history norm `‖g_{1:T,i}‖₂` from Theorem 4.

Source: `book/ICLR2018/AMSGrad.json#/algorithm_spec/parameters/3` defines
`g_{1:t}=[g_1 ... g_t]`; `#/main_theorem/statement_math` uses
`∑_i ‖g_{1:T,i}‖_2` in the RHS.

Signature-contract classification: canonical notation helper for the displayed
RHS.  It carries no denominator or update-domain facts. -/
noncomputable def gradientHistoryNorm {d : ℕ} (setup : Setup d)
    (run : Run setup) (T : ℕ) (i : Fin d) : ℝ :=
  Real.sqrt ((Finset.Icc 1 T).sum fun t => (gSeq setup run t i) ^ 2)

/-- Horizon-local bounded-gradient assumption from Theorem 4, expressed as
existence of the paper gradient together with its `ℓ∞` bound.

Source: `book/ICLR2018/AMSGrad.json#/assumptions/3`:
"`‖∇ f_t(x)‖_∞ ≤ G_∞` for all `t∈[T]` and `x∈F`".  This is horizon-local
because Theorem 4 quantifies over a finite `T`.

SOptLib candidates considered: subgradient norm bounds and Lipschitz bridges in
`SOptLib.Layer0.Subgradient` derive regularity consequences for other problem
classes.  The AMSGrad theorem assumes the literal bound
`‖∇ f_t(x)‖∞ ≤ G∞`; this predicate keeps that source assumption non-vacuous
by requiring a realized gradient at every feasible horizon point rather than a
conditional `HasGradientAt ->` implication. -/
def BoundedGradientsOnHorizon {d : ℕ} (setup : Setup d) (T : ℕ) : Prop :=
  ∀ t ∈ Finset.Icc 1 T, ∀ x, x ∈ setup.F →
    ∃ g, HasGradientAt (setup.f t) g x ∧ linftyNorm g ≤ setup.Ginf

/-- A realized gradient at a point covered by the paper's bounded-gradient
assumption satisfies the same `ℓ∞` bound.

This is a derived bridge, not a setup field: the source assumption is the
non-vacuous existence-and-bound predicate above, and later proof work must
transport the bound to any chosen gradient realization using gradient
uniqueness. -/
theorem boundedGradientsOnHorizon_bound_of_hasGradientAt {d : ℕ}
    (setup : Setup d) (T t : ℕ) (x g : CoordinateSpace d)
    (hbound : BoundedGradientsOnHorizon setup T)
    (ht : t ∈ Finset.Icc 1 T) (hx : x ∈ setup.F)
    (hg : HasGradientAt (setup.f t) g x) :
    linftyNorm g ≤ setup.Ginf := by
  rcases hbound t ht x hx with ⟨g0, hg0, hg0_bound⟩
  have h_eq : g0 = g := hg0.unique hg
  simpa [h_eq] using hg0_bound

/-- Theorem 4 notation `γ = β₁ / √β₂`.

Source: `book/ICLR2018/AMSGrad.json#/assumptions/5`:
"`β_1=β_11`, `β_{1t}≤β_1`, and `γ=β_1/√β_2<1`". -/
noncomputable def theorem4Gamma {d : ℕ} (setup : Setup d) : ℝ :=
  scalarQuotient (beta1 setup) (Real.sqrt setup.beta2)

/-- Lean arithmetic representative of the displayed right-hand side of AMSGrad
Theorem 4.

No SOptLib match: searched `AMSGrad adaptive regret bound output theorem rhs`
and `adaptive regret bound RHS theorem formula`; the available
Telescope/ParameterChoices hits describe other algorithms' averaged-output or
schedule formulas, not the AMSGrad Theorem 4 display. This is not the
source-facing theorem boundary: `IsTheorem4Bound` below records the displayed
roots and quotients relationally so the paper theorem does not rely on Lean's
total division or square-root conventions.

Signature-contract classification: internal totalized compatibility value.
Proofs may use it only after `totalizedRHSCompatibilityObligation`; it must not
stand in for the paper-facing RHS. -/
noncomputable def totalizedTheorem4RHSValue {d : ℕ} (setup : Setup d) (run : Run setup)
    (T : ℕ) : ℝ :=
  let betaOne := beta1 setup
  let firstTerm :=
    scalarQuotient (setup.Dinf ^ 2 * Real.sqrt (T : ℝ))
      (setup.alpha * (1 - betaOne)) *
      (∑ i, Real.sqrt (vhatSeq setup run T i))
  let secondTerm :=
    scalarQuotient (setup.Dinf ^ 2) (2 * (1 - betaOne)) *
      ((Finset.Icc 1 T).sum fun t =>
        ∑ i, scalarQuotient (setup.beta1t t * Real.sqrt (vhatSeq setup run t i))
          (setup.alpha_t t))
  let thirdTerm :=
    scalarQuotient
      (setup.alpha * Real.sqrt (1 + Real.log (T : ℝ)) *
        (∑ i, gradientHistoryNorm setup run T i))
      ((1 - betaOne) ^ 2 * (1 - theorem4Gamma setup) *
        Real.sqrt (1 - setup.beta2))
  firstTerm + secondTerm + thirdTerm

/-- Compatibility alias for the Lean totalized value corresponding to the
Theorem 4 display.  New source-facing statements should use
`IsTheorem4Bound`, not this totalized value.

Signature-contract classification: internal totalized compatibility alias for
legacy proof-side code.  It is not the paper-facing RHS object. -/
noncomputable def totalizedRHSValue {d : ℕ} (setup : Setup d) (run : Run setup)
    (T : ℕ) : ℝ :=
  totalizedTheorem4RHSValue setup run T

/-- Compatibility well-definedness boundary for the total RHS value
`totalizedTheorem4RHSValue`.

The PDF states the formula but not these denominator facts as theorem
assumptions.  This predicate is proof-side compatibility for code that wants to
justify the displayed divisions; it is not used by the source-facing theorem
boundary.

Source: `book/ICLR2018/AMSGrad.json#/main_theorem/statement_math` displays:
"`R_T≤ ... D_∞^2√T/(α(1-β_1)) ... + ... β_{1t}\hat v_{t,i}^{1/2}/α_t
... + ... /((1-β_1)^2(1-γ)√(1-β_2)) ...`".
Neither `book/ICLR2018/AMSGrad.json#/assumptions/5` nor PDF Theorem 4 lists
all of these denominator facts as primitive assumptions.

Signature-contract classification: extension-only RHS denominator obligation.
It may justify a totalized compatibility value, but it is not a source-facing
Theorem 4 assumption. -/
def totalizedRHSWellDefined {d : ℕ} (setup : Setup d) (_run : Run setup)
    (T : ℕ) : Prop :=
  setup.alpha * (1 - beta1 setup) ≠ 0 ∧
    2 * (1 - beta1 setup) ≠ 0 ∧
    Real.sqrt setup.beta2 ≠ 0 ∧
    ((1 - beta1 setup) ^ 2 * (1 - theorem4Gamma setup) *
      Real.sqrt (1 - setup.beta2)) ≠ 0 ∧
    (∃ sqrtBeta2 gamma sqrtOneMinusBeta2,
      IsScalarSqrt setup.beta2 sqrtBeta2 ∧
      IsScalarQuotient (beta1 setup) sqrtBeta2 gamma ∧
      gamma < 1 ∧
      IsScalarSqrt (1 - setup.beta2) sqrtOneMinusBeta2 ∧
      ((1 - beta1 setup) ^ 2 * (1 - gamma) *
        sqrtOneMinusBeta2) ≠ 0) ∧
    (∀ t ∈ Finset.Icc 1 T, IsTheorem4StepSizeAt setup t (setup.alpha_t t)) ∧
    (∀ t ∈ Finset.Icc 1 T, setup.alpha_t t ≠ 0)

/-- Extension-only source-boundary obligation for justifying the displayed
Theorem 4 RHS quotients used by `totalizedTheorem4RHSValue`.

Source: `book/ICLR2018/AMSGrad.json#/main_theorem/statement_math` displays
the quotient-bearing RHS terms, including "`β_{1t}\hat v_{t,i}^{1/2}/α_t`"
and the final denominator "`(1-β_1)^2(1-γ)√(1-β_2)`".
The paper prints these RHS quotients but does not separately state the scalar
denominator facts needed by Lean's total division.  Later proof phases may
prove this predicate from source-backed parameter information; source-facing
paper theorem declarations must not assume or derive it unconditionally.

Signature-contract classification: extension-only RHS compatibility obligation;
do not use it to claim the original paper theorem has been completed. -/
def totalizedRHSCompatibilityObligation {d : ℕ}
    (setup : Setup d) (run : Run setup) (T : ℕ) : Prop :=
  totalizedRHSWellDefined setup run T

/-- Source-facing relational interpretation of the displayed right-hand side in
AMSGrad Theorem 4.

Source citation: `book/ICLR2018/AMSGrad.json#/main_theorem/statement_math`
states: "`For x_t generated using the AMSGRAD (Algorithm 2), we have the
following bound on the regret`" followed by the three-term RHS containing
"`D_∞^2√T/(α(1-β_1))`", "`β_{1t}\hat v_{t,i}^{1/2}/α_t`", and
"`/((1-β_1)^2(1-γ)√(1-β_2))`".  Assumption
`book/ICLR2018/AMSGrad.json#/assumptions/5` states only
"`γ=β_1/√β_2<1`" and "`β_{1t}≤β_1`".  The PDF Theorem 4 repeats the same
displayed RHS and does not separately list scalar denominator facts for the
RHS.

The relation mirrors the paper display by carrying quotient witnesses for the
three denominator-bearing terms and square-root witnesses for the displayed
root expressions.  This prevents the paper theorem from becoming true through
Lean's total fallback values when a denominator or radicand is outside the
paper expression's intended domain.

Signature-contract classification: source-boundary relational RHS object.  It
is the theorem-facing replacement for totalized RHS values, but later proof
work must still discharge its quotient/root witnesses from source-backed
assumptions rather than treating `totalizedTheorem4RHSValue` as the paper
formula. -/
def IsTheorem4Bound {d : ℕ} (setup : Setup d) (run : Run setup)
    (T : ℕ) (B : ℝ) : Prop :=
  ∃ sqrtT sqrtBeta2 gamma sqrtOneMinusBeta2 sqrtOnePlusLogT
      firstCoeff secondCoeff thirdTerm,
    ∃ terminalVhatSqrt : CoordinateSpace d,
    ∃ adaptiveVhatSqrt : ℕ → CoordinateSpace d,
    ∃ adaptiveTerm : ℕ → Fin d → ℝ,
    ∃ historyNorm : Fin d → ℝ,
    IsScalarSqrt (T : ℝ) sqrtT ∧
    IsScalarSqrt setup.beta2 sqrtBeta2 ∧
    IsScalarQuotient (beta1 setup) sqrtBeta2 gamma ∧
    IsScalarSqrt (1 - setup.beta2) sqrtOneMinusBeta2 ∧
    IsScalarSqrt (1 + Real.log (T : ℝ)) sqrtOnePlusLogT ∧
    IsCoordSqrt (vhatSeq setup run T) terminalVhatSqrt ∧
    (∀ t ∈ Finset.Icc 1 T,
      IsCoordSqrt (vhatSeq setup run t) (adaptiveVhatSqrt t)) ∧
    (∀ i,
      IsScalarSqrt
        ((Finset.Icc 1 T).sum fun t => (gSeq setup run t i) ^ 2)
        (historyNorm i)) ∧
    gamma < 1 ∧
    IsScalarQuotient (setup.Dinf ^ 2 * sqrtT)
      (setup.alpha * (1 - beta1 setup)) firstCoeff ∧
    IsScalarQuotient (setup.Dinf ^ 2)
      (2 * (1 - beta1 setup)) secondCoeff ∧
    (∀ t ∈ Finset.Icc 1 T, ∀ i,
      IsScalarQuotient
        (setup.beta1t t * adaptiveVhatSqrt t i)
        (setup.alpha_t t) (adaptiveTerm t i)) ∧
    IsScalarQuotient
      (setup.alpha * sqrtOnePlusLogT * (∑ i, historyNorm i))
      ((1 - beta1 setup) ^ 2 * (1 - gamma) * sqrtOneMinusBeta2)
      thirdTerm ∧
    B =
      firstCoeff * (∑ i, terminalVhatSqrt i) +
        secondCoeff *
          ((Finset.Icc 1 T).sum fun t => ∑ i, adaptiveTerm t i) +
        thirdTerm

/-- Step-0 correction witness: any relational Theorem 4 RHS bound already
contains a real square-root witness for the printed factor `√(1-β₂)`.

This records formally why the old extension head, which had no RHS domain
boundary, could not be proved by tactics alone. -/
theorem theorem4Bound_exposes_oneMinusBeta2_sqrt {d : ℕ}
    (setup : Setup d) (run : Run setup) (T : ℕ) (B : ℝ)
    (hbound : IsTheorem4Bound setup run T B) :
    ∃ sqrtOneMinusBeta2,
      IsScalarSqrt (1 - setup.beta2) sqrtOneMinusBeta2 := by
  rcases hbound with
    ⟨sqrtT, sqrtBeta2, gamma, sqrtOneMinusBeta2, sqrtOnePlusLogT,
      firstCoeff, secondCoeff, thirdTerm, terminalVhatSqrt, adaptiveVhatSqrt,
      adaptiveTerm, historyNorm, hsqrtT, hsqrtBeta2, hgamma,
      hsqrtOneMinusBeta2, hsqrtOnePlusLogT, hterminal, hadaptive, hhistory,
      hgamma_lt, hfirst, hsecond, hadaptiveTerm, hthird, hB⟩
  exact ⟨sqrtOneMinusBeta2, hsqrtOneMinusBeta2⟩

/-- Retired pre-correction extension head, recorded only as a formal Step-0
falsity target.

This is the exact old shape before the RHS compatibility/domain argument was
added.  It is not a theorem-facing source statement; the theorem below proves
this unguarded extension head is false in the present object model. -/
def AMSGrad_theorem4_wellDefinedRunOnHorizon_extension_oldHead : Prop :=
  ∀ {d : ℕ} (setup : Setup d) (T : ℕ)
    (run : Run setup)
    (_hT : 1 ≤ T)
    (_h_corrected_extension_run : WellDefinedRunOnHorizon setup run T)
    (_h_grad_bound_T : BoundedGradientsOnHorizon setup T)
    (_h_alpha_schedule_T :
      ∀ t ∈ Finset.Icc 1 T, IsTheorem4StepSizeAt setup t (setup.alpha_t t))
    (_h_beta1t_le_T :
      ∀ t ∈ Finset.Icc 1 T, setup.beta1t t ≤ beta1 setup),
    ∃ B, IsTheorem4Bound setup run T B ∧
      regretAgainstInfimum setup run T ≤ B

private theorem isPositiveDefiniteMatrix_dim0 (Q : MatrixSpace 0) :
    IsPositiveDefiniteMatrix Q := by
  constructor
  · intro i
    exact Fin.elim0 i
  · intro x hx
    exact False.elim (hx (Subsingleton.elim x 0))

private theorem isWeightedProjection_univ_dim0
    (metric : MatrixSpace 0) (y x : CoordinateSpace 0) :
    IsWeightedProjection Set.univ metric y x := by
  refine ⟨isPositiveDefiniteMatrix_dim0 metric, ?_⟩
  refine ⟨by simp, ?_⟩
  rw [isMinOn_univ_iff]
  intro z
  have hz :
      (⟨x, by simp⟩ : {z : CoordinateSpace 0 // z ∈ Set.univ}) = z :=
    Subtype.ext (Subsingleton.elim _ _)
  rw [← hz]

private theorem linftyNorm_dim0 (x : CoordinateSpace 0) :
    linftyNorm x = 0 := by
  rw [linftyNorm, Pi.norm_def]
  simp

