  have hhist0_sq : historyNorm 0 ^ 2 = 1 := by
    have h := (hhistory 0).2
    simpa [gSeq, preDomainCounterexampleRun, preDomainG,
      preDomainUnit_apply_zero] using h
  have hhist0_pos : 0 < historyNorm 0 := by
    nlinarith [(hhistory 0).1, hhist0_sq]
  have hsum_hist_pos : 0 < ∑ i, historyNorm i := by
    simpa [Fin.sum_univ_one] using hhist0_pos
  have hfirst_zero : firstCoeff = 0 := by
    have hmul : (preDomainCounterexampleSetup.alpha *
        (1 - beta1 preDomainCounterexampleSetup)) * firstCoeff = 0 := by
      simpa [preDomainCounterexampleSetup, beta1] using hfirst.2
    norm_num [preDomainCounterexampleSetup, beta1] at hmul
    exact hmul
  have hsecond_zero : secondCoeff = 0 := by
    have hmul : (2 * (1 - beta1 preDomainCounterexampleSetup)) *
        secondCoeff = 0 := by
      simpa [preDomainCounterexampleSetup, beta1] using hsecond.2
    norm_num [preDomainCounterexampleSetup, beta1] at hmul
    exact hmul
  have hthird_num_neg :
      preDomainCounterexampleSetup.alpha * sqrtOnePlusLogT *
          (∑ i, historyNorm i) < 0 := by
    rw [hsqrtOnePlus_eq]
    simpa [preDomainCounterexampleSetup] using neg_neg_of_pos hsum_hist_pos
  have hthird_den_pos :
      0 <
        (1 - beta1 preDomainCounterexampleSetup) ^ 2 *
          (1 - gamma) * sqrtOneMinusBeta2 := by
    have hgamma_one : 1 - gamma = 1 := by rw [hgamma_zero]; norm_num
    rw [hgamma_one]
    norm_num [preDomainCounterexampleSetup, beta1, hsqrtOneMinus_pos]
  have hthird_neg : thirdTerm < 0 := by
