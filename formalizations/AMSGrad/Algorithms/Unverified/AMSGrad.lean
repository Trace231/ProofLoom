/-- Checked AMSGrad updates satisfy the projection contraction used at the
start of Appendix D Eq. (15).

No SOptLib match: searched `weighted projection fixed point self feasible
argmin zero norm`, `projection self of mem metric argmin minimizer`, and local
`wellDefinedProjectedUpdate`/`weightedProjection_nonexpansive` declarations.
SOptLib's Bregman/prox variational lemmas are abstract mirror-step facts; this
helper is AMSGrad-specific because it aligns the file's paper-time selectors
`x_t`, `m_t`, `vhat_t` with `WellDefinedRunOnHorizon` and the literal
`Π_{F,√Vhat_t}` projection. -/
private theorem amsgrad_projection_contraction_on_horizon {d : ℕ}
    (setup : Setup d) (run : Run setup) (T : ℕ)
    (xStar : CoordinateSpace d)
    (hwell : WellDefinedRunOnHorizon setup run T)
    (hxStar : xStar ∈ setup.F) :
    ∀ t ∈ Finset.Icc 1 T,
      ∃ sqrtVhat direction trial,
        IsCoordSqrt (vhatSeq setup run t) sqrtVhat ∧
        IsCoordQuotient (mSeq setup run t) sqrtVhat direction ∧
        IsWeightedProjectionDomain (amsgradProjectionMetricFromSqrt sqrtVhat) ∧
        trial = xSeq setup run t - setup.alpha_t t • direction ∧
        positiveDefiniteWeightedNorm
            (amsgradProjectionMetricFromSqrt sqrtVhat)
            (xSeq setup run (t + 1) - xStar) ≤
          positiveDefiniteWeightedNorm
            (amsgradProjectionMetricFromSqrt sqrtVhat)
            (trial - xStar) := by
  intro t ht
  have ht_ge_one : 1 ≤ t := (Finset.mem_Icc.mp ht).1
  have ht_succ : (t - 1) + 1 = t := Nat.sub_add_cancel ht_ge_one
  have ht_update : (t - 1) + 1 ∈ Finset.Icc 1 T := by
    simpa [ht_succ] using ht
  have hupdate_raw :=
    wellDefinedProjectedUpdate_of_wellDefinedRunOnHorizon
      setup run T (t - 1) hwell ht_update
  have hm_t :
      mSeq setup run t =
        firstMoment setup t (stateSeq setup run (t - 1)) (gSeq setup run t) := by
    simpa [ht_succ] using mSeq_succ_eq setup run (t - 1)
  have hv_t :
      vSeq setup run t =
        secondMoment setup (stateSeq setup run (t - 1)) (gSeq setup run t) := by
    simpa [ht_succ] using vSeq_succ_eq setup run (t - 1)
  have hvhat_t :
      vhatSeq setup run t =
        longTermMemory (stateSeq setup run (t - 1))
          (secondMoment setup (stateSeq setup run (t - 1))
            (gSeq setup run t)) := by
    simpa [ht_succ, hv_t] using vhatSeq_succ_eq setup run (t - 1)
  have hupdate :
      IsWellDefinedProjectedUpdate setup t (stateSeq setup run (t - 1))
        (mSeq setup run t) (vhatSeq setup run t)
        (xSeq setup run (t + 1)) := by
    simpa [ht_succ, xSeq, hm_t, hvhat_t] using hupdate_raw
  rcases hupdate with ⟨sqrtVhat, direction, trial, hsqrt, hquot, htrial, hproj⟩
  refine ⟨sqrtVhat, direction, trial, hsqrt, hquot, hproj.1, htrial, ?_⟩
  have hself :
      IsWeightedProjection setup.F (amsgradProjectionMetricFromSqrt sqrtVhat)
        xStar xStar :=
    weighted_projection_self_of_mem setup.F
      (amsgradProjectionMetricFromSqrt sqrtVhat) xStar hproj.1 hxStar
  exact weightedProjection_nonexpansive setup.F
    (amsgradProjectionMetricFromSqrt sqrtVhat)
    trial xStar (xSeq setup run (t + 1)) xStar
    setup.hF_convex hproj.1 hproj hself

/-- Squared form of the checked projection contraction, matching the
quadratic inequality expanded in Appendix D Eq. (15).

This does not introduce a new paper primitive: it specializes the proved local
`amsgrad_projection_contraction_on_horizon` bridge and squares both sides using
`positiveDefiniteWeightedNorm_sq`.  The SOptLib/Mathlib search for
`nonnegative norm inequality square both sides matrix quadratic form` found
only unrelated norm-square and variance facts, so the AMSGrad matrix-norm
transport is kept local. -/
private theorem amsgrad_projection_quadratic_contraction_on_horizon {d : ℕ}
    (setup : Setup d) (run : Run setup) (T : ℕ)
    (xStar : CoordinateSpace d)
    (hwell : WellDefinedRunOnHorizon setup run T)
    (hxStar : xStar ∈ setup.F) :
    ∀ t ∈ Finset.Icc 1 T,
      ∃ sqrtVhat direction trial,
        IsCoordSqrt (vhatSeq setup run t) sqrtVhat ∧
        IsCoordQuotient (mSeq setup run t) sqrtVhat direction ∧
        IsWeightedProjectionDomain (amsgradProjectionMetricFromSqrt sqrtVhat) ∧
        trial = xSeq setup run t - setup.alpha_t t • direction ∧
        matrixQuadraticForm
            (amsgradProjectionMetricFromSqrt sqrtVhat)
            (xSeq setup run (t + 1) - xStar) ≤
          matrixQuadraticForm
            (amsgradProjectionMetricFromSqrt sqrtVhat)
            (trial - xStar) := by
  intro t ht
  rcases amsgrad_projection_contraction_on_horizon
      setup run T xStar hwell hxStar t ht with
    ⟨sqrtVhat, direction, trial, hsqrt, hquot, hmetric, htrial, hnorm⟩
  refine ⟨sqrtVhat, direction, trial, hsqrt, hquot, hmetric, htrial, ?_⟩
  let metric := amsgradProjectionMetricFromSqrt sqrtVhat
  let lhsNorm := positiveDefiniteWeightedNorm metric
      (xSeq setup run (t + 1) - xStar)
  let rhsNorm := positiveDefiniteWeightedNorm metric (trial - xStar)
  have hlhs_nonneg : 0 ≤ lhsNorm := by
    simp [lhsNorm, positiveDefiniteWeightedNorm]
  have hrhs_nonneg : 0 ≤ rhsNorm := by
    simp [rhsNorm, positiveDefiniteWeightedNorm]
  have hsquare : lhsNorm ^ 2 ≤ rhsNorm ^ 2 := by
    exact sq_le_sq.2 (by
      simpa [lhsNorm, rhsNorm, abs_of_nonneg hlhs_nonneg,
        abs_of_nonneg hrhs_nonneg] using hnorm)
  calc
    matrixQuadraticForm metric (xSeq setup run (t + 1) - xStar)
        = lhsNorm ^ 2 := by
          exact (positiveDefiniteWeightedNorm_sq metric hmetric
            (xSeq setup run (t + 1) - xStar)).symm
    _ ≤ rhsNorm ^ 2 := hsquare
    _ = matrixQuadraticForm metric (trial - xStar) := by
          exact positiveDefiniteWeightedNorm_sq metric hmetric (trial - xStar)

