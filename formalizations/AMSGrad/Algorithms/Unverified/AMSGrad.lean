/-- Horizon-local generated first-moment recurrence in paper time. -/
private theorem generatedMSeq_eq_on_horizon {d : ℕ}
    (setup : Setup d) (T t : ℕ)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (ht : t ∈ Finset.Icc 1 T) :
    generatedMSeq setup t =
      firstMoment setup t (wellDefinedAlgorithm2GeneratedState setup (t - 1))
        (wellDefinedAlgorithm2GeneratedGradient setup t) := by
  have ht_pos : 1 ≤ t := (Finset.mem_Icc.mp ht).1
  have ht_succ : t - 1 + 1 = t := Nat.sub_add_cancel ht_pos
  have hnmem : t - 1 + 1 ∈ Finset.Icc 1 T := by
    simpa [ht_succ] using ht
  have hstep :=
    wellDefinedAlgorithm2GeneratedState_succ_spec_on_horizon setup T (t - 1)
      hsolv hnmem
  unfold IsWellDefinedNextState at hstep
  dsimp at hstep
  rcases hstep with ⟨_hgrad, hm, _hv, _hvhat, _hupdate⟩
  simpa [generatedMSeq, ht_succ] using hm

