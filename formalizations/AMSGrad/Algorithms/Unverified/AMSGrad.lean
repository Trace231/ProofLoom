  have hsqrtOnePlus_eq : sqrtOnePlusLogT = 1 := by
    have hlog1 : Real.log (1 : ℝ) = 0 := Real.log_one
    have hsq : sqrtOnePlusLogT ^ 2 = (1 : ℝ) := by
      simpa [hlog1] using hsqrtOnePlusLogT.2
