/-- Inner-product form of the generated first-moment recurrence on a theorem
horizon. -/
private theorem generatedMSeq_inner_eq_on_horizon {d : ℕ}
    (setup : Setup d) (T : ℕ)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T) :
    ∀ t ∈ Finset.Icc 1 T, ∀ y : CoordinateSpace d,
      inner ℝ (generatedMSeq setup t) y =
        setup.beta1t t * inner ℝ (generatedMSeq setup (t - 1)) y +
          (1 - setup.beta1t t) *
            inner ℝ (wellDefinedAlgorithm2GeneratedGradient setup t) y := by
  intro t ht y
  have hm_t := generatedMSeq_eq_on_horizon setup T t hsolv ht
  calc
    inner ℝ (generatedMSeq setup t) y
        = inner ℝ
            (firstMoment setup t
              (wellDefinedAlgorithm2GeneratedState setup (t - 1))
              (wellDefinedAlgorithm2GeneratedGradient setup t)) y := by
          rw [hm_t]
    _ = setup.beta1t t *
          inner ℝ (generatedMSeq setup (t - 1)) y +
        (1 - setup.beta1t t) *
          inner ℝ (wellDefinedAlgorithm2GeneratedGradient setup t) y := by
          simpa [generatedMSeq] using
            firstMoment_inner_eq setup t
              (wellDefinedAlgorithm2GeneratedState setup (t - 1))
              (wellDefinedAlgorithm2GeneratedGradient setup t) y

/-- Coordinate form of the generated second-moment recurrence. -/
private theorem generatedVSeq_coord_eq_on_horizon {d : ℕ}
    (setup : Setup d) (T : ℕ)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T) :
    ∀ t ∈ Finset.Icc 1 T, ∀ i : Fin d,
      generatedVSeq setup t i =
        setup.beta2 * generatedVSeq setup (t - 1) i +
          (1 - setup.beta2) *
            (wellDefinedAlgorithm2GeneratedGradient setup t i) ^ 2 := by
  intro t ht i
  have hv_t := generatedVSeq_eq_on_horizon setup T t hsolv ht
  calc
    generatedVSeq setup t i
        = secondMoment setup
            (wellDefinedAlgorithm2GeneratedState setup (t - 1))
            (wellDefinedAlgorithm2GeneratedGradient setup t) i := by
          rw [hv_t]
    _ = setup.beta2 * generatedVSeq setup (t - 1) i +
          (1 - setup.beta2) *
            (wellDefinedAlgorithm2GeneratedGradient setup t i) ^ 2 := by
          simp [secondMoment, coordSquare, generatedVSeq]

/-- Generated long-term memory dominates the current generated second moment
at each coordinate. -/
private theorem generatedVSeq_le_generatedVhatSeq_on_horizon {d : ℕ}
    (setup : Setup d) (T : ℕ)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T) :
    ∀ t ∈ Finset.Icc 1 T, ∀ i : Fin d,
      generatedVSeq setup t i ≤ generatedVhatSeq setup t i := by
  intro t ht i
  have hvhat_t := generatedVhatSeq_eq_on_horizon setup T t hsolv ht
  calc
    generatedVSeq setup t i
        ≤ (longTermMemory (wellDefinedAlgorithm2GeneratedState setup (t - 1))
            (generatedVSeq setup t)) i := by
          simp [longTermMemory, coordMax]
    _ = generatedVhatSeq setup t i := by
          exact congrArg (fun z : CoordinateSpace d => z i) hvhat_t.symm

/-- Generated coordinate numerator unroll used in Appendix D Eq. (17). -/
private theorem generated_mSeq_coord_abs_le_geometric_history {d : ℕ}
    (setup : Setup d) (T : ℕ)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (hdom : Theorem4ParameterDomainOnHorizon setup T)
    (hbeta_le : ∀ t ∈ Finset.Icc 1 T, setup.beta1t t ≤ beta1 setup)
    (hbeta_den : beta1 setup < 1 ∧
      ∀ t ∈ Finset.Icc 1 T, 0 < 1 - setup.beta1t t) :
    ∀ t ∈ Finset.Icc 1 T, ∀ i : Fin d,
      |generatedMSeq setup t i| ≤
        ∑ j ∈ Finset.Icc 1 t,
          (beta1 setup) ^ (t - j) *
            |wellDefinedAlgorithm2GeneratedGradient setup j i| := by
  intro t ht i
  induction t with
  | zero =>
      simp at ht
  | succ n ih =>
      cases n with
      | zero =>
          have ht1 : 1 ∈ Finset.Icc 1 T := by simpa using ht
          have hrec :
              generatedMSeq setup 1 i =
                (1 - setup.beta1t 1) *
                  wellDefinedAlgorithm2GeneratedGradient setup 1 i := by
            have hvec :=
              generatedMSeq_eq_on_horizon setup T 1 hsolv ht1
            have hcoord := congrArg (fun x : CoordinateSpace d => x i) hvec
            simpa [firstMoment, generatedMSeq,
              wellDefinedAlgorithm2GeneratedState_zero, initialState] using hcoord
          have hb_nonneg : 0 ≤ beta1 setup := by
            simpa [beta1] using
              theorem4ParameterDomain_beta1t_nonneg setup T 1 hdom ht1
          have hone_nonneg : 0 ≤ 1 - beta1 setup := by
            nlinarith [hbeta_den.1]
          have hone_le : 1 - beta1 setup ≤ 1 := by
            nlinarith [hb_nonneg]
          calc
            |generatedMSeq setup 1 i|
                = (1 - beta1 setup) *
                    |wellDefinedAlgorithm2GeneratedGradient setup 1 i| := by
                  have hcoeff :
                      1 - setup.beta1t 1 = 1 - beta1 setup := by
                    simp [beta1]
                  calc
                    |generatedMSeq setup 1 i|
                        = |(1 - setup.beta1t 1) *
                            wellDefinedAlgorithm2GeneratedGradient setup 1 i| := by
                          rw [hrec]
                    _ = |1 - beta1 setup| *
                          |wellDefinedAlgorithm2GeneratedGradient setup 1 i| := by
                          rw [hcoeff, abs_mul]
                    _ = (1 - beta1 setup) *
                          |wellDefinedAlgorithm2GeneratedGradient setup 1 i| := by
                          rw [abs_of_nonneg hone_nonneg]
            _ ≤ 1 * |wellDefinedAlgorithm2GeneratedGradient setup 1 i| := by
                  exact mul_le_mul_of_nonneg_right hone_le (abs_nonneg _)
            _ = ∑ j ∈ Finset.Icc 1 1,
                  (beta1 setup) ^ (1 - j) *
                    |wellDefinedAlgorithm2GeneratedGradient setup j i| := by
                  simp
      | succ n =>
          have htcur : n + 2 ∈ Finset.Icc 1 T := by simpa using ht
          have htprev : n + 1 ∈ Finset.Icc 1 T := by
            have htb := Finset.mem_Icc.mp htcur
            exact Finset.mem_Icc.mpr ⟨by omega, by omega⟩
          have hrec :
              generatedMSeq setup (n + 2) i =
                setup.beta1t (n + 2) * generatedMSeq setup (n + 1) i +
                  (1 - setup.beta1t (n + 2)) *
                    wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i := by
            have hvec :=
              generatedMSeq_eq_on_horizon setup T (n + 2) hsolv htcur
            have hcoord := congrArg (fun x : CoordinateSpace d => x i) hvec
            simpa [firstMoment] using hcoord
          have hb_t_nonneg : 0 ≤ setup.beta1t (n + 2) :=
            theorem4ParameterDomain_beta1t_nonneg setup T (n + 2) hdom htcur
          have hb_global_nonneg : 0 ≤ beta1 setup := by
            have hmem1 : 1 ∈ Finset.Icc 1 T := by
              have htb := Finset.mem_Icc.mp htcur
              exact Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
            simpa [beta1] using
              theorem4ParameterDomain_beta1t_nonneg setup T 1 hdom hmem1
          have hone_t_nonneg : 0 ≤ 1 - setup.beta1t (n + 2) :=
            le_of_lt (hbeta_den.2 (n + 2) htcur)
          have hone_t_le_one : 1 - setup.beta1t (n + 2) ≤ 1 := by
            nlinarith [hb_t_nonneg]
          have hprev := ih htprev
          have hsum_shift :
              setup.beta1t (n + 2) *
                  (∑ j ∈ Finset.Icc 1 (n + 1),
                    (beta1 setup) ^ (n + 1 - j) *
                      |wellDefinedAlgorithm2GeneratedGradient setup j i|) ≤
                ∑ j ∈ Finset.Icc 1 (n + 1),
                    (beta1 setup) ^ (n + 2 - j) *
                      |wellDefinedAlgorithm2GeneratedGradient setup j i| := by
            calc
              setup.beta1t (n + 2) *
                  (∑ j ∈ Finset.Icc 1 (n + 1),
                    (beta1 setup) ^ (n + 1 - j) *
                      |wellDefinedAlgorithm2GeneratedGradient setup j i|)
                  = ∑ j ∈ Finset.Icc 1 (n + 1),
                      setup.beta1t (n + 2) *
                        ((beta1 setup) ^ (n + 1 - j) *
                          |wellDefinedAlgorithm2GeneratedGradient setup j i|) := by
                    rw [Finset.mul_sum]
              _ ≤ ∑ j ∈ Finset.Icc 1 (n + 1),
                    (beta1 setup) ^ (n + 2 - j) *
                      |wellDefinedAlgorithm2GeneratedGradient setup j i| := by
                    refine Finset.sum_le_sum ?_
                    intro j hj
                    have hjb := Finset.mem_Icc.mp hj
                    have hpow_shift : n + 2 - j = (n + 1 - j) + 1 := by
                      omega
                    have hterm_nonneg :
                        0 ≤ (beta1 setup) ^ (n + 1 - j) *
                          |wellDefinedAlgorithm2GeneratedGradient setup j i| := by
                      exact mul_nonneg
                        (pow_nonneg hb_global_nonneg (n + 1 - j))
                        (abs_nonneg _)
                    calc
                      setup.beta1t (n + 2) *
                          ((beta1 setup) ^ (n + 1 - j) *
                            |wellDefinedAlgorithm2GeneratedGradient setup j i|)
                          ≤ beta1 setup *
                              ((beta1 setup) ^ (n + 1 - j) *
                                |wellDefinedAlgorithm2GeneratedGradient setup j i|) := by
                            exact mul_le_mul_of_nonneg_right
                              (hbeta_le (n + 2) htcur) hterm_nonneg
                      _ = (beta1 setup) ^ (n + 2 - j) *
                            |wellDefinedAlgorithm2GeneratedGradient setup j i| := by
                            rw [hpow_shift, pow_succ]
                            ring
          have htop_le :
              (1 - setup.beta1t (n + 2)) *
                  |wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i| ≤
                |wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i| := by
            calc
              (1 - setup.beta1t (n + 2)) *
                  |wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i|
                  ≤ 1 *
                      |wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i| := by
                    exact mul_le_mul_of_nonneg_right hone_t_le_one
                      (abs_nonneg _)
              _ = |wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i| := by
                    ring
          calc
            |generatedMSeq setup (n + 2) i|
                ≤ setup.beta1t (n + 2) *
                    |generatedMSeq setup (n + 1) i| +
                    (1 - setup.beta1t (n + 2)) *
                      |wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i| := by
                  rw [hrec]
                  calc
                    |setup.beta1t (n + 2) * generatedMSeq setup (n + 1) i +
                        (1 - setup.beta1t (n + 2)) *
                          wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i|
                        ≤ |setup.beta1t (n + 2) *
                            generatedMSeq setup (n + 1) i| +
                          |(1 - setup.beta1t (n + 2)) *
                            wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i| :=
                          abs_add_le _ _
                    _ = setup.beta1t (n + 2) *
                          |generatedMSeq setup (n + 1) i| +
                        (1 - setup.beta1t (n + 2)) *
                          |wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i| := by
                          rw [abs_mul, abs_mul,
                            abs_of_nonneg hb_t_nonneg,
                            abs_of_nonneg hone_t_nonneg]
            _ ≤ setup.beta1t (n + 2) *
                  (∑ j ∈ Finset.Icc 1 (n + 1),
                    (beta1 setup) ^ (n + 1 - j) *
                      |wellDefinedAlgorithm2GeneratedGradient setup j i|) +
                (1 - setup.beta1t (n + 2)) *
                  |wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i| := by
                  simpa [add_comm, add_left_comm, add_assoc] using
                    add_le_add_right
                      (mul_le_mul_of_nonneg_left hprev hb_t_nonneg)
                      ((1 - setup.beta1t (n + 2)) *
                        |wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i|)
            _ ≤ ∑ j ∈ Finset.Icc 1 (n + 1),
                    (beta1 setup) ^ (n + 2 - j) *
                      |wellDefinedAlgorithm2GeneratedGradient setup j i| +
                |wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i| := by
                  exact add_le_add hsum_shift htop_le
            _ = ∑ j ∈ Finset.Icc 1 (n + 2),
                    (beta1 setup) ^ (n + 2 - j) *
                      |wellDefinedAlgorithm2GeneratedGradient setup j i| := by
                  rw [Finset.sum_Icc_succ_top (by omega : 1 ≤ n + 2)]
                  simp

/-- Nonnegativity of generated second-moment coordinates on a finite horizon. -/
private theorem generatedVSeq_coord_nonneg_on_horizon {d : ℕ}
    (setup : Setup d) (T : ℕ)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (hbeta2_nonneg : 0 ≤ setup.beta2)
    (honeMinusBeta2_nonneg : 0 ≤ 1 - setup.beta2) :
    ∀ t, t ≤ T → ∀ i : Fin d, 0 ≤ generatedVSeq setup t i := by
  intro t
  induction t with
  | zero =>
      intro _ht i
      simp [generatedVSeq, wellDefinedAlgorithm2GeneratedState_zero,
        initialState]
  | succ n ih =>
      intro hle i
      have ht_mem : n + 1 ∈ Finset.Icc 1 T :=
        Finset.mem_Icc.mpr ⟨Nat.succ_pos n, hle⟩
      have hrec := generatedVSeq_coord_eq_on_horizon setup T hsolv
        (n + 1) ht_mem i
      have hprev_nonneg : 0 ≤ generatedVSeq setup n i := ih (by omega) i
      have hbeta_part : 0 ≤ setup.beta2 * generatedVSeq setup n i :=
        mul_nonneg hbeta2_nonneg hprev_nonneg
      have hgrad_part :
          0 ≤ (1 - setup.beta2) *
            (wellDefinedAlgorithm2GeneratedGradient setup (n + 1) i) ^ 2 :=
        mul_nonneg honeMinusBeta2_nonneg (sq_nonneg _)
      rw [hrec]
      exact add_nonneg hbeta_part hgrad_part

/-- A single generated gradient-history square is retained in the generated
second-moment sequence with its geometric `β₂` weight. -/
private theorem generatedVSeq_coord_lower_single_history_term {d : ℕ}
    (setup : Setup d) (T : ℕ)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (hbeta2_nonneg : 0 ≤ setup.beta2)
    (honeMinusBeta2_nonneg : 0 ≤ 1 - setup.beta2) :
    ∀ t ∈ Finset.Icc 1 T, ∀ j ∈ Finset.Icc 1 t, ∀ i : Fin d,
      (1 - setup.beta2) * setup.beta2 ^ (t - j) *
          (wellDefinedAlgorithm2GeneratedGradient setup j i) ^ 2 ≤
        generatedVSeq setup t i := by
  intro t ht
  induction t with
  | zero =>
      simp at ht
  | succ n ih =>
      intro j hj i
      cases n with
      | zero =>
          have hj_eq : j = 1 := by
            have hj_bounds := Finset.mem_Icc.mp hj
            omega
          subst j
          have hrec := generatedVSeq_coord_eq_on_horizon setup T hsolv 1 ht i
          have hv0 : generatedVSeq setup 0 i = 0 := by
            simp [generatedVSeq, wellDefinedAlgorithm2GeneratedState_zero,
              initialState]
          rw [hrec, hv0]
          ring_nf
          exact le_rfl
      | succ n =>
          have hprev_mem : n + 1 ∈ Finset.Icc 1 T := by
            have ht_bounds := Finset.mem_Icc.mp ht
            exact Finset.mem_Icc.mpr ⟨by omega, by omega⟩
          have hrec :=
            generatedVSeq_coord_eq_on_horizon setup T hsolv
              (n + 2) (by simpa using ht) i
          have hrec' :
              generatedVSeq setup (n + 2) i =
                setup.beta2 * generatedVSeq setup (n + 1) i +
                  (1 - setup.beta2) *
                    (wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i) ^ 2 := by
            simpa using hrec
          by_cases hj_top : j = n + 2
          · subst j
            have hprev_nonneg :
                0 ≤ setup.beta2 * generatedVSeq setup (n + 1) i := by
              exact mul_nonneg hbeta2_nonneg
                (generatedVSeq_coord_nonneg_on_horizon setup T hsolv
                  hbeta2_nonneg honeMinusBeta2_nonneg (n + 1)
                  (Finset.mem_Icc.mp hprev_mem).2 i)
            rw [hrec']
            have hpow : setup.beta2 ^ (n + 2 - (n + 2)) = 1 := by
              norm_num
            rw [hpow]
            nlinarith [hprev_nonneg]
          · have hj_prev : j ∈ Finset.Icc 1 (n + 1) := by
              have hj_bounds := Finset.mem_Icc.mp hj
              exact Finset.mem_Icc.mpr ⟨hj_bounds.1, by omega⟩
            have hih := ih hprev_mem j hj_prev i
            have hshift :
                n + 2 - j = (n + 1 - j) + 1 := by
              have hj_bounds := Finset.mem_Icc.mp hj
              omega
            have hterm_shift :
                (1 - setup.beta2) * setup.beta2 ^ (n + 2 - j) *
                    (wellDefinedAlgorithm2GeneratedGradient setup j i) ^ 2 =
                  setup.beta2 *
                    ((1 - setup.beta2) * setup.beta2 ^ (n + 1 - j) *
                      (wellDefinedAlgorithm2GeneratedGradient setup j i) ^ 2) := by
              rw [hshift, pow_succ]
              ring
            have hscaled :
                setup.beta2 *
                    ((1 - setup.beta2) * setup.beta2 ^ (n + 1 - j) *
                      (wellDefinedAlgorithm2GeneratedGradient setup j i) ^ 2) ≤
                  setup.beta2 * generatedVSeq setup (n + 1) i :=
              mul_le_mul_of_nonneg_left hih hbeta2_nonneg
            have hgrad_nonneg :
                0 ≤ (1 - setup.beta2) *
                  (wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i) ^ 2 :=
              mul_nonneg honeMinusBeta2_nonneg (sq_nonneg _)
            calc
              (1 - setup.beta2) * setup.beta2 ^ (n + 2 - j) *
                  (wellDefinedAlgorithm2GeneratedGradient setup j i) ^ 2
                  = setup.beta2 *
                      ((1 - setup.beta2) * setup.beta2 ^ (n + 1 - j) *
                        (wellDefinedAlgorithm2GeneratedGradient setup j i) ^ 2) :=
                    hterm_shift
              _ ≤ setup.beta2 * generatedVSeq setup (n + 1) i := hscaled
              _ ≤ setup.beta2 * generatedVSeq setup (n + 1) i +
                    (1 - setup.beta2) *
                      (wellDefinedAlgorithm2GeneratedGradient setup (n + 2) i) ^ 2 := by
                    exact le_add_of_nonneg_right hgrad_nonneg
              _ = generatedVSeq setup (n + 2) i := by
                    rw [hrec']

/-- Generated checked AMSGrad updates satisfy the projection contraction used
at the start of Appendix D Eq. (15). -/
private theorem generated_projection_contraction_on_horizon {d : ℕ}
    (setup : Setup d) (T : ℕ) (xStar : CoordinateSpace d)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (hxStar : xStar ∈ setup.F) :
    ∀ t ∈ Finset.Icc 1 T,
      ∃ sqrtVhat direction trial,
        IsCoordSqrt (generatedVhatSeq setup t) sqrtVhat ∧
        IsCoordQuotient (generatedMSeq setup t) sqrtVhat direction ∧
        IsWeightedProjectionDomain (amsgradProjectionMetricFromSqrt sqrtVhat) ∧
        trial = generatedXSeq setup t - setup.alpha_t t • direction ∧
        positiveDefiniteWeightedNorm
            (amsgradProjectionMetricFromSqrt sqrtVhat)
            (generatedXSeq setup (t + 1) - xStar) ≤
          positiveDefiniteWeightedNorm
            (amsgradProjectionMetricFromSqrt sqrtVhat)
            (trial - xStar) := by
  intro t ht
  rcases generated_projected_update_on_horizon setup T t hsolv ht with
    ⟨sqrtVhat, direction, trial, hsqrt, hquot, htrial, hproj⟩
  refine ⟨sqrtVhat, direction, trial, hsqrt, hquot, hproj.1, ?_, ?_⟩
  · simpa [generatedXSeq] using htrial
  · have hself :
        IsWeightedProjection setup.F (amsgradProjectionMetricFromSqrt sqrtVhat)
          xStar xStar :=
      weighted_projection_self_of_mem setup.F
        (amsgradProjectionMetricFromSqrt sqrtVhat) xStar hproj.1 hxStar
    exact weightedProjection_nonexpansive setup.F
      (amsgradProjectionMetricFromSqrt sqrtVhat)
      trial xStar (generatedXSeq setup (t + 1)) xStar
      setup.hF_convex hproj.1 hproj hself

/-- Squared generated projection contraction. -/
private theorem generated_projection_quadratic_contraction_on_horizon {d : ℕ}
    (setup : Setup d) (T : ℕ) (xStar : CoordinateSpace d)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (hxStar : xStar ∈ setup.F) :
    ∀ t ∈ Finset.Icc 1 T,
      ∃ sqrtVhat direction trial,
        IsCoordSqrt (generatedVhatSeq setup t) sqrtVhat ∧
        IsCoordQuotient (generatedMSeq setup t) sqrtVhat direction ∧
        IsWeightedProjectionDomain (amsgradProjectionMetricFromSqrt sqrtVhat) ∧
        trial = generatedXSeq setup t - setup.alpha_t t • direction ∧
        matrixQuadraticForm
            (amsgradProjectionMetricFromSqrt sqrtVhat)
            (generatedXSeq setup (t + 1) - xStar) ≤
          matrixQuadraticForm
            (amsgradProjectionMetricFromSqrt sqrtVhat)
            (trial - xStar) := by
  intro t ht
  rcases generated_projection_contraction_on_horizon
      setup T xStar hsolv hxStar t ht with
    ⟨sqrtVhat, direction, trial, hsqrt, hquot, hmetric, htrial, hnorm⟩
  refine ⟨sqrtVhat, direction, trial, hsqrt, hquot, hmetric, htrial, ?_⟩
  let metric := amsgradProjectionMetricFromSqrt sqrtVhat
  let lhsNorm := positiveDefiniteWeightedNorm metric
      (generatedXSeq setup (t + 1) - xStar)
  let rhsNorm := positiveDefiniteWeightedNorm metric (trial - xStar)
  have hlhs_nonneg : 0 ≤ lhsNorm := by
    simp [lhsNorm, positiveDefiniteWeightedNorm]
  have hrhs_nonneg : 0 ≤ rhsNorm := by
    simp [rhsNorm, positiveDefiniteWeightedNorm]
  have hsquare : lhsNorm ^ 2 ≤ rhsNorm ^ 2 := by
    exact sq_le_sq.2 (by
      simpa [lhsNorm, rhsNorm, abs_of_nonneg hlhs_nonneg,
        abs_of_nonneg hrhs_nonneg] using hnorm)
  calc
    matrixQuadraticForm metric (generatedXSeq setup (t + 1) - xStar)
        = lhsNorm ^ 2 := by
          exact (positiveDefiniteWeightedNorm_sq metric hmetric
            (generatedXSeq setup (t + 1) - xStar)).symm
    _ ≤ rhsNorm ^ 2 := hsquare
    _ = matrixQuadraticForm metric (trial - xStar) := by
          exact positiveDefiniteWeightedNorm_sq metric hmetric (trial - xStar)

/-- Coordinate-sum form of the generated checked projection contraction. -/
private theorem generated_projection_coordinate_contraction_on_horizon {d : ℕ}
    (setup : Setup d) (T : ℕ) (xStar : CoordinateSpace d)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (hxStar : xStar ∈ setup.F) :
    ∀ t ∈ Finset.Icc 1 T,
      ∃ sqrtVhat direction trial,
        IsCoordSqrt (generatedVhatSeq setup t) sqrtVhat ∧
        IsCoordQuotient (generatedMSeq setup t) sqrtVhat direction ∧
        trial = generatedXSeq setup t - setup.alpha_t t • direction ∧
        (∑ i, sqrtVhat i *
            ((generatedXSeq setup (t + 1) - xStar) i) ^ 2) ≤
          ∑ i, sqrtVhat i * ((trial - xStar) i) ^ 2 := by
  intro t ht
  rcases generated_projection_quadratic_contraction_on_horizon
      setup T xStar hsolv hxStar t ht with
    ⟨sqrtVhat, direction, trial, hsqrt, hquot, _hmetric, htrial, hquad⟩
  refine ⟨sqrtVhat, direction, trial, hsqrt, hquot, htrial, ?_⟩
  simpa [amsgradProjectionMetricFromSqrt, matrixQuadraticForm_diagonal] using hquad

/-- Trial-square expansion for the generated checked projection update. -/
private theorem generated_projection_trial_square_expansion_on_horizon {d : ℕ}
    (setup : Setup d) (T : ℕ) (xStar : CoordinateSpace d)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (hxStar : xStar ∈ setup.F) :
    ∀ t ∈ Finset.Icc 1 T,
      ∃ sqrtVhat direction,
        IsCoordSqrt (generatedVhatSeq setup t) sqrtVhat ∧
        IsCoordQuotient (generatedMSeq setup t) sqrtVhat direction ∧
        (∑ i, sqrtVhat i *
            ((generatedXSeq setup (t + 1) - xStar) i) ^ 2) ≤
          (∑ i, sqrtVhat i *
              ((generatedXSeq setup t - xStar) i) ^ 2) -
            2 * setup.alpha_t t *
              (∑ i, (generatedMSeq setup t i) *
                ((generatedXSeq setup t - xStar) i)) +
            (setup.alpha_t t) ^ 2 *
              (∑ i, sqrtVhat i * (direction i) ^ 2) := by
  intro t ht
  rcases generated_projection_coordinate_contraction_on_horizon
      setup T xStar hsolv hxStar t ht with
    ⟨sqrtVhat, direction, trial, hsqrt, hquot, htrial, hcoord⟩
  refine ⟨sqrtVhat, direction, hsqrt, hquot, ?_⟩
  have htrial_sum :
      (∑ i, sqrtVhat i * ((trial - xStar) i) ^ 2) =
        (∑ i, sqrtVhat i * ((generatedXSeq setup t - xStar) i) ^ 2) -
          2 * setup.alpha_t t *
            (∑ i, (generatedMSeq setup t i) *
              ((generatedXSeq setup t - xStar) i)) +
          (setup.alpha_t t) ^ 2 *
            (∑ i, sqrtVhat i * (direction i) ^ 2) := by
    calc
      (∑ i, sqrtVhat i * ((trial - xStar) i) ^ 2)
          = ∑ i,
              (sqrtVhat i * ((generatedXSeq setup t - xStar) i) ^ 2 -
                2 * setup.alpha_t t *
                  ((generatedMSeq setup t i) *
                    ((generatedXSeq setup t - xStar) i)) +
                (setup.alpha_t t) ^ 2 *
                  (sqrtVhat i * (direction i) ^ 2)) := by
            refine Finset.sum_congr rfl ?_
            intro i _hi
            have hq : sqrtVhat i * direction i = generatedMSeq setup t i :=
              (hquot i).2
            have hcoord_trial :
                (trial - xStar) i =
                  (generatedXSeq setup t - xStar) i -
                    setup.alpha_t t * direction i := by
              rw [htrial]
              simp [sub_eq_add_neg, add_assoc, add_comm, add_left_comm]
            rw [hcoord_trial, ← hq]
            ring
      _ = (∑ i, sqrtVhat i * ((generatedXSeq setup t - xStar) i) ^ 2) -
            2 * setup.alpha_t t *
              (∑ i, (generatedMSeq setup t i) *
                ((generatedXSeq setup t - xStar) i)) +
            (setup.alpha_t t) ^ 2 *
              (∑ i, sqrtVhat i * (direction i) ^ 2) := by
            simp [Finset.sum_add_distrib, Finset.sum_sub_distrib,
              Finset.mul_sum, mul_assoc, mul_left_comm, mul_comm]
  exact le_trans hcoord (le_of_eq htrial_sum)

/-- Trial-square expansion in generated ambient inner-product notation. -/
private theorem generated_projection_trial_square_expansion_inner_on_horizon
    {d : ℕ} (setup : Setup d) (T : ℕ) (xStar : CoordinateSpace d)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (hxStar : xStar ∈ setup.F) :
    ∀ t ∈ Finset.Icc 1 T,
      ∃ sqrtVhat direction,
        IsCoordSqrt (generatedVhatSeq setup t) sqrtVhat ∧
        IsCoordQuotient (generatedMSeq setup t) sqrtVhat direction ∧
        (∑ i, sqrtVhat i *
            ((generatedXSeq setup (t + 1) - xStar) i) ^ 2) ≤
          (∑ i, sqrtVhat i *
              ((generatedXSeq setup t - xStar) i) ^ 2) -
            2 * setup.alpha_t t *
              inner ℝ (generatedMSeq setup t) (generatedXSeq setup t - xStar) +
            (setup.alpha_t t) ^ 2 *
              (∑ i, sqrtVhat i * (direction i) ^ 2) := by
  intro t ht
  rcases generated_projection_trial_square_expansion_on_horizon
      setup T xStar hsolv hxStar t ht with
    ⟨sqrtVhat, direction, hsqrt, hquot, hle⟩
  refine ⟨sqrtVhat, direction, hsqrt, hquot, ?_⟩
  simpa [coordinate_inner_eq_sum] using hle

/-- Generated pointwise projection/momentum inequality before Young
absorption. -/
private theorem generated_projection_pre_young_bound_on_horizon {d : ℕ}
    (setup : Setup d) (T : ℕ) (xStar : CoordinateSpace d)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (hxStar : xStar ∈ setup.F)
    (hdom : Theorem4ParameterDomainOnHorizon setup T)
    (hbeta_den : beta1 setup < 1 ∧
      ∀ t ∈ Finset.Icc 1 T, 0 < 1 - setup.beta1t t) :
    ∀ t ∈ Finset.Icc 1 T,
      ∃ sqrtVhat direction,
        IsCoordSqrt (generatedVhatSeq setup t) sqrtVhat ∧
        IsCoordQuotient (generatedMSeq setup t) sqrtVhat direction ∧
        inner ℝ (wellDefinedAlgorithm2GeneratedGradient setup t)
            (generatedXSeq setup t - xStar) ≤
          ((∑ i, sqrtVhat i *
                ((generatedXSeq setup t - xStar) i) ^ 2) -
              (∑ i, sqrtVhat i *
                ((generatedXSeq setup (t + 1) - xStar) i) ^ 2)) /
              (2 * setup.alpha_t t * (1 - setup.beta1t t)) +
            (setup.alpha_t t *
                (∑ i, sqrtVhat i * (direction i) ^ 2)) /
              (2 * (1 - setup.beta1t t)) -
            (setup.beta1t t / (1 - setup.beta1t t)) *
              inner ℝ (generatedMSeq setup (t - 1))
                (generatedXSeq setup t - xStar) := by
  intro t ht
  rcases generated_projection_trial_square_expansion_inner_on_horizon
      setup T xStar hsolv hxStar t ht with
    ⟨sqrtVhat, direction, hsqrt, hquot, hproj_expansion⟩
  refine ⟨sqrtVhat, direction, hsqrt, hquot, ?_⟩
  let y : CoordinateSpace d := generatedXSeq setup t - xStar
  let beta : ℝ := setup.beta1t t
  let alpha : ℝ := setup.alpha_t t
  let A : ℝ := ∑ i, sqrtVhat i * ((generatedXSeq setup t - xStar) i) ^ 2
  let N : ℝ :=
    ∑ i, sqrtVhat i * ((generatedXSeq setup (t + 1) - xStar) i) ^ 2
  let C : ℝ := ∑ i, sqrtVhat i * (direction i) ^ 2
  let M : ℝ := inner ℝ (generatedMSeq setup t) y
  let P : ℝ := inner ℝ (generatedMSeq setup (t - 1)) y
  let G : ℝ := inner ℝ (wellDefinedAlgorithm2GeneratedGradient setup t) y
  have halpha : 0 < alpha := by
    exact theorem4ParameterDomain_alpha_t_pos setup T t hdom ht
  have hden : 0 < 1 - beta := by
    exact hbeta_den.2 t ht
  have hproj_expansion' : N ≤ A - 2 * alpha * M + alpha ^ 2 * C := by
    simpa [A, N, C, M, y, alpha] using hproj_expansion
  have hmrec : M = beta * P + (1 - beta) * G := by
    simpa [M, P, G, y, beta] using
      generatedMSeq_inner_eq_on_horizon setup T hsolv t ht y
  have htwoalpha_pos : 0 < 2 * alpha := by nlinarith
  have hM_mul : M * (2 * alpha) ≤ A - N + alpha ^ 2 * C := by
    nlinarith
  have hM_bound : M ≤ (A - N + alpha ^ 2 * C) / (2 * alpha) := by
    exact (le_div_iff₀ htwoalpha_pos).2 hM_mul
  have hG_scaled :
      (1 - beta) * G ≤
        (A - N + alpha ^ 2 * C) / (2 * alpha) - beta * P := by
    nlinarith
  have hG_bound :
      G ≤ ((A - N + alpha ^ 2 * C) / (2 * alpha) - beta * P) /
          (1 - beta) := by
    exact (le_div_iff₀ hden).2 (by
      simpa [mul_comm] using hG_scaled)
  have halpha_ne : alpha ≠ 0 := ne_of_gt halpha
  have hden_ne : 1 - beta ≠ 0 := ne_of_gt hden
  calc
    inner ℝ (wellDefinedAlgorithm2GeneratedGradient setup t)
        (generatedXSeq setup t - xStar)
        = G := by simp [G, y]
    _ ≤ ((A - N + alpha ^ 2 * C) / (2 * alpha) - beta * P) /
          (1 - beta) := hG_bound
    _ = (A - N) / (2 * alpha * (1 - beta)) +
          (alpha * C) / (2 * (1 - beta)) -
          (beta / (1 - beta)) * P := by
          field_simp [halpha_ne, hden_ne]
    _ = ((∑ i, sqrtVhat i *
              ((generatedXSeq setup t - xStar) i) ^ 2) -
            (∑ i, sqrtVhat i *
              ((generatedXSeq setup (t + 1) - xStar) i) ^ 2)) /
            (2 * setup.alpha_t t * (1 - setup.beta1t t)) +
          (setup.alpha_t t *
              (∑ i, sqrtVhat i * (direction i) ^ 2)) /
            (2 * (1 - setup.beta1t t)) -
          (setup.beta1t t / (1 - setup.beta1t t)) *
            inner ℝ (generatedMSeq setup (t - 1))
              (generatedXSeq setup t - xStar) := by
          simp [A, N, C, P, alpha, beta, y]

/-- Generated pointwise Appendix D Eq. (15) after Young absorption of the
previous-momentum cross term. -/
private theorem generated_projection_young_bound_on_horizon {d : ℕ}
    (setup : Setup d) (T : ℕ) (xStar : CoordinateSpace d)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (hxStar : xStar ∈ setup.F)
    (hdom : Theorem4ParameterDomainOnHorizon setup T)
    (hbeta_den : beta1 setup < 1 ∧
      ∀ t ∈ Finset.Icc 1 T, 0 < 1 - setup.beta1t t) :
    ∀ t ∈ Finset.Icc 1 T,
      ∃ sqrtVhat direction,
        IsCoordSqrt (generatedVhatSeq setup t) sqrtVhat ∧
        IsCoordQuotient (generatedMSeq setup t) sqrtVhat direction ∧
        inner ℝ (wellDefinedAlgorithm2GeneratedGradient setup t)
            (generatedXSeq setup t - xStar) ≤
          ((∑ i, sqrtVhat i *
                ((generatedXSeq setup t - xStar) i) ^ 2) -
              (∑ i, sqrtVhat i *
                ((generatedXSeq setup (t + 1) - xStar) i) ^ 2)) /
              (2 * setup.alpha_t t * (1 - setup.beta1t t)) +
            (setup.alpha_t t *
                (∑ i, sqrtVhat i * (direction i) ^ 2)) /
              (2 * (1 - setup.beta1t t)) +
            (setup.beta1t t * setup.alpha_t t *
                (∑ i, (generatedMSeq setup (t - 1) i) ^ 2 / sqrtVhat i)) /
              (2 * (1 - setup.beta1t t)) +
            (setup.beta1t t *
                (∑ i, sqrtVhat i *
                  ((generatedXSeq setup t - xStar) i) ^ 2)) /
              (2 * setup.alpha_t t * (1 - setup.beta1t t)) := by
  intro t ht
  rcases generated_projection_pre_young_bound_on_horizon
      setup T xStar hsolv hxStar hdom hbeta_den t ht with
    ⟨sqrtVhat, direction, hsqrt, hquot, hpre⟩
  refine ⟨sqrtVhat, direction, hsqrt, hquot, ?_⟩
  let y : CoordinateSpace d := generatedXSeq setup t - xStar
  let metricDrop : ℝ :=
    ((∑ i, sqrtVhat i * ((generatedXSeq setup t - xStar) i) ^ 2) -
      (∑ i, sqrtVhat i *
        ((generatedXSeq setup (t + 1) - xStar) i) ^ 2)) /
      (2 * setup.alpha_t t * (1 - setup.beta1t t))
  let currentMomentum : ℝ :=
    (setup.alpha_t t * (∑ i, sqrtVhat i * (direction i) ^ 2)) /
      (2 * (1 - setup.beta1t t))
  let previousRaw : ℝ :=
    - (setup.beta1t t / (1 - setup.beta1t t)) *
      inner ℝ (generatedMSeq setup (t - 1)) y
  let previousMomentum : ℝ :=
    (setup.beta1t t * setup.alpha_t t *
      (∑ i, (generatedMSeq setup (t - 1) i) ^ 2 / sqrtVhat i)) /
      (2 * (1 - setup.beta1t t))
  let betaMetric : ℝ :=
    (setup.beta1t t *
      (∑ i, sqrtVhat i * ((generatedXSeq setup t - xStar) i) ^ 2)) /
      (2 * setup.alpha_t t * (1 - setup.beta1t t))
  have halpha : 0 < setup.alpha_t t :=
    theorem4ParameterDomain_alpha_t_pos setup T t hdom ht
  have hbeta : 0 ≤ setup.beta1t t :=
    theorem4ParameterDomain_beta1t_nonneg setup T t hdom ht
  have hden : 0 < 1 - setup.beta1t t := hbeta_den.2 t ht
  have hsqrt_pos : ∀ i : Fin d, 0 < sqrtVhat i := by
    intro i
    exact lt_of_le_of_ne (hsqrt i).1 (Ne.symm (hquot i).1)
  have hyoung :
      previousRaw ≤ previousMomentum + betaMetric := by
    simpa [previousRaw, previousMomentum, betaMetric, y] using
      coordinate_scaled_negative_inner_young_bound
        (d := d) (alpha := setup.alpha_t t) (beta := setup.beta1t t)
        (sqrtV := sqrtVhat) (m := generatedMSeq setup (t - 1)) (y := y)
        halpha hbeta hden hsqrt_pos
  have hpre' :
      inner ℝ (wellDefinedAlgorithm2GeneratedGradient setup t)
          (generatedXSeq setup t - xStar) ≤
        metricDrop + currentMomentum + previousRaw := by
    unfold metricDrop currentMomentum previousRaw y
    convert hpre using 1
    ring
  calc
    inner ℝ (wellDefinedAlgorithm2GeneratedGradient setup t)
        (generatedXSeq setup t - xStar)
        ≤ metricDrop + currentMomentum + previousRaw := hpre'
    _ ≤ metricDrop + currentMomentum + previousMomentum + betaMetric := by
        linarith
    _ =
        ((∑ i, sqrtVhat i *
              ((generatedXSeq setup t - xStar) i) ^ 2) -
            (∑ i, sqrtVhat i *
              ((generatedXSeq setup (t + 1) - xStar) i) ^ 2)) /
            (2 * setup.alpha_t t * (1 - setup.beta1t t)) +
          (setup.alpha_t t *
              (∑ i, sqrtVhat i * (direction i) ^ 2)) /
            (2 * (1 - setup.beta1t t)) +
          (setup.beta1t t * setup.alpha_t t *
              (∑ i, (generatedMSeq setup (t - 1) i) ^ 2 / sqrtVhat i)) /
            (2 * (1 - setup.beta1t t)) +
          (setup.beta1t t *
              (∑ i, sqrtVhat i *
                ((generatedXSeq setup t - xStar) i) ^ 2)) /
            (2 * setup.alpha_t t * (1 - setup.beta1t t)) := by
        simp [metricDrop, currentMomentum, previousMomentum, betaMetric]

/-- Horizon-local generated checked updates expose the quotient/projection
domain needed by the displayed AMSGrad projected update. -/
private theorem generated_projected_update_domain_obligation_on_horizon {d : ℕ}
    (setup : Setup d) (T t : ℕ)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (ht : t ∈ Finset.Icc 1 T) :
    ∃ sqrtVhat,
      IsCoordSqrt (generatedVhatSeq setup t) sqrtVhat ∧
        (∀ i, sqrtVhat i ≠ 0) ∧
        IsWeightedProjectionDomain (amsgradProjectionMetricFromSqrt sqrtVhat) := by
  have ht_bounds : 1 ≤ t ∧ t ≤ T := Finset.mem_Icc.mp ht
  have ht_succ : t - 1 + 1 = t := Nat.sub_add_cancel ht_bounds.1
  have hnmem : t - 1 + 1 ∈ Finset.Icc 1 T := by
    simpa [ht_succ] using ht
  have hstep :=
    wellDefinedAlgorithm2GeneratedState_succ_spec_on_horizon setup T (t - 1)
      hsolv hnmem
  unfold IsWellDefinedNextState at hstep
  dsimp at hstep
  rcases hstep with ⟨_hgrad, _hm, _hv, hvhat, hupdate⟩
  have hdomain :=
    projectedUpdate_domainObligation_of_isWellDefinedProjectedUpdate
      setup ((t - 1) + 1)
      (wellDefinedAlgorithm2GeneratedState setup (t - 1))
      (firstMoment setup ((t - 1) + 1)
        (wellDefinedAlgorithm2GeneratedState setup (t - 1))
        (wellDefinedAlgorithm2GeneratedGradient setup ((t - 1) + 1)))
      (longTermMemory (wellDefinedAlgorithm2GeneratedState setup (t - 1))
      (secondMoment setup (wellDefinedAlgorithm2GeneratedState setup (t - 1))
        (wellDefinedAlgorithm2GeneratedGradient setup ((t - 1) + 1))))
      (wellDefinedAlgorithm2GeneratedState setup ((t - 1) + 1)).x
      hupdate
  have hdomain' :
      ∃ sqrtVhat,
        IsCoordSqrt
            (wellDefinedAlgorithm2GeneratedState setup ((t - 1) + 1)).vhat
            sqrtVhat ∧
          (∀ i, sqrtVhat i ≠ 0) ∧
          IsWeightedProjectionDomain (amsgradProjectionMetricFromSqrt sqrtVhat) := by
    simpa [hvhat] using hdomain
  simpa [generatedVhatSeq, ht_succ] using hdomain'

/-- Generated checked Algorithm 2 gradient history component used in the
Theorem 4 RHS. -/
noncomputable def generatedGradientHistoryNorm {d : ℕ} (setup : Setup d)
    (T : ℕ) (i : Fin d) : ℝ :=
  Real.sqrt ((Finset.Icc 1 T).sum fun t =>
    (wellDefinedAlgorithm2GeneratedGradient setup t i) ^ 2)

/-- Corrected infimum-form regret for the canonical generated checked
Algorithm 2 process, avoiding the global `Run` compatibility carrier. -/
noncomputable def generatedRegretAgainstInfimum {d : ℕ}
    (setup : Setup d) (T : ℕ) : ℝ :=
  SOptLib.finiteHorizonRegretAgainstInfimum setup.F setup.f (generatedXSeq setup) T

/-- Horizon-local RHS compatibility obligation for the displayed Theorem 4 RHS
evaluated on the canonical generated Algorithm 2 process.

This contains only scalar/root denominator information for the printed RHS; it
does not carry a `Run` witness and does not require checked Algorithm 2
solvability beyond the theorem horizon. -/
def GeneratedAlgorithm2RHSCompatibilityObligation {d : ℕ}
    (setup : Setup d) (T : ℕ) : Prop :=
  setup.alpha * (1 - beta1 setup) ≠ 0 ∧
    2 * (1 - beta1 setup) ≠ 0 ∧
    Real.sqrt setup.beta2 ≠ 0 ∧
    ((1 - beta1 setup) ^ 2 * (1 - theorem4Gamma setup) *
      Real.sqrt (1 - setup.beta2)) ≠ 0 ∧
    (∃ sqrtBeta2 gamma sqrtOneMinusBeta2,
      IsScalarSqrt setup.beta2 sqrtBeta2 ∧
      IsScalarQuotient (beta1 setup) sqrtBeta2 gamma ∧
      gamma < 1 ∧
      IsScalarSqrt (1 - setup.beta2) sqrtOneMinusBeta2 ∧
      ((1 - beta1 setup) ^ 2 * (1 - gamma) *
        sqrtOneMinusBeta2) ≠ 0) ∧
    (∀ t ∈ Finset.Icc 1 T, IsTheorem4StepSizeAt setup t (setup.alpha_t t)) ∧
    (∀ t ∈ Finset.Icc 1 T, setup.alpha_t t ≠ 0)

/-- Relational interpretation of the displayed Theorem 4 RHS for the
canonical generated Algorithm 2 process, without a global `Run` adapter. -/
def IsGeneratedAlgorithm2Theorem4Bound {d : ℕ}
    (setup : Setup d) (T : ℕ) (B : ℝ) : Prop :=
  ∃ sqrtT sqrtBeta2 gamma sqrtOneMinusBeta2 sqrtOnePlusLogT
      firstCoeff secondCoeff thirdTerm,
    ∃ terminalVhatSqrt : CoordinateSpace d,
    ∃ adaptiveVhatSqrt : ℕ → CoordinateSpace d,
    ∃ adaptiveTerm : ℕ → Fin d → ℝ,
    ∃ historyNorm : Fin d → ℝ,
    IsScalarSqrt (T : ℝ) sqrtT ∧
    IsScalarSqrt setup.beta2 sqrtBeta2 ∧
    IsScalarQuotient (beta1 setup) sqrtBeta2 gamma ∧
    IsScalarSqrt (1 - setup.beta2) sqrtOneMinusBeta2 ∧
    IsScalarSqrt (1 + Real.log (T : ℝ)) sqrtOnePlusLogT ∧
    IsCoordSqrt (generatedVhatSeq setup T) terminalVhatSqrt ∧
    (∀ t ∈ Finset.Icc 1 T,
      IsCoordSqrt (generatedVhatSeq setup t) (adaptiveVhatSqrt t)) ∧
    (∀ i,
      IsScalarSqrt
        ((Finset.Icc 1 T).sum fun t =>
          (wellDefinedAlgorithm2GeneratedGradient setup t i) ^ 2)
        (historyNorm i)) ∧
    gamma < 1 ∧
    IsScalarQuotient (setup.Dinf ^ 2 * sqrtT)
      (setup.alpha * (1 - beta1 setup)) firstCoeff ∧
    IsScalarQuotient (setup.Dinf ^ 2)
      (2 * (1 - beta1 setup)) secondCoeff ∧
    (∀ t ∈ Finset.Icc 1 T, ∀ i,
      IsScalarQuotient
        (setup.beta1t t * adaptiveVhatSqrt t i)
        (setup.alpha_t t) (adaptiveTerm t i)) ∧
    IsScalarQuotient
      (setup.alpha * sqrtOnePlusLogT * (∑ i, historyNorm i))
      ((1 - beta1 setup) ^ 2 * (1 - gamma) * sqrtOneMinusBeta2)
      thirdTerm ∧
    B =
      firstCoeff * (∑ i, terminalVhatSqrt i) +
        secondCoeff *
          ((Finset.Icc 1 T).sum fun t => ∑ i, adaptiveTerm t i) +
        thirdTerm

/-- The generated RHS compatibility boundary supplies the displayed Theorem 4
RHS witness package for the canonical checked generated process. -/
private theorem generatedTheorem4Bound_exists_of_rhsCompatibility {d : ℕ}
    (setup : Setup d) (T : ℕ)
    (hT : 1 ≤ T)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (hrhs : GeneratedAlgorithm2RHSCompatibilityObligation setup T) :
    ∃ B, IsGeneratedAlgorithm2Theorem4Bound setup T B := by
  rcases hrhs with
    ⟨hfirstDen, hsecondDen, _hsqrtBeta2Den, _htotalizedThirdDen,
      hrel, _hstep, halphaDen⟩
  rcases hrel with
    ⟨sqrtBeta2, gamma, sqrtOneMinusBeta2, hsqrtBeta2, hgamma,
      hgamma_lt, hsqrtOneMinusBeta2, hthirdDen⟩
  let sqrtT : ℝ := Real.sqrt (T : ℝ)
  let sqrtOnePlusLogT : ℝ := Real.sqrt (1 + Real.log (T : ℝ))
  let adaptiveVhatSqrt : ℕ → CoordinateSpace d := fun t =>
    if ht : t ∈ Finset.Icc 1 T then
      Classical.choose
        (generated_projected_update_domain_obligation_on_horizon setup T t hsolv ht)
    else
      0
  let terminalVhatSqrt : CoordinateSpace d := adaptiveVhatSqrt T
  let historyNorm : Fin d → ℝ := fun i =>
    Real.sqrt ((Finset.Icc 1 T).sum fun t =>
      (wellDefinedAlgorithm2GeneratedGradient setup t i) ^ 2)
  let adaptiveTerm : ℕ → Fin d → ℝ := fun t i =>
    scalarQuotient (setup.beta1t t * adaptiveVhatSqrt t i) (setup.alpha_t t)
  let firstCoeff : ℝ :=
    scalarQuotient (setup.Dinf ^ 2 * sqrtT)
      (setup.alpha * (1 - beta1 setup))
  let secondCoeff : ℝ :=
    scalarQuotient (setup.Dinf ^ 2) (2 * (1 - beta1 setup))
  let thirdTerm : ℝ :=
    scalarQuotient
      (setup.alpha * sqrtOnePlusLogT * (∑ i, historyNorm i))
      ((1 - beta1 setup) ^ 2 * (1 - gamma) * sqrtOneMinusBeta2)
  let B : ℝ :=
    firstCoeff * (∑ i, terminalVhatSqrt i) +
      secondCoeff *
        ((Finset.Icc 1 T).sum fun t => ∑ i, adaptiveTerm t i) +
      thirdTerm
  refine ⟨B, ?_⟩
  refine ⟨sqrtT, sqrtBeta2, gamma, sqrtOneMinusBeta2, sqrtOnePlusLogT,
    firstCoeff, secondCoeff, thirdTerm, terminalVhatSqrt, adaptiveVhatSqrt,
    adaptiveTerm, historyNorm, ?_⟩
  have hT_nonneg : 0 ≤ (T : ℝ) := by exact_mod_cast Nat.zero_le T
  have hsqrtT : IsScalarSqrt (T : ℝ) sqrtT := by
    refine ⟨Real.sqrt_nonneg _, ?_⟩
    change Real.sqrt (T : ℝ) ^ 2 = (T : ℝ)
    exact Real.sq_sqrt hT_nonneg
  have hT_real : (1 : ℝ) ≤ (T : ℝ) := by exact_mod_cast hT
  have hlog_nonneg : 0 ≤ Real.log (T : ℝ) :=
    Real.log_nonneg hT_real
  have hone_log_nonneg : 0 ≤ 1 + Real.log (T : ℝ) := by linarith
  have hsqrtOnePlusLogT :
      IsScalarSqrt (1 + Real.log (T : ℝ)) sqrtOnePlusLogT := by
    exact ⟨Real.sqrt_nonneg _,
      by simpa [sqrtOnePlusLogT] using Real.sq_sqrt hone_log_nonneg⟩
  have hTmem : T ∈ Finset.Icc 1 T := by
    exact Finset.mem_Icc.mpr ⟨hT, le_rfl⟩
  have hadaptive :
      ∀ t ∈ Finset.Icc 1 T,
        IsCoordSqrt (generatedVhatSeq setup t) (adaptiveVhatSqrt t) := by
    intro t ht
    have hspec := Classical.choose_spec
      (generated_projected_update_domain_obligation_on_horizon setup T t hsolv ht)
    have ht_bounds : 1 ≤ t ∧ t ≤ T := Finset.mem_Icc.mp ht
    simpa [adaptiveVhatSqrt, ht_bounds] using hspec.1
  have hterminal :
      IsCoordSqrt (generatedVhatSeq setup T) terminalVhatSqrt := by
    simpa [terminalVhatSqrt] using hadaptive T hTmem
  have hhistory :
      ∀ i,
        IsScalarSqrt
          ((Finset.Icc 1 T).sum fun t =>
            (wellDefinedAlgorithm2GeneratedGradient setup t i) ^ 2)
          (historyNorm i) := by
    intro i
    have hsum_nonneg :
        0 ≤ ((Finset.Icc 1 T).sum fun t =>
          (wellDefinedAlgorithm2GeneratedGradient setup t i) ^ 2) := by
      exact Finset.sum_nonneg (fun t _ht =>
        sq_nonneg (wellDefinedAlgorithm2GeneratedGradient setup t i))
    exact ⟨Real.sqrt_nonneg _,
      by simpa [historyNorm] using Real.sq_sqrt hsum_nonneg⟩
  have hadaptiveTerm :
      ∀ t ∈ Finset.Icc 1 T, ∀ i,
        IsScalarQuotient
          (setup.beta1t t * adaptiveVhatSqrt t i)
          (setup.alpha_t t) (adaptiveTerm t i) := by
    intro t ht i
    simpa [adaptiveTerm] using
      isScalarQuotient_scalarQuotient
        (setup.beta1t t * adaptiveVhatSqrt t i) (setup.alpha_t t)
        (halphaDen t ht)
  refine ⟨hsqrtT, hsqrtBeta2, hgamma, hsqrtOneMinusBeta2,
    hsqrtOnePlusLogT, hterminal, hadaptive, hhistory, hgamma_lt, ?_, ?_,
    hadaptiveTerm, ?_, ?_⟩
  · simpa [firstCoeff] using
      isScalarQuotient_scalarQuotient
        (setup.Dinf ^ 2 * sqrtT) (setup.alpha * (1 - beta1 setup))
        hfirstDen
  · simpa [secondCoeff] using
      isScalarQuotient_scalarQuotient
        (setup.Dinf ^ 2) (2 * (1 - beta1 setup)) hsecondDen
  · simpa [thirdTerm] using
      isScalarQuotient_scalarQuotient
        (setup.alpha * sqrtOnePlusLogT * (∑ i, historyNorm i))
        ((1 - beta1 setup) ^ 2 * (1 - gamma) * sqrtOneMinusBeta2)
        hthirdDen
  · rfl

/-- Uniform generated-comparator bounds imply the generated infimum-form
regret bound. -/
private theorem generated_regretAgainstInfimum_le_of_uniform_comparator_bound {d : ℕ}
    (setup : Setup d) (T : ℕ) (B : ℝ)
    (huniform :
      ∀ xStar, xStar ∈ setup.F →
        ((Finset.Icc 1 T).sum fun t => setup.f t (generatedXSeq setup t)) -
          ((Finset.Icc 1 T).sum fun t => setup.f t xStar) ≤ B) :
    generatedRegretAgainstInfimum setup T ≤ B := by
  let A : ℝ := (Finset.Icc 1 T).sum fun t => setup.f t (generatedXSeq setup t)
  let S : Set ℝ := fixedComparatorValues setup T
  have hnonempty : S.Nonempty := by
    refine ⟨(Finset.Icc 1 T).sum fun t => setup.f t setup.x₁.1, ?_⟩
    unfold S fixedComparatorValues
    exact ⟨setup.x₁, Set.mem_univ _, rfl⟩
  have hlower : ∀ y ∈ S, A - B ≤ y := by
    intro y hy
    rcases hy with ⟨xStar, _hxuniv, rfl⟩
    have hreg := huniform xStar.1 xStar.2
    change A - (Finset.Icc 1 T).sum (fun t => setup.f t xStar.1) ≤ B at hreg
    linarith
  have hle_inf : A - B ≤ sInf S := le_csInf hnonempty hlower
  unfold generatedRegretAgainstInfimum SOptLib.finiteHorizonRegretAgainstInfimum
    SOptLib.objectiveInfimumValue
  change A - sInf S ≤ B
  linarith

/-- Checked generated Algorithm 2 updates keep generated states feasible on the
active horizon. -/
private theorem generated_state_x_mem_F_on_horizon {d : ℕ}
    (setup : Setup d) (T : ℕ)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T) :
    ∀ n, n ≤ T → (wellDefinedAlgorithm2GeneratedState setup n).x ∈ setup.F := by
  intro n hn
  cases n with
  | zero =>
      have hzero := wellDefinedAlgorithm2GeneratedState_zero setup
      have hxzero :
          (wellDefinedAlgorithm2GeneratedState setup 0).x = setup.x₁.1 := by
        simpa [initialState] using congrArg State.x hzero
      rw [hxzero]
      exact setup.x₁.2
  | succ n =>
      have hmem : n + 1 ∈ Finset.Icc 1 T := by
        exact Finset.mem_Icc.mpr ⟨Nat.succ_pos n, hn⟩
      have hstep :=
        wellDefinedAlgorithm2GeneratedState_succ_spec_on_horizon setup T n hsolv hmem
      unfold IsWellDefinedNextState at hstep
      dsimp at hstep
      rcases hstep with ⟨_hgrad, _hm, _hv, _hvhat, hupdate⟩
      rcases hupdate with
        ⟨_sqrtVhat, _direction, _trial, _hsqrt, _hquot, _htrial, hproj⟩
      exact hproj.2.1

/-- Paper-time generated iterates `x_t` are feasible whenever `t ∈ [1,T]`. -/
private theorem generated_x_mem_F_on_horizon {d : ℕ}
    (setup : Setup d) (T t : ℕ)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (ht : t ∈ Finset.Icc 1 T) :
    generatedXSeq setup t ∈ setup.F := by
  have ht_le : t ≤ T := (Finset.mem_Icc.mp ht).2
  have hpred_le : t - 1 ≤ T := le_trans (Nat.sub_le t 1) ht_le
  simpa [generatedXSeq] using
    generated_state_x_mem_F_on_horizon setup T hsolv (t - 1) hpred_le

/-- Appendix D Eq. (16), generated-process first inequality: convex regret is
bounded by the sum of generated gradient inner products. -/
private theorem generated_convex_regret_le_gradient_sum {d : ℕ}
    (setup : Setup d) (T : ℕ) (xStar : CoordinateSpace d)
    (hsolv : WellDefinedAlgorithm2GeneratedSolvabilityOnHorizon setup T)
    (hxStar : xStar ∈ setup.F) :
    ((Finset.Icc 1 T).sum fun t => setup.f t (generatedXSeq setup t)) -
      ((Finset.Icc 1 T).sum fun t => setup.f t xStar) ≤
        (Finset.Icc 1 T).sum fun t =>
          inner ℝ (wellDefinedAlgorithm2GeneratedGradient setup t)
            (generatedXSeq setup t - xStar) := by
  have hsum :
      (Finset.Icc 1 T).sum (fun t =>
        setup.f t (generatedXSeq setup t) - setup.f t xStar) ≤
        (Finset.Icc 1 T).sum fun t =>
          inner ℝ (wellDefinedAlgorithm2GeneratedGradient setup t)
            (generatedXSeq setup t - xStar) :=
    Finset.sum_le_sum (by
    intro t ht
    have ht_succ : (t - 1) + 1 = t := Nat.sub_add_cancel (Finset.mem_Icc.mp ht).1
    have hnmem : (t - 1) + 1 ∈ Finset.Icc 1 T := by
      simpa [ht_succ] using ht
    have hx_t : generatedXSeq setup t ∈ setup.F :=
      generated_x_mem_F_on_horizon setup T t hsolv ht
    have hstep :=
      wellDefinedAlgorithm2GeneratedState_succ_spec_on_horizon setup T (t - 1)
        hsolv hnmem
    unfold IsWellDefinedNextState at hstep
    dsimp at hstep
    rcases hstep with ⟨hgrad, _hm, _hv, _hvhat, _hupdate⟩
    have hgrad' :
        HasGradientAt (setup.f t) (wellDefinedAlgorithm2GeneratedGradient setup t)
          (generatedXSeq setup t) := by
      simpa [IsGradientAtState, generatedXSeq, ht_succ] using hgrad
    exact convex_value_sub_le_inner_of_hasGradientAt
      (setup.h_loss_convex t) hx_t hxStar hgrad')
  simpa [Finset.sum_sub_distrib] using hsum

/-- The generated relational Theorem 4 RHS witnesses imply the positive
denominators `1 - β₁t` needed in Appendix D Eq. (15)--(18). -/
private theorem generated_amsgrad_beta1_lt_one_and_den_pos {d : ℕ}
    (setup : Setup d) (T : ℕ) (B : ℝ)
    (hT : 1 ≤ T)
    (hdom : Theorem4ParameterDomainOnHorizon setup T)
    (hbeta_le : ∀ t ∈ Finset.Icc 1 T, setup.beta1t t ≤ beta1 setup)
    (hB : IsGeneratedAlgorithm2Theorem4Bound setup T B) :
    beta1 setup < 1 ∧
      ∀ t ∈ Finset.Icc 1 T, 0 < 1 - setup.beta1t t := by
  rcases hB with
    ⟨sqrtT, sqrtBeta2, gamma, sqrtOneMinusBeta2, sqrtOnePlusLogT,
      firstCoeff, secondCoeff, thirdTerm, terminalVhatSqrt, adaptiveVhatSqrt,
      adaptiveTerm, historyNorm, hsqrtT, hsqrtBeta2, hgamma,
      hsqrtOneMinusBeta2, hsqrtOnePlusLogT, hterminal, hadaptive, hhistory,
      hgamma_lt, hfirst, hsecond, hadaptiveTerm, hthird, hB_eq⟩
  have hmem1 : 1 ∈ Finset.Icc 1 T := Finset.mem_Icc.mpr ⟨le_rfl, hT⟩
  have hbeta1_nonneg : 0 ≤ beta1 setup := by
    simpa [beta1] using theorem4ParameterDomain_beta1t_nonneg setup T 1 hdom hmem1
  have hsqrtBeta2_pos : 0 < sqrtBeta2 := by
