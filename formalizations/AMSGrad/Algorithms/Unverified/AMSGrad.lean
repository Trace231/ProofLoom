private theorem amsgrad_projection_trial_square_expansion_on_horizon {d : ℕ}
    (setup : Setup d) (run : Run setup) (T : ℕ)
    (xStar : CoordinateSpace d)
    (hwell : WellDefinedRunOnHorizon setup run T)
    (hxStar : xStar ∈ setup.F) :
    ∀ t ∈ Finset.Icc 1 T,
      ∃ sqrtVhat direction,
        IsCoordSqrt (vhatSeq setup run t) sqrtVhat ∧
        IsCoordQuotient (mSeq setup run t) sqrtVhat direction ∧
        (∑ i, sqrtVhat i * ((xSeq setup run (t + 1) - xStar) i) ^ 2) ≤
          (∑ i, sqrtVhat i * ((xSeq setup run t - xStar) i) ^ 2) -
            2 * setup.alpha_t t *
              (∑ i, (mSeq setup run t i) * ((xSeq setup run t - xStar) i)) +
            (setup.alpha_t t) ^ 2 *
              (∑ i, sqrtVhat i * (direction i) ^ 2) := by
  intro t ht
  rcases amsgrad_projection_coordinate_contraction_on_horizon
      setup run T xStar hwell hxStar t ht with
    ⟨sqrtVhat, direction, trial, hsqrt, hquot, htrial, hcoord⟩
  refine ⟨sqrtVhat, direction, hsqrt, hquot, ?_⟩
  have htrial_sum :
      (∑ i, sqrtVhat i * ((trial - xStar) i) ^ 2) =
        (∑ i, sqrtVhat i * ((xSeq setup run t - xStar) i) ^ 2) -
          2 * setup.alpha_t t *
            (∑ i, (mSeq setup run t i) * ((xSeq setup run t - xStar) i)) +
          (setup.alpha_t t) ^ 2 *
            (∑ i, sqrtVhat i * (direction i) ^ 2) := by
    calc
      (∑ i, sqrtVhat i * ((trial - xStar) i) ^ 2)
          = ∑ i,
              (sqrtVhat i * ((xSeq setup run t - xStar) i) ^ 2 -
                2 * setup.alpha_t t *
                  ((mSeq setup run t i) * ((xSeq setup run t - xStar) i)) +
                (setup.alpha_t t) ^ 2 *
                  (sqrtVhat i * (direction i) ^ 2)) := by
            refine Finset.sum_congr rfl ?_
            intro i _hi
            have hq : sqrtVhat i * direction i = mSeq setup run t i :=
              (hquot i).2
            have hcoord_trial :
                (trial - xStar) i =
                  (xSeq setup run t - xStar) i -
                    setup.alpha_t t * direction i := by
              rw [htrial]
              simp [sub_eq_add_neg, add_assoc, add_comm, add_left_comm]
            rw [hcoord_trial, ← hq]
            ring
      _ = (∑ i, sqrtVhat i * ((xSeq setup run t - xStar) i) ^ 2) -
            2 * setup.alpha_t t *
              (∑ i, (mSeq setup run t i) * ((xSeq setup run t - xStar) i)) +
            (setup.alpha_t t) ^ 2 *
              (∑ i, sqrtVhat i * (direction i) ^ 2) := by
            simp [Finset.sum_add_distrib, Finset.sum_sub_distrib,
              Finset.mul_sum, mul_assoc, mul_left_comm, mul_comm]
  exact le_trans hcoord (le_of_eq htrial_sum)

