/-- Scalar Young inequality in the exact sign used by Appendix D Eq. (15).

SOptLib candidates considered: `scaled_linear_inner_quadratic_le_square_over_denominator`,
`mirror_descent_sum_bound_of_three_point_and_young`, and
`inner_sub_sub_bregman_le_half_dual_sq`; in this target file they are not
import-visible and, more importantly, their Hilbert/Bregman statements do not
expose the literal diagonal coordinate weights `sqrt_i` and denominators needed
for AMSGrad Eq. (15). -/
private theorem real_neg_mul_le_weighted_young
    {alpha sqrtV m y : ℝ}
    (halpha : 0 < alpha) (hsqrt : 0 < sqrtV) :
    -(m * y) ≤ alpha / 2 * (m ^ 2 / sqrtV) +
      (sqrtV * y ^ 2) / (2 * alpha) := by
  have hden_pos : 0 < 2 * alpha * sqrtV := by positivity
  have hnonneg :
      0 ≤ (alpha * m + sqrtV * y) ^ 2 / (2 * alpha * sqrtV) := by
    exact div_nonneg (sq_nonneg _) (le_of_lt hden_pos)
  have heq :
      alpha / 2 * (m ^ 2 / sqrtV) +
          (sqrtV * y ^ 2) / (2 * alpha) + m * y =
        (alpha * m + sqrtV * y) ^ 2 / (2 * alpha * sqrtV) := by
    field_simp [ne_of_gt halpha, ne_of_gt hsqrt]
    ring
  have hnonneg' :
      0 ≤ alpha / 2 * (m ^ 2 / sqrtV) +
          (sqrtV * y ^ 2) / (2 * alpha) + m * y := by
    simpa [heq] using hnonneg
  linarith

/-- Coordinate-summed Young absorption for the previous-momentum term in
Appendix D Eq. (15).

SOptLib candidates considered: `scaled_linear_inner_quadratic_le_square_over_denominator`
packages a norm-level residual completion, while
`mirror_descent_sum_bound_of_three_point_and_young` and
`inner_sub_sub_bregman_le_half_dual_sq` are abstract mirror/Bregman lemmas.
None match the source's literal coordinate form
`∑ m_{t-1,i}^2 / sqrtVhat_i` and `∑ sqrtVhat_i y_i^2`, so this route-local
lemma proves the diagonal finite-sum bridge directly. -/
private theorem coordinate_scaled_negative_inner_young_bound {d : ℕ}
    {alpha beta : ℝ} {sqrtV m y : CoordinateSpace d}
    (halpha : 0 < alpha) (hbeta : 0 ≤ beta) (hden : 0 < 1 - beta)
    (hsqrt_pos : ∀ i : Fin d, 0 < sqrtV i) :
    - (beta / (1 - beta)) * inner ℝ m y ≤
      (beta * alpha * (∑ i, (m i) ^ 2 / sqrtV i)) / (2 * (1 - beta)) +
        (beta * (∑ i, sqrtV i * (y i) ^ 2)) /
          (2 * alpha * (1 - beta)) := by
  have hscale_nonneg : 0 ≤ beta / (1 - beta) := by
    exact div_nonneg hbeta (le_of_lt hden)
  have hsum :
      - inner ℝ m y ≤
        ∑ i, (alpha / 2 * ((m i) ^ 2 / sqrtV i) +
          (sqrtV i * (y i) ^ 2) / (2 * alpha)) := by
    rw [coordinate_inner_eq_sum]
    calc
      - (∑ i, m i * y i)
          = ∑ i, -(m i * y i) := by
              simp [Finset.sum_neg_distrib]
      _ ≤ ∑ i, (alpha / 2 * ((m i) ^ 2 / sqrtV i) +
            (sqrtV i * (y i) ^ 2) / (2 * alpha)) := by
              exact Finset.sum_le_sum (by
                intro i _hi
                exact real_neg_mul_le_weighted_young halpha (hsqrt_pos i))
  have hscaled := mul_le_mul_of_nonneg_left hsum hscale_nonneg
  have halpha_ne : alpha ≠ 0 := ne_of_gt halpha
  have hden_ne : 1 - beta ≠ 0 := ne_of_gt hden
  have hsum_expand :
      (∑ i, (alpha / 2 * ((m i) ^ 2 / sqrtV i) +
        (sqrtV i * (y i) ^ 2) / (2 * alpha))) =
        alpha / 2 * (∑ i, (m i) ^ 2 / sqrtV i) +
          (1 / (2 * alpha)) * (∑ i, sqrtV i * (y i) ^ 2) := by
    simp [Finset.sum_add_distrib, Finset.mul_sum, div_eq_mul_inv,
      mul_assoc, mul_left_comm, mul_comm]
  calc
    - (beta / (1 - beta)) * inner ℝ m y
        = (beta / (1 - beta)) * (- inner ℝ m y) := by ring
    _ ≤ (beta / (1 - beta)) *
        (∑ i, (alpha / 2 * ((m i) ^ 2 / sqrtV i) +
          (sqrtV i * (y i) ^ 2) / (2 * alpha))) := hscaled
    _ = (beta * alpha * (∑ i, (m i) ^ 2 / sqrtV i)) /
          (2 * (1 - beta)) +
        (beta * (∑ i, sqrtV i * (y i) ^ 2)) /
          (2 * alpha * (1 - beta)) := by
          rw [hsum_expand]
          field_simp [halpha_ne, hden_ne]

