private theorem convex_value_sub_le_inner_of_hasGradientAt {d : ℕ}
    {F : Set (CoordinateSpace d)} {f : CoordinateSpace d → ℝ}
    {x y g : CoordinateSpace d}
    (hf : ConvexOn ℝ F f) (hx : x ∈ F) (hy : y ∈ F)
    (hg : HasGradientAt f g x) :
    f x - f y ≤ inner ℝ g (x - y) := by
  set φ : ℝ → ℝ := fun t => f (AffineMap.lineMap x y t)
  have hline_mem : Set.Icc (0 : ℝ) 1 ⊆ (AffineMap.lineMap x y) ⁻¹' F := by
    intro t ht
    have ht0 : 0 ≤ t := ht.1
    have ht1 : t ≤ 1 := ht.2
    have h1t : 0 ≤ 1 - t := sub_nonneg.mpr ht1
    have hsum : 1 - t + t = 1 := by ring
    have hmem : (1 - t) • x + t • y ∈ F := hf.1 hx hy h1t ht0 hsum
    change AffineMap.lineMap x y t ∈ F
    rw [AffineMap.lineMap_apply_module']
    convert hmem using 1
    module
  have hφ_conv : ConvexOn ℝ (Set.Icc (0 : ℝ) 1) φ := by
    simpa [φ] using
      (hf.comp_affineMap (AffineMap.lineMap x y)).subset hline_mem (convex_Icc 0 1)
  have hφ_deriv : HasDerivAt φ (inner ℝ g (y - x)) 0 := by
    have hφ_eq_line : φ = fun t : ℝ => f (x + t • (y - x)) := by
      ext t
      simp only [φ, AffineMap.lineMap_apply_module']
      congr 1
      module
    rw [hφ_eq_line]
    have hfderiv : HasFDerivAt f (InnerProductSpace.toDual ℝ (CoordinateSpace d) g)
        (x + (0 : ℝ) • (y - x)) := by
      simpa using hg.hasFDerivAt
    have hline : HasDerivAt (fun t : ℝ => x + t • (y - x))
        ((1 : ℝ) • (y - x)) 0 := by
      exact (hasDerivAt_id 0).smul_const (y - x) |>.const_add x
    have hcomp := hfderiv.comp_hasDerivAt 0
      (hline.congr_deriv (one_smul ℝ (y - x)))
    simpa [Function.comp_def, InnerProductSpace.toDual_apply_apply] using hcomp
  have hslope := hφ_conv.le_slope_of_hasDerivAt
    (by norm_num : (0 : ℝ) ∈ Set.Icc (0 : ℝ) 1)
    (by norm_num : (1 : ℝ) ∈ Set.Icc (0 : ℝ) 1)
