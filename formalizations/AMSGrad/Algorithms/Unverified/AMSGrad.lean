    (∀ t ∈ Finset.Icc 2 T, setup.beta1t t ≤ setup.beta1t (t - 1)) ∧
    WellDefinedRunOnHorizon setup run T ∧
    totalizedRHSCompatibilityObligation setup run T

/-- A checked weighted projection minimizes the squared matrix quadratic form.

Projection_nonexpansiveness uses the Appendix G projection argmin after
squaring the paper's `Q^(1/2)` norm.  SOptLib candidates considered:
`finset_weighted_residual_sum_eq_zero`,
`finset_weighted_variance_eq_second_moment_sub_norm_mean_sq`,
`weighted_variance_le_second_moment`, and `weighted_sq_norm_sub_center_le`
are finite weighted-average variance/norm facts, not matrix-metric projection
argmin transport; the existing local `IsWeightedProjectionArgmin` plus
`positiveDefiniteWeightedNorm_sq` gives the needed paper-specific bridge. -/
private theorem weighted_projection_minimizes_quadratic_form {d : ℕ}
    (F : Set (CoordinateSpace d)) (metric : MatrixSpace d)
    (z u : CoordinateSpace d)
    (hmetric : IsWeightedProjectionDomain metric)
    (hproj : IsWeightedProjection F metric z u) :
    u ∈ F ∧
      ∀ x ∈ F,
        matrixQuadraticForm metric (u - z) ≤
          matrixQuadraticForm metric (x - z) := by
  have hmetric' : SOptLib.IsPositiveDefiniteFiniteMatrix metric := by
    simpa [IsWeightedProjectionDomain, IsPositiveDefiniteMatrix,
      SOptLib.IsPositiveDefiniteFiniteMatrix, matrixQuadraticForm,
      SOptLib.finiteMatrixQuadraticForm, matrixVec,
      SOptLib.finiteMatrixVec] using hmetric
  have hmetric_nonneg :
      ∀ v, 0 ≤ SOptLib.finiteMatrixQuadraticForm metric v := by
    intro v
    by_cases hv : v = 0
    · subst v
      simp [SOptLib.finiteMatrixQuadraticForm, SOptLib.finiteMatrixVec]
    · exact le_of_lt (hmetric'.2 v hv)
  have hproj' :
      SOptLib.parameterizedFeasibleArgmin
        (fun metric y x =>
          SOptLib.positiveDefiniteFiniteMatrixWeightedNorm metric (x - y))
        F metric z u := by
    simpa [IsWeightedProjectionArgmin, weightedProjectionObjective] using hproj.2
  have hquad :=
    SOptLib.finite_matrix_weighted_projection_minimizes_quadratic_form
      F metric z u hmetric' hproj'
  simpa [matrixQuadraticForm, SOptLib.finiteMatrixQuadraticForm,
    matrixVec, SOptLib.finiteMatrixVec] using hquad


/-- Mathlib's matrix bilinear form specializes to the file's quadratic form. -/
private theorem matrix_toBilin_self {d : ℕ}
    (Q : MatrixSpace d) (x : CoordinateSpace d) :
    Matrix.toBilin' Q x x = matrixQuadraticForm Q x := by
  rw [Matrix.toBilin'_apply]
  simp [matrixQuadraticForm, matrixVec, Finset.mul_sum, mul_assoc]

/-- Symmetry of Mathlib's matrix bilinear form for a symmetric Appendix G metric. -/
private theorem matrix_toBilin_comm {d : ℕ}
    (Q : MatrixSpace d) (hQ : IsWeightedProjectionDomain Q)
    (x y : CoordinateSpace d) :
    Matrix.toBilin' Q x y = Matrix.toBilin' Q y x := by
  have hsym : ∀ i j, Q i j = Q j i := hQ.1
  rw [Matrix.toBilin'_apply, Matrix.toBilin'_apply]
  calc
    (∑ i, ∑ j, x i * Q i j * y j)
        = ∑ j, ∑ i, x i * Q i j * y j := by
            rw [Finset.sum_comm]
    _ = ∑ j, ∑ i, y j * Q j i * x i := by
            refine Finset.sum_congr rfl ?_
            intro j _hj
            refine Finset.sum_congr rfl ?_
            intro i _hi
            rw [hsym i j]
            ring
    _ = ∑ i, ∑ j, y i * Q i j * x j := rfl

/-- Appendix G quadratic expansion behind the positive-definite rearrangement. -/
private theorem matrixQuadraticForm_sub_expansion {d : ℕ}
    (Q : MatrixSpace d) (hQ : IsWeightedProjectionDomain Q)
    (p q : CoordinateSpace d) :
    matrixQuadraticForm Q (q - p) =
      matrixQuadraticForm Q q - 2 * Matrix.toBilin' Q q p +
        matrixQuadraticForm Q p := by
  simpa only [← WithLp.ofLp_sub, matrix_toBilin_self] using
    SOptLib.finiteMatrixQuadraticForm_sub_expansion Q hQ.1 p q

/-- Quadratic expansion along a feasible segment for Appendix G projection VI. -/
private theorem matrixQuadraticForm_segment_expansion {d : ℕ}
    (Q : MatrixSpace d) (hQ : IsWeightedProjectionDomain Q)
    (a b : CoordinateSpace d) (t : ℝ) :
    matrixQuadraticForm Q (a + t • b) =
      matrixQuadraticForm Q a + 2 * t * Matrix.toBilin' Q a b +
        t ^ 2 * matrixQuadraticForm Q b := by
  rw [← matrix_toBilin_self Q (a + t • b)]
  have hseg := SOptLib.matrix_toBilin_add_smul_self_of_symm Q hQ.1
    (WithLp.ofLp a) (WithLp.ofLp b) t
  simpa [WithLp.ofLp_add, WithLp.ofLp_smul, matrix_toBilin_self Q a,
    matrix_toBilin_self Q b] using hseg

/-- Derivative at the left endpoint of the normalized scalar quadratic. -/
private theorem scalar_quadratic_segment_hasDerivWithinAt_zero
    (A B C : ℝ) :
    HasDerivWithinAt (fun t : ℝ => A + (2 * B) * t + C * t ^ 2) (2 * B)
      (Set.Icc (0 : ℝ) 1) 0 := by
  have hlin : HasDerivWithinAt (fun t : ℝ => (2 * B) * t) (2 * B)
      (Set.Icc (0 : ℝ) 1) 0 := by
    simpa using
      (((hasDerivAt_id (0 : ℝ)).const_mul (2 * B)).hasDerivWithinAt
        (s := Set.Icc (0 : ℝ) 1))
  have hquad : HasDerivWithinAt (fun t : ℝ => C * t ^ 2) 0
      (Set.Icc (0 : ℝ) 1) 0 := by
    simpa using
      ((((hasDerivAt_id (0 : ℝ)).pow 2).const_mul C).hasDerivWithinAt
        (s := Set.Icc (0 : ℝ) 1))
  have hbody := hlin.add hquad
  have hfull := hbody.const_add A
  simpa [Pi.add_apply, add_assoc] using hfull

/-- Positive-definite quadratic contraction from the two projection VIs.

This is Appendix G Eq. (24) plus the rearrangement of
`0 ≤ (q-p)ᵀQ(q-p)`, separated from the calculus step that supplies the
variational inequalities. -/
private theorem positive_definite_projection_quadratic_contraction {d : ℕ}
    (metric : MatrixSpace d) (hmetric : IsWeightedProjectionDomain metric)
    (z₁ z₂ u₁ u₂ : CoordinateSpace d)
    (hvi₁ : 0 ≤ Matrix.toBilin' metric (u₁ - z₁) (u₂ - u₁))
    (hvi₂ : 0 ≤ Matrix.toBilin' metric (u₂ - z₂) (u₁ - u₂)) :
    matrixQuadraticForm metric (u₁ - u₂) ≤
      matrixQuadraticForm metric (z₁ - z₂) := by
  let p : CoordinateSpace d := u₁ - u₂
  let q : CoordinateSpace d := z₁ - z₂
  let a : CoordinateSpace d := u₁ - z₁
  let b : CoordinateSpace d := u₂ - z₂
  have hdir₁ : u₂ - u₁ = -p := by
    ext i
    simp [p]
  have hvi₁p : Matrix.toBilin' metric a p ≤ 0 := by
    have hvi₁a :
        0 ≤ (Matrix.toBilin' metric) a.ofLp (u₂ - u₁).ofLp := by
      simpa [a] using hvi₁
    have harg : (u₂ - u₁).ofLp = -p.ofLp :=
      congrArg (fun x : CoordinateSpace d => x.ofLp) hdir₁
    have hneg : 0 ≤ -Matrix.toBilin' metric a p := by
      change 0 ≤ -((Matrix.toBilin' metric) a.ofLp p.ofLp)
      rw [← LinearMap.BilinForm.neg_right (B₁ := Matrix.toBilin' metric)]
      rwa [← harg]
    linarith
  have hvi₂p : 0 ≤ Matrix.toBilin' metric b p := by
    simpa [b, p] using hvi₂
  have hdecomp : q = p - a + b := by
    ext i
    simp [p, q, a, b]
  have hBdecomp : Matrix.toBilin' metric q p =
      matrixQuadraticForm metric p - Matrix.toBilin' metric a p +
        Matrix.toBilin' metric b p := by
    rw [hdecomp]
    change (Matrix.toBilin' metric) (p.ofLp - a.ofLp + b.ofLp) p.ofLp =
      matrixQuadraticForm metric p - Matrix.toBilin' metric a p +
        Matrix.toBilin' metric b p
    rw [LinearMap.BilinForm.add_left, LinearMap.BilinForm.sub_left,
      matrix_toBilin_self]
  have hleB : matrixQuadraticForm metric p ≤ Matrix.toBilin' metric q p := by
    nlinarith
  have hnonneg : 0 ≤ matrixQuadraticForm metric (q - p) := by
    by_cases hzero : q - p = 0
    · rw [hzero]
      simp [matrixQuadraticForm, matrixVec]
    · exact le_of_lt (hmetric.2 (q - p) hzero)
  have hupper : Matrix.toBilin' metric q p ≤
      (matrixQuadraticForm metric q + matrixQuadraticForm metric p) / 2 := by
    have hexp := matrixQuadraticForm_sub_expansion metric hmetric p q
    nlinarith
  have hpq : matrixQuadraticForm metric p ≤ matrixQuadraticForm metric q := by
    nlinarith
  simpa [p, q] using hpq

/-- Projection variational inequality from squared-quadratic minimality.

This is Appendix G's "property of projection operator" specialized to the
file's source-facing `IsWeightedProjection` relation.  The proof uses the
quadratic minimizer bridge above, convex feasibility of the segment, the
segment expansion, and SOptLib's right-endpoint derivative sign lemma. -/
private theorem weighted_projection_variational_inequality {d : ℕ}
    (F : Set (CoordinateSpace d)) (metric : MatrixSpace d)
    (z u x : CoordinateSpace d)
    (hF : Convex ℝ F) (hmetric : IsWeightedProjectionDomain metric)
    (hproj : IsWeightedProjection F metric z u) (hxF : x ∈ F) :
    0 ≤ Matrix.toBilin' metric (u - z) (x - u) := by
  obtain ⟨huF, hminquad⟩ :=
    weighted_projection_minimizes_quadratic_form F metric z u hmetric hproj
  let a : CoordinateSpace d := u - z
  let b : CoordinateSpace d := x - u
  let φ : ℝ → ℝ := fun t => matrixQuadraticForm metric (a + t • b)
  let B : ℝ := Matrix.toBilin' metric a b
  let C : ℝ := matrixQuadraticForm metric b
  have hφeq : ∀ t : ℝ,
      φ t = matrixQuadraticForm metric a + (2 * B) * t + C * t ^ 2 := by
    intro t
    simp [φ, B, C, matrixQuadraticForm_segment_expansion metric hmetric a b t]
    ring
  have hderiv : HasDerivWithinAt φ (2 * B) (Set.Icc (0 : ℝ) 1) 0 := by
    have hpoly := scalar_quadratic_segment_hasDerivWithinAt_zero
      (matrixQuadraticForm metric a) B C
    exact hpoly.congr (fun t _ht => hφeq t) (hφeq 0)
  have hφmin : ∀ t ∈ Set.Icc (0 : ℝ) 1, φ 0 ≤ φ t := by
    intro t ht
    have hline_mem : u + t • (x - u) ∈ F := by
      have hmem : AffineMap.lineMap u x t ∈ F :=
        hF.lineMap_mem huF hxF ht
      have hline_eq : u + t • (x - u) = AffineMap.lineMap u x t := by
        simp [AffineMap.lineMap_apply_module', add_comm]
      rwa [hline_eq]
    have hmin := hminquad (u + t • (x - u)) hline_mem
    have hshift : u + t • (x - u) - z = a + t • b := by
      ext i
      simp [a, b]
      ring
    simpa [φ, a, b, hshift] using hmin
  have hnonneg2 : 0 ≤ 2 * B :=
    right_derivative_nonneg_of_min_on_Icc hderiv hφmin
  have : 0 ≤ B := by nlinarith
  simpa [B, a, b] using this

