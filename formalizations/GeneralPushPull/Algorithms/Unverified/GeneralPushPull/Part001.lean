        rfl
  have hPrimalEnergy :
      ∑ t ∈ Finset.range T.1,
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq
              (FiniteNetwork.consensusError (primal S omega alpha t))) ≤
        alpha ^ 2 * disagreementKernel S.network * trackerEnergy S alpha T := by
    have htransport :=
