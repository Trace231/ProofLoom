noncomputable section

open scoped BigOperators InnerProductSpace Matrix
open MeasureTheory

namespace Algorithms.Unverified.GeneralPushPull

/-! # General Push--Pull: source-facing object model

This file models the fixed algorithm in `book/GeneralPushPull/GeneralPushPull.json`.
The network is deterministic and horizon-independent by construction. An oracle
table and every algorithm state are derived below; neither is supplied as a witness.
-/

abbrev Point (d : ℕ) := EuclideanSpace ℝ (Fin d)
abbrev NodeTable (n d : ℕ) := Fin n → Point d
abbrev NetworkMatrix (n : ℕ) := Matrix (Fin n) (Fin n) ℝ

/-- Source-facing run horizons.  Every displayed output and comparator in the
paper contains division by `T` and is stated only for `T ≥ 1`.
Book `#/algorithm_spec/output/math`:
“`\mathcal E_T=\frac1T\sum_{t=0}^{T-1}\mathbb E\|\nabla f(\bar x_t)\|^2`”. -/
abbrev PositiveHorizon := {T : ℕ // 0 < T}

/-- The paper's pre-sampling history `F_{t^-}`, constructed from the oracle
stream rather than supplied as an unrelated witness. It is the sigma-algebra
generated by the strict noise prefix `ε_0,...,ε_{t-1}`.
Book `#/assumptions/14/math`:
“令 `(\mathcal F_{t^-})` 为第 `(t)` 次 oracle 采样前的历史，包含 `(X_t)`”. -/
@[reducible] def preSamplingHistoryOf
    {n d : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    (noise : ℕ → Ω → NodeTable n d) (t : ℕ) : MeasurableSpace Ω :=
  ⨆ j : ℕ, ⨆ (_ : j < t),
    MeasurableSpace.comap (noise j)
      (inferInstance : MeasurableSpace (NodeTable n d))

/-- A conditional second-moment inequality together with the nonfallback
domain of Mathlib's conditional expectation. -/
def ConditionalSecondMomentBound
    {E Ω : Type*} [NormedAddCommGroup E] [m0 : MeasurableSpace Ω]
    (μ : Measure[m0] Ω) (m : MeasurableSpace Ω) (Z : Ω → E) (bound : ℝ) : Prop :=
  @SOptLib.ConditionalExpectation.conditionalExpectationWellDefined
      Ω ℝ m0 _ μ m (fun ω => ‖Z ω‖ ^ 2) ∧
    @MeasureTheory.condExp Ω ℝ m (m₀ := m0) _ _ _ μ
      (fun ω => ‖Z ω‖ ^ 2) ≤ᵐ[μ] fun _ => bound

/-- Event-factorization form of conditional independence for a finite family.
Every conditional expectation in the factorization is explicitly required to
lie in Mathlib's nonfallback domain. -/
def NodeConditionallyIndependent
    {Node E Ω : Type*} [Fintype Node] [DecidableEq Node]
    [MeasurableSpace E] [m0 : MeasurableSpace Ω]
    (μ : Measure[m0] Ω) (m : MeasurableSpace Ω) (Z : Node → Ω → E) : Prop :=
  ∀ (s : Finset Node) (A : Node → Set E),
    (∀ i ∈ s, MeasurableSet (A i)) →
      (∀ i ∈ s,
        @SOptLib.ConditionalExpectation.conditionalExpectationWellDefined
          Ω ℝ m0 _ μ m ((Z i ⁻¹' A i).indicator fun _ => (1 : ℝ))) ∧
      @SOptLib.ConditionalExpectation.conditionalExpectationEq
        Ω ℝ m0 _ _ _ μ m
        (fun ω => ∏ i ∈ s,
          (Z i ⁻¹' A i).indicator (fun _ => (1 : ℝ)) ω)
        (fun ω => ∏ i ∈ s,
          (@MeasureTheory.condExp Ω ℝ m (m₀ := m0)
            _ _ _ μ ((Z i ⁻¹' A i).indicator fun _ => (1 : ℝ))) ω)

/-- A fixed admissible exogenous network. Book `#/assumptions/6/math`:
“`\mathcal N=\{(R_t,C_t)\}_{t\ge0}`”; its individual laws are cited on fields. -/
structure NetworkSetup (n : ℕ) where
  /-- Book `#/assumptions/0/math`: “`n\ge1`”. -/
  hn : 0 < n
  /-- Book `#/assumptions/11/math`: “存在与 `(t)` 无关的 `(a>0)`”. -/
  a : ℝ
  /-- Book `#/assumptions/11/math`: “`a>0`”. -/
  ha : 0 < a
  /-- Book `#/assumptions/6/math`: “`\mathcal N=\{(R_t,C_t)\}_{t\ge0}`”. -/
  rowMix : ℕ → NetworkMatrix n
  /-- Book `#/assumptions/6/math`: “`\mathcal N=\{(R_t,C_t)\}_{t\ge0}`”. -/
  colMix : ℕ → NetworkMatrix n
  /-- Book `#/assumptions/9/math`: “`R_t\ge0,\ R_t\mathbf1=\mathbf1`”. -/
  row_stochastic : ∀ t, rowMix t ∈ Matrix.rowStochastic ℝ (Fin n)
  /-- Book `#/assumptions/10/math`: “`C_t\ge0,\ \mathbf1^\top C_t=\mathbf1^\top`”. -/
  col_stochastic : ∀ t, colMix t ∈ Matrix.colStochastic ℝ (Fin n)
  /-- Book `#/assumptions/11/math`: “两个矩阵均有正对角”. -/
  row_positive_diagonal : ∀ t, FiniteNetwork.PositiveDiagonal (rowMix t)
  /-- Book `#/assumptions/11/math`: “两个矩阵均有正对角”. -/
  col_positive_diagonal : ∀ t, FiniteNetwork.PositiveDiagonal (colMix t)
  /-- Book `#/assumptions/11/math`: “所有非零权重至少为 `(a)`”. -/
  row_weight_floor : ∀ t i j, rowMix t i j ≠ 0 → a ≤ rowMix t i j
  /-- Book `#/assumptions/11/math`: “所有非零权重至少为 `(a)`”. -/
  col_weight_floor : ∀ t i j, colMix t i j ≠ 0 → a ≤ colMix t i j
  /-- Book `#/assumptions/12/math`: “`(R_t)` ... 对应的有向图均强连通”. -/
  row_strongly_connected :
    ∀ t, FiniteNetwork.IsStronglyConnectedPositiveSupport (rowMix t)
  /-- Book `#/assumptions/12/math`: “`(C_t)` ... 对应的有向图均强连通”. -/
  col_strongly_connected :
    ∀ t, FiniteNetwork.IsStronglyConnectedPositiveSupport (colMix t)

/-- The paper's stated finite-parameter, objective, fixed-network, and oracle data.

The `Prop` fields are precisely assumptions from the source contract. In
particular, there are no fields for iterates, sampled oracle tables, Perron rows,
influence operators, window comparators, or any proof-step regularity fact.
-/
structure Setup (n d : ℕ) (Ω : Type*) [MeasurableSpace Ω] where
  /-- Book `#/assumptions/6/math`: “`\mathcal N=\{(R_t,C_t)\}_{t\ge0}`”. -/
  network : NetworkSetup n
  /-- Book `#/setup/variable_space/math`: “`n\ge1,\ d\ge1`”. -/
  hd : 0 < d
  /-- Book `#/assumptions/0/math`: “`L>0`”. -/
  L : ℝ
  /-- Book `#/assumptions/0/math`: “`\Delta>0`”. -/
  Δ : ℝ
  /-- Book `#/assumptions/0/math`: “`\sigma\ge0`”. -/
  σ : ℝ
  /-- Book `#/assumptions/0/math`: “`0\le H<\infty`”. -/
  H : ℝ
  /-- Book `#/assumptions/0/math`: “`L>0`”. -/
  hL : 0 < L
  /-- Book `#/assumptions/0/math`: “`\Delta>0`”. -/
  hΔ : 0 < Δ
  /-- Book `#/assumptions/0/math`: “`\sigma\ge0`”. -/
  hσ : 0 ≤ σ
  /-- Book `#/assumptions/0/math`: “`0\le H<\infty`”. -/
  hH : 0 ≤ H
  /-- Book `#/assumptions/4/math`: “每个 `(f_i:\mathbb R^d\to\mathbb R)`”. -/
  localObjective : Fin n → Point d → ℝ
  /-- Book `#/assumptions/5/math`: “`\Delta=f(x_0)-\inf f`”. -/
  initialPoint : Point d
  /-- Book `#/assumptions/13/math`: “`G_{i,t}=\nabla f_i(x_{i,t})+\varepsilon_{i,t}`”. -/
  noise : ℕ → Ω → NodeTable n d
  /-- Book `#/assumptions/15/math` uses the oracle probability law in
  “`\mathbb E[\varepsilon_{i,t}\mid\mathcal F_{t^-}]=0`”. -/
  probability : Measure Ω
  /-- Book `#/assumptions/15/math` uses `\mathbb E`, hence a probability measure. -/
  is_probability : IsProbabilityMeasure probability
  /-- Book `#/assumptions/4/math`: “全局 `(L)`-光滑”. -/
  local_smooth : ∀ i,
    Differentiable ℝ (localObjective i) ∧
      LipschitzWith ⟨L, le_of_lt hL⟩ (gradient (localObjective i))
  /-- Book `#/setup/problem/description`: “lower-bounded average”. -/
  average_lower_bounded : BddBelow (Set.range fun x =>
    (n : ℝ)⁻¹ * ∑ i, localObjective i x)
  /-- Book `#/assumptions/5/math`: “`0<\Delta=f(x_0)-\inf f<\infty`”. -/
  exact_initial_gap :
    (n : ℝ)⁻¹ * ∑ i, localObjective i initialPoint -
      sInf (Set.range fun x => (n : ℝ)⁻¹ * ∑ i, localObjective i x) = Δ
  /-- Book `#/assumptions/15/math`: “`\mathbb E[\varepsilon_{i,t}\mid\mathcal F_{t^-}]=0`”. -/
  noise_centered : ∀ t i,
    SOptLib.ConditionalExpectation.conditionalExpectationEq probability
      (preSamplingHistoryOf noise t) (fun ω => noise t ω i) (fun _ => 0)
  /-- Book `#/assumptions/16/math`: “`\mathbb E[\|\varepsilon_{i,t}\|^2\mid\mathcal F_{t^-}]\le\sigma^2`”. -/
  noise_second_moment : ∀ t i,
    ConditionalSecondMomentBound probability (preSamplingHistoryOf noise t)
      (fun ω => noise t ω i) (σ ^ 2)
  /-- Book `#/assumptions/17/math`: “给定 `(\mathcal F_{t^-})` 后，同一时刻不同节点的噪声条件独立”. -/
  node_conditional_independence : ∀ t,
    NodeConditionallyIndependent probability (preSamplingHistoryOf noise t)
      (fun i ω => noise t ω i)

variable {n d : ℕ} {Ω : Type*} [MeasurableSpace Ω]

namespace Setup

abbrev hn (S : Setup n d Ω) := S.network.hn
abbrev a (S : Setup n d Ω) := S.network.a
abbrev ha (S : Setup n d Ω) := S.network.ha
abbrev rowMix (S : Setup n d Ω) := S.network.rowMix
abbrev colMix (S : Setup n d Ω) := S.network.colMix
abbrev row_stochastic (S : Setup n d Ω) := S.network.row_stochastic
abbrev col_stochastic (S : Setup n d Ω) := S.network.col_stochastic
abbrev row_positive_diagonal (S : Setup n d Ω) := S.network.row_positive_diagonal
abbrev col_positive_diagonal (S : Setup n d Ω) := S.network.col_positive_diagonal
abbrev row_weight_floor (S : Setup n d Ω) := S.network.row_weight_floor
abbrev col_weight_floor (S : Setup n d Ω) := S.network.col_weight_floor
abbrev row_strongly_connected (S : Setup n d Ω) := S.network.row_strongly_connected
abbrev col_strongly_connected (S : Setup n d Ω) := S.network.col_strongly_connected

end Setup

variable {n d : ℕ} {Ω : Type*} [MeasurableSpace Ω]

/-- Canonical notation for the pre-sampling history of a setup. -/
@[reducible] def preSamplingHistory (S : Setup n d Ω) (t : ℕ) : MeasurableSpace Ω :=
  preSamplingHistoryOf S.noise t

/-- The generated history is a genuine sub-sigma-algebra. This is derived
from the source oracle law's nonfallback conditional-expectation semantics. -/
theorem preSamplingHistory_le (S : Setup n d Ω) (t : ℕ) :
    preSamplingHistory S t ≤ (inferInstance : MeasurableSpace Ω) := by
  let i₀ : Fin n := ⟨0, S.hn⟩
  exact (S.noise_centered t i₀).wellDefined.subSigmaLe

/-- The histories form the paper's canonical increasing pre-sampling
filtration. Its ambient-space property is derived from the oracle law. -/
def preSamplingFiltration (S : Setup n d Ω) :
    Filtration ℕ (inferInstance : MeasurableSpace Ω) where
  seq := preSamplingHistory S
  mono' := by
    intro s t hst
    unfold preSamplingHistory preSamplingHistoryOf
    exact iSup_mono fun j => iSup_mono' fun hj => ⟨lt_of_lt_of_le hj hst, le_rfl⟩
  le' := preSamplingHistory_le S

/-- Conditional centering implies Bochner integrability of every noise
coordinate; this is no longer a separate source-facing regularity assumption. -/
theorem noise_integrable (S : Setup n d Ω) (t : ℕ) (i : Fin n) :
    Integrable (fun ω => S.noise t ω i) S.probability := by
  exact (S.noise_centered t i).wellDefined.integrable

/-- The conditional second-moment law implies integrability of the squared
noise norm, excluding the `condExp` zero fallback. -/
theorem noise_norm_sq_integrable (S : Setup n d Ω) (t : ℕ) (i : Fin n) :
    Integrable (fun ω => ‖S.noise t ω i‖ ^ 2) S.probability := by
  exact (S.noise_second_moment t i).1.integrable

/-- The finite average objective. Book `#/setup/problem/math`:
“`f(x)=\frac1n\sum_{i=1}^n f_i(x)`”. -/
def averageObjective (S : Setup n d Ω) (x : Point d) : ℝ :=
  (n : ℝ)⁻¹ * ∑ i, S.localObjective i x

/-- The initial local-gradient heterogeneity. Book `#/assumptions/3/math`:
“`H_0^2=n^{-1}\sum_i\|\nabla f_i(x_0)-\nabla f(x_0)\|^2`”. -/
def initialHeterogeneitySq (S : Setup n d Ω) : ℝ :=
  (n : ℝ)⁻¹ * ∑ i,
    ‖gradient (S.localObjective i) S.initialPoint -
      gradient (averageObjective S) S.initialPoint‖ ^ 2

/-- Membership in the paper's fixed finite layer. Book `#/assumptions/3/math`:
“`H_0^2 ... \le H^2`”. -/
def InFiniteHeterogeneityLayer (S : Setup n d Ω) : Prop :=
  initialHeterogeneitySq S ≤ S.H ^ 2

/-- Module-valued left action of a network matrix on a node table. -/
def leftAct (A : NetworkMatrix n) (X : NodeTable n d) : NodeTable n d :=
  Matrix.smulVec A X

/-- The primitive sampled oracle table. Book `#/assumptions/13/math`:
“`G_{i,t}=\nabla f_i(x_{i,t})+\varepsilon_{i,t}`”. -/
def oracleTable (S : Setup n d Ω) (ω : Ω) (t : ℕ)
    (X : NodeTable n d) : NodeTable n d :=
  fun i => gradient (S.localObjective i) (X i) + S.noise t ω i

/-- Paper initialization. Book `#/algorithm_spec/initialization/math`:
“`X_0=\mathbf1x_0^\top,\ Y_0=G_0`”. -/
def initialState (S : Setup n d Ω) (ω : Ω) : SOptLib.PushPullState (Fin n) (Point d) :=
  let X0 : NodeTable n d := fun _ => S.initialPoint
  { primal := X0
    tracker := oracleTable S ω 0 X0 }

/-- One exact General Push--Pull transition. Book
`#/algorithm_spec/steps/0/math`: “`X_{t+1}=R_tX_t-\alpha_TY_t`”, and
`#/algorithm_spec/steps/1/math`: “`Y_{t+1}=C_tY_t+G_{t+1}-G_t`”. -/
def oneStep (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ)
    (state : SOptLib.PushPullState (Fin n) (Point d)) :
    SOptLib.PushPullState (Fin n) (Point d) :=
  SOptLib.pushPullStep leftAct S.rowMix S.colMix α (oracleTable S ω) t state

/-- The complete sample-path trajectory generated by `initialState` and `oneStep`. -/
def Setup.trajectory (S : Setup n d Ω) (ω : Ω) (α : ℝ) :
    ℕ → SOptLib.PushPullState (Fin n) (Point d)
  | 0 => initialState S ω
  | t + 1 => oneStep S ω α t (Setup.trajectory S ω α t)

/-- Compatibility alias for the canonical `Setup.trajectory` implementation. -/
def trajectory (S : Setup n d Ω) (ω : Ω) (α : ℝ) :
    ℕ → SOptLib.PushPullState (Fin n) (Point d) :=
  Setup.trajectory S ω α

/-- Canonical primal table `X_t`. -/
def primal (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) : NodeTable n d :=
  (Setup.trajectory S ω α t).primal

/-- Canonical gradient-tracker table `Y_t`. -/
def tracker (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) : NodeTable n d :=
  (Setup.trajectory S ω α t).tracker

/-- Canonical sampled oracle table `G_t`, evaluated at the canonical primal table. -/
def sampledOracle (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) : NodeTable n d :=
  oracleTable S ω t (primal S ω α t)

/-- Every noise table strictly before the cutoff belongs to the exact generated
pre-sampling history. -/
theorem noise_measurable_preSamplingHistory_of_lt
    (S : Setup n d Ω) {j t : ℕ} (hjt : j < t) :
    Measurable[preSamplingHistory S t] (S.noise j) := by
  rw [measurable_iff_comap_le]
  unfold preSamplingHistory preSamplingHistoryOf
  exact le_iSup_of_le j (le_iSup_of_le hjt le_rfl)

/-- A deterministic network action preserves table-valued measurability. -/
theorem leftAct_measurable
    (S : Setup n d Ω) (t : ℕ) (A : NetworkMatrix n)
    (X : Ω → NodeTable n d)
    (hX : Measurable[preSamplingHistory S t] X) :
    Measurable[preSamplingHistory S t] (fun ω => leftAct A (X ω)) := by
  classical
  refine @measurable_pi_lambda
    Ω (Fin n) (fun _ : Fin n => Point d)
    (preSamplingHistory S t) (fun _ => by infer_instance)
    (fun ω i => leftAct A (X ω) i) ?_
  intro i
  unfold leftAct Matrix.smulVec
  refine Finset.measurable_sum _ ?_
  intro j _hj
  exact ((measurable_pi_apply j).comp hX).const_smul (A i j)

/-- Smooth local gradients and a measurable noise table give a measurable
sampled-oracle table. -/
theorem oracleTable_measurable
    (S : Setup n d Ω) (k t : ℕ) (X : Ω → NodeTable n d)
    (hX : Measurable[preSamplingHistory S k] X)
    (hnoise : Measurable[preSamplingHistory S k] (S.noise t)) :
    Measurable[preSamplingHistory S k]
      (fun ω => oracleTable S ω t (X ω)) := by
  refine @measurable_pi_lambda
    Ω (Fin n) (fun _ : Fin n => Point d)
    (preSamplingHistory S k) (fun _ => by infer_instance)
    (fun ω i => oracleTable S ω t (X ω) i) ?_
  intro i
  exact
    ((S.local_smooth i).2.continuous.measurable.comp
        ((measurable_pi_apply i).comp hX)).add
      ((measurable_pi_apply i).comp hnoise)

/-- The canonical iterate `X_t` is measurable before the time-`t` oracle
sample. This is the formal bridge for the source phrase that
`F_{t^-}` contains `X_t`; it is derived from the generated recursion. -/
theorem primal_measurable_preSamplingHistory
    (S : Setup n d Ω) (α : ℝ) (t : ℕ) :
    Measurable[preSamplingHistory S t] (fun ω => primal S ω α t) := by
  have hhist_mono : ∀ {s t : ℕ}, s ≤ t →
      preSamplingHistory S s ≤ preSamplingHistory S t := by
    intro s t hst
    exact (preSamplingFiltration S).mono' hst
  have hinvariant : ∀ r : ℕ,
      Measurable[preSamplingHistory S r] (fun ω => primal S ω α r) ∧
      Measurable[preSamplingHistory S (r + 1)] (fun ω => tracker S ω α r) ∧
      Measurable[preSamplingHistory S (r + 1)]
        (fun ω => sampledOracle S ω α r) := by
    intro r
    induction r with
    | zero =>
        have hX0 :
            Measurable[preSamplingHistory S 0]
              (fun ω => primal S ω α 0) := by
          simpa [primal, Setup.trajectory, initialState] using
            (measurable_const :
              Measurable[preSamplingHistory S 0]
                (fun _ : Ω => (fun _ : Fin n => S.initialPoint)))
        have hX0_lift :
            Measurable[preSamplingHistory S 1]
              (fun ω => primal S ω α 0) :=
          hX0.mono (hhist_mono (Nat.zero_le 1)) le_rfl
        have hnoise0 :
            Measurable[preSamplingHistory S 1] (S.noise 0) :=
          noise_measurable_preSamplingHistory_of_lt S Nat.zero_lt_one
        have hG0 :
            Measurable[preSamplingHistory S 1]
              (fun ω => sampledOracle S ω α 0) := by
          simpa only [sampledOracle] using
            oracleTable_measurable S 1 0
              (fun ω => primal S ω α 0) hX0_lift hnoise0
        have hY0 :
            Measurable[preSamplingHistory S 1]
              (fun ω => tracker S ω α 0) := by
          simpa only [tracker, sampledOracle, primal, Setup.trajectory, initialState] using hG0
        exact ⟨hX0, hY0, hG0⟩
    | succ r ih =>
        have hX_lift :
            Measurable[preSamplingHistory S (r + 1)]
              (fun ω => primal S ω α r) :=
          ih.1.mono (hhist_mono (Nat.le_succ r)) le_rfl
        have hleftX :
            Measurable[preSamplingHistory S (r + 1)]
              (fun ω => leftAct (S.rowMix r) (primal S ω α r)) :=
          leftAct_measurable S (r + 1) (S.rowMix r)
            (fun ω => primal S ω α r) hX_lift
        have hXnext :
            Measurable[preSamplingHistory S (r + 1)]
              (fun ω => primal S ω α (r + 1)) := by
          have hrec :
              (fun ω => primal S ω α (r + 1)) =
                fun ω => leftAct (S.rowMix r) (primal S ω α r) -
                  α • tracker S ω α r := by
            rfl
          rw [hrec]
          exact hleftX.sub (ih.2.1.const_smul α)
        have hnext_le : r + 1 ≤ (r + 1) + 1 := Nat.le_succ _
        have hXnext_lift :
            Measurable[preSamplingHistory S ((r + 1) + 1)]
              (fun ω => primal S ω α (r + 1)) :=
          hXnext.mono (hhist_mono hnext_le) le_rfl
        have hnoise_next :
            Measurable[preSamplingHistory S ((r + 1) + 1)]
              (S.noise (r + 1)) :=
          noise_measurable_preSamplingHistory_of_lt S (Nat.lt_succ_self (r + 1))
        have hGnext :
            Measurable[preSamplingHistory S ((r + 1) + 1)]
              (fun ω => sampledOracle S ω α (r + 1)) := by
          simpa only [sampledOracle] using
            oracleTable_measurable S ((r + 1) + 1) (r + 1)
              (fun ω => primal S ω α (r + 1)) hXnext_lift hnoise_next
        have hY_lift :
            Measurable[preSamplingHistory S ((r + 1) + 1)]
              (fun ω => tracker S ω α r) :=
          ih.2.1.mono (hhist_mono hnext_le) le_rfl
        have hG_lift :
            Measurable[preSamplingHistory S ((r + 1) + 1)]
              (fun ω => sampledOracle S ω α r) :=
          ih.2.2.mono (hhist_mono hnext_le) le_rfl
        have hleftY :
            Measurable[preSamplingHistory S ((r + 1) + 1)]
              (fun ω => leftAct (S.colMix r) (tracker S ω α r)) :=
          leftAct_measurable S ((r + 1) + 1) (S.colMix r)
            (fun ω => tracker S ω α r) hY_lift
        have hYnext :
            Measurable[preSamplingHistory S ((r + 1) + 1)]
              (fun ω => tracker S ω α (r + 1)) := by
          have hrec :
              (fun ω => tracker S ω α (r + 1)) =
                fun ω => leftAct (S.colMix r) (tracker S ω α r) +
                  sampledOracle S ω α (r + 1) -
                  sampledOracle S ω α r := by
            rfl
          rw [hrec]
          exact (hleftY.add hGnext).sub hG_lift
        exact ⟨hXnext, hYnext, hGnext⟩
  exact (hinvariant t).1

@[simp] theorem primal_zero (S : Setup n d Ω) (ω : Ω) (α : ℝ) :
    primal S ω α 0 = fun _ => S.initialPoint := by
  rfl

@[simp] theorem tracker_zero (S : Setup n d Ω) (ω : Ω) (α : ℝ) :
    tracker S ω α 0 = sampledOracle S ω α 0 := by
  rfl

/-- The first defining recurrence of the fixed algorithm. -/
theorem primal_succ (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) :
    primal S ω α (t + 1) =
      leftAct (S.rowMix t) (primal S ω α t) - α • tracker S ω α t := by
  rfl

/-- The second defining recurrence of the fixed algorithm. -/
theorem tracker_succ (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) :
    tracker S ω α (t + 1) =
      leftAct (S.colMix t) (tracker S ω α t) +
        sampledOracle S ω α (t + 1) - sampledOracle S ω α t := by
  rfl

/-- The canonical oracle decomposition at the generated iterate. -/
theorem sampledOracle_eq_gradient_add_noise
    (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) (i : Fin n) :
    sampledOracle S ω α t i =
      gradient (S.localObjective i) (primal S ω α t i) + S.noise t ω i := by
  rfl

/-- Arithmetic node average. Book `#/setup/problem/math`:
“`\bar x_t=\frac1n\mathbf1^\top X_t`”. -/
def arithmeticMean (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) : Point d :=
  (n : ℝ)⁻¹ • ∑ i, primal S ω α t i

/-- The nonnegative stationarity random variable in the paper's output. -/
def stationarityIntegrand (S : Setup n d Ω) (α : ℝ) (t : ℕ) (ω : Ω) : ℝ :=
  ‖gradient (averageObjective S) (arithmeticMean S ω α t)‖ ^ 2

/-- A Lipschitz map, not necessarily fixing zero, preserves `L²` on a finite
measure space.  This is the local closure bridge needed for smooth gradients. -/
theorem memLp_two_comp_lipschitz_local
    {E F : Type*} [NormedAddCommGroup E] [NormedAddCommGroup F]
    {μ : Measure Ω} [IsFiniteMeasure μ]
    (f : E → F) (K : NNReal) (hf : LipschitzWith K f)
    {X : Ω → E} (hX : MemLp X 2 μ) :
    MemLp (fun ω => f (X ω)) 2 μ := by
  have hcentered : LipschitzWith K (fun x => f x - f 0) := by
    intro x y
    simpa only [edist_sub_right] using hf x y
  have hcentered_l2 : MemLp (fun ω => f (X ω) - f 0) 2 μ := by
    simpa only [Function.comp_apply] using
      hcentered.comp_memLp (by simp) hX
  have hsum : MemLp (fun ω => (f (X ω) - f 0) + f 0) 2 μ :=
    hcentered_l2.add (memLp_const (f 0))
  refine MemLp.ae_eq ?_ hsum
  exact Filter.Eventually.of_forall fun ω => by simp

/-- At every finite time, every primal, tracker, and sampled-oracle coordinate
has a finite second moment. -/
theorem generated_process_coordinate_memLp_two
    (S : Setup n d Ω) (α : ℝ) :
    ∀ t,
      (∀ i, MemLp (fun ω => primal S ω α t i) 2 S.probability) ∧
      (∀ i, MemLp (fun ω => tracker S ω α t i) 2 S.probability) ∧
      (∀ i, MemLp (fun ω => sampledOracle S ω α t i) 2 S.probability) := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  have hnoise : ∀ r i,
      MemLp (fun ω => S.noise r ω i) 2 S.probability := by
    intro r i
    exact
      (memLp_two_iff_integrable_sq_norm
        (noise_integrable S r i).aestronglyMeasurable).2
        (noise_norm_sq_integrable S r i)
  have hgradient : ∀ i {X : Ω → Point d},
      MemLp X 2 S.probability →
        MemLp (fun ω => gradient (S.localObjective i) (X ω))
          2 S.probability := by
    intro i X hX
    exact memLp_two_comp_lipschitz_local
      (gradient (S.localObjective i)) ⟨S.L, le_of_lt S.hL⟩
      (S.local_smooth i).2 hX
  intro r
  induction r with
  | zero =>
      have hX0 : ∀ i,
          MemLp (fun ω => primal S ω α 0 i) 2 S.probability := by
        intro i
        simpa only [primal_zero] using
          (memLp_const S.initialPoint :
            MemLp (fun _ : Ω => S.initialPoint) 2 S.probability)
      have hG0 : ∀ i,
          MemLp (fun ω => sampledOracle S ω α 0 i) 2 S.probability := by
        intro i
        have hsum := (hgradient i (hX0 i)).add (hnoise 0 i)
        refine MemLp.ae_eq ?_ hsum
        exact Filter.Eventually.of_forall fun ω =>
          sampledOracle_eq_gradient_add_noise S ω α 0 i
      have hY0 : ∀ i,
          MemLp (fun ω => tracker S ω α 0 i) 2 S.probability := by
        intro i
        refine MemLp.ae_eq ?_ (hG0 i)
        exact Filter.Eventually.of_forall fun ω => congrFun (tracker_zero S ω α) i
      exact ⟨hX0, hY0, hG0⟩
  | succ r ih =>
      have hXnext : ∀ i,
          MemLp (fun ω => primal S ω α (r + 1) i) 2 S.probability := by
        intro i
        have hmix : MemLp
            (fun ω => ∑ j : Fin n, S.rowMix r i j • primal S ω α r j)
            2 S.probability := by
          apply memLp_finset_sum Finset.univ
          intro j _hj
          exact (ih.1 j).const_smul (S.rowMix r i j)
        have hraw := hmix.sub ((ih.2.1 i).const_smul α)
        refine MemLp.ae_eq ?_ hraw
        exact Filter.Eventually.of_forall fun ω =>
          (congrFun (primal_succ S ω α r) i).symm
      have hGnext : ∀ i,
          MemLp (fun ω => sampledOracle S ω α (r + 1) i)
            2 S.probability := by
        intro i
        have hsum := (hgradient i (hXnext i)).add (hnoise (r + 1) i)
        refine MemLp.ae_eq ?_ hsum
        exact Filter.Eventually.of_forall fun ω =>
          sampledOracle_eq_gradient_add_noise S ω α (r + 1) i
      have hYnext : ∀ i,
          MemLp (fun ω => tracker S ω α (r + 1) i) 2 S.probability := by
        intro i
        have hmix : MemLp
            (fun ω => ∑ j : Fin n, S.colMix r i j • tracker S ω α r j)
            2 S.probability := by
          apply memLp_finset_sum Finset.univ
          intro j _hj
          exact (ih.2.1 j).const_smul (S.colMix r i j)
        have hraw := (hmix.add (hGnext i)).sub (ih.2.2 i)
        refine MemLp.ae_eq ?_ hraw
        exact Filter.Eventually.of_forall fun ω =>
          (congrFun (tracker_succ S ω α r) i).symm
      exact ⟨hXnext, hYnext, hGnext⟩

/-- The arithmetic node average inherits the coordinatewise finite second
moments of the generated primal process. -/
theorem arithmeticMean_memLp_two
    (S : Setup n d Ω) (α : ℝ) (t : ℕ) :
    MemLp (fun ω => arithmeticMean S ω α t) 2 S.probability := by
  classical
  have hsum : MemLp
      (fun ω => ∑ i : Fin n, primal S ω α t i) 2 S.probability := by
    apply memLp_finset_sum Finset.univ
    intro i _hi
    exact (generated_process_coordinate_memLp_two S α t).1 i
  simpa only [arithmeticMean] using hsum.const_smul ((n : ℝ)⁻¹)

/-- The average-objective gradient evaluated along the arithmetic mean is in
`L²`; component smoothness is combined only after the process invariant. -/
theorem average_gradient_along_arithmeticMean_memLp_two
    (S : Setup n d Ω) (α : ℝ) (t : ℕ) :
    MemLp
      (fun ω => gradient (averageObjective S) (arithmeticMean S ω α t))
      2 S.probability := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  have hmean := arithmeticMean_memLp_two S α t
  have hcomponent : ∀ i,
      MemLp
        (fun ω => gradient (S.localObjective i) (arithmeticMean S ω α t))
        2 S.probability := by
    intro i
    exact memLp_two_comp_lipschitz_local
      (gradient (S.localObjective i)) ⟨S.L, le_of_lt S.hL⟩
      (S.local_smooth i).2 hmean
  have hsum : MemLp
      (fun ω => ∑ i : Fin n,
        gradient (S.localObjective i) (arithmeticMean S ω α t))
      2 S.probability := by
    apply memLp_finset_sum Finset.univ
    intro i _hi
    exact hcomponent i
  have hraw := hsum.const_smul ((n : ℝ)⁻¹)
  refine MemLp.ae_eq ?_ hraw
  exact Filter.Eventually.of_forall fun ω => by
    have havg := SOptLib.finiteAverageObjective_hasGradientAt
      S.localObjective (fun i x => gradient (S.localObjective i) x)
      (arithmeticMean S ω α t)
      (fun i => ((S.local_smooth i).1 _).hasGradientAt)
    simpa only [averageObjective, Fintype.card_fin] using havg.gradient.symm

/-- Every finite-time stationarity random variable is integrable. This is
derived from smoothness, the finite recursion, and the oracle second-moment
law, rather than added as a theorem-head regularity hypothesis. -/
theorem stationarityIntegrand_integrable
    (S : Setup n d Ω) (α : ℝ) (t : ℕ) :
    Integrable (stationarityIntegrand S α t) S.probability := by
  have hgrad := average_gradient_along_arithmeticMean_memLp_two S α t
  simpa only [stationarityIntegrand] using
    (memLp_two_iff_integrable_sq_norm hgrad.aestronglyMeasurable).1 hgrad

/-- The source output `T⁻¹ ∑_{t<T} E ‖∇f(x̄_t)‖²`. The companion
`stationarityIntegrand_integrable` theorem guarantees that none of these
expectations can take Mathlib's nonintegrable zero fallback.
Book `#/algorithm_spec/output/math`:
“`\mathcal E_T=\frac1T\sum_{t=0}^{T-1}\mathbb E\|\nabla f(\bar x_t)\|^2`”. -/
def stationarityError (S : Setup n d Ω) (α : ℝ) (T : PositiveHorizon) : ℝ :=
  (T.1 : ℝ)⁻¹ * ∑ t ∈ Finset.range T.1,
    SOptLib.expectation S.probability (stationarityIntegrand S α t)

/-! ## Canonical pure-network objects from (2)--(7) -/

/-- Newest-on-the-left product. Book `#/key_lemmas/0/proof/0/description`:
“Define both forward products (with empty products equal to I)”. -/
def forwardProduct (A : ℕ → NetworkMatrix n) (t k : ℕ) : NetworkMatrix n :=
  FiniteNetwork.consecutiveProduct A k (t - k)

/-- Internal characterization of the limit-defined absolute-probability
sequence; it is not an additional source object or assumption. -/
def IsAbsoluteProbabilitySequence (N : NetworkSetup n)
    (π : ℕ → Fin n → ℝ) : Prop :=
  (∀ t i, 0 ≤ π t i) ∧
  (∀ t, ∑ i, π t i = 1) ∧
  (∀ t, π (t + 1) ᵥ* N.rowMix t = π t)

/-- The uniform row `u = 1/n` used in equation (2). Book
`#/key_lemmas/0/proof/0/math`:
“`u=\mathbf1/n`”. -/
def uniformRow (n : ℕ) : Fin n → ℝ :=
  fun _ => (n : ℝ)⁻¹

/-- A later uniform row-product is a probability barycenter of the rows of
the earlier product, so each coordinate stays within the earlier column's
diameter. -/
theorem uniformRow_product_tail_coordinate_le_diameter
    (N : NetworkSetup n) (k j m : ℕ) (i : Fin n) (hjm : j ≤ m) :
    |(uniformRow n ᵥ*
          FiniteNetwork.consecutiveProduct N.rowMix k m) i -
        (uniformRow n ᵥ*
          FiniteNetwork.consecutiveProduct N.rowMix k j) i| ≤
      Metric.diam (Set.range (fun r =>
        FiniteNetwork.consecutiveProduct N.rowMix k j r i)) := by
  classical
  have hu_nonneg : ∀ r : Fin n, 0 ≤ uniformRow n r := by
    intro r
    simp [uniformRow]
  have hu_sum : ∑ r : Fin n, uniformRow n r = 1 := by
    simp [uniformRow, Nat.ne_of_gt N.hn]
  let q : Fin n → ℝ :=
    uniformRow n ᵥ*
      FiniteNetwork.consecutiveProduct N.rowMix (k + j) (m - j)
  have hsuffix :
      FiniteNetwork.consecutiveProduct N.rowMix (k + j) (m - j) ∈
        Matrix.rowStochastic ℝ (Fin n) := by
    apply FiniteNetwork.consecutiveMatrixProduct_mem_rowStochastic
    intro s hs
    exact N.row_stochastic ((k + j) + s)
  have hq_mem : q ∈ stdSimplex ℝ (Fin n) := by
    exact Matrix.vecMul_mem_stdSimplex_of_mem_rowStochastic hsuffix
      ⟨hu_nonneg, hu_sum⟩
  have hsplit :
      FiniteNetwork.consecutiveProduct N.rowMix k m =
        FiniteNetwork.consecutiveProduct N.rowMix (k + j) (m - j) *
          FiniteNetwork.consecutiveProduct N.rowMix k j := by
    conv_lhs => rw [show m = j + (m - j) by omega]
    exact FiniteNetwork.consecutiveProduct_add N.rowMix k j (m - j)
  have hm :
      uniformRow n ᵥ* FiniteNetwork.consecutiveProduct N.rowMix k m =
        q ᵥ* FiniteNetwork.consecutiveProduct N.rowMix k j := by
    change
      uniformRow n ᵥ* FiniteNetwork.consecutiveProduct N.rowMix k m =
        (uniformRow n ᵥ*
            FiniteNetwork.consecutiveProduct N.rowMix (k + j) (m - j)) ᵥ*
          FiniteNetwork.consecutiveProduct N.rowMix k j
    rw [hsplit, Matrix.vecMul_vecMul]
  rw [hm]
  simpa [q, Matrix.vecMul, dotProduct, Real.norm_eq_abs] using
    (FiniteNetwork.norm_sum_smul_sub_sum_smul_le_diam_range
      q (uniformRow n) hq_mem.1 hu_nonneg hq_mem.2 hu_sum
      (fun r => FiniteNetwork.consecutiveProduct N.rowMix k j r i))

/-- Every coordinate of the lag-indexed uniform row-product is Cauchy. -/
theorem uniformRow_vecMul_consecutiveProduct_coordinate_cauchy
    (N : NetworkSetup n) (k : ℕ) (i : Fin n) :
    CauchySeq (fun j =>
      (uniformRow n ᵥ*
        FiniteNetwork.consecutiveProduct N.rowMix k j) i) := by
  classical
  let ell : ℕ := max 1 (n - 1)
  let beta : ℝ := (min N.a 1) ^ ell
  let delta : ℝ := max (1 / 2) (1 - (n : ℝ) * beta)
  let rate : ℝ := Real.rpow delta ((ell : ℝ)⁻¹)
  have hell : 0 < ell := by
    dsimp [ell]
    exact lt_of_lt_of_le Nat.zero_lt_one (le_max_left _ _)
  have hbeta : 0 < beta := by
    dsimp [beta]
    exact pow_pos ((lt_min_iff).2 ⟨N.ha, by norm_num⟩) _
  have hdelta_pos : 0 < delta := by
    dsimp [delta]
    exact lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2)
      (le_max_left _ _)
  have hdelta_lt : delta < 1 := by
    dsimp [delta]
    rw [max_lt_iff]
    constructor
    · norm_num
    · have hnR : (0 : ℝ) < n := Nat.cast_pos.mpr N.hn
      have hprod : 0 < (n : ℝ) * beta := mul_pos hnR hbeta
      linarith
  have hrate_nonneg : 0 ≤ rate := by
    dsimp [rate]
    exact Real.rpow_nonneg hdelta_pos.le _
  have hrate_ell : rate ^ ell = delta := by
    dsimp [rate]
    exact Real.rpow_inv_natCast_pow hdelta_pos.le (Nat.ne_of_gt hell)
  have hrate_lt : rate < 1 := by
    rw [← pow_lt_one_iff_of_nonneg hrate_nonneg (Nat.ne_of_gt hell)]
    simpa [hrate_ell] using hdelta_lt
  have hblock : ∀ (s : ℕ) (r q : Fin n),
      beta ≤ FiniteNetwork.consecutiveProduct N.rowMix s ell r q := by
    intro s r q
    dsimp [beta, ell]
    simpa using
      (FiniteNetwork.consecutiveMatrixProduct_entry_lowerBound_of_stronglyConnected
        N.rowMix (min N.a 1) (le_min N.ha.le (by norm_num)) s
        (fun u _hu r q => Matrix.nonneg_of_mem_rowStochastic
          (i := r) (j := q) (N.row_stochastic (s + u)))
        (fun u _hu => N.row_positive_diagonal (s + u))
        (fun u _hu r q hrq => (min_le_left _ _).trans
          (N.row_weight_floor (s + u) r q (ne_of_gt hrq)))
        (fun u _hu => N.row_strongly_connected (s + u)) r q)
  have hdelta_block :
      1 - (Fintype.card (Fin n) : ℝ) * beta ≤ delta := by
    simpa [delta] using
      (le_max_right (1 / 2 : ℝ) (1 - (n : ℝ) * beta))
  have hgeometric (j : ℕ) :
      Metric.diam (Set.range (fun r =>
          FiniteNetwork.consecutiveProduct N.rowMix k j r i)) ≤
        2 * ((2 * Real.sqrt (Fintype.card (Fin n) : ℝ) / delta) *
          rate ^ j *
          ‖WithLp.toLp 2 (FiniteNetwork.consensusError
            (fun r : Fin n => if r = i then (1 : ℝ) else 0))‖) := by
    have hdiam :=
      FiniteNetwork.statePairwiseDiameter_le_two_mul_consensusError_piLpNorm
        (Matrix.smulVec (FiniteNetwork.consecutiveProduct N.rowMix k j)
          (fun r : Fin n => if r = i then (1 : ℝ) else 0))
    have hmix :=
      FiniteNetwork.consensusError_piLpNorm_consecutiveMatrixProduct_le_geometric_of_blockMinorization
        N.rowMix beta delta rate ell hell hdelta_pos hdelta_lt hrate_nonneg
          hrate_ell hdelta_block N.row_stochastic hblock k j
            (fun r : Fin n => if r = i then (1 : ℝ) else 0)
    calc
      Metric.diam (Set.range (fun r =>
          FiniteNetwork.consecutiveProduct N.rowMix k j r i)) =
          Metric.diam (Set.range
            (Matrix.smulVec (FiniteNetwork.consecutiveProduct N.rowMix k j)
              (fun r : Fin n => if r = i then (1 : ℝ) else 0))) := by
            congr 2
            funext r
            simp [Matrix.smulVec]
      _ ≤ 2 * ‖WithLp.toLp 2 (FiniteNetwork.consensusError
            (Matrix.smulVec (FiniteNetwork.consecutiveProduct N.rowMix k j)
              (fun r : Fin n => if r = i then (1 : ℝ) else 0)))‖ := hdiam
      _ ≤ 2 * ((2 * Real.sqrt (Fintype.card (Fin n) : ℝ) / delta) *
            rate ^ j *
            ‖WithLp.toLp 2 (FiniteNetwork.consensusError
              (fun r : Fin n => if r = i then (1 : ℝ) else 0))‖) :=
        mul_le_mul_of_nonneg_left hmix (by norm_num)
  let K : ℝ :=
    2 * (2 * Real.sqrt (Fintype.card (Fin n) : ℝ) / delta) *
      ‖WithLp.toLp 2 (FiniteNetwork.consensusError
        (fun r : Fin n => if r = i then (1 : ℝ) else 0))‖
  apply cauchySeq_of_le_tendsto_0' (fun j : ℕ => K * rate ^ j)
  · intro j m hjm
    calc
      dist
          ((uniformRow n ᵥ*
            FiniteNetwork.consecutiveProduct N.rowMix k j) i)
          ((uniformRow n ᵥ*
            FiniteNetwork.consecutiveProduct N.rowMix k m) i) =
          |(uniformRow n ᵥ*
              FiniteNetwork.consecutiveProduct N.rowMix k m) i -
            (uniformRow n ᵥ*
              FiniteNetwork.consecutiveProduct N.rowMix k j) i| := by
            rw [Real.dist_eq]
            exact abs_sub_comm _ _
      _ ≤ Metric.diam (Set.range (fun r =>
            FiniteNetwork.consecutiveProduct N.rowMix k j r i)) :=
        uniformRow_product_tail_coordinate_le_diameter N k j m i hjm
      _ ≤ 2 * ((2 * Real.sqrt (Fintype.card (Fin n) : ℝ) / delta) *
            rate ^ j *
            ‖WithLp.toLp 2 (FiniteNetwork.consensusError
              (fun r : Fin n => if r = i then (1 : ℝ) else 0))‖) :=
        hgeometric j
      _ = K * rate ^ j := by
        dsimp [K]
        ring
  · simpa using
      (tendsto_pow_atTop_nhds_zero_of_lt_one hrate_nonneg hrate_lt).const_mul K

/-- Each forward row-product has the limit asserted in equation (2). -/
theorem exists_absoluteProbability_limit (N : NetworkSetup n) (k : ℕ) :
    ∃ π : Fin n → ℝ,
      Filter.Tendsto
        (fun t => uniformRow n ᵥ* forwardProduct N.rowMix t k)
        Filter.atTop (nhds π) := by
  classical
  have hcoordinate : ∀ i : Fin n, ∃ x : ℝ,
      Filter.Tendsto
        (fun j => (uniformRow n ᵥ*
          FiniteNetwork.consecutiveProduct N.rowMix k j) i)
        Filter.atTop (nhds x) := by
    intro i
    exact cauchySeq_tendsto_of_complete
      (uniformRow_vecMul_consecutiveProduct_coordinate_cauchy N k i)
  choose π hπ using hcoordinate
  refine ⟨π, ?_⟩
  rw [tendsto_pi_nhds]
  intro i
  simpa [forwardProduct] using
    (hπ i).comp (Filter.tendsto_sub_atTop_nat k)

/-- The paper's `π_k`, defined directly as the forward-product limit in (2).
Book `#/algorithm_spec/parameters/1/math`:
“`\pi_k^\top=\lim_{t\to\infty}u^\top R(t,k)`”. -/
def absoluteProbability (N : NetworkSetup n) (k : ℕ) : Fin n → ℝ :=
  Classical.choose (exists_absoluteProbability_limit N k)

/-- Explicit equation-(2) bridge: the chosen row is the limit of
`uᵀ R(t,k)`, not merely an abstract recurrent probability sequence. -/
theorem absoluteProbability_tendsto (N : NetworkSetup n) (k : ℕ) :
    Filter.Tendsto
      (fun t => uniformRow n ᵥ* forwardProduct N.rowMix t k)
      Filter.atTop (nhds (absoluteProbability N k)) := by
  exact Classical.choose_spec (exists_absoluteProbability_limit N k)

/-- Adjacent limit rows obey the one-step absolute-probability recurrence. -/
theorem absoluteProbability_step (N : NetworkSetup n) (t : ℕ) :
    absoluteProbability N (t + 1) ᵥ* N.rowMix t =
      absoluteProbability N t := by
  classical
  let approx : ℕ → ℕ → Fin n → ℝ := fun k s =>
    uniformRow n ᵥ* forwardProduct N.rowMix s k
  have heventual :
      (fun s => approx (t + 1) s ᵥ* N.rowMix t) =ᶠ[Filter.atTop]
        fun s => approx t s := by
    filter_upwards [Filter.eventually_ge_atTop (t + 1)] with s hs
    have hlen : s - t = 1 + (s - (t + 1)) := by
      omega
    have hproduct :
        forwardProduct N.rowMix s t =
          forwardProduct N.rowMix s (t + 1) * N.rowMix t := by
      unfold forwardProduct
      rw [hlen, FiniteNetwork.consecutiveProduct_add]
      simp
    dsimp [approx]
    rw [Matrix.vecMul_vecMul, ← hproduct]
  have hleft :
      Filter.Tendsto
        (fun s => approx (t + 1) s ᵥ* N.rowMix t)
        Filter.atTop
        (nhds (absoluteProbability N (t + 1) ᵥ* N.rowMix t)) := by
    rw [tendsto_pi_nhds]
    intro i
    have hcoord := (tendsto_pi_nhds.mp
      (absoluteProbability_tendsto N (t + 1)))
    simpa [approx, Matrix.vecMul, dotProduct] using
      (tendsto_finset_sum Finset.univ (fun r _ =>
        (hcoord r).mul_const (N.rowMix t r i)))
  have hright_from_left :
      Filter.Tendsto (fun s => approx t s) Filter.atTop
        (nhds (absoluteProbability N (t + 1) ᵥ* N.rowMix t)) :=
    hleft.congr' heventual
  have hright :
      Filter.Tendsto (fun s => approx t s) Filter.atTop
        (nhds (absoluteProbability N t)) := by
    simpa [approx] using absoluteProbability_tendsto N t
  exact tendsto_nhds_unique hright_from_left hright

/-- The limit-defined rows satisfy the normalized absolute-probability
recurrence. -/
theorem absoluteProbability_spec (N : NetworkSetup n) :
    IsAbsoluteProbabilitySequence N (absoluteProbability N) := by
  classical
  have hu_nonneg : ∀ i : Fin n, 0 ≤ uniformRow n i := by
    intro i
    simp [uniformRow]
  have hu_sum : ∑ i : Fin n, uniformRow n i = 1 := by
    simp [uniformRow, Nat.ne_of_gt N.hn]
  have hfinite_mem (k s : ℕ) :
      uniformRow n ᵥ* forwardProduct N.rowMix s k ∈
        stdSimplex ℝ (Fin n) := by
    apply Matrix.vecMul_mem_stdSimplex_of_mem_rowStochastic
    · unfold forwardProduct
      apply FiniteNetwork.consecutiveMatrixProduct_mem_rowStochastic
      intro q hq
      exact N.row_stochastic (k + q)
    · exact ⟨hu_nonneg, hu_sum⟩
  refine ⟨?_, ?_, ?_⟩
  · intro t i
    have hcoord :=
      (tendsto_pi_nhds.mp (absoluteProbability_tendsto N t)) i
    exact ge_of_tendsto' hcoord (fun s => (hfinite_mem t s).1 i)
  · intro t
    have hsum_tendsto :
        Filter.Tendsto
          (fun s => ∑ i : Fin n,
            (uniformRow n ᵥ* forwardProduct N.rowMix s t) i)
          Filter.atTop (nhds (∑ i : Fin n, absoluteProbability N t i)) := by
      exact tendsto_finset_sum Finset.univ (fun i _ =>
        (tendsto_pi_nhds.mp (absoluteProbability_tendsto N t)) i)
    have hsum_one :
        Filter.Tendsto
          (fun s => ∑ i : Fin n,
            (uniformRow n ᵥ* forwardProduct N.rowMix s t) i)
          Filter.atTop (nhds (1 : ℝ)) := by
      apply tendsto_const_nhds.congr'
      exact Filter.Eventually.of_forall (fun s => (hfinite_mem t s).2.symm)
    exact tendsto_nhds_unique hsum_tendsto hsum_one
  · exact absoluteProbability_step N

/-- Uniqueness is now a derived characterization of the limit-defined object,
rather than the construction used in place of equation (2). -/
theorem exists_unique_absoluteProbabilitySequence (N : NetworkSetup n) :
    ∃! π : ℕ → Fin n → ℝ, IsAbsoluteProbabilitySequence N π := by
  exact ⟨absoluteProbability N, absoluteProbability_spec N, by
    intro π hπ
    classical
    rcases hπ with ⟨hπ_nonneg, hπ_sum, hπ_rec⟩
    funext k
    let ell : ℕ := max 1 (n - 1)
    let beta : ℝ := (min N.a 1) ^ ell
    let delta : ℝ := max (1 / 2) (1 - (n : ℝ) * beta)
    let rate : ℝ := Real.rpow delta ((ell : ℝ)⁻¹)
    have hell : 0 < ell := by
      dsimp [ell]
      exact lt_of_lt_of_le Nat.zero_lt_one (le_max_left _ _)
    have hbeta : 0 < beta := by
      dsimp [beta]
      exact pow_pos ((lt_min_iff).2 ⟨N.ha, by norm_num⟩) _
    have hdelta_pos : 0 < delta := by
      dsimp [delta]
      exact lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2)
        (le_max_left _ _)
    have hdelta_lt : delta < 1 := by
      dsimp [delta]
      rw [max_lt_iff]
      constructor
      · norm_num
      · have hnR : (0 : ℝ) < n := Nat.cast_pos.mpr N.hn
        have hprod : 0 < (n : ℝ) * beta := mul_pos hnR hbeta
        linarith
    have hrate_nonneg : 0 ≤ rate := by
      dsimp [rate]
      exact Real.rpow_nonneg hdelta_pos.le _
    have hrate_ell : rate ^ ell = delta := by
      dsimp [rate]
      exact Real.rpow_inv_natCast_pow hdelta_pos.le (Nat.ne_of_gt hell)
    have hblock : ∀ (s : ℕ) (i j : Fin n),
        beta ≤ FiniteNetwork.consecutiveProduct N.rowMix s ell i j := by
      intro s i j
      dsimp [beta, ell]
      simpa using
        (FiniteNetwork.consecutiveMatrixProduct_entry_lowerBound_of_stronglyConnected
          N.rowMix (min N.a 1) (le_min N.ha.le (by norm_num)) s
          (fun q _hq i j => Matrix.nonneg_of_mem_rowStochastic
            (i := i) (j := j) (N.row_stochastic (s + q)))
          (fun q _hq => N.row_positive_diagonal (s + q))
          (fun q _hq i j hij => (min_le_left _ _).trans
            (N.row_weight_floor (s + q) i j (ne_of_gt hij)))
          (fun q _hq => N.row_strongly_connected (s + q)) i j)
    have hdelta_block :
        1 - (Fintype.card (Fin n) : ℝ) * beta ≤ delta := by
      simpa [delta] using
        (le_max_right (1 / 2 : ℝ) (1 - (n : ℝ) * beta))
    have hrate_lt : rate < 1 := by
      rw [← pow_lt_one_iff_of_nonneg hrate_nonneg (Nat.ne_of_gt hell)]
      simpa [hrate_ell] using hdelta_lt
    have hback (j : ℕ) :
        π (k + j) ᵥ* FiniteNetwork.consecutiveProduct N.rowMix k j = π k := by
      apply FiniteNetwork.vecMul_consecutiveMatrixProduct_eq_of_step
      intro q hq
      simpa [Nat.add_assoc] using hπ_rec (k + q)
    have hu_nonneg : ∀ i : Fin n, 0 ≤ uniformRow n i := by
      intro i
      simp [uniformRow]
    have hu_sum : ∑ i : Fin n, uniformRow n i = 1 := by
      simp [uniformRow, Nat.ne_of_gt N.hn]
    have hbarycenter (j : ℕ) (i : Fin n) :
        |(uniformRow n ᵥ*
              FiniteNetwork.consecutiveProduct N.rowMix k j) i - π k i| ≤
          Metric.diam (Set.range (fun r =>
            FiniteNetwork.consecutiveProduct N.rowMix k j r i)) := by
      rw [← congrFun (hback j) i]
      simpa [Matrix.vecMul, dotProduct, Real.norm_eq_abs] using
        (FiniteNetwork.norm_sum_smul_sub_sum_smul_le_diam_range
          (uniformRow n) (π (k + j)) hu_nonneg (hπ_nonneg (k + j))
          hu_sum (hπ_sum (k + j))
          (fun r => FiniteNetwork.consecutiveProduct N.rowMix k j r i))
    have hgeometric (j : ℕ) (i : Fin n) :
        Metric.diam (Set.range (fun r =>
            FiniteNetwork.consecutiveProduct N.rowMix k j r i)) ≤
          2 * ((2 * Real.sqrt (Fintype.card (Fin n) : ℝ) / delta) *
            rate ^ j *
            ‖WithLp.toLp 2 (FiniteNetwork.consensusError
              (fun r : Fin n => if r = i then (1 : ℝ) else 0))‖) := by
      have hdiam :=
        FiniteNetwork.statePairwiseDiameter_le_two_mul_consensusError_piLpNorm
          (Matrix.smulVec (FiniteNetwork.consecutiveProduct N.rowMix k j)
            (fun r : Fin n => if r = i then (1 : ℝ) else 0))
      have hmix :=
        FiniteNetwork.consensusError_piLpNorm_consecutiveMatrixProduct_le_geometric_of_blockMinorization
          N.rowMix beta delta rate ell hell hdelta_pos hdelta_lt hrate_nonneg
            hrate_ell hdelta_block N.row_stochastic hblock k j
              (fun r : Fin n => if r = i then (1 : ℝ) else 0)
      calc
        Metric.diam (Set.range (fun r =>
            FiniteNetwork.consecutiveProduct N.rowMix k j r i)) =
            Metric.diam (Set.range
              (Matrix.smulVec (FiniteNetwork.consecutiveProduct N.rowMix k j)
                (fun r : Fin n => if r = i then (1 : ℝ) else 0))) := by
              congr 2
              funext r
              simp [Matrix.smulVec]
        _ ≤ 2 * ‖WithLp.toLp 2 (FiniteNetwork.consensusError
              (Matrix.smulVec (FiniteNetwork.consecutiveProduct N.rowMix k j)
                (fun r : Fin n => if r = i then (1 : ℝ) else 0)))‖ := hdiam
        _ ≤ 2 * ((2 * Real.sqrt (Fintype.card (Fin n) : ℝ) / delta) *
              rate ^ j *
              ‖WithLp.toLp 2 (FiniteNetwork.consensusError
                (fun r : Fin n => if r = i then (1 : ℝ) else 0))‖) :=
          mul_le_mul_of_nonneg_left hmix (by norm_num)
    have hlag (i : Fin n) :
        Filter.Tendsto
          (fun j => (uniformRow n ᵥ*
            FiniteNetwork.consecutiveProduct N.rowMix k j) i)
          Filter.atTop (nhds (π k i)) := by
      rw [tendsto_iff_norm_sub_tendsto_zero]
      let K : ℝ :=
        2 * (2 * Real.sqrt (Fintype.card (Fin n) : ℝ) / delta) *
          ‖WithLp.toLp 2 (FiniteNetwork.consensusError
            (fun r : Fin n => if r = i then (1 : ℝ) else 0))‖
      have herror (j : ℕ) :
          ‖(uniformRow n ᵥ*
              FiniteNetwork.consecutiveProduct N.rowMix k j) i - π k i‖ ≤
            K * rate ^ j := by
        calc
          ‖(uniformRow n ᵥ*
              FiniteNetwork.consecutiveProduct N.rowMix k j) i - π k i‖ =
              |(uniformRow n ᵥ*
                FiniteNetwork.consecutiveProduct N.rowMix k j) i - π k i| :=
            Real.norm_eq_abs _
          _ ≤ Metric.diam (Set.range (fun r =>
              FiniteNetwork.consecutiveProduct N.rowMix k j r i)) :=
            hbarycenter j i
          _ ≤ 2 * ((2 * Real.sqrt (Fintype.card (Fin n) : ℝ) / delta) *
                rate ^ j *
                ‖WithLp.toLp 2 (FiniteNetwork.consensusError
                  (fun r : Fin n => if r = i then (1 : ℝ) else 0))‖) :=
            hgeometric j i
          _ = K * rate ^ j := by
            dsimp [K]
            ring
      exact squeeze_zero (fun _ => norm_nonneg _)
        herror
        (by
          simpa using
            (tendsto_pow_atTop_nhds_zero_of_lt_one hrate_nonneg hrate_lt).const_mul K)
    have hπ_tendsto :
        Filter.Tendsto
          (fun t => uniformRow n ᵥ* forwardProduct N.rowMix t k)
          Filter.atTop (nhds (π k)) := by
      rw [tendsto_pi_nhds]
      intro i
      simpa [forwardProduct] using
        (hlag i).comp (Filter.tendsto_sub_atTop_nat k)
    exact tendsto_nhds_unique hπ_tendsto (absoluteProbability_tendsto N k)⟩

/-- Push mass. Book `#/algorithm_spec/parameters/1/math`:
“`w_0=\mathbf1,\quad w_{t+1}=C_tw_t`”. -/
def pushMass (N : NetworkSetup n) : ℕ → Fin n → ℝ
  | 0 => 1
  | t + 1 => N.colMix t *ᵥ pushMass N t

@[simp] theorem pushMass_zero (N : NetworkSetup n) : pushMass N 0 = 1 := rfl

@[simp] theorem pushMass_succ (N : NetworkSetup n) (t : ℕ) :
    pushMass N (t + 1) = N.colMix t *ᵥ pushMass N t := rfl

/-- Normalized push mass. Book `#/algorithm_spec/parameters/1/math`:
“`v_t=w_t/n`”. -/
def normalizedPushMass (N : NetworkSetup n) (t : ℕ) : Fin n → ℝ :=
  fun i => (n : ℝ)⁻¹ * pushMass N t i

/-- The normalized push mass has unit total mass. -/
theorem normalizedPushMass_sum_eq_one (N : NetworkSetup n) (t : ℕ) :
    ∑ i, normalizedPushMass N t i = 1 := by
  have hneNat : n ≠ 0 := Nat.ne_of_gt N.hn
  have hne : (n : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hneNat
  have hmass : ∀ s : ℕ, ∑ i, pushMass N s i = (n : ℝ) := by
    intro s
    induction s with
    | zero =>
        simp
    | succ s ih =>
        rw [pushMass_succ]
        rw [Matrix.sum_mulVec_of_mem_colStochastic (N.col_stochastic s)]
        exact ih
  simp only [normalizedPushMass, ← Finset.mul_sum]
  rw [hmass t]
  exact inv_mul_cancel₀ hne

/-- Scalar gain. Book `#/algorithm_spec/parameters/1/math`:
“`\kappa_t=\pi_{t+1}^\top w_t`”. -/
def gain (N : NetworkSetup n) (t : ℕ) : ℝ :=
  dotProduct (absoluteProbability N (t + 1)) (pushMass N t)

/-- Uniform gain floor. Book `#/key_lemmas/0/proof/5/description`:
“positivity and conserved mass of w give the gain bounds”. -/
def gainFloor (N : NetworkSetup n) : ℝ := sInf (Set.range (gain N))

/-- Canonical source domain of the influence operator: real node vectors with
zero total mass. -/
abbrev ZeroSumNodeVector (n : ℕ) := FiniteNetwork.ZeroSumState (Fin n) ℝ

/-- The lag-`ℓ` summand in the source series defining `D_t`. Book
`#/algorithm_spec/parameters/2/math`:
“`D_t z=\sum_{\ell\ge0}\pi_{t+\ell+1}^\top C(t+\ell,t)z`”. -/
def influenceSeriesTerm (N : NetworkSetup n) (t ℓ : ℕ)
    (z : ZeroSumNodeVector n) : ℝ :=
  FiniteNetwork.periodicCorrectedLiftSeriesTerm
    N.colMix (absoluteProbability N) t ℓ z

/-- The zero-sum resolvent `D_t` from (4), defined only on its source domain.
The reusable corrected-lift primitive has exactly the same newest-on-the-left
series convention. Book `#/algorithm_spec/parameters/2/math`:
“`D_t z=\sum_{\ell\ge0}\pi_{t+\ell+1}^\top C(t+\ell,t)z`”. -/
def influenceOperator (N : NetworkSetup n) (t : ℕ)
    (z : ZeroSumNodeVector n) : ℝ :=
  FiniteNetwork.periodicCorrectedLift
    (absoluteProbability N)
    (fun s ℓ => FiniteNetwork.consecutiveProduct N.colMix s ℓ) t z

/-- Each column of `C_t-I` lies in the zero-sum domain because `C_t` is
column-stochastic. -/
theorem columnInnovation_sum_zero (N : NetworkSetup n) (t : ℕ) (j : Fin n) :
    ∑ i, (N.colMix t i j - if i = j then 1 else 0) = 0 := by
  classical
  rw [Finset.sum_sub_distrib,
    Matrix.sum_col_of_mem_colStochastic (N.col_stochastic t) j]
  simp

/-- Lean realization of the source input `(C_t-I)e_j` to `D_{t+1}` in
`#/algorithm_spec/parameters/2/math`:
“`b_t^\top=\pi_{t+1}^\top+D_{t+1}(C_t-I)`”. -/
def columnInnovation (N : NetworkSetup n) (t : ℕ) (j : Fin n) :
    ZeroSumNodeVector n :=
  ⟨fun i => N.colMix t i j - if i = j then 1 else 0,
    columnInnovation_sum_zero N t j⟩

/-- Closed-loop influence row. Book `#/algorithm_spec/parameters/2/math`:
“`b_t^\top=\pi_{t+1}^\top+D_{t+1}(C_t-I)`”. -/
def influenceRow (N : NetworkSetup n) (t : ℕ) : Fin n → ℝ :=
  fun j => absoluteProbability N (t + 1) j +
    influenceOperator N (t + 1) (columnInnovation N t j)

/-- Influence energy. Book `#/algorithm_spec/parameters/2/math`:
“`q_t=\|b_t\|_2^2`”. -/
def influenceEnergy (N : NetworkSetup n) (t : ℕ) : ℝ :=
  ∑ i, (influenceRow N t i) ^ 2

/-- Lean realization infrastructure for the Euclidean norm appearing in
`#/key_lemmas/0/statement_math`; this helper introduces no source datum. -/
def nodeL2Norm (x : Fin n → ℝ) : ℝ :=
  Real.sqrt (∑ i, x i ^ 2)

/-- Arithmetic disagreement projection `Πx`. Book
`#/key_lemmas/0/proof/0/math`:
“`\Pi=I-\mathbf1\mathbf1^\top/n`”. -/
def disagreement (x : Fin n → ℝ) : Fin n → ℝ :=
  fun i => x i - (n : ℝ)⁻¹ * ∑ j, x j

/-- Block length `B=max{1,n-1}` used in (3). Book
`#/key_lemmas/0/proof/1/math`:
“`B=\max\{1,n-1\}`”. -/
def mixingBlockLength (n : ℕ) : ℕ := max 1 (n - 1)

/-- Complete-block positivity floor `μ`. Book
`#/key_lemmas/0/proof/1/math`:
“`\mu=\begin{cases}\min\{a,1\}^{n-1},&n>1,\\1,&n=1,\end{cases}`”. -/
def mixingMinorization (N : NetworkSetup n) : ℝ :=
  if 1 < n then min N.a 1 ^ (n - 1) else 1

/-- Complete-block contraction `δ`. Book
`#/key_lemmas/0/proof/1/math`:
“`\delta=\max\{1/2,1-n\mu\}`”. -/
def blockContraction (N : NetworkSetup n) : ℝ :=
  max (1 / 2) (1 - n * mixingMinorization N)

/-- Per-step contraction rate `ρ=δ^(1/B)`. Book
`#/key_lemmas/0/proof/1/math`:
“`\rho=\delta^{1/B}`”. -/
def mixingRate (N : NetworkSetup n) : ℝ :=
  Real.rpow (blockContraction N) ((mixingBlockLength n : ℝ)⁻¹)

theorem sourceMixingRate_nonneg (N : NetworkSetup n) :
    0 ≤ mixingRate N := by
  have hdelta_pos : 0 < blockContraction N := by
    unfold blockContraction
    exact lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) (le_max_left _ _)
  unfold mixingRate
  exact Real.rpow_nonneg hdelta_pos.le _

theorem sourceMixingRate_lt_one (N : NetworkSetup n) :
    mixingRate N < 1 := by
  have hmu : 0 < mixingMinorization N := by
    unfold mixingMinorization
    split_ifs
    · exact pow_pos ((lt_min_iff).2 ⟨N.ha, by norm_num⟩) _
    · norm_num
  have hdelta_pos : 0 < blockContraction N := by
    unfold blockContraction
    exact lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) (le_max_left _ _)
  have hdelta_lt : blockContraction N < 1 := by
    rw [blockContraction, max_lt_iff]
    constructor
    · norm_num
    · have hnR : (0 : ℝ) < n := Nat.cast_pos.mpr N.hn
      have hprod : 0 < (n : ℝ) * mixingMinorization N := mul_pos hnR hmu
      linarith
  have hBnat : 0 < mixingBlockLength n := by
    unfold mixingBlockLength
    exact lt_of_lt_of_le Nat.zero_lt_one (le_max_left _ _)
  have hB : 0 < (mixingBlockLength n : ℝ) := by
    exact_mod_cast hBnat
  have hexp : 0 < ((mixingBlockLength n : ℝ)⁻¹) := inv_pos.mpr hB
  unfold mixingRate
  exact Real.rpow_lt_one hdelta_pos.le hdelta_lt hexp

/-- Column-mixing constant. Book `#/key_lemmas/0/proof/3/math`:
“`M_C=\sqrt n/\delta`”. -/
def columnMixingConstant (N : NetworkSetup n) : ℝ :=
  Real.sqrt n / blockContraction N

/-- Row-mixing constant. Book `#/key_lemmas/0/proof/3/math`:
“`M_R=2\sqrt n/\delta`”. -/
def rowMixingConstant (N : NetworkSetup n) : ℝ :=
  2 * Real.sqrt n / blockContraction N

/-- Uniform influence-operator bound `D_*`. Book
`#/key_lemmas/0/proof/6/math`:
“`D_*=M_C/(1-\rho)`”. -/
def influenceOperatorBound (N : NetworkSetup n) : ℝ :=
  columnMixingConstant N / (1 - mixingRate N)

/-- Shared column-product contraction behind the scalar and Point-valued
corrected lifts.  This packages the source's complete-block minorization,
Dobrushin contraction, and arbitrary-window geometric lifting. -/
theorem colMix_stateL1_geometric
    {E : Type*} [SeminormedAddCommGroup E] [NormedSpace ℝ E]
    (N : NetworkSetup n) (t ℓ : ℕ)
    (z : FiniteNetwork.ZeroSumState (Fin n) E) :
    FiniteNetwork.stateL1Norm
        (Matrix.smulVec (FiniteNetwork.consecutiveProduct N.colMix t ℓ) z.1) ≤
      (blockContraction N)⁻¹ * mixingRate N ^ ℓ *
        FiniteNetwork.stateL1Norm z.1 := by
  classical
  have hBpos : 0 < mixingBlockLength n := by
    unfold mixingBlockLength
    exact lt_of_lt_of_le Nat.zero_lt_one (le_max_left _ _)
  have hmu_pos : 0 < mixingMinorization N := by
    unfold mixingMinorization
    split_ifs with hn
    · exact pow_pos ((lt_min_iff).2 ⟨N.ha, by norm_num⟩) _
    · norm_num
  have hdelta_pos : 0 < blockContraction N := by
    unfold blockContraction
    exact lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) (le_max_left _ _)
  have hdelta_le : blockContraction N ≤ 1 := by
    rw [blockContraction, max_le_iff]
    constructor
    · norm_num
    · have hn_nonneg : (0 : ℝ) ≤ n := by positivity
      have hmu_nonneg : 0 ≤ mixingMinorization N := hmu_pos.le
      nlinarith
  have hrate_nonneg : 0 ≤ mixingRate N := by
    unfold mixingRate
    exact Real.rpow_nonneg hdelta_pos.le _
  have hrate_pow : mixingRate N ^ mixingBlockLength n = blockContraction N := by
    unfold mixingRate
    exact Real.rpow_inv_natCast_pow hdelta_pos.le (Nat.ne_of_gt hBpos)
  have hproduct_col (s k : ℕ) :
      FiniteNetwork.consecutiveProduct N.colMix s k ∈
        Matrix.colStochastic ℝ (Fin n) := by
    induction k with
    | zero => exact (Matrix.colStochastic ℝ (Fin n)).one_mem
    | succ k ih =>
        rw [FiniteNetwork.consecutiveProduct_succ]
        exact (Matrix.colStochastic ℝ (Fin n)).mul_mem
          (N.col_stochastic (s + k)) ih
  have hminor (s : ℕ) (i j : Fin n) :
      mixingMinorization N ≤
        FiniteNetwork.consecutiveProduct N.colMix s (mixingBlockLength n) i j := by
    by_cases hn1 : n = 1
    · subst n
      have hi : i = (0 : Fin 1) := Subsingleton.elim _ _
      have hj : j = (0 : Fin 1) := Subsingleton.elim _ _
      subst i
      subst j
      have hsum := Matrix.sum_col_of_mem_colStochastic
        (hproduct_col s (mixingBlockLength 1)) (0 : Fin 1)
      have heq :
          FiniteNetwork.consecutiveProduct N.colMix s (mixingBlockLength 1)
              (0 : Fin 1) (0 : Fin 1) = 1 := by
        simpa using hsum
      simpa [mixingMinorization] using heq.ge
    · have hnpos : 0 < n := N.hn
      have hn_gt : 1 < n := by omega
      have hmax : max 1 (n - 1) = n - 1 := max_eq_right (by omega)
      unfold mixingMinorization
      rw [if_pos hn_gt]
      simpa [mixingBlockLength, hmax] using
        (FiniteNetwork.consecutiveMatrixProduct_entry_lowerBound_of_stronglyConnected
          N.colMix (min N.a 1) (le_min N.ha.le (by norm_num)) s
          (fun q _hq i j => Matrix.nonneg_of_mem_colStochastic
            (i := i) (j := j) (N.col_stochastic (s + q)))
          (fun q _hq => N.col_positive_diagonal (s + q))
          (fun q _hq i j hij => (min_le_left _ _).trans
            (N.col_weight_floor (s + q) i j (ne_of_gt hij)))
          (fun q _hq => N.col_strongly_connected (s + q)) i j)
  have hblock (s : ℕ) (W : FiniteNetwork.ZeroSumState (Fin n) E) :
      FiniteNetwork.stateL1Norm
          (Matrix.smulVec
            (FiniteNetwork.consecutiveProduct N.colMix s (mixingBlockLength n))
            W.1) ≤
        blockContraction N * FiniteNetwork.stateL1Norm W.1 := by
    have hbase :=
      Matrix.stateL1Norm_smulVec_le_one_sub_card_mul_of_mem_colStochastic_of_minorized
        (hproduct_col s (mixingBlockLength n)) (hminor s) W
    have hcoeff :
        1 - (Fintype.card (Fin n) : ℝ) * mixingMinorization N ≤
          blockContraction N := by
      simpa [blockContraction] using
        (le_max_right (1 / 2 : ℝ)
          (1 - (n : ℝ) * mixingMinorization N))
    exact hbase.trans
      (mul_le_mul_of_nonneg_right hcoeff
        (by
          rw [FiniteNetwork.stateL1Norm_def]
          exact Finset.sum_nonneg fun _ _ => norm_nonneg _))
  exact
    FiniteNetwork.consecutiveMatrixProduct_stateL1Norm_le_geometric_of_block_contraction
      N.colMix (mixingBlockLength n) (blockContraction N) (mixingRate N)
      hBpos hdelta_pos hdelta_le hrate_nonneg hrate_pow N.col_stochastic
      hblock t ℓ z

/-- Uniform coboundary bound `R_*`. Book `#/key_lemmas/0/proof/6/math`:
“`R_*=k_0D_*`”, where the same entry defines `k_0=1+\sqrt n`. -/
def coboundaryBound (N : NetworkSetup n) : ℝ :=
  (1 + Real.sqrt n) * influenceOperatorBound N

/-- Uniform influence-row bound `B_*`. Book
`#/key_lemmas/0/proof/6/math`:
“`B_*=1+k_0D_*`”, where the same entry defines `k_0=1+\sqrt n`. -/
def influenceRowBound (N : NetworkSetup n) : ℝ :=
  1 + (1 + Real.sqrt n) * influenceOperatorBound N

/-- The explicit interval length `ℓ_q` preceding equation (6). Book
`#/key_lemmas/0/proof/9/math`:
“`\ell_q:=\max\{1,\lceil4\sqrt nR_*/g\rceil\}`”. -/
def influenceEnergyWindowThreshold (N : NetworkSetup n) : ℕ :=
  max 1 (Nat.ceil
    (4 * Real.sqrt n * coboundaryBound N / gainFloor N))

/-- Equation (4)'s series is absolutely summable on every zero-sum input. -/
theorem influenceSeries_summable
    (N : NetworkSetup n) (t : ℕ) (z : ZeroSumNodeVector n) :
    Summable (fun ℓ => influenceSeriesTerm N t ℓ z) := by
  apply FiniteNetwork.periodicCorrectedLiftSeries_summable_of_geometric_contraction
    N.colMix (absoluteProbability N) (blockContraction N) (mixingRate N) t z
  · intro ℓ
    rcases absoluteProbability_spec N with ⟨hnonneg, hsum, _hrec⟩
    exact ⟨hnonneg (t + ℓ + 1), hsum (t + ℓ + 1)⟩
  · exact sourceMixingRate_nonneg N
  · exact sourceMixingRate_lt_one N
  · intro ℓ
    exact colMix_stateL1_geometric N t ℓ z

/-- The constructed `D_t` is the sum of the source series, with no reliance on
the nonsummable `tsum` fallback. -/
theorem influenceOperator_hasSum
    (N : NetworkSetup n) (t : ℕ) (z : ZeroSumNodeVector n) :
    HasSum (fun ℓ => influenceSeriesTerm N t ℓ z) (influenceOperator N t z) := by
  simpa [influenceSeriesTerm, influenceOperator,
    FiniteNetwork.periodicCorrectedLift,
    FiniteNetwork.periodicCorrectedLiftSeriesTerm] using
      (influenceSeries_summable N t z).hasSum

/-- Lean realization of column-stochastic transport on the zero-sum subtype;
it is proof infrastructure and introduces no paper object. -/
def advanceZeroSum (N : NetworkSetup n) (t : ℕ) (z : ZeroSumNodeVector n) :
    ZeroSumNodeVector n :=
  ⟨N.colMix t *ᵥ z.1,
    FiniteNetwork.ZeroSumState.smulVec_mem_of_mem_colStochastic z
      (N.col_stochastic t)⟩

/-- The resolvent identity following equation (4), on the exact source
domain. -/
theorem influenceOperator_resolvent
    (N : NetworkSetup n) (t : ℕ) (z : ZeroSumNodeVector n) :
    influenceOperator N t z =
      dotProduct (absoluteProbability N (t + 1)) z.1 +
        influenceOperator N (t + 1) (advanceZeroSum N t z) := by
  have hzero : ∑ i : Fin n, Matrix.smulVec (N.colMix t) z.1 i = 0 :=
    FiniteNetwork.ZeroSumState.smulVec_mem_of_mem_colStochastic z
      (N.col_stochastic t)
  have hseries : Summable (fun ℓ =>
      FiniteNetwork.periodicCorrectedLiftSeriesTerm
        N.colMix (absoluteProbability N) t ℓ z) := by
    simpa [influenceSeriesTerm] using influenceSeries_summable N t z
  simpa [influenceOperator, advanceZeroSum, dotProduct] using
    (FiniteNetwork.periodicCorrectedLift_poisson
      N.colMix (absoluteProbability N) t z hzero hseries)

/-- Uniform operator bound `‖D_t‖ ≤ D_*` from the geometric mixing estimate. -/
theorem influenceOperator_norm_le
    (N : NetworkSetup n) (t : ℕ) (z : ZeroSumNodeVector n) :
    |influenceOperator N t z| ≤ influenceOperatorBound N * nodeL2Norm z.1 := by
  have hpi : ∀ ℓ,
      absoluteProbability N (t + ℓ + 1) ∈ stdSimplex ℝ (Fin n) := by
    intro ℓ
    rcases absoluteProbability_spec N with ⟨hnonneg, hsum, _hrec⟩
    exact ⟨hnonneg (t + ℓ + 1), hsum (t + ℓ + 1)⟩
  have hgeneric :=
    FiniteNetwork.norm_periodicCorrectedLift_le_geometric
      N.colMix (absoluteProbability N) (blockContraction N) (mixingRate N)
      t z hpi (sourceMixingRate_nonneg N) (sourceMixingRate_lt_one N)
      (fun ℓ => colMix_stateL1_geometric N t ℓ z)
  rw [tsum_geometric_of_lt_one (sourceMixingRate_nonneg N)
    (sourceMixingRate_lt_one N)] at hgeneric
  have hL1 : FiniteNetwork.stateL1Norm z.1 ≤
      Real.sqrt n * nodeL2Norm z.1 := by
    simpa [FiniteNetwork.stateL1Norm_def, nodeL2Norm,
      PiLp.norm_eq_of_L2, Real.norm_eq_abs] using
      (sum_norm_le_sqrt_card_mul_dependentProductL2Seminorm z.1)
  have hdelta_pos : 0 < blockContraction N := by
    unfold blockContraction
    exact lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) (le_max_left _ _)
  have hdenom_inv_nonneg : 0 ≤ (1 - mixingRate N)⁻¹ := by
    exact inv_nonneg.mpr (sub_nonneg.mpr (sourceMixingRate_lt_one N).le)
  calc
    |influenceOperator N t z| = ‖influenceOperator N t z‖ := by
      rw [Real.norm_eq_abs]
    _ ≤ ((blockContraction N)⁻¹ * FiniteNetwork.stateL1Norm z.1) *
          (1 - mixingRate N)⁻¹ := by
      simpa [influenceOperator] using hgeneric
    _ ≤ ((blockContraction N)⁻¹ *
          (Real.sqrt n * nodeL2Norm z.1)) * (1 - mixingRate N)⁻¹ :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left hL1 (inv_nonneg.mpr hdelta_pos.le))
        hdenom_inv_nonneg
    _ = influenceOperatorBound N * nodeL2Norm z.1 := by
      unfold influenceOperatorBound columnMixingConstant
      ring

/-- The coordinate input `(I-v_t 1ᵀ)e_i` to the coboundary operator is
zero-sum. -/
theorem coboundaryInput_sum_zero (N : NetworkSetup n) (t : ℕ) (i : Fin n) :
    ∑ j, ((if j = i then 1 else 0) - normalizedPushMass N t j) = 0 := by
  classical
  rw [Finset.sum_sub_distrib, normalizedPushMass_sum_eq_one N t]
  simp

/-- Lean realization of the `i`th column of `I-v_t1ᵀ`; its zero-sum proof is
carried by the subtype and it introduces no source assumption. -/
def coboundaryInput (N : NetworkSetup n) (t : ℕ) (i : Fin n) :
    ZeroSumNodeVector n :=
  ⟨fun j => (if j = i then 1 else 0) - normalizedPushMass N t j,
    coboundaryInput_sum_zero N t i⟩

/-- Coboundary row `r_tᵀ=D_t(I-v_t1ᵀ)` from (5). Book
`#/key_lemmas/0/proof/7/math`:
“`r_t^\top=D_t(I-v_t1^\top)`”. -/
def coboundaryRow (N : NetworkSetup n) (t : ℕ) : Fin n → ℝ :=
  fun i => influenceOperator N t (coboundaryInput N t i)

/-- The source constant `ε=1/16`. Book
`#/algorithm_spec/parameters/5/math`:
“`\epsilon=1/16`”. -/
def epsilon : ℝ := 1 / 16

/-- The source energy scale `A_Δ=LΔ`.
Book `#/algorithm_spec/parameters/4/math`: “`A_\Delta=L\Delta`”. -/
def ADelta (L Δ : ℝ) : ℝ := L * Δ

/-- The dimensionless constant stepsize `s=αL`.
Book `#/algorithm_spec/parameters/5/math`: “`s=\alpha L`”. -/
def dimensionlessStepsize (L α : ℝ) : ℝ := α * L

/-- The exact source domain `0<s≤1/(64n)` used in (7). -/
abbrev AdmissibleDimensionlessStepsize (n : ℕ) :=
  {s : ℝ // 0 < s ∧ s ≤ 1 / (64 * n)}

/-- For `L>0`, the paper's conversion `α=s/L` realizes dimensionless step `s`. -/
theorem dimensionlessStepsize_div (L s : ℝ) (hL : 0 < L) :
    dimensionlessStepsize L (s / L) = s := by
  unfold dimensionlessStepsize
  field_simp

/-- Longest suffix-contained interval satisfying the gain budget. Book
`#/algorithm_spec/parameters/3/math`: “`W_t(s)=\max\{Q-P: ...
s\sum_{r=P}^{Q-1}\kappa_r\le\epsilon\}`”. -/
def windowLength (N : NetworkSetup n) (T t : ℕ) (s : ℝ) : ℕ :=
  if t < T then
    (Finset.Icc t T).sup fun P =>
      (Finset.Icc (P + 1) T).sup fun Q =>
        if s * ∑ r ∈ Finset.Ico P Q, gain N r ≤ epsilon then Q - P else 0
  else 0

/-- Weighted future-window influence sum. Book
`#/algorithm_spec/parameters/3/math`: “`S_T(s)=\sum_{j=0}^{T-1}q_jW_{j+1}(s)`”. -/
def windowInfluenceSum (N : NetworkSetup n) (T : ℕ) (s : ℝ) : ℝ :=
  ∑ j ∈ Finset.range T,
    influenceEnergy N j * windowLength N T (j + 1) s

/-- The explicit network comparator numerator. Book
`#/algorithm_spec/parameters/3/math`: “`{\cal B}_T(s)={L\Delta W_0(s)+(\sigma^2/2)s^2 S_T(s)\over\epsilon T}`”. -/
def comparatorNumerator (N : NetworkSetup n) (L Δ σ : ℝ) (T : PositiveHorizon)
    (s : AdmissibleDimensionlessStepsize n) : ℝ :=
  ADelta L Δ * windowLength N T.1 0 s.1 +
    (σ ^ 2 / 2) * s.1 ^ 2 * windowInfluenceSum N T.1 s.1

def comparatorAt (N : NetworkSetup n) (L Δ σ : ℝ) (T : PositiveHorizon)
    (s : AdmissibleDimensionlessStepsize n) : ℝ :=
  comparatorNumerator N L Δ σ T s / (epsilon * T.1)

/-- `B_T`, the source infimum. Book `#/algorithm_spec/parameters/3/math`:
“`B_T=\inf_{0<s\le1/(64n)}{\cal B}_T(s)`”. -/
def comparator (N : NetworkSetup n) (L Δ σ : ℝ) (T : PositiveHorizon) : ℝ :=
  sInf (Set.range fun s : AdmissibleDimensionlessStepsize n =>
    comparatorAt N L Δ σ T s)

/-- Positive stochastic comparator domain used by equation (58).  Keeping the
positivity certificate in the domain prevents a zero-denominator fallback. -/
abbrev PositiveComparatorHorizon (N : NetworkSetup n) (L Δ σ : ℝ) :=
  {T : PositiveHorizon // 0 < comparator N L Δ σ T}

/-- Effective node count (58), defined from the explicit comparator rather
than from realized optimization error. -/
def effectiveNodeCount (N : NetworkSetup n) (L Δ σ : ℝ)
    (T : PositiveComparatorHorizon N L Δ σ) : ℝ :=
  2 * ADelta L Δ * σ ^ 2 / (T.1.1 * comparator N L Δ σ T.1 ^ 2)

/-! ## Corrected-center objects from equations (9)--(13) -/

/-- The exact local-gradient table `Z_t`. Book
`#/key_lemmas/1/proof/0/description`:
“Let the i-th row of Z_t be the exact local gradient at x_{i,t}”. -/
def gradientTable (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) : NodeTable n d :=
  fun i => gradient (S.localObjective i) (primal S ω α t i)

/-- The historical zero-sum noise tracker `N_t`. Book
`#/key_lemmas/1/proof/0/description`: “separate current oracle noise from its historical
column-stochastic filter”. -/
def filteredNoise (S : Setup n d Ω) (ω : Ω) : ℕ → NodeTable n d
  | 0 => 0
  | t + 1 => leftAct (S.colMix t) (filteredNoise S ω t) +
      leftAct (S.colMix t - 1) (S.noise t ω)

/-- The filtered tracker has zero node sum in every coordinate. -/
theorem filteredNoise_sum_zero (S : Setup n d Ω) (ω : Ω) (t : ℕ) :
    ∑ i, filteredNoise S ω t i = 0 := by
  classical
  induction t with
  | zero =>
      simp [filteredNoise]
  | succ t ih =>
      simp only [filteredNoise, leftAct, Pi.add_apply, Finset.sum_add_distrib]
      rw [Matrix.sum_smulVec_of_mem_colStochastic _ (S.col_stochastic t),
        Matrix.sum_sub_one_smulVec_eq_zero_of_mem_colStochastic _ (S.col_stochastic t),
        ih, add_zero]

/-- Lean subtype realization of `N_t` in the exact zero-sum domain required
by `D_t`; it adds a proved invariant, not a source assumption. -/
def filteredNoiseZeroSum (S : Setup n d Ω) (ω : Ω) (t : ℕ) :
    FiniteNetwork.ZeroSumState (Fin n) (Point d) :=
  ⟨filteredNoise S ω t, filteredNoise_sum_zero S ω t⟩

/-- Module-valued extension of the source resolvent. Book
`#/algorithm_spec/parameters/2/math`:
“`D_t z=\sum_{\ell\ge0}\pi_{t+\ell+1}^\top C(t+\ell,t)z`”. -/
def influenceOperatorPoint (N : NetworkSetup n) (t : ℕ)
    (z : FiniteNetwork.ZeroSumState (Fin n) (Point d)) : Point d :=
  FiniteNetwork.periodicCorrectedLift
    (absoluteProbability N)
    (fun s ℓ => FiniteNetwork.consecutiveProduct N.colMix s ℓ) t z

/-- The Point-valued summand in the absolutely convergent series defining
`D_t`. Book `#/algorithm_spec/parameters/2/math`:
“`D_t z=\sum_{\ell\ge0}\pi_{t+\ell+1}^\top C(t+\ell,t)z`”. -/
def influenceSeriesTermPoint (N : NetworkSetup n) (t ℓ : ℕ)
    (z : FiniteNetwork.ZeroSumState (Fin n) (Point d)) : Point d :=
  FiniteNetwork.periodicCorrectedLiftSeriesTerm
    N.colMix (absoluteProbability N) t ℓ z

/-- The limit-defined absolute-probability rows are simplex weights, as
required by the generic corrected-lift summability theorem. -/
theorem absoluteProbability_mem_stdSimplex (N : NetworkSetup n) (t : ℕ) :
    absoluteProbability N t ∈ stdSimplex ℝ (Fin n) := by
  rcases absoluteProbability_spec N with ⟨hnonneg, hmass, _hrec⟩
  exact ⟨hnonneg t, hmass t⟩

/-- The complete-block factor used in the source mixing proof is positive. -/
theorem blockContraction_pos (N : NetworkSetup n) :
    0 < blockContraction N := by
  unfold blockContraction
  exact lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) (le_max_left _ _)

/-- The per-step source contraction rate is nonnegative. -/
theorem mixingRate_nonneg (N : NetworkSetup n) :
    0 ≤ mixingRate N := by
  unfold mixingRate
  exact Real.rpow_nonneg (blockContraction_pos N).le _

/-- The per-step source contraction rate is strictly below one. -/
theorem mixingRate_lt_one (N : NetworkSetup n) :
    mixingRate N < 1 := by
  have hmu : 0 < mixingMinorization N := by
    unfold mixingMinorization
    split_ifs
    · exact pow_pos ((lt_min_iff).2 ⟨N.ha, by norm_num⟩) _
    · norm_num
  have hdelta_lt : blockContraction N < 1 := by
    rw [blockContraction, max_lt_iff]
    constructor
    · norm_num
    · have hnR : (0 : ℝ) < n := Nat.cast_pos.mpr N.hn
      have hprod : 0 < (n : ℝ) * mixingMinorization N := mul_pos hnR hmu
      linarith
  have hBnat : 0 < mixingBlockLength n := by
    unfold mixingBlockLength
    exact lt_of_lt_of_le Nat.zero_lt_one (le_max_left _ _)
  have hB : 0 < (mixingBlockLength n : ℝ) := by
    exact_mod_cast hBnat
  have hexp : 0 < ((mixingBlockLength n : ℝ)⁻¹) := inv_pos.mpr hB
  unfold mixingRate
  exact Real.rpow_lt_one (blockContraction_pos N).le hdelta_lt hexp

/-- Specialization of the source complete-block contraction to arbitrary
module-valued zero-sum states.  This is the exact hypothesis consumed by
`FiniteNetwork.periodicCorrectedLiftSeries_summable_of_geometric_contraction`. -/
theorem point_colMix_stateL1_geometric
    (N : NetworkSetup n) (t ℓ : ℕ)
    (z : FiniteNetwork.ZeroSumState (Fin n) (Point d)) :
    FiniteNetwork.stateL1Norm
        (Matrix.smulVec (FiniteNetwork.consecutiveProduct N.colMix t ℓ) z.1) ≤
      (blockContraction N)⁻¹ * mixingRate N ^ ℓ *
        FiniteNetwork.stateL1Norm z.1 := by
  exact colMix_stateL1_geometric N t ℓ z

/-- Equation (4)'s Point-valued corrected-lift series is summable for every
source-legal dimension and every zero-sum input.  The proof explicitly
specializes the checked generic SOptLib theorem; it is not a scalar-only or
unconditional bridge. -/
theorem influenceOperatorPoint_summable
    (N : NetworkSetup n) (t : ℕ)
    (z : FiniteNetwork.ZeroSumState (Fin n) (Point d)) :
    Summable (fun ℓ => influenceSeriesTermPoint N t ℓ z) := by
  apply FiniteNetwork.periodicCorrectedLiftSeries_summable_of_geometric_contraction
    N.colMix (absoluteProbability N) (blockContraction N) (mixingRate N) t z
  · intro ℓ
    exact absoluteProbability_mem_stdSimplex N (t + ℓ + 1)
  · exact mixingRate_nonneg N
  · exact mixingRate_lt_one N
  · intro ℓ
    exact point_colMix_stateL1_geometric N t ℓ z

/-- `influenceOperatorPoint` is the certified sum of its Point-valued source
series, excluding Mathlib's nonsummable-`tsum` fallback. -/
theorem influenceOperatorPoint_hasSum
    (N : NetworkSetup n) (t : ℕ)
    (z : FiniteNetwork.ZeroSumState (Fin n) (Point d)) :
    HasSum (fun ℓ => influenceSeriesTermPoint N t ℓ z)
      (influenceOperatorPoint N t z) := by
  simpa [influenceSeriesTermPoint, influenceOperatorPoint,
    FiniteNetwork.periodicCorrectedLift,
    FiniteNetwork.periodicCorrectedLiftSeriesTerm] using
      (influenceOperatorPoint_summable N t z).hasSum

/-- Point-valued form of the uniform corrected-lift operator bound. -/
theorem influenceOperatorPoint_norm_le
    (N : NetworkSetup n) (t : ℕ)
    (z : FiniteNetwork.ZeroSumState (Fin n) (Point d)) :
    ‖influenceOperatorPoint N t z‖ ≤
      influenceOperatorBound N * Real.sqrt (∑ i, ‖z.1 i‖ ^ 2) := by
  have hgeneric :=
    FiniteNetwork.norm_periodicCorrectedLift_le_geometric
      N.colMix (absoluteProbability N) (blockContraction N) (mixingRate N)
      t z (fun ell => absoluteProbability_mem_stdSimplex N (t + ell + 1))
      (mixingRate_nonneg N) (mixingRate_lt_one N)
      (fun ell => point_colMix_stateL1_geometric N t ell z)
  rw [tsum_geometric_of_lt_one (mixingRate_nonneg N)
    (mixingRate_lt_one N)] at hgeneric
  have hL1 : FiniteNetwork.stateL1Norm z.1 ≤
      Real.sqrt n * Real.sqrt (∑ i, ‖z.1 i‖ ^ 2) := by
    simpa [FiniteNetwork.stateL1Norm_def, PiLp.norm_eq_of_L2,
      SOptLib.dependentProductNormSq_def] using
      (sum_norm_le_sqrt_card_mul_dependentProductL2Seminorm z.1)
  have hdelta_pos : 0 < blockContraction N := blockContraction_pos N
  have hdenom_inv_nonneg : 0 ≤ (1 - mixingRate N)⁻¹ :=
    inv_nonneg.mpr (sub_nonneg.mpr (mixingRate_lt_one N).le)
  calc
    ‖influenceOperatorPoint N t z‖ ≤
        ((blockContraction N)⁻¹ * FiniteNetwork.stateL1Norm z.1) *
          (1 - mixingRate N)⁻¹ := by
      simpa [influenceOperatorPoint] using hgeneric
    _ ≤ ((blockContraction N)⁻¹ *
          (Real.sqrt n * Real.sqrt (∑ i, ‖z.1 i‖ ^ 2))) *
            (1 - mixingRate N)⁻¹ :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left hL1 (inv_nonneg.mpr hdelta_pos.le))
        hdenom_inv_nonneg
    _ = influenceOperatorBound N * Real.sqrt (∑ i, ‖z.1 i‖ ^ 2) := by
      unfold influenceOperatorBound columnMixingConstant
      ring

/-- A Point-valued zero-sum state remains zero-sum after taking any scalar
coordinate. -/
theorem pointCoordinate_sum_zero
    (z : FiniteNetwork.ZeroSumState (Fin n) (Point d)) (k : Fin d) :
    ∑ i, z.1 i k = 0 := by
  let eval : Point d →+ ℝ :=
    { toFun := fun x => x k
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  calc
    ∑ i, z.1 i k = ∑ i, eval (z.1 i) := rfl
    _ = eval (∑ i, z.1 i) :=
      (map_sum eval (fun i => z.1 i) Finset.univ).symm
    _ = eval 0 := congrArg eval z.property
    _ = 0 := eval.map_zero

/-- Lean coordinate projection of a Point-valued zero-sum state; this is
realization infrastructure rather than a separate paper object. -/
def pointCoordinateZeroSum
    (z : FiniteNetwork.ZeroSumState (Fin n) (Point d)) (k : Fin d) :
    ZeroSumNodeVector n :=
  ⟨fun i => z.1 i k, pointCoordinate_sum_zero z k⟩

/-- Coordinatewise correspondence between the certified Point-valued
realization of `D_t` and the scalar source operator. -/
theorem influenceOperatorPoint_coordinate
    (N : NetworkSetup n) (t : ℕ)
    (z : FiniteNetwork.ZeroSumState (Fin n) (Point d)) (k : Fin d) :
    influenceOperatorPoint N t z k =
      influenceOperator N t (pointCoordinateZeroSum z k) := by
  have hterm : ∀ ℓ,
      influenceSeriesTermPoint N t ℓ z k =
        influenceSeriesTerm N t ℓ (pointCoordinateZeroSum z k) := by
    intro ℓ
    simp [influenceSeriesTermPoint, influenceSeriesTerm,
      pointCoordinateZeroSum, FiniteNetwork.periodicCorrectedLiftSeriesTerm,
      Matrix.smulVec]
  have hmapped :=
    (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin d => ℝ) k).hasSum
      (influenceOperatorPoint_hasSum N t z)
  change HasSum (fun ℓ => influenceSeriesTermPoint N t ℓ z k)
    (influenceOperatorPoint N t z k) at hmapped
  have hscalar :
      HasSum (fun ℓ => influenceSeriesTerm N t ℓ (pointCoordinateZeroSum z k))
        (influenceOperatorPoint N t z k) := by
    simpa only [hterm] using hmapped
  exact hscalar.unique
    (influenceOperator_hasSum N t (pointCoordinateZeroSum z k))

/-- Point-valued specialization of the corrected-lift Poisson equation. -/
theorem influenceOperatorPoint_resolvent
    (N : NetworkSetup n) (t : ℕ)
    (z : FiniteNetwork.ZeroSumState (Fin n) (Point d)) :
    influenceOperatorPoint N t z =
      (∑ i, (absoluteProbability N (t + 1) i) • z.1 i) +
        influenceOperatorPoint N (t + 1)
          ⟨Matrix.smulVec (N.colMix t) z.1,
            FiniteNetwork.ZeroSumState.smulVec_mem_of_mem_colStochastic z
              (N.col_stochastic t)⟩ := by
  have hzero :
      ∑ i : Fin n, Matrix.smulVec (N.colMix t) z.1 i = 0 :=
    FiniteNetwork.ZeroSumState.smulVec_mem_of_mem_colStochastic z
      (N.col_stochastic t)
  have hseries : Summable (fun ℓ =>
      FiniteNetwork.periodicCorrectedLiftSeriesTerm
        N.colMix (absoluteProbability N) t ℓ z) := by
    simpa [influenceSeriesTermPoint] using
      influenceOperatorPoint_summable N t z
  simpa [influenceOperatorPoint] using
    (FiniteNetwork.periodicCorrectedLift_poisson
      N.colMix (absoluteProbability N) t z hzero hseries)

/-- The Point-valued corrected lift is additive on its zero-sum carrier. -/
theorem influenceOperatorPoint_add
    (N : NetworkSetup n) (t : ℕ)
    (W V : FiniteNetwork.ZeroSumState (Fin n) (Point d)) :
    influenceOperatorPoint N t (W + V) =
      influenceOperatorPoint N t W + influenceOperatorPoint N t V := by
  have hsum : Summable (fun ℓ =>
      FiniteNetwork.periodicCorrectedLiftSeriesTerm
        N.colMix (absoluteProbability N) t ℓ (W + V)) := by
    simpa [influenceSeriesTermPoint] using
      influenceOperatorPoint_summable N t (W + V)
  have hV : Summable (fun ℓ =>
      FiniteNetwork.periodicCorrectedLiftSeriesTerm
        N.colMix (absoluteProbability N) t ℓ V) := by
    simpa [influenceSeriesTermPoint] using
      influenceOperatorPoint_summable N t V
  have hsub := FiniteNetwork.periodicCorrectedLift_sub
    N.colMix (absoluteProbability N) t (W + V) V hsum hV
  have hleft :
      (⟨(W + V).1 - V.1, by
        change ∑ i, ((W + V).1 i - V.1 i) = 0
        rw [Finset.sum_sub_distrib, (W + V).2, V.2, sub_self]⟩ :
          FiniteNetwork.ZeroSumState (Fin n) (Point d)) = W := by
    apply Subtype.ext
    simp
  rw [hleft] at hsub
  simpa [influenceOperatorPoint] using (eq_add_of_sub_eq hsub.symm)

/-- The row-valued influence tail lies in the convergent branch of `tsum`. -/
theorem periodicInfluenceSeries_summable
    (N : NetworkSetup n) (t : ℕ) :
    Summable (fun ℓ => FiniteNetwork.periodicInfluenceSeriesTerm
      N.colMix (absoluteProbability N) t ℓ) := by
  apply FiniteNetwork.periodicInfluenceSeries_summable_of_geometric_contraction
    N.colMix (absoluteProbability N) (blockContraction N) (mixingRate N) t
  · intro i
    exact Matrix.sum_col_of_mem_colStochastic (N.col_stochastic t) i
  · intro ℓ
    simpa only [Nat.add_assoc] using
      absoluteProbability_mem_stdSimplex N (t + ℓ + 2)
  · exact mixingRate_nonneg N
  · exact mixingRate_lt_one N
  · intro ℓ z
    exact colMix_stateL1_geometric N (t + 1) ℓ z

/-- The paper-facing influence row is the reusable full response row. -/
theorem influenceRow_eq_periodicInfluence
    (N : NetworkSetup n) (t : ℕ) :
    influenceRow N t =
      FiniteNetwork.periodicInfluence N.colMix (absoluteProbability N) t := by
  funext i
  have hcolumn : ∑ k : Fin n, N.colMix t k i = 1 :=
    Matrix.sum_col_of_mem_colStochastic (N.col_stochastic t) i
  have hresponse :=
    FiniteNetwork.periodicInfluence_apply_eq_perron_add_correctedLift_normalizedColumnError
      N.colMix (absoluteProbability N) t i
      (periodicInfluenceSeries_summable N t) hcolumn
  simpa [influenceRow, influenceOperator, columnInnovation,
    FiniteNetwork.normalizedCoordinateError] using hresponse.symm

/-- The corrected center. Book `#/key_lemmas/1/proof/0/math`:
“`z_t=\pi_t^\top X_t-\alpha D_tN_t`”. -/
def correctedCenter (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) : Point d :=
  (∑ i, (absoluteProbability S.network t i) • primal S ω α t i) -
    α • influenceOperatorPoint S.network t (filteredNoiseZeroSum S ω t)

/-- The current-noise-free tracker. Book `#/key_lemmas/1/proof/0/math`:
“`Y_t^Z=Y_t-\varepsilon_t-N_t`”. -/
def correctedTracker (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) : NodeTable n d :=
  tracker S ω α t - S.noise t ω - filteredNoise S ω t

/-- The corrected tracker disagreement. Book `#/key_lemmas/1/proof/0/math`:
“`H_t^Z=Y_t^Z-v_t1^\top Z_t`”. -/
def correctedTrackerDisagreement
    (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) : NodeTable n d :=
  fun i => correctedTracker S ω α t i -
    (normalizedPushMass S.network t i) • (∑ j, gradientTable S ω α t j)

/-- The predictable drift `η_t`. Book `#/key_lemmas/1/proof/1/math`:
“`\eta_t=\kappa_t\{u^\top Z_t-\nabla f(z_t)\}+\pi_{t+1}^\top H_t^Z`”. -/
def correctedDrift (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) : Point d :=
  (gain S.network t) •
      ((n : ℝ)⁻¹ • (∑ i, gradientTable S ω α t i) -
        gradient (averageObjective S) (correctedCenter S ω α t)) +
    ∑ i, (absoluteProbability S.network (t + 1) i) •
      correctedTrackerDisagreement S ω α t i

/-- Lean realization infrastructure for the Frobenius-square notation in the
source energy displays; it introduces no paper datum. -/
def nodeTableNormSq (X : NodeTable n d) : ℝ := ∑ i, ‖X i‖ ^ 2

/-- Corrected-gradient energy `G`. Book `#/key_lemmas/1/proof/4/math`:
“`G=\sum_{t<T}{\mathbb E}\|\nabla f(z_t)\|^2`”. -/
def correctedGradientEnergy (S : Setup n d Ω) (α : ℝ) (T : PositiveHorizon) : ℝ :=
  ∑ t ∈ Finset.range T.1, SOptLib.expectation S.probability
    (fun ω => ‖gradient (averageObjective S) (correctedCenter S ω α t)‖ ^ 2)

/-- Drift energy `V`. Book `#/key_lemmas/1/proof/4/math`:
“`V=\sum_{t<T}{\mathbb E}\|\eta_t\|^2`”. -/
def correctedDriftEnergy (S : Setup n d Ω) (α : ℝ) (T : PositiveHorizon) : ℝ :=
  ∑ t ∈ Finset.range T.1, SOptLib.expectation S.probability
    (fun ω => ‖correctedDrift S ω α t‖ ^ 2)

/-- Corrected-center offset energy `J`. Book
`#/key_lemmas/1/proof/4/math`:
“`J=\sum_{t<T}{\mathbb E}\|z_t-\bar x_t\|^2`”. -/
def correctedCenterOffsetEnergy
    (S : Setup n d Ω) (α : ℝ) (T : PositiveHorizon) : ℝ :=
  ∑ t ∈ Finset.range T.1, SOptLib.expectation S.probability
    (fun ω => ‖correctedCenter S ω α t - arithmeticMean S ω α t‖ ^ 2)

/-- Tracker energy `M_Y`. Book `#/key_lemmas/1/proof/4/math`:
“`M_Y=\sum_{t<T}{\mathbb E}\|Y_t\|_F^2`”. -/
def trackerEnergy (S : Setup n d Ω) (α : ℝ) (T : PositiveHorizon) : ℝ :=
  ∑ t ∈ Finset.range T.1, SOptLib.expectation S.probability
    (fun ω => nodeTableNormSq (tracker S ω α t))

/-- Coefficient `K_R`. Book `#/key_lemmas/1/proof/3/math`:
“`K_R=M_R^2/(1-\rho)^2`”. -/
def disagreementKernel (N : NetworkSetup n) : ℝ :=
  rowMixingConstant N ^ 2 / (1 - mixingRate N) ^ 2
/-- Coefficient `K_D`. Book `#/key_lemmas/1/proof/3/math`:
“`K_D=2+2k_0^2K_R`”. -/
def incrementKernel (N : NetworkSetup n) : ℝ :=
  2 + 2 * (1 + Real.sqrt n) ^ 2 * disagreementKernel N
/-- Coefficient `A_0`. Book `#/key_lemmas/1/proof/3/math`:
“`A_0=2M_C^2/(1-\rho^2)`”. -/
def trackerInitialKernel (N : NetworkSetup n) : ℝ :=
  2 * columnMixingConstant N ^ 2 / (1 - mixingRate N ^ 2)
/-- Coefficient `A_1`. Book `#/key_lemmas/1/proof/3/math`:
“`A_1=2M_C^2k_0^2K_D/(1-\rho)^2`”. -/
def trackerIncrementKernel (N : NetworkSetup n) : ℝ :=
  2 * columnMixingConstant N ^ 2 * (1 + Real.sqrt n) ^ 2 *
    incrementKernel N / (1 - mixingRate N) ^ 2
/-- Coefficient `B_E`. Book `#/key_lemmas/1/proof/3/math`:
“`B_E=nM_C^2k_0^2/(1-\rho^2)`”. -/
def filteredNoiseKernel (N : NetworkSetup n) : ℝ :=
  n * columnMixingConstant N ^ 2 * (1 + Real.sqrt n) ^ 2 /
    (1 - mixingRate N ^ 2)
/-- Coefficient `B_Y`. Book `#/key_lemmas/1/proof/3/math`:
“`B_Y=2n+2B_E`”. -/
def currentNoiseKernel (N : NetworkSetup n) : ℝ := 2 * n + 2 * filteredNoiseKernel N
/-- Coefficient `K_a`. Book `#/key_lemmas/1/proof/3/math`:
“`K_a=(3n+6n^2)K_R+3A_1`”. -/
def controlKa (N : NetworkSetup n) : ℝ :=
  (3 * n + 6 * n ^ 2) * disagreementKernel N + 3 * trackerIncrementKernel N
/-- Coefficient `K_b`. Book `#/key_lemmas/1/proof/3/math`:
“`K_b=6n^2D_*^2B_E`”. -/
def controlKb (N : NetworkSetup n) : ℝ :=
  6 * n ^ 2 * influenceOperatorBound N ^ 2 * filteredNoiseKernel N
/-- Coefficient `m_B`. Book `#/key_lemmas/1/proof/3/math`:
“`m_B=48n^2`”. -/
def controlMB (n : ℕ) : ℝ := 48 * n ^ 2
/-- Coefficient `m_H`. Book `#/key_lemmas/1/proof/3/math`:
“`m_H=12A_0`”. -/
def controlMH (N : NetworkSetup n) : ℝ := 12 * trackerInitialKernel N
/-- Coefficient `m_N`. Book `#/key_lemmas/1/proof/3/math`:
“`m_N=12B_Y+96n^2D_*^2B_E`”. -/
def controlMN (N : NetworkSetup n) : ℝ :=
  12 * currentNoiseKernel N +
    96 * n ^ 2 * influenceOperatorBound N ^ 2 * filteredNoiseKernel N
/-- Coefficient `j_B`. Book `#/key_lemmas/1/proof/3/math`:
“`j_B=2K_Rm_B`”. -/
def controlJB (N : NetworkSetup n) : ℝ := 2 * disagreementKernel N * controlMB n
/-- Coefficient `j_H`. Book `#/key_lemmas/1/proof/3/math`:
“`j_H=2K_Rm_H`”. -/
def controlJH (N : NetworkSetup n) : ℝ := 2 * disagreementKernel N * controlMH N
/-- Coefficient `j_N`. Book `#/key_lemmas/1/proof/3/math`:
“`j_N=2(K_Rm_N+D_*^2B_E)`”. -/
def controlJN (N : NetworkSetup n) : ℝ :=
  2 * (disagreementKernel N * controlMN N +
    influenceOperatorBound N ^ 2 * filteredNoiseKernel N)
/-- Coefficient `r_H`. Book `#/key_lemmas/1/proof/3/math`:
“`r_H=3A_0+K_am_H`”. -/
def controlRH (N : NetworkSetup n) : ℝ :=
  3 * trackerInitialKernel N + controlKa N * controlMH N
/-- Coefficient `r_B`. Book `#/key_lemmas/1/proof/3/math`:
“`r_B=K_am_B`”. -/
def controlRB (N : NetworkSetup n) : ℝ := controlKa N * controlMB n
/-- Coefficient `r_N`. Book `#/key_lemmas/1/proof/3/math`:
“`r_N=K_am_N+K_b`”. -/
def controlRN (N : NetworkSetup n) : ℝ := controlKa N * controlMN N + controlKb N

/-- Source cap `x_*`. Book `#/key_lemmas/1/proof/3/math`:
“`x_*=\min\left\{1,{1\over4n},{1\over\sqrt{2(6nK_R+3A_1)}},
{1\over\sqrt{96n^2K_R}},{g\over\sqrt{8r_B}}\right\}`”. -/
def correctedCenterStepCap (N : NetworkSetup n) : ℝ :=
  min 1 (min (1 / (4 * n))
    (min (1 / Real.sqrt (2 * (6 * n * disagreementKernel N +
      3 * trackerIncrementKernel N)))
      (min (1 / Real.sqrt (96 * n ^ 2 * disagreementKernel N))
        (gainFloor N / Real.sqrt (8 * controlRB N)))))

/-- Equation-(13) upper expression `U`. Book
`#/key_lemmas/1/proof/15/math`:
“`G\le U:={4\Delta\over\alpha g}+{8r_HnH^2\over g^2}+
{8r_Ns^2\sigma^2T\over g^2}+{2L\alpha\sigma^2\over g}\sum_{t<T}q_t`”. -/
def correctedGradientUpperBound
    (S : Setup n d Ω) (α : ℝ) (T : PositiveHorizon) : ℝ :=
  4 * S.Δ / (α * gainFloor S.network) +
    8 * controlRH S.network * n * S.H ^ 2 / gainFloor S.network ^ 2 +
    8 * controlRN S.network * dimensionlessStepsize S.L α ^ 2 * S.σ ^ 2 * T.1 /
      gainFloor S.network ^ 2 +
    2 * S.L * α * S.σ ^ 2 / gainFloor S.network *
      (∑ t ∈ Finset.range T.1, influenceEnergy S.network t)

/-! ## Source guarantees registered as proof obligations

The following statements use only constructed objects and source assumptions.
Their proofs belong to Phase 2.
-/

/-- The innovation `b_tᵀε_t` in equation (9). Book
`#/key_lemmas/1/proof/2/math`:
“`{\mathbb E}[b_t^\top\varepsilon_t\mid{\cal F}_{t^-}]=0`”. -/
def influenceNoise (S : Setup n d Ω) (ω : Ω) (t : ℕ) : Point d :=
  ∑ i, (influenceRow S.network t i) • S.noise t ω i

/-- The innovation row action is the Perron average plus the corrected lift
of the one-step column innovation. -/
theorem influenceNoise_response
    (S : Setup n d Ω) (ω : Ω) (t : ℕ) :
    influenceNoise S ω t =
      (∑ i, (absoluteProbability S.network (t + 1) i) • S.noise t ω i) +
        influenceOperatorPoint S.network (t + 1)
          ⟨Matrix.smulVec (S.colMix t - 1) (S.noise t ω),
            Matrix.sum_sub_one_smulVec_eq_zero_of_mem_colStochastic
              (S.noise t ω) (S.col_stochastic t)⟩ := by
  classical
  have hresponse :=
    FiniteNetwork.periodicInfluence_weightedState_eq_perron_add_correctedLift
      S.colMix (absoluteProbability S.network) t (S.noise t ω)
      (periodicInfluenceSeries_summable S.network t)
      (Matrix.sum_sub_one_smulVec_eq_zero_of_mem_colStochastic
        (S.noise t ω) (S.col_stochastic t))
  simpa [influenceNoise, influenceOperatorPoint,
    influenceRow_eq_periodicInfluence] using hresponse

/-- The zero-sum historical filter splits into transported history and the
current column innovation. -/
theorem filteredNoiseZeroSum_succ
    (S : Setup n d Ω) (ω : Ω) (t : ℕ) :
    filteredNoiseZeroSum S ω (t + 1) =
      (⟨Matrix.smulVec (S.colMix t) (filteredNoise S ω t),
          FiniteNetwork.ZeroSumState.smulVec_mem_of_mem_colStochastic
            (filteredNoiseZeroSum S ω t) (S.col_stochastic t)⟩ :
        FiniteNetwork.ZeroSumState (Fin n) (Point d)) +
      ⟨Matrix.smulVec (S.colMix t - 1) (S.noise t ω),
        Matrix.sum_sub_one_smulVec_eq_zero_of_mem_colStochastic
          (S.noise t ω) (S.col_stochastic t)⟩ := by
  apply Subtype.ext
  rfl

/-- The normalized push mass obeys the same column transport as the
unnormalized source mass. -/
theorem normalizedPushMass_succ_leftAct
    (N : NetworkSetup n) (t : ℕ) :
    normalizedPushMass N (t + 1) =
      Matrix.smulVec (N.colMix t) (normalizedPushMass N t) := by
  classical
  funext i
  change (n : ℝ)⁻¹ * (∑ j, N.colMix t i j * pushMass N t j) =
    ∑ j, N.colMix t i j * ((n : ℝ)⁻¹ * pushMass N t j)
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _hj
  ring

/-- Removing the current oracle noise and its historical column filter leaves
the exact-gradient innovation recursion. -/
theorem correctedTracker_succ
    (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) :
    correctedTracker S ω α (t + 1) =
      leftAct (S.colMix t) (correctedTracker S ω α t) +
        gradientTable S ω α (t + 1) - gradientTable S ω α t := by
  classical
  funext i
  rw [show correctedTracker S ω α (t + 1) i =
      tracker S ω α (t + 1) i - S.noise (t + 1) ω i -
        filteredNoise S ω (t + 1) i by rfl]
  rw [congrFun (tracker_succ S ω α t) i]
  simp only [sampledOracle_eq_gradient_add_noise, gradientTable,
    correctedTracker, filteredNoise, leftAct, Matrix.smulVec, dotProduct,
    Pi.add_apply, Pi.sub_apply, Matrix.sub_apply, Matrix.one_apply,
    sub_smul, smul_sub, Finset.sum_sub_distrib]
  have hdelta :
      (∑ j : Fin n, (if i = j then (1 : ℝ) else 0) • S.noise t ω j) =
        S.noise t ω i := by
    simp
  rw [hdelta]
  module

/-- Column stochasticity preserves the aggregate of the corrected tracker,
which is therefore exactly the aggregate exact gradient. -/
theorem correctedTracker_sum_eq_gradientTable_sum
    (S : Setup n d Ω) (ω : Ω) (α : ℝ) :
    ∀ t, ∑ i, correctedTracker S ω α t i =
      ∑ i, gradientTable S ω α t i := by
  classical
  intro t
  induction t with
  | zero =>
      simp [correctedTracker, gradientTable, filteredNoise,
        sampledOracle_eq_gradient_add_noise]
  | succ t ih =>
      rw [correctedTracker_succ S ω α t]
      simp only [Pi.add_apply, Pi.sub_apply, Finset.sum_add_distrib,
        Finset.sum_sub_distrib, leftAct]
      rw [Matrix.sum_smulVec_of_mem_colStochastic _ (S.col_stochastic t), ih]
      module

/-- Perron weighting of the corrected tracker splits into its normalized
aggregate exact gradient and corrected disagreement. -/
theorem correctedTracker_weighted_eq
    (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) :
    (∑ i, (absoluteProbability S.network (t + 1) i) •
      correctedTracker S ω α t i) =
      (gain S.network t) • ((n : ℝ)⁻¹ •
        ∑ j, gradientTable S ω α t j) +
      ∑ i, (absoluteProbability S.network (t + 1) i) •
        correctedTrackerDisagreement S ω α t i := by
  classical
  have hcoeff :
      ∑ i, absoluteProbability S.network (t + 1) i *
          normalizedPushMass S.network t i =
        gain S.network t / (n : ℝ) := by
    unfold normalizedPushMass gain dotProduct
    rw [div_eq_mul_inv, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro i _hi
    ring
  unfold correctedTrackerDisagreement
  simp only [smul_sub, Finset.sum_sub_distrib, smul_smul]
  rw [← Finset.sum_smul, hcoeff]
  module

/-- The absolute-probability row converts the primal recursion into a weighted
center recursion. -/
theorem absoluteProbability_primal_succ
    (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) :
    (∑ i, (absoluteProbability S.network (t + 1) i) •
      primal S ω α (t + 1) i) =
      (∑ i, (absoluteProbability S.network t i) • primal S ω α t i) -
        α • (∑ i, (absoluteProbability S.network (t + 1) i) •
          tracker S ω α t i) := by
  classical
  have hmix :
      (∑ i, (absoluteProbability S.network (t + 1) i) •
        leftAct (S.rowMix t) (primal S ω α t) i) =
        ∑ i, (absoluteProbability S.network t i) • primal S ω α t i := by
    calc
      (∑ i, (absoluteProbability S.network (t + 1) i) •
          leftAct (S.rowMix t) (primal S ω α t) i) =
          ∑ j, (absoluteProbability S.network (t + 1) ᵥ* S.rowMix t) j •
            primal S ω α t j := by
        simpa [leftAct] using
          (Matrix.sum_vecMul_smul_eq_sum_smul_smulVec
            (absoluteProbability S.network (t + 1))
            (S.rowMix t) (primal S ω α t)).symm
      _ = ∑ i, (absoluteProbability S.network t i) •
            primal S ω α t i := by
        rw [(absoluteProbability_spec S.network).2.2 t]
  have hscale :
      (∑ i, (absoluteProbability S.network (t + 1) i) •
        (α • tracker S ω α t i)) =
        α • (∑ i, (absoluteProbability S.network (t + 1) i) •
          tracker S ω α t i) := by
    rw [Finset.smul_sum]
    apply Finset.sum_congr rfl
    intro i _hi
    rw [smul_smul, smul_smul]
    congr 1
    ring
  rw [primal_succ]
  simp only [Pi.sub_apply, Pi.smul_apply, smul_sub, Finset.sum_sub_distrib]
  rw [hmix, hscale]

/-- Equation-(9)'s corrected tracker-disagreement recursion. -/
theorem correctedTrackerDisagreement_succ
    (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) :
    correctedTrackerDisagreement S ω α (t + 1) =
      leftAct (S.colMix t) (correctedTrackerDisagreement S ω α t) +
        (fun i => gradientTable S ω α (t + 1) i -
          gradientTable S ω α t i -
          (normalizedPushMass S.network (t + 1) i) •
            (∑ j, (gradientTable S ω α (t + 1) j -
              gradientTable S ω α t j))) := by
  classical
  unfold correctedTrackerDisagreement
  rw [correctedTracker_succ S ω α t]
  funext i
  rw [congrFun (normalizedPushMass_succ_leftAct S.network t) i]
  simp only [correctedTrackerDisagreement, leftAct, Matrix.smulVec,
    dotProduct, Pi.add_apply, Pi.sub_apply, Finset.sum_add_distrib,
    Finset.sum_sub_distrib]
  rw [congrFun (normalizedPushMass_succ_leftAct S.network t) i]
  simp only [smul_sub, sub_smul, Finset.sum_sub_distrib,
    Finset.smul_sum, Matrix.smulVec, dotProduct, smul_eq_mul]
  have hold :
      (∑ x : Fin n, ∑ y : Fin n,
        S.colMix t i x • normalizedPushMass S.network t x •
          gradientTable S ω α t y) =
        ∑ y : Fin n,
          (∑ x : Fin n,
            S.colMix t i x * normalizedPushMass S.network t x) •
              gradientTable S ω α t y := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro y _hy
    rw [Finset.sum_smul]
    apply Finset.sum_congr rfl
    intro x _hx
    rw [smul_smul]
  rw [hold]
  module

/-- Equation-(9)'s time-zero corrected tracker disagreement. -/
theorem correctedTrackerDisagreement_zero
    (S : Setup n d Ω) (ω : Ω) (α : ℝ) :
    correctedTrackerDisagreement S ω α 0 =
      fun i => gradientTable S ω α 0 i -
        (n : ℝ)⁻¹ • ∑ j, gradientTable S ω α 0 j := by
  classical
  funext i
  simp [correctedTrackerDisagreement, correctedTracker, gradientTable,
    filteredNoise, normalizedPushMass, sampledOracle_eq_gradient_add_noise]

/-- Equation-(9)'s corrected center initialization. -/
theorem correctedCenter_zero
    (S : Setup n d Ω) (ω : Ω) (α : ℝ) :
    correctedCenter S ω α 0 = S.initialPoint := by
  classical
  have hmass : ∑ i, absoluteProbability S.network 0 i = 1 :=
    (absoluteProbability_spec S.network).2.1 0
  simp [correctedCenter, filteredNoiseZeroSum, filteredNoise,
    influenceOperatorPoint, FiniteNetwork.periodicCorrectedLift,
    FiniteNetwork.periodicCorrectedLiftSeriesTerm]
  rw [← Finset.sum_smul, hmass, one_smul]

/-- The net forcing in the weighted primal/corrector update is exactly the
gradient, predictable drift, and current innovation from equation (9). -/
theorem correctedCenter_forcing_eq
    (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) :
    (∑ i, (absoluteProbability S.network (t + 1) i) •
      tracker S ω α t i) +
        influenceOperatorPoint S.network (t + 1)
          (filteredNoiseZeroSum S ω (t + 1)) -
        influenceOperatorPoint S.network t (filteredNoiseZeroSum S ω t) =
      (gain S.network t) •
          gradient (averageObjective S) (correctedCenter S ω α t) +
        correctedDrift S ω α t + influenceNoise S ω t := by
  classical
  have htracker :
      (∑ i, (absoluteProbability S.network (t + 1) i) •
        tracker S ω α t i) =
        (∑ i, (absoluteProbability S.network (t + 1) i) •
          correctedTracker S ω α t i) +
        (∑ i, (absoluteProbability S.network (t + 1) i) •
          S.noise t ω i) +
        (∑ i, (absoluteProbability S.network (t + 1) i) •
          filteredNoise S ω t i) := by
    unfold correctedTracker
    simp only [Pi.sub_apply, smul_sub, Finset.sum_sub_distrib]
    module
  rw [htracker, correctedTracker_weighted_eq]
  rw [filteredNoiseZeroSum_succ, influenceOperatorPoint_add]
  rw [influenceOperatorPoint_resolvent S.network t
    (filteredNoiseZeroSum S ω t), influenceNoise_response]
  unfold correctedDrift
  simp only [filteredNoiseZeroSum]
  module

/-- Equation-(9)'s exact corrected-center successor recursion. -/
theorem correctedCenter_succ
    (S : Setup n d Ω) (ω : Ω) (α : ℝ) (t : ℕ) :
    correctedCenter S ω α (t + 1) = correctedCenter S ω α t -
      α • ((gain S.network t) •
        gradient (averageObjective S) (correctedCenter S ω α t) +
        correctedDrift S ω α t + influenceNoise S ω t) := by
  change
    (∑ i, (absoluteProbability S.network (t + 1) i) •
      primal S ω α (t + 1) i) -
        α • influenceOperatorPoint S.network (t + 1)
          (filteredNoiseZeroSum S ω (t + 1)) =
      ((∑ i, (absoluteProbability S.network t i) • primal S ω α t i) -
        α • influenceOperatorPoint S.network t
          (filteredNoiseZeroSum S ω t)) -
      α • ((gain S.network t) •
        gradient (averageObjective S) (correctedCenter S ω α t) +
        correctedDrift S ω α t + influenceNoise S ω t)
  rw [absoluteProbability_primal_succ]
  rw [← correctedCenter_forcing_eq S ω α t]
  module

/-- The historical noise filter is measurable before the current sample. -/
theorem filteredNoise_measurable_preSamplingHistory
    (S : Setup n d Ω) (t : ℕ) :
    Measurable[preSamplingHistory S t] (fun ω => filteredNoise S ω t) := by
  induction t with
  | zero => simpa [filteredNoise] using
      (measurable_const : Measurable[preSamplingHistory S 0]
        (fun _ : Ω => (0 : NodeTable n d)))
  | succ t ih =>
      have hmono : preSamplingHistory S t ≤ preSamplingHistory S (t + 1) :=
        (preSamplingFiltration S).mono' (Nat.le_succ t)
      have ih' := ih.mono hmono le_rfl
      have hnoise := noise_measurable_preSamplingHistory_of_lt S
        (Nat.lt_succ_self t)
      have hleft := leftAct_measurable S (t + 1) (S.colMix t)
        (fun ω => filteredNoise S ω t) ih'
      have hinnovation := leftAct_measurable S (t + 1) (S.colMix t - 1)
        (S.noise t) hnoise
      simpa only [filteredNoise] using hleft.add hinnovation

/-- The exact local-gradient table is strict-past measurable. -/
theorem gradientTable_measurable_preSamplingHistory
    (S : Setup n d Ω) (α : ℝ) (t : ℕ) :
    Measurable[preSamplingHistory S t] (fun ω => gradientTable S ω α t) := by
  refine @measurable_pi_lambda Ω (Fin n) (fun _ : Fin n => Point d)
    (preSamplingHistory S t) (fun _ => by infer_instance) _ ?_
  intro i
  exact (S.local_smooth i).2.continuous.measurable.comp
    ((measurable_pi_apply i).comp (primal_measurable_preSamplingHistory S α t))

/-- Removing current noise exposes a strict-past corrected tracker. -/
theorem correctedTracker_measurable_preSamplingHistory
    (S : Setup n d Ω) (α : ℝ) (t : ℕ) :
    Measurable[preSamplingHistory S t] (fun ω => correctedTracker S ω α t) := by
  induction t with
  | zero =>
      have heq : (fun ω => correctedTracker S ω α 0) =
          fun ω => gradientTable S ω α 0 := by
        funext ω
        funext i
        simp [correctedTracker, filteredNoise, gradientTable,
          sampledOracle_eq_gradient_add_noise]
      rw [heq]
      exact gradientTable_measurable_preSamplingHistory S α 0
  | succ t ih =>
      have hmono : preSamplingHistory S t ≤ preSamplingHistory S (t + 1) :=
        (preSamplingFiltration S).mono' (Nat.le_succ t)
      have ih' := ih.mono hmono le_rfl
      have hleft := leftAct_measurable S (t + 1) (S.colMix t)
        (fun ω => correctedTracker S ω α t) ih'
      have hnext := gradientTable_measurable_preSamplingHistory S α (t + 1)
      have hprev := (gradientTable_measurable_preSamplingHistory S α t).mono
        hmono le_rfl
      have hrec :
          (fun ω => correctedTracker S ω α (t + 1)) =
            fun ω => leftAct (S.colMix t) (correctedTracker S ω α t) +
              gradientTable S ω α (t + 1) - gradientTable S ω α t := by
        funext ω
        exact correctedTracker_succ S ω α t
      rw [hrec]
      exact (hleft.add hnext).sub hprev

/-- The corrected tracker disagreement is strict-past measurable. -/
theorem correctedTrackerDisagreement_measurable_preSamplingHistory
    (S : Setup n d Ω) (α : ℝ) (t : ℕ) :
    Measurable[preSamplingHistory S t]
      (fun ω => correctedTrackerDisagreement S ω α t) := by
  refine @measurable_pi_lambda Ω (Fin n) (fun _ : Fin n => Point d)
    (preSamplingHistory S t) (fun _ => by infer_instance) _ ?_
  intro i
  have htracker := (measurable_pi_apply i).comp
    (correctedTracker_measurable_preSamplingHistory S α t)
  have hsum : Measurable[preSamplingHistory S t]
      (fun ω => ∑ j, gradientTable S ω α t j) := by
    apply Finset.measurable_sum
    intro j _hj
    exact (measurable_pi_apply j).comp
      (gradientTable_measurable_preSamplingHistory S α t)
  exact htracker.sub (hsum.const_smul (normalizedPushMass S.network t i))

/-- Corrected-center and corrected-drift predictability derived from the
generated strict-past filtration and smoothness. -/
theorem correctedCenter_and_drift_measurable
    (S : Setup n d Ω) (α : ℝ) :
    (∀ t, Measurable[preSamplingHistory S t]
      (fun ω => correctedCenter S ω α t)) ∧
    (∀ t, Measurable[preSamplingHistory S t]
      (fun ω => correctedDrift S ω α t)) := by
  classical
  have hcenter : ∀ t, Measurable[preSamplingHistory S t]
      (fun ω => correctedCenter S ω α t) := by
    intro t
    have hweighted : Measurable[preSamplingHistory S t]
        (fun ω => ∑ i, (absoluteProbability S.network t i) •
          primal S ω α t i) := by
      apply Finset.measurable_sum
      intro i _hi
      exact ((measurable_pi_apply i).comp
        (primal_measurable_preSamplingHistory S α t)).const_smul
          (absoluteProbability S.network t i)
    have hfilter : Measurable[preSamplingHistory S t]
        (fun ω => filteredNoiseZeroSum S ω t) :=
      Measurable.subtype_mk (filteredNoise_measurable_preSamplingHistory S t)
    obtain ⟨K, hK⟩ :=
      FiniteNetwork.exists_lipschitzWith_periodicCorrectedLift
        S.colMix (absoluteProbability S.network)
        (blockContraction S.network) (mixingRate S.network) t
        (fun ℓ => absoluteProbability_mem_stdSimplex S.network (t + ℓ + 1))
        (blockContraction_pos S.network).le (mixingRate_nonneg S.network)
        (mixingRate_lt_one S.network)
        (fun z ℓ => point_colMix_stateL1_geometric S.network t ℓ z)
    have hlift : Measurable[preSamplingHistory S t]
        (fun ω => influenceOperatorPoint S.network t
          (filteredNoiseZeroSum S ω t)) :=
      hK.continuous.measurable.comp hfilter
    exact hweighted.sub (hlift.const_smul α)
  refine ⟨hcenter, ?_⟩
  intro t
  have hgradSum : Measurable[preSamplingHistory S t]
      (fun ω => ∑ i, gradientTable S ω α t i) := by
    apply Finset.measurable_sum
    intro i _hi
    exact (measurable_pi_apply i).comp
      (gradientTable_measurable_preSamplingHistory S α t)
  have havgGrad : Measurable[preSamplingHistory S t]
      (fun ω => gradient (averageObjective S) (correctedCenter S ω α t)) := by
    have hlocal : Measurable[preSamplingHistory S t]
        (fun ω => (n : ℝ)⁻¹ • ∑ i,
          gradient (S.localObjective i) (correctedCenter S ω α t)) := by
      have hsum : Measurable[preSamplingHistory S t]
          (fun ω => ∑ i,
            gradient (S.localObjective i) (correctedCenter S ω α t)) := by
        apply Finset.measurable_sum
        intro i _hi
        exact (S.local_smooth i).2.continuous.measurable.comp (hcenter t)
      exact hsum.const_smul ((n : ℝ)⁻¹)
    have heq :
        (fun ω => gradient (averageObjective S) (correctedCenter S ω α t)) =
          fun ω => (n : ℝ)⁻¹ • ∑ i,
            gradient (S.localObjective i) (correctedCenter S ω α t) := by
      funext ω
      have havg := SOptLib.finiteAverageObjective_hasGradientAt
        S.localObjective (fun i x => gradient (S.localObjective i) x)
        (correctedCenter S ω α t)
        (fun i => ((S.local_smooth i).1 _).hasGradientAt)
      simpa only [averageObjective, Fintype.card_fin] using havg.gradient
    rw [heq]
    exact hlocal
  have hfirst := ((hgradSum.const_smul ((n : ℝ)⁻¹)).sub havgGrad).const_smul
    (gain S.network t)
  have hsecond : Measurable[preSamplingHistory S t]
      (fun ω => ∑ i, (absoluteProbability S.network (t + 1) i) •
        correctedTrackerDisagreement S ω α t i) := by
    apply Finset.measurable_sum
    intro i _hi
    exact ((measurable_pi_apply i).comp
      (correctedTrackerDisagreement_measurable_preSamplingHistory S α t)).const_smul
        (absoluteProbability S.network (t + 1) i)
  exact hfirst.add hsecond

/-! The declaration below records the exact parse of the former malformed
first conjunct of `corrected_center_uniform_control`.  Its explicit final
parameter is the accidental theorem-level `j` that arose when the old-gradient
term escaped the finite-sum binder.  Keeping this rejected statement under a
different name makes the source correction formally auditable without leaving
the malformed recurrence in the paper-facing theorem. -/

def EscapedOldGradientRecurrence
    (S : Setup n d Ω) (α : ℝ) (j : Fin n) : Prop :=
  ∀ ω t,
    correctedTrackerDisagreement S ω α (t + 1) =
      leftAct (S.colMix t) (correctedTrackerDisagreement S ω α t) +
        (fun i => gradientTable S ω α (t + 1) i - gradientTable S ω α t i -
          (normalizedPushMass S.network (t + 1) i) •
            ((∑ k, gradientTable S ω α (t + 1) k) -
              gradientTable S ω α t j))

def escapedBinderNetwork : NetworkSetup 2 where
  hn := by norm_num
  a := 1 / 2
  ha := by norm_num
  rowMix := fun _ _ _ => 1 / 2
  colMix := fun _ _ _ => 1 / 2
  row_stochastic := by
    intro t
    rw [Matrix.mem_rowStochastic_iff_sum]
    constructor
    · norm_num
    · intro i
      simp
  col_stochastic := by
    intro t
    rw [Matrix.mem_colStochastic_iff_sum]
    constructor
    · norm_num
    · intro j
      simp
  row_positive_diagonal := by
    intro t i
    norm_num
  col_positive_diagonal := by
    intro t i
    norm_num
  row_weight_floor := by
    intro t i j hij
    norm_num
  col_weight_floor := by
    intro t i j hij
    norm_num
  row_strongly_connected := by
    intro t i j
    exact Relation.ReflTransGen.single (by norm_num)
  col_strongly_connected := by
    intro t i j
    exact Relation.ReflTransGen.single (by norm_num)

def escapedBinderObjective (x : Point 1) : ℝ :=
  (1 / 2 : ℝ) * ‖x‖ ^ 2

@[simp] theorem gradient_escapedBinderObjective (x : Point 1) :
    gradient escapedBinderObjective x = x := by
  change gradient (fun y : Point 1 => (1 / 2 : ℝ) * ‖y‖ ^ 2) x = x
  simpa using
    (hasGradientAt_const_mul_norm_sub_sq_centered (1 : ℝ) (0 : Point 1) x).gradient

theorem escapedBinderObjective_sInf :
    sInf (Set.range escapedBinderObjective) = 0 := by
  apply csInf_eq_of_forall_ge_of_forall_gt_exists_lt
  · exact ⟨0, ⟨0, by simp [escapedBinderObjective]⟩⟩
  · rintro _ ⟨x, rfl⟩
    exact mul_nonneg (by norm_num) (sq_nonneg _)
  · intro w hw
    exact ⟨0, ⟨0, by simp [escapedBinderObjective]⟩, hw⟩

def escapedBinderProbability : Measure Unit := Measure.dirac ()

instance escapedBinderProbability_isProbability :
    IsProbabilityMeasure escapedBinderProbability := by
  unfold escapedBinderProbability
  infer_instance

theorem diracUnitCondExp_eq_self
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (m : MeasurableSpace Unit) (hm : m ≤ PUnit.instMeasurableSpace)
    (Z : Unit → E) :
    @MeasureTheory.condExp Unit E m (m₀ := PUnit.instMeasurableSpace)
      _ _ _ escapedBinderProbability Z = Z := by
  have hZ : Z = fun _ => Z () := by
    funext ω
    rw [Subsingleton.elim ω ()]
  rw [hZ]
  exact MeasureTheory.condExp_const hm (Z ())

theorem diracUnitConditionalExpectationEqSelf
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (m : MeasurableSpace Unit) (hm : m ≤ PUnit.instMeasurableSpace)
    (Z : Unit → E) :
    @SOptLib.ConditionalExpectation.conditionalExpectationEq
      Unit E PUnit.instMeasurableSpace _ _ _
      escapedBinderProbability m Z Z := by
  constructor
  · exact ⟨hm, inferInstance, MeasureTheory.integrable_dirac (by simp)⟩
  · rw [diracUnitCondExp_eq_self m hm Z]

theorem diracUnitConditionalSecondMomentZero
    {E : Type*} [NormedAddCommGroup E]
    (m : MeasurableSpace Unit) (hm : m ≤ PUnit.instMeasurableSpace) :
    @ConditionalSecondMomentBound E Unit _
      PUnit.instMeasurableSpace escapedBinderProbability m
      (fun _ => (0 : E)) 0 := by
  constructor
  · refine ⟨hm, inferInstance, ?_⟩
    simp
  · rw [diracUnitCondExp_eq_self m hm]
    exact Filter.Eventually.of_forall fun _ => by simp

theorem diracUnitNodeConditionallyIndependentZero
    {Node E : Type*} [Fintype Node] [DecidableEq Node]
    [MeasurableSpace E] [NormedAddCommGroup E]
    (m : MeasurableSpace Unit) (hm : m ≤ PUnit.instMeasurableSpace) :
    @NodeConditionallyIndependent Node E Unit _ _ _
      PUnit.instMeasurableSpace escapedBinderProbability m
      (fun _ _ => (0 : E)) := by
  intro s A hA
  constructor
  · intro i hi
    show @SOptLib.ConditionalExpectation.conditionalExpectationWellDefined
      Unit ℝ PUnit.instMeasurableSpace _ escapedBinderProbability m
        (((fun _ : Unit => (0 : E)) ⁻¹' A i).indicator
          (fun _ => (1 : ℝ)))
    exact (diracUnitConditionalExpectationEqSelf m hm
      (((fun _ : Unit => (0 : E)) ⁻¹' A i).indicator
        (fun _ => (1 : ℝ)))).1
  · let Z : Unit → ℝ := fun ω => ∏ i ∈ s,
      ((fun _ : Unit => (0 : E)) ⁻¹' A i).indicator (fun _ => (1 : ℝ)) ω
    have htarget :
        (fun ω => ∏ i ∈ s,
          (@MeasureTheory.condExp Unit ℝ m
            (m₀ := PUnit.instMeasurableSpace) _ _ _ escapedBinderProbability
            (((fun _ : Unit => (0 : E)) ⁻¹' A i).indicator
              (fun _ => (1 : ℝ)))) ω) = Z := by
      funext ω
      apply Finset.prod_congr rfl
      intro i hi
      rw [diracUnitCondExp_eq_self m hm]
    rw [htarget]
    exact diracUnitConditionalExpectationEqSelf m hm Z

def escapedBinderPoint : Point 1 :=
  WithLp.toLp 2 (fun _ : Fin 1 => (1 : ℝ))

theorem escapedBinderHistory_le (t : ℕ) :
    preSamplingHistoryOf (fun _ : ℕ => fun _ : Unit => fun _ : Fin 2 =>
      (0 : Point 1)) t ≤ PUnit.instMeasurableSpace := by
  unfold preSamplingHistoryOf
  refine iSup_le fun j => iSup_le fun hj => ?_
  rw [← measurable_iff_comap_le]
  exact measurable_const

def escapedBinderSetup : Setup 2 1 Unit where
  network := escapedBinderNetwork
  hd := by norm_num
  L := 1
  Δ := 1 / 2
  σ := 0
  H := 0
  hL := by norm_num
  hΔ := by norm_num
  hσ := by norm_num
  hH := by norm_num
  localObjective := fun _ => escapedBinderObjective
  initialPoint := escapedBinderPoint
  noise := fun _ _ _ => 0
  probability := escapedBinderProbability
  is_probability := escapedBinderProbability_isProbability
  local_smooth := by
    intro i
    constructor
    · intro x
      change DifferentiableAt ℝ (fun y : Point 1 => (1 / 2 : ℝ) * ‖y‖ ^ 2) x
      simpa using (hasGradientAt_const_mul_norm_sub_sq_centered
        (1 : ℝ) (0 : Point 1) x).differentiableAt
    · have hgradient : gradient escapedBinderObjective = id := by
        funext x
        exact gradient_escapedBinderObjective x
      rw [hgradient]
      exact LipschitzWith.id
  average_lower_bounded := by
    refine ⟨0, ?_⟩
    rintro _ ⟨x, rfl⟩
    simp only [escapedBinderObjective]
    positivity
  exact_initial_gap := by
    have havg :
        (fun x : Point 1 =>
          (2 : ℝ)⁻¹ * ∑ _i : Fin 2, escapedBinderObjective x) =
          escapedBinderObjective := by
      funext x
      simp
    change
      (2 : ℝ)⁻¹ * ∑ _i : Fin 2, escapedBinderObjective escapedBinderPoint -
        sInf (Set.range fun x : Point 1 =>
          (2 : ℝ)⁻¹ * ∑ _i : Fin 2, escapedBinderObjective x) = 1 / 2
    rw [havg, escapedBinderObjective_sInf]
    simp [escapedBinderObjective, escapedBinderPoint, PiLp.norm_eq_of_L2]
  noise_centered := by
    intro t i
    exact diracUnitConditionalExpectationEqSelf
      (preSamplingHistoryOf (fun _ : ℕ => fun _ : Unit => fun _ : Fin 2 =>
        (0 : Point 1)) t) (escapedBinderHistory_le t) _
  noise_second_moment := by
    intro t i
    simpa using diracUnitConditionalSecondMomentZero
      (preSamplingHistoryOf (fun _ : ℕ => fun _ : Unit => fun _ : Fin 2 =>
        (0 : Point 1)) t) (escapedBinderHistory_le t)
  node_conditional_independence := by
    intro t
    exact diracUnitNodeConditionallyIndependentZero _ (escapedBinderHistory_le t)

/-- Formal defect certificate for the statement corrected below.  On a
two-node feasible Push--Pull setup with identical scalar quadratics and the
constant averaging network, the escaped-binder recurrence is false already at
time zero. -/
theorem escapedOldGradientRecurrence_false :
    ¬ EscapedOldGradientRecurrence escapedBinderSetup 1 (0 : Fin 2) := by
  intro hold
  have hsource := correctedTrackerDisagreement_succ escapedBinderSetup () 1 0
  have hescaped := hold () 0
  have heq := hsource.symm.trans hescaped
  have hcoord := congrArg (fun X : NodeTable 2 1 => X (0 : Fin 2) (0 : Fin 1)) heq
  simp [escapedBinderSetup, escapedBinderNetwork, gradientTable, escapedBinderPoint,
    normalizedPushMass, pushMass, leftAct, Matrix.smulVec, Matrix.mulVec,
    dotProduct] at hcoord

/-- Conditional independence and nodewise centering cancel every off-diagonal
noise cross moment after localization to a pre-sampling event. -/
theorem noise_setIntegral_inner_eq_zero
    (S : Setup n d Ω) (t : ℕ) (A : Set Ω)
    (hA : MeasurableSet[preSamplingHistory S t] A)
    (i j : Fin n) (hij : i ≠ j) :
    (∫ ω in A, ⟪S.noise t ω i, S.noise t ω j⟫_ℝ ∂S.probability) = 0 := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  let μ : Measure Ω := S.probability.restrict A
  letI : IsFiniteMeasure μ :=
    isFiniteMeasure_restrict.2 (measure_ne_top S.probability A)
  change (∫ ω, ⟪S.noise t ω i, S.noise t ω j⟫_ℝ ∂μ) = 0
  apply integral_inner_eq_zero_of_condExp_indicator_factorization_of_condExp_eq_zero
    μ (preSamplingHistory S t) (preSamplingHistory_le S t)
    (fun k ω => S.noise t ω k)
  · intro events hevents
    let joint : Ω → ℝ :=
      {ω | ∀ k : Fin n, S.noise t ω k ∈ events k}.indicator (fun _ => 1)
    let coord : Fin n → Ω → ℝ := fun k =>
      ((fun ω => S.noise t ω k) ⁻¹' events k).indicator (fun _ => 1)
    have hjoint_eq : joint = fun ω => ∏ k : Fin n, coord k ω := by
      funext ω
      by_cases hω : ∀ k : Fin n, S.noise t ω k ∈ events k
      · simp [joint, coord, hω]
      · simp only [not_forall] at hω
        have hnot : ¬ ∀ k : Fin n, S.noise t ω k ∈ events k := by
          simpa only [not_forall] using hω
        have hnotmem : ω ∉ {ω | ∀ k : Fin n, S.noise t ω k ∈ events k} := hnot
        obtain ⟨k, hk⟩ := hω
        dsimp [joint]
        rw [Set.indicator_of_notMem hnotmem]
        symm
        apply Finset.prod_eq_zero (Finset.mem_univ k)
        simp [coord, hk]
    have hnode := S.node_conditional_independence t Finset.univ events (by
      intro k _hk
      exact hevents k)
    have hraw :
        MeasureTheory.condExp (preSamplingHistory S t) S.probability joint =ᵐ[S.probability]
          fun ω => ∏ k : Fin n,
            MeasureTheory.condExp (preSamplingHistory S t) S.probability (coord k) ω := by
      rw [hjoint_eq]
      simpa [coord] using hnode.2.ae_eq
    have hjoint_int : Integrable joint S.probability := by
      rw [hjoint_eq]
      simpa [coord] using hnode.2.wellDefined.integrable
    have hcoord_int (k : Fin n) : Integrable (coord k) S.probability := by
      exact (hnode.1 k (Finset.mem_univ k)).integrable
    have hleft := MeasureTheory.condExp_restrict_ae_eq_restrict
      (μ := S.probability) (m := preSamplingHistory S t)
      (s := A) (preSamplingHistory_le S t) hA hjoint_int
    have hright :
        (fun ω => ∏ k : Fin n,
          MeasureTheory.condExp (preSamplingHistory S t) μ (coord k) ω) =ᵐ[μ]
        fun ω => ∏ k : Fin n,
          MeasureTheory.condExp (preSamplingHistory S t) S.probability (coord k) ω := by
      filter_upwards [ae_all_iff.2 (fun k =>
        MeasureTheory.condExp_restrict_ae_eq_restrict
          (μ := S.probability) (m := preSamplingHistory S t)
          (s := A) (preSamplingHistory_le S t) hA (hcoord_int k))] with ω hω
      exact Finset.prod_congr rfl (fun k _hk => hω k)
    exact Filter.EventuallyEq.trans hleft
      (Filter.EventuallyEq.trans (ae_restrict_of_ae hraw) hright.symm)
  · exact hij
  · exact ((measurable_pi_apply i).comp
      (noise_measurable_preSamplingHistory_of_lt S (Nat.lt_succ_self t))).mono
        (preSamplingHistory_le S (t + 1)) le_rfl
  · exact ((measurable_pi_apply j).comp
      (noise_measurable_preSamplingHistory_of_lt S (Nat.lt_succ_self t))).mono
        (preSamplingHistory_le S (t + 1)) le_rfl
  · have hrestrict := MeasureTheory.condExp_restrict_ae_eq_restrict
      (μ := S.probability) (m := preSamplingHistory S t)
      (s := A) (preSamplingHistory_le S t) hA (noise_integrable S t j)
    exact hrestrict.trans (ae_restrict_of_ae (S.noise_centered t j).ae_eq)
  · have hbase : MemLp (fun ω => S.noise t ω i) 2 S.probability :=
      (memLp_two_iff_integrable_sq_norm (noise_integrable S t i).aestronglyMeasurable).2
        (noise_norm_sq_integrable S t i)
    exact hbase.mono_measure Measure.restrict_le_self
  · have hbase : MemLp (fun ω => S.noise t ω j) 2 S.probability :=
      (memLp_two_iff_integrable_sq_norm (noise_integrable S t j).aestronglyMeasurable).2
        (noise_norm_sq_integrable S t j)
    exact hbase.mono_measure Measure.restrict_le_self

/-- A deterministic finite weighting of one same-time node-noise family is
conditionally centered and has the sharp diagonal conditional second moment. -/
theorem weighted_noise_conditional_moments
    (S : Setup n d Ω) (t : ℕ) (w : Fin n → ℝ) :
    SOptLib.ConditionalExpectation.conditionalExpectationEq S.probability
        (preSamplingHistory S t)
        (fun ω => ∑ i, w i • S.noise t ω i) (fun _ => 0) ∧
      ConditionalSecondMomentBound S.probability (preSamplingHistory S t)
        (fun ω => ∑ i, w i • S.noise t ω i)
        (S.σ ^ 2 * ∑ i, w i ^ 2) := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  have hm : preSamplingHistory S t ≤ (inferInstance : MeasurableSpace Ω) :=
    preSamplingHistory_le S t
  let i₀ : Fin n := ⟨0, S.hn⟩
  rcases (S.noise_centered t i₀).wellDefined with ⟨hm', hsf, _hi₀⟩
  letI : @SigmaFinite Ω (preSamplingHistory S t) (S.probability.trim hm) := by
    simpa only using hsf
  have hcoord_memLp (i : Fin n) :
      MemLp (fun ω => S.noise t ω i) 2 S.probability :=
    (memLp_two_iff_integrable_sq_norm
      (noise_integrable S t i).aestronglyMeasurable).2
        (noise_norm_sq_integrable S t i)
  have hsum_memLp :
      MemLp (fun ω => ∑ i, w i • S.noise t ω i) 2 S.probability := by
    apply memLp_finset_sum Finset.univ
    intro i _hi
    exact (hcoord_memLp i).const_smul (w i)
  have hsum_int : Integrable (fun ω => ∑ i, w i • S.noise t ω i) S.probability :=
    hsum_memLp.integrable (by norm_num)
  have hsum_sq_int :
      Integrable (fun ω => ‖∑ i, w i • S.noise t ω i‖ ^ 2) S.probability :=
    (memLp_two_iff_integrable_sq_norm hsum_memLp.aestronglyMeasurable).1 hsum_memLp
  have hcenter_ae :
      MeasureTheory.condExp (preSamplingHistory S t) S.probability
          (fun ω => ∑ i, w i • S.noise t ω i) =ᵐ[S.probability]
        fun _ => (0 : Point d) := by
    rw [show (fun ω => ∑ i, w i • S.noise t ω i) =
        Finset.sum Finset.univ (fun i ω => w i • S.noise t ω i) by
      funext ω
      simp]
    refine (MeasureTheory.condExp_finset_sum (s := Finset.univ)
      (fun i _hi => (noise_integrable S t i).smul (w i))
        (preSamplingHistory S t)).trans ?_
    have hscaled : ∀ i ∈ Finset.univ,
        MeasureTheory.condExp (preSamplingHistory S t) S.probability
            (fun ω => w i • S.noise t ω i) =ᵐ[S.probability]
          (0 : Ω → Point d) := by
      intro i _hi
      calc
        MeasureTheory.condExp (preSamplingHistory S t) S.probability
            (fun ω => w i • S.noise t ω i) =ᵐ[S.probability]
            w i • MeasureTheory.condExp (preSamplingHistory S t) S.probability
              (fun ω => S.noise t ω i) :=
          MeasureTheory.condExp_smul (w i) (fun ω => S.noise t ω i)
            (preSamplingHistory S t)
        _ =ᵐ[S.probability] w i • (0 : Ω → Point d) :=
          (S.noise_centered t i).ae_eq.const_smul (w i)
        _ =ᵐ[S.probability] 0 := Filter.Eventually.of_forall (fun x => by simp)
    simpa only [Finset.sum_const_zero] using eventuallyEq_sum hscaled
  have hcenter :
      SOptLib.ConditionalExpectation.conditionalExpectationEq S.probability
        (preSamplingHistory S t)
        (fun ω => ∑ i, w i • S.noise t ω i) (fun _ => 0) :=
    ⟨⟨hm, inferInstance, hsum_int⟩, hcenter_ae⟩
  have hset_bound (A : Set Ω) (hA : MeasurableSet[preSamplingHistory S t] A)
      (_hfinite : S.probability A < ⊤) :
      (∫ ω in A, ‖∑ i, w i • S.noise t ω i‖ ^ 2 ∂S.probability) ≤
        (S.σ ^ 2 * ∑ i, w i ^ 2) * S.probability.real A := by
    have hdiag (i : Fin n) :
        (∫ ω in A, ‖S.noise t ω i‖ ^ 2 ∂S.probability) ≤
          S.σ ^ 2 * S.probability.real A := by
      have hmono :
          (∫ ω in A, MeasureTheory.condExp (preSamplingHistory S t) S.probability
              (fun ω => ‖S.noise t ω i‖ ^ 2) ω ∂S.probability) ≤
            ∫ _ω in A, S.σ ^ 2 ∂S.probability := by
        apply MeasureTheory.integral_mono_ae
        · exact MeasureTheory.integrable_condExp.integrableOn
        · exact integrableOn_const (measure_ne_top S.probability A)
        · exact ae_restrict_of_ae (S.noise_second_moment t i).2
      rw [MeasureTheory.setIntegral_condExp hm
        (noise_norm_sq_integrable S t i) hA] at hmono
      simpa [MeasureTheory.setIntegral_const, mul_comm] using hmono
    have hweighted := integral_norm_sq_finset_sum_smul_le_of_cross_zero
      (S.probability.restrict A) Finset.univ w
      (fun i ω => S.noise t ω i) (S.σ ^ 2 * S.probability.real A)
      (fun i _hi => (noise_integrable S t i).aestronglyMeasurable.mono_measure
        Measure.restrict_le_self)
      (fun i _hi => (noise_norm_sq_integrable S t i).integrableOn)
      (fun i _hi j _hj hij => noise_setIntegral_inner_eq_zero S t A hA i j hij)
      (fun i _hi => hdiag i)
    simpa [mul_assoc, mul_comm, mul_left_comm] using hweighted
  have hsecond_ae := condExp_le_const_of_setIntegral_le
    S.probability (preSamplingHistory S t)
      (fun ω => ‖∑ i, w i • S.noise t ω i‖ ^ 2)
      (S.σ ^ 2 * ∑ i, w i ^ 2) hm hsum_sq_int hset_bound
  exact ⟨hcenter, ⟨⟨hm, inferInstance, hsum_sq_int⟩, hsecond_ae⟩⟩

/-- The source column-product estimate on Point-valued zero-sum states, in the
Frobenius seminorm used by the corrected tracker energy. -/
theorem point_colMix_nodeTableNorm_geometric
    (N : NetworkSetup n) (t ℓ : ℕ)
    (z : FiniteNetwork.ZeroSumState (Fin n) (Point d)) :
    Real.sqrt (nodeTableNormSq
        (Matrix.smulVec (FiniteNetwork.consecutiveProduct N.colMix t ℓ) z.1)) ≤
      columnMixingConstant N * mixingRate N ^ ℓ *
        Real.sqrt (nodeTableNormSq z.1) := by
  have htransfer :=
    FiniteNetwork.dependentProductL2Seminorm_le_sqrt_card_mul_geometric_of_sum_norm_le
      (fun W : NodeTable n d =>
        Matrix.smulVec (FiniteNetwork.consecutiveProduct N.colMix t ℓ) W)
      (blockContraction N)⁻¹ (mixingRate N) ℓ z.1
      (mul_nonneg (inv_nonneg.mpr (blockContraction_pos N).le)
        (pow_nonneg (mixingRate_nonneg N) _))
      (by
        simpa [FiniteNetwork.stateL1Norm_def] using
          point_colMix_stateL1_geometric N t ℓ z)
  simpa [nodeTableNormSq, SOptLib.dependentProductNormSq_def,
    columnMixingConstant, Fintype.card_fin, div_eq_mul_inv,
    mul_assoc, mul_comm, mul_left_comm] using htransfer

/-- The exact-gradient forcing in the corrected tracker recurrence. -/
def correctedTrackerForcing
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (t : ℕ) : NodeTable n d :=
  FiniteNetwork.perronResidual (normalizedPushMass S.network (t + 1))
    (gradientTable S omega alpha (t + 1) - gradientTable S omega alpha t)

/-- Every corrected-tracker forcing lies in the Point-valued zero-sum carrier. -/
theorem correctedTrackerForcing_sum_zero
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (t : ℕ) :
    ∑ i, correctedTrackerForcing S omega alpha t i = 0 := by
  unfold correctedTrackerForcing
  exact FiniteNetwork.perronResidual_sum_eq_zero _ _
    (normalizedPushMass_sum_eq_one S.network (t + 1))

/-- The corrected tracker disagreement itself has zero node sum at every time. -/
theorem correctedTrackerDisagreement_sum_zero
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (t : ℕ) :
    ∑ i, correctedTrackerDisagreement S omega alpha t i = 0 := by
  classical
  unfold correctedTrackerDisagreement
  simp only [Finset.sum_sub_distrib]
  rw [← Finset.sum_smul, normalizedPushMass_sum_eq_one, one_smul,
    correctedTracker_sum_eq_gradientTable_sum, sub_self]

/-- The normalized push mass is a simplex weight at the point where the
corrected-tracker response is assembled. -/
theorem normalizedPushMass_mem_stdSimplex_for_tracker
    (N : NetworkSetup n) (t : ℕ) :
    normalizedPushMass N t ∈ stdSimplex ℝ (Fin n) := by
  have hpush : ∀ s (i : Fin n), 0 ≤ pushMass N s i := by
    intro s
    induction s with
    | zero => intro i; simp
    | succ s ih =>
        intro i
        rw [pushMass_succ]
        exact Matrix.nonneg_mulVec_of_mem_colStochastic
          (N.col_stochastic s) ih i
  constructor
  · intro i
    unfold normalizedPushMass
    exact mul_nonneg (inv_nonneg.mpr (Nat.cast_nonneg n)) (hpush t i)
  · exact normalizedPushMass_sum_eq_one N t

/-- A normalized Perron residual costs at most `1 + sqrt(card)` in the
Frobenius seminorm. -/
theorem perronResidual_nodeTableNorm_le
    (v : Fin n → ℝ) (X : NodeTable n d)
    (hv : v ∈ stdSimplex ℝ (Fin n)) :
    Real.sqrt (nodeTableNormSq (FiniteNetwork.perronResidual v X)) ≤
      (1 + Real.sqrt n) * Real.sqrt (nodeTableNormSq X) := by
  classical
  let g : Point d := ∑ i, X i
  let R : NodeTable n d := fun i => v i • g
  have hnorm (Y : NodeTable n d) :
      ‖WithLp.toLp 2 Y‖ = Real.sqrt (nodeTableNormSq Y) := by
    simp [PiLp.norm_eq_of_L2, nodeTableNormSq]
  have hres : FiniteNetwork.perronResidual v X = X - R := by
    rfl
  have hR : Real.sqrt (nodeTableNormSq R) ≤ ‖g‖ := by
    rw [← hnorm]
    calc
      ‖WithLp.toLp 2 R‖ ≤ ∑ i, ‖R i‖ :=
        dependentProductL2Seminorm_le_sum_norm R
      _ = ∑ i, v i * ‖g‖ := by
        apply Finset.sum_congr rfl
        intro i _hi
        simp [R, norm_smul, Real.norm_eq_abs, abs_of_nonneg (hv.1 i)]
      _ = ‖g‖ := by rw [← Finset.sum_mul, hv.2, one_mul]
  have hg : ‖g‖ ≤
      Real.sqrt n * Real.sqrt (nodeTableNormSq X) := by
    calc
      ‖g‖ ≤ ∑ i, ‖X i‖ := by
        simpa [g] using norm_sum_le Finset.univ (fun i : Fin n => X i)
      _ ≤ Real.sqrt (Fintype.card (Fin n) : ℝ) *
            ‖WithLp.toLp 2 X‖ :=
        sum_norm_le_sqrt_card_mul_dependentProductL2Seminorm X
      _ = Real.sqrt n * Real.sqrt (nodeTableNormSq X) := by
        rw [hnorm]
        simp
  rw [hres, ← hnorm]
  calc
    ‖WithLp.toLp 2 (X - R)‖ =
        ‖WithLp.toLp 2 X - WithLp.toLp 2 R‖ := by congr 1
    _ ≤ ‖WithLp.toLp 2 X‖ + ‖WithLp.toLp 2 R‖ := norm_sub_le _ _
    _ = Real.sqrt (nodeTableNormSq X) + Real.sqrt (nodeTableNormSq R) := by
      rw [hnorm, hnorm]
    _ ≤ Real.sqrt (nodeTableNormSq X) +
        Real.sqrt n * Real.sqrt (nodeTableNormSq X) :=
      add_le_add le_rfl (hR.trans hg)
    _ = (1 + Real.sqrt n) * Real.sqrt (nodeTableNormSq X) := by ring

/-- The corrected exact-gradient forcing has the source `k₀=1+sqrt(n)`
Frobenius bound. -/
theorem correctedTrackerForcing_norm_le
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (t : ℕ) :
    Real.sqrt (nodeTableNormSq (correctedTrackerForcing S omega alpha t)) ≤
      (1 + Real.sqrt n) *
        Real.sqrt (nodeTableNormSq
          (gradientTable S omega alpha (t + 1) -
            gradientTable S omega alpha t)) := by
  exact perronResidual_nodeTableNorm_le _ _
    (normalizedPushMass_mem_stdSimplex_for_tracker S.network (t + 1))

/-- Exact nonzero-initial Duhamel expansion of the corrected tracker
disagreement under the time-varying column products. -/
theorem correctedTrackerDisagreement_duhamel
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (t : ℕ) :
    correctedTrackerDisagreement S omega alpha t =
      Matrix.smulVec (FiniteNetwork.consecutiveProduct S.colMix 0 t)
        (correctedTrackerDisagreement S omega alpha 0) +
      ∑ j ∈ Finset.range t,
        Matrix.smulVec
          (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j))
          (correctedTrackerForcing S omega alpha j) := by
  classical
  have haction (A B : NetworkMatrix n) (X : NodeTable n d) :
      Matrix.smulVec (A * B) X =
        Matrix.smulVec A (Matrix.smulVec B X) := by
    funext i
    simp only [Matrix.smulVec_apply, Matrix.mul_apply, Finset.smul_sum,
      Finset.sum_smul, mul_smul]
    rw [Finset.sum_comm]
  have hadd (A : NetworkMatrix n) (X Y : NodeTable n d) :
      Matrix.smulVec A (X + Y) =
        Matrix.smulVec A X + Matrix.smulVec A Y := by
    funext i
    simp [Matrix.smulVec_apply, smul_add, Finset.sum_add_distrib]
  have hsum_action (A : NetworkMatrix n) (s : Finset ℕ)
      (X : ℕ → NodeTable n d) :
      Matrix.smulVec A (∑ j ∈ s, X j) =
        ∑ j ∈ s, Matrix.smulVec A (X j) := by
    induction s using Finset.induction_on with
    | empty => simp
    | @insert j s hj ih => simp [hj, hadd, ih]
  induction t with
  | zero =>
      simp only [FiniteNetwork.consecutiveProduct_zero, Finset.range_zero,
        Finset.sum_empty, add_zero]
      change correctedTrackerDisagreement S omega alpha 0 =
        Matrix.smulVec (fun i j : Fin n => if i = j then 1 else 0)
          (correctedTrackerDisagreement S omega alpha 0)
      funext i
      simp [Matrix.smulVec_apply]
  | succ t ih =>
      rw [correctedTrackerDisagreement_succ, ih]
      change Matrix.smulVec (S.colMix t)
          (Matrix.smulVec (FiniteNetwork.consecutiveProduct S.colMix 0 t)
              (correctedTrackerDisagreement S omega alpha 0) +
            ∑ j ∈ Finset.range t,
              Matrix.smulVec
                (FiniteNetwork.consecutiveProduct S.colMix (j + 1)
                  (t - 1 - j))
                (correctedTrackerForcing S omega alpha j)) +
          correctedTrackerForcing S omega alpha t = _
      rw [hadd, Finset.sum_range_succ]
      have hinit :
          Matrix.smulVec (S.colMix t)
              (Matrix.smulVec (FiniteNetwork.consecutiveProduct S.colMix 0 t)
                (correctedTrackerDisagreement S omega alpha 0)) =
            Matrix.smulVec
              (FiniteNetwork.consecutiveProduct S.colMix 0 (t + 1))
              (correctedTrackerDisagreement S omega alpha 0) := by
        rw [FiniteNetwork.consecutiveProduct_succ, haction]
        simp only [zero_add]
      rw [hinit]
      have hsum :
          Matrix.smulVec (S.colMix t)
              (∑ j ∈ Finset.range t,
                Matrix.smulVec
                  (FiniteNetwork.consecutiveProduct S.colMix (j + 1)
                    (t - 1 - j))
                  (correctedTrackerForcing S omega alpha j)) =
            ∑ j ∈ Finset.range t,
              Matrix.smulVec
                (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - j))
                (correctedTrackerForcing S omega alpha j) := by
        rw [hsum_action]
        apply Finset.sum_congr rfl
        intro j hj
        have hjt : j < t := Finset.mem_range.mp hj
        have hexp : t - j = (t - 1 - j) + 1 := by omega
        rw [hexp, FiniteNetwork.consecutiveProduct_succ, haction]
        congr 2
        omega
      rw [hsum]
      have hlast :
          Matrix.smulVec
              (FiniteNetwork.consecutiveProduct S.colMix (t + 1) 0)
              (correctedTrackerForcing S omega alpha t) =
            correctedTrackerForcing S omega alpha t := by
        simp only [FiniteNetwork.consecutiveProduct_zero]
        change Matrix.smulVec (fun i j : Fin n => if i = j then 1 else 0)
            (correctedTrackerForcing S omega alpha t) =
          correctedTrackerForcing S omega alpha t
        funext i
        simp [Matrix.smulVec_apply]
      have hsum_index :
          (∑ j ∈ Finset.range t,
            Matrix.smulVec
              (FiniteNetwork.consecutiveProduct S.colMix (j + 1)
                (t + 1 - 1 - j))
              (correctedTrackerForcing S omega alpha j)) =
            ∑ j ∈ Finset.range t,
              Matrix.smulVec
                (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - j))
                (correctedTrackerForcing S omega alpha j) := by
        apply Finset.sum_congr rfl
        intro j hj
        congr 4
      have hlast_target :
          Matrix.smulVec
              (FiniteNetwork.consecutiveProduct S.colMix (t + 1)
                (t + 1 - 1 - t))
              (correctedTrackerForcing S omega alpha t) =
            correctedTrackerForcing S omega alpha t := by
        have hexp : t + 1 - 1 - t = 0 := by omega
        rw [hexp]
        exact hlast
      rw [hsum_index, hlast_target]
      abel

/-- Pointwise nonzero-initial geometric response for the corrected tracker
disagreement.  This is equation (9) followed by the Point-valued column-product
contraction, before any expectation or horizon summation. -/
theorem corrected_tracker_disagreement_geometric_response
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (t : ℕ) :
    Real.sqrt (nodeTableNormSq
        (correctedTrackerDisagreement S omega alpha t)) ≤
      columnMixingConstant S.network * mixingRate S.network ^ t *
          Real.sqrt (nodeTableNormSq
            (correctedTrackerDisagreement S omega alpha 0)) +
        ∑ j ∈ Finset.range t,
          columnMixingConstant S.network *
              mixingRate S.network ^ (t - 1 - j) *
            (1 + Real.sqrt n) *
              Real.sqrt (nodeTableNormSq
                (gradientTable S omega alpha (j + 1) -
                  gradientTable S omega alpha j)) := by
  classical
  have hnorm (Y : NodeTable n d) :
      ‖WithLp.toLp 2 Y‖ = Real.sqrt (nodeTableNormSq Y) := by
    simp [PiLp.norm_eq_of_L2, nodeTableNormSq]
  have hM : 0 ≤ columnMixingConstant S.network := by
    unfold columnMixingConstant
    exact div_nonneg (Real.sqrt_nonneg _) (blockContraction_pos S.network).le
  have hr : 0 ≤ mixingRate S.network := mixingRate_nonneg S.network
  have hadd_norm (X Y : NodeTable n d) :
      Real.sqrt (nodeTableNormSq (X + Y)) ≤
        Real.sqrt (nodeTableNormSq X) + Real.sqrt (nodeTableNormSq Y) := by
    rw [← hnorm, ← hnorm, ← hnorm]
    exact SOptLib.dependentProductL2Seminorm_add_le X Y
  have hsum_norm (s : Finset ℕ) (f : ℕ → NodeTable n d) :
      Real.sqrt (nodeTableNormSq (∑ j ∈ s, f j)) ≤
        ∑ j ∈ s, Real.sqrt (nodeTableNormSq (f j)) := by
    induction s using Finset.induction_on with
    | empty => simp [nodeTableNormSq]
    | @insert j s hj ih =>
        rw [Finset.sum_insert hj, Finset.sum_insert hj]
        exact (hadd_norm (f j) (∑ k ∈ s, f k)).trans
          (add_le_add le_rfl ih)
  have hinit :
      Real.sqrt (nodeTableNormSq
        (Matrix.smulVec (FiniteNetwork.consecutiveProduct S.colMix 0 t)
          (correctedTrackerDisagreement S omega alpha 0))) ≤
        columnMixingConstant S.network * mixingRate S.network ^ t *
          Real.sqrt (nodeTableNormSq
            (correctedTrackerDisagreement S omega alpha 0)) :=
    point_colMix_nodeTableNorm_geometric S.network 0 t
      ⟨correctedTrackerDisagreement S omega alpha 0,
        correctedTrackerDisagreement_sum_zero S omega alpha 0⟩
  have hterm (j : ℕ) :
      Real.sqrt (nodeTableNormSq
          (Matrix.smulVec
            (FiniteNetwork.consecutiveProduct S.colMix (j + 1)
              (t - 1 - j))
            (correctedTrackerForcing S omega alpha j))) ≤
        columnMixingConstant S.network *
            mixingRate S.network ^ (t - 1 - j) *
          (1 + Real.sqrt n) *
            Real.sqrt (nodeTableNormSq
              (gradientTable S omega alpha (j + 1) -
                gradientTable S omega alpha j)) := by
    calc
      Real.sqrt (nodeTableNormSq
          (Matrix.smulVec
            (FiniteNetwork.consecutiveProduct S.colMix (j + 1)
              (t - 1 - j))
            (correctedTrackerForcing S omega alpha j))) ≤
          columnMixingConstant S.network *
              mixingRate S.network ^ (t - 1 - j) *
            Real.sqrt (nodeTableNormSq
              (correctedTrackerForcing S omega alpha j)) :=
        point_colMix_nodeTableNorm_geometric S.network (j + 1)
          (t - 1 - j)
          ⟨correctedTrackerForcing S omega alpha j,
            correctedTrackerForcing_sum_zero S omega alpha j⟩
      _ ≤ columnMixingConstant S.network *
              mixingRate S.network ^ (t - 1 - j) *
            ((1 + Real.sqrt n) *
              Real.sqrt (nodeTableNormSq
                (gradientTable S omega alpha (j + 1) -
                  gradientTable S omega alpha j))) := by
        exact mul_le_mul_of_nonneg_left
          (correctedTrackerForcing_norm_le S omega alpha j)
          (mul_nonneg hM (pow_nonneg hr _))
      _ = columnMixingConstant S.network *
              mixingRate S.network ^ (t - 1 - j) *
            (1 + Real.sqrt n) *
              Real.sqrt (nodeTableNormSq
                (gradientTable S omega alpha (j + 1) -
                  gradientTable S omega alpha j)) := by ring
  rw [correctedTrackerDisagreement_duhamel]
  calc
    Real.sqrt (nodeTableNormSq
        (Matrix.smulVec
            (FiniteNetwork.consecutiveProduct S.colMix 0 t)
            (correctedTrackerDisagreement S omega alpha 0) +
          ∑ j ∈ Finset.range t,
            Matrix.smulVec
              (FiniteNetwork.consecutiveProduct S.colMix (j + 1)
                (t - 1 - j))
              (correctedTrackerForcing S omega alpha j))) ≤
        Real.sqrt (nodeTableNormSq
          (Matrix.smulVec
            (FiniteNetwork.consecutiveProduct S.colMix 0 t)
            (correctedTrackerDisagreement S omega alpha 0))) +
        Real.sqrt (nodeTableNormSq
          (∑ j ∈ Finset.range t,
            Matrix.smulVec
              (FiniteNetwork.consecutiveProduct S.colMix (j + 1)
                (t - 1 - j))
              (correctedTrackerForcing S omega alpha j))) :=
      hadd_norm _ _
    _ ≤ Real.sqrt (nodeTableNormSq
          (Matrix.smulVec
            (FiniteNetwork.consecutiveProduct S.colMix 0 t)
            (correctedTrackerDisagreement S omega alpha 0))) +
        ∑ j ∈ Finset.range t,
          Real.sqrt (nodeTableNormSq
            (Matrix.smulVec
              (FiniteNetwork.consecutiveProduct S.colMix (j + 1)
                (t - 1 - j))
              (correctedTrackerForcing S omega alpha j))) :=
      add_le_add le_rfl (hsum_norm _ _)
    _ ≤ columnMixingConstant S.network * mixingRate S.network ^ t *
          Real.sqrt (nodeTableNormSq
            (correctedTrackerDisagreement S omega alpha 0)) +
        ∑ j ∈ Finset.range t,
          columnMixingConstant S.network *
              mixingRate S.network ^ (t - 1 - j) *
            (1 + Real.sqrt n) *
              Real.sqrt (nodeTableNormSq
                (gradientTable S omega alpha (j + 1) -
                  gradientTable S omega alpha j)) := by
      apply add_le_add hinit
      apply Finset.sum_le_sum
      intro j hj
      exact hterm j

/-- Pathwise prefix energy obtained from the corrected-tracker geometric
response by the generic initial-plus-convolution square-sum estimate. -/
theorem corrected_tracker_disagreement_pathwise_prefix_energy
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (T : PositiveHorizon) :
    ∑ t ∈ Finset.range T.1,
        nodeTableNormSq (correctedTrackerDisagreement S omega alpha t) ≤
      (2 * columnMixingConstant S.network ^ 2 /
          (1 - mixingRate S.network ^ 2)) *
        nodeTableNormSq (correctedTrackerDisagreement S omega alpha 0) +
      (2 * columnMixingConstant S.network ^ 2 /
          (1 - mixingRate S.network) ^ 2) *
        ∑ j ∈ Finset.range (T.1 - 1),
          ((1 + Real.sqrt n) *
            Real.sqrt (nodeTableNormSq
              (gradientTable S omega alpha (j + 1) -
                gradientTable S omega alpha j))) ^ 2 := by
  let N := T.1 - 1
  have hTN : N + 1 = T.1 := by
    dsimp [N]
    omega
  have hraw :=
    finite_sq_sum_le_of_le_geometric_initial_add_convolution
      (u := fun t => Real.sqrt (nodeTableNormSq
        (correctedTrackerDisagreement S omega alpha t)))
      (z := fun j => (1 + Real.sqrt n) *
        Real.sqrt (nodeTableNormSq
          (gradientTable S omega alpha (j + 1) -
            gradientTable S omega alpha j)))
      (M := columnMixingConstant S.network)
      (r := mixingRate S.network) N
      (fun _ _ => Real.sqrt_nonneg _)
      (mixingRate_nonneg S.network) (mixingRate_lt_one S.network)
      (fun t _ht => by
        simpa [mul_assoc] using
          corrected_tracker_disagreement_geometric_response S omega alpha t)
  have hsqrt_sq (Y : NodeTable n d) :
      Real.sqrt (nodeTableNormSq Y) ^ 2 = nodeTableNormSq Y := by
    rw [Real.sq_sqrt]
    exact Finset.sum_nonneg fun i _ => sq_nonneg ‖Y i‖
  simp_rw [hsqrt_sq] at hraw
  rw [hTN] at hraw
  exact hraw

/-- The time-zero corrected tracker energy is the source initial-gradient
heterogeneity energy, and the finite-layer hypothesis bounds it by `n H²`. -/
theorem correctedTrackerDisagreement_initial_energy_le
    (S : Setup n d Ω) (hLayer : InFiniteHeterogeneityLayer S)
    (omega : Ω) (alpha : ℝ) :
    nodeTableNormSq (correctedTrackerDisagreement S omega alpha 0) ≤
      (n : ℝ) * S.H ^ 2 := by
  classical
  have havg :
      gradient (averageObjective S) S.initialPoint =
        (n : ℝ)⁻¹ • ∑ i,
          gradient (S.localObjective i) S.initialPoint := by
    have h := SOptLib.finiteAverageObjective_hasGradientAt
      S.localObjective (fun i x => gradient (S.localObjective i) x)
      S.initialPoint (fun i => ((S.local_smooth i).1 _).hasGradientAt)
    simpa only [averageObjective, Fintype.card_fin] using h.gradient
  have henergy :
      nodeTableNormSq (correctedTrackerDisagreement S omega alpha 0) =
        (n : ℝ) * initialHeterogeneitySq S := by
    rw [correctedTrackerDisagreement_zero]
    unfold nodeTableNormSq initialHeterogeneitySq gradientTable
    simp only [primal_zero]
    rw [havg]
    have hn0 : (n : ℝ) ≠ 0 := by
      exact_mod_cast Nat.ne_of_gt S.hn
    rw [← mul_assoc, mul_inv_cancel₀ hn0, one_mul]
  rw [henergy]
  exact mul_le_mul_of_nonneg_left hLayer (Nat.cast_nonneg n)

/-- The pathwise prefix bound with its initial term discharged by the finite
heterogeneity layer.  The remaining forcing sum is exactly the input to the
primal-increment comparison in source step 6. -/
theorem corrected_tracker_disagreement_pathwise_prefix_energy_of_layer
    (S : Setup n d Ω) (hLayer : InFiniteHeterogeneityLayer S)
    (omega : Ω) (alpha : ℝ) (T : PositiveHorizon) :
    ∑ t ∈ Finset.range T.1,
        nodeTableNormSq (correctedTrackerDisagreement S omega alpha t) ≤
      trackerInitialKernel S.network * (n : ℝ) * S.H ^ 2 +
      (2 * columnMixingConstant S.network ^ 2 /
          (1 - mixingRate S.network) ^ 2) *
        ∑ j ∈ Finset.range (T.1 - 1),
          ((1 + Real.sqrt n) *
            Real.sqrt (nodeTableNormSq
              (gradientTable S omega alpha (j + 1) -
                gradientTable S omega alpha j))) ^ 2 := by
  have hprefix := corrected_tracker_disagreement_pathwise_prefix_energy
    S omega alpha T
  have hr := mixingRate_nonneg S.network
  have hrlt := mixingRate_lt_one S.network
  have hr2lt : mixingRate S.network ^ 2 < 1 := by nlinarith
  have hcoef : 0 ≤
      2 * columnMixingConstant S.network ^ 2 /
        (1 - mixingRate S.network ^ 2) := by
    exact div_nonneg
      (mul_nonneg (by norm_num) (sq_nonneg _))
      (sub_nonneg.mpr hr2lt.le)
  calc
    (∑ t ∈ Finset.range T.1,
        nodeTableNormSq (correctedTrackerDisagreement S omega alpha t)) ≤
      (2 * columnMixingConstant S.network ^ 2 /
          (1 - mixingRate S.network ^ 2)) *
        nodeTableNormSq (correctedTrackerDisagreement S omega alpha 0) +
      (2 * columnMixingConstant S.network ^ 2 /
          (1 - mixingRate S.network) ^ 2) *
        ∑ j ∈ Finset.range (T.1 - 1),
          ((1 + Real.sqrt n) *
            Real.sqrt (nodeTableNormSq
              (gradientTable S omega alpha (j + 1) -
                gradientTable S omega alpha j))) ^ 2 := hprefix
    _ ≤ (2 * columnMixingConstant S.network ^ 2 /
          (1 - mixingRate S.network ^ 2)) * ((n : ℝ) * S.H ^ 2) +
      (2 * columnMixingConstant S.network ^ 2 /
          (1 - mixingRate S.network) ^ 2) *
        ∑ j ∈ Finset.range (T.1 - 1),
          ((1 + Real.sqrt n) *
            Real.sqrt (nodeTableNormSq
              (gradientTable S omega alpha (j + 1) -
                gradientTable S omega alpha j))) ^ 2 := by
      exact add_le_add
        (mul_le_mul_of_nonneg_left
          (correctedTrackerDisagreement_initial_energy_le S hLayer omega alpha)
          hcoef)
        le_rfl
    _ = trackerInitialKernel S.network * (n : ℝ) * S.H ^ 2 +
      (2 * columnMixingConstant S.network ^ 2 /
          (1 - mixingRate S.network) ^ 2) *
        ∑ j ∈ Finset.range (T.1 - 1),
          ((1 + Real.sqrt n) *
            Real.sqrt (nodeTableNormSq
              (gradientTable S omega alpha (j + 1) -
                gradientTable S omega alpha j))) ^ 2 := by
      unfold trackerInitialKernel
      ring

/-- Component smoothness controls the exact-gradient-table increment by the
corresponding primal-table increment in Frobenius energy. -/
theorem gradientTable_increment_energy_le
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (t : ℕ) :
    nodeTableNormSq
        (gradientTable S omega alpha (t + 1) -
          gradientTable S omega alpha t) ≤
      S.L ^ 2 * nodeTableNormSq
        (primal S omega alpha (t + 1) - primal S omega alpha t) := by
  simpa [nodeTableNormSq, gradientTable] using
    (SOptLib.dependent_product_norm_sq_map_sub_le_of_pointwise_lipschitz
      (fun i => gradient (S.localObjective i)) S.L
      (primal S omega alpha (t + 1)) (primal S omega alpha t) S.hL.le
      (fun i => by
        simpa using (S.local_smooth i).2.norm_sub_le
          (primal S omega alpha (t + 1) i) (primal S omega alpha t i)))

/-- Every complete source row-mixing block has the displayed common entry
floor.  It is placed here because the Point-valued primal response below uses
the generic consecutive-product contraction before the later scalar
specialization. -/
theorem rowMix_block_entry_ge_mixingMinorization
    (N : NetworkSetup n) (s : ℕ) (i j : Fin n) :
    mixingMinorization N ≤
      FiniteNetwork.consecutiveProduct N.rowMix s (mixingBlockLength n) i j := by
  classical
  by_cases hn1 : n = 1
  · subst n
    have hi : i = (0 : Fin 1) := Subsingleton.elim _ _
    have hj : j = (0 : Fin 1) := Subsingleton.elim _ _
    subst i
    subst j
    have hproduct :
        FiniteNetwork.consecutiveProduct N.rowMix s (mixingBlockLength 1) ∈
          Matrix.rowStochastic ℝ (Fin 1) :=
      FiniteNetwork.consecutiveMatrixProduct_mem_rowStochastic
        N.rowMix s (mixingBlockLength 1) (fun q _ => N.row_stochastic (s + q))
    have hsum := Matrix.sum_row_of_mem_rowStochastic hproduct (0 : Fin 1)
    have heq :
        FiniteNetwork.consecutiveProduct N.rowMix s (mixingBlockLength 1)
            (0 : Fin 1) (0 : Fin 1) = 1 := by
      simpa using hsum
    simpa [mixingMinorization] using heq.ge
  · have hnpos : 0 < n := N.hn
    have hn_gt : 1 < n := by omega
    have hmax : max 1 (n - 1) = n - 1 := max_eq_right (by omega)
    unfold mixingMinorization
    rw [if_pos hn_gt]
    simpa [mixingBlockLength, hmax] using
      (FiniteNetwork.consecutiveMatrixProduct_entry_lowerBound_of_stronglyConnected
        N.rowMix (min N.a 1) (le_min N.ha.le (by norm_num)) s
        (fun q _hq i j => Matrix.nonneg_of_mem_rowStochastic
          (i := i) (j := j) (N.row_stochastic (s + q)))
        (fun q _hq => N.row_positive_diagonal (s + q))
        (fun q _hq i j hij => (min_le_left _ _).trans
          (N.row_weight_floor (s + q) i j (ne_of_gt hij)))
        (fun q _hq => N.row_strongly_connected (s + q)) i j)

/-- Point-valued consecutive row products contract consensus error in the
source Frobenius seminorm with the exact `M_R rho^ell` coefficient. -/
theorem point_rowMix_consensus_geometric
    (N : NetworkSetup n) (t ell : ℕ) (X : NodeTable n d) :
    Real.sqrt (nodeTableNormSq (FiniteNetwork.consensusError
        (Matrix.smulVec (FiniteNetwork.consecutiveProduct N.rowMix t ell) X))) ≤
      rowMixingConstant N * mixingRate N ^ ell *
        Real.sqrt (nodeTableNormSq (FiniteNetwork.consensusError X)) := by
  classical
  have hBpos : 0 < mixingBlockLength n := by
    unfold mixingBlockLength
    exact lt_of_lt_of_le Nat.zero_lt_one (le_max_left _ _)
  have hmu_pos : 0 < mixingMinorization N := by
    unfold mixingMinorization
    split_ifs
    · exact pow_pos ((lt_min_iff).2 ⟨N.ha, by norm_num⟩) _
    · norm_num
  have hdelta_lt : blockContraction N < 1 := by
    rw [blockContraction, max_lt_iff]
    constructor
    · norm_num
    · have hnR : (0 : ℝ) < n := Nat.cast_pos.mpr N.hn
      have hprod : 0 < (n : ℝ) * mixingMinorization N := mul_pos hnR hmu_pos
      linarith
  have hrate_pow : mixingRate N ^ mixingBlockLength n = blockContraction N := by
    unfold mixingRate
    exact Real.rpow_inv_natCast_pow (blockContraction_pos N).le
      (Nat.ne_of_gt hBpos)
  have hdelta_block :
      1 - (Fintype.card (Fin n) : ℝ) * mixingMinorization N ≤
        blockContraction N := by
    simpa [blockContraction] using
      (le_max_right (1 / 2 : ℝ)
        (1 - (n : ℝ) * mixingMinorization N))
  have hmix :=
    FiniteNetwork.consensusError_piLpNorm_consecutiveMatrixProduct_le_geometric_of_blockMinorization
      N.rowMix (mixingMinorization N) (blockContraction N) (mixingRate N)
      (mixingBlockLength n) hBpos (blockContraction_pos N) hdelta_lt
      (mixingRate_nonneg N) hrate_pow hdelta_block N.row_stochastic
      (rowMix_block_entry_ge_mixingMinorization N) t ell X
  simpa [PiLp.norm_eq_of_L2, nodeTableNormSq, rowMixingConstant,
    Fintype.card_fin] using hmix

/-- Exact zero-initial variation-of-constants formula for the primal consensus
error.  This is the row-mixed affine recurrence in source step 6 before taking
norms. -/
theorem primal_consensusError_duhamel
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (t : ℕ) :
    FiniteNetwork.consensusError (primal S omega alpha t) =
      (-alpha) • ∑ j ∈ Finset.range t,
        FiniteNetwork.consensusError
          (Matrix.smulVec
            (FiniteNetwork.consecutiveProduct S.rowMix (j + 1) (t - 1 - j))
            (tracker S omega alpha j)) := by
  classical
  letI : Nonempty (Fin n) := ⟨⟨0, S.hn⟩⟩
  have hconsensus_zero :
      FiniteNetwork.consensusError (0 : NodeTable n d) = 0 := by
    funext i
    simp [FiniteNetwork.consensusError_apply, FiniteNetwork.meanState,
      SOptLib.finiteUniformAverage_def]
  have hconsensus_add (U V : NodeTable n d) :
      FiniteNetwork.consensusError (U + V) =
        FiniteNetwork.consensusError U + FiniteNetwork.consensusError V := by
    funext i
    simp only [FiniteNetwork.consensusError_apply, Pi.add_apply,
      FiniteNetwork.meanState, SOptLib.finiteUniformAverage_def,
      Finset.sum_add_distrib, smul_add]
    abel
  have hconsensus_smul (a : ℝ) (U : NodeTable n d) :
      FiniteNetwork.consensusError (a • U) =
        a • FiniteNetwork.consensusError U := by
    funext i
    simp only [FiniteNetwork.consensusError_apply, Pi.smul_apply,
      FiniteNetwork.meanState, SOptLib.finiteUniformAverage_def,
      Finset.smul_sum, smul_sub]
    apply congrArg (fun z => a • U i - z)
    apply Finset.sum_congr rfl
    intro j _
    rw [smul_smul, smul_smul, mul_comm]
  have hconsensus_sub (U V : NodeTable n d) :
      FiniteNetwork.consensusError (U - V) =
        FiniteNetwork.consensusError U - FiniteNetwork.consensusError V := by
    funext i
    simp only [FiniteNetwork.consensusError_apply, Pi.sub_apply,
      FiniteNetwork.meanState, SOptLib.finiteUniformAverage_def,
      Finset.sum_sub_distrib, smul_sub]
    abel
  have hconsensus_sum (s : Finset ℕ) (U : ℕ → NodeTable n d) :
      FiniteNetwork.consensusError (∑ i ∈ s, U i) =
        ∑ i ∈ s, FiniteNetwork.consensusError (U i) := by
    induction s using Finset.induction_on with
    | empty => simpa only [Finset.sum_empty] using hconsensus_zero
    | @insert i s hi ih =>
        simp only [Finset.sum_insert hi]
        rw [hconsensus_add, ih]
  have hmatrix_smul (B : NetworkMatrix n) (a : ℝ) (U : NodeTable n d) :
      Matrix.smulVec B (a • U) = a • Matrix.smulVec B U := by
    funext i
    simp only [Matrix.smulVec_apply, Pi.smul_apply]
    calc
      (∑ j, B i j • a • U j) = ∑ j, a • (B i j • U j) := by
        apply Finset.sum_congr rfl
        intro j _
        rw [smul_smul, smul_smul, mul_comm]
      _ = a • ∑ j, B i j • U j := by rw [Finset.smul_sum]
  have hmatrix_mul (A B : NetworkMatrix n) (U : NodeTable n d) :
      Matrix.smulVec (A * B) U =
        Matrix.smulVec A (Matrix.smulVec B U) := by
    funext i
    simp only [Matrix.smulVec_apply, Matrix.mul_apply, Finset.smul_sum,
      Finset.sum_smul, mul_smul]
    rw [Finset.sum_comm]
  have hmatrix_sum (B : NetworkMatrix n) (s : Finset ℕ)
      (U : ℕ → NodeTable n d) :
      Matrix.smulVec B (∑ i ∈ s, U i) =
        ∑ i ∈ s, Matrix.smulVec B (U i) := by
    induction s using Finset.induction_on with
    | empty => simp [Matrix.smulVec_apply]
    | @insert i s hi ih =>
        simp only [Finset.sum_insert hi]
        have hadd : Matrix.smulVec B (U i + ∑ j ∈ s, U j) =
            Matrix.smulVec B (U i) +
              Matrix.smulVec B (∑ j ∈ s, U j) := by
          funext q
          simp [Matrix.smulVec_apply, smul_add, Finset.sum_add_distrib]
        rw [hadd, ih]
  have hrec (k : ℕ) :
      FiniteNetwork.consensusError (primal S omega alpha (k + 1)) =
        FiniteNetwork.consensusError
            (Matrix.smulVec (S.rowMix k)
              (FiniteNetwork.consensusError (primal S omega alpha k))) -
          alpha • FiniteNetwork.consensusError (tracker S omega alpha k) := by
    rw [primal_succ, hconsensus_sub, hconsensus_smul]
    have hinv :=
      FiniteNetwork.consensusError_smulVec_consensusError_of_sum_row_eq_one
        (S.rowMix k) (primal S omega alpha k)
        (fun i => Matrix.sum_row_of_mem_rowStochastic (S.row_stochastic k) i)
    have hinv' :
        FiniteNetwork.consensusError
            (Matrix.smulVec (S.rowMix k) (primal S omega alpha k)) =
          FiniteNetwork.consensusError
            (Matrix.smulVec (S.rowMix k)
              (FiniteNetwork.consensusError (primal S omega alpha k))) := by
      simpa only [leftAct, Matrix.Module.smul_apply, Matrix.smulVec_apply] using hinv
    exact congrArg
      (fun Z => Z - alpha • FiniteNetwork.consensusError
        (tracker S omega alpha k)) hinv'
  induction t with
  | zero =>
      simp only [primal_zero, Finset.range_zero, Finset.sum_empty, smul_zero]
      funext i
      rw [FiniteNetwork.consensusError_apply]
      change S.initialPoint -
        SOptLib.finiteUniformAverage (fun _ : Fin n => S.initialPoint) = 0
      rw [SOptLib.finiteUniformAverage_const]
      exact sub_self S.initialPoint
  | succ t ih =>
      rw [hrec t, ih, hmatrix_smul, hconsensus_smul]
      rw [hmatrix_sum (S.rowMix t) (Finset.range t)
        (fun j => FiniteNetwork.consensusError
          (Matrix.smulVec
            (FiniteNetwork.consecutiveProduct S.rowMix (j + 1) (t - 1 - j))
            (tracker S omega alpha j)))]
      rw [hconsensus_sum]
      have hterm : ∀ j ∈ Finset.range t,
          FiniteNetwork.consensusError
              (Matrix.smulVec (S.rowMix t)
                (FiniteNetwork.consensusError
                  (Matrix.smulVec
                    (FiniteNetwork.consecutiveProduct S.rowMix (j + 1)
                      (t - 1 - j))
                    (tracker S omega alpha j)))) =
            FiniteNetwork.consensusError
              (Matrix.smulVec
                (FiniteNetwork.consecutiveProduct S.rowMix (j + 1) (t - j))
                (tracker S omega alpha j)) := by
        intro j hj
        have hjt : j < t := Finset.mem_range.mp hj
        let Z := Matrix.smulVec
          (FiniteNetwork.consecutiveProduct S.rowMix (j + 1) (t - 1 - j))
          (tracker S omega alpha j)
        have hinv :
            FiniteNetwork.consensusError (Matrix.smulVec (S.rowMix t) Z) =
              FiniteNetwork.consensusError
                (Matrix.smulVec (S.rowMix t)
                  (FiniteNetwork.consensusError Z)) := by
          simpa only [Matrix.Module.smul_apply, Matrix.smulVec_apply] using
            (FiniteNetwork.consensusError_smulVec_consensusError_of_sum_row_eq_one
              (S.rowMix t) Z
              (fun i => Matrix.sum_row_of_mem_rowStochastic
                (S.row_stochastic t) i))
        rw [← hinv]
        rw [show t - j = (t - 1 - j) + 1 by omega,
          FiniteNetwork.consecutiveProduct_succ]
        rw [show j + 1 + (t - 1 - j) = t by omega]
        exact congrArg FiniteNetwork.consensusError
          (hmatrix_mul (S.rowMix t)
            (FiniteNetwork.consecutiveProduct S.rowMix (j + 1) (t - 1 - j))
            (tracker S omega alpha j)).symm
      have hsum :
          (∑ j ∈ Finset.range t,
              FiniteNetwork.consensusError
                (Matrix.smulVec (S.rowMix t)
                  (FiniteNetwork.consensusError
                    (Matrix.smulVec
                      (FiniteNetwork.consecutiveProduct S.rowMix (j + 1)
                        (t - 1 - j))
                      (tracker S omega alpha j))))) =
            ∑ j ∈ Finset.range t,
              FiniteNetwork.consensusError
                (Matrix.smulVec
                  (FiniteNetwork.consecutiveProduct S.rowMix (j + 1) (t - j))
                  (tracker S omega alpha j)) := by
        apply Finset.sum_congr rfl
        intro j hj
        exact hterm j hj
      rw [hsum, Finset.sum_range_succ]
      simp only [show t + 1 - 1 = t by omega, Nat.sub_self,
        FiniteNetwork.consecutiveProduct_zero]
      have hlast : Matrix.smulVec (1 : NetworkMatrix n)
          (tracker S omega alpha t) = tracker S omega alpha t := by
        change Matrix.smulVec (fun i j : Fin n => if i = j then 1 else 0)
          (tracker S omega alpha t) = tracker S omega alpha t
        funext i
        rw [Matrix.smulVec_apply, Finset.sum_eq_single i]
        · simp
        · intro j _ hji
          simp [Ne.symm hji]
        · simp
      rw [hlast]
      module

/-- The zero-initial primal disagreement is bounded by the geometric response
to the tracker forcing, with the exact row-mixing constant. -/
theorem primal_consensusError_geometric_response
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (halpha : 0 ≤ alpha) (t : ℕ) :
    Real.sqrt (nodeTableNormSq
        (FiniteNetwork.consensusError (primal S omega alpha t))) ≤
      ∑ j ∈ Finset.range t,
        rowMixingConstant S.network * mixingRate S.network ^ (t - 1 - j) *
          (alpha * Real.sqrt (nodeTableNormSq
            (FiniteNetwork.consensusError (tracker S omega alpha j)))) := by
  let response : ℕ → PiLp 2 (fun _ : Fin n => Point d) := fun j =>
    WithLp.toLp 2
      (FiniteNetwork.consensusError
        (Matrix.smulVec
          (FiniteNetwork.consecutiveProduct S.rowMix (j + 1) (t - 1 - j))
          (tracker S omega alpha j)))
  let forcingNorm : ℕ → ℝ := fun j =>
    ‖(WithLp.toLp 2
      (FiniteNetwork.consensusError (tracker S omega alpha j)) :
        PiLp 2 (fun _ : Fin n => Point d))‖
  have hresponseLp :
      (WithLp.toLp 2
          (FiniteNetwork.consensusError (primal S omega alpha t)) :
            PiLp 2 (fun _ : Fin n => Point d)) =
        (-alpha) • ∑ j ∈ Finset.range t, response j := by
    rw [primal_consensusError_duhamel]
    rw [WithLp.toLp_smul, WithLp.toLp_sum]
  have hresponse_bound (j : ℕ) :
      ‖response j‖ ≤ rowMixingConstant S.network *
          mixingRate S.network ^ (t - 1 - j) * forcingNorm j := by
    simpa [response, forcingNorm, PiLp.norm_eq_of_L2, nodeTableNormSq] using
      (point_rowMix_consensus_geometric S.network (j + 1) (t - 1 - j)
        (tracker S omega alpha j))
  have hraw :
      ‖(WithLp.toLp 2
          (FiniteNetwork.consensusError (primal S omega alpha t)) :
            PiLp 2 (fun _ : Fin n => Point d))‖ ≤
        ∑ j ∈ Finset.range t,
          rowMixingConstant S.network *
            mixingRate S.network ^ (t - 1 - j) * (alpha * forcingNorm j) := by
    rw [hresponseLp, norm_smul, Real.norm_eq_abs, abs_neg,
      abs_of_nonneg halpha]
    calc
      alpha * ‖∑ j ∈ Finset.range t, response j‖ ≤
          alpha * ∑ j ∈ Finset.range t, ‖response j‖ := by
        apply mul_le_mul_of_nonneg_left _ halpha
        exact norm_sum_le (Finset.range t) response
      _ ≤ alpha * ∑ j ∈ Finset.range t,
          rowMixingConstant S.network *
            mixingRate S.network ^ (t - 1 - j) * forcingNorm j := by
        apply mul_le_mul_of_nonneg_left _ halpha
        apply Finset.sum_le_sum
        intro j _hj
        exact hresponse_bound j
      _ = ∑ j ∈ Finset.range t,
          rowMixingConstant S.network *
            mixingRate S.network ^ (t - 1 - j) * (alpha * forcingNorm j) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro j _hj
        ring
  simpa [PiLp.norm_eq_of_L2, nodeTableNormSq, forcingNorm] using hraw

/-- Source step 6's first pathwise energy estimate: the zero-initial primal
disagreement is controlled by tracker energy with the printed `K_R`. -/
theorem primal_disagreement_pathwise_prefix_energy
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (halpha : 0 ≤ alpha)
    (T : PositiveHorizon) :
    ∑ t ∈ Finset.range T.1,
        nodeTableNormSq (FiniteNetwork.consensusError (primal S omega alpha t)) ≤
      alpha ^ 2 * disagreementKernel S.network *
        ∑ t ∈ Finset.range T.1, nodeTableNormSq (tracker S omega alpha t) := by
  letI : Nonempty (Fin n) := ⟨⟨0, S.hn⟩⟩
  let N := T.1 - 1
  have hTN : N + 1 = T.1 := by
    dsimp [N]
    omega
  have hraw := finite_sq_sum_le_of_le_geometric_convolution
    (u := fun t => Real.sqrt (nodeTableNormSq
      (FiniteNetwork.consensusError (primal S omega alpha t))))
    (z := fun j => alpha * Real.sqrt (nodeTableNormSq
      (FiniteNetwork.consensusError (tracker S omega alpha j))))
    (M := rowMixingConstant S.network) (r := mixingRate S.network) N
    (fun _ _ => Real.sqrt_nonneg _)
    (mixingRate_nonneg S.network) (mixingRate_lt_one S.network)
    (fun t _ht => primal_consensusError_geometric_response
      S omega alpha halpha t)
  have hsqrt_sq (Y : NodeTable n d) :
      Real.sqrt (nodeTableNormSq Y) ^ 2 = nodeTableNormSq Y := by
    rw [Real.sq_sqrt]
    exact Finset.sum_nonneg fun i _ => sq_nonneg ‖Y i‖
  simp_rw [hsqrt_sq] at hraw
  rw [hTN] at hraw
  have hscale :
      (∑ j ∈ Finset.range N,
        (alpha * Real.sqrt (nodeTableNormSq
          (FiniteNetwork.consensusError (tracker S omega alpha j)))) ^ 2) =
        alpha ^ 2 * ∑ j ∈ Finset.range N,
          nodeTableNormSq
            (FiniteNetwork.consensusError (tracker S omega alpha j)) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _hj
    rw [mul_pow, hsqrt_sq]
  rw [hscale] at hraw
  have hraw' :
      (∑ t ∈ Finset.range T.1,
          nodeTableNormSq
            (FiniteNetwork.consensusError (primal S omega alpha t))) ≤
        alpha ^ 2 * disagreementKernel S.network *
          ∑ j ∈ Finset.range N,
            nodeTableNormSq
              (FiniteNetwork.consensusError (tracker S omega alpha j)) := by
    calc
      _ ≤ (rowMixingConstant S.network ^ 2 /
          (1 - mixingRate S.network) ^ 2) *
            (alpha ^ 2 * ∑ j ∈ Finset.range N,
              nodeTableNormSq
                (FiniteNetwork.consensusError (tracker S omega alpha j))) := hraw
      _ = alpha ^ 2 * disagreementKernel S.network *
          ∑ j ∈ Finset.range N,
            nodeTableNormSq
              (FiniteNetwork.consensusError (tracker S omega alpha j)) := by
        unfold disagreementKernel
        ring
  have hproject (j : ℕ) :
      nodeTableNormSq
          (FiniteNetwork.consensusError (tracker S omega alpha j)) ≤
        nodeTableNormSq (tracker S omega alpha j) := by
    simpa [nodeTableNormSq, FiniteNetwork.consensusError_apply,
      FiniteNetwork.meanState, SOptLib.finiteUniformAverage_def] using
      (SOptLib.sum_norm_sq_sub_finiteUniformAverage_le_sum_norm_sq
        (tracker S omega alpha j))
  have hprefix :
      (∑ j ∈ Finset.range N,
          nodeTableNormSq
            (FiniteNetwork.consensusError (tracker S omega alpha j))) ≤
        ∑ j ∈ Finset.range T.1,
          nodeTableNormSq (tracker S omega alpha j) := by
    calc
      _ ≤ ∑ j ∈ Finset.range N,
          nodeTableNormSq (tracker S omega alpha j) := by
        apply Finset.sum_le_sum
        intro j _hj
        exact hproject j
      _ ≤ ∑ j ∈ Finset.range T.1,
          nodeTableNormSq (tracker S omega alpha j) := by
        rw [← hTN, Finset.sum_range_succ]
        exact le_add_of_nonneg_right
          (Finset.sum_nonneg fun i _ => sq_nonneg ‖tracker S omega alpha N i‖)
  exact hraw'.trans (mul_le_mul_of_nonneg_left hprefix (by
    exact mul_nonneg (sq_nonneg alpha)
      (div_nonneg (sq_nonneg (rowMixingConstant S.network))
        (sq_nonneg (1 - mixingRate S.network)))))

/-- A row-stochastic Point-valued action minus the identity costs at most
`1 + sqrt(card)` in Frobenius norm. -/
theorem rowStochastic_sub_identity_nodeTableNorm_le
    (A : NetworkMatrix n) (hA : A ∈ Matrix.rowStochastic ℝ (Fin n))
    (X : NodeTable n d) :
    Real.sqrt (nodeTableNormSq (Matrix.smulVec (A - 1) X)) ≤
      (1 + Real.sqrt n) * Real.sqrt (nodeTableNormSq X) := by
  classical
  have hnorm (Y : NodeTable n d) :
      ‖WithLp.toLp 2 Y‖ = Real.sqrt (nodeTableNormSq Y) := by
    simp [PiLp.norm_eq_of_L2, nodeTableNormSq]
  have hcoord (i : Fin n) :
      ‖Matrix.smulVec A X i‖ ≤ Real.sqrt (nodeTableNormSq X) := by
    calc
      ‖Matrix.smulVec A X i‖ ≤ ∑ j, ‖A i j • X j‖ := by
        simpa [Matrix.smulVec_apply] using
          norm_sum_le Finset.univ (fun j : Fin n => A i j • X j)
      _ = ∑ j, A i j * ‖X j‖ := by
        apply Finset.sum_congr rfl
        intro j _hj
        simp [norm_smul, Real.norm_eq_abs,
          abs_of_nonneg (Matrix.nonneg_of_mem_rowStochastic hA)]
      _ ≤ ∑ j, A i j * ‖WithLp.toLp 2 X‖ := by
        apply Finset.sum_le_sum
        intro j _hj
        exact mul_le_mul_of_nonneg_left
          (PiLp.norm_apply_le (WithLp.toLp 2 X) j)
          (Matrix.nonneg_of_mem_rowStochastic hA)
      _ = ‖WithLp.toLp 2 X‖ := by
        rw [← Finset.sum_mul, Matrix.sum_row_of_mem_rowStochastic hA i, one_mul]
      _ = Real.sqrt (nodeTableNormSq X) := hnorm X
  have henergy :
      nodeTableNormSq (Matrix.smulVec A X) ≤
        (n : ℝ) * nodeTableNormSq X := by
    unfold nodeTableNormSq
    calc
      (∑ i, ‖Matrix.smulVec A X i‖ ^ 2) ≤
          ∑ _i : Fin n, (Real.sqrt (∑ j, ‖X j‖ ^ 2)) ^ 2 := by
        apply Finset.sum_le_sum
        intro i _hi
        have hci : ‖Matrix.smulVec A X i‖ ≤
            Real.sqrt (∑ j, ‖X j‖ ^ 2) := by
          simpa [nodeTableNormSq] using hcoord i
        nlinarith [hci, norm_nonneg (Matrix.smulVec A X i),
          Real.sqrt_nonneg (∑ j, ‖X j‖ ^ 2)]
      _ = (n : ℝ) * ∑ j, ‖X j‖ ^ 2 := by
        rw [Real.sq_sqrt (Finset.sum_nonneg fun j _ => sq_nonneg ‖X j‖)]
        simp
  have haction :
      Real.sqrt (nodeTableNormSq (Matrix.smulVec A X)) ≤
        Real.sqrt n * Real.sqrt (nodeTableNormSq X) := by
    calc
      Real.sqrt (nodeTableNormSq (Matrix.smulVec A X)) ≤
          Real.sqrt ((n : ℝ) * nodeTableNormSq X) := Real.sqrt_le_sqrt henergy
      _ = Real.sqrt n * Real.sqrt (nodeTableNormSq X) := by
        rw [Real.sqrt_mul (Nat.cast_nonneg n)]
  rw [Matrix.sub_one_smulVec, ← hnorm]
  calc
    ‖WithLp.toLp 2 (Matrix.smulVec A X - X)‖ =
        ‖WithLp.toLp 2 (Matrix.smulVec A X) - WithLp.toLp 2 X‖ := by
      congr 1
    _ ≤ ‖WithLp.toLp 2 (Matrix.smulVec A X)‖ + ‖WithLp.toLp 2 X‖ :=
      norm_sub_le _ _
    _ = Real.sqrt (nodeTableNormSq (Matrix.smulVec A X)) +
        Real.sqrt (nodeTableNormSq X) := by rw [hnorm, hnorm]
    _ ≤ Real.sqrt n * Real.sqrt (nodeTableNormSq X) +
        Real.sqrt (nodeTableNormSq X) := add_le_add haction le_rfl
    _ = (1 + Real.sqrt n) * Real.sqrt (nodeTableNormSq X) := by ring

/-- A column-stochastic Point-valued action minus the identity has the same
`1 + sqrt(card)` Frobenius cost.  Here column stochasticity first gives an
`ℓ¹` nonexpansive action, which is then compared with the finite-product
`ℓ²` norm. -/
theorem colStochastic_sub_identity_nodeTableNorm_le
    (A : NetworkMatrix n) (hA : A ∈ Matrix.colStochastic ℝ (Fin n))
    (X : NodeTable n d) :
    Real.sqrt (nodeTableNormSq (Matrix.smulVec (A - 1) X)) ≤
      (1 + Real.sqrt n) * Real.sqrt (nodeTableNormSq X) := by
  classical
  have hnorm (Y : NodeTable n d) :
      ‖WithLp.toLp 2 Y‖ = Real.sqrt (nodeTableNormSq Y) := by
    simp [PiLp.norm_eq_of_L2, nodeTableNormSq]
  have haction :
      Real.sqrt (nodeTableNormSq (Matrix.smulVec A X)) ≤
        Real.sqrt n * Real.sqrt (nodeTableNormSq X) := by
    calc
      Real.sqrt (nodeTableNormSq (Matrix.smulVec A X)) =
          ‖WithLp.toLp 2 (Matrix.smulVec A X)‖ := (hnorm _).symm
      _ ≤ ∑ i, ‖Matrix.smulVec A X i‖ :=
        dependentProductL2Seminorm_le_sum_norm _
      _ ≤ ∑ i, ‖X i‖ :=
        Matrix.stateL1Norm_smulVec_le_of_mem_colStochastic X hA
      _ ≤ Real.sqrt n * ‖WithLp.toLp 2 X‖ := by
        simpa [Fintype.card_fin] using
          (sum_norm_le_sqrt_card_mul_dependentProductL2Seminorm X)
      _ = Real.sqrt n * Real.sqrt (nodeTableNormSq X) := by rw [hnorm]
  rw [Matrix.sub_one_smulVec, ← hnorm]
  calc
    ‖WithLp.toLp 2 (Matrix.smulVec A X - X)‖ =
        ‖WithLp.toLp 2 (Matrix.smulVec A X) - WithLp.toLp 2 X‖ := by
      congr 1
    _ ≤ ‖WithLp.toLp 2 (Matrix.smulVec A X)‖ + ‖WithLp.toLp 2 X‖ :=
      norm_sub_le _ _
    _ = Real.sqrt (nodeTableNormSq (Matrix.smulVec A X)) +
        Real.sqrt (nodeTableNormSq X) := by rw [hnorm, hnorm]
    _ ≤ Real.sqrt n * Real.sqrt (nodeTableNormSq X) +
        Real.sqrt (nodeTableNormSq X) := add_le_add haction le_rfl
    _ = (1 + Real.sqrt n) * Real.sqrt (nodeTableNormSq X) := by ring

/-- Source step 6's exact pathwise primal-increment prefix estimate with the
printed `K_D = 2 + 2(1+sqrt n)^2 K_R`. -/
theorem primal_increment_pathwise_prefix_energy
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (halpha : 0 ≤ alpha)
    (T : PositiveHorizon) :
    ∑ j ∈ Finset.range (T.1 - 1),
        nodeTableNormSq
          (primal S omega alpha (j + 1) - primal S omega alpha j) ≤
      alpha ^ 2 * incrementKernel S.network *
        ∑ t ∈ Finset.range T.1, nodeTableNormSq (tracker S omega alpha t) := by
  letI : Nonempty (Fin n) := ⟨⟨0, S.hn⟩⟩
  let N := T.1 - 1
  have hTN : N + 1 = T.1 := by
    dsimp [N]
    omega
  have hinc (j : ℕ) :
      primal S omega alpha (j + 1) - primal S omega alpha j =
        Matrix.smulVec (S.rowMix j - 1)
            (FiniteNetwork.consensusError (primal S omega alpha j)) -
          alpha • tracker S omega alpha j := by
    have hinnovation :
        Matrix.smulVec (S.rowMix j) (primal S omega alpha j) -
            primal S omega alpha j =
          Matrix.smulVec (S.rowMix j)
              (FiniteNetwork.consensusError (primal S omega alpha j)) -
            FiniteNetwork.consensusError (primal S omega alpha j) := by
      funext i
      simp only [Matrix.smulVec_apply, FiniteNetwork.consensusError_apply,
        Pi.sub_apply, smul_sub, Finset.sum_sub_distrib]
      rw [← Finset.sum_smul,
        Matrix.sum_row_of_mem_rowStochastic (S.row_stochastic j) i]
      simp
    rw [primal_succ, Matrix.sub_one_smulVec]
    unfold leftAct
    calc
      (Matrix.smulVec (S.rowMix j) (primal S omega alpha j) -
          alpha • tracker S omega alpha j) - primal S omega alpha j =
        (Matrix.smulVec (S.rowMix j) (primal S omega alpha j) -
          primal S omega alpha j) - alpha • tracker S omega alpha j := by abel
      _ = (Matrix.smulVec (S.rowMix j)
          (FiniteNetwork.consensusError (primal S omega alpha j)) -
            FiniteNetwork.consensusError (primal S omega alpha j)) -
          alpha • tracker S omega alpha j := by rw [hinnovation]
  have hsplit (U V : NodeTable n d) :
      nodeTableNormSq (U + V) ≤
        2 * nodeTableNormSq U + 2 * nodeTableNormSq V := by
    unfold nodeTableNormSq
    calc
      (∑ i, ‖U i + V i‖ ^ 2) ≤
          ∑ i, (2 * ‖U i‖ ^ 2 + 2 * ‖V i‖ ^ 2) := by
        apply Finset.sum_le_sum
        intro i _hi
        exact SOptLib.norm_add_sq_le_two_mul_norm_sq_add_two_mul_norm_sq
          (U i) (V i)
      _ = 2 * ∑ i, ‖U i‖ ^ 2 + 2 * ∑ i, ‖V i‖ ^ 2 := by
        rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
  have hscale (a : ℝ) (Y : NodeTable n d) :
      nodeTableNormSq (a • Y) = a ^ 2 * nodeTableNormSq Y := by
    unfold nodeTableNormSq
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _hi
    simp [norm_smul, Real.norm_eq_abs, sq_abs, mul_pow]
  have hone (j : ℕ) :
      nodeTableNormSq
          (primal S omega alpha (j + 1) - primal S omega alpha j) ≤
        2 * (1 + Real.sqrt n) ^ 2 *
            nodeTableNormSq
              (FiniteNetwork.consensusError (primal S omega alpha j)) +
          2 * alpha ^ 2 * nodeTableNormSq (tracker S omega alpha j) := by
    let E := FiniteNetwork.consensusError (primal S omega alpha j)
    let D := Matrix.smulVec (S.rowMix j - 1) E
    have hsqrt := rowStochastic_sub_identity_nodeTableNorm_le
      (S.rowMix j) (S.row_stochastic j) E
    have hD_nonneg : 0 ≤ nodeTableNormSq D :=
      Finset.sum_nonneg fun i _ => sq_nonneg ‖D i‖
    have hE_nonneg : 0 ≤ nodeTableNormSq E :=
      Finset.sum_nonneg fun i _ => sq_nonneg ‖E i‖
    have hD : nodeTableNormSq D ≤
        (1 + Real.sqrt n) ^ 2 * nodeTableNormSq E := by
      have hsD := Real.sq_sqrt hD_nonneg
      have hsE := Real.sq_sqrt hE_nonneg
      have hk : 0 ≤ 1 + Real.sqrt n := by positivity
      nlinarith [hsqrt, Real.sqrt_nonneg (nodeTableNormSq D),
        Real.sqrt_nonneg (nodeTableNormSq E)]
    rw [hinc, sub_eq_add_neg, ← neg_smul]
    change nodeTableNormSq (D + (-alpha) • tracker S omega alpha j) ≤ _
    calc
      _ ≤ 2 * nodeTableNormSq D +
          2 * nodeTableNormSq ((-alpha) • tracker S omega alpha j) :=
        hsplit D ((-alpha) • tracker S omega alpha j)
      _ = 2 * nodeTableNormSq D +
          2 * alpha ^ 2 * nodeTableNormSq (tracker S omega alpha j) := by
        rw [hscale]
        ring
      _ ≤ 2 * ((1 + Real.sqrt n) ^ 2 * nodeTableNormSq E) +
          2 * alpha ^ 2 * nodeTableNormSq (tracker S omega alpha j) := by
        gcongr
      _ = _ := by ring
  have hsum :
      (∑ j ∈ Finset.range N,
          nodeTableNormSq
            (primal S omega alpha (j + 1) - primal S omega alpha j)) ≤
        2 * (1 + Real.sqrt n) ^ 2 *
            ∑ j ∈ Finset.range N,
              nodeTableNormSq
                (FiniteNetwork.consensusError (primal S omega alpha j)) +
          2 * alpha ^ 2 *
            ∑ j ∈ Finset.range N, nodeTableNormSq (tracker S omega alpha j) := by
    calc
      _ ≤ ∑ j ∈ Finset.range N,
          (2 * (1 + Real.sqrt n) ^ 2 *
              nodeTableNormSq
                (FiniteNetwork.consensusError (primal S omega alpha j)) +
            2 * alpha ^ 2 * nodeTableNormSq (tracker S omega alpha j)) := by
        apply Finset.sum_le_sum
        intro j _hj
        exact hone j
      _ = _ := by
        rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
  have hdisPrefix :
      (∑ j ∈ Finset.range N,
          nodeTableNormSq
            (FiniteNetwork.consensusError (primal S omega alpha j))) ≤
        alpha ^ 2 * disagreementKernel S.network *
          ∑ t ∈ Finset.range T.1,
            nodeTableNormSq (tracker S omega alpha t) := by
    calc
      _ ≤ ∑ j ∈ Finset.range T.1,
          nodeTableNormSq
            (FiniteNetwork.consensusError (primal S omega alpha j)) := by
        rw [← hTN, Finset.sum_range_succ]
        exact le_add_of_nonneg_right
          (Finset.sum_nonneg fun i _ => sq_nonneg
            ‖FiniteNetwork.consensusError (primal S omega alpha N) i‖)
      _ ≤ _ := primal_disagreement_pathwise_prefix_energy
        S omega alpha halpha T
  have htrackerPrefix :
      (∑ j ∈ Finset.range N, nodeTableNormSq (tracker S omega alpha j)) ≤
        ∑ t ∈ Finset.range T.1, nodeTableNormSq (tracker S omega alpha t) := by
    rw [← hTN, Finset.sum_range_succ]
    exact le_add_of_nonneg_right
      (Finset.sum_nonneg fun i _ => sq_nonneg ‖tracker S omega alpha N i‖)
  calc
    _ ≤ 2 * (1 + Real.sqrt n) ^ 2 *
          ∑ j ∈ Finset.range N,
            nodeTableNormSq
              (FiniteNetwork.consensusError (primal S omega alpha j)) +
        2 * alpha ^ 2 *
          ∑ j ∈ Finset.range N, nodeTableNormSq (tracker S omega alpha j) := hsum
    _ ≤ 2 * (1 + Real.sqrt n) ^ 2 *
          (alpha ^ 2 * disagreementKernel S.network *
            ∑ t ∈ Finset.range T.1, nodeTableNormSq (tracker S omega alpha t)) +
        2 * alpha ^ 2 *
          ∑ t ∈ Finset.range T.1, nodeTableNormSq (tracker S omega alpha t) := by
      exact add_le_add
        (mul_le_mul_of_nonneg_left hdisPrefix
          (mul_nonneg (by norm_num) (sq_nonneg _)))
        (mul_le_mul_of_nonneg_left htrackerPrefix
          (mul_nonneg (by norm_num) (sq_nonneg alpha)))
    _ = alpha ^ 2 * incrementKernel S.network *
        ∑ t ∈ Finset.range T.1, nodeTableNormSq (tracker S omega alpha t) := by
      unfold incrementKernel
      ring

/-- The source historical-noise filter is the canonical zero-initial tracker
innovation response.  This identifies its recurrence with reusable network
infrastructure before the martingale second-moment calculation. -/
theorem filteredNoise_eq_trackerInnovationResponse
    (S : Setup n d Ω) (omega : Ω) (t : ℕ) :
    filteredNoise S omega t =
      FiniteNetwork.trackerInnovationResponse S.colMix
        (fun j => S.noise j omega) t := by
  induction t with
  | zero =>
      change (0 : NodeTable n d) =
        FiniteNetwork.trackerInnovationResponse S.colMix
          (fun j => S.noise j omega) 0
      exact (FiniteNetwork.trackerInnovationResponse_zero S.colMix
        (fun j => S.noise j omega)).symm
  | succ t ih =>
      rw [filteredNoise,
        FiniteNetwork.trackerInnovationResponse_succ_sub_one, ← ih]
      rfl

/-- Exact deterministic-coefficient Duhamel expansion of the historical
noise filter.  It is the representation whose distinct-time summands are
orthogonal by conditional centering. -/
theorem filteredNoise_duhamel
    (S : Setup n d Ω) (omega : Ω) (t : ℕ) :
    filteredNoise S omega t =
      ∑ j ∈ Finset.range t,
        Matrix.smulVec
          (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j))
          (Matrix.smulVec (S.colMix j - 1) (S.noise j omega)) := by
  classical
  induction t with
  | zero =>
      simp [filteredNoise]
  | succ t ih =>
      rw [filteredNoise, ih, Finset.sum_range_succ]
      have hdistrib :
          Matrix.smulVec (S.colMix t)
              (∑ j ∈ Finset.range t,
                Matrix.smulVec
                  (FiniteNetwork.consecutiveProduct S.colMix (j + 1)
                    (t - 1 - j))
                  (Matrix.smulVec (S.colMix j - 1) (S.noise j omega))) =
            ∑ j ∈ Finset.range t,
              Matrix.smulVec (S.colMix t)
                (Matrix.smulVec
                  (FiniteNetwork.consecutiveProduct S.colMix (j + 1)
                    (t - 1 - j))
                  (Matrix.smulVec (S.colMix j - 1) (S.noise j omega))) := by
        funext i
        simp only [Matrix.smulVec_apply, Finset.sum_apply, Finset.smul_sum]
        rw [Finset.sum_comm]
      have hterms :
          Matrix.smulVec (S.colMix t)
              (∑ j ∈ Finset.range t,
                Matrix.smulVec
                  (FiniteNetwork.consecutiveProduct S.colMix (j + 1)
                    (t - 1 - j))
                  (Matrix.smulVec (S.colMix j - 1) (S.noise j omega))) =
            ∑ j ∈ Finset.range t,
              Matrix.smulVec
                (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - j))
                (Matrix.smulVec (S.colMix j - 1) (S.noise j omega)) := by
        have haction (A B : NetworkMatrix n) (X : NodeTable n d) :
            Matrix.smulVec (A * B) X =
              Matrix.smulVec A (Matrix.smulVec B X) := by
          funext i
          simp only [Matrix.smulVec_apply, Matrix.mul_apply,
            Finset.smul_sum, Finset.sum_smul, mul_smul]
          rw [Finset.sum_comm]
        rw [hdistrib]
        apply Finset.sum_congr rfl
        intro j hj
        have hjt : j < t := Finset.mem_range.mp hj
        rw [show t - j = (t - 1 - j) + 1 by omega,
          FiniteNetwork.consecutiveProduct_succ, haction]
        congr 2
        omega
      unfold leftAct
      rw [hterms]
      apply congrArg₂ (.+.)
      · apply Finset.sum_congr rfl
        intro j hj
        congr 3
      · rw [show t + 1 - 1 - t = 0 by omega,
          FiniteNetwork.consecutiveProduct_zero]
        change Matrix.smulVec (S.colMix t - 1) (S.noise t omega) =
          Matrix.smulVec (fun i j : Fin n => if i = j then 1 else 0)
            (Matrix.smulVec (S.colMix t - 1) (S.noise t omega))
        funext i
        simp [Matrix.smulVec_apply]

/-- The conditional nodewise oracle budget aggregates to the full table
budget `n * σ²`. -/
theorem noise_nodeTable_expected_energy_le
    (S : Setup n d Ω) (t : ℕ) :
    SOptLib.expectation S.probability
        (fun omega => nodeTableNormSq (S.noise t omega)) ≤
      (n : ℝ) * S.σ ^ 2 := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  have hcoord (i : Fin n) :
      (∫ omega, ‖S.noise t omega i‖ ^ 2 ∂S.probability) ≤ S.σ ^ 2 := by
    have hm := preSamplingHistory_le S t
    rcases (S.noise_second_moment t i).1 with ⟨hm', hsf, hint⟩
    letI : SigmaFinite (S.probability.trim hm) := by
      simpa only using hsf
    have hmono :
        (∫ omega,
            MeasureTheory.condExp (preSamplingHistory S t) S.probability
              (fun omega => ‖S.noise t omega i‖ ^ 2) omega
              ∂S.probability) ≤
          ∫ _omega : Ω, S.σ ^ 2 ∂S.probability := by
      apply MeasureTheory.integral_mono_ae
      · exact MeasureTheory.integrable_condExp
      · exact integrable_const _
      · exact (S.noise_second_moment t i).2
    rw [MeasureTheory.integral_condExp hm] at hmono
    simpa using hmono
  simpa [SOptLib.expectation, nodeTableNormSq,
    SOptLib.dependentProductNormSq_def, Fintype.card_fin] using
      (integral_dependent_product_norm_sq_le_card_mul_of_coordinate_second_moment_le
        S.probability (fun omega => S.noise t omega) (S.σ ^ 2)
        (fun i => noise_norm_sq_integrable S t i) hcoord)

/-- Every deterministic propagated column-innovation response coordinate is
square integrable. -/
theorem filteredNoise_response_coordinate_memLp
    (S : Setup n d Ω) (t j : ℕ) (i : Fin n) :
    MemLp (fun omega =>
      Matrix.smulVec
        (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j))
        (Matrix.smulVec (S.colMix j - 1) (S.noise j omega)) i)
      2 S.probability := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  have hnoiseMem (k : Fin n) :
      MemLp (fun omega => S.noise j omega k) 2 S.probability :=
    (memLp_two_iff_integrable_sq_norm
      (noise_integrable S j k).aestronglyMeasurable).2
        (noise_norm_sq_integrable S j k)
  have hinnovationMem (k : Fin n) :
      MemLp (fun omega =>
        Matrix.smulVec (S.colMix j - 1) (S.noise j omega) k)
          2 S.probability := by
    have hraw := memLp_matrix_smulVec_add_of_coordinate_memLp
      (S.colMix j - 1) (fun q omega => S.noise j omega q)
      (fun _ _ => (0 : Point d)) 2 k hnoiseMem
      (memLp_const (0 : Point d) :
        MemLp (fun _ : Ω => (0 : Point d)) 2 S.probability)
    simpa [Matrix.smulVec_apply] using hraw
  have hraw := memLp_matrix_smulVec_add_of_coordinate_memLp
    (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j) :
      NetworkMatrix n)
    (fun q omega =>
      Matrix.smulVec (S.colMix j - 1) (S.noise j omega) q)
    (fun _ _ => (0 : Point d)) 2 i hinnovationMem
    (memLp_const (0 : Point d) :
      MemLp (fun _ : Ω => (0 : Point d)) 2 S.probability)
  simpa [Matrix.smulVec_apply] using hraw

/-- Distinct deterministic filter-response times are orthogonal in every
output coordinate.  The later response is a deterministic weighting of the
fresh centered noise, while the earlier response is measurable in its
pre-sampling history. -/
theorem filteredNoise_response_cross_integral_eq_zero
    (S : Setup n d Ω) (t j k : ℕ) (hjt : j < t) (hkt : k < t)
    (hjk : j ≠ k) (i : Fin n) :
    (∫ omega,
      ⟪Matrix.smulVec
          (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j))
          (Matrix.smulVec (S.colMix j - 1) (S.noise j omega)) i,
        Matrix.smulVec
          (FiniteNetwork.consecutiveProduct S.colMix (k + 1) (t - 1 - k))
          (Matrix.smulVec (S.colMix k - 1) (S.noise k omega)) i⟫_ℝ
        ∂S.probability) = 0 := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  let response (r : ℕ) (omega : Ω) : NodeTable n d :=
    Matrix.smulVec
      (FiniteNetwork.consecutiveProduct S.colMix (r + 1) (t - 1 - r))
      (Matrix.smulVec (S.colMix r - 1) (S.noise r omega))
  have hforward {a b : ℕ} (hab : a < b) (hat : a < t) (hbt : b < t) :
      (∫ omega, ⟪response a omega i, response b omega i⟫_ℝ
        ∂S.probability) = 0 := by
    have hnoise : Measurable[preSamplingHistory S b] (S.noise a) :=
      noise_measurable_preSamplingHistory_of_lt S hab
    have hadaptTable : Measurable[preSamplingHistory S b]
        (fun omega => response a omega) := by
      dsimp [response]
      exact leftAct_measurable S b
        (FiniteNetwork.consecutiveProduct S.colMix (a + 1) (t - 1 - a)) _
        (leftAct_measurable S b (S.colMix a - 1) _ hnoise)
    have hadapt : Measurable[preSamplingHistory S b]
        (fun omega => response a omega i) :=
      (measurable_pi_apply i).comp hadaptTable
    let P : NetworkMatrix n :=
      FiniteNetwork.consecutiveProduct S.colMix (b + 1) (t - 1 - b)
    let A : NetworkMatrix n := P * (S.colMix b - 1)
    have haction (X : NodeTable n d) :
        Matrix.smulVec A X =
          Matrix.smulVec P (Matrix.smulVec (S.colMix b - 1) X) := by
      funext q
      simp only [A, Matrix.smulVec_apply, Matrix.mul_apply,
        Finset.smul_sum, Finset.sum_smul, mul_smul]
      rw [Finset.sum_comm]
    have hresponseEq :
        (fun omega => response b omega i) =
          fun omega => ∑ q, A i q • S.noise b omega q := by
      funext omega
      dsimp [response, P]
      rw [← haction]
      rfl
    have hcenter :=
      (weighted_noise_conditional_moments S b (fun q => A i q)).1
    have hcenterAe :
        MeasureTheory.condExp (preSamplingHistory S b) S.probability
          (fun omega => response b omega i) =ᵐ[S.probability]
            fun _ => (0 : Point d) := by
      rw [hresponseEq]
      exact hcenter.ae_eq
    rcases hcenter.wellDefined with ⟨hm, hsf, _hweightedInt⟩
    letI : SigmaFinite (S.probability.trim hm) := by
      simpa only using hsf
    have haMem := filteredNoise_response_coordinate_memLp S t a i
    have hbMem := filteredNoise_response_coordinate_memLp S t b i
    have hinner : Integrable
        (fun omega => ⟪response b omega i, response a omega i⟫_ℝ)
        S.probability :=
      integrable_inner_of_integrable_sq_norm
        hbMem.aestronglyMeasurable haMem.aestronglyMeasurable
        ((memLp_two_iff_integrable_sq_norm hbMem.aestronglyMeasurable).1 hbMem)
        ((memLp_two_iff_integrable_sq_norm haMem.aestronglyMeasurable).1 haMem)
    have hinnerSub : Integrable
        (fun omega => ⟪response b omega i,
          response a omega i - (0 : Point d)⟫_ℝ) S.probability := by
      simpa only [sub_zero] using hinner
    have hzero := integral_inner_sub_const_eq_zero_of_condExp_eq_zero
      (P := S.probability) (m := preSamplingHistory S b)
      (δ := fun omega => response b omega i)
      (x := fun omega => response a omega i) (c := (0 : Point d))
      (preSamplingHistory_le S b) hadapt hcenterAe
      (hbMem.integrable (by norm_num)) hinnerSub
    calc
      (∫ omega, ⟪response a omega i, response b omega i⟫_ℝ
          ∂S.probability) =
          ∫ omega, ⟪response b omega i, response a omega i⟫_ℝ
            ∂S.probability := by
        apply MeasureTheory.integral_congr_ae
        exact Filter.Eventually.of_forall fun omega => real_inner_comm _ _
      _ = ∫ omega, ⟪response b omega i,
          response a omega i - (0 : Point d)⟫_ℝ ∂S.probability := by
        congr 1
        funext omega
        rw [sub_zero]
      _ = 0 := hzero
  change (∫ omega, ⟪response j omega i, response k omega i⟫_ℝ
    ∂S.probability) = 0
  rcases lt_or_gt_of_ne hjk with hjk' | hkj'
  · exact hforward hjk' hjt hkt
  · have hz := hforward hkj' hkt hjt
    calc
      (∫ omega, ⟪response j omega i, response k omega i⟫_ℝ
          ∂S.probability) =
          ∫ omega, ⟪response k omega i, response j omega i⟫_ℝ
            ∂S.probability := by
        apply MeasureTheory.integral_congr_ae
        exact Filter.Eventually.of_forall fun omega => real_inner_comm _ _
      _ = 0 := hz

/-- One past deterministic filter response has the printed geometric
second-moment bound.  This is the diagonal term used after martingale
orthogonality removes all distinct-time cross terms. -/
theorem filteredNoise_response_term_expected_energy_le
    (S : Setup n d Ω) (t j : ℕ) (hjt : j < t) :
    SOptLib.expectation S.probability (fun omega =>
        nodeTableNormSq
          (Matrix.smulVec
            (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j))
            (Matrix.smulVec (S.colMix j - 1) (S.noise j omega)))) ≤
      columnMixingConstant S.network ^ 2 * (1 + Real.sqrt n) ^ 2 *
        (mixingRate S.network ^ 2) ^ (t - 1 - j) *
          ((n : ℝ) * S.σ ^ 2) := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  have hnoiseMem (k : ℕ) (i : Fin n) :
      MemLp (fun omega => S.noise k omega i) 2 S.probability :=
    (memLp_two_iff_integrable_sq_norm
      (noise_integrable S k i).aestronglyMeasurable).2
        (noise_norm_sq_integrable S k i)
  have hinnovationMem (k : ℕ) (i : Fin n) :
      MemLp (fun omega =>
        Matrix.smulVec (S.colMix k - 1) (S.noise k omega) i)
          2 S.probability := by
    have hraw := memLp_matrix_smulVec_add_of_coordinate_memLp
      (S.colMix k - 1) (fun q omega => S.noise k omega q)
      (fun _ _ => (0 : Point d)) 2 i
      (fun q => hnoiseMem k q)
      (memLp_const (0 : Point d) :
        MemLp (fun _ : Ω => (0 : Point d)) 2 S.probability)
    simpa [Matrix.smulVec_apply] using hraw
  have hresponseMem (i : Fin n) :
      MemLp (fun omega =>
        Matrix.smulVec
          (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j))
          (Matrix.smulVec (S.colMix j - 1) (S.noise j omega)) i)
          2 S.probability := by
    have hraw := memLp_matrix_smulVec_add_of_coordinate_memLp
      (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j) :
        NetworkMatrix n)
      (fun q omega =>
        Matrix.smulVec (S.colMix j - 1) (S.noise j omega) q)
      (fun _ _ => (0 : Point d)) 2 i
      (fun q => hinnovationMem j q)
      (memLp_const (0 : Point d) :
        MemLp (fun _ : Ω => (0 : Point d)) 2 S.probability)
    simpa [Matrix.smulVec_apply] using hraw
  have hresponseIntegrable : Integrable (fun omega =>
      SOptLib.dependentProductNormSq
        (Matrix.smulVec
          (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j))
          (Matrix.smulVec (S.colMix j - 1) (S.noise j omega))))
        S.probability :=
    (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
      (fun omega =>
        Matrix.smulVec
          (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j))
          (Matrix.smulVec (S.colMix j - 1) (S.noise j omega)))
      hresponseMem).1
  have hinputIntegrable : Integrable (fun omega =>
      SOptLib.dependentProductNormSq (S.noise j omega)) S.probability :=
    (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
      (fun omega => S.noise j omega) (hnoiseMem j)).1
  have hraw := SOptLib.response_term_second_moment_le_of_geometric_action_bounds
    S.probability (fun k omega => S.noise k omega)
    (fun s ell X => Matrix.smulVec
      (FiniteNetwork.consecutiveProduct S.colMix s ell) X)
    (fun s X => Matrix.smulVec (S.colMix s - 1) X)
    (fun X : NodeTable n d => ∑ i, X i = 0)
    (columnMixingConstant S.network) (1 + Real.sqrt n)
    (mixingRate S.network) ((n : ℝ) * S.σ ^ 2) t j
    (by
      unfold columnMixingConstant
      exact div_nonneg (Real.sqrt_nonneg _) (blockContraction_pos S.network).le)
    (by positivity)
    (mixingRate_nonneg S.network)
    (fun s ell X hX => point_colMix_nodeTableNorm_geometric S.network s ell
      ⟨X, hX⟩)
    (fun s X => Matrix.sum_sub_one_smulVec_eq_zero_of_mem_colStochastic
      X (S.col_stochastic s))
    (fun s X => colStochastic_sub_identity_nodeTableNorm_le
      (S.colMix s) (S.col_stochastic s) X)
    (by simpa [hjt.ne] using hresponseIntegrable)
    hinputIntegrable
    (by simpa [SOptLib.expectation, nodeTableNormSq,
      SOptLib.dependentProductNormSq_def] using
        (noise_nodeTable_expected_energy_le S j))
  simpa [SOptLib.expectation, nodeTableNormSq,
    SOptLib.dependentProductNormSq_def, hjt.ne] using hraw

/-- The historical noise filter has the source's uniform `B_E σ²` second
moment.  The exact Duhamel sum is diagonalized using distinct-time martingale
orthogonality, and its diagonal geometric mass is summed sharply with ratio
`ρ²`. -/
theorem filteredNoise_expected_energy_le
    (S : Setup n d Ω) (t : ℕ) :
    SOptLib.expectation S.probability
        (fun omega => nodeTableNormSq (filteredNoise S omega t)) ≤
      filteredNoiseKernel S.network * S.σ ^ 2 := by
  classical
  let response (j : ℕ) (omega : Ω) : NodeTable n d :=
    Matrix.smulVec
      (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j))
      (Matrix.smulVec (S.colMix j - 1) (S.noise j omega))
  have hmem (j : ℕ) (i : Fin n) :
      MemLp (fun omega => response j omega i) 2 S.probability := by
    exact filteredNoise_response_coordinate_memLp S t j i
  have hdiag :
      (∫ omega, SOptLib.dependentProductNormSq
          (∑ j ∈ Finset.range t, response j omega) ∂S.probability) =
        ∑ j ∈ Finset.range t,
          ∫ omega, SOptLib.dependentProductNormSq (response j omega)
            ∂S.probability := by
    exact integral_dependentProductNormSq_finset_sum_eq_sum_integrals_of_cross_zero
      S.probability (Finset.range t) response
      (fun j _hj i => (hmem j i).aestronglyMeasurable)
      (fun j _hj i =>
        (memLp_two_iff_integrable_sq_norm
          (hmem j i).aestronglyMeasurable).1 (hmem j i))
      (fun i j hj k hk hjk =>
        filteredNoise_response_cross_integral_eq_zero S t j k
          (Finset.mem_range.mp hj) (Finset.mem_range.mp hk) hjk i)
  let theta := mixingRate S.network ^ 2
  let Lnoise := columnMixingConstant S.network ^ 2 *
    (1 + Real.sqrt n) ^ 2 * ((n : ℝ) * S.σ ^ 2)
  have htheta_nonneg : 0 ≤ theta := sq_nonneg _
  have htheta_lt : theta < 1 := by
    dsimp [theta]
    nlinarith [mixingRate_nonneg S.network, mixingRate_lt_one S.network]
  have hLnoise : 0 ≤ Lnoise := by
    dsimp [Lnoise]
    positivity
  have hduhamel :
      (fun omega => filteredNoise S omega t) =
        fun omega => ∑ j ∈ Finset.range t, response j omega := by
    funext omega
    simpa [response] using filteredNoise_duhamel S omega t
  calc
    SOptLib.expectation S.probability
        (fun omega => nodeTableNormSq (filteredNoise S omega t)) =
        ∫ omega, SOptLib.dependentProductNormSq
          (∑ j ∈ Finset.range t, response j omega) ∂S.probability := by
      unfold SOptLib.expectation
      apply MeasureTheory.integral_congr_ae
      exact Filter.Eventually.of_forall fun omega => by
        change nodeTableNormSq (filteredNoise S omega t) =
          SOptLib.dependentProductNormSq
            (∑ j ∈ Finset.range t, response j omega)
        rw [congrFun hduhamel omega]
        rfl
    _ = ∑ j ∈ Finset.range t,
          ∫ omega, SOptLib.dependentProductNormSq (response j omega)
            ∂S.probability := hdiag
    _ ≤ ∑ j ∈ Finset.range t,
          theta ^ (t - 1 - j) * Lnoise := by
      apply Finset.sum_le_sum
      intro j hj
      have hterm := filteredNoise_response_term_expected_energy_le S t j
        (Finset.mem_range.mp hj)
      dsimp [response, theta, Lnoise]
      simpa [SOptLib.expectation, nodeTableNormSq,
        SOptLib.dependentProductNormSq_def, mul_assoc, mul_comm, mul_left_comm]
        using hterm
    _ ≤ Lnoise / (1 - theta) :=
      sum_range_geometric_reverse_mul_le_div_one_sub
        theta Lnoise t htheta_nonneg htheta_lt hLnoise
    _ = filteredNoiseKernel S.network * S.σ ^ 2 := by
      dsimp [Lnoise, theta]
      unfold filteredNoiseKernel
      ring

/-- Current plus historical oracle noise has the source's `B_Y σ²`
budget. -/
theorem current_and_filtered_noise_expected_energy_le
    (S : Setup n d Ω) (t : ℕ) :
    SOptLib.expectation S.probability (fun omega =>
        nodeTableNormSq (S.noise t omega + filteredNoise S omega t)) ≤
      currentNoiseKernel S.network * S.σ ^ 2 := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  have hnoiseMem (i : Fin n) :
      MemLp (fun omega => S.noise t omega i) 2 S.probability :=
    (memLp_two_iff_integrable_sq_norm
      (noise_integrable S t i).aestronglyMeasurable).2
        (noise_norm_sq_integrable S t i)
  have hfilterMem (i : Fin n) :
      MemLp (fun omega => filteredNoise S omega t i) 2 S.probability := by
    have hsum' : MemLp (fun omega =>
        ∑ j ∈ Finset.range t,
          Matrix.smulVec
            (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j))
            (Matrix.smulVec (S.colMix j - 1) (S.noise j omega)) i)
        2 S.probability := by
      apply memLp_finset_sum (Finset.range t)
      intro j hj
      exact filteredNoise_response_coordinate_memLp S t j i
    have hsum : MemLp (fun omega =>
        (∑ j ∈ Finset.range t,
          Matrix.smulVec
            (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j))
            (Matrix.smulVec (S.colMix j - 1) (S.noise j omega))) i)
        2 S.probability := by
      simpa only [Finset.sum_apply] using hsum'
    refine MemLp.ae_eq ?_ hsum
    exact Filter.Eventually.of_forall fun omega => by
      change (∑ j ∈ Finset.range t,
          Matrix.smulVec
            (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j))
            (Matrix.smulVec (S.colMix j - 1) (S.noise j omega))) i =
        filteredNoise S omega t i
      rw [filteredNoise_duhamel S omega t]
  have hnoiseEnergyInt : Integrable (fun omega =>
      nodeTableNormSq (S.noise t omega)) S.probability := by
    simpa [nodeTableNormSq, SOptLib.dependentProductNormSq_def] using
      (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
        (fun omega => S.noise t omega) hnoiseMem).1
  have hfilterEnergyInt : Integrable (fun omega =>
      nodeTableNormSq (filteredNoise S omega t)) S.probability := by
    simpa [nodeTableNormSq, SOptLib.dependentProductNormSq_def] using
      (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
        (fun omega => filteredNoise S omega t) hfilterMem).1
  have hsumEnergyInt : Integrable (fun omega =>
      nodeTableNormSq (S.noise t omega + filteredNoise S omega t))
      S.probability := by
    simpa [nodeTableNormSq, SOptLib.dependentProductNormSq_def] using
      (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
        (fun omega => S.noise t omega + filteredNoise S omega t)
        (fun i => (hnoiseMem i).add (hfilterMem i))).1
  have hpoint (omega : Ω) :
      nodeTableNormSq (S.noise t omega + filteredNoise S omega t) ≤
        2 * nodeTableNormSq (S.noise t omega) +
          2 * nodeTableNormSq (filteredNoise S omega t) := by
    unfold nodeTableNormSq
    calc
      (∑ i, ‖(S.noise t omega + filteredNoise S omega t) i‖ ^ 2) ≤
          ∑ i, (2 * ‖S.noise t omega i‖ ^ 2 +
            2 * ‖filteredNoise S omega t i‖ ^ 2) := by
        apply Finset.sum_le_sum
        intro i hi
        simpa only [Pi.add_apply] using
          SOptLib.norm_add_sq_le_two_mul_norm_sq_add_two_mul_norm_sq
            (S.noise t omega i) (filteredNoise S omega t i)
      _ = 2 * ∑ i, ‖S.noise t omega i‖ ^ 2 +
          2 * ∑ i, ‖filteredNoise S omega t i‖ ^ 2 := by
        rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
  have hintegral :
      SOptLib.expectation S.probability (fun omega =>
          nodeTableNormSq (S.noise t omega + filteredNoise S omega t)) ≤
        2 * SOptLib.expectation S.probability
              (fun omega => nodeTableNormSq (S.noise t omega)) +
          2 * SOptLib.expectation S.probability
              (fun omega => nodeTableNormSq (filteredNoise S omega t)) := by
    unfold SOptLib.expectation
    calc
      (∫ omega,
          nodeTableNormSq (S.noise t omega + filteredNoise S omega t)
            ∂S.probability) ≤
          ∫ omega, 2 * nodeTableNormSq (S.noise t omega) +
            2 * nodeTableNormSq (filteredNoise S omega t)
              ∂S.probability := by
        apply MeasureTheory.integral_mono hsumEnergyInt
          ((hnoiseEnergyInt.const_mul 2).add
            (hfilterEnergyInt.const_mul 2))
        exact hpoint
      _ = 2 * (∫ omega, nodeTableNormSq (S.noise t omega)
              ∂S.probability) +
            2 * (∫ omega, nodeTableNormSq (filteredNoise S omega t)
              ∂S.probability) := by
        rw [MeasureTheory.integral_add (hnoiseEnergyInt.const_mul 2)
          (hfilterEnergyInt.const_mul 2),
          MeasureTheory.integral_const_mul,
          MeasureTheory.integral_const_mul]
  calc
    _ ≤ 2 * SOptLib.expectation S.probability
          (fun omega => nodeTableNormSq (S.noise t omega)) +
        2 * SOptLib.expectation S.probability
          (fun omega => nodeTableNormSq (filteredNoise S omega t)) := hintegral
    _ ≤ 2 * ((n : ℝ) * S.σ ^ 2) +
        2 * (filteredNoiseKernel S.network * S.σ ^ 2) := by
      gcongr
      · exact noise_nodeTable_expected_energy_le S t
      · exact filteredNoise_expected_energy_le S t
    _ = currentNoiseKernel S.network * S.σ ^ 2 := by
      unfold currentNoiseKernel
      ring

/-- The historical noise filter has coordinatewise finite second moments. -/
theorem filteredNoise_coordinate_memLp_two
    (S : Setup n d Ω) (t : ℕ) (i : Fin n) :
    MemLp (fun omega => filteredNoise S omega t i) 2 S.probability := by
  have hsum' : MemLp (fun omega =>
      ∑ j ∈ Finset.range t,
        Matrix.smulVec
          (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j))
          (Matrix.smulVec (S.colMix j - 1) (S.noise j omega)) i)
      2 S.probability := by
    apply memLp_finset_sum (Finset.range t)
    intro j hj
    exact filteredNoise_response_coordinate_memLp S t j i
  have hsum : MemLp (fun omega =>
      (∑ j ∈ Finset.range t,
        Matrix.smulVec
          (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j))
          (Matrix.smulVec (S.colMix j - 1) (S.noise j omega))) i)
      2 S.probability := by
    simpa only [Finset.sum_apply] using hsum'
  refine MemLp.ae_eq ?_ hsum
  exact Filter.Eventually.of_forall fun omega => by
    change (∑ j ∈ Finset.range t,
        Matrix.smulVec
          (FiniteNetwork.consecutiveProduct S.colMix (j + 1) (t - 1 - j))
          (Matrix.smulVec (S.colMix j - 1) (S.noise j omega))) i =
      filteredNoise S omega t i
    rw [filteredNoise_duhamel S omega t]

/-- Source step 9 before summing in time and expectation: the tracker splits
into corrected disagreement, the normalized aggregate exact gradient, and the
current-plus-filtered oracle noise. -/
theorem tracker_feedback_energy_pointwise
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (t : ℕ) :
    nodeTableNormSq (tracker S omega alpha t) ≤
      3 * nodeTableNormSq
        (correctedTrackerDisagreement S omega alpha t) +
      6 * (n : ℝ) * S.L ^ 2 * nodeTableNormSq
        (FiniteNetwork.consensusError (primal S omega alpha t)) +
      12 * (n : ℝ) ^ 2 * S.L ^ 2 *
        ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2 +
      12 * (n : ℝ) ^ 2 *
        ‖gradient (averageObjective S) (correctedCenter S omega alpha t)‖ ^ 2 +
      3 * nodeTableNormSq
        (S.noise t omega + filteredNoise S omega t) := by
  classical
  let v := normalizedPushMass S.network t
  let g : Point d := ∑ j, gradientTable S omega alpha t j
  let HZ := correctedTrackerDisagreement S omega alpha t
  let E := S.noise t omega + filteredNoise S omega t
  have hv : v ∈ stdSimplex ℝ (Fin n) := by
    simpa [v] using normalizedPushMass_mem_stdSimplex_for_tracker S.network t
  have hgInvariant : g = ∑ i, correctedTracker S omega alpha t i := by
    simpa [g] using
      (correctedTracker_sum_eq_gradientTable_sum S omega alpha t).symm
  have htracker : tracker S omega alpha t = HZ + (fun i => v i • g) + E := by
    funext i
    rw [hgInvariant, correctedTracker_sum_eq_gradientTable_sum]
    dsimp [HZ, E, v, correctedTrackerDisagreement, correctedTracker]
    module
  have hsimplexEnergy :
      nodeTableNormSq (fun i => v i • g) ≤ ‖g‖ ^ 2 := by
    have hv_le_one (i : Fin n) : v i ≤ 1 :=
      (mem_Icc_of_mem_stdSimplex hv i).2
    have hsq : (∑ i : Fin n, v i ^ 2) ≤ 1 := by
      calc
        (∑ i : Fin n, v i ^ 2) ≤ ∑ i : Fin n, v i := by
          apply Finset.sum_le_sum
          intro i _hi
          have hvi := hv.1 i
          have hvi1 := hv_le_one i
          nlinarith
        _ = 1 := hv.2
    unfold nodeTableNormSq
    calc
      (∑ i : Fin n, ‖v i • g‖ ^ 2) =
          (∑ i : Fin n, v i ^ 2) * ‖g‖ ^ 2 := by
        rw [Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro i _hi
        simp [norm_smul, Real.norm_eq_abs, sq_abs, mul_pow]
      _ ≤ 1 * ‖g‖ ^ 2 :=
        mul_le_mul_of_nonneg_right hsq (sq_nonneg ‖g‖)
      _ = ‖g‖ ^ 2 := one_mul _
  have haggregate :
      ‖g‖ ^ 2 ≤
        2 * (n : ℝ) ^ 2 *
            ‖gradient (averageObjective S) (arithmeticMean S omega alpha t)‖ ^ 2 +
          2 * (n : ℝ) * S.L ^ 2 *
            nodeTableNormSq
              (FiniteNetwork.consensusError (primal S omega alpha t)) := by
    have hraw :=
      SOptLib.norm_sq_sum_map_le_mean_map_add_centered_energy_of_pointwise_lipschitz
        (fun i => gradient (S.localObjective i))
        (primal S omega alpha t) (arithmeticMean S omega alpha t) S.L
        (fun i => by
          simpa using (S.local_smooth i).2.norm_sub_le
            (primal S omega alpha t i) (arithmeticMean S omega alpha t))
    have havg :
        (n : ℝ)⁻¹ • ∑ i : Fin n,
            gradient (S.localObjective i) (arithmeticMean S omega alpha t) =
          gradient (averageObjective S) (arithmeticMean S omega alpha t) := by
      have hfun : averageObjective S =
          SOptLib.finiteUniformAverage S.localObjective := by
        funext x
        simp [averageObjective, SOptLib.finiteUniformAverage_def,
          Fintype.card_fin, smul_eq_mul]
      have h := SOptLib.gradient_finiteUniformAverage_eq_finiteUniformAverage_gradient
        S.localObjective (fun i x => gradient (S.localObjective i) x)
        (arithmeticMean S omega alpha t)
        (fun i => ((S.local_smooth i).1 _).hasGradientAt)
      rw [hfun]
      simpa [SOptLib.finiteUniformAverage_def, Fintype.card_fin] using h.symm
    simpa [g, gradientTable, nodeTableNormSq,
      FiniteNetwork.consensusError_apply, FiniteNetwork.meanState,
      SOptLib.finiteUniformAverage_def, Fintype.card_fin, havg] using hraw
  have havgGradient (x : Point d) :
      gradient (averageObjective S) x =
        (n : ℝ)⁻¹ • ∑ i : Fin n, gradient (S.localObjective i) x := by
    have hfun : averageObjective S =
        SOptLib.finiteUniformAverage S.localObjective := by
      funext y
      simp [averageObjective, SOptLib.finiteUniformAverage_def,
        Fintype.card_fin, smul_eq_mul]
    have h := SOptLib.gradient_finiteUniformAverage_eq_finiteUniformAverage_gradient
      S.localObjective (fun i y => gradient (S.localObjective i) y) x
      (fun i => ((S.local_smooth i).1 _).hasGradientAt)
    rw [hfun]
    simpa [SOptLib.finiteUniformAverage_def, Fintype.card_fin] using h
  have havgLip :
      ‖gradient (averageObjective S) (arithmeticMean S omega alpha t) -
          gradient (averageObjective S) (correctedCenter S omega alpha t)‖ ≤
        S.L * ‖arithmeticMean S omega alpha t - correctedCenter S omega alpha t‖ := by
    rw [havgGradient, havgGradient, ← smul_sub, ← Finset.sum_sub_distrib,
      norm_smul, Real.norm_eq_abs, abs_of_nonneg (inv_nonneg.mpr
        (Nat.cast_nonneg n))]
    calc
      (n : ℝ)⁻¹ *
          ‖∑ i : Fin n,
            (gradient (S.localObjective i) (arithmeticMean S omega alpha t) -
              gradient (S.localObjective i) (correctedCenter S omega alpha t))‖ ≤
          (n : ℝ)⁻¹ *
            ∑ i : Fin n,
              ‖gradient (S.localObjective i) (arithmeticMean S omega alpha t) -
                gradient (S.localObjective i) (correctedCenter S omega alpha t)‖ := by
        exact mul_le_mul_of_nonneg_left
          (norm_sum_le Finset.univ fun i : Fin n =>
            gradient (S.localObjective i) (arithmeticMean S omega alpha t) -
              gradient (S.localObjective i) (correctedCenter S omega alpha t))
          (inv_nonneg.mpr (Nat.cast_nonneg n))
      _ ≤ (n : ℝ)⁻¹ *
            ∑ _i : Fin n,
              S.L * ‖arithmeticMean S omega alpha t -
                correctedCenter S omega alpha t‖ := by
        apply mul_le_mul_of_nonneg_left _ (inv_nonneg.mpr (Nat.cast_nonneg n))
        apply Finset.sum_le_sum
        intro i _hi
        exact (S.local_smooth i).2.norm_sub_le _ _
      _ = S.L * ‖arithmeticMean S omega alpha t -
            correctedCenter S omega alpha t‖ := by
        simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin,
          nsmul_eq_mul]
        have hn : (n : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt S.hn)
        field_simp
  have hmeanToCenter :
      ‖gradient (averageObjective S) (arithmeticMean S omega alpha t)‖ ^ 2 ≤
        2 * S.L ^ 2 *
            ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2 +
          2 * ‖gradient (averageObjective S)
            (correctedCenter S omega alpha t)‖ ^ 2 := by
    have hadd := SOptLib.norm_add_sq_le_two_mul_norm_sq_add_two_mul_norm_sq
      (gradient (averageObjective S) (arithmeticMean S omega alpha t) -
        gradient (averageObjective S) (correctedCenter S omega alpha t))
      (gradient (averageObjective S) (correctedCenter S omega alpha t))
    have hdiffsq :
        ‖gradient (averageObjective S) (arithmeticMean S omega alpha t) -
            gradient (averageObjective S) (correctedCenter S omega alpha t)‖ ^ 2 ≤
          S.L ^ 2 * ‖arithmeticMean S omega alpha t -
            correctedCenter S omega alpha t‖ ^ 2 := by
      have hnonneg : 0 ≤ S.L * ‖arithmeticMean S omega alpha t -
          correctedCenter S omega alpha t‖ :=
        mul_nonneg S.hL.le (norm_nonneg _)
      simpa [mul_pow] using
        ((sq_le_sq₀ (norm_nonneg _) hnonneg).2 havgLip)
    rw [sub_add_cancel] at hadd
    calc
      _ ≤ 2 *
          ‖gradient (averageObjective S) (arithmeticMean S omega alpha t) -
            gradient (averageObjective S) (correctedCenter S omega alpha t)‖ ^ 2 +
          2 * ‖gradient (averageObjective S)
            (correctedCenter S omega alpha t)‖ ^ 2 := hadd
      _ ≤ 2 * (S.L ^ 2 * ‖arithmeticMean S omega alpha t -
            correctedCenter S omega alpha t‖ ^ 2) +
          2 * ‖gradient (averageObjective S)
            (correctedCenter S omega alpha t)‖ ^ 2 := by
        gcongr
      _ = 2 * S.L ^ 2 *
            ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2 +
          2 * ‖gradient (averageObjective S)
            (correctedCenter S omega alpha t)‖ ^ 2 := by
        rw [norm_sub_rev]
        ring
  have haggregateFinal :
      ‖g‖ ^ 2 ≤
        2 * (n : ℝ) * S.L ^ 2 * nodeTableNormSq
            (FiniteNetwork.consensusError (primal S omega alpha t)) +
          4 * (n : ℝ) ^ 2 * S.L ^ 2 *
            ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2 +
          4 * (n : ℝ) ^ 2 *
            ‖gradient (averageObjective S) (correctedCenter S omega alpha t)‖ ^ 2 := by
    calc
      _ ≤ 2 * (n : ℝ) ^ 2 *
            ‖gradient (averageObjective S) (arithmeticMean S omega alpha t)‖ ^ 2 +
          2 * (n : ℝ) * S.L ^ 2 * nodeTableNormSq
            (FiniteNetwork.consensusError (primal S omega alpha t)) := haggregate
      _ ≤ 2 * (n : ℝ) ^ 2 *
            (2 * S.L ^ 2 *
                ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2 +
              2 * ‖gradient (averageObjective S)
                (correctedCenter S omega alpha t)‖ ^ 2) +
          2 * (n : ℝ) * S.L ^ 2 * nodeTableNormSq
            (FiniteNetwork.consensusError (primal S omega alpha t)) := by
        gcongr
      _ = _ := by ring
  rw [htracker]
  have hthree := SOptLib.dependentProductNormSq_add_add_le_three
    HZ (fun i => v i • g) E
  change nodeTableNormSq (HZ + (fun i => v i • g) + E) ≤ _
  calc
    nodeTableNormSq (HZ + (fun i => v i • g) + E) ≤
        3 * nodeTableNormSq HZ +
          3 * nodeTableNormSq (fun i => v i • g) +
            3 * nodeTableNormSq E := by
      simpa [nodeTableNormSq] using hthree
    _ ≤ 3 * nodeTableNormSq HZ + 3 * ‖g‖ ^ 2 +
          3 * nodeTableNormSq E := by
      gcongr
    _ ≤ 3 * nodeTableNormSq HZ +
          3 * (2 * (n : ℝ) * S.L ^ 2 * nodeTableNormSq
              (FiniteNetwork.consensusError (primal S omega alpha t)) +
            4 * (n : ℝ) ^ 2 * S.L ^ 2 *
              ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2 +
            4 * (n : ℝ) ^ 2 *
              ‖gradient (averageObjective S)
                (correctedCenter S omega alpha t)‖ ^ 2) +
          3 * nodeTableNormSq E := by
      gcongr
    _ = _ := by
      dsimp [HZ, E]
      ring

/-- Source step 14 before expectation: the predictable corrected-center drift
splits into the normalized local-gradient discrepancy, the corrected-center
displacement, and the Perron-weighted corrected tracker disagreement. -/
theorem corrected_drift_energy_pointwise
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (t : ℕ) :
    ‖correctedDrift S omega alpha t‖ ^ 2 ≤
      3 * (n : ℝ) * S.L ^ 2 *
        nodeTableNormSq
          (FiniteNetwork.consensusError (primal S omega alpha t)) +
      3 * (n : ℝ) ^ 2 * S.L ^ 2 *
        ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2 +
      3 * nodeTableNormSq
        (correctedTrackerDisagreement S omega alpha t) := by
  classical
  let k := gain S.network t
  let xbar := arithmeticMean S omega alpha t
  let z := correctedCenter S omega alpha t
  let A : Point d :=
    (n : ℝ)⁻¹ • (∑ i, gradientTable S omega alpha t i) -
      gradient (averageObjective S) xbar
  let B : Point d :=
    gradient (averageObjective S) xbar - gradient (averageObjective S) z
  let C : Point d :=
    ∑ i, (absoluteProbability S.network (t + 1) i) •
      correctedTrackerDisagreement S omega alpha t i
  have hn : (n : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt S.hn)
  have hpi := absoluteProbability_mem_stdSimplex S.network (t + 1)
  have hpush_nonneg : ∀ r i, 0 ≤ pushMass S.network r i := by
    intro r
    induction r with
    | zero => intro i; simp [pushMass]
    | succ r ihr =>
        intro i
        rw [pushMass_succ]
        exact Matrix.nonneg_mulVec_of_mem_colStochastic
          (S.col_stochastic r) ihr i
  have hpush_sum : ∀ r, ∑ i, pushMass S.network r i = (n : ℝ) := by
    intro r
    induction r with
    | zero => simp [pushMass]
    | succ r ihr =>
        rw [pushMass_succ,
          Matrix.sum_mulVec_of_mem_colStochastic (S.col_stochastic r), ihr]
  have hk_nonneg : 0 ≤ k := by
    dsimp [k]
    unfold gain dotProduct
    exact Finset.sum_nonneg fun i _ =>
      mul_nonneg (hpi.1 i) (hpush_nonneg t i)
  have hk_le : k ≤ (n : ℝ) := by
    have hmass_le (i : Fin n) : pushMass S.network t i ≤ (n : ℝ) := by
      calc
        pushMass S.network t i ≤ ∑ j, pushMass S.network t j :=
          Finset.single_le_sum (fun j _ => hpush_nonneg t j)
            (Finset.mem_univ i)
        _ = (n : ℝ) := hpush_sum t
    dsimp [k]
    unfold gain dotProduct
    calc
      ∑ i, absoluteProbability S.network (t + 1) i *
            pushMass S.network t i ≤
          ∑ i, absoluteProbability S.network (t + 1) i * (n : ℝ) := by
        exact Finset.sum_le_sum fun i _ =>
          mul_le_mul_of_nonneg_left (hmass_le i) (hpi.1 i)
      _ = (n : ℝ) := by
        rw [← Finset.sum_mul, hpi.2]
        ring
  have hk_sq : k ^ 2 ≤ (n : ℝ) ^ 2 := by
    exact (sq_le_sq₀ hk_nonneg (Nat.cast_nonneg n)).2 hk_le
  have havgGradient (x : Point d) :
      gradient (averageObjective S) x =
        (n : ℝ)⁻¹ • ∑ i : Fin n, gradient (S.localObjective i) x := by
    have hfun : averageObjective S =
        SOptLib.finiteUniformAverage S.localObjective := by
      funext y
      simp [averageObjective, SOptLib.finiteUniformAverage_def,
        Fintype.card_fin, smul_eq_mul]
    have h := SOptLib.gradient_finiteUniformAverage_eq_finiteUniformAverage_gradient
      S.localObjective (fun i y => gradient (S.localObjective i) y) x
      (fun i => ((S.local_smooth i).1 _).hasGradientAt)
    rw [hfun]
    simpa [SOptLib.finiteUniformAverage_def, Fintype.card_fin] using h
  have hAeq : A = (n : ℝ)⁻¹ • ∑ i : Fin n,
      (gradient (S.localObjective i) (primal S omega alpha t i) -
        gradient (S.localObjective i) xbar) := by
    dsimp [A, gradientTable]
    rw [havgGradient, ← smul_sub, ← Finset.sum_sub_distrib]
  have hA : ‖A‖ ^ 2 ≤ (n : ℝ)⁻¹ * S.L ^ 2 *
      nodeTableNormSq
        (FiniteNetwork.consensusError (primal S omega alpha t)) := by
    rw [hAeq]
    calc
      ‖(n : ℝ)⁻¹ • ∑ i : Fin n,
          (gradient (S.localObjective i) (primal S omega alpha t i) -
            gradient (S.localObjective i) xbar)‖ ^ 2 ≤
          (n : ℝ)⁻¹ * ∑ i : Fin n,
            ‖gradient (S.localObjective i) (primal S omega alpha t i) -
              gradient (S.localObjective i) xbar‖ ^ 2 := by
        simpa [Fintype.card_fin] using
          (norm_sq_inv_card_smul_sum_le_inv_card_mul_sum_norm_sq
            (Finset.univ : Finset (Fin n))
            (fun i => gradient (S.localObjective i) (primal S omega alpha t i) -
              gradient (S.localObjective i) xbar)
            (by simpa [Fintype.card_fin] using S.hn))
      _ ≤ (n : ℝ)⁻¹ * ∑ i : Fin n,
            (S.L ^ 2 * ‖primal S omega alpha t i - xbar‖ ^ 2) := by
        apply mul_le_mul_of_nonneg_left _ (inv_nonneg.mpr (Nat.cast_nonneg n))
        apply Finset.sum_le_sum
        intro i _hi
        have hl := (S.local_smooth i).2.norm_sub_le
          (primal S omega alpha t i) xbar
        have hsquare := (sq_le_sq₀ (norm_nonneg _)
          (mul_nonneg S.hL.le (norm_nonneg _))).2 hl
        simpa [mul_pow] using hsquare
      _ = (n : ℝ)⁻¹ * S.L ^ 2 *
          nodeTableNormSq
            (FiniteNetwork.consensusError (primal S omega alpha t)) := by
        simp only [nodeTableNormSq, FiniteNetwork.consensusError_apply,
          FiniteNetwork.meanState, SOptLib.finiteUniformAverage_def,
          arithmeticMean, xbar, Fintype.card_fin]
        rw [Finset.mul_sum, Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i _hi
        ring
  have hB : ‖B‖ ^ 2 ≤ S.L ^ 2 * ‖z - xbar‖ ^ 2 := by
    have hlip : ‖gradient (averageObjective S) xbar -
          gradient (averageObjective S) z‖ ≤ S.L * ‖xbar - z‖ := by
      rw [havgGradient, havgGradient, ← smul_sub, ← Finset.sum_sub_distrib,
        norm_smul, Real.norm_eq_abs, abs_of_nonneg
          (inv_nonneg.mpr (Nat.cast_nonneg n))]
      calc
        (n : ℝ)⁻¹ * ‖∑ i : Fin n,
            (gradient (S.localObjective i) xbar -
              gradient (S.localObjective i) z)‖ ≤
            (n : ℝ)⁻¹ * ∑ i : Fin n,
              ‖gradient (S.localObjective i) xbar -
                gradient (S.localObjective i) z‖ := by
          exact mul_le_mul_of_nonneg_left
            (norm_sum_le Finset.univ fun i : Fin n =>
              gradient (S.localObjective i) xbar -
                gradient (S.localObjective i) z)
            (inv_nonneg.mpr (Nat.cast_nonneg n))
        _ ≤ (n : ℝ)⁻¹ * ∑ _i : Fin n, S.L * ‖xbar - z‖ := by
          apply mul_le_mul_of_nonneg_left _ (inv_nonneg.mpr (Nat.cast_nonneg n))
          exact Finset.sum_le_sum fun i _ => (S.local_smooth i).2.norm_sub_le _ _
        _ = S.L * ‖xbar - z‖ := by
          simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin,
            nsmul_eq_mul]
          field_simp
    have hsquare := (sq_le_sq₀ (norm_nonneg _)
      (mul_nonneg S.hL.le (norm_nonneg _))).2 hlip
    dsimp [B]
    simpa [mul_pow, norm_sub_rev] using hsquare
  have hC : ‖C‖ ^ 2 ≤
      nodeTableNormSq (correctedTrackerDisagreement S omega alpha t) := by
    have hsq : (∑ i : Fin n,
        absoluteProbability S.network (t + 1) i ^ 2) ≤ 1 := by
      calc
        (∑ i : Fin n, absoluteProbability S.network (t + 1) i ^ 2) ≤
            ∑ i : Fin n, absoluteProbability S.network (t + 1) i := by
          apply Finset.sum_le_sum
          intro i _hi
          have hi0 := hpi.1 i
          have hi1 := (mem_Icc_of_mem_stdSimplex hpi i).2
          nlinarith
        _ = 1 := hpi.2
    have hraw := norm_sq_finset_sum_smul_le_sum_sq_mul_sum_norm_sq
      (Finset.univ : Finset (Fin n))
      (absoluteProbability S.network (t + 1))
      (correctedTrackerDisagreement S omega alpha t)
    dsimp [C]
    calc
      ‖∑ i : Fin n, absoluteProbability S.network (t + 1) i •
          correctedTrackerDisagreement S omega alpha t i‖ ^ 2 ≤
          (∑ i : Fin n, absoluteProbability S.network (t + 1) i ^ 2) *
            nodeTableNormSq
              (correctedTrackerDisagreement S omega alpha t) := by
        simpa [nodeTableNormSq] using hraw
      _ ≤ 1 * nodeTableNormSq
            (correctedTrackerDisagreement S omega alpha t) := by
        exact mul_le_mul_of_nonneg_right hsq
          (Finset.sum_nonneg fun i _ => sq_nonneg _)
      _ = _ := one_mul _
  have hKA : ‖k • A‖ ^ 2 ≤ (n : ℝ) * S.L ^ 2 *
      nodeTableNormSq
        (FiniteNetwork.consensusError (primal S omega alpha t)) := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hk_nonneg, mul_pow]
    calc
      k ^ 2 * ‖A‖ ^ 2 ≤ (n : ℝ) ^ 2 * ‖A‖ ^ 2 :=
        mul_le_mul_of_nonneg_right hk_sq (sq_nonneg _)
      _ ≤ (n : ℝ) ^ 2 *
          ((n : ℝ)⁻¹ * S.L ^ 2 * nodeTableNormSq
            (FiniteNetwork.consensusError (primal S omega alpha t))) := by
        exact mul_le_mul_of_nonneg_left hA (sq_nonneg _)
      _ = _ := by field_simp
  have hKB : ‖k • B‖ ^ 2 ≤ (n : ℝ) ^ 2 * S.L ^ 2 *
      ‖z - xbar‖ ^ 2 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hk_nonneg, mul_pow]
    calc
      k ^ 2 * ‖B‖ ^ 2 ≤ (n : ℝ) ^ 2 * ‖B‖ ^ 2 :=
        mul_le_mul_of_nonneg_right hk_sq (sq_nonneg _)
      _ ≤ (n : ℝ) ^ 2 *
          (S.L ^ 2 * ‖z - xbar‖ ^ 2) := by
        exact mul_le_mul_of_nonneg_left hB (sq_nonneg _)
      _ = _ := by ring
  have hdrift : correctedDrift S omega alpha t = k • A + k • B + C := by
    dsimp [k, A, B, C, xbar, z]
    unfold correctedDrift
    module
  rw [hdrift]
  have hthree : ‖k • A + k • B + C‖ ≤
      ‖k • A‖ + ‖k • B‖ + ‖C‖ := norm_add₃_le
  have hthreeSq : ‖k • A + k • B + C‖ ^ 2 ≤
      3 * (‖k • A‖ ^ 2 + ‖k • B‖ ^ 2 + ‖C‖ ^ 2) := by
    have hnormSq : ‖k • A + k • B + C‖ ^ 2 ≤
        (‖k • A‖ + ‖k • B‖ + ‖C‖) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _)
        (by positivity)).2 hthree
    have hsumSq : (‖k • A‖ + ‖k • B‖ + ‖C‖) ^ 2 ≤
        3 * (‖k • A‖ ^ 2 + ‖k • B‖ ^ 2 + ‖C‖ ^ 2) := by
      nlinarith [sq_nonneg (‖k • A‖ - ‖k • B‖),
        sq_nonneg (‖k • A‖ - ‖C‖), sq_nonneg (‖k • B‖ - ‖C‖)]
    exact hnormSq.trans hsumSq
  calc
    ‖k • A + k • B + C‖ ^ 2 ≤
        3 * (‖k • A‖ ^ 2 + ‖k • B‖ ^ 2 + ‖C‖ ^ 2) := hthreeSq
    _ ≤ 3 * ((n : ℝ) * S.L ^ 2 *
          nodeTableNormSq
            (FiniteNetwork.consensusError (primal S omega alpha t)) +
        (n : ℝ) ^ 2 * S.L ^ 2 * ‖z - xbar‖ ^ 2 +
        nodeTableNormSq
          (correctedTrackerDisagreement S omega alpha t)) := by
      gcongr
    _ = _ := by
      dsimp [z, xbar]
      ring

/-- Source steps 10--12 before expectation: corrected-center displacement is
controlled by primal disagreement and historical filtered noise. -/
theorem corrected_center_offset_energy_pointwise
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (t : ℕ) :
    ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2 ≤
      2 * nodeTableNormSq
          (FiniteNetwork.consensusError (primal S omega alpha t)) +
        2 * alpha ^ 2 * influenceOperatorBound S.network ^ 2 *
          nodeTableNormSq (filteredNoise S omega t) := by
  classical
  let pi := absoluteProbability S.network t
  let X := primal S omega alpha t
  let xbar := arithmeticMean S omega alpha t
  let lift := influenceOperatorPoint S.network t (filteredNoiseZeroSum S omega t)
  have hpi : pi ∈ stdSimplex ℝ (Fin n) := by
    simpa [pi] using absoluteProbability_mem_stdSimplex S.network t
  have hweightedEq :
      (∑ i, pi i • X i) - xbar = ∑ i, pi i • (X i - xbar) := by
    calc
      (∑ i, pi i • X i) - xbar =
          (∑ i, pi i • X i) - ∑ i, pi i • xbar := by
        rw [← Finset.sum_smul, hpi.2, one_smul]
      _ = ∑ i, (pi i • X i - pi i • xbar) := by
        rw [Finset.sum_sub_distrib]
      _ = ∑ i, pi i • (X i - xbar) := by
        apply Finset.sum_congr rfl
        intro i _hi
        rw [smul_sub]
  have hpiSq : (∑ i : Fin n, pi i ^ 2) ≤ 1 := by
    calc
      (∑ i : Fin n, pi i ^ 2) ≤ ∑ i : Fin n, pi i := by
        apply Finset.sum_le_sum
        intro i _hi
        have hi0 := hpi.1 i
        have hi1 := (mem_Icc_of_mem_stdSimplex hpi i).2
        nlinarith
      _ = 1 := hpi.2
  have hweighted :
      ‖(∑ i, pi i • X i) - xbar‖ ^ 2 ≤
        nodeTableNormSq (FiniteNetwork.consensusError X) := by
    rw [hweightedEq]
    have hcs := norm_sq_finset_sum_smul_le_sum_sq_mul_sum_norm_sq
      (Finset.univ : Finset (Fin n)) pi (fun i => X i - xbar)
    calc
      ‖∑ i, pi i • (X i - xbar)‖ ^ 2 ≤
          (∑ i : Fin n, pi i ^ 2) *
            ∑ i : Fin n, ‖X i - xbar‖ ^ 2 := by
        simpa using hcs
      _ ≤ 1 * ∑ i : Fin n, ‖X i - xbar‖ ^ 2 :=
        mul_le_mul_of_nonneg_right hpiSq
          (Finset.sum_nonneg fun i _ => sq_nonneg ‖X i - xbar‖)
      _ = nodeTableNormSq (FiniteNetwork.consensusError X) := by
        simp [nodeTableNormSq, FiniteNetwork.consensusError_apply,
          FiniteNetwork.meanState, SOptLib.finiteUniformAverage_def,
          xbar, arithmeticMean, X, Fintype.card_fin]
  have hD_nonneg : 0 ≤ influenceOperatorBound S.network := by
    unfold influenceOperatorBound columnMixingConstant
    exact div_nonneg
      (div_nonneg (Real.sqrt_nonneg _) (blockContraction_pos S.network).le)
      (sub_nonneg.mpr (mixingRate_lt_one S.network).le)
  have hliftNorm : ‖lift‖ ≤ influenceOperatorBound S.network *
      Real.sqrt (nodeTableNormSq (filteredNoise S omega t)) := by
    simpa [lift, nodeTableNormSq] using
      influenceOperatorPoint_norm_le S.network t (filteredNoiseZeroSum S omega t)
  have hliftSq : ‖lift‖ ^ 2 ≤ influenceOperatorBound S.network ^ 2 *
      nodeTableNormSq (filteredNoise S omega t) := by
    have hright : 0 ≤ influenceOperatorBound S.network *
        Real.sqrt (nodeTableNormSq (filteredNoise S omega t)) :=
      mul_nonneg hD_nonneg (Real.sqrt_nonneg _)
    have hsquare := (sq_le_sq₀ (norm_nonneg _) hright).2 hliftNorm
    rw [mul_pow, Real.sq_sqrt] at hsquare
    · exact hsquare
    · exact Finset.sum_nonneg fun i _ => sq_nonneg ‖filteredNoise S omega t i‖
  have hdecomp :
      correctedCenter S omega alpha t - arithmeticMean S omega alpha t =
        ((∑ i, pi i • X i) - xbar) + (-alpha) • lift := by
    dsimp [correctedCenter, pi, X, xbar, lift]
    module
  rw [hdecomp]
  have hadd := SOptLib.norm_add_sq_le_two_mul_norm_sq_add_two_mul_norm_sq
    ((∑ i, pi i • X i) - xbar) ((-alpha) • lift)
  calc
    _ ≤ 2 * ‖(∑ i, pi i • X i) - xbar‖ ^ 2 +
          2 * ‖(-alpha) • lift‖ ^ 2 := hadd
    _ ≤ 2 * nodeTableNormSq (FiniteNetwork.consensusError X) +
          2 * (alpha ^ 2 * (influenceOperatorBound S.network ^ 2 *
            nodeTableNormSq (filteredNoise S omega t))) := by
      gcongr
      have hscaled := mul_le_mul_of_nonneg_left hliftSq (sq_nonneg alpha)
      simpa [norm_smul, Real.norm_eq_abs, sq_abs, mul_pow] using hscaled
    _ = _ := by
      dsimp [X]
      ring

/-- Source step 10's raw corrected-center offset comparison, before inserting
the closed tracker bound. -/
theorem corrected_center_offset_energy_raw
    (S : Setup n d Ω) (alpha : ℝ) (halpha : 0 < alpha)
    (T : PositiveHorizon) :
    correctedCenterOffsetEnergy S alpha T ≤
      2 * alpha ^ 2 *
        (disagreementKernel S.network * trackerEnergy S alpha T +
          influenceOperatorBound S.network ^ 2 *
            filteredNoiseKernel S.network * S.σ ^ 2 * T.1) := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  have hprimalMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => primal S omega alpha t i) 2 S.probability :=
    (generated_process_coordinate_memLp_two S alpha t).1 i
  have htrackerMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => tracker S omega alpha t i) 2 S.probability :=
    (generated_process_coordinate_memLp_two S alpha t).2.1 i
  have hfilterMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => filteredNoise S omega t i) 2 S.probability :=
    filteredNoise_coordinate_memLp_two S t i
  have hconsensusMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega =>
        FiniteNetwork.consensusError (primal S omega alpha t) i)
        2 S.probability := by
    simpa [FiniteNetwork.consensusError_apply, FiniteNetwork.meanState,
      SOptLib.finiteUniformAverage_def, arithmeticMean, Fintype.card_fin] using
        (hprimalMem t i).sub (arithmeticMean_memLp_two S alpha t)
  have htrackerEnergyInt (t : ℕ) : Integrable (fun omega =>
      nodeTableNormSq (tracker S omega alpha t)) S.probability := by
    simpa [nodeTableNormSq, SOptLib.dependentProductNormSq_def] using
      (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
        (fun omega => tracker S omega alpha t) (htrackerMem t)).1
  have hconsensusEnergyInt (t : ℕ) : Integrable (fun omega =>
      nodeTableNormSq
        (FiniteNetwork.consensusError (primal S omega alpha t)))
      S.probability := by
    simpa [nodeTableNormSq, SOptLib.dependentProductNormSq_def] using
      (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
        (fun omega => FiniteNetwork.consensusError (primal S omega alpha t))
        (hconsensusMem t)).1
  have hfilterEnergyInt (t : ℕ) : Integrable (fun omega =>
      nodeTableNormSq (filteredNoise S omega t)) S.probability := by
    simpa [nodeTableNormSq, SOptLib.dependentProductNormSq_def] using
      (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
        (fun omega => filteredNoise S omega t) (hfilterMem t)).1
  have hOffsetEnergyMeasurable (t : ℕ) : Measurable (fun omega =>
      ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2) := by
    have hc : Measurable (fun omega => correctedCenter S omega alpha t) :=
      ((correctedCenter_and_drift_measurable S alpha).1 t).mono
        (preSamplingHistory_le S t) le_rfl
    have hmSub : Measurable[preSamplingHistory S t]
        (fun omega => arithmeticMean S omega alpha t) := by
      unfold arithmeticMean
      have hsum : Measurable[preSamplingHistory S t]
          (fun omega => ∑ i, primal S omega alpha t i) := by
        apply Finset.measurable_sum
        intro i _hi
        exact (measurable_pi_apply i).comp
          (primal_measurable_preSamplingHistory S alpha t)
      exact hsum.const_smul ((n : ℝ)⁻¹)
    have hm : Measurable (fun omega => arithmeticMean S omega alpha t) :=
      hmSub.mono (preSamplingHistory_le S t) le_rfl
    exact (hc.sub hm).norm.pow_const 2
  have hOffsetEnergyInt (t : ℕ) : Integrable (fun omega =>
      ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2)
      S.probability := by
    have hright : Integrable (fun omega =>
        2 * nodeTableNormSq
            (FiniteNetwork.consensusError (primal S omega alpha t)) +
          2 * alpha ^ 2 * influenceOperatorBound S.network ^ 2 *
            nodeTableNormSq (filteredNoise S omega t)) S.probability :=
      ((hconsensusEnergyInt t).const_mul 2).add
        ((hfilterEnergyInt t).const_mul
          (2 * alpha ^ 2 * influenceOperatorBound S.network ^ 2))
    refine Integrable.mono' hright
      (hOffsetEnergyMeasurable t).aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall fun omega => by
      have hleft : 0 ≤
          ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2 :=
        sq_nonneg _
      have hle := corrected_center_offset_energy_pointwise S omega alpha t
      have hrightNonneg : 0 ≤
          2 * nodeTableNormSq
              (FiniteNetwork.consensusError (primal S omega alpha t)) +
            2 * alpha ^ 2 * influenceOperatorBound S.network ^ 2 *
              nodeTableNormSq (filteredNoise S omega t) := hleft.trans hle
      simpa [Real.norm_eq_abs, abs_of_nonneg hleft,
        abs_of_nonneg hrightNonneg] using hle
  have hpointExpectation (t : ℕ) :
      SOptLib.expectation S.probability (fun omega =>
          ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2) ≤
        2 * SOptLib.expectation S.probability (fun omega =>
          nodeTableNormSq
            (FiniteNetwork.consensusError (primal S omega alpha t))) +
        2 * alpha ^ 2 * influenceOperatorBound S.network ^ 2 *
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq (filteredNoise S omega t)) := by
    have hright : Integrable (fun omega =>
        2 * nodeTableNormSq
            (FiniteNetwork.consensusError (primal S omega alpha t)) +
          2 * alpha ^ 2 * influenceOperatorBound S.network ^ 2 *
            nodeTableNormSq (filteredNoise S omega t)) S.probability :=
      ((hconsensusEnergyInt t).const_mul 2).add
        ((hfilterEnergyInt t).const_mul
          (2 * alpha ^ 2 * influenceOperatorBound S.network ^ 2))
    have hmono := MeasureTheory.integral_mono
      (hOffsetEnergyInt t) hright
      (corrected_center_offset_energy_pointwise S · alpha t)
    unfold SOptLib.expectation
    rw [MeasureTheory.integral_add
      ((hconsensusEnergyInt t).const_mul 2)
      ((hfilterEnergyInt t).const_mul
        (2 * alpha ^ 2 * influenceOperatorBound S.network ^ 2)),
      MeasureTheory.integral_const_mul,
      MeasureTheory.integral_const_mul] at hmono
    exact hmono
  have hPrimalEnergy :
      ∑ t ∈ Finset.range T.1,
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq
              (FiniteNetwork.consensusError (primal S omega alpha t))) ≤
        alpha ^ 2 * disagreementKernel S.network * trackerEnergy S alpha T := by
    have htransport :=
      sum_integral_le_smul_sum_integral_of_ae_sum_le_smul_sum
        (Finset.range T.1) (Finset.range T.1)
        (fun t omega => nodeTableNormSq
          (FiniteNetwork.consensusError (primal S omega alpha t)))
        (fun t omega => nodeTableNormSq (tracker S omega alpha t))
        (alpha ^ 2 * disagreementKernel S.network)
        (fun t _ht => hconsensusEnergyInt t)
        (fun t _ht => htrackerEnergyInt t)
        (Filter.Eventually.of_forall fun omega => by
          simpa only [smul_eq_mul] using
            primal_disagreement_pathwise_prefix_energy
              S omega alpha halpha.le T)
    simpa [SOptLib.expectation, trackerEnergy, smul_eq_mul] using htransport
  have hFilteredEnergy :
      ∑ t ∈ Finset.range T.1,
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq (filteredNoise S omega t)) ≤
        filteredNoiseKernel S.network * S.σ ^ 2 * T.1 := by
    calc
      _ ≤ ∑ _t ∈ Finset.range T.1,
          filteredNoiseKernel S.network * S.σ ^ 2 := by
        apply Finset.sum_le_sum
        intro t _ht
        exact filteredNoise_expected_energy_le S t
      _ = _ := by simp; ring
  have hsum := Finset.sum_le_sum fun t (_ht : t ∈ Finset.range T.1) =>
    hpointExpectation t
  calc
    correctedCenterOffsetEnergy S alpha T ≤
        2 * (∑ t ∈ Finset.range T.1,
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq
              (FiniteNetwork.consensusError (primal S omega alpha t)))) +
        2 * alpha ^ 2 * influenceOperatorBound S.network ^ 2 *
          (∑ t ∈ Finset.range T.1,
            SOptLib.expectation S.probability (fun omega =>
              nodeTableNormSq (filteredNoise S omega t))) := by
      unfold correctedCenterOffsetEnergy
      calc
        _ ≤ ∑ t ∈ Finset.range T.1,
            (2 * SOptLib.expectation S.probability (fun omega =>
                nodeTableNormSq
                  (FiniteNetwork.consensusError (primal S omega alpha t))) +
              2 * alpha ^ 2 * influenceOperatorBound S.network ^ 2 *
                SOptLib.expectation S.probability (fun omega =>
                  nodeTableNormSq (filteredNoise S omega t))) := hsum
        _ = _ := by
          rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
    _ ≤ 2 * (alpha ^ 2 * disagreementKernel S.network *
          trackerEnergy S alpha T) +
        2 * alpha ^ 2 * influenceOperatorBound S.network ^ 2 *
          (filteredNoiseKernel S.network * S.σ ^ 2 * T.1) := by
      gcongr
    _ = _ := by ring

/-- Source step 14 after expectation and time aggregation, before inserting
the closed tracker-energy estimate. -/
theorem corrected_drift_energy_raw
    (S : Setup n d Ω) (alpha : ℝ) (halpha : 0 < alpha)
    (T : PositiveHorizon)
    (hCorrectedTrackerEnergy :
      ∑ t ∈ Finset.range T.1,
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq
              (correctedTrackerDisagreement S omega alpha t)) ≤
        trackerInitialKernel S.network * (n : ℝ) * S.H ^ 2 +
          dimensionlessStepsize S.L alpha ^ 2 *
            trackerIncrementKernel S.network * trackerEnergy S alpha T) :
    correctedDriftEnergy S alpha T ≤
      3 * trackerInitialKernel S.network * (n : ℝ) * S.H ^ 2 +
        dimensionlessStepsize S.L alpha ^ 2 *
          (controlKa S.network * trackerEnergy S alpha T +
            controlKb S.network * S.σ ^ 2 * T.1) := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  have hprimalMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => primal S omega alpha t i) 2 S.probability :=
    (generated_process_coordinate_memLp_two S alpha t).1 i
  have htrackerMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => tracker S omega alpha t i) 2 S.probability :=
    (generated_process_coordinate_memLp_two S alpha t).2.1 i
  have hnoiseMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => S.noise t omega i) 2 S.probability :=
    (memLp_two_iff_integrable_sq_norm
      (noise_integrable S t i).aestronglyMeasurable).2
        (noise_norm_sq_integrable S t i)
  have hfilterMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => filteredNoise S omega t i) 2 S.probability :=
    filteredNoise_coordinate_memLp_two S t i
  have hgradientMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => gradientTable S omega alpha t i)
        2 S.probability := by
    simpa [gradientTable] using memLp_two_comp_lipschitz_local
      (gradient (S.localObjective i)) ⟨S.L, S.hL.le⟩
      (S.local_smooth i).2 (hprimalMem t i)
  have hgradientSumMem (t : ℕ) :
      MemLp (fun omega => ∑ i, gradientTable S omega alpha t i)
