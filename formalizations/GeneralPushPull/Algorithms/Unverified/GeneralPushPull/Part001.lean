  have hsum := Finset.sum_le_sum fun t (_ht : t ∈ Finset.range T.1) =>
    hpointExpectation t
  calc
    correctedDriftEnergy S alpha T ≤
        3 * (n : ℝ) * S.L ^ 2 *
          (∑ t ∈ Finset.range T.1,
            SOptLib.expectation S.probability (fun omega =>
              nodeTableNormSq
                (FiniteNetwork.consensusError (primal S omega alpha t)))) +
        3 * (n : ℝ) ^ 2 * S.L ^ 2 *
          correctedCenterOffsetEnergy S alpha T +
        3 * (∑ t ∈ Finset.range T.1,
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq
              (correctedTrackerDisagreement S omega alpha t))) := by
      unfold correctedDriftEnergy correctedCenterOffsetEnergy
      simpa only [Finset.sum_add_distrib, Finset.mul_sum] using hsum
    _ ≤ 3 * (n : ℝ) * S.L ^ 2 *
          (alpha ^ 2 * disagreementKernel S.network * trackerEnergy S alpha T) +
        3 * (n : ℝ) ^ 2 * S.L ^ 2 *
          (2 * alpha ^ 2 *
            (disagreementKernel S.network * trackerEnergy S alpha T +
              influenceOperatorBound S.network ^ 2 *
                filteredNoiseKernel S.network * S.σ ^ 2 * T.1)) +
        3 * (trackerInitialKernel S.network * (n : ℝ) * S.H ^ 2 +
          dimensionlessStepsize S.L alpha ^ 2 *
            trackerIncrementKernel S.network * trackerEnergy S alpha T) := by
      gcongr
    _ = _ := by
      unfold dimensionlessStepsize controlKa controlKb
      ring

/-- Source step 9's finite-horizon tracker feedback inequality, before either
small-gain absorption. -/
theorem raw_tracker_feedback_energy
    (S : Setup n d Ω) (hLayer : InFiniteHeterogeneityLayer S)
    (alpha : ℝ) (halpha : 0 < alpha) (T : PositiveHorizon)
    (hCorrectedTrackerEnergy :
      ∑ t ∈ Finset.range T.1,
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq
              (correctedTrackerDisagreement S omega alpha t)) ≤
        trackerInitialKernel S.network * (n : ℝ) * S.H ^ 2 +
          dimensionlessStepsize S.L alpha ^ 2 *
            trackerIncrementKernel S.network * trackerEnergy S alpha T)
    (hCurrentNoiseEnergy :
      ∑ t ∈ Finset.range T.1,
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq
              (S.noise t omega + filteredNoise S omega t)) ≤
        currentNoiseKernel S.network * S.σ ^ 2 * T.1) :
    trackerEnergy S alpha T ≤
      12 * (n : ℝ) ^ 2 * correctedGradientEnergy S alpha T +
      3 * trackerInitialKernel S.network * (n : ℝ) * S.H ^ 2 +
      3 * currentNoiseKernel S.network * S.σ ^ 2 * T.1 +
      dimensionlessStepsize S.L alpha ^ 2 *
        (6 * (n : ℝ) * disagreementKernel S.network +
          3 * trackerIncrementKernel S.network) * trackerEnergy S alpha T +
      12 * (n : ℝ) ^ 2 * S.L ^ 2 *
        correctedCenterOffsetEnergy S alpha T := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  have hnoiseMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => S.noise t omega i) 2 S.probability :=
    (memLp_two_iff_integrable_sq_norm
      (noise_integrable S t i).aestronglyMeasurable).2
        (noise_norm_sq_integrable S t i)
  have hfilterMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => filteredNoise S omega t i) 2 S.probability :=
    filteredNoise_coordinate_memLp_two S t i
  have hprimalMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => primal S omega alpha t i) 2 S.probability :=
    (generated_process_coordinate_memLp_two S alpha t).1 i
  have htrackerMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => tracker S omega alpha t i) 2 S.probability :=
    (generated_process_coordinate_memLp_two S alpha t).2.1 i
  have hgradientMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => gradientTable S omega alpha t i)
        2 S.probability := by
    simpa [gradientTable] using memLp_two_comp_lipschitz_local
      (gradient (S.localObjective i)) ⟨S.L, S.hL.le⟩
      (S.local_smooth i).2 (hprimalMem t i)
  have hgradientSumMem (t : ℕ) :
      MemLp (fun omega => ∑ i, gradientTable S omega alpha t i)
        2 S.probability := by
    apply memLp_finset_sum Finset.univ
    intro i _hi
    exact hgradientMem t i
  have hcorrectedTrackerMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => correctedTracker S omega alpha t i)
        2 S.probability := by
    simpa [correctedTracker] using
      ((htrackerMem t i).sub (hnoiseMem t i)).sub (hfilterMem t i)
  have hcorrectedDisagreementMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => correctedTrackerDisagreement S omega alpha t i)
        2 S.probability := by
    simpa [correctedTrackerDisagreement] using
      (hcorrectedTrackerMem t i).sub
        ((hgradientSumMem t).const_smul (normalizedPushMass S.network t i))
  have harithmeticMeanMem (t : ℕ) :
      MemLp (fun omega => arithmeticMean S omega alpha t)
        2 S.probability := arithmeticMean_memLp_two S alpha t
  have hconsensusMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega =>
        FiniteNetwork.consensusError (primal S omega alpha t) i)
        2 S.probability := by
    simpa [FiniteNetwork.consensusError_apply, FiniteNetwork.meanState,
      SOptLib.finiteUniformAverage_def, arithmeticMean, Fintype.card_fin] using
        (hprimalMem t i).sub (harithmeticMeanMem t)
  have hweightedPrimalMem (t : ℕ) :
      MemLp (fun omega =>
        ∑ i, (absoluteProbability S.network t i) •
          primal S omega alpha t i) 2 S.probability := by
    apply memLp_finset_sum Finset.univ
    intro i _hi
    exact (hprimalMem t i).const_smul (absoluteProbability S.network t i)
  have hliftMem (t : ℕ) :
      MemLp (fun omega => influenceOperatorPoint S.network t
        (filteredNoiseZeroSum S omega t)) 2 S.probability := by
    obtain ⟨K, hK⟩ :=
      FiniteNetwork.exists_lipschitzWith_periodicCorrectedLift
        S.colMix (absoluteProbability S.network)
        (blockContraction S.network) (mixingRate S.network) t
        (fun ell => absoluteProbability_mem_stdSimplex S.network (t + ell + 1))
        (blockContraction_pos S.network).le (mixingRate_nonneg S.network)
        (mixingRate_lt_one S.network)
        (fun z ell => point_colMix_stateL1_geometric S.network t ell z)
    apply memLp_comp_lipschitz_subtype_pi_of_coordinate_memLp
      S.probability {X : NodeTable n d | ∑ i, X i = 0}
      (fun omega => filteredNoiseZeroSum S omega t)
      (influenceOperatorPoint S.network t) 2 K (by simp)
      (hfilterMem t) hK
    simp [influenceOperatorPoint, FiniteNetwork.periodicCorrectedLift]
  have hcenterMem (t : ℕ) :
      MemLp (fun omega => correctedCenter S omega alpha t)
        2 S.probability := by
    simpa [correctedCenter] using
      (hweightedPrimalMem t).sub ((hliftMem t).const_smul alpha)
  have hoffsetMem (t : ℕ) :
      MemLp (fun omega => correctedCenter S omega alpha t -
        arithmeticMean S omega alpha t) 2 S.probability :=
    (hcenterMem t).sub (harithmeticMeanMem t)
  have hcenterGradientMem (t : ℕ) :
      MemLp (fun omega =>
        gradient (averageObjective S) (correctedCenter S omega alpha t))
        2 S.probability := by
    have hcomponent : ∀ i : Fin n,
        MemLp (fun omega => gradient (S.localObjective i)
          (correctedCenter S omega alpha t)) 2 S.probability := by
      intro i
      exact memLp_two_comp_lipschitz_local
        (gradient (S.localObjective i)) ⟨S.L, S.hL.le⟩
        (S.local_smooth i).2 (hcenterMem t)
    have hsum : MemLp (fun omega => ∑ i : Fin n,
        gradient (S.localObjective i) (correctedCenter S omega alpha t))
        2 S.probability := by
      apply memLp_finset_sum Finset.univ
      intro i _hi
      exact hcomponent i
    have hscaled := hsum.const_smul ((n : ℝ)⁻¹)
    refine MemLp.ae_eq ?_ hscaled
    exact Filter.Eventually.of_forall fun omega => by
      have havg := SOptLib.gradient_finiteUniformAverage_eq_finiteUniformAverage_gradient
        S.localObjective (fun i x => gradient (S.localObjective i) x)
        (correctedCenter S omega alpha t)
        (fun i => ((S.local_smooth i).1 _).hasGradientAt)
      have hfun : averageObjective S =
          SOptLib.finiteUniformAverage S.localObjective := by
        funext x
        simp [averageObjective, SOptLib.finiteUniformAverage_def,
          Fintype.card_fin, smul_eq_mul]
      rw [hfun]
      simpa [SOptLib.finiteUniformAverage_def, Fintype.card_fin] using havg.symm
  have htrackerEnergyInt (t : ℕ) : Integrable (fun omega =>
      nodeTableNormSq (tracker S omega alpha t)) S.probability := by
    simpa [nodeTableNormSq, SOptLib.dependentProductNormSq_def] using
      (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
        (fun omega => tracker S omega alpha t) (htrackerMem t)).1
  have hcorrectedEnergyInt (t : ℕ) : Integrable (fun omega =>
      nodeTableNormSq (correctedTrackerDisagreement S omega alpha t))
      S.probability := by
    simpa [nodeTableNormSq, SOptLib.dependentProductNormSq_def] using
      (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
        (fun omega => correctedTrackerDisagreement S omega alpha t)
        (hcorrectedDisagreementMem t)).1
  have hconsensusEnergyInt (t : ℕ) : Integrable (fun omega =>
      nodeTableNormSq
        (FiniteNetwork.consensusError (primal S omega alpha t)))
      S.probability := by
    simpa [nodeTableNormSq, SOptLib.dependentProductNormSq_def] using
      (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
        (fun omega => FiniteNetwork.consensusError (primal S omega alpha t))
        (hconsensusMem t)).1
  have hoffsetEnergyInt (t : ℕ) : Integrable (fun omega =>
      ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2)
      S.probability :=
    (memLp_two_iff_integrable_sq_norm
      (hoffsetMem t).aestronglyMeasurable).1 (hoffsetMem t)
  have hgradientEnergyInt (t : ℕ) : Integrable (fun omega =>
      ‖gradient (averageObjective S) (correctedCenter S omega alpha t)‖ ^ 2)
      S.probability :=
    (memLp_two_iff_integrable_sq_norm
      (hcenterGradientMem t).aestronglyMeasurable).1 (hcenterGradientMem t)
  have hnoiseEnergyInt (t : ℕ) : Integrable (fun omega =>
      nodeTableNormSq (S.noise t omega + filteredNoise S omega t))
      S.probability := by
    simpa [nodeTableNormSq, SOptLib.dependentProductNormSq_def] using
      (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
        (fun omega => S.noise t omega + filteredNoise S omega t)
        (fun i => (hnoiseMem t i).add (hfilterMem t i))).1
  have hpointExpectation (t : ℕ) :
      SOptLib.expectation S.probability (fun omega =>
          nodeTableNormSq (tracker S omega alpha t)) ≤
        3 * SOptLib.expectation S.probability (fun omega =>
          nodeTableNormSq (correctedTrackerDisagreement S omega alpha t)) +
        6 * (n : ℝ) * S.L ^ 2 *
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq
              (FiniteNetwork.consensusError (primal S omega alpha t))) +
        12 * (n : ℝ) ^ 2 * S.L ^ 2 *
          SOptLib.expectation S.probability (fun omega =>
            ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2) +
        12 * (n : ℝ) ^ 2 *
          SOptLib.expectation S.probability (fun omega =>
            ‖gradient (averageObjective S)
              (correctedCenter S omega alpha t)‖ ^ 2) +
        3 * SOptLib.expectation S.probability (fun omega =>
          nodeTableNormSq (S.noise t omega + filteredNoise S omega t)) := by
    let A : Ω → ℝ := fun omega => 3 * nodeTableNormSq
      (correctedTrackerDisagreement S omega alpha t)
    let B : Ω → ℝ := fun omega => 6 * (n : ℝ) * S.L ^ 2 * nodeTableNormSq
      (FiniteNetwork.consensusError (primal S omega alpha t))
    let C : Ω → ℝ := fun omega => 12 * (n : ℝ) ^ 2 * S.L ^ 2 *
      ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2
    let D : Ω → ℝ := fun omega => 12 * (n : ℝ) ^ 2 *
      ‖gradient (averageObjective S) (correctedCenter S omega alpha t)‖ ^ 2
    let E : Ω → ℝ := fun omega => 3 * nodeTableNormSq
      (S.noise t omega + filteredNoise S omega t)
    have hA : Integrable A S.probability :=
      (hcorrectedEnergyInt t).const_mul 3
    have hB : Integrable B S.probability :=
      (hconsensusEnergyInt t).const_mul (6 * (n : ℝ) * S.L ^ 2)
    have hC : Integrable C S.probability :=
      (hoffsetEnergyInt t).const_mul (12 * (n : ℝ) ^ 2 * S.L ^ 2)
    have hD : Integrable D S.probability :=
      (hgradientEnergyInt t).const_mul (12 * (n : ℝ) ^ 2)
    have hE : Integrable E S.probability :=
      (hnoiseEnergyInt t).const_mul 3
    have hrightInt : Integrable (fun omega =>
        3 * nodeTableNormSq
            (correctedTrackerDisagreement S omega alpha t) +
        6 * (n : ℝ) * S.L ^ 2 * nodeTableNormSq
            (FiniteNetwork.consensusError (primal S omega alpha t)) +
        12 * (n : ℝ) ^ 2 * S.L ^ 2 *
            ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2 +
        12 * (n : ℝ) ^ 2 *
            ‖gradient (averageObjective S)
              (correctedCenter S omega alpha t)‖ ^ 2 +
        3 * nodeTableNormSq
            (S.noise t omega + filteredNoise S omega t)) S.probability := by
      simpa only [A, B, C, D, E] using (((hA.add hB).add hC).add hD).add hE
    have hmono := MeasureTheory.integral_mono
      (htrackerEnergyInt t) hrightInt
      (tracker_feedback_energy_pointwise S · alpha t)
    calc
      SOptLib.expectation S.probability (fun omega =>
          nodeTableNormSq (tracker S omega alpha t)) =
          ∫ omega, nodeTableNormSq (tracker S omega alpha t)
            ∂S.probability := by rfl
      _ ≤ ∫ omega, A omega + B omega + C omega + D omega + E omega
            ∂S.probability := by
        simpa only [A, B, C, D, E] using hmono
      _ = (∫ omega, A omega ∂S.probability) +
            (∫ omega, B omega ∂S.probability) +
            (∫ omega, C omega ∂S.probability) +
            (∫ omega, D omega ∂S.probability) +
            (∫ omega, E omega ∂S.probability) := by
        change (∫ omega, ((((A + B) + C) + D) + E) omega
          ∂S.probability) = _
        have h4 := MeasureTheory.integral_add
          (((hA.add hB).add hC).add hD) hE
        have h3 := MeasureTheory.integral_add ((hA.add hB).add hC) hD
        have h2 := MeasureTheory.integral_add (hA.add hB) hC
        have h1 := MeasureTheory.integral_add hA hB
        simpa only [Pi.add_apply] using h4.trans
          (congrArg (fun z => z + ∫ omega, E omega ∂S.probability)
            (h3.trans (congrArg (fun z => z + ∫ omega, D omega ∂S.probability)
              (h2.trans (congrArg
                (fun z => z + ∫ omega, C omega ∂S.probability) h1)))))
      _ = _ := by
        dsimp [A, B, C, D, E]
        rw [MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul,
          MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul,
          MeasureTheory.integral_const_mul]
        rfl
  have hPrimalEnergy :
      ∑ t ∈ Finset.range T.1,
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq
              (FiniteNetwork.consensusError (primal S omega alpha t))) ≤
        alpha ^ 2 * disagreementKernel S.network * trackerEnergy S alpha T := by
    have htransport :=
      sum_integral_le_smul_sum_integral_of_ae_sum_le_smul_sum
        (Finset.range T.1) (Finset.range T.1)
        (fun t omega => nodeTableNormSq
          (FiniteNetwork.consensusError (primal S omega alpha t)))
        (fun t omega => nodeTableNormSq (tracker S omega alpha t))
        (alpha ^ 2 * disagreementKernel S.network)
        (fun t _ht => hconsensusEnergyInt t)
        (fun t _ht => htrackerEnergyInt t)
        (Filter.Eventually.of_forall fun omega => by
          simpa only [smul_eq_mul] using
            primal_disagreement_pathwise_prefix_energy
              S omega alpha halpha.le T)
    simpa [SOptLib.expectation, trackerEnergy, smul_eq_mul] using htransport
  have hsumPoint :
      trackerEnergy S alpha T ≤
        3 * (∑ t ∈ Finset.range T.1,
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq (correctedTrackerDisagreement S omega alpha t))) +
        6 * (n : ℝ) * S.L ^ 2 *
          (∑ t ∈ Finset.range T.1,
            SOptLib.expectation S.probability (fun omega =>
              nodeTableNormSq
                (FiniteNetwork.consensusError (primal S omega alpha t)))) +
        12 * (n : ℝ) ^ 2 * S.L ^ 2 * correctedCenterOffsetEnergy S alpha T +
        12 * (n : ℝ) ^ 2 * correctedGradientEnergy S alpha T +
        3 * (∑ t ∈ Finset.range T.1,
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq (S.noise t omega + filteredNoise S omega t))) := by
    have hsum := Finset.sum_le_sum fun t (_ht : t ∈ Finset.range T.1) =>
      hpointExpectation t
    unfold trackerEnergy correctedCenterOffsetEnergy correctedGradientEnergy
    simpa only [Finset.sum_add_distrib, Finset.mul_sum] using hsum
  calc
    trackerEnergy S alpha T ≤
        3 * (∑ t ∈ Finset.range T.1,
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq (correctedTrackerDisagreement S omega alpha t))) +
        6 * (n : ℝ) * S.L ^ 2 *
          (∑ t ∈ Finset.range T.1,
            SOptLib.expectation S.probability (fun omega =>
              nodeTableNormSq
                (FiniteNetwork.consensusError (primal S omega alpha t)))) +
        12 * (n : ℝ) ^ 2 * S.L ^ 2 * correctedCenterOffsetEnergy S alpha T +
        12 * (n : ℝ) ^ 2 * correctedGradientEnergy S alpha T +
        3 * (∑ t ∈ Finset.range T.1,
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq (S.noise t omega + filteredNoise S omega t))) := hsumPoint
    _ ≤ 3 * (trackerInitialKernel S.network * (n : ℝ) * S.H ^ 2 +
          dimensionlessStepsize S.L alpha ^ 2 *
            trackerIncrementKernel S.network * trackerEnergy S alpha T) +
        6 * (n : ℝ) * S.L ^ 2 *
          (alpha ^ 2 * disagreementKernel S.network * trackerEnergy S alpha T) +
        12 * (n : ℝ) ^ 2 * S.L ^ 2 * correctedCenterOffsetEnergy S alpha T +
        12 * (n : ℝ) ^ 2 * correctedGradientEnergy S alpha T +
        3 * (currentNoiseKernel S.network * S.σ ^ 2 * T.1) := by
      gcongr
    _ = _ := by
      unfold dimensionlessStepsize
      ring

/-- The source average objective inherits the component smooth quadratic upper
model with the same constant `L`. -/
theorem average_objective_smooth_interface
    (S : Setup n d Ω) (x y : Point d) :
    averageObjective S x - averageObjective S y -
        ⟪gradient (averageObjective S) y, x - y⟫_ℝ ≤
      (S.L / 2) * ‖x - y‖ ^ 2 := by
  classical
  let F : Point d → ℝ := averageObjective S
  let f : {z : Point d // z ∈ (Set.univ : Set (Point d))} → ℝ :=
    fun z => averageObjective S z.1
  let grad : {z : Point d // z ∈ (Set.univ : Set (Point d))} → Point d :=
    fun z => gradient (averageObjective S) z.1
  have hfun : averageObjective S =
      SOptLib.finiteUniformAverage S.localObjective := by
    funext z
    simp [averageObjective, SOptLib.finiteUniformAverage_def,
      Fintype.card_fin, smul_eq_mul]
  have hgradAt (z : Point d) :
      HasGradientAt (averageObjective S)
        (gradient (averageObjective S) z) z := by
    have hraw := SOptLib.finiteAverageObjective_hasGradientAt
      S.localObjective (fun i q => gradient (S.localObjective i) q) z
      (fun i => ((S.local_smooth i).1 z).hasGradientAt)
    have hgradEq :=
      SOptLib.gradient_finiteUniformAverage_eq_finiteUniformAverage_gradient
        S.localObjective (fun i q => gradient (S.localObjective i) q) z
        (fun i => ((S.local_smooth i).1 z).hasGradientAt)
    convert hraw using 1
    · funext q
      simp [averageObjective, Fintype.card_fin]
    · rw [hfun]
      simpa [SOptLib.finiteUniformAverage_def, Fintype.card_fin] using hgradEq
  have hgradLip (u v : Point d) :
      ‖gradient (averageObjective S) v -
          gradient (averageObjective S) u‖ ≤ S.L * ‖v - u‖ := by
    have hgradEq (q : Point d) :
        gradient (averageObjective S) q =
          (n : ℝ)⁻¹ • ∑ i : Fin n, gradient (S.localObjective i) q := by
      rw [hfun]
      have h :=
        SOptLib.gradient_finiteUniformAverage_eq_finiteUniformAverage_gradient
          S.localObjective (fun i z => gradient (S.localObjective i) z) q
          (fun i => ((S.local_smooth i).1 q).hasGradientAt)
      simpa [SOptLib.finiteUniformAverage_def, Fintype.card_fin] using h
    rw [hgradEq, hgradEq, ← smul_sub, ← Finset.sum_sub_distrib,
      norm_smul, Real.norm_eq_abs, abs_of_nonneg
        (inv_nonneg.mpr (Nat.cast_nonneg n))]
    calc
      (n : ℝ)⁻¹ * ‖∑ i : Fin n,
          (gradient (S.localObjective i) v -
            gradient (S.localObjective i) u)‖ ≤
          (n : ℝ)⁻¹ * ∑ i : Fin n,
            ‖gradient (S.localObjective i) v -
              gradient (S.localObjective i) u‖ := by
        exact mul_le_mul_of_nonneg_left
          (norm_sum_le Finset.univ fun i : Fin n =>
            gradient (S.localObjective i) v - gradient (S.localObjective i) u)
          (inv_nonneg.mpr (Nat.cast_nonneg n))
      _ ≤ (n : ℝ)⁻¹ * ∑ _i : Fin n, S.L * ‖v - u‖ := by
        apply mul_le_mul_of_nonneg_left _ (inv_nonneg.mpr (Nat.cast_nonneg n))
        exact Finset.sum_le_sum fun i _ => (S.local_smooth i).2.norm_sub_le _ _
      _ = S.L * ‖v - u‖ := by
        simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin,
          nsmul_eq_mul]
        have hn : (n : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt S.hn)
        field_simp
  have hraw := Convex.carrier_smooth_quadratic_upper_bound_of_hasGradientWithinAt_lipschitz
    f F grad S.L (convex_univ : Convex ℝ (Set.univ : Set (Point d)))
    (fun z _hz => rfl)
    (fun z => by
      dsimp [F, grad]
      exact hasGradientWithinAt_univ.mpr (hgradAt z.1))
    (fun u v => by
      dsimp [grad]
      exact hgradLip u.1 v.1)
    (⟨x, Set.mem_univ x⟩) (⟨y, Set.mem_univ y⟩)
  simpa [f, F, grad] using hraw

/-- Exact one-step smoothness expansion used before conditional centering of
the current innovation.  No generic three-term square estimate is used here. -/
theorem corrected_center_smooth_step_exact
    (S : Setup n d Ω) (omega : Ω) (alpha : ℝ) (halpha : 0 < alpha)
    (t : ℕ) :
    averageObjective S (correctedCenter S omega alpha (t + 1)) ≤
      averageObjective S (correctedCenter S omega alpha t) -
        alpha * gain S.network t *
          ‖gradient (averageObjective S) (correctedCenter S omega alpha t)‖ ^ 2 -
        alpha * ⟪gradient (averageObjective S) (correctedCenter S omega alpha t),
          correctedDrift S omega alpha t⟫_ℝ -
        alpha * ⟪gradient (averageObjective S) (correctedCenter S omega alpha t),
          influenceNoise S omega t⟫_ℝ +
        (S.L * alpha ^ 2 / 2) *
          (‖(gain S.network t) •
                gradient (averageObjective S) (correctedCenter S omega alpha t) +
              correctedDrift S omega alpha t‖ ^ 2 +
            2 * ⟪(gain S.network t) •
                  gradient (averageObjective S) (correctedCenter S omega alpha t) +
                correctedDrift S omega alpha t,
              influenceNoise S omega t⟫_ℝ +
            ‖influenceNoise S omega t‖ ^ 2) := by
  let z := correctedCenter S omega alpha t
  let znext := correctedCenter S omega alpha (t + 1)
  let g := gradient (averageObjective S) z
  let eta := correctedDrift S omega alpha t
  let xi := influenceNoise S omega t
  let v := (gain S.network t) • g + eta
  have hstep : znext - z = (-alpha) • (v + xi) := by
    dsimp [znext, z, v, g, eta, xi]
    rw [correctedCenter_succ]
    module
  have hsmooth := average_objective_smooth_interface S znext z
  have hsmooth' : averageObjective S znext ≤
      averageObjective S z + ⟪g, znext - z⟫_ℝ +
        (S.L / 2) * ‖znext - z‖ ^ 2 := by
    dsimp [g]
    linarith
  calc
    averageObjective S znext ≤
        averageObjective S z + ⟪g, znext - z⟫_ℝ +
          (S.L / 2) * ‖znext - z‖ ^ 2 := hsmooth'
    _ = averageObjective S z -
        alpha * gain S.network t * ‖g‖ ^ 2 -
        alpha * ⟪g, eta⟫_ℝ - alpha * ⟪g, xi⟫_ℝ +
        (S.L * alpha ^ 2 / 2) *
          (‖v‖ ^ 2 + 2 * ⟪v, xi⟫_ℝ + ‖xi‖ ^ 2) := by
      rw [hstep, norm_smul, Real.norm_eq_abs, abs_neg,
        abs_of_pos halpha, mul_pow, norm_add_sq_real]
      dsimp [v]
      simp only [inner_smul_right, inner_add_right, inner_smul_left,
        real_inner_self_eq_norm_sq]
      ring
    _ = _ := by
      dsimp [znext, z, g, eta, xi, v]

/-- The two gain comparisons needed by corrected-center descent, exposed before
the later minorization development.  Only nonnegativity and conservation of the
column-stochastic push mass are used here. -/
theorem gain_bounds_before_corrected_center_control
    (N : NetworkSetup n) (t : ℕ) :
    gainFloor N ≤ gain N t ∧ gain N t ≤ (n : ℝ) := by
  classical
  have hpush_nonneg : ∀ s (i : Fin n), 0 ≤ pushMass N s i := by
    intro s
    induction s with
    | zero => intro i; simp [pushMass]
    | succ s ih =>
        intro i
        rw [pushMass_succ]
        exact Matrix.nonneg_mulVec_of_mem_colStochastic
          (N.col_stochastic s) ih i
  have hpush_sum : ∀ s, ∑ i, pushMass N s i = (n : ℝ) := by
    intro s
    induction s with
    | zero => simp [pushMass]
    | succ s ih =>
        rw [pushMass_succ,
          Matrix.sum_mulVec_of_mem_colStochastic (N.col_stochastic s), ih]
  have hgain_nonneg : ∀ s, 0 ≤ gain N s := by
    intro s
    have hpi := absoluteProbability_mem_stdSimplex N (s + 1)
    unfold gain dotProduct
    exact Finset.sum_nonneg fun i _ =>
      mul_nonneg (hpi.1 i) (hpush_nonneg s i)
  have hfloor : gainFloor N ≤ gain N t := by
    have hbdd : BddBelow (Set.range (gain N)) := by
      refine ⟨0, ?_⟩
      intro y hy
      rcases hy with ⟨s, rfl⟩
      exact hgain_nonneg s
    unfold gainFloor
    exact csInf_le hbdd ⟨t, rfl⟩
  have hupper : gain N t ≤ (n : ℝ) := by
    have hpi := absoluteProbability_mem_stdSimplex N (t + 1)
    have hmass_le (i : Fin n) : pushMass N t i ≤ (n : ℝ) := by
      calc
        pushMass N t i ≤ ∑ j, pushMass N t j :=
          Finset.single_le_sum (fun j _ => hpush_nonneg t j)
            (Finset.mem_univ i)
        _ = (n : ℝ) := hpush_sum t
    unfold gain dotProduct
    calc
      ∑ i, absoluteProbability N (t + 1) i * pushMass N t i ≤
          ∑ i, absoluteProbability N (t + 1) i * (n : ℝ) := by
        exact Finset.sum_le_sum fun i _ =>
          mul_le_mul_of_nonneg_left (hmass_le i) (hpi.1 i)
      _ = (n : ℝ) := by
        rw [← Finset.sum_mul, hpi.2]
        ring
  exact ⟨hfloor, hupper⟩

/-- Finite-time `L²` closure for the predictable payloads in the exact
corrected-center smoothness step. -/
theorem corrected_center_descent_payload_memLp_two
    (S : Setup n d Ω) (alpha : ℝ) (t : ℕ) :
    MemLp (fun omega => correctedCenter S omega alpha t)
        2 S.probability ∧
      MemLp (fun omega =>
        gradient (averageObjective S) (correctedCenter S omega alpha t))
        2 S.probability ∧
      MemLp (fun omega => correctedDrift S omega alpha t)
        2 S.probability ∧
      MemLp (fun omega =>
        (gain S.network t) •
            gradient (averageObjective S) (correctedCenter S omega alpha t) +
          correctedDrift S omega alpha t) 2 S.probability := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  have hprimalMem (i : Fin n) :
      MemLp (fun omega => primal S omega alpha t i) 2 S.probability :=
    (generated_process_coordinate_memLp_two S alpha t).1 i
  have htrackerMem (i : Fin n) :
      MemLp (fun omega => tracker S omega alpha t i) 2 S.probability :=
    (generated_process_coordinate_memLp_two S alpha t).2.1 i
  have hnoiseMem (i : Fin n) :
      MemLp (fun omega => S.noise t omega i) 2 S.probability :=
    (memLp_two_iff_integrable_sq_norm
      (noise_integrable S t i).aestronglyMeasurable).2
        (noise_norm_sq_integrable S t i)
  have hfilterMem (i : Fin n) :
      MemLp (fun omega => filteredNoise S omega t i) 2 S.probability :=
    filteredNoise_coordinate_memLp_two S t i
  have hgradientMem (i : Fin n) :
      MemLp (fun omega => gradientTable S omega alpha t i)
        2 S.probability := by
    simpa [gradientTable] using memLp_two_comp_lipschitz_local
      (gradient (S.localObjective i)) ⟨S.L, S.hL.le⟩
      (S.local_smooth i).2 (hprimalMem i)
  have hgradientSumMem :
      MemLp (fun omega => ∑ i, gradientTable S omega alpha t i)
        2 S.probability := by
    apply memLp_finset_sum Finset.univ
    intro i _hi
    exact hgradientMem i
  have hcorrectedTrackerMem (i : Fin n) :
      MemLp (fun omega => correctedTracker S omega alpha t i)
        2 S.probability := by
    simpa [correctedTracker] using
      ((htrackerMem i).sub (hnoiseMem i)).sub (hfilterMem i)
  have hcorrectedDisagreementMem (i : Fin n) :
      MemLp (fun omega => correctedTrackerDisagreement S omega alpha t i)
        2 S.probability := by
    simpa [correctedTrackerDisagreement] using
      (hcorrectedTrackerMem i).sub
        (hgradientSumMem.const_smul (normalizedPushMass S.network t i))
  have hweightedPrimalMem :
      MemLp (fun omega =>
        ∑ i, (absoluteProbability S.network t i) •
          primal S omega alpha t i) 2 S.probability := by
    apply memLp_finset_sum Finset.univ
    intro i _hi
    exact (hprimalMem i).const_smul (absoluteProbability S.network t i)
  have hliftMem :
      MemLp (fun omega => influenceOperatorPoint S.network t
        (filteredNoiseZeroSum S omega t)) 2 S.probability := by
    obtain ⟨K, hK⟩ :=
      FiniteNetwork.exists_lipschitzWith_periodicCorrectedLift
        S.colMix (absoluteProbability S.network)
        (blockContraction S.network) (mixingRate S.network) t
        (fun ell => absoluteProbability_mem_stdSimplex S.network (t + ell + 1))
        (blockContraction_pos S.network).le (mixingRate_nonneg S.network)
        (mixingRate_lt_one S.network)
        (fun z ell => point_colMix_stateL1_geometric S.network t ell z)
    apply memLp_comp_lipschitz_subtype_pi_of_coordinate_memLp
      S.probability {X : NodeTable n d | ∑ i, X i = 0}
      (fun omega => filteredNoiseZeroSum S omega t)
      (influenceOperatorPoint S.network t) 2 K (by simp)
      hfilterMem hK
    simp [influenceOperatorPoint, FiniteNetwork.periodicCorrectedLift]
  have hcenterMem :
      MemLp (fun omega => correctedCenter S omega alpha t)
        2 S.probability := by
    simpa [correctedCenter] using
      hweightedPrimalMem.sub (hliftMem.const_smul alpha)
  have hcenterGradientMem :
      MemLp (fun omega =>
        gradient (averageObjective S) (correctedCenter S omega alpha t))
        2 S.probability := by
    have hcomponent : ∀ i : Fin n,
        MemLp (fun omega => gradient (S.localObjective i)
          (correctedCenter S omega alpha t)) 2 S.probability := by
      intro i
      exact memLp_two_comp_lipschitz_local
        (gradient (S.localObjective i)) ⟨S.L, S.hL.le⟩
        (S.local_smooth i).2 hcenterMem
    have hsum : MemLp (fun omega => ∑ i : Fin n,
        gradient (S.localObjective i) (correctedCenter S omega alpha t))
        2 S.probability := by
      apply memLp_finset_sum Finset.univ
      intro i _hi
      exact hcomponent i
    have hscaled := hsum.const_smul ((n : ℝ)⁻¹)
    refine MemLp.ae_eq ?_ hscaled
    exact Filter.Eventually.of_forall fun omega => by
      have havg :=
        SOptLib.gradient_finiteUniformAverage_eq_finiteUniformAverage_gradient
          S.localObjective (fun i x => gradient (S.localObjective i) x)
          (correctedCenter S omega alpha t)
          (fun i => ((S.local_smooth i).1 _).hasGradientAt)
      have hfun : averageObjective S =
          SOptLib.finiteUniformAverage S.localObjective := by
        funext x
        simp [averageObjective, SOptLib.finiteUniformAverage_def,
          Fintype.card_fin, smul_eq_mul]
      rw [hfun]
      simpa [SOptLib.finiteUniformAverage_def, Fintype.card_fin] using havg.symm
  have hweightedDisagreementMem :
      MemLp (fun omega =>
        ∑ i, (absoluteProbability S.network (t + 1) i) •
          correctedTrackerDisagreement S omega alpha t i)
        2 S.probability := by
    apply memLp_finset_sum Finset.univ
    intro i _hi
    exact (hcorrectedDisagreementMem i).const_smul
      (absoluteProbability S.network (t + 1) i)
  have hdriftMem :
      MemLp (fun omega => correctedDrift S omega alpha t)
        2 S.probability := by
    have hfirst :=
      (hgradientSumMem.const_smul ((n : ℝ)⁻¹)).sub hcenterGradientMem
    have hraw := (hfirst.const_smul (gain S.network t)).add
      hweightedDisagreementMem
    simpa [correctedDrift] using hraw
  have hcombinedMem :
      MemLp (fun omega =>
        (gain S.network t) •
            gradient (averageObjective S) (correctedCenter S omega alpha t) +
          correctedDrift S omega alpha t) 2 S.probability :=
    (hcenterGradientMem.const_smul (gain S.network t)).add hdriftMem
  exact ⟨hcenterMem, hcenterGradientMem, hdriftMem, hcombinedMem⟩

/-- Smoothness and the global lower bound make every corrected-center
objective value integrable. -/
theorem corrected_center_objective_integrable
    (S : Setup n d Ω) (alpha : ℝ) (t : ℕ) :
    Integrable (fun omega =>
      averageObjective S (correctedCenter S omega alpha t)) S.probability := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  let z : Ω → Point d := fun omega => correctedCenter S omega alpha t
  let base : Point d := S.initialPoint
  let g : Point d := gradient (averageObjective S) base
  let lower : ℝ := sInf (Set.range (averageObjective S))
  let upper : Ω → ℝ := fun omega =>
    averageObjective S base + ⟪g, z omega - base⟫_ℝ +
      (S.L / 2) * ‖z omega - base‖ ^ 2
  have hz_mem : MemLp z 2 S.probability :=
    (corrected_center_descent_payload_memLp_two S alpha t).1
  have hdisp_mem : MemLp (fun omega => z omega - base) 2 S.probability :=
    hz_mem.sub (memLp_const base)
  have hdisp_sq : Integrable (fun omega => ‖z omega - base‖ ^ 2)
      S.probability :=
    (memLp_two_iff_integrable_sq_norm hdisp_mem.aestronglyMeasurable).1
      hdisp_mem
  have hinner : Integrable (fun omega => ⟪g, z omega - base⟫_ℝ)
      S.probability :=
    integrable_inner_of_integrable_sq_norm
      aestronglyMeasurable_const hdisp_mem.aestronglyMeasurable
      (integrable_const _) hdisp_sq
  have hupper : Integrable upper S.probability := by
    dsimp [upper]
    exact ((integrable_const _).add hinner).add (hdisp_sq.const_mul (S.L / 2))
  have havg_meas : Measurable (averageObjective S) := by
    unfold averageObjective
    apply measurable_const.mul
    apply Finset.measurable_sum
    intro i _hi
    exact (S.local_smooth i).1.continuous.measurable
  have hz_meas : Measurable z :=
    ((correctedCenter_and_drift_measurable S alpha).1 t).mono
      (preSamplingHistory_le S t) le_rfl
  have hvalue_meas : Measurable (fun omega => averageObjective S (z omega)) :=
    havg_meas.comp hz_meas
  have hbdd : BddBelow (Set.range (averageObjective S)) := by
    simpa [averageObjective] using S.average_lower_bounded
  have hmajorant : Integrable (fun omega => |lower| + |upper omega|)
      S.probability :=
    (integrable_const |lower|).add (by
      simpa [Real.norm_eq_abs] using hupper.norm)
  refine Integrable.mono' hmajorant hvalue_meas.aestronglyMeasurable ?_
  exact Filter.Eventually.of_forall fun omega => by
    have hlower : lower ≤ averageObjective S (z omega) := by
      dsimp [lower]
      exact csInf_le hbdd ⟨z omega, rfl⟩
    have hsmooth := average_objective_smooth_interface S (z omega) base
    have hobj_upper : averageObjective S (z omega) ≤ upper omega := by
      dsimp [upper, g]
      linarith
    have habs : |averageObjective S (z omega)| ≤ |lower| + |upper omega| := by
      rw [abs_le]
      constructor
      · have hneg : -|lower| ≤ lower := neg_abs_le lower
        nlinarith [abs_nonneg (upper omega)]
      · exact hobj_upper.trans
          ((le_abs_self (upper omega)).trans
            (le_add_of_nonneg_left (abs_nonneg lower)))
    have hmaj_nonneg : 0 ≤ |lower| + |upper omega| := by positivity
    simpa [Real.norm_eq_abs, abs_of_nonneg hmaj_nonneg] using habs

/-- A predictable square-integrable payload is orthogonal in expectation to
the current influence innovation; the same interface retains its sharp second
moment bound. -/
theorem influence_noise_martingale_interface
    (S : Setup n d Ω) (t : ℕ) (U : Ω → Point d)
    (hU_meas : Measurable[preSamplingHistory S t] U)
    (hU_mem : MemLp U 2 S.probability) :
    Integrable (fun omega => ⟪U omega, influenceNoise S omega t⟫_ℝ)
        S.probability ∧
      (∫ omega, ⟪U omega, influenceNoise S omega t⟫_ℝ
          ∂S.probability) = 0 ∧
      (∫ omega, ‖influenceNoise S omega t‖ ^ 2 ∂S.probability) ≤
        S.σ ^ 2 * influenceEnergy S.network t := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  have hmom := weighted_noise_conditional_moments S t
    (influenceRow S.network t)
  have hcenter :
      SOptLib.ConditionalExpectation.conditionalExpectationEq S.probability
        (preSamplingHistory S t) (fun omega => influenceNoise S omega t)
        (fun _ => 0) := by
    simpa [influenceNoise] using hmom.1
  have hsecond :
      ConditionalSecondMomentBound S.probability (preSamplingHistory S t)
        (fun omega => influenceNoise S omega t)
        (S.σ ^ 2 * influenceEnergy S.network t) := by
    simpa [influenceNoise, influenceEnergy] using hmom.2
  rcases hcenter.wellDefined with ⟨hm, hsf, hnoise_int⟩
  letI : @SigmaFinite Ω (preSamplingHistory S t)
      (S.probability.trim hm) := hsf
  have hnoise_sq : Integrable
      (fun omega => ‖influenceNoise S omega t‖ ^ 2) S.probability :=
    hsecond.1.integrable
  have hnoise_mem :
      MemLp (fun omega => influenceNoise S omega t) 2 S.probability :=
    (memLp_two_iff_integrable_sq_norm hnoise_int.aestronglyMeasurable).2
      hnoise_sq
  have hinner : Integrable
      (fun omega => ⟪U omega, influenceNoise S omega t⟫_ℝ)
      S.probability :=
    integrable_inner_of_integrable_sq_norm
      hU_mem.aestronglyMeasurable hnoise_mem.aestronglyMeasurable
      ((memLp_two_iff_integrable_sq_norm hU_mem.aestronglyMeasurable).1 hU_mem)
      hnoise_sq
  have hinner_rev : Integrable
      (fun omega => ⟪influenceNoise S omega t, U omega - 0⟫_ℝ)
      S.probability := by
    simpa [real_inner_comm] using hinner
  have hscalar_ce :
      SOptLib.ConditionalExpectation.conditionalExpectationEq S.probability
        (preSamplingHistory S t)
        (fun omega => ⟪influenceNoise S omega t, U omega - 0⟫_ℝ)
        (fun _ => 0) := by
    refine ⟨⟨hm, hsf, hinner_rev⟩, ?_⟩
    exact condExp_inner_sub_const_eq_zero_of_condExp_eq_zero
      hU_meas hcenter.ae_eq hnoise_int hinner_rev
  have hzero_rev :=
    SOptLib.ConditionalExpectation.conditionalExpectationEq.integral_eq hscalar_ce
  have hzero :
      (∫ omega, ⟪U omega, influenceNoise S omega t⟫_ℝ
        ∂S.probability) = 0 := by
    rw [show (fun omega => ⟪U omega, influenceNoise S omega t⟫_ℝ) =
        (fun omega => ⟪influenceNoise S omega t, U omega - 0⟫_ℝ) by
      funext omega
      simp [real_inner_comm]]
    simpa using hzero_rev
  have hnoise_bound :
      (∫ omega, ‖influenceNoise S omega t‖ ^ 2 ∂S.probability) ≤
        S.σ ^ 2 * influenceEnergy S.network t := by
    calc
      (∫ omega, ‖influenceNoise S omega t‖ ^ 2 ∂S.probability) =
          ∫ omega, MeasureTheory.condExp (preSamplingHistory S t)
            S.probability
            (fun omega => ‖influenceNoise S omega t‖ ^ 2) omega
              ∂S.probability := hsecond.1.integral_condExp.symm
      _ ≤ ∫ _omega : Ω, S.σ ^ 2 * influenceEnergy S.network t
          ∂S.probability := by
        apply MeasureTheory.integral_mono_ae MeasureTheory.integrable_condExp
          (integrable_const _)
        exact hsecond.2
      _ = S.σ ^ 2 * influenceEnergy S.network t := by simp
  exact ⟨hinner, hzero, hnoise_bound⟩

/-- The exact expected one-step corrected-center descent inequality, after
martingale cancellation and the source stepsize absorption. -/
theorem corrected_center_expected_one_step_descent
    (S : Setup n d Ω) (alpha : ℝ) (halpha : 0 < alpha)
    (hs : dimensionlessStepsize S.L alpha ≤
      correctedCenterStepCap S.network) (t : ℕ) :
    alpha * gainFloor S.network / 2 *
        SOptLib.expectation S.probability (fun omega =>
          ‖gradient (averageObjective S)
            (correctedCenter S omega alpha t)‖ ^ 2) ≤
      SOptLib.expectation S.probability (fun omega =>
        averageObjective S (correctedCenter S omega alpha t) -
          averageObjective S (correctedCenter S omega alpha (t + 1))) +
      2 * alpha / gainFloor S.network *
        SOptLib.expectation S.probability (fun omega =>
          ‖correctedDrift S omega alpha t‖ ^ 2) +
      S.L * alpha ^ 2 * S.σ ^ 2 / 2 *
        influenceEnergy S.network t := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  let k := gain S.network t
  let kfloor := gainFloor S.network
  have hgain := gain_bounds_before_corrected_center_control S.network t
  have hkfloor_le : kfloor ≤ k := hgain.1
  have hk_le : k ≤ (n : ℝ) := hgain.2
  have hs_pos : 0 < dimensionlessStepsize S.L alpha := by
    unfold dimensionlessStepsize
    exact mul_pos halpha S.hL
  have hlast : correctedCenterStepCap S.network ≤
      gainFloor S.network / Real.sqrt (8 * controlRB S.network) := by
    unfold correctedCenterStepCap
    exact (min_le_right _ _).trans
      ((min_le_right _ _).trans
        ((min_le_right _ _).trans (min_le_right _ _)))
  have hkfloor_pos : 0 < kfloor := by
    dsimp [kfloor]
    by_contra hnot
    have hnonpos : gainFloor S.network ≤ 0 := le_of_not_gt hnot
    have hquot_nonpos : gainFloor S.network /
        Real.sqrt (8 * controlRB S.network) ≤ 0 :=
      div_nonpos_of_nonpos_of_nonneg hnonpos (Real.sqrt_nonneg _)
    have := hs.trans hlast
    linarith
  have hk_pos : 0 < k := hkfloor_pos.trans_le hkfloor_le
  have hquarter : S.L * alpha ≤ 1 / (4 * (n : ℝ)) := by
    have hcap : correctedCenterStepCap S.network ≤
        1 / (4 * (n : ℝ)) := by
      unfold correctedCenterStepCap
      exact (min_le_right _ _).trans (min_le_left _ _)
    simpa [dimensionlessStepsize, mul_comm] using hs.trans hcap
  have hn_pos : 0 < (n : ℝ) := by exact_mod_cast S.hn
  have hLalpha_k : S.L * alpha * k ≤ 1 / 4 := by
    have hmul := mul_le_mul hquarter hk_le hk_pos.le
      (div_nonneg (by norm_num) (mul_nonneg (by norm_num) hn_pos.le))
    have hid : (1 / (4 * (n : ℝ))) * (n : ℝ) = 1 / 4 := by
      field_simp
    nlinarith
  have hquadcoef : S.L * alpha ^ 2 * k ^ 2 ≤ alpha * k / 4 := by
    have hmul := mul_le_mul_of_nonneg_left hLalpha_k
      (mul_nonneg halpha.le hk_pos.le)
    nlinarith
  have hkfloor_le_n : kfloor ≤ (n : ℝ) := hkfloor_le.trans hk_le
  have hLalpha_floor : S.L * alpha * kfloor ≤ 1 / 4 := by
    have hmul := mul_le_mul hquarter hkfloor_le_n hkfloor_pos.le
      (div_nonneg (by norm_num) (mul_nonneg (by norm_num) hn_pos.le))
    have hid : (1 / (4 * (n : ℝ))) * (n : ℝ) = 1 / 4 := by
      field_simp
    nlinarith
  have hLalpha2 : S.L * alpha ^ 2 ≤ alpha / kfloor := by
    apply (le_div_iff₀ hkfloor_pos).2
    have hmul := mul_le_mul_of_nonneg_left hLalpha_floor halpha.le
    nlinarith
  have hgradcoef :
      alpha * kfloor / 2 + alpha * kfloor / 4 +
          S.L * alpha ^ 2 * k ^ 2 ≤ alpha * k := by
    nlinarith
  have hdriftcoef : alpha / kfloor + S.L * alpha ^ 2 ≤
      2 * alpha / kfloor := by
    have heq : 2 * alpha / kfloor =
        alpha / kfloor + alpha / kfloor := by ring
    calc
      alpha / kfloor + S.L * alpha ^ 2 =
          S.L * alpha ^ 2 + alpha / kfloor := by ring
      _ ≤ alpha / kfloor + alpha / kfloor :=
        add_le_add_left hLalpha2 (alpha / kfloor)
      _ = 2 * alpha / kfloor := heq.symm
  have hpayload := corrected_center_descent_payload_memLp_two S alpha t
  have hgrad_mem := hpayload.2.1
  have hdrift_mem := hpayload.2.2.1
  have hcombined_mem := hpayload.2.2.2
  have hgrad_sq : Integrable (fun omega =>
      ‖gradient (averageObjective S) (correctedCenter S omega alpha t)‖ ^ 2)
      S.probability :=
    (memLp_two_iff_integrable_sq_norm hgrad_mem.aestronglyMeasurable).1
      hgrad_mem
  have hdrift_sq : Integrable (fun omega =>
      ‖correctedDrift S omega alpha t‖ ^ 2) S.probability :=
    (memLp_two_iff_integrable_sq_norm hdrift_mem.aestronglyMeasurable).1
      hdrift_mem
  have hcombined_sq : Integrable (fun omega =>
      ‖(gain S.network t) •
          gradient (averageObjective S) (correctedCenter S omega alpha t) +
        correctedDrift S omega alpha t‖ ^ 2) S.probability :=
    (memLp_two_iff_integrable_sq_norm hcombined_mem.aestronglyMeasurable).1
      hcombined_mem
  have hgrad_meas : Measurable[preSamplingHistory S t] (fun omega =>
      gradient (averageObjective S) (correctedCenter S omega alpha t)) := by
    have hcenter := (correctedCenter_and_drift_measurable S alpha).1 t
    have hgradEq (q : Point d) :
        gradient (averageObjective S) q =
          (n : ℝ)⁻¹ • ∑ i : Fin n, gradient (S.localObjective i) q := by
      have hfun : averageObjective S =
          SOptLib.finiteUniformAverage S.localObjective := by
        funext z
        simp [averageObjective, SOptLib.finiteUniformAverage_def,
          Fintype.card_fin, smul_eq_mul]
      rw [hfun]
      have h :=
        SOptLib.gradient_finiteUniformAverage_eq_finiteUniformAverage_gradient
          S.localObjective (fun i z => gradient (S.localObjective i) z) q
          (fun i => ((S.local_smooth i).1 q).hasGradientAt)
      simpa [SOptLib.finiteUniformAverage_def, Fintype.card_fin] using h
    have hsum : Measurable[preSamplingHistory S t] (fun omega =>
        ∑ i : Fin n,
          gradient (S.localObjective i) (correctedCenter S omega alpha t)) := by
      apply Finset.measurable_sum
      intro i _hi
      exact (S.local_smooth i).2.continuous.measurable.comp hcenter
    simpa only [hgradEq] using hsum.const_smul ((n : ℝ)⁻¹)
  have hcombined_meas : Measurable[preSamplingHistory S t] (fun omega =>
      (gain S.network t) •
          gradient (averageObjective S) (correctedCenter S omega alpha t) +
        correctedDrift S omega alpha t) :=
    hgrad_meas.const_smul (gain S.network t) |>.add
      ((correctedCenter_and_drift_measurable S alpha).2 t)
  have hcross_grad := influence_noise_martingale_interface S t
    (fun omega =>
      gradient (averageObjective S) (correctedCenter S omega alpha t))
    hgrad_meas hgrad_mem
  have hcross_combined := influence_noise_martingale_interface S t
    (fun omega =>
      (gain S.network t) •
          gradient (averageObjective S) (correctedCenter S omega alpha t) +
        correctedDrift S omega alpha t)
    hcombined_meas hcombined_mem
  have hnoise_sq : Integrable (fun omega =>
      ‖influenceNoise S omega t‖ ^ 2) S.probability := by
    have hmom := weighted_noise_conditional_moments S t
      (influenceRow S.network t)
    simpa [influenceNoise, influenceEnergy] using hmom.2.1.integrable
  have hobj := corrected_center_objective_integrable S alpha t
  have hobj_next := corrected_center_objective_integrable S alpha (t + 1)
  let A : Ω → ℝ := fun omega => alpha * kfloor / 2 *
    ‖gradient (averageObjective S) (correctedCenter S omega alpha t)‖ ^ 2
  let Drop : Ω → ℝ := fun omega =>
    averageObjective S (correctedCenter S omega alpha t) -
      averageObjective S (correctedCenter S omega alpha (t + 1))
  let Drift : Ω → ℝ := fun omega => 2 * alpha / kfloor *
    ‖correctedDrift S omega alpha t‖ ^ 2
  let CrossGrad : Ω → ℝ := fun omega => -alpha *
    ⟪gradient (averageObjective S) (correctedCenter S omega alpha t),
      influenceNoise S omega t⟫_ℝ
  let CrossCombined : Ω → ℝ := fun omega => S.L * alpha ^ 2 *
    ⟪(gain S.network t) •
          gradient (averageObjective S) (correctedCenter S omega alpha t) +
        correctedDrift S omega alpha t,
      influenceNoise S omega t⟫_ℝ
  let Noise : Ω → ℝ := fun omega => S.L * alpha ^ 2 / 2 *
    ‖influenceNoise S omega t‖ ^ 2
  have hA : Integrable A S.probability := hgrad_sq.const_mul _
  have hDrop : Integrable Drop S.probability := hobj.sub hobj_next
  have hDrift : Integrable Drift S.probability := hdrift_sq.const_mul _
  have hCrossGrad : Integrable CrossGrad S.probability :=
    hcross_grad.1.const_mul _
  have hCrossCombined : Integrable CrossCombined S.probability :=
    hcross_combined.1.const_mul _
  have hNoise : Integrable Noise S.probability := hnoise_sq.const_mul _
  have hpoint : ∀ omega, A omega ≤
      (((Drop omega + Drift omega) + CrossGrad omega) +
        CrossCombined omega) + Noise omega := by
    intro omega
    let gvec := gradient (averageObjective S)
      (correctedCenter S omega alpha t)
    let eta := correctedDrift S omega alpha t
    let xi := influenceNoise S omega t
    let combined := k • gvec + eta
    have hstep := corrected_center_smooth_step_exact S omega alpha halpha t
    have hsquare : ‖combined‖ ^ 2 ≤
        2 * k ^ 2 * ‖gvec‖ ^ 2 + 2 * ‖eta‖ ^ 2 := by
      have hraw :=
        SOptLib.norm_add_sq_le_two_mul_norm_sq_add_two_mul_norm_sq
          (k • gvec) eta
      dsimp [combined]
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hk_pos, mul_pow] at hraw
      nlinarith
    have hsquare_scaled :
        (S.L * alpha ^ 2 / 2) * ‖combined‖ ^ 2 ≤
          (S.L * alpha ^ 2 / 2) *
            (2 * k ^ 2 * ‖gvec‖ ^ 2 + 2 * ‖eta‖ ^ 2) :=
      mul_le_mul_of_nonneg_left hsquare
        (div_nonneg (mul_nonneg S.hL.le (sq_nonneg alpha)) (by norm_num))
    have hqpos : 0 < kfloor / 2 := by positivity
    have hyoung_raw :=
      neg_inner_le_half_mul_norm_sq_add_inv_two_mul_norm_sq
        hqpos eta gvec
    have hcoef : 1 / (2 * (kfloor / 2)) = 1 / kfloor := by
      field_simp
    have hcoef_half : kfloor / 2 / 2 = kfloor / 4 := by ring
    have hyoung : -⟪gvec, eta⟫_ℝ ≤
        kfloor / 4 * ‖gvec‖ ^ 2 + 1 / kfloor * ‖eta‖ ^ 2 := by
      rw [real_inner_comm]
      rw [hcoef, hcoef_half] at hyoung_raw
      exact hyoung_raw
    have hyoung_scaled := mul_le_mul_of_nonneg_left hyoung halpha.le
    have hyoung_scaled' :
        -alpha * ⟪gvec, eta⟫_ℝ ≤
          alpha * kfloor / 4 * ‖gvec‖ ^ 2 +
            alpha / kfloor * ‖eta‖ ^ 2 := by
      calc
        -alpha * ⟪gvec, eta⟫_ℝ =
            alpha * (-⟪gvec, eta⟫_ℝ) := by ring
        _ ≤ alpha *
            (kfloor / 4 * ‖gvec‖ ^ 2 +
              1 / kfloor * ‖eta‖ ^ 2) := hyoung_scaled
        _ = alpha * kfloor / 4 * ‖gvec‖ ^ 2 +
            alpha / kfloor * ‖eta‖ ^ 2 := by ring
    have hgrad_absorb :
        (alpha * kfloor / 2 + alpha * kfloor / 4 +
            S.L * alpha ^ 2 * k ^ 2) * ‖gvec‖ ^ 2 ≤
          (alpha * k) * ‖gvec‖ ^ 2 :=
      mul_le_mul_of_nonneg_right hgradcoef (sq_nonneg ‖gvec‖)
    have hdrift_absorb :
        (alpha / kfloor + S.L * alpha ^ 2) * ‖eta‖ ^ 2 ≤
          (2 * alpha / kfloor) * ‖eta‖ ^ 2 :=
      mul_le_mul_of_nonneg_right hdriftcoef (sq_nonneg ‖eta‖)
    have hfromstep :
        alpha * k * ‖gvec‖ ^ 2 ≤
          averageObjective S (correctedCenter S omega alpha t) -
              averageObjective S (correctedCenter S omega alpha (t + 1)) -
            alpha * ⟪gvec, eta⟫_ℝ - alpha * ⟪gvec, xi⟫_ℝ +
            S.L * alpha ^ 2 * k ^ 2 * ‖gvec‖ ^ 2 +
            S.L * alpha ^ 2 * ‖eta‖ ^ 2 +
            S.L * alpha ^ 2 * ⟪combined, xi⟫_ℝ +
            S.L * alpha ^ 2 / 2 * ‖xi‖ ^ 2 := by
      dsimp [combined, gvec, eta, xi, k] at ⊢
      dsimp [combined, gvec, eta, xi, k] at hsquare_scaled
      nlinarith [hstep, hsquare_scaled]
    have hafterYoung :
        alpha * k * ‖gvec‖ ^ 2 ≤
          averageObjective S (correctedCenter S omega alpha t) -
              averageObjective S (correctedCenter S omega alpha (t + 1)) +
            alpha * kfloor / 4 * ‖gvec‖ ^ 2 +
            alpha / kfloor * ‖eta‖ ^ 2 -
            alpha * ⟪gvec, xi⟫_ℝ +
            S.L * alpha ^ 2 * k ^ 2 * ‖gvec‖ ^ 2 +
            S.L * alpha ^ 2 * ‖eta‖ ^ 2 +
            S.L * alpha ^ 2 * ⟪combined, xi⟫_ℝ +
            S.L * alpha ^ 2 / 2 * ‖xi‖ ^ 2 := by
      nlinarith [hfromstep, hyoung_scaled']
    dsimp [A, Drop, Drift, CrossGrad, CrossCombined, Noise,
      gvec, eta, xi, combined, k, kfloor]
    dsimp [combined, gvec, eta, xi, k, kfloor] at hafterYoung hgrad_absorb hdrift_absorb
    nlinarith [hafterYoung, hgrad_absorb, hdrift_absorb]
  have hintegral := MeasureTheory.integral_mono hA
    ((((hDrop.add hDrift).add hCrossGrad).add hCrossCombined).add hNoise)
    hpoint
  have hcross_grad_scaled : (∫ omega, CrossGrad omega ∂S.probability) = 0 := by
    dsimp [CrossGrad]
    rw [MeasureTheory.integral_const_mul, hcross_grad.2.1, mul_zero]
  have hcross_combined_scaled :
      (∫ omega, CrossCombined omega ∂S.probability) = 0 := by
    dsimp [CrossCombined]
    rw [MeasureTheory.integral_const_mul, hcross_combined.2.1, mul_zero]
  have hIntegralDropDrift :
      (∫ omega, Drop omega + Drift omega ∂S.probability) =
        (∫ omega, Drop omega ∂S.probability) +
          ∫ omega, Drift omega ∂S.probability := by
    simpa only [Pi.add_apply] using
      MeasureTheory.integral_add hDrop hDrift
  have hIntegralCrossGrad :
      (∫ omega, (Drop omega + Drift omega) + CrossGrad omega
          ∂S.probability) =
        (∫ omega, Drop omega + Drift omega ∂S.probability) +
          ∫ omega, CrossGrad omega ∂S.probability := by
    simpa only [Pi.add_apply] using
      MeasureTheory.integral_add (hDrop.add hDrift) hCrossGrad
  have hIntegralCrossCombined :
      (∫ omega, ((Drop omega + Drift omega) + CrossGrad omega) +
          CrossCombined omega ∂S.probability) =
        (∫ omega, (Drop omega + Drift omega) + CrossGrad omega
          ∂S.probability) +
          ∫ omega, CrossCombined omega ∂S.probability := by
    simpa only [Pi.add_apply] using
      MeasureTheory.integral_add ((hDrop.add hDrift).add hCrossGrad)
        hCrossCombined
  have hIntegralNoise :
      (∫ omega, (((Drop omega + Drift omega) + CrossGrad omega) +
          CrossCombined omega) + Noise omega ∂S.probability) =
        (∫ omega, ((Drop omega + Drift omega) + CrossGrad omega) +
          CrossCombined omega ∂S.probability) +
          ∫ omega, Noise omega ∂S.probability := by
    simpa only [Pi.add_apply] using
      MeasureTheory.integral_add
        (((hDrop.add hDrift).add hCrossGrad).add hCrossCombined) hNoise
  have hexpanded :
      (∫ omega, A omega ∂S.probability) ≤
        (∫ omega, Drop omega ∂S.probability) +
        (∫ omega, Drift omega ∂S.probability) +
        (∫ omega, Noise omega ∂S.probability) := by
    simp only [Pi.add_apply] at hintegral
    rw [hIntegralNoise, hIntegralCrossCombined, hIntegralCrossGrad,
      hIntegralDropDrift,
      hcross_grad_scaled, hcross_combined_scaled] at hintegral
    linarith
  have hnoise_scaled :
      (∫ omega, Noise omega ∂S.probability) ≤
        S.L * alpha ^ 2 / 2 *
          (S.σ ^ 2 * influenceEnergy S.network t) := by
    dsimp [Noise]
    rw [MeasureTheory.integral_const_mul]
    exact mul_le_mul_of_nonneg_left hcross_grad.2.2
      (div_nonneg (mul_nonneg S.hL.le (sq_nonneg alpha)) (by norm_num))
  calc
    alpha * gainFloor S.network / 2 *
        SOptLib.expectation S.probability (fun omega =>
          ‖gradient (averageObjective S)
            (correctedCenter S omega alpha t)‖ ^ 2) =
        ∫ omega, A omega ∂S.probability := by
      dsimp [A, kfloor, SOptLib.expectation]
      rw [MeasureTheory.integral_const_mul]
    _ ≤ (∫ omega, Drop omega ∂S.probability) +
          (∫ omega, Drift omega ∂S.probability) +
          (∫ omega, Noise omega ∂S.probability) := hexpanded
    _ ≤ (∫ omega, Drop omega ∂S.probability) +
          (∫ omega, Drift omega ∂S.probability) +
          S.L * alpha ^ 2 / 2 *
            (S.σ ^ 2 * influenceEnergy S.network t) := by linarith
    _ = _ := by
      dsimp [Drop, Drift, kfloor, SOptLib.expectation]
      rw [MeasureTheory.integral_const_mul]
      ring

/-- The expected corrected-center objective drops telescope to the initial
source gap, with the terminal value bounded below by the objective infimum. -/
theorem corrected_center_objective_drop_telescope
    (S : Setup n d Ω) (alpha : ℝ) (T : PositiveHorizon) :
    ∑ t ∈ Finset.range T.1,
        SOptLib.expectation S.probability (fun omega =>
          averageObjective S (correctedCenter S omega alpha t) -
            averageObjective S (correctedCenter S omega alpha (t + 1))) ≤
      S.Δ := by
  classical
  letI : IsProbabilityMeasure S.probability := S.is_probability
  let F : ℕ → Ω → ℝ := fun t omega =>
    averageObjective S (correctedCenter S omega alpha t)
  have hF (t : ℕ) : Integrable (F t) S.probability := by
    simpa [F] using corrected_center_objective_integrable S alpha t
  have hdrop (t : ℕ) : Integrable (fun omega => F t omega - F (t + 1) omega)
      S.probability := (hF t).sub (hF (t + 1))
  have hswap :
      (∑ t ∈ Finset.range T.1,
          SOptLib.expectation S.probability (fun omega =>
            F t omega - F (t + 1) omega)) =
        ∫ omega, ∑ t ∈ Finset.range T.1,
          (F t omega - F (t + 1) omega) ∂S.probability := by
    unfold SOptLib.expectation
    rw [MeasureTheory.integral_finset_sum (Finset.range T.1)
      (fun t _ht => hdrop t)]
  have htelescope (omega : Ω) :
      (∑ t ∈ Finset.range T.1,
          (F t omega - F (t + 1) omega)) =
        F 0 omega - F T.1 omega := by
    exact Finset.sum_range_sub' (fun t => F t omega) T.1
  have hendpoint :
      (∑ t ∈ Finset.range T.1,
          SOptLib.expectation S.probability (fun omega =>
            F t omega - F (t + 1) omega)) =
        averageObjective S S.initialPoint -
          ∫ omega, F T.1 omega ∂S.probability := by
    rw [hswap]
    calc
      (∫ omega, ∑ t ∈ Finset.range T.1,
          (F t omega - F (t + 1) omega) ∂S.probability) =
          ∫ omega, F 0 omega - F T.1 omega ∂S.probability := by
        apply MeasureTheory.integral_congr_ae
        exact Filter.Eventually.of_forall htelescope
      _ = (∫ omega, F 0 omega ∂S.probability) -
          ∫ omega, F T.1 omega ∂S.probability := by
        exact MeasureTheory.integral_sub (hF 0) (hF T.1)
      _ = averageObjective S S.initialPoint -
          ∫ omega, F T.1 omega ∂S.probability := by
        have hzero : (fun omega => F 0 omega) =
            (fun _omega : Ω => averageObjective S S.initialPoint) := by
          funext omega
          simp [F, correctedCenter_zero]
        rw [hzero]
        simp
  have hbdd : BddBelow (Set.range (averageObjective S)) := by
    simpa [averageObjective] using S.average_lower_bounded
  have hterminal : sInf (Set.range (averageObjective S)) ≤
      ∫ omega, F T.1 omega ∂S.probability := by
    have hmono := MeasureTheory.integral_mono
      (integrable_const (sInf (Set.range (averageObjective S))))
      (hF T.1) (fun omega =>
        csInf_le hbdd ⟨correctedCenter S omega alpha T.1, rfl⟩)
    simpa [F] using hmono
  have hgap : averageObjective S S.initialPoint -
      sInf (Set.range (averageObjective S)) = S.Δ := by
    simpa [averageObjective] using S.exact_initial_gap
  rw [hendpoint]
  linarith

/-- Equations (9)--(13), on the generated Push--Pull trajectory.

Statement-correction record: an earlier transcription placed the old-gradient
term outside the finite-sum binder.  `escapedOldGradientRecurrence_false`
formally refutes that parse on a feasible Setup; the parenthesized summand below
is the expansion of `(I-v_{t+1}1ᵀ)(Z_{t+1}-Z_t)` in source equation (9).

All
measurability and moment facts are conclusions derived from the source oracle
contract, not extra theorem-head assumptions.
Book `#/key_lemmas/1/statement_math`:
“`z_{t+1}=z_t-\alpha\{\kappa_t\nabla f(z_t)+\eta_t+b_t^\top\varepsilon_t\}`”. -/
theorem corrected_center_uniform_control
    (S : Setup n d Ω) (hLayer : InFiniteHeterogeneityLayer S)
    (α : ℝ) (hα : 0 < α)
    (hs : dimensionlessStepsize S.L α ≤ correctedCenterStepCap S.network)
    (T : PositiveHorizon) :
    (∀ ω t,
      correctedTrackerDisagreement S ω α (t + 1) =
        leftAct (S.colMix t) (correctedTrackerDisagreement S ω α t) +
          (fun i => gradientTable S ω α (t + 1) i - gradientTable S ω α t i -
            (normalizedPushMass S.network (t + 1) i) •
              (∑ j, (gradientTable S ω α (t + 1) j -
                gradientTable S ω α t j)))) ∧
    (∀ ω,
      correctedTrackerDisagreement S ω α 0 =
        fun i => gradientTable S ω α 0 i -
          (n : ℝ)⁻¹ • ∑ j, gradientTable S ω α 0 j) ∧
    (∀ ω, correctedCenter S ω α 0 = S.initialPoint) ∧
    (∀ ω t,
      correctedCenter S ω α (t + 1) = correctedCenter S ω α t -
        α • ((gain S.network t) •
          gradient (averageObjective S) (correctedCenter S ω α t) +
          correctedDrift S ω α t + influenceNoise S ω t)) ∧
    (∀ t, Measurable[preSamplingHistory S t] (fun ω => correctedCenter S ω α t)) ∧
    (∀ t, Measurable[preSamplingHistory S t] (fun ω => correctedDrift S ω α t)) ∧
    (∀ t,
      SOptLib.ConditionalExpectation.conditionalExpectationEq S.probability
        (preSamplingHistory S t) (fun ω => influenceNoise S ω t) (fun _ => 0) ∧
      ConditionalSecondMomentBound S.probability (preSamplingHistory S t)
        (fun ω => influenceNoise S ω t) (S.σ ^ 2 * influenceEnergy S.network t)) ∧
    trackerEnergy S α T ≤
      controlMB n * correctedGradientEnergy S α T +
      controlMH S.network * n * S.H ^ 2 +
      controlMN S.network * S.σ ^ 2 * T.1 ∧
    correctedDriftEnergy S α T ≤
      controlRH S.network * n * S.H ^ 2 +
      dimensionlessStepsize S.L α ^ 2 *
        (controlRB S.network * correctedGradientEnergy S α T +
          controlRN S.network * S.σ ^ 2 * T.1) ∧
    correctedCenterOffsetEnergy S α T ≤
      α ^ 2 * (controlJB S.network * correctedGradientEnergy S α T +
        controlJH S.network * n * S.H ^ 2 +
        controlJN S.network * S.σ ^ 2 * T.1) ∧
    correctedGradientEnergy S α T ≤ correctedGradientUpperBound S α T := by
  refine ⟨fun ω t => correctedTrackerDisagreement_succ S ω α t, ?_⟩
  refine ⟨fun ω => correctedTrackerDisagreement_zero S ω α, ?_⟩
  refine ⟨fun ω => correctedCenter_zero S ω α, ?_⟩
  refine ⟨fun ω t => correctedCenter_succ S ω α t, ?_⟩
  rcases correctedCenter_and_drift_measurable S α with ⟨hcenter, hdrift⟩
  refine ⟨hcenter, hdrift, ?_⟩
  refine ⟨?_, ?_⟩
  · intro t
    simpa [influenceNoise, influenceEnergy] using
      weighted_noise_conditional_moments S t (influenceRow S.network t)
  · have htrackerPrefixPathwise : ∀ omega,
        ∑ t ∈ Finset.range T.1,
            nodeTableNormSq (correctedTrackerDisagreement S omega α t) ≤
          trackerInitialKernel S.network * (n : ℝ) * S.H ^ 2 +
          (2 * columnMixingConstant S.network ^ 2 /
              (1 - mixingRate S.network) ^ 2) *
            ∑ j ∈ Finset.range (T.1 - 1),
              ((1 + Real.sqrt n) *
                Real.sqrt (nodeTableNormSq
                  (gradientTable S omega α (j + 1) -
                    gradientTable S omega α j))) ^ 2 := by
      intro omega
      exact corrected_tracker_disagreement_pathwise_prefix_energy_of_layer
        S hLayer omega α T
    have hgradientIncrementPathwise : ∀ omega t,
        nodeTableNormSq
            (gradientTable S omega α (t + 1) -
              gradientTable S omega α t) ≤
          S.L ^ 2 * nodeTableNormSq
            (primal S omega α (t + 1) - primal S omega α t) := by
      intro omega t
      exact gradientTable_increment_energy_le S omega α t
    have hPrimalIncrementPathwise : ∀ omega,
        ∑ j ∈ Finset.range (T.1 - 1),
            nodeTableNormSq
              (primal S omega α (j + 1) - primal S omega α j) ≤
          α ^ 2 * incrementKernel S.network *
            ∑ t ∈ Finset.range T.1,
              nodeTableNormSq (tracker S omega α t) := by
      intro omega
      exact primal_increment_pathwise_prefix_energy S omega α hα.le T
    have hCorrectedTrackerPathwise : ∀ omega,
        ∑ t ∈ Finset.range T.1,
            nodeTableNormSq (correctedTrackerDisagreement S omega α t) ≤
          trackerInitialKernel S.network * (n : ℝ) * S.H ^ 2 +
            dimensionlessStepsize S.L α ^ 2 *
              trackerIncrementKernel S.network *
                ∑ t ∈ Finset.range T.1,
                  nodeTableNormSq (tracker S omega α t) := by
      intro omega
      have hsqrt_sq (Y : NodeTable n d) :
          Real.sqrt (nodeTableNormSq Y) ^ 2 = nodeTableNormSq Y := by
        rw [Real.sq_sqrt]
        exact Finset.sum_nonneg fun i _ => sq_nonneg ‖Y i‖
      have hforcing :
          (∑ j ∈ Finset.range (T.1 - 1),
              ((1 + Real.sqrt n) *
                Real.sqrt (nodeTableNormSq
                  (gradientTable S omega α (j + 1) -
                    gradientTable S omega α j))) ^ 2) ≤
            (1 + Real.sqrt n) ^ 2 * S.L ^ 2 *
              ∑ j ∈ Finset.range (T.1 - 1),
                nodeTableNormSq
                  (primal S omega α (j + 1) - primal S omega α j) := by
        calc
          _ = ∑ j ∈ Finset.range (T.1 - 1),
              (1 + Real.sqrt n) ^ 2 *
                nodeTableNormSq
                  (gradientTable S omega α (j + 1) -
                    gradientTable S omega α j) := by
            apply Finset.sum_congr rfl
            intro j _hj
            rw [mul_pow, hsqrt_sq]
          _ ≤ ∑ j ∈ Finset.range (T.1 - 1),
              (1 + Real.sqrt n) ^ 2 *
                (S.L ^ 2 * nodeTableNormSq
                  (primal S omega α (j + 1) - primal S omega α j)) := by
            apply Finset.sum_le_sum
            intro j _hj
            exact mul_le_mul_of_nonneg_left
              (hgradientIncrementPathwise omega j) (sq_nonneg _)
          _ = (1 + Real.sqrt n) ^ 2 * S.L ^ 2 *
              ∑ j ∈ Finset.range (T.1 - 1),
                nodeTableNormSq
                  (primal S omega α (j + 1) - primal S omega α j) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro j _hj
            ring
      have hforcingTracker :
          (∑ j ∈ Finset.range (T.1 - 1),
              ((1 + Real.sqrt n) *
                Real.sqrt (nodeTableNormSq
                  (gradientTable S omega α (j + 1) -
                    gradientTable S omega α j))) ^ 2) ≤
            (1 + Real.sqrt n) ^ 2 * S.L ^ 2 *
              (α ^ 2 * incrementKernel S.network *
                ∑ t ∈ Finset.range T.1,
                  nodeTableNormSq (tracker S omega α t)) :=
        hforcing.trans (mul_le_mul_of_nonneg_left
          (hPrimalIncrementPathwise omega)
          (mul_nonneg (sq_nonneg _) (sq_nonneg _)))
      have hcoef : 0 ≤
          2 * columnMixingConstant S.network ^ 2 /
            (1 - mixingRate S.network) ^ 2 :=
        div_nonneg (mul_nonneg (by norm_num) (sq_nonneg _)) (sq_nonneg _)
      calc
        _ ≤ trackerInitialKernel S.network * (n : ℝ) * S.H ^ 2 +
            (2 * columnMixingConstant S.network ^ 2 /
              (1 - mixingRate S.network) ^ 2) *
              ∑ j ∈ Finset.range (T.1 - 1),
                ((1 + Real.sqrt n) *
                  Real.sqrt (nodeTableNormSq
                    (gradientTable S omega α (j + 1) -
                      gradientTable S omega α j))) ^ 2 :=
          htrackerPrefixPathwise omega
        _ ≤ trackerInitialKernel S.network * (n : ℝ) * S.H ^ 2 +
            (2 * columnMixingConstant S.network ^ 2 /
              (1 - mixingRate S.network) ^ 2) *
              ((1 + Real.sqrt n) ^ 2 * S.L ^ 2 *
                (α ^ 2 * incrementKernel S.network *
                  ∑ t ∈ Finset.range T.1,
                    nodeTableNormSq (tracker S omega α t))) :=
          add_le_add le_rfl (mul_le_mul_of_nonneg_left hforcingTracker hcoef)
        _ = trackerInitialKernel S.network * (n : ℝ) * S.H ^ 2 +
            dimensionlessStepsize S.L α ^ 2 *
              trackerIncrementKernel S.network *
                ∑ t ∈ Finset.range T.1,
                  nodeTableNormSq (tracker S omega α t) := by
          unfold dimensionlessStepsize trackerIncrementKernel
          ring
    letI : IsProbabilityMeasure S.probability := S.is_probability
    have hTrackerEnergyIntegrable (t : ℕ) :
        Integrable (fun omega =>
