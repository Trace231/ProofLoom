    intro i _hi
    exact hgradientMem t i
  have hcorrectedTrackerMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => correctedTracker S omega alpha t i)
        2 S.probability := by
    simpa [correctedTracker] using
      ((htrackerMem t i).sub (hnoiseMem t i)).sub (hfilterMem t i)
  have hcorrectedDisagreementMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega => correctedTrackerDisagreement S omega alpha t i)
        2 S.probability := by
    simpa [correctedTrackerDisagreement] using
      (hcorrectedTrackerMem t i).sub
        ((hgradientSumMem t).const_smul (normalizedPushMass S.network t i))
  have hmeanMem (t : ℕ) :
      MemLp (fun omega => arithmeticMean S omega alpha t)
        2 S.probability := arithmeticMean_memLp_two S alpha t
  have hconsensusMem (t : ℕ) (i : Fin n) :
      MemLp (fun omega =>
        FiniteNetwork.consensusError (primal S omega alpha t) i)
        2 S.probability := by
    simpa [FiniteNetwork.consensusError_apply, FiniteNetwork.meanState,
      SOptLib.finiteUniformAverage_def, arithmeticMean, Fintype.card_fin] using
        (hprimalMem t i).sub (hmeanMem t)
  have htrackerEnergyInt (t : ℕ) : Integrable (fun omega =>
      nodeTableNormSq (tracker S omega alpha t)) S.probability := by
    simpa [nodeTableNormSq, SOptLib.dependentProductNormSq_def] using
      (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
        (fun omega => tracker S omega alpha t) (htrackerMem t)).1
  have hcorrectedEnergyInt (t : ℕ) : Integrable (fun omega =>
      nodeTableNormSq (correctedTrackerDisagreement S omega alpha t))
      S.probability := by
    simpa [nodeTableNormSq, SOptLib.dependentProductNormSq_def] using
      (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
        (fun omega => correctedTrackerDisagreement S omega alpha t)
        (hcorrectedDisagreementMem t)).1
  have hconsensusEnergyInt (t : ℕ) : Integrable (fun omega =>
      nodeTableNormSq
        (FiniteNetwork.consensusError (primal S omega alpha t)))
      S.probability := by
    simpa [nodeTableNormSq, SOptLib.dependentProductNormSq_def] using
      (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
        (fun omega => FiniteNetwork.consensusError (primal S omega alpha t))
        (hconsensusMem t)).1
  have hfilterEnergyInt (t : ℕ) : Integrable (fun omega =>
      nodeTableNormSq (filteredNoise S omega t)) S.probability := by
    simpa [nodeTableNormSq, SOptLib.dependentProductNormSq_def] using
      (SOptLib.integrable_dependentProductNormSq_and_centered_of_coordinate_memLp
        (fun omega => filteredNoise S omega t) (hfilterMem t)).1
  have hOffsetEnergyMeasurable (t : ℕ) : Measurable (fun omega =>
      ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2) := by
    have hc : Measurable (fun omega => correctedCenter S omega alpha t) :=
