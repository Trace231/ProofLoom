              (gainFloor S.network ^ 2 / 8 *
                correctedGradientEnergy S α T) := hscaled'
        _ = α * gainFloor S.network / 4 *
            correctedGradientEnergy S α T := by
          field_simp
          ring
    have hPreAbsorb :
        α * gainFloor S.network / 2 * correctedGradientEnergy S α T ≤
          S.Δ +
          2 * α / gainFloor S.network *
            (controlRH S.network * (n : ℝ) * S.H ^ 2 +
              s ^ 2 * (controlRB S.network * correctedGradientEnergy S α T +
                controlRN S.network * S.σ ^ 2 * T.1)) +
          S.L * α ^ 2 * S.σ ^ 2 / 2 *
            ∑ t ∈ Finset.range T.1, influenceEnergy S.network t := by
      calc
        α * gainFloor S.network / 2 * correctedGradientEnergy S α T ≤
            S.Δ + 2 * α / gainFloor S.network * correctedDriftEnergy S α T +
              S.L * α ^ 2 * S.σ ^ 2 / 2 *
                ∑ t ∈ Finset.range T.1, influenceEnergy S.network t := hDescent
        _ ≤ _ := by
          gcongr
    have hAbsorb :
        α * gainFloor S.network / 4 * correctedGradientEnergy S α T ≤
          S.Δ +
          2 * α / gainFloor S.network *
            (controlRH S.network * (n : ℝ) * S.H ^ 2) +
          2 * α / gainFloor S.network *
            (s ^ 2 * controlRN S.network * S.σ ^ 2 * T.1) +
          S.L * α ^ 2 * S.σ ^ 2 / 2 *
            ∑ t ∈ Finset.range T.1, influenceEnergy S.network t := by
      linarith
    have hscale : 0 ≤ 4 / (α * gainFloor S.network) := by positivity
    have hscaled := mul_le_mul_of_nonneg_left hAbsorb hscale
    unfold correctedGradientUpperBound
    dsimp [s] at hscaled
    unfold dimensionlessStepsize at hscaled ⊢
    convert hscaled using 1 <;> field_simp <;> ring

/-- Scalar Euclidean specialization of the zero-sum column-product
contraction.  This is the equation-(3) carrier bridge from the reusable
`stateL1Norm` estimate to the source-facing `nodeL2Norm`. -/
theorem scalar_colMix_nodeL2_geometric
    (N : NetworkSetup n) (t k : ℕ) (hkt : k ≤ t)
    (z : Fin n → ℝ) (hz : ∑ i, z i = 0) :
    nodeL2Norm ((forwardProduct N.colMix t k) *ᵥ z) ≤
      columnMixingConstant N * mixingRate N ^ (t - k) * nodeL2Norm z := by
  classical
  let Z : ZeroSumNodeVector n := ⟨z, hz⟩
  have hL1 := colMix_stateL1_geometric N k (t - k) Z
  have hcoeff_nonneg :
      0 ≤ (blockContraction N)⁻¹ * mixingRate N ^ (t - k) :=
    mul_nonneg (inv_nonneg.mpr (blockContraction_pos N).le)
      (pow_nonneg (mixingRate_nonneg N) _)
  have htransfer :=
    FiniteNetwork.dependentProductL2Seminorm_le_sqrt_card_mul_geometric_of_sum_norm_le
      (fun y : Fin n → ℝ =>
        Matrix.smulVec
          (FiniteNetwork.consecutiveProduct N.colMix k (t - k)) y)
      (blockContraction N)⁻¹ (mixingRate N) (t - k) z hcoeff_nonneg hL1
  calc
    nodeL2Norm ((forwardProduct N.colMix t k) *ᵥ z) =
        Real.sqrt (SOptLib.dependentProductNormSq
          (Matrix.smulVec
            (FiniteNetwork.consecutiveProduct N.colMix k (t - k)) z)) := by
      simp [forwardProduct, nodeL2Norm, SOptLib.dependentProductNormSq_def,
        Matrix.mulVec, dotProduct, Matrix.smulVec, Real.norm_eq_abs, sq_abs]
    _ ≤ (blockContraction N)⁻¹ * Real.sqrt (Fintype.card (Fin n) : ℝ) *
          mixingRate N ^ (t - k) *
          Real.sqrt (SOptLib.dependentProductNormSq z) := htransfer
    _ = columnMixingConstant N * mixingRate N ^ (t - k) * nodeL2Norm z := by
      have hnorm_z :
          Real.sqrt (SOptLib.dependentProductNormSq z) = nodeL2Norm z := by
        simp [nodeL2Norm, SOptLib.dependentProductNormSq_def,
          Real.norm_eq_abs, sq_abs]
      rw [hnorm_z]
      simp only [Fintype.card_fin]
      unfold columnMixingConstant
      rw [div_eq_mul_inv]
      ring

/-- Scalar Euclidean specialization of the row-product consensus estimate.
The arbitrary-window block induction is supplied by SOptLib; this lemma only
constructs the source block-minorization data and identifies the norm carrier. -/
theorem rowMix_disagreement_nodeL2_geometric
    (N : NetworkSetup n) (t k : ℕ) (hkt : k ≤ t) (x : Fin n → ℝ) :
    nodeL2Norm (disagreement ((forwardProduct N.rowMix t k) *ᵥ x)) ≤
      rowMixingConstant N * mixingRate N ^ (t - k) *
        nodeL2Norm (disagreement x) := by
  classical
  have hBpos : 0 < mixingBlockLength n := by
    unfold mixingBlockLength
    exact lt_of_lt_of_le Nat.zero_lt_one (le_max_left _ _)
  have hmu_pos : 0 < mixingMinorization N := by
    unfold mixingMinorization
    split_ifs
    · exact pow_pos ((lt_min_iff).2 ⟨N.ha, by norm_num⟩) _
    · norm_num
  have hdelta_lt : blockContraction N < 1 := by
    rw [blockContraction, max_lt_iff]
    constructor
    · norm_num
    · have hnR : (0 : ℝ) < n := Nat.cast_pos.mpr N.hn
      have hprod : 0 < (n : ℝ) * mixingMinorization N := mul_pos hnR hmu_pos
      linarith
  have hrate_pow : mixingRate N ^ mixingBlockLength n = blockContraction N := by
    unfold mixingRate
    exact Real.rpow_inv_natCast_pow (blockContraction_pos N).le
      (Nat.ne_of_gt hBpos)
  have hdelta_block :
      1 - (Fintype.card (Fin n) : ℝ) * mixingMinorization N ≤
        blockContraction N := by
    simpa [blockContraction] using
      (le_max_right (1 / 2 : ℝ)
        (1 - (n : ℝ) * mixingMinorization N))
  have hmix :=
    FiniteNetwork.consensusError_piLpNorm_consecutiveMatrixProduct_le_geometric_of_blockMinorization
      N.rowMix (mixingMinorization N) (blockContraction N) (mixingRate N)
      (mixingBlockLength n) hBpos (blockContraction_pos N) hdelta_lt
      (mixingRate_nonneg N) hrate_pow hdelta_block N.row_stochastic
      (rowMix_block_entry_ge_mixingMinorization N)
      k (t - k) x
  have hconsensus (y : Fin n → ℝ) :
      FiniteNetwork.consensusError y = disagreement y := by
    funext i
    simp [FiniteNetwork.consensusError_apply, FiniteNetwork.meanState,
      SOptLib.finiteUniformAverage, disagreement]
  have hnorm (y : Fin n → ℝ) :
      ‖WithLp.toLp 2 y‖ = nodeL2Norm y := by
    simp [PiLp.norm_eq_of_L2, nodeL2Norm, Real.norm_eq_abs, sq_abs]
  rw [hconsensus, hconsensus, hnorm, hnorm] at hmix
  simpa [forwardProduct, Matrix.mulVec, dotProduct, Matrix.smulVec,
    rowMixingConstant] using hmix

/-- The limit-defined absolute-probability row inherits the complete-block
minorization.  The proof passes the eventually closed coordinate inequality
through the defining forward-product limit. -/
theorem absolute_probability_ge_mixingMinorization
    (N : NetworkSetup n) (t : ℕ) (i : Fin n) :
    mixingMinorization N ≤ absoluteProbability N t i := by
  classical
  let B := mixingBlockLength n
  have hBpos : 0 < B := by
    dsimp [B, mixingBlockLength]
    exact lt_of_lt_of_le Nat.zero_lt_one (le_max_left _ _)
  have hlong (s : ℕ) (hs : t + B ≤ s) (r j : Fin n) :
      mixingMinorization N ≤ forwardProduct N.rowMix s t r j := by
    let q := s - t - B
    have hst : t ≤ s := by omega
    have hlen : s - t = B + q := by
      dsimp [q]
      omega
    have hleft :
        FiniteNetwork.consecutiveProduct N.rowMix (t + B) q ∈
          Matrix.rowStochastic ℝ (Fin n) :=
      FiniteNetwork.consecutiveMatrixProduct_mem_rowStochastic
        N.rowMix (t + B) q (fun u _ => N.row_stochastic (t + B + u))
    have hsum := Matrix.sum_row_of_mem_rowStochastic hleft r
    rw [forwardProduct, hlen, FiniteNetwork.consecutiveProduct_add,
      Matrix.mul_apply]
    calc
      mixingMinorization N = 1 * mixingMinorization N := by ring
      _ = (∑ u, FiniteNetwork.consecutiveProduct N.rowMix (t + B) q r u) *
            mixingMinorization N := by rw [hsum]
      _ = ∑ u, FiniteNetwork.consecutiveProduct N.rowMix (t + B) q r u *
            mixingMinorization N := by rw [Finset.sum_mul]
      _ ≤ ∑ u, FiniteNetwork.consecutiveProduct N.rowMix (t + B) q r u *
            FiniteNetwork.consecutiveProduct N.rowMix t B u j := by
        exact Finset.sum_le_sum fun u _ =>
          mul_le_mul_of_nonneg_left
            (rowMix_block_entry_ge_mixingMinorization N t u j)
            (Matrix.nonneg_of_mem_rowStochastic hleft)
  have hu_nonneg : ∀ r : Fin n, 0 ≤ uniformRow n r := by
    intro r
    simp [uniformRow]
  have hu_sum : ∑ r : Fin n, uniformRow n r = 1 := by
    simp [uniformRow, Nat.ne_of_gt N.hn]
  have heventually : ∀ᶠ s in Filter.atTop,
      mixingMinorization N ≤
        (uniformRow n ᵥ* forwardProduct N.rowMix s t) i := by
    filter_upwards [Filter.eventually_ge_atTop (t + B)] with s hs
    rw [Matrix.vecMul, dotProduct]
    calc
      mixingMinorization N = 1 * mixingMinorization N := by ring
      _ = (∑ r, uniformRow n r) * mixingMinorization N := by rw [hu_sum]
      _ = ∑ r, uniformRow n r * mixingMinorization N := by rw [Finset.sum_mul]
      _ ≤ ∑ r, uniformRow n r * forwardProduct N.rowMix s t r i := by
        exact Finset.sum_le_sum fun r _ =>
          mul_le_mul_of_nonneg_left (hlong s hs r i) (hu_nonneg r)
  have htendsto :
      Filter.Tendsto
        (fun s => (uniformRow n ᵥ* forwardProduct N.rowMix s t) i)
        Filter.atTop (nhds (absoluteProbability N t i)) :=
    (tendsto_pi_nhds.mp (absoluteProbability_tendsto N t)) i
  exact ge_of_tendsto htendsto heventually

/-- Column-stochastic push-mass evolution remains coordinatewise nonnegative. -/
theorem pushMass_nonneg (N : NetworkSetup n) (t : ℕ) (i : Fin n) :
    0 ≤ pushMass N t i := by
  induction t generalizing i with
  | zero => simp
  | succ t ih =>
      rw [pushMass_succ]
      exact Matrix.nonneg_mulVec_of_mem_colStochastic
        (N.col_stochastic t) ih i

/-- The unnormalized push mass keeps its initial total mass `n`. -/
theorem pushMass_sum_eq_n (N : NetworkSetup n) (t : ℕ) :
    ∑ i, pushMass N t i = (n : ℝ) := by
  induction t with
  | zero => simp
  | succ t ih =>
      rw [pushMass_succ,
        Matrix.sum_mulVec_of_mem_colStochastic (N.col_stochastic t), ih]

/-- Pointwise source gain lower bound from absolute-probability minorization
and conserved nonnegative push mass. -/
theorem gain_ge_n_mul_mixingMinorization
    (N : NetworkSetup n) (t : ℕ) :
    (n : ℝ) * mixingMinorization N ≤ gain N t := by
  classical
  unfold gain dotProduct
  calc
    (n : ℝ) * mixingMinorization N =
        ∑ i, mixingMinorization N * pushMass N t i := by
      rw [← Finset.mul_sum, pushMass_sum_eq_n]
      ring
    _ ≤ ∑ i, absoluteProbability N (t + 1) i * pushMass N t i := by
      exact Finset.sum_le_sum fun i _ =>
        mul_le_mul_of_nonneg_right
          (absolute_probability_ge_mixingMinorization N (t + 1) i)
          (pushMass_nonneg N t i)

/-- The source gain is at most the conserved push mass `n`. -/
theorem gain_le_n (N : NetworkSetup n) (t : ℕ) :
    gain N t ≤ (n : ℝ) := by
  classical
  have hpi := absoluteProbability_mem_stdSimplex N (t + 1)
  have hw_le (i : Fin n) : pushMass N t i ≤ (n : ℝ) := by
    calc
      pushMass N t i ≤ ∑ j, pushMass N t j :=
        Finset.single_le_sum (fun j _ => pushMass_nonneg N t j)
          (Finset.mem_univ i)
      _ = (n : ℝ) := pushMass_sum_eq_n N t
  unfold gain dotProduct
  calc
    ∑ i, absoluteProbability N (t + 1) i * pushMass N t i ≤
        ∑ i, absoluteProbability N (t + 1) i * (n : ℝ) := by
      exact Finset.sum_le_sum fun i _ =>
        mul_le_mul_of_nonneg_left (hw_le i) (hpi.1 i)
    _ = (n : ℝ) := by
      rw [← Finset.sum_mul, hpi.2]
      ring

/-- The gain floor retains the uniform pointwise minorization lower bound. -/
theorem gainFloor_ge_n_mul_mixingMinorization (N : NetworkSetup n) :
    (n : ℝ) * mixingMinorization N ≤ gainFloor N := by
  unfold gainFloor
  apply le_csInf (Set.range_nonempty (gain N))
  intro y hy
  rcases hy with ⟨t, rfl⟩
  exact gain_ge_n_mul_mixingMinorization N t

/-- The infimum-defined gain floor lies below every source gain. -/
theorem gainFloor_le_gain (N : NetworkSetup n) (t : ℕ) :
    gainFloor N ≤ gain N t := by
  have hbdd : BddBelow (Set.range (gain N)) := by
    refine ⟨(n : ℝ) * mixingMinorization N, ?_⟩
    intro y hy
    rcases hy with ⟨s, rfl⟩
    exact gain_ge_n_mul_mixingMinorization N s
  unfold gainFloor
  exact csInf_le hbdd ⟨t, rfl⟩

/-- In the one-node source branch the scalar gain is exactly one. -/
theorem gain_eq_one_of_n_eq_one
    (N : NetworkSetup n) (hn1 : n = 1) (t : ℕ) : gain N t = 1 := by
  have hlo := gain_ge_n_mul_mixingMinorization N t
  have hhi := gain_le_n N t
  subst n
  have hlo' : (1 : ℝ) ≤ gain N t := by
    simpa [mixingMinorization] using hlo
  have hhi' : gain N t ≤ (1 : ℝ) := by
    simpa using hhi
  exact le_antisymm hhi' hlo'

/-- The corrected-lift operator is additive on its zero-sum domain. -/
theorem influenceOperator_add
    (N : NetworkSetup n) (t : ℕ)
    (W V : ZeroSumNodeVector n) :
    influenceOperator N t (W + V) =
      influenceOperator N t W + influenceOperator N t V := by
  have hsum : Summable (fun ℓ =>
      FiniteNetwork.periodicCorrectedLiftSeriesTerm
        N.colMix (absoluteProbability N) t ℓ (W + V)) := by
    simpa [influenceSeriesTerm] using influenceSeries_summable N t (W + V)
  have hV : Summable (fun ℓ =>
      FiniteNetwork.periodicCorrectedLiftSeriesTerm
        N.colMix (absoluteProbability N) t ℓ V) := by
    simpa [influenceSeriesTerm] using influenceSeries_summable N t V
  have hsub := FiniteNetwork.periodicCorrectedLift_sub
    N.colMix (absoluteProbability N) t (W + V) V hsum hV
  have hleft :
      (⟨(W + V).1 - V.1, by
        change ∑ i, ((W + V).1 i - V.1 i) = 0
        rw [Finset.sum_sub_distrib, (W + V).2, V.2, sub_self]⟩ :
          ZeroSumNodeVector n) = W := by
    apply Subtype.ext
    simp
  rw [hleft] at hsub
  simpa [influenceOperator] using (eq_add_of_sub_eq hsub.symm)

/-- The corrected-lift operator commutes with real scaling. -/
theorem influenceOperator_smul
    (N : NetworkSetup n) (t : ℕ) (c : ℝ)
    (W : ZeroSumNodeVector n) :
    influenceOperator N t
        ⟨fun j => c * W.1 j, by
          change ∑ j, c * W.1 j = 0
          rw [← Finset.mul_sum, W.2, mul_zero]⟩ =
      c * influenceOperator N t W := by
  simpa [influenceOperator] using
    (FiniteNetwork.periodicCorrectedLift_smul
      (absoluteProbability N)
      (fun s ℓ => FiniteNetwork.consecutiveProduct N.colMix s ℓ)
      t c W)

end Algorithms.Unverified.GeneralPushPull
