  have hpointExpectation (t : ℕ) :
      SOptLib.expectation S.probability (fun omega =>
          ‖correctedDrift S omega alpha t‖ ^ 2) ≤
        3 * (n : ℝ) * S.L ^ 2 *
          SOptLib.expectation S.probability (fun omega =>
            nodeTableNormSq
              (FiniteNetwork.consensusError (primal S omega alpha t))) +
        3 * (n : ℝ) ^ 2 * S.L ^ 2 *
