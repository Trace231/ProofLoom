            2 * alpha ^ 2 * influenceOperatorBound S.network ^ 2 *
              nodeTableNormSq (filteredNoise S omega t) := hleft.trans hle
      simpa [Real.norm_eq_abs, abs_of_nonneg hleft,
        abs_of_nonneg hrightNonneg] using hle
  have hDriftEnergyMeasurable (t : ℕ) : Measurable (fun omega =>
      ‖correctedDrift S omega alpha t‖ ^ 2) :=
    ((((correctedCenter_and_drift_measurable S alpha).2 t).mono
      (preSamplingHistory_le S t) le_rfl).norm.pow_const 2)
  have hDriftEnergyInt (t : ℕ) : Integrable (fun omega =>
      ‖correctedDrift S omega alpha t‖ ^ 2) S.probability := by
    have hright : Integrable (fun omega =>
        3 * (n : ℝ) * S.L ^ 2 * nodeTableNormSq
