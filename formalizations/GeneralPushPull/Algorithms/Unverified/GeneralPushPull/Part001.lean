        3 * (n : ℝ) ^ 2 * S.L ^ 2 *
            ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2 +
        3 * nodeTableNormSq
            (correctedTrackerDisagreement S omega alpha t)) S.probability :=
      (((hconsensusEnergyInt t).const_mul (3 * (n : ℝ) * S.L ^ 2)).add
        ((hOffsetEnergyInt t).const_mul (3 * (n : ℝ) ^ 2 * S.L ^ 2))).add
        ((hcorrectedEnergyInt t).const_mul 3)
    refine Integrable.mono' hright
      (hDriftEnergyMeasurable t).aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall fun omega => by
      have hleft : 0 ≤ ‖correctedDrift S omega alpha t‖ ^ 2 := sq_nonneg _
      have hle := corrected_drift_energy_pointwise S omega alpha t
      have hrightNonneg : 0 ≤
          3 * (n : ℝ) * S.L ^ 2 * nodeTableNormSq
              (FiniteNetwork.consensusError (primal S omega alpha t)) +
          3 * (n : ℝ) ^ 2 * S.L ^ 2 *
              ‖correctedCenter S omega alpha t - arithmeticMean S omega alpha t‖ ^ 2 +
