/-!
Object layer for Lan's two-phase randomized stochastic gradient method.

The stochastic base is the canonical path space of sample histories. RSGD
iterates, oracle values, validation samples, and independent optimization runs
are all derived from that space rather than supplied as theorem-local witness
processes.
-/

abbrev State (n : Nat) := EuclideanSpace Real (Fin n)
abbrev PaperTime := {k : Nat // 1 <= k}
abbrev StepsizeSchedule := PaperTime -> Real
abbrev SamplePath (Sample : Type*) := Nat -> Sample
abbrev OptimizationSamplePath (Sample : Type*) (S : Nat) :=
  Fin S -> SamplePath Sample
abbrev TwoPhaseSamplePath (Sample : Type*) (S : Nat) :=
  OptimizationSamplePath Sample S × SamplePath Sample

variable {n : Nat} {Sample : Type*} [MeasurableSpace Sample]

def sampleCoordinate (j : Nat) : SamplePath Sample -> Sample :=
  fun xi => xi j

theorem sampleCoordinate_measurable (j : Nat) :
    Measurable (sampleCoordinate (Sample := Sample) j) :=
  measurable_pi_apply j

/-- Canonical filtration generated by the finite prefix of the sample history. -/
noncomputable def sampleHistoryFiltration (Sample : Type*) [MeasurableSpace Sample] :
    Filtration Nat (by infer_instance : MeasurableSpace (SamplePath Sample)) :=
  SOptLib.filtration
    (fun j (xi : SamplePath Sample) => xi j)
    (fun j => sampleCoordinate_measurable (Sample := Sample) j)

@[simp]
theorem sampleHistoryFiltration_seq (t : Nat) :
    (sampleHistoryFiltration Sample).seq t =
      ⨆ j < t,
        MeasurableSpace.comap
          (fun xi : SamplePath Sample => xi j)
          (by infer_instance : MeasurableSpace Sample) := by
  exact SOptLib.filtration_seq
    (fun j (xi : SamplePath Sample) => xi j)
    (fun j => sampleCoordinate_measurable (Sample := Sample) j) t

/-- Paper data together with the one-step law for the SFO samples.

The complete sample-history law is derived below as the canonical iid stream
law, matching the paper's use of a generated sample history rather than taking
an arbitrary path measure as primitive data.
-/
structure Setup (n : Nat) (Sample : Type*) [MeasurableSpace Sample] where
  objective : State n -> Real
  initialPoint : State n
  oracle : State n -> Sample -> State n
  oracle_borel : Measurable (fun p : State n × Sample => oracle p.1 p.2)
  sampleMeasure : Measure Sample
  sampleMeasure_isProbability : IsProbabilityMeasure sampleMeasure
  L : Real
  sigma : Real
  dtilde : Real
  L_pos : 0 < L
  sigma_nonneg : 0 <= sigma
  dtilde_pos : 0 < dtilde
  objective_differentiable : Differentiable Real objective
  objective_bounded_below : BddBelow (Set.range objective)
  smooth_gradient :
    forall x y, ‖gradient objective y - gradient objective x‖ <= L * ‖y - x‖

namespace Setup

/-- Canonical iid law of the complete generated sample history. -/
noncomputable def sampleLaw (P : Setup n Sample) : Measure (SamplePath Sample) :=
  SOptLib.iidStreamLaw P.sampleMeasure

theorem sampleLaw_isProbability (P : Setup n Sample) :
    IsProbabilityMeasure P.sampleLaw := by
  dsimp [sampleLaw]
  letI : IsProbabilityMeasure P.sampleMeasure := P.sampleMeasure_isProbability
  infer_instance

theorem sampleLaw_iIndepFun_eval (P : Setup n Sample) :
    iIndepFun (fun t (omega : SamplePath Sample) => omega t) P.sampleLaw := by
  dsimp [sampleLaw]
  letI : IsProbabilityMeasure P.sampleMeasure := P.sampleMeasure_isProbability
  exact SOptLib.iidStreamLaw_iIndepFun_eval P.sampleMeasure

theorem sampleLaw_map_eval (P : Setup n Sample) (t : Nat) :
    Measure.map (fun omega : SamplePath Sample => omega t) P.sampleLaw =
      P.sampleMeasure := by
  dsimp [sampleLaw]
  letI : IsProbabilityMeasure P.sampleMeasure := P.sampleMeasure_isProbability
  exact SOptLib.iidStreamLaw_map_eval P.sampleMeasure t

end Setup

theorem sampleLaw_isProbability (P : Setup n Sample) :
    IsProbabilityMeasure P.sampleLaw :=
  P.sampleLaw_isProbability

/-- The canonical true gradient field of the paper objective. -/
noncomputable def trueGradient (P : Setup n Sample) : State n -> State n :=
  fun x => gradient P.objective x

@[simp]
theorem trueGradient_apply (P : Setup n Sample) (x : State n) :
    trueGradient P x = gradient P.objective x := by
  rfl

/-- The paper's lower objective value `f^* := inf_x f(x)`. -/
noncomputable def fStar (P : Setup n Sample) : Real :=
  sInf (Set.range P.objective)

@[simp]
theorem fStar_def (P : Setup n Sample) :
    fStar P = sInf (Set.range P.objective) := by
  rfl

/-- The source quantity `D_f = sqrt (2 (f(x_1) - f^*) / L)`. -/
noncomputable def objectiveRadius (P : Setup n Sample) : Real :=
  scaledObjectiveGapRadius 2 (P.objective P.initialPoint) (fStar P) P.L

theorem objectiveRadius_def (P : Setup n Sample) :
    objectiveRadius P =
      Real.sqrt (2 * (P.objective P.initialPoint - fStar P) / P.L) := by
  rfl

private theorem fStar_le_objective (P : Setup n Sample) (x : State n) :
    fStar P <= P.objective x := by
  rw [fStar_def]
  exact csInf_le P.objective_bounded_below ⟨x, rfl⟩

private theorem objectiveRadius_sq_eq_scaled_initial_gap (P : Setup n Sample) :
    objectiveRadius P ^ 2 =
      2 * (P.objective P.initialPoint - fStar P) / P.L := by
  exact scaledObjectiveGapRadius_sq_eq
    (scale := 2) (initialValue := P.objective P.initialPoint)
    (optimumValue := fStar P) (L := P.L)
    (by norm_num) (fStar_le_objective P P.initialPoint) (by linarith [P.L_pos])

/-- Fixed-query mean oracle on the canonical sample-history law. -/
noncomputable def meanOracle
    (P : Setup n Sample) (k : PaperTime) (x : State n) : State n :=
  SOptLib.oracleMean P.sampleLaw P.oracle (fun xi => xi k.1) x

theorem meanOracle_def
    (P : Setup n Sample) (k : PaperTime) (x : State n) :
    meanOracle P k x = ∫ xi, P.oracle x (xi k.1) ∂P.sampleLaw := by
  rfl

/-- The primitive stochastic oracle evaluated at a sample-history point. -/
noncomputable def sampledOracleValue
    (P : Setup n Sample) (k : PaperTime) (x : State n) :
    SamplePath Sample -> State n :=
  SOptLib.oracleKernel P.oracle (fun xi => xi k.1) x

@[simp]
theorem sampledOracleValue_apply
    (P : Setup n Sample) (k : PaperTime) (x : State n)
    (xi : SamplePath Sample) :
    sampledOracleValue P k x xi = P.oracle x (xi k.1) := by
  rfl

/-- Assumption 13 residual along a random query process. -/
noncomputable def oracleResidual
    (P : Setup n Sample) (k : PaperTime)
    (x : SamplePath Sample -> State n) :
    SamplePath Sample -> State n :=
  fun xi => P.oracle (x xi) (xi k.1) - trueGradient P (x xi)

@[simp]
theorem oracleResidual_apply
    (P : Setup n Sample) (k : PaperTime)
    (x : SamplePath Sample -> State n) (xi : SamplePath Sample) :
    oracleResidual P k x xi =
      P.oracle (x xi) (xi k.1) - trueGradient P (x xi) := by
  rfl

/-!
Assumption 13 is stated for Borel stochastic-oracle calls and expectations.
The source-facing fixed-call contract therefore records measurability and
integrability before stating the unbiasedness and second-moment formulas.
-/

/-- Fixed-call measurability for the stochastic-gradient random variable in
Assumption 13.
-/
def FixedCallOracleBorel
    (P : Setup n Sample) (k : PaperTime) (x : State n) : Prop :=
  Measurable (fun xi : SamplePath Sample => P.oracle x (xi k.1))

/-- Nonfallback well-definedness of the fixed-call mean in Assumption 13. -/
def FixedCallMeanWellDefined
    (P : Setup n Sample) (k : PaperTime) (x : State n) : Prop :=
  SOptLib.oracleWellDefined P.sampleLaw P.oracle (fun xi => xi k.1) x

/-- The exact centered second-moment integrand printed in Assumption 13(b). -/
noncomputable def fixedCallResidualSq
    (P : Setup n Sample) (k : PaperTime) (x : State n) :
    SamplePath Sample -> Real :=
  fun xi => ‖P.oracle x (xi k.1) - trueGradient P x‖ ^ 2

@[simp]
theorem fixedCallResidualSq_apply
    (P : Setup n Sample) (k : PaperTime) (x : State n)
    (xi : SamplePath Sample) :
    fixedCallResidualSq P k x xi =
      ‖P.oracle x (xi k.1) - trueGradient P x‖ ^ 2 := by
  rfl

/-- Nonfallback well-definedness of the fixed-call second moment in
Assumption 13(b).
-/
def FixedCallSecondMomentWellDefined
    (P : Setup n Sample) (k : PaperTime) (x : State n) : Prop :=
  Integrable (fixedCallResidualSq P k x) P.sampleLaw

/-- Fixed-call regularity required for the expectation formulas in Assumption 13. -/
def FixedCallOracleWellDefined
    (P : Setup n Sample) (k : PaperTime) (x : State n) : Prop :=
  FixedCallOracleBorel P k x /\
    FixedCallMeanWellDefined P k x /\
    FixedCallSecondMomentWellDefined P k x

/-- The fixed-query portion of Assumption 13, used when the SFO point is
deterministic.
-/
def Assumption13FixedCallContract (P : Setup n Sample) : Prop :=
  forall k : PaperTime,
    forall x : State n,
      FixedCallOracleWellDefined P k x /\
      meanOracle P k x = trueGradient P x /\
      (∫ xi, fixedCallResidualSq P k x xi ∂P.sampleLaw) <= P.sigma ^ 2

/-- Assumption 13 at a genuinely random oracle query.

This is the random-query moment component used by the source-facing
`Assumption13` predicate below.  Conditional mean-zero is kept out of
`Assumption13`: Eq. (6.1.18) is a proof bridge relative to a chosen history
filtration, not a separately stated Assumption 13 clause.
-/
def Assumption13At
    (P : Setup n Sample) (k : PaperTime)
    (x : SamplePath Sample -> State n) : Prop :=
    (∫ xi, P.oracle (x xi) (xi k.1) ∂P.sampleLaw =
      ∫ xi, trueGradient P (x xi) ∂P.sampleLaw) /\
    (∫ xi, ‖oracleResidual P k x xi‖ ^ 2 ∂P.sampleLaw) <= P.sigma ^ 2

/-- Well-definedness of a stochastic-oracle call at a random, history-dependent
query point.
-/
def RandomQueryOracleWellDefined
    (P : Setup n Sample) (k : PaperTime)
    (x : SamplePath Sample -> State n) : Prop :=
  Measurable (fun xi : SamplePath Sample => P.oracle (x xi) (xi k.1)) /\
    Integrable (fun xi : SamplePath Sample => P.oracle (x xi) (xi k.1)) P.sampleLaw /\
    Integrable (oracleResidual P k x) P.sampleLaw /\
    Integrable (fun xi => ‖oracleResidual P k x xi‖ ^ 2) P.sampleLaw

/-- Random-query form of Assumption 13: the unbiasedness and second-moment
contract is stated at the random SFO calls used by the algorithm, not only at
fixed deterministic points.
-/
def RandomQueryOracleBridge (P : Setup n Sample) : Prop :=
  SOptLib.RandomQueryUnbiasedVarianceOracle
    P.sampleLaw P.oracle (trueGradient P)
    (fun (k : PaperTime) (xi : SamplePath Sample) => xi k.1) P.sigma

/-- Conditional random-query SFO contract needed for the martingale step in
Eq. (6.1.18).  This is intentionally not a conjunct of `Assumption13`: the
source records the conditional identity in the proof of Theorem 6.1, after
using history measurability, rather than listing it as an assumption.
-/
def ConditionalRandomQueryOracleBridge (P : Setup n Sample) : Prop :=
  forall (k : PaperTime) (x : SamplePath Sample -> State n),
    @Measurable (SamplePath Sample) (State n)
      ((sampleHistoryFiltration Sample).seq k.1) inferInstance x ->
      P.sampleLaw[oracleResidual P k x |
          (sampleHistoryFiltration Sample).seq k.1] =ᵐ[P.sampleLaw]
        (fun _ => (0 : State n))

/-- Source-facing Assumption 13: unbiased stochastic first-order oracle with
second moment bounded by `σ²` at every SFO call time.

The fixed-call conjunct preserves the deterministic-query API, while the
random-query conjunct records the source's `G(x_k, ξ_k)` moment formulas at
algorithm-generated random iterates.  Conditional martingale identities such
as Eq. (6.1.18) remain separate theorem-specific bridge obligations.
-/
def Assumption13 (P : Setup n Sample) : Prop :=
  Assumption13FixedCallContract P /\
    RandomQueryOracleBridge P

theorem Assumption13.fixed_call_contract_all
    (P : Setup n Sample) (hA : Assumption13 P) :
    Assumption13FixedCallContract P :=
  hA.1

theorem Assumption13.random_query_bridge
    (P : Setup n Sample) (hA : Assumption13 P) :
    RandomQueryOracleBridge P :=
  hA.2

theorem Assumption13.fixed_call_wellDefined
    (P : Setup n Sample) (hA : Assumption13 P)
    (k : PaperTime) (x : State n) :
    FixedCallOracleWellDefined P k x :=
  (Assumption13.fixed_call_contract_all P hA k x).1

theorem Assumption13.fixed_call_borel
    (P : Setup n Sample) (hA : Assumption13 P)
    (k : PaperTime) (x : State n) :
    FixedCallOracleBorel P k x :=
  (Assumption13.fixed_call_wellDefined P hA k x).1

theorem Assumption13.mean_wellDefined
    (P : Setup n Sample) (hA : Assumption13 P)
    (k : PaperTime) (x : State n) :
    FixedCallMeanWellDefined P k x :=
  (Assumption13.fixed_call_wellDefined P hA k x).2.1

theorem Assumption13.second_moment_wellDefined
    (P : Setup n Sample) (hA : Assumption13 P)
    (k : PaperTime) (x : State n) :
    FixedCallSecondMomentWellDefined P k x :=
  (Assumption13.fixed_call_wellDefined P hA k x).2.2

theorem Assumption13.second_moment_integrable
    (P : Setup n Sample) (hA : Assumption13 P)
    (k : PaperTime) (x : State n) :
    Integrable (fixedCallResidualSq P k x) P.sampleLaw :=
  Assumption13.second_moment_wellDefined P hA k x

theorem Assumption13.integrable_oracle
    (P : Setup n Sample) (hA : Assumption13 P)
    (k : PaperTime) (x : State n) :
    Integrable (fun xi : SamplePath Sample => P.oracle x (xi k.1)) P.sampleLaw := by
  simpa [FixedCallMeanWellDefined, SOptLib.oracleWellDefined, SOptLib.oracleKernel]
    using Assumption13.mean_wellDefined P hA k x

theorem Assumption13.mean_wellDefined_soptlib
    (P : Setup n Sample) (hA : Assumption13 P)
    (k : PaperTime) (x : State n) :
    SOptLib.oracleWellDefined P.sampleLaw P.oracle (fun xi => xi k.1) x :=
  Assumption13.mean_wellDefined P hA k x

theorem Assumption13.second_moment_bound
    (P : Setup n Sample) (hA : Assumption13 P)
    (k : PaperTime) (x : State n) :
    (∫ xi, fixedCallResidualSq P k x xi ∂P.sampleLaw) <= P.sigma ^ 2 :=
  (Assumption13.fixed_call_contract_all P hA k x).2.2

theorem Assumption13.second_moment_bound_integral
    (P : Setup n Sample) (hA : Assumption13 P)
    (k : PaperTime) (x : State n) :
    (∫ xi, ‖P.oracle x (xi k.1) - trueGradient P x‖ ^ 2 ∂P.sampleLaw) <=
      P.sigma ^ 2 := by
  simpa [fixedCallResidualSq] using
    Assumption13.second_moment_bound P hA k x

theorem Assumption13.fixed_call_contract
    (P : Setup n Sample) (hA : Assumption13 P)
    (k : PaperTime) (x : State n) :
    FixedCallOracleWellDefined P k x /\
      meanOracle P k x = trueGradient P x /\
      (∫ xi, fixedCallResidualSq P k x xi ∂P.sampleLaw) <= P.sigma ^ 2 :=
  Assumption13.fixed_call_contract_all P hA k x

theorem Assumption13.unfold_source_contract
    (P : Setup n Sample) :
    Assumption13 P ↔
      Assumption13FixedCallContract P /\
        RandomQueryOracleBridge P := by
  constructor
  · intro hA
    exact hA
  · intro hA
    exact hA

theorem Assumption13.mean_unbiased
    (P : Setup n Sample) (hA : Assumption13 P)
    (k : PaperTime) (x : State n) :
    meanOracle P k x = trueGradient P x :=
  (Assumption13.fixed_call_contract_all P hA k x).2.1

theorem Assumption13.variance_bound
    (P : Setup n Sample) (hA : Assumption13 P)
    (k : PaperTime) (x : State n) :
    (∫ xi, ‖P.oracle x (xi k.1) - trueGradient P x‖ ^ 2 ∂P.sampleLaw) <=
      P.sigma ^ 2 :=
  Assumption13.second_moment_bound_integral P hA k x

/-- Source-boundary notice for the random-query realization.  The reconstructed
Assumption 13 exposes the random-query moment contract, while conditional
martingale bridges and history/adaptedness proofs for concrete
algorithm-generated query processes remain separate obligations of the process
model.
-/
def RandomQueryOracleBridgeSourceBoundary (P : Setup n Sample) : Prop :=
  Assumption13 P ->
    ["random-query moment bridge is part of the reconstructed Assumption 13 contract",
      "conditional martingale identities remain theorem-specific bridge obligations"] ≠ []

theorem randomQueryOracleBridge_source_boundary
    (P : Setup n Sample) :
    RandomQueryOracleBridgeSourceBoundary P := by
  intro _hA hnil
  cases hnil

theorem Assumption13At_of_randomQueryOracleBridge
    (P : Setup n Sample) (hBridge : RandomQueryOracleBridge P)
    (k : PaperTime) (x : SamplePath Sample -> State n) :
    Assumption13At P k x :=
  (hBridge k x).2

/-!
The printed stepsize and stopping-law formulas are recorded only on their
source-valid domains.  The paper does not define the `σ = 0` or `N = 0`
branch of (6.1.21), so those cases remain source-boundary obligations rather
than fallback values of the paper object.
-/

def ConstantStepsizeFormulaAdmissible
    (P : Setup n Sample) (N : Nat) : Prop :=
  1 <= N /\ 0 < P.sigma

noncomputable def paperStepSizeFormula
    (P : Setup n Sample) (N : Nat) (_k : PaperTime) : Real :=
  SOptLib.min_inv_lipschitz_sqrt_horizon_stepsize P.L P.sigma P.dtilde N

theorem paperStepSizeFormula_eq_printed
    (P : Setup n Sample) (N : Nat) (k : PaperTime)
    (_hDom : ConstantStepsizeFormulaAdmissible P N) :
    paperStepSizeFormula P N k =
      min (1 / P.L) (P.dtilde / (P.sigma * Real.sqrt (N : Real))) := by
  simp [paperStepSizeFormula]

theorem paperStepSizeFormula_denominator_ne_zero
    (P : Setup n Sample) (N : Nat) (_k : PaperTime)
    (hDom : ConstantStepsizeFormulaAdmissible P N) :
    P.sigma * Real.sqrt (N : Real) ≠ 0 := by
  exact SOptLib.min_inv_lipschitz_sqrt_horizon_stepsize_denominator_ne_zero
    P.sigma N hDom.1 hDom.2

def stoppingTime (N : Nat) (r : Fin N) : PaperTime :=
  ⟨r.1 + 1, Nat.succ_le_succ (Nat.zero_le r.1)⟩

@[simp]
theorem stoppingTime_val (N : Nat) (r : Fin N) :
    (stoppingTime N r).1 = r.1 + 1 := by
  rfl

/-!
Theorem 6.1(a) is stated for an arbitrary stepsize schedule satisfying
`γ_k < 2/L` on `k = 1, ..., N`.  The later constant policy (6.1.21) is only a
specialization, so the source-facing one-run theorem uses these raw schedule
objects rather than `paperStepSizeFormula`.
-/

def RSGDStepsizeFeasible
    (P : Setup n Sample) (N : Nat) (gamma : StepsizeSchedule) : Prop :=
  SOptLib.smoothDescentStepsizeFeasibleOn
    (Finset.univ : Finset (Fin N)) P.L
    (fun r => gamma (stoppingTime N r))

noncomputable def rsgdStepWithStepsize
    (P : Setup n Sample) (gamma : StepsizeSchedule)
    (k : Nat) (x : State n) (xi : SamplePath Sample) : State n :=
  SOptLib.sampledOracleDescentStep
    SOptLib.natSuccPositiveTime gamma (sampledOracleValue P) k x xi

noncomputable def rsgdIteratesWithStepsize
    (P : Setup n Sample) (gamma : StepsizeSchedule) :
    Nat -> SamplePath Sample -> State n :=
  SOptLib.recursiveIterateProcess P.initialPoint (rsgdStepWithStepsize P gamma)

@[simp]
theorem rsgdIteratesWithStepsize_zero
    (P : Setup n Sample) (gamma : StepsizeSchedule)
    (xi : SamplePath Sample) :
    rsgdIteratesWithStepsize P gamma 0 xi = P.initialPoint := by
  rfl

@[simp]
theorem rsgdIteratesWithStepsize_succ
    (P : Setup n Sample) (gamma : StepsizeSchedule)
    (k : Nat) (xi : SamplePath Sample) :
    rsgdIteratesWithStepsize P gamma (k + 1) xi =
      rsgdStepWithStepsize P gamma k
        (rsgdIteratesWithStepsize P gamma k xi) xi := by
  rfl

noncomputable def rsgdIterateWithStepsize
    (P : Setup n Sample) (gamma : StepsizeSchedule) (k : PaperTime) :
    SamplePath Sample -> State n :=
  SOptLib.positiveTimeIterateView (rsgdIteratesWithStepsize P gamma) k

/-- Paper statement that `x_k` is a function of the strict sample history before
the fresh oracle call at time `k`, specialized to the arbitrary-stepsize RSGD
process of Theorem 6.1(a).
-/
def RSGDHistoryMeasurabilityWithStepsize
    (P : Setup n Sample) (gamma : StepsizeSchedule) (N : Nat) : Prop :=
  forall r : Fin N,
    @Measurable (SamplePath Sample) (State n)
      ((sampleHistoryFiltration Sample).seq (stoppingTime N r).1)
      inferInstance
      (rsgdIterateWithStepsize P gamma (stoppingTime N r))

/-- The exact residual martingale bridge needed for Eq. (6.1.18) along the
arbitrary-stepsize RSGD process.
-/
def RSGDResidualMartingaleBridgeWithStepsize
    (P : Setup n Sample) (gamma : StepsizeSchedule) (N : Nat) : Prop :=
  forall r : Fin N,
    let k : PaperTime := stoppingTime N r
    ;
      RandomQueryOracleWellDefined P k (rsgdIterateWithStepsize P gamma k) /\
        Assumption13At P k (rsgdIterateWithStepsize P gamma k) /\
        (sampleHistoryFiltration Sample).seq k.1 <=
            (inferInstance : MeasurableSpace (SamplePath Sample)) /\
        P.sampleLaw[
            oracleResidual P k (rsgdIterateWithStepsize P gamma k) |
              (sampleHistoryFiltration Sample).seq k.1] =ᵐ[P.sampleLaw]
          (fun _ => (0 : State n))

theorem RSGDResidualMartingaleBridgeWithStepsize.of_randomQuery_and_conditional
    (P : Setup n Sample) (gamma : StepsizeSchedule) (N : Nat)
    (hRandomAll : RandomQueryOracleBridge P)
    (hConditional : ConditionalRandomQueryOracleBridge P)
    (hHist : RSGDHistoryMeasurabilityWithStepsize P gamma N) :
    RSGDResidualMartingaleBridgeWithStepsize P gamma N := by
  intro r
  let k : PaperTime := stoppingTime N r
  have hRandom :=
    hRandomAll k (rsgdIterateWithStepsize P gamma k)
  have hCond :=
    hConditional k (rsgdIterateWithStepsize P gamma k)
      (by simpa [k] using hHist r)
  exact ⟨hRandom.1, hRandom.2, (sampleHistoryFiltration Sample).le k.1, hCond⟩

/-- The RSGD iterate queried at paper time `k` is measurable with respect to
the sample-history sigma-algebra generated before that query.

This is the Lean form of the source sentence in the proof of Theorem 6.1 that
`x_k` is a function of `ξ_[k-1]`.  It is intentionally a theorem about the
recursive process, not a field of `Setup` and not a theorem-head hypothesis.
-/
theorem RSGDHistoryMeasurabilityWithStepsize.of_recursiveIterates
    (P : Setup n Sample) (gamma : StepsizeSchedule) (N : Nat) :
    RSGDHistoryMeasurabilityWithStepsize P gamma N := by
  intro r
  let k : PaperTime := stoppingTime N r
  let past : Unit -> MeasurableSpace (SamplePath Sample) :=
    fun _ => (sampleHistoryFiltration Sample).seq k.1
  let process := rsgdIteratesWithStepsize P gamma
  let driver : Nat -> SamplePath Sample -> State n :=
    fun j xi => P.oracle (process j xi) (xi (j + 1))
  let step : Nat -> State n -> State n -> State n :=
    fun j x g => x - gamma (SOptLib.natSuccPositiveTime j) • g
  have hproc :
      forall m, m <= k.1 - 1 ->
        Measurable[(sampleHistoryFiltration Sample).seq k.1] (process m) := by
    simpa [past] using
      (SOptLib.recursiveProcess_measurable_wrt_strictPast
        (past := past)
        (process := process)
        (driver := driver)
        (step := step)
        (k := ())
        (N := k.1 - 1)
        (by
          dsimp [process]
          exact measurable_const)
        (by
          intro j hj hprocess
          have hξ :
              Measurable[(sampleHistoryFiltration Sample).seq k.1]
                (fun xi : SamplePath Sample => xi (j + 1)) := by
            exact SOptLib.measurable_sample_of_lt_prefixFiltration
              (fun j (xi : SamplePath Sample) => xi j)
              (fun j => sampleCoordinate_measurable (Sample := Sample) j)
              (by omega : j + 1 < k.1)
          exact P.oracle_borel.comp (hprocess.prodMk hξ))
        (by
          intro j _hj
          dsimp [step]
          measurability)
        (by
          intro j _hj
          funext xi
          simp [process, driver, step, rsgdStepWithStepsize,
            sampledOracleValue, SOptLib.natSuccPositiveTime]))
  simpa [RSGDHistoryMeasurabilityWithStepsize, rsgdIterateWithStepsize, process, k]
    using hproc (k.1 - 1) le_rfl

noncomputable def rsgdRunOutputWithStepsize
    (P : Setup n Sample) (gamma : StepsizeSchedule)
    (N : Nat) (xi : SamplePath Sample) (r : Fin N) : State n :=
  rsgdIterateWithStepsize P gamma (stoppingTime N r) xi

noncomputable def rsgdWeightFromStepsize
    (P : Setup n Sample) (gamma : StepsizeSchedule)
    (N : Nat) (r : Fin N) : Real :=
  SOptLib.smoothDescentOutputWeight P.L (fun r : Fin N => gamma (stoppingTime N r)) r

noncomputable def rsgdWeightDenominatorFromStepsize
    (P : Setup n Sample) (gamma : StepsizeSchedule) (N : Nat) : Real :=
  ∑ r : Fin N, rsgdWeightFromStepsize P gamma N r

def RSGDStoppingLawAdmissible
    (P : Setup n Sample) (N : Nat) (gamma : StepsizeSchedule) : Prop :=
  1 <= N /\
    RSGDStepsizeFeasible P N gamma /\
    (forall r : Fin N, 0 <= rsgdWeightFromStepsize P gamma N r) /\
    0 < rsgdWeightDenominatorFromStepsize P gamma N

abbrev RSGDStepsizeHorizon
    (P : Setup n Sample) (gamma : StepsizeSchedule) :=
  {N : Nat // RSGDStoppingLawAdmissible P N gamma}

noncomputable def rsgdStoppingMassWithStepsize
    (P : Setup n Sample) (gamma : StepsizeSchedule)
    (N : RSGDStepsizeHorizon P gamma) (r : Fin N.1) : Real :=
  rsgdWeightFromStepsize P gamma N.1 r /
    rsgdWeightDenominatorFromStepsize P gamma N.1

theorem rsgdStoppingMassWithStepsize_sum_one
    (P : Setup n Sample) (gamma : StepsizeSchedule)
    (N : RSGDStepsizeHorizon P gamma) :
    ∑ r : Fin N.1, rsgdStoppingMassWithStepsize P gamma N r = 1 := by
  simpa [rsgdStoppingMassWithStepsize, rsgdWeightDenominatorFromStepsize] using
    (SOptLib.normalizedOutputMass_sum_one
      (times := (Finset.univ : Finset (Fin N.1)))
      (weight := rsgdWeightFromStepsize P gamma N.1)
      (denom := rsgdWeightDenominatorFromStepsize P gamma N.1)
      (hdenom := rfl)
      (hdenom_ne := ne_of_gt N.property.2.2.2))

theorem rsgdStoppingMassWithStepsize_nonneg
    (P : Setup n Sample) (gamma : StepsizeSchedule)
    (N : RSGDStepsizeHorizon P gamma) :
    forall r : Fin N.1, 0 <= rsgdStoppingMassWithStepsize P gamma N r := by
  intro r
  exact div_nonneg (N.property.2.2.1 r) (le_of_lt N.property.2.2.2)

noncomputable def rsgdStoppingPMFWithStepsize
    (P : Setup n Sample) (gamma : StepsizeSchedule)
    (N : RSGDStepsizeHorizon P gamma) : PMF (Fin N.1) :=
  PMF.ofFintypeOfReal
    (rsgdStoppingMassWithStepsize P gamma N)
    (fun r => rsgdStoppingMassWithStepsize_nonneg P gamma N r)
    (rsgdStoppingMassWithStepsize_sum_one P gamma N)

noncomputable def rsgdStoppingSampleMeasureWithStepsize
    (P : Setup n Sample) (gamma : StepsizeSchedule)
    (N : RSGDStepsizeHorizon P gamma) :
    Measure (Fin N.1 × SamplePath Sample) :=
  (rsgdStoppingPMFWithStepsize P gamma N).toMeasure.prod P.sampleLaw

noncomputable def stoppingWeightFormula
    (P : Setup n Sample) (N : Nat) (r : Fin N) : Real :=
  2 * paperStepSizeFormula P N (stoppingTime N r) -
    P.L * paperStepSizeFormula P N (stoppingTime N r) ^ 2

noncomputable def stoppingWeightDenominatorFormula
    (P : Setup n Sample) (N : Nat) : Real :=
  ∑ r : Fin N, stoppingWeightFormula P N r

/-- The source-validity domain for the printed RSGD stopping law. -/
def StoppingLawAdmissible
    (P : Setup n Sample) (N : Nat) : Prop :=
  ConstantStepsizeFormulaAdmissible P N /\
    (forall r : Fin N, 0 <= stoppingWeightFormula P N r) /\
    0 < stoppingWeightDenominatorFormula P N

/-- An admissible horizon is a mathematical domain, not a proof argument to a PMF. -/
abbrev RSGDHorizon (P : Setup n Sample) :=
  {N : Nat // StoppingLawAdmissible P N}

theorem stoppingLawAdmissible_of_positive_sigma
    (P : Setup n Sample) (N : Nat)
    (hN : 1 <= N) (hsigma : 0 < P.sigma) :
    StoppingLawAdmissible P N := by
  have hadm :=
    SOptLib.smoothDescentWeightsAdmissible_of_min_inv_lipschitz_sqrt_horizon_stepsize
      N P.L P.sigma P.dtilde hN P.L_pos hsigma P.dtilde_pos
  exact ⟨⟨hN, hsigma⟩,
    (fun r => by
      simpa [stoppingWeightFormula, paperStepSizeFormula, SOptLib.smoothDescentOutputWeight]
        using SOptLib.FiniteWindowWeightsAdmissible.nonneg hadm r
          (by simp : r ∈ (Finset.univ : Finset (Fin N)))),
    by
      simpa [stoppingWeightDenominatorFormula, stoppingWeightFormula,
        paperStepSizeFormula, SOptLib.smoothDescentOutputWeight]
        using SOptLib.FiniteWindowWeightsAdmissible.sum_pos hadm⟩

/-- The paper stepsize on an admissible RSGD horizon. -/
noncomputable def paperStepSize
    (P : Setup n Sample) (N : RSGDHorizon P) (_k : PaperTime) : Real :=
  paperStepSizeFormula P N.1 _k

theorem paperStepSize_def
    (P : Setup n Sample) (N : RSGDHorizon P) (k : PaperTime) :
    paperStepSize P N k = paperStepSizeFormula P N.1 k := by
  rfl

theorem paperStepSize_eq_printed_formula_of_nonzero
    (P : Setup n Sample) (N : RSGDHorizon P) (k : PaperTime) :
    paperStepSize P N k =
      min (1 / P.L) (P.dtilde / (P.sigma * Real.sqrt (N.1 : Real))) := by
  exact paperStepSizeFormula_eq_printed P N.1 k N.property.1

theorem paperStepSize_denominator_ne_zero
    (P : Setup n Sample) (N : RSGDHorizon P) :
    P.sigma * Real.sqrt (N.1 : Real) ≠ 0 := by
  exact paperStepSizeFormula_denominator_ne_zero P N.1 ⟨1, le_rfl⟩
    N.property.1

/-- One canonical RSGD transition using the current path sample. -/
noncomputable def rsgdStep
    (P : Setup n Sample) (N : RSGDHorizon P)
    (k : Nat) (x : State n) (xi : SamplePath Sample) : State n :=
  let t := SOptLib.natSuccPositiveTime k
  x - paperStepSize P N t • sampledOracleValue P t x xi

/-- Canonical zero-based RSGD iterate process generated by the transition. -/
noncomputable def rsgdIterates
    (P : Setup n Sample) (N : RSGDHorizon P) :
    Nat -> SamplePath Sample -> State n :=
  SOptLib.recursiveIterateProcess P.initialPoint (rsgdStep P N)

@[simp]
theorem rsgdIterates_zero
    (P : Setup n Sample) (N : RSGDHorizon P)
    (xi : SamplePath Sample) :
    rsgdIterates P N 0 xi = P.initialPoint := by
  rfl

@[simp]
theorem rsgdIterates_succ
    (P : Setup n Sample) (N : RSGDHorizon P)
    (k : Nat) (xi : SamplePath Sample) :
    rsgdIterates P N (k + 1) xi =
      rsgdStep P N k (rsgdIterates P N k xi) xi := by
  rfl

/-- Positive-time paper view of the generated RSGD iterates. -/
noncomputable def rsgdIterate
    (P : Setup n Sample) (N : RSGDHorizon P) (k : PaperTime) :
    SamplePath Sample -> State n :=
  SOptLib.positiveTimeIterateView (rsgdIterates P N) k

/-- Source Assumption 13 specialized to the random RSGD iterate process. -/
def Assumption13AlongRSGD
    (P : Setup n Sample) (N : RSGDHorizon P) : Prop :=
  forall k : PaperTime, Assumption13At P k (rsgdIterate P N k)

theorem Assumption13AlongRSGD_of_randomQueryOracleBridge
    (P : Setup n Sample) (N : RSGDHorizon P)
    (hBridge : RandomQueryOracleBridge P) :
    Assumption13AlongRSGD P N := by
  intro k
  exact Assumption13At_of_randomQueryOracleBridge P hBridge k
    (rsgdIterate P N k)

/-- The sampled stochastic-gradient process used by RSGD. -/
noncomputable def rsgdOracleProcess
    (P : Setup n Sample) (N : RSGDHorizon P) (k : PaperTime) :
    SamplePath Sample -> State n :=
  fun xi => P.oracle (rsgdIterate P N k xi) (xi k.1)

@[simp]
theorem rsgdOracleProcess_apply
    (P : Setup n Sample) (N : RSGDHorizon P) (k : PaperTime)
    (xi : SamplePath Sample) :
    rsgdOracleProcess P N k xi =
      P.oracle (rsgdIterate P N k xi) (xi k.1) := by
  rfl

theorem rsgdIterate_one
    (P : Setup n Sample) (N : RSGDHorizon P)
    (xi : SamplePath Sample) :
    rsgdIterate P N ⟨1, le_rfl⟩ xi = P.initialPoint := by
  rfl

/-- The generated process realizes Eq. (6.1.10) on the finite source range
`k = 1, ..., N`.
-/
theorem rsgdIterate_update
    (P : Setup n Sample) (N : RSGDHorizon P) (r : Fin N.1) :
    let k : PaperTime := stoppingTime N.1 r
    ;
    rsgdIterate P N
        ⟨k.1 + 1, Nat.succ_le_succ (Nat.zero_le k.1)⟩ =
      fun xi =>
        rsgdIterate P N k xi -
          paperStepSize P N k •
            P.oracle (rsgdIterate P N k xi) (xi k.1) := by
  dsimp
  funext xi
  simp [rsgdIterate, rsgdIterates, rsgdStep, paperStepSize, sampledOracleValue,
    stoppingTime, SOptLib.positiveTimeIterateView, SOptLib.recursiveIterateProcess,
    SOptLib.natSuccPositiveTime]

/-- RSGD output at the source's randomized stopping time. -/
noncomputable def rsgdRunOutput
    (P : Setup n Sample) (N : RSGDHorizon P)
    (xi : SamplePath Sample) (r : Fin N.1) : State n :=
  rsgdIterate P N (stoppingTime N.1 r) xi

theorem rsgdRunOutput_eq_paper_iterate
    (P : Setup n Sample) (N : RSGDHorizon P)
    (xi : SamplePath Sample) (r : Fin N.1) :
    rsgdRunOutput P N xi r =
      rsgdIterate P N (stoppingTime N.1 r) xi := by
  rfl

noncomputable def stoppingWeight
    (P : Setup n Sample) (N : RSGDHorizon P) (r : Fin N.1) : Real :=
  stoppingWeightFormula P N.1 r

noncomputable def stoppingWeightDenominator
    (P : Setup n Sample) (N : RSGDHorizon P) : Real :=
  ∑ r : Fin N.1, stoppingWeight P N r

noncomputable def stoppingMass
    (P : Setup n Sample) (N : RSGDHorizon P) (r : Fin N.1) : Real :=
  stoppingWeight P N r / stoppingWeightDenominator P N

theorem stoppingMass_def
    (P : Setup n Sample) (N : RSGDHorizon P) (r : Fin N.1) :
    stoppingMass P N r =
      stoppingWeight P N r / stoppingWeightDenominator P N := by
  rfl

theorem stoppingMass_sum_one
    (P : Setup n Sample) (N : RSGDHorizon P) :
    ∑ r : Fin N.1, stoppingMass P N r = 1 := by
  simpa [stoppingMass, stoppingWeightDenominator] using
    (SOptLib.normalizedOutputMass_sum_one
      (times := (Finset.univ : Finset (Fin N.1)))
      (weight := stoppingWeight P N)
      (denom := stoppingWeightDenominator P N)
      (hdenom := rfl)
      (hdenom_ne := ne_of_gt N.property.2.2))

theorem stoppingMass_nonneg
    (P : Setup n Sample) (N : RSGDHorizon P) :
    forall r : Fin N.1, 0 <= stoppingMass P N r := by
  intro r
  exact div_nonneg (N.property.2.1 r) (le_of_lt N.property.2.2)

/-- Canonical PMF realizing the paper's randomized stopping rule. -/
noncomputable def rsgdStoppingPMF
    (P : Setup n Sample) (N : RSGDHorizon P) : PMF (Fin N.1) :=
  PMF.ofFintypeOfReal
    (stoppingMass P N)
    (fun r => stoppingMass_nonneg P N r)
    (stoppingMass_sum_one P N)

@[simp]
theorem rsgdStoppingPMF_apply
    (P : Setup n Sample) (N : RSGDHorizon P) (r : Fin N.1) :
    rsgdStoppingPMF P N r =
      ENNReal.ofReal (stoppingMass P N r) := by
  exact PMF.ofFintypeOfReal_apply
    (stoppingMass P N)
    (fun r => stoppingMass_nonneg P N r)
    (stoppingMass_sum_one P N) r

/-- Joint law of the canonical stopping draw and sample-history randomness. -/
noncomputable def rsgdStoppingSampleMeasure
    (P : Setup n Sample) (N : RSGDHorizon P) :
    Measure (Fin N.1 × SamplePath Sample) :=
  (rsgdStoppingPMF P N).toMeasure.prod P.sampleLaw

/-!
The two-phase method uses a finite product of one-run sample-history laws.
This makes independent optimization runs a construction, while validation uses
the separate canonical sample-history coordinate.
-/

noncomputable def optimizationSampleLaw
    (P : Setup n Sample) (S : Nat) :
    Measure (OptimizationSamplePath Sample S) :=
  Measure.pi (fun _ : Fin S => P.sampleLaw)

theorem optimizationSampleLaw_isProbability
    (P : Setup n Sample) (S : Nat) :
    IsProbabilityMeasure (optimizationSampleLaw P S) := by
  letI : ∀ _ : Fin S, IsProbabilityMeasure P.sampleLaw :=
    fun _ => P.sampleLaw_isProbability
  unfold optimizationSampleLaw
  infer_instance


theorem independentOptimizationRuns_spec
    (P : Setup n Sample) (S : Nat) :
    iIndepFun
      (fun s (omega : OptimizationSamplePath Sample S) => omega s)
      (Measure.pi (fun _ : Fin S => P.sampleLaw)) := by
  exact @ProbabilityTheory.iIndepFun_pi
    (Fin S) inferInstance
    (fun _ : Fin S => SamplePath Sample)
    (fun _ : Fin S => inferInstance)
    (fun _ : Fin S => P.sampleLaw)
    (fun _ : Fin S => P.sampleLaw_isProbability)
    (fun _ : Fin S => SamplePath Sample)
    (fun _ : Fin S => inferInstance)
    (fun _ (omega : SamplePath Sample) => omega)
    (fun _ : Fin S => aemeasurable_id)

noncomputable def stoppingVectorMass
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (R : Fin S -> Fin N.1) : Real :=
  SOptLib.stoppingVectorWeight (stoppingMass P N) R

noncomputable def rsgdStoppingVectorPMF
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P) :
    PMF (Fin S -> Fin N.1) :=
  SOptLib.stoppingVectorPMF
    (stoppingMass P N)
    (stoppingVectorMass P S N)
    (by intro R; rfl)
    (fun r => stoppingMass_nonneg P N r)
    (by
      rw [← ENNReal.ofReal_one, ← stoppingMass_sum_one P N]
      exact (ENNReal.ofReal_sum_of_nonneg
        (fun r _ => stoppingMass_nonneg P N r)).symm)

@[simp]
theorem rsgdStoppingVectorPMF_apply
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (R : Fin S -> Fin N.1) :
    rsgdStoppingVectorPMF P S N R =
      ENNReal.ofReal (stoppingVectorMass P S N R) := by
  exact SOptLib.stoppingVectorPMF_apply
    (stoppingMass P N)
    (stoppingVectorMass P S N)
    (by intro R; rfl)
    (fun r => stoppingMass_nonneg P N r)
    (by
      rw [← ENNReal.ofReal_one, ← stoppingMass_sum_one P N]
      exact (ENNReal.ofReal_sum_of_nonneg
        (fun r _ => stoppingMass_nonneg P N r)).symm)
    R

noncomputable def twoPhaseStoppingSampleMeasure
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P) :
    Measure
      ((Fin S -> Fin N.1) ×
        (OptimizationSamplePath Sample S × SamplePath Sample)) :=
  (rsgdStoppingVectorPMF P S N).toMeasure.prod
    ((optimizationSampleLaw P S).prod P.sampleLaw)

/-- One candidate output produced by an optimization run. -/
noncomputable def optimizationCandidate
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (R : Fin S -> Fin N.1) (s : Fin S)
    (omega : OptimizationSamplePath Sample S) : State n :=
  rsgdRunOutput P N (omega s) (R s)

/-- Candidate outputs indexed by the independent run coordinate. -/
noncomputable def optimizationRunOutputs
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (R : Fin S -> Fin N.1)
    (omega : OptimizationSamplePath Sample S) :
    Fin S -> State n :=
  fun s => optimizationCandidate P S N R s omega

/-- Candidate outputs viewed on the stopping/vector/sample product space. -/
noncomputable def optimizationCandidateOnJoint
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (R : Fin S -> Fin N.1) (s : Fin S)
    (q : OptimizationSamplePath Sample S × SamplePath Sample) : State n :=
  optimizationCandidate P S N R s q.1

/-- Post-optimization oracle value on the canonical validation path. -/
noncomputable def validationOracleValue
    (P : Setup n Sample) (xi : SamplePath Sample) (k : Nat)
    (x : State n) : State n :=
  P.oracle x (xi k)

@[simp]
theorem validationOracleValue_apply
    (P : Setup n Sample) (xi : SamplePath Sample) (k : Nat)
    (x : State n) :
    validationOracleValue P xi k x = P.oracle x (xi k) := by
  rfl

/-- Staged validation oracle process used by the empirical average helper. -/
noncomputable def validationOracleProcess
    (P : Setup n Sample) : Nat -> State n -> SamplePath Sample -> State n :=
  fun k x xi => validationOracleValue P xi k x

@[simp]
theorem validationOracleProcess_apply
    (P : Setup n Sample) (k : Nat) (x : State n) (xi : SamplePath Sample) :
    validationOracleProcess P k x xi = P.oracle x (xi k) := by
  rfl

/-- Source-validity domain for the validation average in Eq. (6.1.29). -/
def ValidationCountAdmissible (T : Nat) : Prop :=
  1 <= T

abbrev ValidationCount :=
  {T : Nat // ValidationCountAdmissible T}

/-- Empirical post-optimization gradient in Eq. (6.1.29), defined only on the
source-valid sample-count domain `T >= 1`.
-/
noncomputable def empiricalGradient
    (P : Setup n Sample) (xi : SamplePath Sample)
    (T : ValidationCount) (x : State n) : State n :=
  SOptLib.empiricalOracleAverage
    (validationOracleProcess P) (fun _ i => i) T.1 0 x xi

theorem empiricalGradient_def
    (P : Setup n Sample) (xi : SamplePath Sample)
    (T : ValidationCount) (x : State n) :
    empiricalGradient P xi T x =
      SOptLib.empiricalOracleAverage
        (validationOracleProcess P) (fun _ i => i) T.1 0 x xi := by
  rfl

theorem empiricalGradient_eq_source_formula
    (P : Setup n Sample) (xi : SamplePath Sample)
    (T : ValidationCount) (x : State n) :
    empiricalGradient P xi T x =
      ((T.1 : Real)⁻¹) •
        Finset.sum (Finset.Icc 1 T.1)
          (fun k => validationOracleValue P xi k x) := by
  simp [empiricalGradient, SOptLib.empiricalOracleAverage,
    validationOracleProcess]

noncomputable def candidateEmpiricalGradient
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (R : Fin S -> Fin N.1) (s : Fin S)
    (q : TwoPhaseSamplePath Sample S) : State n :=
  empiricalGradient P q.2 T
    (optimizationCandidate P S N R s q.1)

/-- Squared validation error for one post-optimization candidate. -/
noncomputable def candidateValidationErrorSq
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (R : Fin S -> Fin N.1) (s : Fin S)
    (q : TwoPhaseSamplePath Sample S) : Real :=
  ‖candidateEmpiricalGradient P S N T R s q -
      trueGradient P (optimizationCandidate P S N R s q.1)‖ ^ 2

@[simp]
theorem candidateValidationErrorSq_apply
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (R : Fin S -> Fin N.1) (s : Fin S)
    (q : TwoPhaseSamplePath Sample S) :
    candidateValidationErrorSq P S N T R s q =
      ‖candidateEmpiricalGradient P S N T R s q -
          trueGradient P (optimizationCandidate P S N R s q.1)‖ ^ 2 := by
  rfl

/-- The run selected by the minimum empirical gradient norm. -/
noncomputable def selectedRun
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (hS : 0 < S) (R : Fin S -> Fin N.1)
    (q : TwoPhaseSamplePath Sample S) : Fin S := by
  letI : Nonempty (Fin S) := Fin.pos_iff_nonempty.mp hS
  exact SOptLib.finiteArgmin
    (fun s => ‖candidateEmpiricalGradient P S N T R s q‖)

theorem selectedRun_minimal
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (hS : 0 < S) (R : Fin S -> Fin N.1)
    (q : TwoPhaseSamplePath Sample S) (s : Fin S) :
    ‖candidateEmpiricalGradient P S N T R
        (selectedRun P S N T hS R q) q‖ <=
      ‖candidateEmpiricalGradient P S N T R s q‖ := by
  letI : Nonempty (Fin S) := Fin.pos_iff_nonempty.mp hS
  exact SOptLib.finiteArgmin_spec
    (fun j => ‖candidateEmpiricalGradient P S N T R j q‖) s

/-- The selected candidate `xbar^*` from the two-phase method. -/
noncomputable def selectedCandidate
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (hS : 0 < S) (R : Fin S -> Fin N.1)
    (q : TwoPhaseSamplePath Sample S) : State n :=
  optimizationCandidate P S N R
    (selectedRun P S N T hS R q) q.1

theorem selectedCandidate_def
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (hS : 0 < S) (R : Fin S -> Fin N.1)
    (q : TwoPhaseSamplePath Sample S) :
    selectedCandidate P S N T hS R q =
      optimizationCandidate P S N R
        (selectedRun P S N T hS R q) q.1 := by
  rfl

/-- The selected 2-RSGD output on the complete joint sample space. -/
noncomputable def twoPhaseOutput
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (hS : 0 < S) (R : Fin S -> Fin N.1)
    (q : TwoPhaseSamplePath Sample S) : State n :=
  selectedCandidate P S N T hS R q

theorem twoPhaseOutput_apply
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (hS : 0 < S) (R : Fin S -> Fin N.1)
    (q : TwoPhaseSamplePath Sample S) :
    twoPhaseOutput P S N T hS R q =
      selectedCandidate P S N T hS R q := by
  rfl

noncomputable def twoPhaseOutputOnJoint
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (hS : 0 < S)
    (q : (Fin S -> Fin N.1) × TwoPhaseSamplePath Sample S) : State n :=
  twoPhaseOutput P S N T hS q.1 q.2

theorem twoPhaseOutputOnJoint_apply
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (hS : 0 < S)
    (q : (Fin S -> Fin N.1) × TwoPhaseSamplePath Sample S) :
    twoPhaseOutputOnJoint P S N T hS q =
      selectedCandidate P S N T hS q.1 q.2 := by
  rfl

/-- Number of stochastic first-order oracle calls in the two phases. -/
def oracleCallCount (S N T : Nat) : Nat :=
  S * (N + T)

theorem oracleCallCount_def (S N T : Nat) :
    oracleCallCount S N T = S * (N + T) := by
  rfl

/-- Eq. (6.1.22), the one-run stationarity budget. -/
noncomputable def stationarityBudgetFormula
    (P : Setup n Sample) (N : Nat) : Real :=
  SOptLib.nonconvexStationarityBudgetBound
    P.L (objectiveRadius P) P.dtilde P.sigma N

theorem stationarityBudgetFormula_def
    (P : Setup n Sample) (N : Nat) :
    stationarityBudgetFormula P N =
      P.L * objectiveRadius P ^ 2 / N +
        (P.dtilde + objectiveRadius P ^ 2 / P.dtilde) *
          P.sigma / Real.sqrt N := by
  rfl

noncomputable def stationarityBudget
    (P : Setup n Sample) (N : RSGDHorizon P) : Real :=
  stationarityBudgetFormula P N.1

theorem stationarityBudget_def
    (P : Setup n Sample) (N : RSGDHorizon P) :
    stationarityBudget P N = stationarityBudgetFormula P N.1 := by
  rfl

abbrev Accuracy := {epsilon : Real // 0 < epsilon}
abbrev Confidence := {Lambda : Real // 0 < Lambda /\ Lambda < 1}

/-- Eq. (6.1.32), on its source-stated confidence domain. -/
noncomputable def runCount (Lambda : Confidence) : Nat :=
  SOptLib.runCountChoice Lambda.1

theorem runCount_def (Lambda : Confidence) :
    runCount Lambda = Nat.ceil (Real.log (2 / Lambda.1) / Real.log 2) := by
  rfl

theorem runCount_pos (Lambda : Confidence) : 0 < runCount Lambda := by
  simpa [runCount] using
    SOptLib.runCountChoice_pos Lambda.1 Lambda.2.1 Lambda.2.2

theorem runCount_confidence_tail_bound (Lambda : Confidence) :
    ((2 : Real) ^ runCount Lambda)⁻¹ <= Lambda.1 / 2 := by
  simpa [runCount, SOptLib.runCountChoice] using
    SOptLib.inv_two_pow_natCeil_log_two_div_le_half Lambda.1 Lambda.2.1

/-- Eq. (6.1.33), on its source-stated accuracy domain. -/
noncomputable def iterationCount
    (P : Setup n Sample) (epsilon : Accuracy) : Nat :=
  Nat.ceil
    (max
      (32 * P.L ^ 2 * objectiveRadius P ^ 2 / epsilon.1)
      (32 * P.L *
          (P.dtilde + objectiveRadius P ^ 2 / P.dtilde) *
          P.sigma / epsilon.1) ^ 2)

theorem iterationCount_def
    (P : Setup n Sample) (epsilon : Accuracy) :
    iterationCount P epsilon =
      Nat.ceil
        (max
          (32 * P.L ^ 2 * objectiveRadius P ^ 2 / epsilon.1)
          (32 * P.L *
              (P.dtilde + objectiveRadius P ^ 2 / P.dtilde) *
              P.sigma / epsilon.1) ^ 2) := by
  rfl

/-- Eq. (6.1.34), on its source-stated accuracy and confidence domains. -/
noncomputable def validationCount
    (P : Setup n Sample) (S : Nat)
    (epsilon : Accuracy) (Lambda : Confidence) : Nat :=
  Nat.ceil (24 * (S + 1 : Real) * P.sigma ^ 2 /
    (Lambda.1 * epsilon.1))

theorem validationCount_def
    (P : Setup n Sample) (S : Nat)
    (epsilon : Accuracy) (Lambda : Confidence) :
    validationCount P S epsilon Lambda =
      Nat.ceil (24 * (S + 1 : Real) * P.sigma ^ 2 /
        (Lambda.1 * epsilon.1)) := by
  rfl

/-!
Source theorem inventory.

The declarations in this block expose the paper-facing theorem heads using the
paper's parameters (`Nat` horizons and validation counts) and source
`Assumption13`.  Nonzero/admissible realization facts needed to instantiate the
canonical Lean PMFs are obligations inside named statements or separate
extension theorems; they are not fields of `Setup` and are not assumptions on
the original theorem heads.
-/

/-- Non-vacuous marker for a source theorem whose printed formula is retained
only behind named realization obstructions.

The marker is deliberately not definitionally `True`: source-facing statements
must carry at least one concrete obstruction together with the realized formula
that becomes available once the obstruction is discharged.
-/
def SourceBoundaryObstruction
    (_P : Setup n Sample) (_paperObject : String)
    (obstructions : List String) : Prop :=
  obstructions ≠ []

def SourceBoundaryObstructionBare
    (_paperObject : String) (obstructions : List String) : Prop :=
  obstructions ≠ []

/-- One-run randomized-output squared-gradient observable. -/
noncomputable def rsgdOutputGradientSq
    (P : Setup n Sample) (N : RSGDHorizon P)
    (q : Fin N.1 × SamplePath Sample) : Real :=
  ‖trueGradient P (rsgdRunOutput P N q.2 q.1)‖ ^ 2

/-- Realized one-run output expectation after the printed stopping law has
been shown admissible.
-/
noncomputable def rsgdOutputGradientSqExpectation
    (P : Setup n Sample) (N : RSGDHorizon P) : Real :=
  ∫ q, rsgdOutputGradientSq P N q ∂(rsgdStoppingSampleMeasure P N)

/-- Realized one-run tail probability after the printed stopping law has been
shown admissible.
-/
noncomputable def rsgdOutputGradientTailProbability
    (P : Setup n Sample) (N : RSGDHorizon P) (threshold : Real) : ENNReal :=
  (rsgdStoppingSampleMeasure P N)
    {q | rsgdOutputGradientSq P N q >= threshold}

/-- One-run randomized-output squared-gradient observable for the arbitrary
stepsize schedule in Theorem 6.1(a).
-/
noncomputable def rsgdOutputGradientSqWithStepsize
    (P : Setup n Sample) (gamma : StepsizeSchedule)
    (N : RSGDStepsizeHorizon P gamma)
    (q : Fin N.1 × SamplePath Sample) : Real :=
  ‖trueGradient P (rsgdRunOutputWithStepsize P gamma N.1 q.2 q.1)‖ ^ 2

noncomputable def rsgdOutputGradientSqExpectationWithStepsize
    (P : Setup n Sample) (gamma : StepsizeSchedule)
    (N : RSGDStepsizeHorizon P gamma) : Real :=
  ∫ q, rsgdOutputGradientSqWithStepsize P gamma N q
    ∂(rsgdStoppingSampleMeasureWithStepsize P gamma N)

/-- Conditional one-run stationarity inequality for a fixed raw horizon and
stepsize schedule, after the printed stopping law and the Eq. (6.1.18)
residual martingale bridge are available.

This is the formula-level target retained behind the source obstruction for
Theorem 6.1(a); it is not an added premise of the unqualified source theorem.
-/
def RSGDStationarityConditionalRealizedBoundary
    (P : Setup n Sample) (N : Nat) (gamma : StepsizeSchedule) : Prop :=
  forall hN : RSGDStoppingLawAdmissible P N gamma,
    RSGDResidualMartingaleBridgeWithStepsize P gamma N ->
      (1 / P.L) *
          rsgdOutputGradientSqExpectationWithStepsize P gamma ⟨N, hN⟩ <=
        (objectiveRadius P ^ 2 +
            P.sigma ^ 2 *
              ∑ r : Fin N,
                gamma (stoppingTime N r) ^ 2) /
          rsgdWeightDenominatorFromStepsize P gamma N

/-- Theorem 6.1(a), source-boundary marker over the paper's raw horizon and
arbitrary stepsize schedule.

The source theorem assumes a schedule satisfying `γ_k < 2/L` and uses the PMF
with weights `2γ_k - Lγ_k^2`; it is not the constant policy from (6.1.21).
The unqualified source theorem still records the missing Eq. (6.1.18) bridge
as an obstruction, but the conditional formula-level target is retained as a
separate theorem leaf so Phase 2a can prove the smoothness/telescope argument
without moving the bridge into `Assumption13` or into the theorem head.
-/
def RSGDStationaritySourceBoundary
    (P : Setup n Sample) (N : Nat) (gamma : StepsizeSchedule) : Prop :=
  SourceBoundaryObstruction P "Theorem 6.1(a)"
    ["RSGD history measurability is derived from the recursive process",
      "Eq. (6.1.18) remains conditional on the residual martingale bridge for the history filtration",
      "raw PMF nonnegativity and denominator/admissibility must be derived for the printed law"] /\
    SourceBoundaryObstruction P "Theorem 6.1(a) realized inequality"
      ["the Lean model currently has no source-backed derivation of Eq. (6.1.18) from Assumption 13",
        "the conditional residual martingale bridge is not a stated theorem hypothesis",
        "the printed inequality is retained only as a conditional theorem-level leaf"] /\
    RSGDStationarityConditionalRealizedBoundary P N gamma

def RSGDStationarityBoundStatement (P : Setup n Sample) : Prop :=
  forall (N : Nat), 1 <= N ->
    forall gamma : StepsizeSchedule,
      RSGDStepsizeFeasible P N gamma ->
        RSGDStationaritySourceBoundary P N gamma

def RSGDStationarityBoundRealizedStatement (P : Setup n Sample) : Prop :=
  forall (N : Nat) (gamma : StepsizeSchedule)
    (_hN : RSGDStoppingLawAdmissible P N gamma),
    SourceBoundaryObstruction P "Theorem 6.1(a) realized inequality"
      ["the Lean model currently has no source-backed derivation of Eq. (6.1.18) from Assumption 13",
        "the conditional residual martingale bridge is not a stated theorem hypothesis",
        "asserting the printed inequality here would expose only a conditional theorem, not Theorem 6.1(a)"]

/-- Conditional realization of the one-run stationarity inequality once the
RSGD residual martingale bridge for Eq. (6.1.18) has been supplied or proved
from a stronger oracle/process model.

This is not the source-facing Theorem 6.1(a) boundary.  It keeps the useful
telescope target available without making the missing bridge a public premise
of the paper theorem.
-/
def RSGDStationarityConditionalRealizedStatement
    (P : Setup n Sample) : Prop :=
  forall (N : Nat) (gamma : StepsizeSchedule),
    RSGDStationarityConditionalRealizedBoundary P N gamma

private theorem rsgd_cross_integral_zero_of_bridge
    (P : Setup n Sample) (N : Nat) (gamma : StepsizeSchedule)
    (hBridge : RSGDResidualMartingaleBridgeWithStepsize P gamma N)
    (r : Fin N) :
    ∫ xi,
        ⟪trueGradient P
            (rsgdIterateWithStepsize P gamma (stoppingTime N r) xi),
          oracleResidual P (stoppingTime N r)
            (rsgdIterateWithStepsize P gamma (stoppingTime N r)) xi⟫_ℝ
          ∂P.sampleLaw = 0 := by
  let k : PaperTime := stoppingTime N r
  let x : SamplePath Sample -> State n := rsgdIterateWithStepsize P gamma k
  let δ : SamplePath Sample -> State n := oracleResidual P k x
  let g : SamplePath Sample -> State n := fun xi => trueGradient P (x xi)
  have hHist :
      RSGDHistoryMeasurabilityWithStepsize P gamma N :=
    RSGDHistoryMeasurabilityWithStepsize.of_recursiveIterates P gamma N
  have hx :
      @Measurable (SamplePath Sample) (State n)
        ((sampleHistoryFiltration Sample).seq k.1) inferInstance x := by
    simpa [RSGDHistoryMeasurabilityWithStepsize, x, k] using hHist r
  rcases hBridge r with ⟨hWell, _hAt, hF_le, hCond⟩
  have hgrad_lipschitz :
      LipschitzWith (Real.toNNReal P.L) (trueGradient P) := by
    refine lipschitzWith_of_norm_sub_le_mul (trueGradient P) P.L ?_
    intro a b
    simpa [trueGradient, dist_eq_norm] using P.smooth_gradient b a
  have hgrad_meas : Measurable (trueGradient P) :=
    hgrad_lipschitz.continuous.measurable
  have hg :
      @Measurable (SamplePath Sample) (State n)
        ((sampleHistoryFiltration Sample).seq k.1) inferInstance g := by
    simpa [g] using hgrad_meas.comp hx
  have hδ_int : Integrable δ P.sampleLaw := by
    simpa [δ, x, k] using hWell.2.2.1
  letI : IsProbabilityMeasure P.sampleLaw := P.sampleLaw_isProbability
  letI : IsFiniteMeasure (P.sampleLaw.trim hF_le) :=
    isFiniteMeasure_trim (μ := P.sampleLaw) hF_le
  let target : SamplePath Sample -> Real := fun xi => ⟪g xi, δ xi⟫_ℝ
  change ∫ xi, target xi ∂P.sampleLaw = 0
  by_cases htarget_int : Integrable target P.sampleLaw
  · have hinner_int :
        Integrable (fun xi => ⟪δ xi, g xi - (0 : State n)⟫_ℝ)
          P.sampleLaw := by
      refine htarget_int.congr ?_
      filter_upwards with xi
      simp [target, g, sub_zero, real_inner_comm]
    have hzero :
        ∫ xi, ⟪δ xi, g xi - (0 : State n)⟫_ℝ ∂P.sampleLaw = 0 := by
      exact integral_inner_sub_const_eq_zero_of_condExp_eq_zero
        (P := P.sampleLaw)
        (m := (sampleHistoryFiltration Sample).seq k.1)
        (δ := δ) (x := g) (c := (0 : State n))
        hF_le hg hCond hδ_int hinner_int
    simpa [target, g, sub_zero, real_inner_comm] using hzero
  · have htarget_zero : ∫ xi, target xi ∂P.sampleLaw = 0 := by
      simp [integral_undef, htarget_int]
    exact htarget_zero

private theorem rsgdIterateWithStepsize_update
    (P : Setup n Sample) (gamma : StepsizeSchedule) (N : Nat) (r : Fin N) :
    let k : PaperTime := stoppingTime N r
    ;
    rsgdIterateWithStepsize P gamma
        ⟨k.1 + 1, Nat.succ_le_succ (Nat.zero_le k.1)⟩ =
      fun xi =>
        rsgdIterateWithStepsize P gamma k xi -
          gamma k •
            P.oracle (rsgdIterateWithStepsize P gamma k xi) (xi k.1) := by
  dsimp
  funext xi
  simp [rsgdIterateWithStepsize, rsgdIteratesWithStepsize,
    rsgdStepWithStepsize, sampledOracleValue, stoppingTime,
    SOptLib.positiveTimeIterateView, SOptLib.recursiveIterateProcess,
    SOptLib.natSuccPositiveTime]

private theorem rsgd_residual_variance_bound_of_bridge
    (P : Setup n Sample) (N : Nat) (gamma : StepsizeSchedule)
    (hBridge : RSGDResidualMartingaleBridgeWithStepsize P gamma N)
    (r : Fin N) :
    ∫ xi,
        ‖oracleResidual P (stoppingTime N r)
          (rsgdIterateWithStepsize P gamma (stoppingTime N r)) xi‖ ^ 2
        ∂P.sampleLaw <= P.sigma ^ 2 := by
  rcases hBridge r with ⟨_hWell, hAt, _hF_le, _hCond⟩
  exact hAt.2

private theorem rsgd_raw_iterate_centered_sq_integrable_of_bridge
    (P : Setup n Sample) (N : Nat) (gamma : StepsizeSchedule)
    (hBridge : RSGDResidualMartingaleBridgeWithStepsize P gamma N) :
    forall m : Nat, m < N ->
      Integrable
        (fun xi : SamplePath Sample =>
          ‖rsgdIteratesWithStepsize P gamma m xi - P.initialPoint‖ ^ 2)
        P.sampleLaw := by
  classical
  letI : IsProbabilityMeasure P.sampleLaw := P.sampleLaw_isProbability
  have hHist :
      RSGDHistoryMeasurabilityWithStepsize P gamma N :=
    RSGDHistoryMeasurabilityWithStepsize.of_recursiveIterates P gamma N
  have hprocess_meas :
      forall m : Nat, m < N ->
        Measurable (rsgdIteratesWithStepsize P gamma m) := by
    intro m hm
    let r : Fin N := ⟨m, hm⟩
    let k : PaperTime := stoppingTime N r
    have hx_hist :
        @Measurable (SamplePath Sample) (State n)
          ((sampleHistoryFiltration Sample).seq k.1) inferInstance
          (rsgdIterateWithStepsize P gamma k) := by
      simpa [RSGDHistoryMeasurabilityWithStepsize, k, r] using hHist r
    have hx_meas :
        Measurable (rsgdIterateWithStepsize P gamma k) :=
      hx_hist.of_measurableSpace_le ((sampleHistoryFiltration Sample).le k.1)
    simpa [k, r, rsgdIterateWithStepsize, stoppingTime,
      SOptLib.positiveTimeIterateView] using hx_meas
  have hgrad_lipschitz :
      forall x y : State n,
        ‖trueGradient P y - trueGradient P x‖ <= P.L * ‖y - x‖ := by
    intro x y
    simpa [trueGradient] using P.smooth_gradient x y
  have hgrad_cont : Continuous (trueGradient P) := by
    have hLip : LipschitzWith (Real.toNNReal P.L) (trueGradient P) := by
      refine lipschitzWith_of_norm_sub_le_mul (trueGradient P) P.L ?_
      intro x y
      simpa [dist_eq_norm] using hgrad_lipschitz y x
    exact hLip.continuous
  exact centered_l2_iterates_of_sgd_residual_update
    (base := P.initialPoint)
    (x := rsgdIteratesWithStepsize P gamma)
    (G := fun m xi =>
      P.oracle (rsgdIteratesWithStepsize P gamma m xi) (xi (m + 1)))
    (residual := fun m xi =>
      P.oracle (rsgdIteratesWithStepsize P gamma m xi) (xi (m + 1)) -
        trueGradient P (rsgdIteratesWithStepsize P gamma m xi))
    (grad := trueGradient P)
    (γ := fun m => gamma (SOptLib.natSuccPositiveTime m))
    (N := N)
    (hx_aesm := by
      intro m hm
      exact (hprocess_meas m hm).aestronglyMeasurable)
    (hgrad_aesm := by
      intro m hm
      exact (hgrad_cont.measurable.comp (hprocess_meas m hm)).aestronglyMeasurable)
    (hG_aesm := by
      intro m hm
      let r : Fin N := ⟨m, hm⟩
      rcases hBridge r with ⟨hWell, _hAt, _hF_le, _hCond⟩
      simpa [r, stoppingTime, SOptLib.natSuccPositiveTime,
        rsgdIterateWithStepsize, SOptLib.positiveTimeIterateView] using
        hWell.2.1.aestronglyMeasurable)
    (hresidual_aesm := by
      intro m hm
      let r : Fin N := ⟨m, hm⟩
      rcases hBridge r with ⟨hWell, _hAt, _hF_le, _hCond⟩
      simpa [r, stoppingTime, SOptLib.natSuccPositiveTime,
        rsgdIterateWithStepsize, SOptLib.positiveTimeIterateView,
        oracleResidual] using hWell.2.2.1.aestronglyMeasurable)
    (hgrad_sq := by
      intro m hm hx_center
      have hx_center_rev :
          Integrable
            (fun xi : SamplePath Sample =>
              ‖P.initialPoint - rsgdIteratesWithStepsize P gamma m xi‖ ^ 2)
            P.sampleLaw := by
        refine hx_center.congr ?_
        filter_upwards with xi
        rw [← norm_neg
          (rsgdIteratesWithStepsize P gamma m xi - P.initialPoint)]
        congr 1
        abel
      simpa using
        (SOptLib.integrable_sq_norm_grad_of_lipschitz_grad_centered_l2
          (μ := P.sampleLaw)
          (base := P.initialPoint) (grad := trueGradient P) (L := P.L)
          (z := rsgdIteratesWithStepsize P gamma m)
          (hprocess_meas m hm).aestronglyMeasurable
          hx_center_rev hgrad_lipschitz))
    (hresidual_sq := by
      intro m hm
      let r : Fin N := ⟨m, hm⟩
      rcases hBridge r with ⟨hWell, _hAt, _hF_le, _hCond⟩
      simpa [r, stoppingTime, SOptLib.natSuccPositiveTime,
        rsgdIterateWithStepsize, SOptLib.positiveTimeIterateView,
        oracleResidual] using hWell.2.2.2)
    (hG_eq := by
      intro m hm xi
      dsimp
      abel)
    (hx_zero := by
      simpa using
        (show (rsgdIteratesWithStepsize P gamma 0) =ᵐ[P.sampleLaw]
            fun _ => P.initialPoint from
          Filter.Eventually.of_forall (fun _ => rfl)))
    (hupdate := by
      intro m hm xi
      rw [rsgdIteratesWithStepsize_succ]
      simp [rsgdIteratesWithStepsize, rsgdStepWithStepsize,
        sampledOracleValue, SOptLib.natSuccPositiveTime])

private theorem rsgd_gradient_sq_integrable_of_bridge
    (P : Setup n Sample) (N : Nat) (gamma : StepsizeSchedule)
    (hBridge : RSGDResidualMartingaleBridgeWithStepsize P gamma N) :
    forall r : Fin N,
      Integrable
        (fun xi : SamplePath Sample =>
          ‖trueGradient P
            (rsgdIterateWithStepsize P gamma (stoppingTime N r) xi)‖ ^ 2)
        P.sampleLaw := by
  classical
  letI : IsProbabilityMeasure P.sampleLaw := P.sampleLaw_isProbability
  have hHist :
      RSGDHistoryMeasurabilityWithStepsize P gamma N :=
    RSGDHistoryMeasurabilityWithStepsize.of_recursiveIterates P gamma N
  have hgrad_lipschitz :
      forall x y : State n,
        ‖trueGradient P y - trueGradient P x‖ <= P.L * ‖y - x‖ := by
    intro x y
    simpa [trueGradient] using P.smooth_gradient x y
  intro r
  let x : SamplePath Sample -> State n :=
    rsgdIterateWithStepsize P gamma (stoppingTime N r)
  have hx_hist :
      @Measurable (SamplePath Sample) (State n)
        ((sampleHistoryFiltration Sample).seq (stoppingTime N r).1)
        inferInstance x := by
    simpa [RSGDHistoryMeasurabilityWithStepsize, x] using hHist r
  have hx_meas : Measurable x :=
    hx_hist.of_measurableSpace_le
      ((sampleHistoryFiltration Sample).le (stoppingTime N r).1)
  have hx_center_raw :
      Integrable
        (fun xi : SamplePath Sample =>
          ‖rsgdIteratesWithStepsize P gamma r.1 xi - P.initialPoint‖ ^ 2)
        P.sampleLaw :=
    rsgd_raw_iterate_centered_sq_integrable_of_bridge P N gamma hBridge
      r.1 r.2
  have hx_center : Integrable
      (fun xi : SamplePath Sample => ‖P.initialPoint - x xi‖ ^ 2)
      P.sampleLaw := by
    refine hx_center_raw.congr ?_
    filter_upwards with xi
    simp [x, rsgdIterateWithStepsize, stoppingTime,
      SOptLib.positiveTimeIterateView]
    rw [← norm_neg (rsgdIteratesWithStepsize P gamma r.1 xi - P.initialPoint)]
    congr 1
    abel
  simpa [x] using
    (SOptLib.integrable_sq_norm_grad_of_lipschitz_grad_centered_l2
      (μ := P.sampleLaw)
      (base := P.initialPoint) (grad := trueGradient P) (L := P.L)
      (z := x) hx_meas.aestronglyMeasurable hx_center hgrad_lipschitz)

private theorem rsgd_cross_integrable_of_bridge
    (P : Setup n Sample) (N : Nat) (gamma : StepsizeSchedule)
    (hBridge : RSGDResidualMartingaleBridgeWithStepsize P gamma N) :
    forall r : Fin N,
      Integrable
        (fun xi : SamplePath Sample =>
          ⟪trueGradient P
              (rsgdIterateWithStepsize P gamma (stoppingTime N r) xi),
            oracleResidual P (stoppingTime N r)
              (rsgdIterateWithStepsize P gamma (stoppingTime N r)) xi⟫_ℝ)
        P.sampleLaw := by
  classical
  have hHist :
      RSGDHistoryMeasurabilityWithStepsize P gamma N :=
    RSGDHistoryMeasurabilityWithStepsize.of_recursiveIterates P gamma N
  have hgrad_lipschitz :
      LipschitzWith (Real.toNNReal P.L) (trueGradient P) := by
    refine lipschitzWith_of_norm_sub_le_mul (trueGradient P) P.L ?_
    intro x y
    simpa [trueGradient, dist_eq_norm] using P.smooth_gradient y x
  have hgrad_meas : Measurable (trueGradient P) :=
    hgrad_lipschitz.continuous.measurable
  have hgrad_sq_int :=
    rsgd_gradient_sq_integrable_of_bridge P N gamma hBridge
  intro r
  let k : PaperTime := stoppingTime N r
  let x : SamplePath Sample -> State n := rsgdIterateWithStepsize P gamma k
  let g : SamplePath Sample -> State n := fun xi => trueGradient P (x xi)
  let δ : SamplePath Sample -> State n := oracleResidual P k x
  have hx_hist :
      @Measurable (SamplePath Sample) (State n)
        ((sampleHistoryFiltration Sample).seq k.1) inferInstance x := by
    simpa [RSGDHistoryMeasurabilityWithStepsize, x, k] using hHist r
  have hx_meas : Measurable x :=
    hx_hist.of_measurableSpace_le ((sampleHistoryFiltration Sample).le k.1)
  have hg_aesm : AEStronglyMeasurable g P.sampleLaw :=
    (hgrad_meas.comp hx_meas).aestronglyMeasurable
  rcases hBridge r with ⟨hWell, _hAt, _hF_le, _hCond⟩
  have hδ_aesm : AEStronglyMeasurable δ P.sampleLaw := by
    exact hWell.2.2.1.aestronglyMeasurable
  have hg_sq : Integrable (fun xi : SamplePath Sample => ‖g xi‖ ^ 2)
      P.sampleLaw := by
    simpa [g, x, k] using hgrad_sq_int r
  have hδ_sq : Integrable (fun xi : SamplePath Sample => ‖δ xi‖ ^ 2)
      P.sampleLaw := by
    simpa [δ, x, k] using hWell.2.2.2
  simpa [g, δ, x, k] using
    integrable_inner_of_integrable_sq_norm
      (P := P.sampleLaw) (u := g) (v := δ)
      hg_aesm hδ_aesm hg_sq hδ_sq

private theorem setup_smooth_quadratic_upper_bound
    (P : Setup n Sample) (x y : State n) :
    P.objective y <=
      P.objective x + ⟪trueGradient P x, y - x⟫_ℝ +
        (P.L / 2) * ‖y - x‖ ^ 2 := by
  exact
    smooth_quadratic_upper_bound_of_hasGradientAt_lipschitzOn_convex
      (X := Set.univ) (f := P.objective) (grad := trueGradient P) (L := P.L)
      convex_univ
      (by
        intro z _hz
        simpa [trueGradient] using
          (P.objective_differentiable z).hasGradientAt)
      (by
        intro z _hz w _hw
        simpa [trueGradient] using P.smooth_gradient w z)
      (by simp) (by simp)

private theorem setup_smooth_residual_descent_pointwise
    (P : Setup n Sample) (x δ : State n) (η : Real) :
    P.objective (x - η • (trueGradient P x + δ)) <=
      P.objective x -
        (η - P.L / 2 * η ^ 2) * ‖trueGradient P x‖ ^ 2 -
        (η - P.L * η ^ 2) * ⟪trueGradient P x, δ⟫_ℝ +
        (P.L / 2) * η ^ 2 * ‖δ‖ ^ 2 := by
  exact smooth_descent_of_gradient_step_with_residual
    (f := P.objective) (grad := trueGradient P) (L := P.L)
    (η := η) (x := x) (δ := δ) (by
      simpa using
        setup_smooth_quadratic_upper_bound P x
          (x - η • (trueGradient P x + δ)))

private theorem rsgd_one_step_pointwise_descent
    (P : Setup n Sample) (N : Nat) (gamma : StepsizeSchedule)
    (r : Fin N) (xi : SamplePath Sample) :
    let k : PaperTime := stoppingTime N r
    ;
    let x : State n := rsgdIterateWithStepsize P gamma k xi
    ;
    let δ : State n :=
      oracleResidual P k (rsgdIterateWithStepsize P gamma k) xi
    ;
    P.objective
        (rsgdIterateWithStepsize P gamma
          ⟨k.1 + 1, Nat.succ_le_succ (Nat.zero_le k.1)⟩ xi) <=
      P.objective x -
        (gamma k - P.L / 2 * gamma k ^ 2) *
          ‖trueGradient P x‖ ^ 2 -
        (gamma k - P.L * gamma k ^ 2) *
          ⟪trueGradient P x, δ⟫_ℝ +
        (P.L / 2) * gamma k ^ 2 * ‖δ‖ ^ 2 := by
  dsimp
  let k : PaperTime := stoppingTime N r
  let xproc : SamplePath Sample -> State n := rsgdIterateWithStepsize P gamma k
  let x : State n := xproc xi
  let δ : State n := oracleResidual P k xproc xi
  have hupdate_fun := rsgdIterateWithStepsize_update P gamma N r
  have hupdate :
      rsgdIterateWithStepsize P gamma
          ⟨k.1 + 1, Nat.succ_le_succ (Nat.zero_le k.1)⟩ xi =
        x - gamma k • (trueGradient P x + δ) := by
    have hfun :
        rsgdIterateWithStepsize P gamma
            ⟨k.1 + 1, Nat.succ_le_succ (Nat.zero_le k.1)⟩ =
          fun xi =>
            rsgdIterateWithStepsize P gamma k xi -
              gamma k •
                P.oracle (rsgdIterateWithStepsize P gamma k xi) (xi k.1) := by
      simpa [k] using hupdate_fun
    calc
      rsgdIterateWithStepsize P gamma
          ⟨k.1 + 1, Nat.succ_le_succ (Nat.zero_le k.1)⟩ xi
          = x - gamma k • P.oracle x (xi k.1) := by
            simpa [xproc, x, k] using congrFun hfun xi
      _ = x - gamma k • (trueGradient P x + δ) := by
            have horacle : P.oracle x (xi k.1) = trueGradient P x + δ := by
              simp [δ, x, xproc]
            rw [horacle]
  have hdescent := setup_smooth_residual_descent_pointwise P x δ (gamma k)
  simpa [hupdate, x, δ, xproc, k] using hdescent

private theorem rsgd_weight_div_eq_scaled_descent_coeff
    (P : Setup n Sample) (N : Nat) (gamma : StepsizeSchedule) (r : Fin N) :
    rsgdWeightFromStepsize P gamma N r / P.L =
      (2 / P.L) *
        (gamma (stoppingTime N r) -
          P.L / 2 * gamma (stoppingTime N r) ^ 2) := by
  simp [rsgdWeightFromStepsize]
  ring

private theorem rsgd_one_step_gradient_budget_pointwise
    (P : Setup n Sample) (N : Nat) (gamma : StepsizeSchedule)
    (r : Fin N) (xi : SamplePath Sample) :
    let k : PaperTime := stoppingTime N r
    ;
    let x : State n := rsgdIterateWithStepsize P gamma k xi
    ;
    let xnext : State n :=
      rsgdIterateWithStepsize P gamma
        ⟨k.1 + 1, Nat.succ_le_succ (Nat.zero_le k.1)⟩ xi
    ;
    let δ : State n :=
      oracleResidual P k (rsgdIterateWithStepsize P gamma k) xi
    ;
    (gamma k - P.L / 2 * gamma k ^ 2) *
        ‖trueGradient P x‖ ^ 2 <=
      P.objective x - P.objective xnext -
        (gamma k - P.L * gamma k ^ 2) *
          ⟪trueGradient P x, δ⟫_ℝ +
        (P.L / 2) * gamma k ^ 2 * ‖δ‖ ^ 2 := by
  dsimp
  let k : PaperTime := stoppingTime N r
  let x : State n := rsgdIterateWithStepsize P gamma k xi
  let xnext : State n :=
    rsgdIterateWithStepsize P gamma
      ⟨k.1 + 1, Nat.succ_le_succ (Nat.zero_le k.1)⟩ xi
  let δ : State n :=
    oracleResidual P k (rsgdIterateWithStepsize P gamma k) xi
  have hdesc :
      P.objective xnext <=
        P.objective x -
          (gamma k - P.L / 2 * gamma k ^ 2) *
            ‖trueGradient P x‖ ^ 2 -
          (gamma k - P.L * gamma k ^ 2) *
            ⟪trueGradient P x, δ⟫_ℝ +
          (P.L / 2) * gamma k ^ 2 * ‖δ‖ ^ 2 := by
    simpa [xnext, x, δ, k] using rsgd_one_step_pointwise_descent P N gamma r xi
  nlinarith [hdesc]

private theorem rsgd_pointwise_weighted_budget_telescope
    (P : Setup n Sample) (N : Nat) (gamma : StepsizeSchedule)
    (xi : SamplePath Sample) :
    ∑ r : Fin N,
        (rsgdWeightFromStepsize P gamma N r / P.L) *
          ‖trueGradient P
            (rsgdIterateWithStepsize P gamma (stoppingTime N r) xi)‖ ^ 2 <=
      objectiveRadius P ^ 2 -
        ∑ r : Fin N,
          (2 / P.L) *
            (gamma (stoppingTime N r) -
              P.L * gamma (stoppingTime N r) ^ 2) *
            ⟪trueGradient P
                (rsgdIterateWithStepsize P gamma (stoppingTime N r) xi),
              oracleResidual P (stoppingTime N r)
                (rsgdIterateWithStepsize P gamma (stoppingTime N r)) xi⟫_ℝ +
        ∑ r : Fin N,
          gamma (stoppingTime N r) ^ 2 *
            ‖oracleResidual P (stoppingTime N r)
            (rsgdIterateWithStepsize P gamma (stoppingTime N r)) xi‖ ^ 2 := by
  classical
  let raw : Nat -> State n := fun m => rsgdIteratesWithStepsize P gamma m xi
  let x : Fin N -> State n := fun r =>
    rsgdIterateWithStepsize P gamma (stoppingTime N r) xi
  let xnext : Fin N -> State n := fun r =>
    rsgdIterateWithStepsize P gamma
      ⟨(stoppingTime N r).1 + 1,
        Nat.succ_le_succ (Nat.zero_le (stoppingTime N r).1)⟩ xi
  let grad : Fin N -> State n := fun r => trueGradient P (x r)
  let residual : Fin N -> State n := fun r =>
    oracleResidual P (stoppingTime N r)
      (rsgdIterateWithStepsize P gamma (stoppingTime N r)) xi
  let scale : Real := 2 / P.L
  let coefficient : Fin N -> Real := fun r =>
    gamma (stoppingTime N r) -
      P.L / 2 * gamma (stoppingTime N r) ^ 2
  let variance : Fin N -> Real := fun r =>
    gamma (stoppingTime N r) ^ 2
  let correction : Fin N -> Real := fun r =>
    scale *
      (gamma (stoppingTime N r) -
        P.L * gamma (stoppingTime N r) ^ 2)
  let terminal : Real :=
    (2 / P.L) * (P.objective (raw N) - fStar P)
  have hscale_nonneg : 0 <= 2 / P.L := by
    exact div_nonneg (by norm_num) (le_of_lt P.L_pos)
  have hweight :
      ∀ r : Fin N, r ∈ (Finset.univ : Finset (Fin N)) ->
        rsgdWeightFromStepsize P gamma N r / P.L =
          scale * coefficient r := by
    intro r _hr
    simpa [scale, coefficient] using
      rsgd_weight_div_eq_scaled_descent_coeff P N gamma r
  have hstep :
      ∀ r : Fin N, r ∈ (Finset.univ : Finset (Fin N)) ->
        scale * (coefficient r * ‖grad r‖ ^ 2) <=
          scale * (P.objective (x r) - P.objective (xnext r)) +
            gamma (stoppingTime N r) ^ 2 * ‖residual r‖ ^ 2 -
            correction r * ⟪grad r, residual r⟫_ℝ := by
    intro r _hr
    let k : PaperTime := stoppingTime N r
    let xx : State n := rsgdIterateWithStepsize P gamma k xi
    let xxnext : State n :=
      rsgdIterateWithStepsize P gamma
        ⟨k.1 + 1, Nat.succ_le_succ (Nat.zero_le k.1)⟩ xi
    let δ : State n := oracleResidual P k (rsgdIterateWithStepsize P gamma k) xi
    have hone :=
      rsgd_one_step_gradient_budget_pointwise P N gamma r xi
    have hmul :
        scale *
            ((gamma k - P.L / 2 * gamma k ^ 2) *
              ‖trueGradient P xx‖ ^ 2) <=
          scale *
            (P.objective xx - P.objective xxnext -
              (gamma k - P.L * gamma k ^ 2) *
                ⟪trueGradient P xx, δ⟫_ℝ +
              (P.L / 2) * gamma k ^ 2 * ‖δ‖ ^ 2) :=
      mul_le_mul_of_nonneg_left (by simpa [xx, xxnext, δ, k] using hone)
        hscale_nonneg
    calc
      scale * (coefficient r * ‖grad r‖ ^ 2) =
          scale *
            ((gamma k - P.L / 2 * gamma k ^ 2) *
              ‖trueGradient P xx‖ ^ 2) := by
            simp [scale, coefficient, grad, x, k, xx]
      _ <=
          scale *
            (P.objective xx - P.objective xxnext -
              (gamma k - P.L * gamma k ^ 2) *
                ⟪trueGradient P xx, δ⟫_ℝ +
              (P.L / 2) * gamma k ^ 2 * ‖δ‖ ^ 2) := hmul
      _ = scale * (P.objective (x r) - P.objective (xnext r)) +
            gamma (stoppingTime N r) ^ 2 * ‖residual r‖ ^ 2 -
            correction r * ⟪grad r, residual r⟫_ℝ := by
            simp [scale, variance, correction, grad, residual, x, xnext,
              xx, xxnext, δ, k]
            field_simp [ne_of_gt P.L_pos]
            ring
  have htelescope :
      ∑ r : Fin N, scale * (P.objective (x r) - P.objective (xnext r)) =
        objectiveRadius P ^ 2 - terminal := by
    have hdesc_eq :
        ∑ r : Fin N, scale * (P.objective (x r) - P.objective (xnext r)) =
          scale *
            (P.objective (raw 0) - P.objective (raw N)) := by
      calc
        (∑ r : Fin N, scale * (P.objective (x r) - P.objective (xnext r)))
            =
              ∑ r : Fin N, scale *
                (P.objective (raw r.1) - P.objective (raw (r.1 + 1))) := by
              apply Finset.sum_congr rfl
              intro r _hr
              simp [scale, x, xnext, raw, rsgdIterateWithStepsize,
                stoppingTime, SOptLib.positiveTimeIterateView]
        _ =
              scale * ∑ r : Fin N,
                (P.objective (raw r.1) - P.objective (raw (r.1 + 1))) := by
                rw [Finset.mul_sum]
        _ =
              scale *
                (P.objective (raw 0) - P.objective (raw N)) := by
                congr 1
                exact sum_fin_adjacent_sub_eq_sub N (fun m => P.objective (raw m))
    calc
      (∑ r : Fin N, scale * (P.objective (x r) - P.objective (xnext r)))
          = scale *
              (P.objective (raw 0) - P.objective (raw N)) := hdesc_eq
      _ = objectiveRadius P ^ 2 - terminal := by
          rw [objectiveRadius_sq_eq_scaled_initial_gap]
          simp [scale, terminal, raw]
          field_simp [ne_of_gt P.L_pos]
          ring
  have hterminal_nonneg : 0 <= terminal := by
    have hgap_nonneg : 0 <= P.objective (raw N) - fStar P := by
      exact sub_nonneg.mpr (fStar_le_objective P (raw N))
    exact mul_nonneg hscale_nonneg hgap_nonneg
  have hsum :=
    weighted_gradient_budget_telescope_of_one_step_descent
      (s := (Finset.univ : Finset (Fin N))) (f := P.objective)
      (x := x) (xnext := xnext) (grad := grad) (residual := residual)
      (scale := scale)
      (weight := fun r => rsgdWeightFromStepsize P gamma N r / P.L)
      (coefficient := coefficient) (variance := variance)
      (correction := correction) (initial := objectiveRadius P ^ 2)
      (lower := 0) (terminal := terminal) hweight hstep htelescope
      hterminal_nonneg
  simpa [scale, variance, correction, grad, residual, x, xnext,
    add_comm, add_left_comm, add_assoc, sub_eq_add_neg] using hsum

private theorem rsgd_expected_weighted_gradient_sum_bound_of_bridge
    (P : Setup n Sample) (N : Nat) (gamma : StepsizeSchedule)
    (hN : RSGDStoppingLawAdmissible P N gamma)
    (hBridge : RSGDResidualMartingaleBridgeWithStepsize P gamma N)
    (hcross :
      forall r : Fin N,
        ∫ xi,
            ⟪trueGradient P
                (rsgdIterateWithStepsize P gamma (stoppingTime N r) xi),
              oracleResidual P (stoppingTime N r)
                (rsgdIterateWithStepsize P gamma (stoppingTime N r)) xi⟫_ℝ
              ∂P.sampleLaw = 0) :
    ∑ r : Fin N,
        ((rsgdWeightFromStepsize P gamma N r) / P.L) *
          ∫ xi,
            ‖trueGradient P
              (rsgdIterateWithStepsize P gamma (stoppingTime N r) xi)‖ ^ 2
              ∂P.sampleLaw <=
      objectiveRadius P ^ 2 +
        P.sigma ^ 2 * ∑ r : Fin N, gamma (stoppingTime N r) ^ 2 := by
  classical
  letI : IsProbabilityMeasure P.sampleLaw := P.sampleLaw_isProbability
  let gradSq : Fin N -> SamplePath Sample -> Real := fun r xi =>
    ‖trueGradient P
      (rsgdIterateWithStepsize P gamma (stoppingTime N r) xi)‖ ^ 2
  let crossTerm : Fin N -> SamplePath Sample -> Real := fun r xi =>
    ⟪trueGradient P
        (rsgdIterateWithStepsize P gamma (stoppingTime N r) xi),
      oracleResidual P (stoppingTime N r)
        (rsgdIterateWithStepsize P gamma (stoppingTime N r)) xi⟫_ℝ
  let deltaSq : Fin N -> SamplePath Sample -> Real := fun r xi =>
    ‖oracleResidual P (stoppingTime N r)
      (rsgdIterateWithStepsize P gamma (stoppingTime N r)) xi‖ ^ 2
  let A : Fin N -> SamplePath Sample -> Real := fun r xi =>
    (rsgdWeightFromStepsize P gamma N r / P.L) * gradSq r xi
  let crossCoeff : Fin N -> Real := fun r =>
    -((2 / P.L) *
      (gamma (stoppingTime N r) -
        P.L * gamma (stoppingTime N r) ^ 2))
  let stepSq : Fin N -> Real := fun r =>
    gamma (stoppingTime N r) ^ 2
  have hgrad_int :
      forall r : Fin N, Integrable (gradSq r) P.sampleLaw := by
    intro r
    simpa [gradSq] using
      rsgd_gradient_sq_integrable_of_bridge P N gamma hBridge r
  have hcross_int :
      forall r : Fin N, Integrable (crossTerm r) P.sampleLaw := by
    intro r
    simpa [crossTerm] using
      rsgd_cross_integrable_of_bridge P N gamma hBridge r
  have hdelta_int :
      forall r : Fin N, Integrable (deltaSq r) P.sampleLaw := by
    intro r
    rcases hBridge r with ⟨hWell, _hAt, _hF_le, _hCond⟩
    simpa [deltaSq] using hWell.2.2.2
  have hA_int :
      forall r : Fin N, r ∈ (Finset.univ : Finset (Fin N)) ->
        Integrable (A r) P.sampleLaw := by
    intro r _hr
    simpa [A] using
      (hgrad_int r).const_mul
        (rsgdWeightFromStepsize P gamma N r / P.L)
  have hpoint :
      ∀ᵐ xi ∂P.sampleLaw,
        Finset.sum (Finset.univ : Finset (Fin N)) (fun r => A r xi) ≤
          objectiveRadius P ^ 2 +
            Finset.sum (Finset.univ : Finset (Fin N))
              (fun r => crossCoeff r * crossTerm r xi +
                stepSq r * deltaSq r xi) := by
    refine Filter.Eventually.of_forall ?_
    intro xi
    have hp := rsgd_pointwise_weighted_budget_telescope P N gamma xi
    simpa [A, crossCoeff, stepSq, gradSq, crossTerm, deltaSq,
      Finset.sum_add_distrib, Finset.sum_neg_distrib, sub_eq_add_neg,
      neg_mul, add_comm, add_left_comm, add_assoc] using hp
  have hcross_zero :
      ∀ r : Fin N, r ∈ (Finset.univ : Finset (Fin N)) ->
        ∫ xi, crossTerm r xi ∂P.sampleLaw = 0 := by
    intro r _hr
    exact hcross r
  have hdelta_bound :
      ∀ r : Fin N, r ∈ (Finset.univ : Finset (Fin N)) ->
        ∫ xi, deltaSq r xi ∂P.sampleLaw ≤ P.sigma ^ 2 := by
    intro r _hr
    simpa [deltaSq] using
      rsgd_residual_variance_bound_of_bridge P N gamma hBridge r
  have hstepSq_nonneg :
      ∀ r : Fin N, r ∈ (Finset.univ : Finset (Fin N)) -> 0 ≤ stepSq r := by
    intro r _hr
    exact sq_nonneg _
  have hbound :=
    expected_weighted_gradient_sum_bound_of_pathwise_budget
      (μ := P.sampleLaw) (s := (Finset.univ : Finset (Fin N)))
      (A := A) (cross := crossTerm) (deltaSq := deltaSq)
      (crossCoeff := crossCoeff) (stepSq := stepSq)
      (initial := objectiveRadius P ^ 2) (sigma2 := P.sigma ^ 2)
      hA_int (by
        intro r _hr
        exact hcross_int r) (by
        intro r _hr
        exact hdelta_int r) hpoint hcross_zero hdelta_bound hstepSq_nonneg
  have hleft :
      ∑ r : Fin N,
          (rsgdWeightFromStepsize P gamma N r / P.L) *
            ∫ xi, gradSq r xi ∂P.sampleLaw =
        Finset.sum (Finset.univ : Finset (Fin N))
          (fun r => ∫ xi, A r xi ∂P.sampleLaw) := by
    apply Finset.sum_congr rfl
    intro r _hr
    simp only [A]
    rw [integral_const_mul]
  calc
    ∑ r : Fin N,
        (rsgdWeightFromStepsize P gamma N r / P.L) *
          ∫ xi, gradSq r xi ∂P.sampleLaw = _ := hleft
    _ ≤ objectiveRadius P ^ 2 + P.sigma ^ 2 * Finset.sum
        (Finset.univ : Finset (Fin N)) stepSq := hbound
    _ = objectiveRadius P ^ 2 +
        P.sigma ^ 2 * ∑ r : Fin N, gamma (stoppingTime N r) ^ 2 := by
          simp [stepSq]

theorem RSGD_stationarity_conditional_realized_bound
    (P : Setup n Sample) :
    RSGDStationarityConditionalRealizedStatement P := by
  intro N gamma hN hBridge
  have hcross :
      forall r : Fin N,
        ∫ xi,
            ⟪trueGradient P
                (rsgdIterateWithStepsize P gamma (stoppingTime N r) xi),
              oracleResidual P (stoppingTime N r)
                (rsgdIterateWithStepsize P gamma (stoppingTime N r)) xi⟫_ℝ
              ∂P.sampleLaw = 0 := by
    intro r
    exact rsgd_cross_integral_zero_of_bridge P N gamma hBridge r
  classical
  letI : IsProbabilityMeasure P.sampleLaw := P.sampleLaw_isProbability
  let Nh : RSGDStepsizeHorizon P gamma := ⟨N, hN⟩
  let F : Fin Nh.1 → SamplePath Sample → ℝ :=
    fun r xi =>
      ‖trueGradient P
        (rsgdIterateWithStepsize P gamma (stoppingTime Nh.1 r) xi)‖ ^ 2
  let denom : ℝ := rsgdWeightDenominatorFromStepsize P gamma Nh.1
  let w : Fin Nh.1 → ℝ := rsgdWeightFromStepsize P gamma Nh.1
  let A : Fin Nh.1 → ℝ := fun r => ∫ xi, F r xi ∂P.sampleLaw
  have hsum :=
    rsgd_expected_weighted_gradient_sum_bound_of_bridge
      P N gamma hN hBridge hcross
  by_cases hprod_int :
      Integrable (fun q : Fin Nh.1 × SamplePath Sample => F q.1 q.2)
        (rsgdStoppingSampleMeasureWithStepsize P gamma Nh)
  · have hmass : ∀ r : Fin Nh.1,
        ((rsgdStoppingPMFWithStepsize P gamma Nh).toMeasure).real
            ({r} : Set (Fin Nh.1)) =
          rsgdStoppingMassWithStepsize P gamma Nh r := by
      intro r
      simpa [rsgdStoppingPMFWithStepsize] using
        (SOptLib.ofFintypeOfReal_toMeasure_real_singleton
          (mass := rsgdStoppingMassWithStepsize P gamma Nh)
          (hmass_nonneg :=
            fun r => rsgdStoppingMassWithStepsize_nonneg P gamma Nh r)
          (hmass_sum := rsgdStoppingMassWithStepsize_sum_one P gamma Nh)
          r)
    have hprod_eq :
        rsgdOutputGradientSqExpectationWithStepsize P gamma Nh =
          ∑ r : Fin Nh.1, rsgdStoppingMassWithStepsize P gamma Nh r * A r := by
      have hraw :=
        integral_finite_selector_first_prod_eq_sum_of_integrable
          (ν := (rsgdStoppingPMFWithStepsize P gamma Nh).toMeasure)
          (μ := P.sampleLaw) (F := F) hprod_int
      calc
        rsgdOutputGradientSqExpectationWithStepsize P gamma Nh
            =
              ∫ q : Fin Nh.1 × SamplePath Sample, F q.1 q.2
                ∂(rsgdStoppingSampleMeasureWithStepsize P gamma Nh) := by
                simp [rsgdOutputGradientSqExpectationWithStepsize,
                  rsgdOutputGradientSqWithStepsize, rsgdRunOutputWithStepsize, F]
        _ = ∑ r : Fin Nh.1,
              ((rsgdStoppingPMFWithStepsize P gamma Nh).toMeasure).real
                  ({r} : Set (Fin Nh.1)) * A r := by
                simpa [rsgdStoppingSampleMeasureWithStepsize, A] using hraw
        _ = ∑ r : Fin Nh.1,
              rsgdStoppingMassWithStepsize P gamma Nh r * A r := by
                exact Finset.sum_congr rfl (by intro r _hr; rw [hmass r])
    have hexp :
        rsgdOutputGradientSqExpectationWithStepsize P gamma Nh =
          denom⁻¹ * ∑ r : Fin Nh.1, w r * A r := by
      calc
        rsgdOutputGradientSqExpectationWithStepsize P gamma Nh
            = ∑ r : Fin Nh.1, (w r / denom) * A r := by
                simpa [w, denom, rsgdStoppingMassWithStepsize] using hprod_eq
        _ = denom⁻¹ * ∑ r : Fin Nh.1, w r * A r := by
                simp [div_eq_mul_inv, Finset.mul_sum, mul_assoc, mul_comm]
    have hsumA : ∑ r : Fin Nh.1, (w r / P.L) * A r <=
        objectiveRadius P ^ 2 +
          P.sigma ^ 2 * ∑ r : Fin Nh.1, gamma (stoppingTime Nh.1 r) ^ 2 := by
      simpa [Nh, w, A, F] using hsum
    have hrewrite :
        (1 / P.L) * (denom⁻¹ * ∑ r : Fin Nh.1, w r * A r) =
          denom⁻¹ * ∑ r : Fin Nh.1, (w r / P.L) * A r := by
      calc
        (1 / P.L) * (denom⁻¹ * ∑ r : Fin Nh.1, w r * A r)
            = denom⁻¹ * ((1 / P.L) * ∑ r : Fin Nh.1, w r * A r) := by
                ring
        _ = denom⁻¹ * ∑ r : Fin Nh.1, (w r / P.L) * A r := by
          congr 1
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro i _hi
          ring
    have hgoal :
        (1 / P.L) * rsgdOutputGradientSqExpectationWithStepsize P gamma Nh <=
          (objectiveRadius P ^ 2 +
              P.sigma ^ 2 * ∑ r : Fin Nh.1, gamma (stoppingTime Nh.1 r) ^ 2) /
            rsgdWeightDenominatorFromStepsize P gamma Nh.1 := by
      rw [hexp]
      calc
        (1 / P.L) * (denom⁻¹ * ∑ r : Fin Nh.1, w r * A r)
            = denom⁻¹ * ∑ r : Fin Nh.1, (w r / P.L) * A r := hrewrite
        _ <=
            denom⁻¹ *
              (objectiveRadius P ^ 2 +
                P.sigma ^ 2 * ∑ r : Fin Nh.1, gamma (stoppingTime Nh.1 r) ^ 2) :=
            mul_le_mul_of_nonneg_left hsumA
              (inv_nonneg.mpr (le_of_lt Nh.property.2.2.2))
        _ =
            (objectiveRadius P ^ 2 +
                P.sigma ^ 2 * ∑ r : Fin Nh.1, gamma (stoppingTime Nh.1 r) ^ 2) /
              rsgdWeightDenominatorFromStepsize P gamma Nh.1 := by
            simp [denom, div_eq_mul_inv, mul_comm]
    simpa [Nh] using hgoal
  · have hout_zero : rsgdOutputGradientSqExpectationWithStepsize P gamma Nh = 0 := by
      have hzero := integral_undef
        (μ := rsgdStoppingSampleMeasureWithStepsize P gamma Nh)
        (f := fun q : Fin Nh.1 × SamplePath Sample => F q.1 q.2)
        hprod_int
      simpa [rsgdOutputGradientSqExpectationWithStepsize,
        rsgdOutputGradientSqWithStepsize, rsgdRunOutputWithStepsize, F] using hzero
    have hgoal :
        (1 / P.L) * rsgdOutputGradientSqExpectationWithStepsize P gamma Nh <=
          (objectiveRadius P ^ 2 +
              P.sigma ^ 2 * ∑ r : Fin Nh.1, gamma (stoppingTime Nh.1 r) ^ 2) /
            rsgdWeightDenominatorFromStepsize P gamma Nh.1 := by
      rw [hout_zero]
      have hsum_sq_nonneg :
          0 <= ∑ r : Fin Nh.1, gamma (stoppingTime Nh.1 r) ^ 2 := by
        exact Finset.sum_nonneg
          (by intro r _hr; exact sq_nonneg (gamma (stoppingTime Nh.1 r)))
      have hnum_nonneg :
          0 <= objectiveRadius P ^ 2 +
            P.sigma ^ 2 * ∑ r : Fin Nh.1, gamma (stoppingTime Nh.1 r) ^ 2 := by
        have hsigma_sq : 0 <= P.sigma ^ 2 := sq_nonneg P.sigma
        have hprod_nonneg :
            0 <= P.sigma ^ 2 *
              ∑ r : Fin Nh.1, gamma (stoppingTime Nh.1 r) ^ 2 :=
          mul_nonneg hsigma_sq hsum_sq_nonneg
        nlinarith [sq_nonneg (objectiveRadius P), hprod_nonneg]
      have hden_nonneg :
          0 <= rsgdWeightDenominatorFromStepsize P gamma Nh.1 :=
        le_of_lt Nh.property.2.2.2
      have hrhs_nonneg :
          0 <=
            (objectiveRadius P ^ 2 +
                P.sigma ^ 2 * ∑ r : Fin Nh.1, gamma (stoppingTime Nh.1 r) ^ 2) /
              rsgdWeightDenominatorFromStepsize P gamma Nh.1 :=
        div_nonneg hnum_nonneg hden_nonneg
      simpa using hrhs_nonneg
    simpa [Nh] using hgoal

theorem RSGD_stationarity_bound
    (P : Setup n Sample) (hA : Assumption13 P) :
    RSGDStationarityBoundStatement P := by
  have _hRandom : RandomQueryOracleBridge P :=
    Assumption13.random_query_bridge P hA
  intro N _hN gamma _hgamma
  unfold RSGDStationaritySourceBoundary
  constructor
  · simp [SourceBoundaryObstruction]
  · constructor
    · simp [SourceBoundaryObstruction]
    · exact (RSGD_stationarity_conditional_realized_bound P) N gamma

/-- Corollary 6.1 / Eq. (6.1.22), the source-facing expected-stationarity
inequality for the constant stepsize policy.
-/
def ConstantStepsizeSourceBoundary
    (P : Setup n Sample) (N : Nat) : Prop :=
  SourceBoundaryObstruction P "Corollary 6.1 / Eq. (6.1.22)"
    ["constant stepsize formula divides by sigma",
      "printed stopping law requires positive normalization denominator",
      "the realized inequality is conditional on the Eq. (6.1.18) residual martingale bridge"] /\
    (ConditionalRandomQueryOracleBridge P ->
      forall hN : StoppingLawAdmissible P N,
        (1 / P.L) * rsgdOutputGradientSqExpectation P ⟨N, hN⟩ <=
          stationarityBudgetFormula P N)

def ConstantStepsizeBoundStatement (P : Setup n Sample) : Prop :=
  forall (N : Nat), 1 <= N ->
    ConstantStepsizeSourceBoundary P N

def ConstantStepsizeBoundRealizedStatement (P : Setup n Sample) : Prop :=
  ConditionalRandomQueryOracleBridge P ->
  forall (N : Nat) (hN : StoppingLawAdmissible P N),
    (1 / P.L) * rsgdOutputGradientSqExpectation P ⟨N, hN⟩ <=
      stationarityBudgetFormula P N

private theorem constant_stepsize_rsgd_stopping_admissible
    (P : Setup n Sample) (N : Nat)
    (hN : StoppingLawAdmissible P N) :
    RSGDStoppingLawAdmissible P N (paperStepSizeFormula P N) := by
  refine ⟨hN.1.1, ?_, ?_, ?_⟩
  · intro r _hr
    let γ := paperStepSizeFormula P N (stoppingTime N r)
    have hγ_le : γ ≤ 1 / P.L := by
      dsimp [γ]
      unfold paperStepSizeFormula
      exact min_le_left _ _
    have hone_div_lt_two_div : 1 / P.L < 2 / P.L := by
      have hpos : 0 < 1 / P.L := one_div_pos.mpr P.L_pos
      calc
        1 / P.L < 1 / P.L + 1 / P.L := lt_add_of_pos_right _ hpos
        _ = 2 / P.L := by ring
    exact lt_of_le_of_lt hγ_le hone_div_lt_two_div
  · intro r
    simpa [rsgdWeightFromStepsize, stoppingWeightFormula]
      using hN.2.1 r
  · simpa [rsgdWeightDenominatorFromStepsize, stoppingWeightDenominatorFormula,
      rsgdWeightFromStepsize, stoppingWeightFormula]
      using hN.2.2

private theorem constant_stepsize_realized_expectation_eq_withStepsize
    (P : Setup n Sample) (N : Nat)
    (hN : StoppingLawAdmissible P N) :
    rsgdOutputGradientSqExpectation P ⟨N, hN⟩ =
      rsgdOutputGradientSqExpectationWithStepsize P (paperStepSizeFormula P N)
        ⟨N, constant_stepsize_rsgd_stopping_admissible P N hN⟩ := by
  have hstep :
      rsgdStep P ⟨N, hN⟩ =
        rsgdStepWithStepsize P (paperStepSizeFormula P N) := by
    funext k x xi
    simp [rsgdStep, rsgdStepWithStepsize, paperStepSize]
  have hiterates :
      rsgdIterates P ⟨N, hN⟩ =
        rsgdIteratesWithStepsize P (paperStepSizeFormula P N) := by
    simp [rsgdIterates, rsgdIteratesWithStepsize, hstep]
  have hpmf :
      rsgdStoppingPMF P ⟨N, hN⟩ =
        rsgdStoppingPMFWithStepsize P (paperStepSizeFormula P N)
          ⟨N, constant_stepsize_rsgd_stopping_admissible P N hN⟩ := by
    ext r
    simp [rsgdStoppingPMF, rsgdStoppingPMFWithStepsize, stoppingMass,
      rsgdStoppingMassWithStepsize, stoppingWeight, stoppingWeightDenominator,
      rsgdWeightFromStepsize, rsgdWeightDenominatorFromStepsize,
      stoppingWeightFormula, stoppingWeightDenominatorFormula]
  simp [rsgdOutputGradientSqExpectation, rsgdOutputGradientSqExpectationWithStepsize,
    rsgdOutputGradientSq, rsgdOutputGradientSqWithStepsize, rsgdRunOutput,
    rsgdRunOutputWithStepsize, rsgdIterate, rsgdIterateWithStepsize,
    rsgdStoppingSampleMeasure, rsgdStoppingSampleMeasureWithStepsize,
    hiterates, hpmf]

private theorem constant_stepsize_ratio_relaxation_scalar
    (D L sigma N γ : Real)
    (hN : 0 < N) (hγ : 0 < γ) (hLγ : L * γ ≤ 1)
    (_hden : 0 < N * (2 * γ - L * γ ^ 2)) :
    (D ^ 2 + sigma ^ 2 * (N * γ ^ 2)) /
        (N * (2 * γ - L * γ ^ 2)) ≤
      D ^ 2 / (N * γ) + sigma ^ 2 * γ := by
  exact _root_.sq_add_sq_mul_mul_sq_div_mul_sub_le_div_add_sq_mul_of_mul_le_one
    D L sigma N γ hN hγ hLγ

private theorem constant_stepsize_min_budget_split_scalar
    (D L sigma d N γ : Real)
    (hN : 0 < N) (hL : 0 < L) (hsigma : 0 < sigma) (hd : 0 < d)
    (hγ_def : γ = min (1 / L) (d / (sigma * Real.sqrt N))) :
    D ^ 2 / (N * γ) + sigma ^ 2 * γ ≤
      L * D ^ 2 / N + (d + D ^ 2 / d) * sigma / Real.sqrt N := by
  exact SOptLib.min_inv_lipschitz_sqrt_horizon_budget_split_le
    D L sigma d N γ hN hL hsigma hd hγ_def

private theorem constant_stepsize_stationarity_rhs_le_budget
    (P : Setup n Sample) (N : Nat)
    (hN : StoppingLawAdmissible P N) :
    (objectiveRadius P ^ 2 +
        P.sigma ^ 2 *
          ∑ r : Fin N, paperStepSizeFormula P N (stoppingTime N r) ^ 2) /
        rsgdWeightDenominatorFromStepsize P (paperStepSizeFormula P N) N <=
      stationarityBudgetFormula P N := by
  let γ : Real :=
    min (1 / P.L) (P.dtilde / (P.sigma * Real.sqrt (N : Real)))
  have hN_real : 0 < (N : Real) := by exact_mod_cast hN.1.1
  have hsqrt_pos : 0 < Real.sqrt (N : Real) := Real.sqrt_pos.2 hN_real
  have hden_step_pos : 0 < P.sigma * Real.sqrt (N : Real) :=
    mul_pos hN.1.2 hsqrt_pos
  have hγ_pos : 0 < γ := by
    dsimp [γ]
    exact lt_min (one_div_pos.mpr P.L_pos) (div_pos P.dtilde_pos hden_step_pos)
  have hγ_le_one_over_L : γ ≤ 1 / P.L := by
    dsimp [γ]
    exact min_le_left _ _
  have hLγ : P.L * γ ≤ 1 := by
    calc
      P.L * γ ≤ P.L * (1 / P.L) :=
        mul_le_mul_of_nonneg_left hγ_le_one_over_L (le_of_lt P.L_pos)
      _ = 1 := by field_simp [ne_of_gt P.L_pos]
  have hsum_sq :
      (∑ r : Fin N, paperStepSizeFormula P N (stoppingTime N r) ^ 2) =
        (N : Real) * γ ^ 2 := by
    simp [paperStepSizeFormula, γ]
  have hden :
      rsgdWeightDenominatorFromStepsize P (paperStepSizeFormula P N) N =
        (N : Real) * (2 * γ - P.L * γ ^ 2) := by
    simp [rsgdWeightDenominatorFromStepsize, rsgdWeightFromStepsize,
      paperStepSizeFormula, γ]
    ring
  have hsource_den_pos :
      0 < rsgdWeightDenominatorFromStepsize P (paperStepSizeFormula P N) N := by
    simpa [rsgdWeightDenominatorFromStepsize, stoppingWeightDenominatorFormula,
      rsgdWeightFromStepsize, stoppingWeightFormula]
      using hN.2.2
  have hclosed_den_pos :
      0 < (N : Real) * (2 * γ - P.L * γ ^ 2) := by
    simpa [hden] using hsource_den_pos
  calc
    (objectiveRadius P ^ 2 +
        P.sigma ^ 2 *
          ∑ r : Fin N, paperStepSizeFormula P N (stoppingTime N r) ^ 2) /
        rsgdWeightDenominatorFromStepsize P (paperStepSizeFormula P N) N
        =
          (objectiveRadius P ^ 2 +
              P.sigma ^ 2 * ((N : Real) * γ ^ 2)) /
            ((N : Real) * (2 * γ - P.L * γ ^ 2)) := by
          rw [hsum_sq, hden]
    _ ≤ objectiveRadius P ^ 2 / ((N : Real) * γ) + P.sigma ^ 2 * γ :=
          constant_stepsize_ratio_relaxation_scalar
            (objectiveRadius P) P.L P.sigma (N : Real) γ
            hN_real hγ_pos hLγ hclosed_den_pos
    _ ≤ stationarityBudgetFormula P N := by
          unfold stationarityBudgetFormula
          simpa [γ, mul_add, add_comm, add_left_comm, add_assoc] using
            constant_stepsize_min_budget_split_scalar
              (objectiveRadius P) P.L P.sigma P.dtilde (N : Real) γ
              hN_real P.L_pos hN.1.2 P.dtilde_pos rfl

theorem constant_stepsize_realized_bound_of_conditional_bridge
    (P : Setup n Sample) (hA : Assumption13 P)
    (hCond : ConditionalRandomQueryOracleBridge P) :
    forall (N : Nat) (hN : StoppingLawAdmissible P N),
      (1 / P.L) * rsgdOutputGradientSqExpectation P ⟨N, hN⟩ <=
        stationarityBudgetFormula P N := by
  intro N hN
  let gamma : StepsizeSchedule := paperStepSizeFormula P N
  have hStop : RSGDStoppingLawAdmissible P N gamma := by
    simpa [gamma] using constant_stepsize_rsgd_stopping_admissible P N hN
  have hBridge : RSGDResidualMartingaleBridgeWithStepsize P gamma N := by
    exact RSGDResidualMartingaleBridgeWithStepsize.of_randomQuery_and_conditional
      P gamma N (Assumption13.random_query_bridge P hA) hCond
      (RSGDHistoryMeasurabilityWithStepsize.of_recursiveIterates P gamma N)
  have hStationarity :=
    (RSGD_stationarity_conditional_realized_bound P) N gamma hStop hBridge
  have hExp :
      rsgdOutputGradientSqExpectation P ⟨N, hN⟩ =
        rsgdOutputGradientSqExpectationWithStepsize P gamma ⟨N, hStop⟩ := by
    simpa [gamma] using
      constant_stepsize_realized_expectation_eq_withStepsize P N hN
  calc
    (1 / P.L) * rsgdOutputGradientSqExpectation P ⟨N, hN⟩
        =
          (1 / P.L) *
            rsgdOutputGradientSqExpectationWithStepsize P gamma ⟨N, hStop⟩ := by
          rw [hExp]
    _ <=
        (objectiveRadius P ^ 2 +
            P.sigma ^ 2 *
              ∑ r : Fin N, gamma (stoppingTime N r) ^ 2) /
          rsgdWeightDenominatorFromStepsize P gamma N := hStationarity
    _ <= stationarityBudgetFormula P N := by
      simpa [gamma] using constant_stepsize_stationarity_rhs_le_budget P N hN

theorem Constant_stepsize_bound
    (P : Setup n Sample) (hA : Assumption13 P) :
    ConstantStepsizeBoundStatement P := by
  intro N _hN
  unfold ConstantStepsizeSourceBoundary
  constructor
  · simp [SourceBoundaryObstruction]
  · intro hCond
    exact constant_stepsize_realized_bound_of_conditional_bridge P hA hCond N

private theorem stationarityBudgetFormula_pos
    (P : Setup n Sample) (N : Nat)
    (hN : StoppingLawAdmissible P N) :
    0 < stationarityBudgetFormula P N := by
  unfold stationarityBudgetFormula SOptLib.nonconvexStationarityBudgetBound
  have hN_real : 0 < (N : Real) := by exact_mod_cast hN.1.1
  have hsqrt_pos : 0 < Real.sqrt (N : Real) := Real.sqrt_pos.2 hN_real
  have hfirst_nonneg : 0 <= P.L * objectiveRadius P ^ 2 / (N : Real) := by
    exact div_nonneg
      (mul_nonneg (le_of_lt P.L_pos) (sq_nonneg (objectiveRadius P)))
      (le_of_lt hN_real)
  have hD_div_nonneg : 0 <= objectiveRadius P ^ 2 / P.dtilde :=
    div_nonneg (sq_nonneg (objectiveRadius P)) (le_of_lt P.dtilde_pos)
  have hsum_pos : 0 < P.dtilde + objectiveRadius P ^ 2 / P.dtilde := by
    exact add_pos_of_pos_of_nonneg P.dtilde_pos hD_div_nonneg
  have hsecond_pos :
      0 < (P.dtilde + objectiveRadius P ^ 2 / P.dtilde) *
          P.sigma / Real.sqrt (N : Real) := by
    exact div_pos (mul_pos hsum_pos hN.1.2) hsqrt_pos
  linarith


private theorem rsgd_output_gradient_sq_integrable_of_conditional_bridge
    (P : Setup n Sample) (hA : Assumption13 P)
    (hCond : ConditionalRandomQueryOracleBridge P)
    (N : Nat) (hN : StoppingLawAdmissible P N) :
    Integrable
      (fun q : Fin N × SamplePath Sample => rsgdOutputGradientSq P ⟨N, hN⟩ q)
      (rsgdStoppingSampleMeasure P ⟨N, hN⟩) := by
  letI : IsProbabilityMeasure P.sampleLaw := P.sampleLaw_isProbability
  let gamma : StepsizeSchedule := paperStepSizeFormula P N
  have hStop : RSGDStoppingLawAdmissible P N gamma := by
    simpa [gamma] using constant_stepsize_rsgd_stopping_admissible P N hN
  have hBridge : RSGDResidualMartingaleBridgeWithStepsize P gamma N := by
    exact RSGDResidualMartingaleBridgeWithStepsize.of_randomQuery_and_conditional
      P gamma N (Assumption13.random_query_bridge P hA) hCond
      (RSGDHistoryMeasurabilityWithStepsize.of_recursiveIterates P gamma N)
  have hInt :=
    integrable_finite_index_first_prod_of_fiber_integrable
      (ν := (rsgdStoppingPMFWithStepsize P gamma ⟨N, hStop⟩).toMeasure)
      (μ := P.sampleLaw)
      (F := fun r xi => ‖trueGradient P (rsgdRunOutputWithStepsize P gamma N xi r)‖ ^ 2)
      (by
        intro r
        simpa [rsgdRunOutputWithStepsize] using
          rsgd_gradient_sq_integrable_of_bridge P N gamma hBridge r)
  have hstep :
      rsgdStep P ⟨N, hN⟩ =
        rsgdStepWithStepsize P (paperStepSizeFormula P N) := by
    funext k x xi
    simp [rsgdStep, rsgdStepWithStepsize, paperStepSize]
  have hiterates :
      rsgdIterates P ⟨N, hN⟩ =
        rsgdIteratesWithStepsize P (paperStepSizeFormula P N) := by
    simp [rsgdIterates, rsgdIteratesWithStepsize, hstep]
  have hpmf :
      rsgdStoppingPMF P ⟨N, hN⟩ =
        rsgdStoppingPMFWithStepsize P (paperStepSizeFormula P N)
          ⟨N, constant_stepsize_rsgd_stopping_admissible P N hN⟩ := by
    ext r
    simp [rsgdStoppingPMF, rsgdStoppingPMFWithStepsize, stoppingMass,
      rsgdStoppingMassWithStepsize, stoppingWeight, stoppingWeightDenominator,
      rsgdWeightFromStepsize, rsgdWeightDenominatorFromStepsize,
      stoppingWeightFormula, stoppingWeightDenominatorFormula]
  simpa [gamma, rsgdStoppingSampleMeasure, rsgdStoppingSampleMeasureWithStepsize,
    rsgdOutputGradientSq, rsgdOutputGradientSqWithStepsize, rsgdRunOutput,
    rsgdRunOutputWithStepsize, rsgdIterate, rsgdIterateWithStepsize,
    hiterates, hpmf] using hInt

private theorem one_run_markov_tail_realized_of_conditional_bridge
    (P : Setup n Sample) (hA : Assumption13 P)
    (hCond : ConditionalRandomQueryOracleBridge P) :
    forall (N : Nat) (hN : StoppingLawAdmissible P N),
      forall (lambda : Real), 0 < lambda ->
        rsgdOutputGradientTailProbability P ⟨N, hN⟩
            (lambda * P.L * stationarityBudgetFormula P N) <=
          ENNReal.ofReal (1 / lambda) := by
  intro N hN lambda hlambda
  let μ := rsgdStoppingSampleMeasure P ⟨N, hN⟩
  let f : Fin N × SamplePath Sample -> Real :=
    fun q => rsgdOutputGradientSq P ⟨N, hN⟩ q
  let B : Real := stationarityBudgetFormula P N
  have hf_int : Integrable f μ := by
    simpa [f, μ] using
      rsgd_output_gradient_sq_integrable_of_conditional_bridge P hA hCond N hN
  have hf_nonneg : ∀ q, 0 <= f q := by
    intro q
    simp [f, rsgdOutputGradientSq]
  have hExpBound :=
    constant_stepsize_realized_bound_of_conditional_bridge P hA hCond N hN
  have h_int_le : ∫ q, f q ∂μ <= P.L * B := by
    have hscaled :
        (1 / P.L) * (∫ q, f q ∂μ) <= B := by
      simpa [f, μ, B, rsgdOutputGradientSqExpectation] using hExpBound
    calc
      ∫ q, f q ∂μ = P.L * ((1 / P.L) * ∫ q, f q ∂μ) := by
        field_simp [ne_of_gt P.L_pos]
      _ <= P.L * B := mul_le_mul_of_nonneg_left hscaled (le_of_lt P.L_pos)
  have hB_pos : 0 < B := by
    simpa [B] using stationarityBudgetFormula_pos P N hN
  have htail := measure_ge_mul_le_inv_of_integral_le_of_nonneg
    (μ := μ) f (P.L * B) lambda
    hf_int hf_nonneg h_int_le (mul_pos P.L_pos hB_pos) hlambda
  simpa [rsgdOutputGradientTailProbability, μ, f, B, mul_assoc] using htail

/-- One-run Markov tail statement used in Eq. (6.1.37). -/
def OneRunMarkovTailSourceBoundary
    (P : Setup n Sample) (N : Nat) (lambda : Real) : Prop :=
  SourceBoundaryObstruction P "Eq. (6.1.37) one-run Markov tail"
    ["depends on the conditional one-run expectation bound behind Eq. (6.1.18)",
      "requires realized stopping PMF for the printed horizon"] /\
    (ConditionalRandomQueryOracleBridge P ->
      forall hN : StoppingLawAdmissible P N,
        rsgdOutputGradientTailProbability P ⟨N, hN⟩
            (lambda * P.L * stationarityBudgetFormula P N) <=
          ENNReal.ofReal (1 / lambda))

def OneRunMarkovTailStatement (P : Setup n Sample) : Prop :=
  forall (N : Nat), 1 <= N ->
    forall (lambda : Real), 0 < lambda ->
      OneRunMarkovTailSourceBoundary P N lambda

def OneRunMarkovTailRealizedStatement (P : Setup n Sample) : Prop :=
  forall (N : Nat) (hN : StoppingLawAdmissible P N),
    forall (lambda : Real), 0 < lambda ->
      rsgdOutputGradientTailProbability P ⟨N, hN⟩
          (lambda * P.L * stationarityBudgetFormula P N) <=
        ENNReal.ofReal (1 / lambda)

theorem One_run_Markov_tail_bound
    (P : Setup n Sample) (hA : Assumption13 P) :
    OneRunMarkovTailStatement P := by
  intro N _hN lambda hlambda
  unfold OneRunMarkovTailSourceBoundary
  constructor
  · simp [SourceBoundaryObstruction]
  · intro hCond hStop
    exact one_run_markov_tail_realized_of_conditional_bridge P hA hCond N hStop
      lambda hlambda

/-- Source-facing hypotheses of Lemma 6.1(a): an increasing filtration and a
martingale-difference sequence with per-index second-moment bounds.
-/
def MartingaleDifferenceHypotheses
    {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    (F : Nat -> MeasurableSpace Ω) (zeta : Nat -> Ω -> State n)
    (sigmaSeq : Nat -> Real) : Prop :=
  F 0 = ⊥ /\
    (forall i : Nat, F i <= F (i + 1)) /\
    (forall i : Nat, F i <= (inferInstance : MeasurableSpace Ω)) /\
    (forall i : Nat, 1 <= i ->
      @Measurable Ω (State n) (F i) _ (zeta i)) /\
    (forall i : Nat, 1 <= i -> Integrable (zeta i) μ) /\
    (forall i : Nat, 1 <= i ->
      μ[zeta i | F (i - 1)] =ᵐ[μ] (fun _ => (0 : State n))) /\
    (forall i : Nat, 1 <= i ->
      Integrable (fun ω => ‖zeta i ω‖ ^ 2) μ) /\
    (forall i : Nat, 1 <= i ->
      (∫ ω, ‖zeta i ω‖ ^ 2 ∂μ) <= sigmaSeq i ^ 2)

/-- Internal Lean realization of Lemma 6.1(a) on an arbitrary measurable
probability space.

The paper states this lemma for a Polish space with a Borel probability
measure.  The measure-space version is useful proof infrastructure, but it is
not the paper-facing statement.
-/
def MartingaleSecondMomentRealizedStatement (n : Nat) : Prop :=
  forall (Ω : Type) [MeasurableSpace Ω] (μ : Measure Ω),
    IsProbabilityMeasure μ ->
      forall (F : Nat -> MeasurableSpace Ω)
        (zeta : Nat -> Ω -> State n) (sigmaSeq : Nat -> Real),
        MartingaleDifferenceHypotheses μ F zeta sigmaSeq ->
          forall (N : Nat), 1 <= N ->
            (∫ ω, ‖Finset.sum (Finset.Icc 1 N) (fun i => zeta i ω)‖ ^ 2 ∂μ) <=
                Finset.sum (Finset.Icc 1 N) (fun i => sigmaSeq i ^ 2) /\
              SourceBoundaryObstructionBare
                "Lemma 6.1(a) tail statement"
                ["source prints lambda >= 0 although the displayed 1/lambda bound is singular at lambda = 0",
                  "source prints a non-strict tail; the zero-variance case requires the strict-tail realization used here"] /\
              forall lambda : Real, 0 < lambda ->
                μ {ω | ‖Finset.sum (Finset.Icc 1 N) (fun i => zeta i ω)‖ ^ 2 >
                    lambda * Finset.sum (Finset.Icc 1 N)
                      (fun i => sigmaSeq i ^ 2)} <=
                  ENNReal.ofReal (1 / lambda)

/-- Lemma 6.1(a), source-boundary statement.

The source lemma is a Polish/Borel probability-space theorem.  This file keeps
the reusable arbitrary-measurable-space correction separate as
`MartingaleSecondMomentRealizedStatement` and records the positive-`lambda`
correction for the printed tail display.
-/
def MartingaleSecondMomentStatement (n : Nat) : Prop :=
  SourceBoundaryObstructionBare "Lemma 6.1(a)"
    ["paper states a Polish space with Borel probability measure, not the arbitrary measurable-space extension",
      "source prints lambda >= 0 although the displayed 1/lambda bound is singular at lambda = 0",
      "source prints a non-strict tail; the unguarded zero-variance case is false, so the realized reusable tail is strict"] /\
    MartingaleSecondMomentRealizedStatement n

private theorem filtration_le_of_successor_mono
    {Ω : Type*} [MeasurableSpace Ω] {F : Nat -> MeasurableSpace Ω}
    (hmono : forall i : Nat, F i <= F (i + 1)) :
    forall {a b : Nat}, a <= b -> F a <= F b := by
  intro a b hab
  induction hab with
  | refl =>
      rfl
  | step _ ih =>
      exact le_trans ih (hmono _)

private theorem martingale_cross_integral_zero_of_indices
    {n : Nat} {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    [IsProbabilityMeasure μ]
    (F : Nat -> MeasurableSpace Ω) (zeta : Nat -> Ω -> State n)
    (sigmaSeq : Nat -> Real)
    (hMD : MartingaleDifferenceHypotheses μ F zeta sigmaSeq)
    {N i j : Nat} (hiI : i ∈ Finset.Icc 1 N) (hjI : j ∈ Finset.Icc 1 N)
    (hij_ne : i ≠ j) :
    ∫ ω, ⟪zeta i ω, zeta j ω⟫_ℝ ∂μ = 0 := by
  classical
  rcases hMD with
    ⟨_hF0, hmono, hF_le, hmeas, hint, hcond, hsq_int, _hsq_bound⟩
  have hi1 : 1 <= i := (Finset.mem_Icc.mp hiI).1
  have hj1 : 1 <= j := (Finset.mem_Icc.mp hjI).1
  exact integral_inner_martingale_difference_eq_zero_of_ne
    (μ := μ)
    (F :=
      { seq := F
        mono' := fun _ _ hab => filtration_le_of_successor_mono (F := F) hmono hab
        le' := hF_le })
    (zeta := zeta) hmeas hint hcond hsq_int hi1 hj1 hij_ne

private theorem integrable_norm_sq_finset_sum_of_integrable_sq_norm
    {Ω E ι : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [DecidableEq ι]
    (μ : Measure Ω) (I : Finset ι) (δ : ι -> Ω -> E)
    (hmeas : forall i, i ∈ I -> AEStronglyMeasurable (δ i) μ)
    (hL2 : forall i, i ∈ I -> Integrable (fun ω => ‖δ i ω‖ ^ 2) μ) :
    Integrable (fun ω => ‖Finset.sum I (fun i => δ i ω)‖ ^ 2) μ := by
  exact SOptLib.integrable_norm_sq_finset_sum_of_integrable_norm_sq μ I δ hmeas hL2

theorem Martingale_second_moment_bound
    (n : Nat) :
    MartingaleSecondMomentStatement n := by
  unfold MartingaleSecondMomentStatement MartingaleSecondMomentRealizedStatement
  constructor
  · simp [SourceBoundaryObstructionBare]
  · intro Ω _ μ hprob F zeta sigmaSeq hMD N _hN
    classical
    letI : IsProbabilityMeasure μ := hprob
    rcases hMD with
      ⟨_hF0, hmono, hF_le, hmeas, hint, hcond, hsq_int, hsq_bound⟩
    let Filt : Filtration Nat (inferInstance : MeasurableSpace Ω) :=
      { seq := F
        mono' := fun _ _ hab => filtration_le_of_successor_mono (F := F) hmono hab
        le' := hF_le }
    have hMD' : SOptLib.MartingaleDifferenceL2Hypotheses μ Filt zeta sigmaSeq := by
      exact ⟨hmeas, hint, hcond, hsq_int, hsq_bound⟩
    have hbound :=
      martingale_second_moment_and_strict_tail_bound
        (μ := μ) Filt zeta sigmaSeq hMD' N
    constructor
    · exact hbound.1
    · constructor
      · simp [SourceBoundaryObstructionBare]
      · exact hbound.2

/-- Tail probability of the selected 2-RSGD output, with realization witnesses
kept local to the definition instead of appearing in the paper theorem head.
-/
noncomputable def twoRSGDSelectedGradientTailProbability
    (P : Setup n Sample) (S N T : Nat)
    (hS : 0 < S) (hN : StoppingLawAdmissible P N)
    (hT : ValidationCountAdmissible T)
    (threshold : Real) : ENNReal :=
  (twoPhaseStoppingSampleMeasure P S ⟨N, hN⟩)
    {q | ‖trueGradient P
          (twoPhaseOutputOnJoint P S ⟨N, hN⟩ ⟨T, hT⟩ hS q)‖ ^ 2 > threshold}

/-- Validation residual for Lemma 6.1(a) at a deterministic post-optimization
candidate.  This is the source object `δ_{s,k}` after the candidate has been
fixed and only the validation sample path remains random.
-/
noncomputable def fixedValidationResidual
    (P : Setup n Sample) (x : State n) (k : Nat) :
    SamplePath Sample -> State n :=
  fun xi => P.oracle x (xi k) - trueGradient P x

/-- Source-level martingale prerequisites for a fixed validation candidate.

The bridge records the filtration, measurability, conditional mean-zero, and
second-moment hypotheses needed before Lemma 6.1(a) can be instantiated for
the residuals `δ_{s,k}`.  It is deliberately smaller than the tail conclusion.
-/
def FixedValidationMartingaleBridgeAt
    (P : Setup n Sample) (x : State n) : Prop :=
  exists F : Nat -> MeasurableSpace (SamplePath Sample),
    MartingaleDifferenceHypotheses P.sampleLaw F
      (fun k xi => fixedValidationResidual P x k xi)
      (fun _ => P.sigma)

/-- Post-optimization fixed-candidate bridge required by the source invocation
of Lemma 6.1(a) before Eq. (6.1.38).
-/
def PostOptimizationFixedCandidateMartingaleBridge
    (P : Setup n Sample) (S N T : Nat) : Prop :=
  forall (_hS : 0 < S) (hN : StoppingLawAdmissible P N)
    (_hT : ValidationCountAdmissible T),
      forall (R : Fin S -> Fin N) (omega : OptimizationSamplePath Sample S)
        (s : Fin S),
        FixedValidationMartingaleBridgeAt P
          (optimizationCandidate P S ⟨N, hN⟩ R s omega)

private theorem martingale_second_moment_tail_bound_typeStar
    {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    (hprob : IsProbabilityMeasure μ)
    (F : Nat -> MeasurableSpace Ω) (zeta : Nat -> Ω -> State n)
    (sigmaSeq : Nat -> Real)
    (hMD : MartingaleDifferenceHypotheses μ F zeta sigmaSeq)
    (N : Nat) (_hN : 1 <= N) (lambda : Real) (hlambda : 0 < lambda) :
    μ {ω | ‖Finset.sum (Finset.Icc 1 N) (fun i => zeta i ω)‖ ^ 2 >
          lambda * Finset.sum (Finset.Icc 1 N) (fun i => sigmaSeq i ^ 2)} <=
      ENNReal.ofReal (1 / lambda) := by
  classical
  letI : IsProbabilityMeasure μ := hprob
  let I := Finset.Icc 1 N
  have hMD_orig : MartingaleDifferenceHypotheses μ F zeta sigmaSeq := hMD
  rcases hMD with
    ⟨_hF0, _hmono, hF_le, hmeas, _hint, _hcond, hsq_int, hsq_bound⟩
  have h_ae_meas : forall i, i ∈ I ->
      AEStronglyMeasurable (zeta i) μ := by
    intro i hi
    have hi1 : 1 <= i := (Finset.mem_Icc.mp hi).1
    exact ((hmeas i hi1).of_measurableSpace_le (hF_le i)).aestronglyMeasurable
  have hL2I : forall i, i ∈ I ->
      Integrable (fun ω => ‖zeta i ω‖ ^ 2) μ := by
    intro i hi
    exact hsq_int i ((Finset.mem_Icc.mp hi).1)
  have hcross :
      forall i, i ∈ I -> forall j, j ∈ I -> i ≠ j ->
        ∫ ω, ⟪zeta i ω, zeta j ω⟫_ℝ ∂μ = 0 := by
    intro i hi j hj hij
    exact martingale_cross_integral_zero_of_indices
      (μ := μ) F zeta sigmaSeq hMD_orig hi hj hij
  have hdiag :
      ∫ ω, ‖Finset.sum I (fun i => zeta i ω)‖ ^ 2 ∂μ =
        Finset.sum I (fun i => ∫ ω, ‖zeta i ω‖ ^ 2 ∂μ) :=
    integral_norm_sq_finset_sum_eq_sum_integrals_of_cross_zero
      μ I zeta h_ae_meas hL2I hcross
  have hL2Bound :
      (∫ ω, ‖Finset.sum I (fun i => zeta i ω)‖ ^ 2 ∂μ) <=
        Finset.sum I (fun i => sigmaSeq i ^ 2) := by
    rw [hdiag]
    exact Finset.sum_le_sum (by
      intro i hi
      exact hsq_bound i ((Finset.mem_Icc.mp hi).1))
  set C : Real := Finset.sum I (fun i => sigmaSeq i ^ 2) with hC_def
  have hC_nonneg : 0 <= C := by
    rw [hC_def]
    exact Finset.sum_nonneg (by
      intro i hi
      exact sq_nonneg (sigmaSeq i))
  have hsum_int :
      Integrable
        (fun ω => ‖Finset.sum I (fun i => zeta i ω)‖ ^ 2) μ :=
    integrable_norm_sq_finset_sum_of_integrable_sq_norm
      μ I zeta h_ae_meas hL2I
  have hL2BoundC :
      (∫ ω, ‖Finset.sum I (fun i => zeta i ω)‖ ^ 2 ∂μ) <= C := by
    simpa [hC_def] using hL2Bound
  have htail := measure_gt_le_of_integral_le_of_nonneg
    (μ := μ)
    (f := fun ω => ‖Finset.sum I (fun i => zeta i ω)‖ ^ 2)
    (t := lambda * C) (C := C) (b := 1 / lambda)
    hsum_int
    (by intro ω; exact sq_nonneg (‖Finset.sum I (fun i => zeta i ω)‖))
    hL2BoundC
    (mul_nonneg (le_of_lt hlambda) hC_nonneg)
    (by
      intro htpos
      have hCpos : 0 < C := by
        nlinarith [htpos, hlambda, hC_nonneg]
      have hEq : C / (lambda * C) = 1 / lambda := by
        field_simp [hlambda.ne', hCpos.ne']
      rw [hEq])
    (by
      intro htzero
      nlinarith [hC_nonneg, hlambda, htzero])
  simpa [I, hC_def] using htail

private theorem fixed_validation_sum_tail_on_sampleLaw_of_bridge_at
    (P : Setup n Sample) (x : State n) (T : Nat) (lambda : Real)
    (hBridgeAt : FixedValidationMartingaleBridgeAt P x)
    (hT : ValidationCountAdmissible T) (hlambda : 0 < lambda) :
    P.sampleLaw
        {xi |
          ‖Finset.sum (Finset.Icc 1 T)
              (fun k => fixedValidationResidual P x k xi)‖ ^ 2 >
            lambda *
              Finset.sum (Finset.Icc 1 T) (fun _ => P.sigma ^ 2)} <=
      ENNReal.ofReal (1 / lambda) := by
  rcases hBridgeAt with ⟨F, hMD⟩
  exact martingale_second_moment_tail_bound_typeStar
    P.sampleLaw P.sampleLaw_isProbability
    F (fun k xi => fixedValidationResidual P x k xi)
    (fun _ => P.sigma) hMD T hT lambda hlambda

private theorem fixed_validation_tail_on_sampleLaw_of_bridge_at
    (P : Setup n Sample) (x : State n) (T : Nat) (lambda : Real)
    (hBridgeAt : FixedValidationMartingaleBridgeAt P x)
    (hT : ValidationCountAdmissible T) (hlambda : 0 < lambda) :
    P.sampleLaw
        {xi |
          ‖((T : Real)⁻¹) •
              Finset.sum (Finset.Icc 1 T)
                (fun k => fixedValidationResidual P x k xi)‖ ^ 2 >
            lambda * P.sigma ^ 2 / T} <=
      ENNReal.ofReal (1 / lambda) := by
  have hcard : (Finset.Icc 1 T).card = T := by
    rw [Nat.card_Icc]
    omega
  simpa [hcard] using
    measure_norm_sq_inv_nat_smul_sum_gt_le_of_sum_tail_const_variance
      (μ := P.sampleLaw) (s := Finset.Icc 1 T)
      (zeta := fun k xi => fixedValidationResidual P x k xi)
      (sigma := P.sigma) (lambda := lambda)
      (hs := by
        rw [hcard]
        exact Nat.lt_of_lt_of_le Nat.zero_lt_one hT)
      (hsumTail :=
        fixed_validation_sum_tail_on_sampleLaw_of_bridge_at
          P x T lambda hBridgeAt hT hlambda)

private theorem prod_measure_le_of_fiber_measure_le
    {A B : Type*} [MeasurableSpace A] [MeasurableSpace B]
    (μ : Measure A) (ν : Measure B) [SFinite ν] [IsProbabilityMeasure μ]
    (E : Set (A × B)) (hE : MeasurableSet E) (C : ENNReal)
    (hfiber : forall a, ν (Prod.mk a ⁻¹' E) <= C) :
    (μ.prod ν) E <= C := by
  exact Measure.prod_le_of_forall_fiber_le μ ν E hE C hfiber

private theorem candidateValidationErrorSq_eq_fixed_residual_average
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (R : Fin S -> Fin N.1) (s : Fin S)
    (q : TwoPhaseSamplePath Sample S) :
    candidateValidationErrorSq P S N T R s q =
      ‖((T.1 : Real)⁻¹) •
          Finset.sum (Finset.Icc 1 T.1)
            (fun k =>
              fixedValidationResidual P
                (optimizationCandidate P S N R s q.1) k q.2)‖ ^ 2 := by
  have hcard : (Finset.Icc 1 T.1).card = T.1 := by
    simpa using (Nat.card_Icc 1 T.1)
  have hcenter :=
    miniBatchAverage_sub_target_eq_average_residual
      (I := Finset.Icc 1 T.1) (m := T.1)
      (hmcard := hcard) (hmpos := T.property)
      (a := fun k => validationOracleValue P q.2 k
        (optimizationCandidate P S N R s q.1))
      (target := trueGradient P (optimizationCandidate P S N R s q.1))
  rw [candidateValidationErrorSq_apply, candidateEmpiricalGradient,
    empiricalGradient_eq_source_formula]
  rw [hcenter]
  rfl

private theorem trueGradient_measurable
    (P : Setup n Sample) :
    Measurable (trueGradient P) := by
  have hgrad_lipschitz :
      LipschitzWith (Real.toNNReal P.L) (trueGradient P) := by
    refine lipschitzWith_of_norm_sub_le_mul (trueGradient P) P.L ?_
    intro x y
    simpa [trueGradient, dist_eq_norm] using P.smooth_gradient y x
  exact hgrad_lipschitz.continuous.measurable

private theorem rsgdIterates_measurable
    (P : Setup n Sample) (N : RSGDHorizon P) :
    forall k : Nat, Measurable (rsgdIterates P N k) := by
  refine recursive_process_measurable_of_measurable_update_oracle
    (x := rsgdIterates P N)
    (oracle := fun j x xi => P.oracle x (xi (j + 1)))
    (update := fun j x g =>
      x - paperStepSize P N (SOptLib.natSuccPositiveTime j) • g)
    ?_ ?_ ?_ ?_
  · exact measurable_const
  · intro j y hy
    exact P.oracle_borel.comp (hy.prodMk (measurable_pi_apply (j + 1)))
  · intro j
    dsimp
    measurability
  · intro j
    funext xi
    simp [rsgdIterates, rsgdStep, sampledOracleValue,
      SOptLib.recursiveIterateProcess, SOptLib.natSuccPositiveTime]

private theorem rsgdIterate_measurable
    (P : Setup n Sample) (N : RSGDHorizon P) (k : PaperTime) :
    Measurable (rsgdIterate P N k) := by
  simpa [rsgdIterate, SOptLib.positiveTimeIterateView] using
    rsgdIterates_measurable P N (k.1 - 1)

private theorem rsgdRunOutput_measurable
    (P : Setup n Sample) (N : RSGDHorizon P) (r : Fin N.1) :
    Measurable (fun xi : SamplePath Sample => rsgdRunOutput P N xi r) := by
  simpa [rsgdRunOutput] using
    rsgdIterate_measurable P N (stoppingTime N.1 r)

private theorem optimizationCandidate_measurable
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (R : Fin S -> Fin N.1) (s : Fin S) :
    Measurable (optimizationCandidate P S N R s) := by
  exact (rsgdRunOutput_measurable P N (R s)).comp (measurable_pi_apply s)

private theorem candidateEmpiricalGradient_measurable
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (R : Fin S -> Fin N.1) (s : Fin S) :
    Measurable (candidateEmpiricalGradient P S N T R s) := by
  classical
  let x : TwoPhaseSamplePath Sample S -> State n :=
    fun q => optimizationCandidate P S N R s q.1
  have hx : Measurable x :=
    (optimizationCandidate_measurable P S N R s).comp measurable_fst
  have hsum :
      Measurable
        (fun q : TwoPhaseSamplePath Sample S =>
          Finset.sum (Finset.Icc 1 T.1)
            (fun k => validationOracleValue P q.2 k (x q))) := by
    refine SOptLib.measurable_finset_sum_kernel_comp_of_coordinate_measurable
      (mΩ := (by infer_instance : MeasurableSpace (TwoPhaseSamplePath Sample S)))
      (I := Finset.Icc 1 T.1)
      (K := fun p : State n × Sample => P.oracle p.1 p.2)
      P.oracle_borel hx
      (Y := fun k (q : TwoPhaseSamplePath Sample S) => q.2 k)
      (idx := fun k => k)
      ?_
    intro k _hk
    exact (measurable_pi_apply k).comp measurable_snd
  have havg :
      Measurable
        (fun q : TwoPhaseSamplePath Sample S =>
          ((T.1 : Real)⁻¹) •
            Finset.sum (Finset.Icc 1 T.1)
              (fun k => validationOracleValue P q.2 k (x q))) := by
    exact hsum.const_smul ((T.1 : Real)⁻¹)
  simpa [candidateEmpiricalGradient, empiricalGradient_eq_source_formula, x]
    using havg

private theorem candidateValidationErrorSq_measurable
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (R : Fin S -> Fin N.1) (s : Fin S) :
    Measurable (candidateValidationErrorSq P S N T R s) := by
  let x : TwoPhaseSamplePath Sample S -> State n :=
    fun q => optimizationCandidate P S N R s q.1
  have hx : Measurable x :=
    (optimizationCandidate_measurable P S N R s).comp measurable_fst
  have hgrad :
      Measurable (fun q : TwoPhaseSamplePath Sample S => trueGradient P (x q)) :=
    (trueGradient_measurable P).comp hx
  have hdiff :
      Measurable
        (fun q : TwoPhaseSamplePath Sample S =>
          candidateEmpiricalGradient P S N T R s q -
            trueGradient P (x q)) :=
    (candidateEmpiricalGradient_measurable P S N T R s).sub hgrad
  have hnorm :
      Measurable
        (fun q : TwoPhaseSamplePath Sample S =>
          ‖candidateEmpiricalGradient P S N T R s q -
            trueGradient P (x q)‖) :=
    measurable_norm.comp hdiff
  have hsquare :
      Measurable
        (fun q : TwoPhaseSamplePath Sample S =>
          ‖candidateEmpiricalGradient P S N T R s q -
            trueGradient P (x q)‖ ^ 2) := by
    exact hnorm.pow_const 2
  simpa [candidateValidationErrorSq, x] using hsquare

private theorem candidateValidationErrorSq_measurableSet_gt
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (R : Fin S -> Fin N.1) (s : Fin S)
    (threshold : Real) :
    MeasurableSet
      {q : TwoPhaseSamplePath Sample S |
        candidateValidationErrorSq P S N T R s q > threshold} := by
  have hmeas := candidateValidationErrorSq_measurable P S N T R s
  simpa [gt_iff_lt] using
    (measurableSet_lt measurable_const hmeas :
      MeasurableSet
        {q : TwoPhaseSamplePath Sample S |
          (fun _ => threshold) q <
            candidateValidationErrorSq P S N T R s q})

private theorem fixed_candidate_tail_under_optimization_product
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (lambda : Real)
    (hPost : PostOptimizationFixedCandidateMartingaleBridge P S N.1 T.1)
    (hS : 0 < S) (hlambda : 0 < lambda)
    (R : Fin S -> Fin N.1) (s : Fin S) :
    ((optimizationSampleLaw P S).prod P.sampleLaw)
        {q : TwoPhaseSamplePath Sample S |
          candidateValidationErrorSq P S N T R s q >
            lambda * P.sigma ^ 2 / T.1} <=
      ENNReal.ofReal (1 / lambda) := by
  let E : Set (TwoPhaseSamplePath Sample S) :=
    {q | candidateValidationErrorSq P S N T R s q >
      lambda * P.sigma ^ 2 / T.1}
  have hE : MeasurableSet E :=
    candidateValidationErrorSq_measurableSet_gt P S N T R s
      (lambda * P.sigma ^ 2 / T.1)
  letI : IsProbabilityMeasure (optimizationSampleLaw P S) :=
    optimizationSampleLaw_isProbability P S
  letI : IsProbabilityMeasure P.sampleLaw := P.sampleLaw_isProbability
  refine prod_measure_le_of_fiber_measure_le
    (μ := optimizationSampleLaw P S) (ν := P.sampleLaw)
    (E := E) hE (ENNReal.ofReal (1 / lambda)) ?_
  intro omega
  have hBridgeAt :
      FixedValidationMartingaleBridgeAt P
        (optimizationCandidate P S N R s omega) :=
    hPost hS N.property T.property R omega s
  have htail :=
    fixed_validation_tail_on_sampleLaw_of_bridge_at
      P (optimizationCandidate P S N R s omega) T.1 lambda
      hBridgeAt T.property hlambda
  have hfiber :
      Prod.mk omega ⁻¹' E =
        {xi : SamplePath Sample |
          ‖((T.1 : Real)⁻¹) •
              Finset.sum (Finset.Icc 1 T.1)
                (fun k =>
                  fixedValidationResidual P
                    (optimizationCandidate P S N R s omega) k xi)‖ ^ 2 >
            lambda * P.sigma ^ 2 / T.1} := by
    ext xi
    have hpoint :=
      candidateValidationErrorSq_eq_fixed_residual_average
        P S N T R s (omega, xi)
    change
      (candidateValidationErrorSq P S N T R s (omega, xi) >
          lambda * P.sigma ^ 2 / T.1) ↔
        (‖((T.1 : Real)⁻¹) •
              Finset.sum (Finset.Icc 1 T.1)
                (fun k =>
                  fixedValidationResidual P
                    (optimizationCandidate P S N R s omega) k xi)‖ ^ 2 >
          lambda * P.sigma ^ 2 / T.1)
    rw [hpoint]
  rw [hfiber]
  exact htail

private theorem fixed_candidate_tail_under_stopping_vector_for_candidate
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (lambda : Real)
    (hPost : PostOptimizationFixedCandidateMartingaleBridge P S N.1 T.1)
    (hS : 0 < S) (hlambda : 0 < lambda) (s : Fin S) :
    (twoPhaseStoppingSampleMeasure P S N)
        {q |
          candidateValidationErrorSq P S N T q.1 s q.2 >
            lambda * P.sigma ^ 2 / T.1} <=
      ENNReal.ofReal (1 / lambda) := by
  classical
  let A : (Fin S -> Fin N.1) -> Set (TwoPhaseSamplePath Sample S) :=
    fun R =>
      {q | candidateValidationErrorSq P S N T R s q >
        lambda * P.sigma ^ 2 / T.1}
  letI : IsProbabilityMeasure (optimizationSampleLaw P S) :=
    optimizationSampleLaw_isProbability P S
  letI : IsProbabilityMeasure P.sampleLaw := P.sampleLaw_isProbability
  have hper :
      forall R : Fin S -> Fin N.1,
        ((optimizationSampleLaw P S).prod P.sampleLaw) (A R) <=
          ENNReal.ofReal (1 / lambda) := by
    intro R
    simpa [A] using
      fixed_candidate_tail_under_optimization_product
        P S N T lambda hPost hS hlambda R s
  simpa [twoPhaseStoppingSampleMeasure, A] using
    (PMF.prod_measure_fiber_event_le_of_forall_le
      (p := rsgdStoppingVectorPMF P S N)
      (μ := (optimizationSampleLaw P S).prod P.sampleLaw)
      (A := A) (C := ENNReal.ofReal (1 / lambda)) hper)

private theorem fixed_candidate_sup_tail_union_bound
    {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    (S : Nat) [Nonempty (Fin S)] (E : Fin S -> Ω -> Real)
    (threshold lambda : Real) (hlambda : 0 < lambda)
    (hper : forall s : Fin S,
      μ {ω | E s ω > threshold} <= ENNReal.ofReal (1 / lambda)) :
    μ {ω |
        Finset.univ.sup' Finset.univ_nonempty (fun s : Fin S => E s ω) >
          threshold} <=
      ENNReal.ofReal (((S : Nat) : Real) / lambda) := by
  classical
  simpa [Finset.card_univ, Fintype.card_fin] using
    SOptLib.measure_finset_sup_gt_le_card_div_of_forall_measure_gt_le
      (mu := μ) (I := (Finset.univ : Finset (Fin S)))
      (hI := Finset.univ_nonempty) (E := E)
      (threshold := threshold) (lambda := lambda)
      (hper := by
        intro s _hs
        exact hper s)

/-- Selected-candidate validation residual on the complete two-phase sample
space.  This is the source object behind Eq. (6.1.39), where the selected index
is itself data-dependent.
-/
noncomputable def selectedValidationResidual
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (hS : 0 < S) (k : Nat) :
    ((Fin S -> Fin N.1) × TwoPhaseSamplePath Sample S) -> State n :=
  fun q =>
    P.oracle (selectedCandidate P S N T hS q.1 q.2) (q.2.2 k) -
      trueGradient P (selectedCandidate P S N T hS q.1 q.2)

/-- Squared empirical-gradient error of the data-dependent selected candidate.

This is the realized event variable behind Eq. (6.1.39).  The probability
statements below use its strict superlevel event, matching the strict tail that
follows from the reusable martingale second-moment realization.
-/
noncomputable def selectedCandidateValidationErrorSq
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (hS : 0 < S) :
    ((Fin S -> Fin N.1) × TwoPhaseSamplePath Sample S) -> Real :=
  fun q =>
    ‖candidateEmpiricalGradient P S N T q.1
        (selectedRun P S N T hS q.1 q.2) q.2 -
      trueGradient P (selectedCandidate P S N T hS q.1 q.2)‖ ^ 2

/-- Selected-index martingale prerequisites required before Lemma 6.1(a) can
be applied to the data-dependent candidate in Eq. (6.1.39).
-/
def SelectedCandidateValidationMartingaleBridge
    (P : Setup n Sample) (S N T : Nat) : Prop :=
  forall (hS : 0 < S) (hN : StoppingLawAdmissible P N)
    (hT : ValidationCountAdmissible T),
      exists F :
        Nat -> MeasurableSpace
          ((Fin S -> Fin N) × TwoPhaseSamplePath Sample S),
        MartingaleDifferenceHypotheses
          (twoPhaseStoppingSampleMeasure P S ⟨N, hN⟩)
          F
          (fun k q => selectedValidationResidual P S ⟨N, hN⟩ ⟨T, hT⟩ hS k q)
          (fun _ => P.sigma)

/-- Per-candidate validation tail estimate used before the union bound in the
proof of Eq. (6.1.38).
-/
def FixedCandidatePreUnionTailSourceBoundary
    (P : Setup n Sample) (S N T : Nat) (lambda : Real) : Prop :=
  SourceBoundaryObstruction P
    "pre-union fixed-candidate validation tail estimate before Eq. (6.1.38)"
    ["post-optimization martingale prerequisites for each fixed candidate are not supplied by the source",
      "the source display uses a non-strict tail; the Lean realized tail is strict to match Lemma 6.1(a) in the zero-variance case",
      "the printed empirical average is source-defined only after T >= 1",
      "the candidate law uses the printed RSGD stopping PMF, whose admissibility must be derived"] /\
    (PostOptimizationFixedCandidateMartingaleBridge P S N T ->
      forall (_hS : 0 < S) (hN : StoppingLawAdmissible P N),
        forall hT : ValidationCountAdmissible T,
          forall s : Fin S,
            (twoPhaseStoppingSampleMeasure P S ⟨N, hN⟩)
                {q | candidateValidationErrorSq P S ⟨N, hN⟩ ⟨T, hT⟩ q.1 s q.2 >
                    lambda * P.sigma ^ 2 / T} <=
              ENNReal.ofReal (1 / lambda))

/-- Fixed-candidate validation union bound Eq. (6.1.38), kept at the paper's
raw `(S,N,T)` boundary.
-/
def FixedCandidateTailSourceBoundary
    (P : Setup n Sample) (S N T : Nat) (lambda : Real) : Prop :=
  SourceBoundaryObstruction P "Eq. (6.1.38) fixed-candidate validation union bound"
    ["post-optimization martingale prerequisites for each fixed candidate are not supplied by the source",
      "the source display uses a non-strict tail; the Lean realized tail is strict to match Lemma 6.1(a) in the zero-variance case",
      "the printed empirical average is source-defined only after T >= 1",
      "the candidate law uses the printed RSGD stopping PMF, whose admissibility must be derived"] /\
    (PostOptimizationFixedCandidateMartingaleBridge P S N T ->
      forall (_hS : 0 < S) (hN : StoppingLawAdmissible P N),
        forall hT : ValidationCountAdmissible T,
          letI : Nonempty (Fin S) := Fin.pos_iff_nonempty.mp _hS
          ;
            (twoPhaseStoppingSampleMeasure P S ⟨N, hN⟩)
                {q |
                  (Finset.univ.sup'
                      (Finset.univ_nonempty)
                      (fun s : Fin S =>
                        candidateValidationErrorSq P S ⟨N, hN⟩ ⟨T, hT⟩ q.1 s q.2)) >
                    lambda * P.sigma ^ 2 / T} <=
              ENNReal.ofReal (((S : Nat) : Real) / lambda))

def FixedCandidateTailStatement (P : Setup n Sample) : Prop :=
  forall (S N T : Nat) (lambda : Real), 0 < lambda ->
    FixedCandidateTailSourceBoundary P S N T lambda

theorem fixed_candidate_tail_bound
    (P : Setup n Sample) (hA : Assumption13 P) :
    FixedCandidateTailStatement P := by
  intro S N T lambda hlambda
  unfold FixedCandidateTailSourceBoundary
  constructor
  · simp [SourceBoundaryObstruction]
  · intro hPost hS hN hT
    classical
    letI : Nonempty (Fin S) := Fin.pos_iff_nonempty.mp hS
    let Np : RSGDHorizon P := ⟨N, hN⟩
    let Tp : ValidationCount := ⟨T, hT⟩
    have hper :
        forall s : Fin S,
          (twoPhaseStoppingSampleMeasure P S Np)
              {q |
                candidateValidationErrorSq P S Np Tp q.1 s q.2 >
                  lambda * P.sigma ^ 2 / T} <=
            ENNReal.ofReal (1 / lambda) := by
      intro s
      simpa [Np, Tp] using
        fixed_candidate_tail_under_stopping_vector_for_candidate
          P S Np Tp lambda hPost hS hlambda s
    simpa [Np, Tp] using
      fixed_candidate_sup_tail_union_bound
        (twoPhaseStoppingSampleMeasure P S Np) S
        (fun s q => candidateValidationErrorSq P S Np Tp q.1 s q.2)
        (lambda * P.sigma ^ 2 / T) lambda hlambda hper

/-- Selected-candidate validation tail bound Eq. (6.1.39), kept at the raw
source boundary because the selected-index martingale prerequisites are not
printed in the source.
-/
def SelectedCandidateTailSourceBoundary
    (P : Setup n Sample) (S N T : Nat) (lambda : Real) : Prop :=
  SourceBoundaryObstruction P "Eq. (6.1.39) selected-candidate validation tail"
    ["selected-index measurability with respect to the martingale filtration is not supplied by the source",
      "selected-index conditional-mean-zero and second-moment prerequisites are not supplied by the source",
      "the realized tail is therefore exposed only through the selected-index martingale bridge",
      "the source display uses a non-strict tail; the Lean realized tail is strict to match Lemma 6.1(a) in the zero-variance case",
      "the printed empirical average is source-defined only after T >= 1"] /\
    (SelectedCandidateValidationMartingaleBridge P S N T ->
      forall (hS : 0 < S) (hN : StoppingLawAdmissible P N),
        forall hT : ValidationCountAdmissible T,
          (twoPhaseStoppingSampleMeasure P S ⟨N, hN⟩)
              {q | selectedCandidateValidationErrorSq
                      P S ⟨N, hN⟩ ⟨T, hT⟩ hS q >
                  lambda * P.sigma ^ 2 / T} <=
            ENNReal.ofReal (1 / lambda))

def SelectedCandidateTailStatement (P : Setup n Sample) : Prop :=
  forall (S N T : Nat) (lambda : Real), 0 < lambda ->
    SelectedCandidateTailSourceBoundary P S N T lambda

private theorem selectedCandidateValidationErrorSq_eq_selected_residual_average
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (hS : 0 < S)
    (q : (Fin S -> Fin N.1) × TwoPhaseSamplePath Sample S) :
    selectedCandidateValidationErrorSq P S N T hS q =
      ‖((T.1 : Real)⁻¹) •
          Finset.sum (Finset.Icc 1 T.1)
            (fun k => selectedValidationResidual P S N T hS k q)‖ ^ 2 := by
  have hcard : (Finset.Icc 1 T.1).card = T.1 := by
    simpa using (Nat.card_Icc 1 T.1)
  let x : State n := selectedCandidate P S N T hS q.1 q.2
  have hcenter :=
    miniBatchAverage_sub_target_eq_average_residual
      (I := Finset.Icc 1 T.1) (m := T.1)
      (hmcard := hcard) (hmpos := T.property)
      (a := fun k => validationOracleValue P q.2.2 k x)
      (target := trueGradient P x)
  rw [selectedCandidateValidationErrorSq, candidateEmpiricalGradient,
    empiricalGradient_eq_source_formula]
  rw [show
      optimizationCandidate P S N q.1
          (selectedRun P S N T hS q.1 q.2) q.2.1 = x by
    simp [x, selectedCandidate]]
  rw [hcenter]
  simp [selectedValidationResidual, x, validationOracleValue]

private theorem selected_validation_sum_tail_of_bridge
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (lambda : Real)
    (hSel : SelectedCandidateValidationMartingaleBridge P S N.1 T.1)
    (hS : 0 < S) (hlambda : 0 < lambda) :
    (twoPhaseStoppingSampleMeasure P S N)
        {q |
          ‖Finset.sum (Finset.Icc 1 T.1)
              (fun k => selectedValidationResidual P S N T hS k q)‖ ^ 2 >
            lambda *
              Finset.sum (Finset.Icc 1 T.1) (fun _ => P.sigma ^ 2)} <=
      ENNReal.ofReal (1 / lambda) := by
  rcases hSel hS N.property T.property with ⟨F, hMD⟩
  have hprob : IsProbabilityMeasure (twoPhaseStoppingSampleMeasure P S N) := by
    letI : IsProbabilityMeasure (optimizationSampleLaw P S) :=
      optimizationSampleLaw_isProbability P S
    letI : IsProbabilityMeasure P.sampleLaw := P.sampleLaw_isProbability
    unfold twoPhaseStoppingSampleMeasure
    infer_instance
  exact martingale_second_moment_tail_bound_typeStar
    (twoPhaseStoppingSampleMeasure P S N) hprob
    F (fun k q => selectedValidationResidual P S N T hS k q)
    (fun _ => P.sigma) hMD T.1 T.property lambda hlambda

private theorem selected_validation_tail_of_bridge
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (T : ValidationCount) (lambda : Real)
    (hSel : SelectedCandidateValidationMartingaleBridge P S N.1 T.1)
    (hS : 0 < S) (hlambda : 0 < lambda) :
    (twoPhaseStoppingSampleMeasure P S N)
        {q |
          ‖((T.1 : Real)⁻¹) •
              Finset.sum (Finset.Icc 1 T.1)
                (fun k => selectedValidationResidual P S N T hS k q)‖ ^ 2 >
            lambda * P.sigma ^ 2 / T.1} <=
      ENNReal.ofReal (1 / lambda) := by
  classical
  have hsumTail :=
    selected_validation_sum_tail_of_bridge
      P S N T lambda hSel hS hlambda
  refine le_trans (measure_mono ?_) hsumTail
  intro q hq
  let y : State n :=
    Finset.sum (Finset.Icc 1 T.1)
      (fun k => selectedValidationResidual P S N T hS k q)
  have hTpos : 0 < (T.1 : Real) := by exact_mod_cast T.property
  have hTne : (T.1 : Real) ≠ 0 := ne_of_gt hTpos
  have hsum_sigma :
      Finset.sum (Finset.Icc 1 T.1) (fun _ : Nat => P.sigma ^ 2) =
        (T.1 : Real) * P.sigma ^ 2 := by
    rw [sum_Icc_one_eq_sum_range_succ]
    simp [Finset.sum_const, nsmul_eq_mul]
  have hnormavg :
      ‖((T.1 : Real)⁻¹) • y‖ ^ 2 =
        ‖y‖ ^ 2 / (T.1 : Real) ^ 2 := by
    rw [norm_smul]
    have hinv_nonneg : 0 <= ((T.1 : Real)⁻¹) :=
      inv_nonneg.mpr (le_of_lt hTpos)
    rw [Real.norm_of_nonneg hinv_nonneg]
    field_simp [hTne]
  have hq' :
      ‖y‖ ^ 2 / (T.1 : Real) ^ 2 >
        lambda * P.sigma ^ 2 / T.1 := by
    simpa [y, hnormavg] using hq
  have htarget : ‖y‖ ^ 2 > lambda * ((T.1 : Real) * P.sigma ^ 2) := by
    have hT2pos : 0 < (T.1 : Real) ^ 2 := sq_pos_of_ne_zero hTne
    have hmul := mul_lt_mul_of_pos_right hq' hT2pos
    field_simp [hTne] at hmul
    nlinarith
  simpa [y, hsum_sigma, mul_assoc, mul_left_comm, mul_comm] using htarget

theorem selected_candidate_tail_bound
    (P : Setup n Sample) (hA : Assumption13 P) :
    SelectedCandidateTailStatement P := by
  intro S N T lambda hlambda
  unfold SelectedCandidateTailSourceBoundary
  constructor
  · simp [SourceBoundaryObstruction]
  · intro hSel hS hN hT
    let Np : RSGDHorizon P := ⟨N, hN⟩
    let Tp : ValidationCount := ⟨T, hT⟩
    have htail :=
      selected_validation_tail_of_bridge P S Np Tp lambda hSel hS hlambda
    have hset :
        {q |
          selectedCandidateValidationErrorSq P S Np Tp hS q >
            lambda * P.sigma ^ 2 / T} =
        {q |
          ‖((Tp.1 : Real)⁻¹) •
              Finset.sum (Finset.Icc 1 Tp.1)
                (fun k => selectedValidationResidual P S Np Tp hS k q)‖ ^ 2 >
            lambda * P.sigma ^ 2 / Tp.1} := by
      ext q
      change
        (selectedCandidateValidationErrorSq P S Np Tp hS q >
            lambda * P.sigma ^ 2 / T) ↔
          (‖((Tp.1 : Real)⁻¹) •
              Finset.sum (Finset.Icc 1 Tp.1)
                (fun k => selectedValidationResidual P S Np Tp hS k q)‖ ^ 2 >
            lambda * P.sigma ^ 2 / Tp.1)
      rw [selectedCandidateValidationErrorSq_eq_selected_residual_average]
    simpa [Np, Tp] using (by
      rw [hset]
      simpa [one_div] using htail)

/-- Realized deterministic selector decomposition after the candidate list,
empirical gradients, and selector have been instantiated on source-valid
domains.
-/
def SelectorDecompositionRealizedStatement (P : Setup n Sample) : Prop :=
  forall (S N T : Nat) (hS : 0 < S) (hN : StoppingLawAdmissible P N)
    (hT : ValidationCountAdmissible T)
    (R : Fin S -> Fin N) (q : TwoPhaseSamplePath Sample S),
    letI : Nonempty (Fin S) := Fin.pos_iff_nonempty.mp hS
    ;
      ‖trueGradient P (selectedCandidate P S ⟨N, hN⟩ ⟨T, hT⟩ hS R q)‖ ^ 2 <=
        4 *
          (Finset.univ.inf'
            (Finset.univ_nonempty)
            (fun s : Fin S =>
              ‖trueGradient P (optimizationCandidate P S ⟨N, hN⟩ R s q.1)‖ ^ 2)) +
        4 *
          (Finset.univ.sup'
            (Finset.univ_nonempty)
            (fun s : Fin S =>
              ‖candidateEmpiricalGradient P S ⟨N, hN⟩ ⟨T, hT⟩ R s q -
                trueGradient P (optimizationCandidate P S ⟨N, hN⟩ R s q.1)‖ ^ 2)) +
        2 *
          ‖candidateEmpiricalGradient P S ⟨N, hN⟩ ⟨T, hT⟩ R
              (selectedRun P S ⟨N, hN⟩ ⟨T, hT⟩ hS R q) q -
            trueGradient P (selectedCandidate P S ⟨N, hN⟩ ⟨T, hT⟩ hS R q)‖ ^ 2

/-- Deterministic selector decomposition Eq. (6.1.36), stated over raw source
parameters with the realization obligations exposed inside the boundary.
-/
def SelectorDecompositionSourceBoundary
    (P : Setup n Sample) (S N T : Nat) : Prop :=
  SourceBoundaryObstruction P "Eq. (6.1.36) selector decomposition"
    ["the source formula assumes a nonempty candidate list s = 1,...,S",
      "the Lean selected-output object is realized only after the RSGD stopping PMF is admissible",
      "the empirical-gradient selector is source-defined only after T >= 1"] /\
    forall (hS : 0 < S) (hN : StoppingLawAdmissible P N)
      (hT : ValidationCountAdmissible T)
      (R : Fin S -> Fin N) (q : TwoPhaseSamplePath Sample S),
      letI : Nonempty (Fin S) := Fin.pos_iff_nonempty.mp hS
      ;
        ‖trueGradient P (selectedCandidate P S ⟨N, hN⟩ ⟨T, hT⟩ hS R q)‖ ^ 2 <=
          4 *
            (Finset.univ.inf'
              (Finset.univ_nonempty)
              (fun s : Fin S =>
                ‖trueGradient P (optimizationCandidate P S ⟨N, hN⟩ R s q.1)‖ ^ 2)) +
          4 *
            (Finset.univ.sup'
              (Finset.univ_nonempty)
              (fun s : Fin S =>
                ‖candidateEmpiricalGradient P S ⟨N, hN⟩ ⟨T, hT⟩ R s q -
                  trueGradient P (optimizationCandidate P S ⟨N, hN⟩ R s q.1)‖ ^ 2)) +
          2 *
            ‖candidateEmpiricalGradient P S ⟨N, hN⟩ ⟨T, hT⟩ R
                (selectedRun P S ⟨N, hN⟩ ⟨T, hT⟩ hS R q) q -
              trueGradient P (selectedCandidate P S ⟨N, hN⟩ ⟨T, hT⟩ hS R q)‖ ^ 2

def SelectorDecompositionStatement (P : Setup n Sample) : Prop :=
  forall (S N T : Nat), SelectorDecompositionSourceBoundary P S N T

theorem Selector_decomposition (P : Setup n Sample) :
    SelectorDecompositionStatement P := by
  intro S N T
  unfold SelectorDecompositionSourceBoundary
  constructor
  · simp [SourceBoundaryObstruction]
  · intro hS hN hT R q
    classical
    letI : Nonempty (Fin S) := Fin.pos_iff_nonempty.mp hS
    let Np : RSGDHorizon P := ⟨N, hN⟩
    let Tp : ValidationCount := ⟨T, hT⟩
    let G : Fin S -> State n :=
      fun s => candidateEmpiricalGradient P S Np Tp R s q
    let target : Fin S -> State n :=
      fun s => trueGradient P (optimizationCandidate P S Np R s q.1)
    let i : Fin S := selectedRun P S Np Tp hS R q
    have hmin : ∀ s : Fin S, ‖G i‖ <= ‖G s‖ := by
      intro s
      simpa [G, i, Np, Tp] using selectedRun_minimal P S Np Tp hS R q s
    simpa [G, target, i, Np, Tp, selectedCandidate] using
      SOptLib.norm_sq_target_selected_le_four_inf_add_four_sup_error_add_two_selected_error
        (G := G) (target := target) (i := i) hmin

/-- Threshold in Theorem 6.2(a), defined on the source-valid validation-count
domain of Eq. (6.1.29).
-/
noncomputable def theorem62PartAThreshold
    (P : Setup n Sample) (N : Nat) (T : ValidationCount)
    (lambda : Real) : Real :=
  2 * (4 * P.L * stationarityBudgetFormula P N +
    3 * lambda * P.sigma ^ 2 / T.1)

theorem theorem62PartAThreshold_eq_source_formula
    (P : Setup n Sample) (N : Nat) (T : ValidationCount) (lambda : Real) :
    theorem62PartAThreshold P N T lambda =
      2 * (4 * P.L * stationarityBudgetFormula P N +
        3 * lambda * P.sigma ^ 2 / T.1) := by
  rfl

/-- Explicit boundary marker for the paper's original Theorem 6.2(a).

The printed theorem is over the 2-RSGD method and raw parameters `(S,N,T)`;
the PDF does not define the zero-denominator branches of (6.1.21)/(6.1.29) or
the random-query martingale bridge needed by the proof.  The realized
nondegenerate inequality is therefore exposed only through the corrected
bridge-gated endpoint below, not hidden in this paper-facing marker.
-/
def Theorem62PartASourceBoundary
    (P : Setup n Sample) (S N T : Nat) (lambda : Real) : Prop :=
  SourceBoundaryObstruction P "Theorem 6.2(a) / Eq. (6.1.31)"
    ["printed parameter counts may be zero under sigma = 0 and D_f = 0",
      "post-optimization fixed-candidate martingale prerequisites are not printed",
      "selected-index martingale prerequisites are not printed",
      "one-run Markov input depends on the unresolved RSGD conditional-oracle bridge",
      "validation and selected-output realized tails are strict because the printed non-strict zero-threshold event is false at zero variance"] /\
    (ConditionalRandomQueryOracleBridge P ->
      PostOptimizationFixedCandidateMartingaleBridge P S N T ->
        SelectedCandidateValidationMartingaleBridge P S N T ->
          forall (hS : 0 < S) (hN : StoppingLawAdmissible P N)
            (hT : ValidationCountAdmissible T),
            twoRSGDSelectedGradientTailProbability P S N T hS hN hT
                (theorem62PartAThreshold P N ⟨T, hT⟩ lambda) <=
              ENNReal.ofReal
                (((S + 1 : Nat) : Real) / lambda + ((2 : Real) ^ S)⁻¹))

def Theorem62PartAStatement (P : Setup n Sample) : Prop :=
  forall (S N T : Nat) (lambda : Real), 0 < lambda ->
    Theorem62PartASourceBoundary P S N T lambda

/-- Paper-facing `(epsilon, Lambda)` success marker for Theorem 6.2(b).

The realized probability statement for the parameter choices is stated in
`TwoRSGDComputesEpsilonLambdaSolutionRealized` after separate admissibility
proofs have supplied positive `S`, admissible `N`, and positive `T`.
-/
def TwoRSGDComputesEpsilonLambdaSolution
    (P : Setup n Sample) (epsilon : Accuracy) (Lambda : Confidence) : Prop :=
  SourceBoundaryObstruction P "Theorem 6.2(b) / Eqs. (6.1.32)-(6.1.35)"
    ["S(epsilon,Lambda), N(epsilon), and T(epsilon,Lambda) require separate positivity/admissibility proofs",
      "the part-(a) probability bound used to certify an (epsilon,Lambda)-solution remains source-boundary blocked",
      "the realized selected-output tail is strict to avoid the false non-strict zero-threshold branch"] /\
    (ConditionalRandomQueryOracleBridge P ->
      PostOptimizationFixedCandidateMartingaleBridge P
        (runCount Lambda) (iterationCount P epsilon)
        (validationCount P (runCount Lambda) epsilon Lambda) ->
      SelectedCandidateValidationMartingaleBridge P
        (runCount Lambda) (iterationCount P epsilon)
        (validationCount P (runCount Lambda) epsilon Lambda) ->
      forall (hS : 0 < runCount Lambda)
        (hN : StoppingLawAdmissible P (iterationCount P epsilon))
        (hT : ValidationCountAdmissible
          (validationCount P (runCount Lambda) epsilon Lambda)),
          twoRSGDSelectedGradientTailProbability P
              (runCount Lambda) (iterationCount P epsilon)
              (validationCount P (runCount Lambda) epsilon Lambda)
              hS hN hT epsilon.1 <= ENNReal.ofReal Lambda.1)

def TwoRSGDComputesEpsilonLambdaSolutionRealized
    (P : Setup n Sample) (epsilon : Accuracy) (Lambda : Confidence)
    (hS : 0 < runCount Lambda)
    (hN : StoppingLawAdmissible P (iterationCount P epsilon))
    (hT : ValidationCountAdmissible
      (validationCount P (runCount Lambda) epsilon Lambda)) : Prop :=
  twoRSGDSelectedGradientTailProbability P
      (runCount Lambda) (iterationCount P epsilon)
      (validationCount P (runCount Lambda) epsilon Lambda)
      hS hN hT epsilon.1 <= ENNReal.ofReal Lambda.1

/-- Theorem 6.2(b), source-facing complexity statement over the printed
parameter choices.  Admissibility of those choices is a proof obligation, not a
theorem-head hypothesis and not a degenerate disjunction.
-/
def Theorem62PartBStatement (P : Setup n Sample) : Prop :=
  forall (epsilon : Accuracy) (Lambda : Confidence),
    TwoRSGDComputesEpsilonLambdaSolution P epsilon Lambda /\
      oracleCallCount (runCount Lambda) (iterationCount P epsilon)
          (validationCount P (runCount Lambda) epsilon Lambda) <=
        runCount Lambda *
          (iterationCount P epsilon +
            validationCount P (runCount Lambda) epsilon Lambda)

def Theorem62Statement (P : Setup n Sample) : Prop :=
  Theorem62PartAStatement P /\ Theorem62PartBStatement P

private theorem theorem62_partA_realized_of_optimization_tail
    (P : Setup n Sample) (hA : Assumption13 P)
    (S N T : Nat) (lambda : Real) (hlambda : 0 < lambda)
    (hPost : PostOptimizationFixedCandidateMartingaleBridge P S N T)
    (hSel : SelectedCandidateValidationMartingaleBridge P S N T)
    (hS : 0 < S) (hN : StoppingLawAdmissible P N)
    (hT : ValidationCountAdmissible T)
    (hOpt :
      letI : Nonempty (Fin S) := Fin.pos_iff_nonempty.mp hS
      (twoPhaseStoppingSampleMeasure P S ⟨N, hN⟩)
            {q |
              (Finset.univ.inf'
                  (Finset.univ_nonempty)
                  (fun s : Fin S =>
                    ‖trueGradient P
                      (optimizationCandidate P S ⟨N, hN⟩ q.1 s q.2.1)‖ ^ 2)) >=
                2 * P.L * stationarityBudgetFormula P N} <=
          ENNReal.ofReal (((2 : Real) ^ S)⁻¹)) :
    twoRSGDSelectedGradientTailProbability P S N T hS hN hT
        (theorem62PartAThreshold P N ⟨T, hT⟩ lambda) <=
      ENNReal.ofReal
        (((S + 1 : Nat) : Real) / lambda + ((2 : Real) ^ S)⁻¹) := by
  classical
  letI : Nonempty (Fin S) := Fin.pos_iff_nonempty.mp hS
  let Np : RSGDHorizon P := ⟨N, hN⟩
  let Tp : ValidationCount := ⟨T, hT⟩
  let d : Real := P.L * stationarityBudgetFormula P N
  let e : Real := lambda * P.sigma ^ 2 / T
  have htail :
      (twoPhaseStoppingSampleMeasure P S Np)
        {q |
          ‖trueGradient P (twoPhaseOutputOnJoint P S Np Tp hS q)‖ ^ 2 >
            2 * (4 * d + 3 * e)} <=
        ENNReal.ofReal
          (((S + 1 : Nat) : Real) / lambda + ((2 : Real) ^ S)⁻¹) := by
    exact
      measure_selected_tail_le_of_three_component_tails
        (μ := twoPhaseStoppingSampleMeasure P S Np)
        (selected := fun q =>
          ‖trueGradient P (twoPhaseOutputOnJoint P S Np Tp hS q)‖ ^ 2)
        (primary := fun q =>
          Finset.univ.inf'
            (Finset.univ_nonempty)
            (fun s : Fin S =>
              ‖trueGradient P
                (optimizationCandidate P S Np q.1 s q.2.1)‖ ^ 2))
        (secondary := fun q =>
          Finset.univ.sup'
            (Finset.univ_nonempty)
            (fun s : Fin S =>
              candidateValidationErrorSq P S Np Tp q.1 s q.2))
        (tertiary := fun q =>
          selectedCandidateValidationErrorSq P S Np Tp hS q)
        (d := d) (e := e)
        (Bprimary := ((2 : Real) ^ S)⁻¹)
        (Bsecondary := ((S : Nat) : Real) / lambda)
        (Btertiary := 1 / lambda)
        (final := ((S + 1 : Nat) : Real) / lambda + ((2 : Real) ^ S)⁻¹)
        (by exact inv_nonneg.mpr (pow_nonneg (by norm_num) S))
        (by exact div_nonneg (Nat.cast_nonneg S) (le_of_lt hlambda))
        (by exact div_nonneg zero_le_one (le_of_lt hlambda))
        (by
          intro q
          have hdecomp :=
            (Selector_decomposition P S N T).2 hS hN hT q.1 q.2
          simpa [twoPhaseOutputOnJoint, twoPhaseOutput,
            selectedCandidateValidationErrorSq, candidateValidationErrorSq,
            Np, Tp] using hdecomp)
        (by
          simpa [Np, d, mul_assoc] using hOpt)
        (by
          have h :=
            (fixed_candidate_tail_bound P hA S N T lambda hlambda).2
              hPost hS hN hT
          simpa [Np, Tp, e] using h)
        (by
          have h :=
            (selected_candidate_tail_bound P hA S N T lambda hlambda).2
              hSel hS hN hT
          simpa [Np, Tp, e] using h)
        (by
          norm_num [Nat.cast_add]
          ring_nf
          exact le_rfl)
  have hthreshold :
      theorem62PartAThreshold P N Tp lambda = 2 * (4 * d + 3 * e) := by
    simp [theorem62PartAThreshold, d, e, Tp]
    ring
  simpa [twoRSGDSelectedGradientTailProbability, Np, Tp, hthreshold] using htail

private theorem optimization_coordinate_tail_measure
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (s : Fin S) (r : Fin N.1) (tau : Real) :
    optimizationSampleLaw P S
        {omega : OptimizationSamplePath Sample S |
          ‖trueGradient P (rsgdRunOutput P N (omega s) r)‖ ^ 2 >= tau} =
      P.sampleLaw
        {xi : SamplePath Sample |
          ‖trueGradient P (rsgdRunOutput P N xi r)‖ ^ 2 >= tau} := by
  classical
  let C : Set (SamplePath Sample) :=
    {xi | ‖trueGradient P (rsgdRunOutput P N xi r)‖ ^ 2 >= tau}
  have hC : MeasurableSet C := by
    have hout : Measurable (fun xi : SamplePath Sample => rsgdRunOutput P N xi r) :=
      rsgdRunOutput_measurable P N r
    have hgrad :
        Measurable
          (fun xi : SamplePath Sample =>
            trueGradient P (rsgdRunOutput P N xi r)) :=
      (trueGradient_measurable P).comp hout
    have hnorm :
        Measurable
          (fun xi : SamplePath Sample =>
            ‖trueGradient P (rsgdRunOutput P N xi r)‖) :=
      measurable_norm.comp hgrad
    have hsquare :
        Measurable
          (fun xi : SamplePath Sample =>
            ‖trueGradient P (rsgdRunOutput P N xi r)‖ ^ 2) :=
      hnorm.pow_const 2
    simpa [C, ge_iff_le] using
      (measurableSet_le measurable_const hsquare :
        MeasurableSet
          {xi : SamplePath Sample |
            (fun _ => tau) xi <=
              ‖trueGradient P (rsgdRunOutput P N xi r)‖ ^ 2})
  haveI : ∀ i : Fin S, IsProbabilityMeasure ((fun _ : Fin S => P.sampleLaw) i) :=
    fun _ => P.sampleLaw_isProbability
  have hmp :
      MeasurePreserving (Function.eval s)
        (Measure.pi (fun _ : Fin S => P.sampleLaw)) P.sampleLaw :=
    @MeasureTheory.measurePreserving_eval
      (Fin S) (fun _ : Fin S => SamplePath Sample)
      inferInstance (fun _ : Fin S => inferInstance)
      (fun _ : Fin S => P.sampleLaw)
      (fun _ : Fin S => P.sampleLaw_isProbability) s
  have hpre :
      (Function.eval s) ⁻¹' C =
        {omega : OptimizationSamplePath Sample S |
          ‖trueGradient P (rsgdRunOutput P N (omega s) r)‖ ^ 2 >= tau} := by
    rfl
  calc
    optimizationSampleLaw P S
        {omega : OptimizationSamplePath Sample S |
          ‖trueGradient P (rsgdRunOutput P N (omega s) r)‖ ^ 2 >= tau}
        = Measure.pi (fun _ : Fin S => P.sampleLaw) ((Function.eval s) ⁻¹' C) := by
            simp [optimizationSampleLaw, C, hpre]
    _ = P.sampleLaw C := hmp.measure_preimage hC.nullMeasurableSet
    _ = P.sampleLaw
        {xi : SamplePath Sample |
          ‖trueGradient P (rsgdRunOutput P N xi r)‖ ^ 2 >= tau} := rfl

private theorem optimization_all_runs_tail_fiber_product
    (P : Setup n Sample) (S : Nat) (N : RSGDHorizon P)
    (R : Fin S -> Fin N.1) (tau : Real) :
    optimizationSampleLaw P S
        {omega : OptimizationSamplePath Sample S |
          ∀ s : Fin S,
            ‖trueGradient P (optimizationCandidate P S N R s omega)‖ ^ 2 >= tau} =
      ∏ s : Fin S,
        P.sampleLaw
          {xi : SamplePath Sample |
            ‖trueGradient P (rsgdRunOutput P N xi (R s))‖ ^ 2 >= tau} := by
  classical
  let C : Fin S -> Set (SamplePath Sample) :=
    fun s =>
      {xi | ‖trueGradient P (rsgdRunOutput P N xi (R s))‖ ^ 2 >= tau}
  have hset :
      {omega : OptimizationSamplePath Sample S |
          ∀ s : Fin S,
            ‖trueGradient P (optimizationCandidate P S N R s omega)‖ ^ 2 >= tau} =
        Set.pi Set.univ C := by
    ext omega
    simp [C, optimizationCandidate]
  haveI : ∀ _ : Fin S, IsProbabilityMeasure P.sampleLaw :=
    fun _ => P.sampleLaw_isProbability
  calc
    optimizationSampleLaw P S
        {omega : OptimizationSamplePath Sample S |
          ∀ s : Fin S,
            ‖trueGradient P (optimizationCandidate P S N R s omega)‖ ^ 2 >= tau}
        = Measure.pi (fun _ : Fin S => P.sampleLaw) (Set.pi Set.univ C) := by
            rw [hset]
            rfl
    _ = ∏ s : Fin S, P.sampleLaw (C s) := by
            simpa using
              (Measure.pi_pi (fun _ : Fin S => P.sampleLaw) C)
    _ = ∏ s : Fin S,
        P.sampleLaw
          {xi : SamplePath Sample |
            ‖trueGradient P (rsgdRunOutput P N xi (R s))‖ ^ 2 >= tau} := rfl

private theorem optimization_min_tail_bound_of_one_run_markov
    (P : Setup n Sample) (hA : Assumption13 P)
    (S N : Nat) (hCond : ConditionalRandomQueryOracleBridge P)
    (hS : 0 < S) (hN : StoppingLawAdmissible P N) :
    letI : Nonempty (Fin S) := Fin.pos_iff_nonempty.mp hS
    (twoPhaseStoppingSampleMeasure P S ⟨N, hN⟩)
          {q |
            (Finset.univ.inf'
                (Finset.univ_nonempty)
                (fun s : Fin S =>
                  ‖trueGradient P
                    (optimizationCandidate P S ⟨N, hN⟩ q.1 s q.2.1)‖ ^ 2)) >=
              2 * P.L * stationarityBudgetFormula P N} <=
        ENNReal.ofReal (((2 : Real) ^ S)⁻¹) := by
  classical
  letI : Nonempty (Fin S) := Fin.pos_iff_nonempty.mp hS
  have hOne :
      rsgdOutputGradientTailProbability P ⟨N, hN⟩
          (2 * P.L * stationarityBudgetFormula P N) <=
        ENNReal.ofReal (1 / (2 : Real)) := by
    exact
      (One_run_Markov_tail_bound P hA N hN.1.1 2 (by norm_num)).2
        hCond hN
  -- Remaining Eq. (6.1.37) work: factor the all-runs minimum event through
  -- the stopping-vector PMF and the finite product optimization sample law,
  -- then raise the one-run Markov tail `hOne` to the `S`-fold product.
  let Np : RSGDHorizon P := ⟨N, hN⟩
  let tau : Real := 2 * P.L * stationarityBudgetFormula P N
  let A : (Fin S -> Fin Np.1) -> Set (OptimizationSamplePath Sample S) :=
    fun R =>
      {omega | ∀ s : Fin S,
        ‖trueGradient P (optimizationCandidate P S Np R s omega)‖ ^ 2 >= tau}
  let B : Fin S -> Fin Np.1 -> Set (OptimizationSamplePath Sample S) :=
    fun s r =>
      {omega | ‖trueGradient P (rsgdRunOutput P Np (omega s) r)‖ ^ 2 >= tau}
  let Pone : Fin S -> ENNReal :=
    fun _ => rsgdOutputGradientTailProbability P Np tau
  letI : IsProbabilityMeasure (optimizationSampleLaw P S) :=
    optimizationSampleLaw_isProbability P S
  letI : IsProbabilityMeasure P.sampleLaw := P.sampleLaw_isProbability
  have hq : ∀ R : Fin S -> Fin Np.1,
      rsgdStoppingVectorPMF P S Np R =
        ∏ i : Fin S, rsgdStoppingPMF P Np (R i) := by
    intro R
    have hvec :
        rsgdStoppingVectorPMF P S Np R =
          ENNReal.ofReal (∏ i : Fin S, stoppingMass P Np (R i)) := by
      simpa [rsgdStoppingVectorPMF, stoppingVectorMass,
        SOptLib.stoppingVectorWeight] using
        (SOptLib.stoppingVectorPMF_apply_eq_product
          (p := stoppingMass P Np)
          (w := stoppingVectorMass P S Np)
          (hw := by intro R; rfl)
          (hp_nonneg := stoppingMass_nonneg P Np)
          (hp_sum := by
            rw [← ENNReal.ofReal_one, ← stoppingMass_sum_one P Np]
            exact (ENNReal.ofReal_sum_of_nonneg
              (fun r _ => stoppingMass_nonneg P Np r)).symm)
          R)
    calc
      rsgdStoppingVectorPMF P S Np R =
          ENNReal.ofReal (∏ i : Fin S, stoppingMass P Np (R i)) := hvec
      _ = ∏ i : Fin S, rsgdStoppingPMF P Np (R i) := by
          rw [ENNReal.ofReal_prod_of_nonneg]
          · simp [rsgdStoppingPMF_apply]
          · intro i _hi
            exact stoppingMass_nonneg P Np (R i)
  have hfiber : ∀ R : Fin S -> Fin Np.1,
      optimizationSampleLaw P S (A R) =
        ∏ i : Fin S, optimizationSampleLaw P S (B i (R i)) := by
    intro R
    calc
      optimizationSampleLaw P S (A R) =
          ∏ i : Fin S,
            P.sampleLaw
              {xi : SamplePath Sample |
                ‖trueGradient P (rsgdRunOutput P Np xi (R i))‖ ^ 2 >= tau} := by
            simpa [A, tau] using
              optimization_all_runs_tail_fiber_product P S Np R tau
      _ = ∏ i : Fin S, optimizationSampleLaw P S (B i (R i)) := by
            refine Finset.prod_congr rfl ?_
            intro i _hi
            exact (optimization_coordinate_tail_measure P S Np i (R i) tau).symm
  have hPone : ∀ i : Fin S, Pone i =
      ∑ a : Fin Np.1,
        rsgdStoppingPMF P Np a * optimizationSampleLaw P S (B i a) := by
    intro i
    have hcoord :
        ∀ a : Fin Np.1,
          optimizationSampleLaw P S (B i a) =
            P.sampleLaw
              {xi : SamplePath Sample |
                ‖trueGradient P (rsgdRunOutput P Np xi a)‖ ^ 2 >= tau} := by
      intro a
      exact optimization_coordinate_tail_measure P S Np i a tau
    calc
      Pone i = rsgdOutputGradientTailProbability P Np tau := rfl
      _ = ∑ a : Fin Np.1,
            rsgdStoppingPMF P Np a *
              P.sampleLaw
                {xi : SamplePath Sample |
                  ‖trueGradient P (rsgdRunOutput P Np xi a)‖ ^ 2 >= tau} := by
            simpa [rsgdOutputGradientTailProbability, rsgdStoppingSampleMeasure,
              rsgdOutputGradientSq, tau] using
              (PMF.prod_measure_set_sigma_eq_sum
                (rsgdStoppingPMF P Np) P.sampleLaw
                (fun a : Fin Np.1 =>
                  {xi : SamplePath Sample |
                    ‖trueGradient P (rsgdRunOutput P Np xi a)‖ ^ 2 >= tau}))
      _ = ∑ a : Fin Np.1,
            rsgdStoppingPMF P Np a * optimizationSampleLaw P S (B i a) := by
            refine Finset.sum_congr rfl ?_
            intro a _ha
            rw [hcoord a]
  have htwo_to_opt :
      (twoPhaseStoppingSampleMeasure P S Np)
          {q : (Fin S -> Fin Np.1) × TwoPhaseSamplePath Sample S |
            q.2.1 ∈ A q.1} =
        ((rsgdStoppingVectorPMF P S Np).toMeasure.prod (optimizationSampleLaw P S))
          {x : (Fin S -> Fin Np.1) × OptimizationSamplePath Sample S |
            x.2 ∈ A x.1} := by
    have hsum_two :
        (twoPhaseStoppingSampleMeasure P S Np)
            {q : (Fin S -> Fin Np.1) × TwoPhaseSamplePath Sample S |
              q.2.1 ∈ A q.1} =
          ∑ R : Fin S -> Fin Np.1,
            (rsgdStoppingVectorPMF P S Np) R *
              ((optimizationSampleLaw P S).prod P.sampleLaw)
                {q : TwoPhaseSamplePath Sample S | q.1 ∈ A R} := by
      simpa [twoPhaseStoppingSampleMeasure] using
        (PMF.prod_measure_set_sigma_eq_sum
          (rsgdStoppingVectorPMF P S Np)
          ((optimizationSampleLaw P S).prod P.sampleLaw)
          (fun R : Fin S -> Fin Np.1 =>
            {q : TwoPhaseSamplePath Sample S | q.1 ∈ A R}))
    have hsum_opt :
        ((rsgdStoppingVectorPMF P S Np).toMeasure.prod (optimizationSampleLaw P S))
            {x : (Fin S -> Fin Np.1) × OptimizationSamplePath Sample S |
              x.2 ∈ A x.1} =
          ∑ R : Fin S -> Fin Np.1,
            (rsgdStoppingVectorPMF P S Np) R *
              optimizationSampleLaw P S (A R) := by
      exact
        PMF.prod_measure_set_sigma_eq_sum
          (rsgdStoppingVectorPMF P S Np)
          (optimizationSampleLaw P S) A
    have hfiber_val :
        ∀ R : Fin S -> Fin Np.1,
          ((optimizationSampleLaw P S).prod P.sampleLaw)
              {q : TwoPhaseSamplePath Sample S | q.1 ∈ A R} =
            optimizationSampleLaw P S (A R) := by
      intro R
      have hrect :
          {q : TwoPhaseSamplePath Sample S | q.1 ∈ A R} =
            (A R) ×ˢ (Set.univ : Set (SamplePath Sample)) := by
        ext q
        simp
      rw [hrect, Measure.prod_prod, measure_univ, mul_one]
    calc
      (twoPhaseStoppingSampleMeasure P S Np)
          {q : (Fin S -> Fin Np.1) × TwoPhaseSamplePath Sample S |
            q.2.1 ∈ A q.1}
          = ∑ R : Fin S -> Fin Np.1,
              (rsgdStoppingVectorPMF P S Np) R *
                ((optimizationSampleLaw P S).prod P.sampleLaw)
                  {q : TwoPhaseSamplePath Sample S | q.1 ∈ A R} := hsum_two
      _ = ∑ R : Fin S -> Fin Np.1,
              (rsgdStoppingVectorPMF P S Np) R *
                optimizationSampleLaw P S (A R) := by
            refine Finset.sum_congr rfl ?_
            intro R _hR
            rw [hfiber_val R]
      _ = ((rsgdStoppingVectorPMF P S Np).toMeasure.prod (optimizationSampleLaw P S))
          {x : (Fin S -> Fin Np.1) × OptimizationSamplePath Sample S |
            x.2 ∈ A x.1} := hsum_opt.symm
  have hmain_eq :
      (twoPhaseStoppingSampleMeasure P S Np)
          {q |
            (Finset.univ.inf'
                (Finset.univ_nonempty)
                (fun s : Fin S =>
                  ‖trueGradient P
                    (optimizationCandidate P S Np q.1 s q.2.1)‖ ^ 2)) >= tau} =
        (twoPhaseStoppingSampleMeasure P S Np)
          {q : (Fin S -> Fin Np.1) × TwoPhaseSamplePath Sample S |
            q.2.1 ∈ A q.1} := by
    apply congrArg
    ext q
    simp [A, tau, Finset.le_inf'_iff]
  have hall_tail_bound :
      ((rsgdStoppingVectorPMF P S Np).toMeasure.prod (optimizationSampleLaw P S))
          {x : (Fin S -> Fin Np.1) × OptimizationSamplePath Sample S |
            x.2 ∈ A x.1} <=
        ENNReal.ofReal (((2 : Real) ^ S)⁻¹) := by
    have hpow :
        ((rsgdStoppingVectorPMF P S Np).toMeasure.prod (optimizationSampleLaw P S))
            {x : (Fin S -> Fin Np.1) × OptimizationSamplePath Sample S |
              x.2 ∈ A x.1} <=
          (ENNReal.ofReal (1 / (2 : Real))) ^ Fintype.card (Fin S) := by
      exact
        pi_stopping_all_tail_le_const_pow_of_one_tail_bound
          (p := rsgdStoppingPMF P Np)
          (q := rsgdStoppingVectorPMF P S Np)
          (μ := optimizationSampleLaw P S)
          (A := A) (B := B)
          (c := ENNReal.ofReal (1 / (2 : Real)))
          hq hfiber
          (by
            intro i
            calc
              (∑ a : Fin Np.1,
                  rsgdStoppingPMF P Np a * optimizationSampleLaw P S (B i a))
                  = Pone i := (hPone i).symm
              _ <= ENNReal.ofReal (1 / (2 : Real)) := by
                  simpa [Pone, tau, Np] using hOne)
    calc
      ((rsgdStoppingVectorPMF P S Np).toMeasure.prod (optimizationSampleLaw P S))
          {x : (Fin S -> Fin Np.1) × OptimizationSamplePath Sample S |
            x.2 ∈ A x.1}
          <= (ENNReal.ofReal (1 / (2 : Real))) ^ Fintype.card (Fin S) := hpow
      _ = ENNReal.ofReal (((2 : Real) ^ S)⁻¹) := by
          have hhalf_nonneg : 0 <= (1 / (2 : Real)) := by norm_num
          rw [Fintype.card_fin]
          change (ENNReal.ofReal (1 / (2 : Real))) ^ S =
            ENNReal.ofReal (((2 : Real) ^ S)⁻¹)
          rw [← ENNReal.ofReal_pow hhalf_nonneg]
          congr 1
          rw [one_div, inv_pow]
  calc
    (twoPhaseStoppingSampleMeasure P S ⟨N, hN⟩)
          {q |
            (Finset.univ.inf'
                (Finset.univ_nonempty)
                (fun s : Fin S =>
                  ‖trueGradient P
                    (optimizationCandidate P S ⟨N, hN⟩ q.1 s q.2.1)‖ ^ 2)) >=
              2 * P.L * stationarityBudgetFormula P N}
        = (twoPhaseStoppingSampleMeasure P S Np)
          {q |
            (Finset.univ.inf'
                (Finset.univ_nonempty)
                (fun s : Fin S =>
                  ‖trueGradient P
                    (optimizationCandidate P S Np q.1 s q.2.1)‖ ^ 2)) >= tau} := by
            rfl
    _ = (twoPhaseStoppingSampleMeasure P S Np)
          {q : (Fin S -> Fin Np.1) × TwoPhaseSamplePath Sample S |
            q.2.1 ∈ A q.1} := hmain_eq
    _ = ((rsgdStoppingVectorPMF P S Np).toMeasure.prod (optimizationSampleLaw P S))
          {x : (Fin S -> Fin Np.1) × OptimizationSamplePath Sample S |
            x.2 ∈ A x.1} := htwo_to_opt
    _ <= ENNReal.ofReal (((2 : Real) ^ S)⁻¹) := hall_tail_bound

private theorem theorem62_partA_realized_of_bridges
    (P : Setup n Sample) (hA : Assumption13 P)
    (S N T : Nat) (lambda : Real) (hlambda : 0 < lambda)
    (hCond : ConditionalRandomQueryOracleBridge P)
    (hPost : PostOptimizationFixedCandidateMartingaleBridge P S N T)
    (hSel : SelectedCandidateValidationMartingaleBridge P S N T)
    (hS : 0 < S) (hN : StoppingLawAdmissible P N)
    (hT : ValidationCountAdmissible T) :
    twoRSGDSelectedGradientTailProbability P S N T hS hN hT
        (theorem62PartAThreshold P N ⟨T, hT⟩ lambda) <=
      ENNReal.ofReal
        (((S + 1 : Nat) : Real) / lambda + ((2 : Real) ^ S)⁻¹) := by
  classical
  letI : Nonempty (Fin S) := Fin.pos_iff_nonempty.mp hS
  have hOpt :=
    optimization_min_tail_bound_of_one_run_markov
      P hA S N hCond hS hN
  exact
    theorem62_partA_realized_of_optimization_tail
      P hA S N T lambda hlambda hPost hSel hS hN hT hOpt

private theorem theorem62_partB_stationarity_term_le_quarter
    (P : Setup n Sample) (epsilon : Accuracy)
    (hN : StoppingLawAdmissible P (iterationCount P epsilon)) :
    4 * P.L * stationarityBudgetFormula P (iterationCount P epsilon) <=
      epsilon.1 / 4 := by
  simpa [stationarityBudgetFormula, SOptLib.nonconvexStationarityBudgetBound,
    iterationCount] using
    four_mul_smoothness_mul_stationarity_budget_le_quarter_of_iteration_lower_bounds
      P.L (objectiveRadius P)
      (P.dtilde + objectiveRadius P ^ 2 / P.dtilde) P.sigma epsilon.1 P.L_pos
      (add_pos_of_pos_of_nonneg P.dtilde_pos
        (div_nonneg (sq_nonneg (objectiveRadius P))
          (le_of_lt P.dtilde_pos)))
      hN.1.2 epsilon.2

private theorem theorem62_partB_validation_term_le_quarter
    (P : Setup n Sample) (epsilon : Accuracy) (Lambda : Confidence)
    (hT : ValidationCountAdmissible
      (validationCount P (runCount Lambda) epsilon Lambda)) :
    3 * (2 * ((runCount Lambda + 1 : Nat) : Real) / Lambda.1) *
        P.sigma ^ 2 /
        (validationCount P (runCount Lambda) epsilon Lambda : Real) <=
      epsilon.1 / 4 := by
  let T : Nat := validationCount P (runCount Lambda) epsilon Lambda
  let Splus : Real := ((runCount Lambda + 1 : Nat) : Real)
  have hT_nat : 1 <= T := by
    simpa [T] using hT
  have hT_pos_nat : 0 < T := Nat.lt_of_lt_of_le Nat.zero_lt_one hT_nat
  have hT_pos : 0 < (T : Real) := by
    exact_mod_cast hT_pos_nat
  have hT_lower :
      24 * Splus * P.sigma ^ 2 / (Lambda.1 * epsilon.1) <=
        (T : Real) := by
    have h :=
      Nat.le_ceil
        (24 * ((runCount Lambda + 1 : Nat) : Real) * P.sigma ^ 2 /
          (Lambda.1 * epsilon.1))
    simpa [T, Splus, validationCount] using h
  have hhalf :
      6 * (2 * Splus / Lambda.1) * P.sigma ^ 2 / (T : Real) <=
        epsilon.1 / 2 :=
    validation_term_le_half_of_count_choice
      Splus P.sigma (T : Real) epsilon.1 Lambda.1
      epsilon.2 Lambda.2.1 hT_pos hT_lower
  change
    3 * (2 * Splus / Lambda.1) * P.sigma ^ 2 / (T : Real) <=
      epsilon.1 / 4
  calc
    3 * (2 * Splus / Lambda.1) * P.sigma ^ 2 / (T : Real)
        = (1 / 2 : Real) *
            (6 * (2 * Splus / Lambda.1) * P.sigma ^ 2 / (T : Real)) := by
          ring
    _ <= (1 / 2 : Real) * (epsilon.1 / 2) :=
          mul_le_mul_of_nonneg_left hhalf (by norm_num)
    _ = epsilon.1 / 4 := by
          ring

private theorem iterationCount_stoppingLawAdmissible_of_positive_sigma
    (P : Setup n Sample) (epsilon : Accuracy) (hsigma : 0 < P.sigma) :
    StoppingLawAdmissible P (iterationCount P epsilon) := by
  let D : Real := objectiveRadius P
  let C : Real := P.dtilde + D ^ 2 / P.dtilde
  have hC_pos : 0 < C := by
    dsimp [C, D]
    exact add_pos_of_pos_of_nonneg P.dtilde_pos
      (div_nonneg (sq_nonneg (objectiveRadius P)) (le_of_lt P.dtilde_pos))
  have hchoice_pos :
      0 < 32 * P.L * C * P.sigma / epsilon.1 := by
    exact div_pos
      (mul_pos (mul_pos (mul_pos (by norm_num : (0 : Real) < 32) P.L_pos)
        hC_pos) hsigma)
      epsilon.2
  have hmax_pos :
      0 <
        max (32 * P.L ^ 2 * D ^ 2 / epsilon.1)
          (32 * P.L * C * P.sigma / epsilon.1) :=
    lt_of_lt_of_le hchoice_pos (le_max_right _ _)
  have hcount_pos : 0 < iterationCount P epsilon := by
    rw [iterationCount]
    exact Nat.ceil_pos.mpr (sq_pos_of_pos hmax_pos)
  exact stoppingLawAdmissible_of_positive_sigma P
    (iterationCount P epsilon) hcount_pos hsigma

private theorem validationCount_admissible_of_positive_sigma
    (P : Setup n Sample) (epsilon : Accuracy) (Lambda : Confidence)
    (hsigma : 0 < P.sigma) :
    ValidationCountAdmissible
      (validationCount P (runCount Lambda) epsilon Lambda) := by
  unfold ValidationCountAdmissible
  have hSplus_pos :
      0 < ((runCount Lambda : Real) + 1) :=
    add_pos_of_nonneg_of_pos (Nat.cast_nonneg _) zero_lt_one
  have hsigma_sq_pos : 0 < P.sigma ^ 2 := sq_pos_of_pos hsigma
  have hden_pos : 0 < Lambda.1 * epsilon.1 :=
    mul_pos Lambda.2.1 epsilon.2
  have hratio_pos :
      0 <
        24 * ((runCount Lambda : Real) + 1) *
          P.sigma ^ 2 / (Lambda.1 * epsilon.1) := by
    exact div_pos
      (mul_pos (mul_pos (by norm_num : (0 : Real) < 24) hSplus_pos)
        hsigma_sq_pos)
      hden_pos
  rw [validationCount]
  exact Nat.ceil_pos.mpr hratio_pos

/-- Corrected direct B-track Theorem 6.2 endpoint.

The source-facing boundary statements above document why the printed theorem is
not used as a wrapper.  This endpoint exposes the strict selected-output tail
for raw source-valid `(S,N,T)` parameters and, for the generated choices
`S(epsilon,Lambda)`, `N(epsilon)`, and `T(epsilon,Lambda)`, constructs the
required admissibility witnesses internally from `0 < P.sigma`.
-/
theorem Theorem_6_2
    (P : Setup n Sample) (hA : Assumption13 P) (hsigma : 0 < P.sigma) :
    (forall (S N T : Nat) (lambda : Real), 0 < lambda ->
      ConditionalRandomQueryOracleBridge P ->
      PostOptimizationFixedCandidateMartingaleBridge P S N T ->
      SelectedCandidateValidationMartingaleBridge P S N T ->
      forall (hS : 0 < S) (hN : StoppingLawAdmissible P N)
        (hT : ValidationCountAdmissible T),
        twoRSGDSelectedGradientTailProbability P S N T hS hN hT
            (theorem62PartAThreshold P N ⟨T, hT⟩ lambda) <=
          ENNReal.ofReal
            (((S + 1 : Nat) : Real) / lambda + ((2 : Real) ^ S)⁻¹)) /\
    (forall (epsilon : Accuracy) (Lambda : Confidence),
      ConditionalRandomQueryOracleBridge P ->
      PostOptimizationFixedCandidateMartingaleBridge P
        (runCount Lambda) (iterationCount P epsilon)
        (validationCount P (runCount Lambda) epsilon Lambda) ->
      SelectedCandidateValidationMartingaleBridge P
        (runCount Lambda) (iterationCount P epsilon)
        (validationCount P (runCount Lambda) epsilon Lambda) ->
        exists hS : 0 < runCount Lambda,
        exists hN : StoppingLawAdmissible P (iterationCount P epsilon),
        exists hT : ValidationCountAdmissible
            (validationCount P (runCount Lambda) epsilon Lambda),
          twoRSGDSelectedGradientTailProbability P
              (runCount Lambda) (iterationCount P epsilon)
              (validationCount P (runCount Lambda) epsilon Lambda)
              hS hN hT epsilon.1 <= ENNReal.ofReal Lambda.1 /\
            oracleCallCount (runCount Lambda) (iterationCount P epsilon)
                (validationCount P (runCount Lambda) epsilon Lambda) <=
              runCount Lambda *
                (iterationCount P epsilon +
                  validationCount P (runCount Lambda) epsilon Lambda)) := by
  constructor
  · intro S N T lambda hlambda hCond hPost hSel hS hN hT
    exact
      theorem62_partA_realized_of_bridges
        P hA S N T lambda hlambda hCond hPost hSel hS hN hT
  · intro epsilon Lambda hCond hPost hSel
    let hSlocal : 0 < runCount Lambda := runCount_pos Lambda
    let hNlocal : StoppingLawAdmissible P (iterationCount P epsilon) :=
      iterationCount_stoppingLawAdmissible_of_positive_sigma P epsilon hsigma
    let hTlocal : ValidationCountAdmissible
        (validationCount P (runCount Lambda) epsilon Lambda) :=
      validationCount_admissible_of_positive_sigma P epsilon Lambda hsigma
    refine ⟨hSlocal, hNlocal, hTlocal, ?_, ?_⟩
    · let lambda : Real :=
        2 * ((runCount Lambda + 1 : Nat) : Real) / Lambda.1
      have hlambda : 0 < lambda := by
        have hrun_succ :
            0 < ((runCount Lambda + 1 : Nat) : Real) :=
          Nat.cast_pos.mpr (Nat.succ_pos _)
        exact div_pos
          (mul_pos (by norm_num : (0 : Real) < 2) hrun_succ)
          Lambda.2.1
      have hBridgeBound :
          twoRSGDSelectedGradientTailProbability P
              (runCount Lambda) (iterationCount P epsilon)
              (validationCount P (runCount Lambda) epsilon Lambda)
              hSlocal hNlocal hTlocal
              (theorem62PartAThreshold P (iterationCount P epsilon)
                ⟨validationCount P (runCount Lambda) epsilon Lambda, hTlocal⟩
                lambda) <=
            ENNReal.ofReal
              ((((runCount Lambda + 1 : Nat) : Real) / lambda) +
                ((2 : Real) ^ runCount Lambda)⁻¹) :=
        theorem62_partA_realized_of_bridges
          P hA (runCount Lambda) (iterationCount P epsilon)
          (validationCount P (runCount Lambda) epsilon Lambda)
          lambda hlambda hCond hPost hSel hSlocal hNlocal hTlocal
      have hThreshold :
          theorem62PartAThreshold P (iterationCount P epsilon)
              ⟨validationCount P (runCount Lambda) epsilon Lambda, hTlocal⟩
              lambda <= epsilon.1 := by
        have hStationarity :
            4 * P.L *
                stationarityBudgetFormula P (iterationCount P epsilon) <=
              epsilon.1 / 4 :=
          theorem62_partB_stationarity_term_le_quarter P epsilon hNlocal
        have hValidationBase :
            3 * (2 * ((runCount Lambda + 1 : Nat) : Real) / Lambda.1) *
                P.sigma ^ 2 /
                (validationCount P (runCount Lambda) epsilon Lambda : Real) <=
              epsilon.1 / 4 :=
          theorem62_partB_validation_term_le_quarter P epsilon Lambda hTlocal
        have hValidation :
            3 * lambda * P.sigma ^ 2 /
                (validationCount P (runCount Lambda) epsilon Lambda : Real) <=
              epsilon.1 / 4 := by
          change
            3 *
                  (2 * ((runCount Lambda + 1 : Nat) : Real) /
                    Lambda.1) *
                P.sigma ^ 2 /
                (validationCount P (runCount Lambda) epsilon Lambda : Real) <=
              epsilon.1 / 4
          exact hValidationBase
        unfold theorem62PartAThreshold
        nlinarith [hStationarity, hValidation]
      have hMonotone :
          twoRSGDSelectedGradientTailProbability P
              (runCount Lambda) (iterationCount P epsilon)
              (validationCount P (runCount Lambda) epsilon Lambda)
              hSlocal hNlocal hTlocal epsilon.1 <=
            twoRSGDSelectedGradientTailProbability P
              (runCount Lambda) (iterationCount P epsilon)
              (validationCount P (runCount Lambda) epsilon Lambda)
              hSlocal hNlocal hTlocal
              (theorem62PartAThreshold P (iterationCount P epsilon)
                ⟨validationCount P (runCount Lambda) epsilon Lambda, hTlocal⟩
                lambda) := by
        unfold twoRSGDSelectedGradientTailProbability
        exact measure_mono (by
          intro q hq
          exact lt_of_le_of_lt hThreshold hq)
      have hScalar :
          (((runCount Lambda + 1 : Nat) : Real) / lambda) +
              ((2 : Real) ^ runCount Lambda)⁻¹ <= Lambda.1 := by
        have htail := runCount_confidence_tail_bound Lambda
        have hrun_succ_pos :
            0 < ((runCount Lambda + 1 : Nat) : Real) :=
          Nat.cast_pos.mpr (Nat.succ_pos _)
        have hfirst :
            ((runCount Lambda + 1 : Nat) : Real) / lambda =
              Lambda.1 / 2 := by
          change ((runCount Lambda + 1 : Nat) : Real) /
              (2 * ((runCount Lambda + 1 : Nat) : Real) / Lambda.1) =
            Lambda.1 / 2
          field_simp [Lambda.2.1.ne', hrun_succ_pos.ne']
        rw [hfirst]
        nlinarith [htail]
      exact
        le_trans hMonotone
          (le_trans hBridgeBound (ENNReal.ofReal_le_ofReal hScalar))
    · rfl

end SGD.NonconvexStochasticFirstOrder
