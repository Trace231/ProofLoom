{
  "algorithm": "NonconvexVarianceReducedMirrorDescent",
  "full_name": "Nonconvex variance-reduced mirror descent method for deterministic finite-sum optimization",
  "source_reference": "Lan, First-order and Stochastic Optimization Methods for Machine Learning, Springer 2020, Section 6.5.1, Algorithm 6.6, Theorem 6.14, Corollary 6.20",
  "setup": {
    "problem": {
      "math": "\\Psi^* := \\min_{x\\in X}\\{\\Psi(x):=f(x)+h(x)\\}",
      "ref": "Eq. (6.5.1)",
      "description": "Nonconvex finite-sum composite optimization over a closed convex feasible set."
    },
    "variable_space": {
      "math": "X\\subseteq \\mathbb{R}^n",
      "ref": "Section 6.5, p. 388"
    }
  },
  "assumptions": [
    {
      "name": "Finite_sum_problem_6_5_1",
      "math": "\\Psi^* := \\min_{x\\in X}\\{\\Psi(x):=f(x)+h(x)\\}",
      "ref": "Eq. (6.5.1)",
      "parameters": [
        "\\Psi",
        "f",
        "h",
        "X"
      ]
    },
    {
      "name": "Closed_convex_X_section_6_5",
      "math": "\\text{$X$ is a closed convex set in Euclidean space $\\mathbb{R}^n$}",
      "ref": "Section 6.5, prose after (6.5.1)",
      "parameters": [
        "X"
      ]
    },
    {
      "name": "Finite_sum_f_section_6_5",
      "math": "f(x)=\\sum_{i=1}^m f_i(x)/m",
      "ref": "Section 6.5, prose after (6.5.1)",
      "parameters": [
        "f",
        "f_i",
        "m"
      ]
    },
    {
      "name": "Convex_simple_h_section_6_5",
      "math": "\\text{$h$ is a simple convex function with known structure, but possibly nonsmooth}",
      "ref": "Section 6.5, prose after (6.5.1)",
      "parameters": [
        "h"
      ]
    },
    {
      "name": "Component_Lipschitz_gradients_section_6_5",
      "math": "\\forall i=1,2,\\ldots,m,\\ \\exists L_i>0,\\ \\text{s.t.}\\ \\|\\nabla f_i(x)-\\nabla f_i(y)\\|_*\\le L_i\\|x-y\\|,\\ \\forall x,y\\in X.",
      "ref": "Section 6.5, displayed assumption before (6.5.2)",
      "parameters": [
        "L_i",
        "f_i"
      ]
    },
    {
      "name": "Aggregate_smoothness_6_5_2",
      "math": "L_f\\le L\\equiv \\frac{1}{m}\\sum_{i=1}^m L_i",
      "ref": "Eq. (6.5.2)",
      "parameters": [
        "L_f",
        "L",
        "L_i"
      ]
    },
    {
      "name": "Psi_bounded_below_section_6_5",
      "math": "\\text{$\\Psi$ is bounded below over $X$, i.e., $\\Psi^*$ is finite}",
      "ref": "Section 6.5, prose after (6.5.2)",
      "parameters": [
        "\\Psi^*"
      ]
    },
    {
      "name": "Euclidean_norm_section_6_5",
      "math": "\\text{we assume that $\\|\\cdot\\|$ is the Euclidean norm}",
      "ref": "Section 6.5, final sentence before Section 6.5.1",
      "parameters": [
        "\\|\\cdot\\|"
      ]
    },
    {
      "name": "DGF_strong_convexity_6_2_4",
      "math": "\\langle x-z,\\nabla\\nu(x)-\\nabla\\nu(z)\\rangle\\ge \\|x-z\\|^2,\\ \\forall x,z\\in X.",
      "ref": "Eq. (6.2.4)",
      "parameters": [
        "\\nu",
        "X"
      ]
    },
    {
      "name": "Prox_function_definition_6_2_5",
      "math": "V(z,x)=\\nu(x)-[\\nu(z)+\\langle\\nabla\\nu(z),x-z\\rangle].",
      "ref": "Eq. (6.2.5)",
      "parameters": [
        "V",
        "\\nu"
      ]
    },
    {
      "name": "Prox_projection_definition_6_2_6",
      "math": "x^+=\\arg\\min_{u\\in X}\\{\\langle g,u\\rangle+\\frac{1}{\\gamma}V(x,u)+h(u)\\}",
      "ref": "Eq. (6.2.6)",
      "parameters": [
        "x^+",
        "g",
        "\\gamma"
      ]
    },
    {
      "name": "Projected_gradient_definition_6_2_7",
      "math": "P_X(x,g,\\gamma)=\\frac{1}{\\gamma}(x-x^+)",
      "ref": "Eq. (6.2.7)",
      "parameters": [
        "P_X",
        "x^+",
        "\\gamma"
      ]
    },
    {
      "name": "Gradient_mapping_notation_section_6_5",
      "math": "g_{X,k}\\equiv P_X(x_k,\\nabla f(x_k),\\gamma)\\ \\text{and}\\ \\tilde{g}_{X,k}\\equiv P_X(x_k,G_k,\\gamma).",
      "ref": "Section 6.5.1, displayed notation before (6.5.3)",
      "parameters": [
        "g_{X,k}",
        "\\tilde{g}_{X,k}"
      ]
    },
    {
      "name": "Estimator_error_definition_section_6_5",
      "math": "\\delta_k\\equiv G_k-\\nabla f(x_k)",
      "ref": "Section 6.5.1, sentence before (6.5.3)",
      "parameters": [
        "\\delta_k",
        "G_k"
      ]
    },
    {
      "name": "Algorithm_6_6_gradient_estimator",
      "math": "G_k=\\nabla f(x_k)\\ \\text{if }k\\%T=1,\\quad G_k=\\frac{1}{b}\\sum_{i\\in I_b}\\frac{\\nabla f_i(x_k)-\\nabla f_i(x_{k-1})}{q_i m}+G_{k-1}\\ \\text{otherwise}",
      "ref": "Algorithm 6.6",
      "parameters": [
        "G_k",
        "I_b",
        "b",
        "q_i"
      ]
    },
    {
      "name": "Algorithm_6_6_mirror_step",
      "math": "x_{k+1}=\\arg\\min_{x\\in X}\\{\\gamma[\\langle G_k,x\\rangle+h(x)]+V(x_k,x)\\}",
      "ref": "Algorithm 6.6",
      "parameters": [
        "x_{k+1}",
        "\\gamma",
        "G_k"
      ]
    },
    {
      "name": "Epoch_indexing_section_6_5_1",
      "math": "\\{\\{1,2,\\ldots,T\\},\\{T+1,T+2,\\ldots,2T\\},\\ldots,\\{sT+1,sT+2,\\ldots,(s+1)T\\},\\ldots\\}",
      "ref": "Section 6.5.1, displayed epoch grouping",
      "parameters": [
        "s",
        "t",
        "T"
      ]
    },
    {
      "name": "Importance_sampling_6_5_4",
      "math": "q_i=\\frac{L_i}{mL}",
      "ref": "Eq. (6.5.4)",
      "parameters": [
        "q_i",
        "L_i",
        "L"
      ]
    },
    {
      "name": "Parameter_choice_6_5_7",
      "math": "\\gamma=1/L\\ \\text{and}\\ b=17T.",
      "ref": "Eq. (6.5.7)",
      "parameters": [
        "\\gamma",
        "b",
        "T"
      ]
    },
    {
      "name": "Uniform_random_output_R",
      "math": "R\\ \\text{is uniformly distributed over}\\ \\{1,\\ldots,N\\}",
      "ref": "Algorithm 6.6 output",
      "parameters": [
        "R",
        "N"
      ]
    },
    {
      "name": "Corollary_6_20_epoch_length",
      "math": "T=\\sqrt{m}",
      "ref": "Corollary 6.20",
      "parameters": [
        "T",
        "m"
      ]
    }
  ],
  "algorithm_spec": {
    "initialization": {
      "math": "x_1,\\ \\gamma,\\ T,\\ \\{\\theta_t\\}\\ \\text{and probability distribution}\\ Q=\\{q_1,\\ldots,q_m\\}\\ \\text{on}\\ \\{1,\\ldots,m\\}",
      "ref": "Algorithm 6.6 input"
    },
    "steps": [
      {
        "step": 1,
        "name": "full_gradient_at_epoch_start",
        "math": "\\text{if }k\\%T==1\\ \\text{ then set }G_k=\\nabla f(x_k).",
        "ref": "Algorithm 6.6"
      },
      {
        "step": 2,
        "name": "recursive_minibatch_estimator",
        "math": "\\text{Generate i.i.d. samples }I_b\\text{ of size }b\\text{ according to }Q.\\ \\text{Set }G_k=\\frac{1}{b}\\sum_{i\\in I_b}(\\nabla f_i(x_k)-\\nabla f_i(x_{k-1}))/(q_i m)+G_{k-1}.",
        "ref": "Algorithm 6.6"
      },
      {
        "step": 3,
        "name": "mirror_descent_update",
        "math": "x_{k+1}=\\arg\\min_{x\\in X}\\{\\gamma[\\langle G_k,x\\rangle+h(x)]+V(x_k,x)\\}.",
        "ref": "Algorithm 6.6"
      }
    ],
    "output": {
      "math": "x_R,\\ \\text{where }R\\text{ is uniformly distributed over }\\{1,\\ldots,N\\}.",
      "ref": "Algorithm 6.6 output",
      "type": "random_iterate"
    },
    "parameters": [
      {
        "name": "epoch_indexing",
        "math": "k=sT+t,\\quad (s,T+1)==(s+1,1)",
        "ref": "Section 6.5.1"
      },
      {
        "name": "projected_gradients",
        "math": "g_{X,k}\\equiv P_X(x_k,\\nabla f(x_k),\\gamma)\\ \\text{and}\\ \\tilde{g}_{X,k}\\equiv P_X(x_k,G_k,\\gamma).",
        "ref": "Section 6.5.1"
      },
      {
        "name": "estimator_error",
        "math": "\\delta_k\\equiv G_k-\\nabla f(x_k)",
        "ref": "Section 6.5.1"
      },
      {
        "name": "importance_sampling",
        "math": "q_i=\\frac{L_i}{mL}",
        "ref": "Eq. (6.5.4)"
      },
      {
        "name": "theorem_stepsizes",
        "math": "\\gamma=1/L\\ \\text{and}\\ b=17T.",
        "ref": "Eq. (6.5.7)"
      },
      {
        "name": "corollary_epoch_length",
        "math": "T=\\sqrt{m}",
        "ref": "Corollary 6.20"
      }
    ]
  },
  "main_theorem": {
    "ref": "Corollary 6.20",
    "statement_math": "\\text{Assume that the probabilities }q_i\\text{ are set to (6.5.4) and that }\\gamma\\text{ and }b\\text{ are set to (6.5.7). In addition if }T=\\sqrt{m},\\text{ then the total number of gradient evaluations required by the nonconvex variance-reduced mirror descent method to find a solution }\\bar{x}\\in X\\text{ s.t. }\\mathbb{E}[\\|P_X(x_k,\\nabla f(x_k),\\gamma)\\|^2]\\le \\epsilon\\text{ can be bounded by }\\mathcal{O}\\left(m+\\frac{\\sqrt{m}L[\\Psi(x_1)-\\Psi^*]}{\\epsilon}\\right).",
    "rate": "\\mathcal{O}\\left(m+\\frac{\\sqrt{m}L[\\Psi(x_1)-\\Psi^*]}{\\epsilon}\\right)",
    "measure": "total number of component-gradient evaluations required to make the expected squared generalized projected gradient at most epsilon",
    "proof": [
      {
        "step": 1,
        "description": "Count one full gradient computation at the start of each epoch and mini-batches of size b in the remaining iterations; the paper bounds this by one full-gradient cost plus bT component-gradient calls per epoch, multiplied by the number of epochs.",
        "ref": "Corollary 6.20 proof, first displayed formula",
        "source_pdf_lines": [
          23180,
          23183
        ],
        "math": "(m+bT)\\left\\lceil \\frac{N}{T}\\right\\rceil=(m+17T^2)\\left\\lceil \\frac{N}{T}\\right\\rceil.",
        "uses": [
          "Algorithm_6_6_gradient_estimator",
          "Parameter_choice_6_5_7"
        ],
        "produces": "gradient_evaluation_count"
      },
      {
        "step": 2,
        "description": "Use the consequence (6.5.9) of Theorem 6.14 to choose an iteration count sufficient for the target expected projected-gradient bound.",
        "ref": "Corollary 6.20 proof, sentence after count",
        "source_pdf_lines": [
          23184,
          23186
        ],
        "math": "N=\\frac{8L}{\\epsilon}[\\Psi(x_1)-\\Psi^*].",
        "uses": [
          "Theorem_6_14_iteration_bound"
        ],
        "produces": "iteration_count_for_epsilon"
      },
      {
        "step": 3,
        "description": "Substitute the corollary epoch length into the per-epoch gradient count.",
        "ref": "Corollary 6.20 proof, final sentence",
        "source_pdf_lines": [
          23184,
          23188
        ],
        "uses": [
          "previous_step:1",
          "previous_step:2",
          "Corollary_6_20_epoch_length"
        ],
        "produces": "With T=sqrt(m), (m+17T^2)ceil(N/T) is O(m+sqrt(m)L[Psi(x_1)-Psi^*]/epsilon)."
      },
      {
        "step": 4,
        "description": "Conclude the displayed big-O complexity bound from the count and the iteration choice.",
        "ref": "Corollary 6.20 statement and proof",
        "source_pdf_lines": [
          23174,
          23188
        ],
        "math": "\\mathcal{O}\\left(m+\\frac{\\sqrt{m}L[\\Psi(x_1)-\\Psi^*]}{\\epsilon}\\right).",
        "uses": [
          "previous_step:3"
        ],
        "produces": "Corollary 6.20"
      }
    ]
  },
  "key_lemmas": [
    {
      "name": "Lemma_6_4_basic_prox_mapping_inequality",
      "ref": "Lemma 6.4 / Eq. (6.2.10)",
      "statement_math": "\\langle g,P_X(x,g,\\gamma)\\rangle\\ge \\|P_X(x,g,\\gamma)\\|^2+\\frac{1}{\\gamma}[h(x^+)-h(x)].",
      "role": "Used in the first displayed chain of Theorem 6.14 to replace the prox inner product by a negative squared mapping norm plus the h difference.",
      "proof": [
        {
          "step": 1,
          "description": "Apply the optimality condition of the generalized projection problem and the definition of the prox-function.",
          "ref": "Lemma 6.4 proof, first display",
          "source_pdf_lines": [
            19457,
            19461
          ],
          "math": "\\langle g+\\frac{1}{\\gamma}[\\nabla\\nu(x^+)-\\nabla\\nu(x)]+p,u-x^+\\rangle\\ge 0,\\quad \\text{for any }u\\in X.",
          "uses": [
            "Prox_projection_definition_6_2_6",
            "Prox_function_definition_6_2_5"
          ],
          "produces": "prox_optimality_condition"
        },
        {
          "step": 2,
          "description": "Let u=x; convexity of h and strong convexity of the distance generating function give the printed two-line lower bound.",
          "ref": "Lemma 6.4 proof, second display",
          "source_pdf_lines": [
            19463,
            19466
          ],
          "math": "\\langle g,x-x^+\\rangle\\ge \\frac{1}{\\gamma}\\langle \\nabla\\nu(x^+)-\\nabla\\nu(x),x^+-x\\rangle+\\langle p,x^+-x\\rangle\\ge \\frac{1}{\\gamma}\\|x^+-x\\|^2+h(x^+)-h(x).",
          "uses": [
            "previous_step:1",
            "Convex_simple_h_section_6_5",
            "DGF_strong_convexity_6_2_4"
          ],
          "produces": "lower_bound_for_<g,x-x+>"
        },
        {
          "step": 3,
          "description": "Use the definition of P_X and gamma positivity to rewrite the previous inequality as the statement of Lemma 6.4.",
          "ref": "Lemma 6.4 proof, final sentence",
          "source_pdf_lines": [
            19467,
            19468
          ],
          "uses": [
            "previous_step:2",
            "Projected_gradient_definition_6_2_7"
          ],
          "produces": "Eq. (6.2.10)"
        }
      ]
    },
    {
      "name": "Lemma_6_5_prox_mapping_Lipschitz",
      "ref": "Lemma 6.5 / Eq. (6.2.11)",
      "statement_math": "\\|x_2^+-x_1^+\\|\\le \\gamma\\|g_2-g_1\\|.",
      "role": "Provides the last inequality in Proposition 6.1.",
      "proof": [
        {
          "step": 1,
          "description": "Write the two optimality conditions for the prox subproblems with g_1 and g_2.",
          "ref": "Eqs. (6.2.12)-(6.2.13)",
          "source_pdf_lines": [
            19474,
            19482
          ],
          "math": "\\langle g_1+\\frac{1}{\\gamma}[\\nabla\\nu(x_1^+)-\\nabla\\nu(x)]+p_1,u-x_1^+\\rangle\\ge 0,\\quad \\langle g_2+\\frac{1}{\\gamma}[\\nabla\\nu(x_2^+)-\\nabla\\nu(x)]+p_2,u-x_2^+\\rangle\\ge 0.",
          "uses": [
            "Prox_projection_definition_6_2_6",
            "Prox_function_definition_6_2_5"
          ],
          "produces": "prox_optimality_conditions_for_two_gradients"
        },
        {
          "step": 2,
          "description": "Let u=x_2^+ in (6.2.12), keeping the displayed subgradient term p_1 before applying convexity of h.",
          "ref": "Eq. (6.2.14), first inequality",
          "source_pdf_lines": [
            19483,
            19486
          ],
          "math": "\\langle g_1,x_2^+-x_1^+\\rangle\\ge \\frac{1}{\\gamma}\\langle\\nabla\\nu(x)-\\nabla\\nu(x_1^+),x_2^+-x_1^+\\rangle+\\langle p_1,x_1^+-x_2^+\\rangle.",
          "uses": [
            "previous_step:1"
          ],
          "produces": "Eq. (6.2.14) first inequality with p_1 term"
        },
        {
          "step": 3,
          "description": "Apply convexity of h to replace the p_1 subgradient term by h(x_1^+)-h(x_2^+) and split the gradient difference at x_2^+.",
          "ref": "Eq. (6.2.14), second inequality",
          "source_pdf_lines": [
            19486,
            19490
          ],
          "math": "\\langle g_1,x_2^+-x_1^+\\rangle\\ge \\frac{1}{\\gamma}\\langle\\nabla\\nu(x_2^+)-\\nabla\\nu(x_1^+),x_2^+-x_1^+\\rangle+\\frac{1}{\\gamma}\\langle\\nabla\\nu(x)-\\nabla\\nu(x_2^+),x_2^+-x_1^+\\rangle+h(x_1^+)-h(x_2^+).",
          "uses": [
            "previous_step:2",
            "Convex_simple_h_section_6_5"
          ],
          "produces": "Eq. (6.2.14) final inequality"
        },
        {
          "step": 4,
          "description": "Let u=x_1^+ in (6.2.13), keeping the displayed subgradient term p_2 before applying convexity of h.",
          "ref": "Eq. (6.2.15), first inequality",
          "source_pdf_lines": [
            19492,
            19495
          ],
          "math": "\\langle g_2,x_1^+-x_2^+\\rangle\\ge \\frac{1}{\\gamma}\\langle\\nabla\\nu(x)-\\nabla\\nu(x_2^+),x_1^+-x_2^+\\rangle+\\langle p_2,x_2^+-x_1^+\\rangle.",
          "uses": [
            "previous_step:1"
          ],
          "produces": "Eq. (6.2.15) first inequality with p_2 term"
        },
        {
          "step": 5,
          "description": "Apply convexity of h to replace the p_2 subgradient term by h(x_2^+)-h(x_1^+).",
          "ref": "Eq. (6.2.15), second inequality",
          "source_pdf_lines": [
            19494,
            19495
          ],
          "math": "\\langle g_2,x_1^+-x_2^+\\rangle\\ge \\frac{1}{\\gamma}\\langle\\nabla\\nu(x)-\\nabla\\nu(x_2^+),x_1^+-x_2^+\\rangle+h(x_2^+)-h(x_1^+).",
          "uses": [
            "previous_step:4",
            "Convex_simple_h_section_6_5"
          ],
          "produces": "Eq. (6.2.15) final inequality"
        },
        {
          "step": 6,
          "description": "Sum (6.2.14) and (6.2.15); the h terms and common gradient terms cancel, and strong convexity of nu bounds the remaining term.",
          "ref": "Lemma 6.5 proof, summation display",
          "source_pdf_lines": [
            19497,
            19499
          ],
          "math": "\\|g_1-g_2\\|\\|x_2^+-x_1^+\\|\\ge \\langle g_1-g_2,x_2^+-x_1^+\\rangle\\ge \\frac{1}{\\gamma}\\|x_2^+-x_1^+\\|^2.",
          "uses": [
            "previous_step:3",
            "previous_step:5",
            "DGF_strong_convexity_6_2_4"
          ],
          "produces": "summed_lipschitz_inequality"
        },
        {
          "step": 7,
          "description": "Cancel one factor of the norm to obtain (6.2.11).",
          "ref": "Lemma 6.5 proof, final sentence",
          "source_pdf_lines": [
            19499,
            19501
          ],
          "uses": [
            "previous_step:6"
          ],
          "produces": "Eq. (6.2.11)"
        }
      ]
    },
    {
      "name": "Proposition_6_1_projected_gradient_Lipschitz",
      "ref": "Proposition 6.1 / Eq. (6.2.16)",
      "statement_math": "\\|P_X(x,g_1,\\gamma)-P_X(x,g_2,\\gamma)\\|\\le \\|g_1-g_2\\|.",
      "role": "Used to compare the exact generalized projected gradient with the stochastic one in (6.5.3).",
      "proof": [
        {
          "step": 1,
          "description": "Use the definition of P_X to express the mapping difference through x_2^+-x_1^+, then apply Lemma 6.5.",
          "ref": "Proposition 6.1 proof",
          "source_pdf_lines": [
            19504,
            19510
          ],
          "math": "\\|P_X(x,g_1,\\gamma)-P_X(x,g_2,\\gamma)\\|=\\frac{1}{\\gamma}\\|x_2^+-x_1^+\\|\\le \\|g_1-g_2\\|.",
          "uses": [
            "Projected_gradient_definition_6_2_7",
            "Lemma_6_5_prox_mapping_Lipschitz"
          ],
          "produces": "Eq. (6.2.16)"
        }
      ]
    },
        {
            "name": "Gradient_mapping_perturbation_6_5_3",
            "ref": "Eq. (6.5.3)",
            "statement_math": "\\|g_{X,k}-\\tilde{g}_{X,k}\\|\\le \\|\\delta_k\\|.",
            "role": "Used in Theorem 6.14 to bound \\|g_{X,k}\\|^2 by \\|\\delta_k\\|^2 and \\|\\tilde g_{X,k}\\|^2.",
            "proof": [
                {
                    "step": 1,
                    "description": "Record the paper's printed invocation: after defining \\delta_k, the source says 'Then by Corollary 6.1' and displays (6.5.3). Corollary 6.1 is an unrelated RSGD stepsize corollary in the same chapter, so this JSON treats the citation as a source typo and uses Proposition 6.1, the prox-mapping Lipschitz result (6.2.16), with g_1=\\nabla f(x_k), g_2=G_k together with \\delta_k=G_k-\\nabla f(x_k).",
                    "ref": "Section 6.5.1, printed citation to Corollary 6.1 before (6.5.3); mathematical repair via Proposition 6.1 / Eq. (6.2.16)",
                    "source_pdf_lines": [
                        23019,
                        23021
                    ],
          "math": "\\|g_{X,k}-\\tilde{g}_{X,k}\\|\\le \\|\\delta_k\\|.",
          "uses": [
            "Proposition_6_1_projected_gradient_Lipschitz",
            "Gradient_mapping_notation_section_6_5",
            "Estimator_error_definition_section_6_5"
          ],
          "produces": "Eq. (6.5.3)"
        }
      ]
    },
    {
      "name": "Lemma_6_10_epochwise_estimator_variance_bound",
      "ref": "Lemma 6.10 / Eqs. (6.5.4)-(6.5.5)",
      "statement_math": "\\text{Let }L\\text{ be defined in (6.5.2) and suppose that the probabilities }q_i\\text{ are set to }q_i=\\frac{L_i}{mL}\\text{ for }i=1,\\ldots,m.\\text{ If }k\\text{ (or equivalently }(s,t)\\text{) represents the }t\\text{-th iteration at the }s\\text{-epoch, then }\\mathbb{E}[\\|\\delta_k\\|^2]\\equiv \\mathbb{E}[\\|\\delta_{(s,t)}\\|^2]\\le \\frac{L^2}{b}\\sum_{i=2}^t\\mathbb{E}[\\|x_{(s,i)}-x_{(s,i-1)}\\|^2].",
      "role": "Controls the recursive estimator error inside an epoch and is substituted into the epochwise descent recursion.",
      "proof": [
        {
          "step": 1,
          "description": "Fix an epoch and introduce the simplified notations delta_t and x_t; the first estimator in each epoch is exact.",
          "ref": "Lemma 6.10 proof, first paragraph",
          "source_pdf_lines": [
            23034,
            23036
          ],
