import Mathlib.Algebra.BigOperators.Field
import Mathlib.Algebra.BigOperators.Intervals
import Mathlib.Algebra.Order.Floor.Div
import Mathlib.Algebra.Order.BigOperators.Ring.Finset
import Mathlib.Analysis.Calculus.Gradient.Basic
import Mathlib.Analysis.InnerProductSpace.PiL2
import Mathlib.Data.Real.Sqrt
import Mathlib.Logic.Relation
import Mathlib.Topology.Algebra.InfiniteSum.Basic
import SOptLib.Glue.Algebra
import SOptLib.Layer0.Objective
import SOptLib.Model.Objective

/-!
# R/C-DGD object-layer model

This file records the paper-facing mathematical objects for the deterministic
single-loop R/C-DGD algorithm. The algorithmic state is generated by the
canonical update equations from Algorithm 1 rather than supplied as witnesses.
-/

open scoped BigOperators Gradient InnerProductSpace

namespace SGD.RCDGD

/-- The paper's ambient space `R^d`, represented as a finite Euclidean space. -/
abbrev Vec (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-- Nodes are the finite set `{0, ..., n-1}`; the paper's one-based node `i`
corresponds to Lean index `i - 1`. -/
abbrev Node (n : ℕ) := Fin n

/-- A directed edge supported by the row-stochastic matrix at round `k`. -/
def supportEdge {n : ℕ} (A : ℕ → Node n → Node n → ℝ) (k : ℕ) :
    Node n → Node n → Prop :=
  fun i j => 0 < A k i j

/-- Reachability in the union of the `B` support graphs starting at round `t`. -/
def bWindowReachable {n : ℕ} (A : ℕ → Node n → Node n → ℝ) (B t : ℕ)
    (i j : Node n) : Prop :=
  Relation.ReflTransGen
    (fun u v : Node n => ∃ r : ℕ, r < B ∧ 0 < A (t + r) u v) i j

/-- Assumption 2.2 as a paper-facing predicate on the time-varying matrices.

Source: `book/RCDGD/RCDGD.json#/assumptions/1/math`.
Quote: "存在整数 B\ge 1 与 a_{\min}\in(0,1]，使每个 A_k\in\R^{n\times n}
行随机，具有正对角元，每个正条目至少为 a_{\min}，且任意连续 B 轮支持图的并图强连通。"
-/
structure TimeVaryingRowStochasticNetwork {n : ℕ}
    (A : ℕ → Node n → Node n → ℝ) (B : ℕ) (aMin : ℝ) : Prop where
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/1/math`.
  Quote: "每个 A_k... 行随机". -/
  row_nonneg : ∀ k i j, 0 ≤ A k i j
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/1/math`.
  Quote: "每个 A_k... 行随机". -/
  row_sum : ∀ k i, (∑ j : Node n, A k i j) = 1
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/1/math`.
  Quote: "具有正对角元". -/
  positive_diagonal : ∀ k i, 0 < A k i i
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/1/math`.
  Quote: "每个正条目至少为 a_{\min}". -/
  positive_entry_lower : ∀ k i j, 0 < A k i j → aMin ≤ A k i j
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/1/math`.
  Quote: "任意连续 B 轮支持图的并图强连通". -/
  b_window_strongly_connected : ∀ t i j, bWindowReachable A B t i j

/-- Source-facing setup data and assumptions for R/C-DGD.

The local gradients are not fields: they are the Mathlib gradients of the
paper's local objectives `f_i`. The generated iterates are likewise defined
below from Algorithm 1.

Source: `book/RCDGD/RCDGD.json#/setup/problem/math`.
Quote: "\min_{x\in\R^d} f(x):=\frac1n\sum_{i=1}^n f_i(x)".
Source: `book/RCDGD/RCDGD.json#/setup/problem/description`.
Quote: "n>=2 nodes jointly minimize the equal-weight aggregate; node i can query only f_i."
-/
structure Setup where
  /-- Source: `book/RCDGD/RCDGD.json#/setup/problem/description`.
  Quote: "n>=2 nodes". -/
  n : ℕ
  /-- Source: `book/RCDGD/RCDGD.json#/setup/problem/math`.
  Quote: "x\in\R^d". -/
  d : ℕ
  /-- Source: `book/RCDGD/RCDGD.json#/setup/problem/description`.
  Quote: "n>=2 nodes". -/
  hn : 2 ≤ n
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/1/math`.
  Quote: "存在整数 B\ge 1". -/
  B : ℕ
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/1/math`.
  Quote: "B\ge 1". -/
  hB : 1 ≤ B
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/1/math`.
  Quote: "a_{\min}\in(0,1]". -/
  aMin : ℝ
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/1/math`.
  Quote: "a_{\min}\in(0,1]". -/
  haMin : 0 < aMin ∧ aMin ≤ 1
  /-- Source: `book/RCDGD/RCDGD.json#/algorithm_spec/parameters/3/math`.
  Quote: "\gamma>0". -/
  gamma : ℝ
  /-- Source: `book/RCDGD/RCDGD.json#/algorithm_spec/parameters/3/math`.
  Quote: "\gamma>0". -/
  hgamma : 0 < gamma
  /-- Source: `book/RCDGD/RCDGD.json#/setup/problem/math`.
  Quote: "f(x):=\frac1n\sum_{i=1}^n f_i(x)". -/
  localObjective : Node n → Vec d → ℝ
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/0/math`.
  Quote: "梯度全局 L-Lipschitz". -/
  L : ℝ
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/0/math`.
  Quote: "每个 fi : Rd → R 可微". -/
  local_differentiable : ∀ i : Node n, Differentiable ℝ (localObjective i)
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/0/math`.
  Quote: "∥∇fi (x) − ∇fi (y)∥ ≤ L ∥x − y∥". -/
  local_gradient_lipschitz :
    ∀ (i : Node n) (x y : Vec d),
      ‖∇ (localObjective i) x - ∇ (localObjective i) y‖ ≤ L * ‖x - y‖
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/0/math`.
  Quote: "聚合目标 f = n−1 ∑i fi 有下界 f∗ := infx f (x) > −∞". -/
  objective_bddBelow :
    BddBelow (Set.range fun x : Vec d =>
      ((n : ℝ)⁻¹) * ∑ i : Node n, localObjective i x)
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/1/math`.
  Quote: "每个 A_k\in\R^{n\times n} 行随机". -/
  mixing : ℕ → Node n → Node n → ℝ
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/1/math`.
  Quote: "行随机，具有正对角元，每个正条目至少为 a_{\min}，且任意连续 B 轮支持图的并图强连通". -/
  hnetwork : TimeVaryingRowStochasticNetwork mixing B aMin
  /-- Source: `book/RCDGD/RCDGD.json#/assumptions/4/math`.
  Quote: "g_{i,0}=\nabla f_i(x_{i,0}),\qquad c_{i,0}=R_{i,0}=0". -/
  x0 : Node n → Vec d

namespace Setup

/-- The aggregate objective `f = n^{-1} sum_i f_i` from (1.1).

Source: `book/RCDGD/RCDGD.json#/setup/problem/math`.
Quote: "f(x):=\frac1n\sum_{i=1}^n f_i(x)".
-/
noncomputable def aggregateObjective (P : Setup) (x : Vec P.d) : ℝ :=
  ((P.n : ℝ)⁻¹) * ∑ i : Node P.n, P.localObjective i x

/-- The canonical lower objective value `f_* = inf_x f(x)` from Assumption 2.1.

Source: `book/RCDGD/RCDGD.json#/assumptions/0/math`.
Quote: "f∗ := infx f (x)".
-/
noncomputable def fStar (P : Setup) : ℝ :=
  sInf (Set.range P.aggregateObjective)

/-- Assumption 2.1 makes the canonical `f_*` a lower bound for the aggregate
objective.

Source: `book/RCDGD/RCDGD.json#/assumptions/0/math`.
Quote: "聚合目标 ... 有下界 f∗ := infx f (x) > −∞".
-/
theorem fStar_le_aggregateObjective (P : Setup) (x : Vec P.d) :
    P.fStar ≤ P.aggregateObjective x := by
  exact csInf_le P.objective_bddBelow ⟨x, rfl⟩

/-- The canonical local gradient `g_i(x) = ∇ f_i(x)`.

Source: `book/RCDGD/RCDGD.json#/setup/variable_space/math`.
Quote: "g_{i,k}:=\nabla f_i(x_{i,k})".
-/
noncomputable def localGradient (P : Setup) (i : Node P.n) (x : Vec P.d) : Vec P.d :=
  ∇ (P.localObjective i) x

/-- The canonical aggregate gradient `∇ f(x)`.

Source: `book/RCDGD/RCDGD.json#/main_theorem/statement_math`.
Quote: "\|\nabla f(\bar x_k)\|^2".
-/
noncomputable def aggregateGradient (P : Setup) (x : Vec P.d) : Vec P.d :=
  ∇ (P.aggregateObjective) x

/-- The transaction length `H = max {1, (n-1)B}` from (2.3).

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/parameters/0/math`.
Quote: "H=\max\{1,(n-1)B\}".
-/
def H (P : Setup) : ℕ :=
  max 1 ((P.n - 1) * P.B)

theorem H_pos (P : Setup) : 0 < P.H := by
  unfold H
  exact lt_of_lt_of_le Nat.zero_lt_one (le_max_left 1 ((P.n - 1) * P.B))

/-- The proof-prefix length `K_0 = nH` from (2.3).

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/parameters/1/math`.
Quote: "K_0=nH".
-/
def K0 (P : Setup) : ℕ :=
  P.n * P.H

/-- The delay parameter `D = (n+1)H` from (2.3).

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/parameters/2/math`.
Quote: "D=(n+1)H".
-/
def D (P : Setup) : ℕ :=
  (P.n + 1) * P.H

/-- The mass constant `β = a_min^H` from (4.1).

Source: `book/RCDGD/RCDGD.json#/key_lemmas/2/statement_math`.
Quote: "\beta=a_{\min}^H".
-/
noncomputable def beta (P : Setup) : ℝ :=
  P.aMin ^ P.H

/-- The mass constant `β=a_min^H` is positive from Assumption 2.2 and the
definition of `H`.

Source: `book/RCDGD/RCDGD.json#/key_lemmas/3/statement_math`.
Quote: "P_{is}\ge\beta=a_{\min}^H>0".
-/
theorem beta_pos (P : Setup) : 0 < P.beta := by
  unfold beta
  exact pow_pos P.haMin.1 P.H

/-- The node count is positive in the real scalar encoding used in the paper
constants. -/
theorem n_pos_real (P : Setup) : 0 < (P.n : ℝ) := by
  exact_mod_cast (lt_of_lt_of_le (by decide : 0 < 2) P.hn)

/-- Transaction number `ell = floor(k/H)`, encoded by natural division.

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/0/math`.
Quote: "\ell=\lfloor k/H\rfloor".
-/
def transactionIndex (P : Setup) (k : ℕ) : ℕ :=
  k / P.H

/-- Position `r = k mod H` inside the current transaction.

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/0/math`.
Quote: "r=k\bmod H".
-/
def transactionRemainder (P : Setup) (k : ℕ) : ℕ :=
  k % P.H

/-- Transaction start `t_ell = ell H` from (3.6).

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/0/math`.
Quote: "t_\ell=\ell H".
-/
def transactionStart (P : Setup) (ell : ℕ) : ℕ :=
  ell * P.H

/-- Transaction endpoint `t_ell + H - 1` from (3.6), (3.10)--(3.12).

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/0/math`.
Quote: "\mathcal I_\ell=\{t_\ell,\ldots,t_\ell+H-1\}".
-/
def transactionEnd (P : Setup) (ell : ℕ) : ℕ :=
  P.transactionStart ell + P.H - 1

/-- The current transaction start `t_floor(k/H)` associated to round `k`. -/
def currentTransactionStart (P : Setup) (k : ℕ) : ℕ :=
  P.transactionStart (P.transactionIndex k)

/-- The current transaction endpoint `t_floor(k/H)+H-1` associated to round `k`. -/
def currentTransactionEnd (P : Setup) (k : ℕ) : ℕ :=
  P.transactionEnd (P.transactionIndex k)

/-- The paper's transaction window `I_ell={t_ell,...,t_ell+H-1}`.

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/0/math`.
Quote: "\mathcal I_\ell=\{t_\ell,\ldots,t_\ell+H-1\}".
-/
def transactionWindow (P : Setup) (ell : ℕ) : Finset ℕ :=
  Finset.Icc (P.transactionStart ell) (P.transactionEnd ell)

/-- Source-facing predicate for the start round `k=t_ell` of its transaction. -/
def isTransactionStart (P : Setup) (k : ℕ) : Prop :=
  k = P.currentTransactionStart k

/-- Source-facing predicate for the endpoint round `k=t_ell+H-1` of its
transaction. This is the object in (3.10)--(3.12); the modulo characterization
is only a bridge theorem below. -/
def isTransactionEndpoint (P : Setup) (k : ℕ) : Prop :=
  k = P.currentTransactionEnd k

/-- Membership in the current source transaction window. -/
def inCurrentTransactionWindow (P : Setup) (k : ℕ) : Prop :=
  k ∈ P.transactionWindow (P.transactionIndex k)

/-- The cyclic source node `s_ell = 1 + (ell mod n)`, represented zero-based.

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/0/math`.
Quote: "s=1+(\ell\bmod n)".
-/
def sourceIndex (P : Setup) (ell : ℕ) : Node P.n :=
  ⟨ell % P.n, Nat.mod_lt ell (lt_of_lt_of_le (by decide : 0 < 2) P.hn)⟩

/-- The source node active at communication round `k`. -/
def roundSource (P : Setup) (k : ℕ) : Node P.n :=
  P.sourceIndex (P.transactionIndex k)

theorem sourceIndex_val (P : Setup) (ell : ℕ) :
    (P.sourceIndex ell).val = ell % P.n :=
  rfl

theorem transactionStart_eq (P : Setup) (ell : ℕ) :
    P.transactionStart ell = ell * P.H :=
  rfl

theorem transactionEnd_eq (P : Setup) (ell : ℕ) :
    P.transactionEnd ell = ell * P.H + P.H - 1 :=
  rfl

/-- Arithmetic bridge from the source-facing start predicate to the implementable
clock remainder. -/
theorem isTransactionStart_iff_remainder_zero (P : Setup) (k : ℕ) :
    P.isTransactionStart k ↔ P.transactionRemainder k = 0 := by
  unfold isTransactionStart currentTransactionStart transactionStart transactionIndex
    transactionRemainder
  constructor
  · intro h
    have hdiv := Nat.div_add_mod k P.H
    rw [Nat.mul_comm P.H (k / P.H)] at hdiv
    omega
  · intro h
    have hdiv := Nat.div_add_mod k P.H
    rw [Nat.mul_comm P.H (k / P.H)] at hdiv
    omega

/-- Arithmetic bridge from the source-facing endpoint predicate to the
implementable clock remainder. -/
theorem isTransactionEndpoint_iff_remainder_eq (P : Setup) (k : ℕ) :
    P.isTransactionEndpoint k ↔ P.transactionRemainder k = P.H - 1 := by
  unfold isTransactionEndpoint currentTransactionEnd transactionEnd
    transactionStart transactionIndex transactionRemainder
  constructor
  · intro h
    have hH := P.H_pos
    have hdiv := Nat.div_add_mod k P.H
    rw [Nat.mul_comm P.H (k / P.H)] at hdiv
    have hmod_lt : k % P.H < P.H := Nat.mod_lt k hH
    omega
  · intro h
    have hH := P.H_pos
    have hdiv := Nat.div_add_mod k P.H
    rw [Nat.mul_comm P.H (k / P.H)] at hdiv
    have hmod_lt : k % P.H < P.H := Nat.mod_lt k hH
    omega

/-- The source endpoint `t_ell+H-1` is an endpoint round in the paper's clock. -/
theorem transactionEnd_isTransactionEndpoint (P : Setup) (ell : ℕ) :
    P.isTransactionEndpoint (P.transactionEnd ell) := by
  rw [P.isTransactionEndpoint_iff_remainder_eq]
  unfold Setup.transactionRemainder Setup.transactionEnd Setup.transactionStart
  have hH := P.H_pos
  have hsub : ell * P.H + P.H - 1 = P.H - 1 + ell * P.H := by
    omega
  rw [hsub]
  rw [Nat.add_mul_mod_self_right]
  exact Nat.mod_eq_of_lt (by omega)

private theorem roundSource_transactionEnd (P : Setup) (ell : ℕ) :
    P.roundSource (P.transactionEnd ell) = P.sourceIndex ell := by
  have hidx : P.transactionIndex (P.transactionEnd ell) = ell := by
    unfold Setup.transactionIndex Setup.transactionEnd Setup.transactionStart
    have hH := P.H_pos
    have hsub : ell * P.H + P.H - 1 = P.H - 1 + P.H * ell := by
      rw [Nat.mul_comm ell P.H]
      omega
    rw [hsub]
    rw [Nat.add_mul_div_left _ _ hH]
    rw [Nat.div_eq_of_lt]
    · simp
    · omega
  apply Fin.ext
  unfold Setup.roundSource Setup.sourceIndex
  simp [hidx]

private theorem transactionStart_isTransactionStart (P : Setup) (ell : ℕ) :
    P.isTransactionStart (P.transactionStart ell) := by
  rw [P.isTransactionStart_iff_remainder_zero]
  unfold Setup.transactionRemainder Setup.transactionStart
  exact Nat.mul_mod_left ell P.H

private theorem roundSource_transactionStart (P : Setup) (ell : ℕ) :
    P.roundSource (P.transactionStart ell) = P.sourceIndex ell := by
  have hidx : P.transactionIndex (P.transactionStart ell) = ell := by
    unfold Setup.transactionIndex Setup.transactionStart
    rw [Nat.mul_comm]
    exact Nat.mul_div_right ell P.H_pos
  apply Fin.ext
  unfold Setup.roundSource Setup.sourceIndex
  simp [hidx]

/-- The paper's finite-horizon notation `||u||_{l2[p,q)}`.

Source: `book/RCDGD/RCDGD.json#/definitions/0/math`.
Quote: "\|u\|_{\ell_2[p,q)}:=\left(\sum_{k=p}^{q-1}u_k^2\right)^{1/2}".
-/
noncomputable def finiteHorizonL2Norm (u : ℕ → ℝ) (p q : ℕ) : ℝ :=
  Real.sqrt (∑ k ∈ Finset.Ico p q, u k ^ (2 : ℕ))

end Setup

/-- Per-node algorithm state at the beginning of a communication round. -/
structure State (P : Setup) where
  x : Node P.n → Vec P.d
  g : Node P.n → Vec P.d
  c : Node P.n → Vec P.d
  R : Node P.n → Vec P.d
  phi : Node P.n → Vec P.d
  psi : Node P.n → ℝ

namespace State

variable (P : Setup)

/-- Initialization from Algorithm 1, line 1: `g_{i,0}=∇f_i(x_{i,0})` and
`c_{i,0}=R_{i,0}=0`. The ratio lanes are inactive before the first round.

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/initialization/math`.
Quote: "查询 g_{i,0}=\nabla f_i(x_{i,0})；令 c_{i,0}=R_{i,0}=0".
-/
noncomputable def initial : State P where
  x := P.x0
  g := fun i => P.localGradient i (P.x0 i)
  c := fun _ => 0
  R := fun _ => 0
  phi := fun _ => 0
  psi := fun _ => 0

variable {P}

/-- Row-stochastic mixing of a vector-valued per-node field.

Source: `book/RCDGD/RCDGD.json#/setup/variable_space/math`.
Quote: "\widehat y_{i,k}=\sum_{j=1}^n(A_k)_{ij}y_{j,k}".
-/
noncomputable def mixVec (k : ℕ) (v : Node P.n → Vec P.d) (i : Node P.n) : Vec P.d :=
  ∑ j : Node P.n, P.mixing k i j • v j

/-- Row-stochastic mixing of a scalar per-node field.

Source: `book/RCDGD/RCDGD.json#/setup/variable_space/math`.
Quote: "\widehat Y_k=A_kY_k".
-/
noncomputable def mixScalar (k : ℕ) (v : Node P.n → ℝ) (i : Node P.n) : ℝ :=
  ∑ j : Node P.n, P.mixing k i j * v j

/-- The direction `d_{i,k}=R_{i,k}/n+g_{i,k}-c_{i,k}` from (3.9).

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/4/math`.
Quote: "d_{i,k}=R_{i,k}/n+g_{i,k}-c_{i,k}".
-/
noncomputable def direction (st : State P) (i : Node P.n) : Vec P.d :=
  ((P.n : ℝ)⁻¹) • st.R i + st.g i - st.c i

/-- Whether round `k` is the endpoint `k=t_ell+H-1` of its transaction. -/
def isEndpoint (k : ℕ) : Prop :=
  P.isTransactionEndpoint k

/-- Payload `z_ell = g_{s_ell,t_ell}-c_{s_ell,t_ell}` from (3.7).

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/1/math`.
Quote: "z_\ell=g_{s_\ell,t_\ell}-c_{s_\ell,t_\ell}".
-/
noncomputable def sourcePayload (st : State P) (k : ℕ) : Vec P.d :=
  st.g (P.roundSource k) - st.c (P.roundSource k)

/-- The vector lane after the source-only initialization at `r=0` from (3.7).

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/1/math`.
Quote: "(\phi_{i,t_\ell},\psi_{i,t_\ell})=\begin{cases}(z_\ell,1),&i=s_\ell,\\(0,0),&i\ne s_\ell,\end{cases}".
-/
noncomputable def preparedPhi (st : State P) (k : ℕ) (i : Node P.n) : Vec P.d :=
  by
    classical
    exact
      if P.isTransactionStart k then
        if i = P.roundSource k then st.sourcePayload k else 0
      else
        st.phi i

/-- The scalar lane after the source-only initialization at `r=0` from (3.7).

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/1/math`.
Quote: "(\phi_{i,t_\ell},\psi_{i,t_\ell})=\begin{cases}(z_\ell,1),&i=s_\ell,\\(0,0),&i\ne s_\ell,\end{cases}".
-/
noncomputable def preparedPsi (st : State P) (k : ℕ) (i : Node P.n) : ℝ :=
  by
    classical
    exact
      if P.isTransactionStart k then
        if i = P.roundSource k then 1 else 0
      else
        st.psi i

/-- `\widehat x_{i,k}` from the three-channel mixing step (3.8).

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/3/math`.
Quote: "\widehat x_{i,k}=\sum_j(A_k)_{ij}x_{j,k}".
-/
noncomputable def xHat (st : State P) (k : ℕ) (i : Node P.n) : Vec P.d :=
  mixVec k st.x i

/-- `\widehat phi_{i,k}` from (3.8), after the possible round-start lane reset.

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/3/math`.
Quote: "\widehat\phi_{i,k}=\sum_j(A_k)_{ij}\phi_{j,k}".
-/
noncomputable def phiHat (st : State P) (k : ℕ) (i : Node P.n) : Vec P.d :=
  mixVec k (st.preparedPhi k) i

/-- `\widehat psi_{i,k}` from (3.8), after the possible round-start lane reset.

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/3/math`.
Quote: "\widehat\psi_{i,k}=\sum_j(A_k)_{ij}\psi_{j,k}".
-/
noncomputable def psiHat (st : State P) (k : ℕ) (i : Node P.n) : ℝ :=
  mixScalar k (st.preparedPsi k) i

/- Internal raw quotient used only to define the primitive recursive generated
state. The paper-facing decoded payload below is indexed by generated
transaction endpoints, where positivity is a theorem obligation from Lemma 5.2. -/
private noncomputable def rawEndpointDecodedPayload (st : State P) (k : ℕ)
    (i : Node P.n) : Vec P.d :=
  (st.psiHat k i)⁻¹ • st.phiHat k i

/-- The model component of (3.9): `x_{i,k+1}=xhat_{i,k}-gamma d_{i,k}`.

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/4/math`.
Quote: "x_{i,k+1}=\widehat x_{i,k}-\gamma d_{i,k}".
-/
noncomputable def nextX (st : State P) (k : ℕ) (i : Node P.n) : Vec P.d :=
  st.xHat k i - P.gamma • st.direction i

/-- Ledger `R` after applying either (3.10) or the endpoint update (3.12).

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/5/math`.
Quote: "R_{i,k+1}=R_{i,k}".
Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/7/math`.
Quote: "R_{i,k+1}=R_{i,k}+\widetilde z_{i,\ell}".
-/
private noncomputable def rawNextR (st : State P) (k : ℕ) (i : Node P.n) : Vec P.d :=
  by
    classical
    exact
      if hk : isEndpoint (P := P) k then
        st.R i + rawEndpointDecodedPayload st k i
      else
        st.R i

/-- Ledger `c` after applying either (3.10) or the source commit in (3.12).

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/5/math`.
Quote: "c_{i,k+1}=c_{i,k}".
Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/7/math`.
Quote: "c_{i,k+1}=c_{i,k}+\mathbf 1_{\{i=s_\ell\}}\widetilde z_{i,\ell}".
-/
private noncomputable def rawNextC (st : State P) (k : ℕ) (i : Node P.n) : Vec P.d :=
  by
    classical
    exact
      if hk : isEndpoint (P := P) k then
        if i = P.roundSource k then
          st.c i + rawEndpointDecodedPayload st k i
        else
          st.c i
      else
        st.c i

/-- The full one-round R/C-DGD update from Algorithm 1, (3.7)--(3.13).

Source: `book/RCDGD/RCDGD.json#/assumptions/2/math`.
Quote: "通信同步，消息和除法暂按精确实数处理".
Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/2/math`.
Quote: "\phi_{k+1}=A_k\phi_k,\qquad\psi_{k+1}=A_k\psi_k".
Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/8/math`.
Quote: "g_{i,k+1}=\nabla f_i(x_{i,k+1})".
-/
private noncomputable def rawNext (st : State P) (k : ℕ) : State P where
  x := fun i => st.nextX k i
  g := fun i => P.localGradient i (st.nextX k i)
  c := fun i => rawNextC st k i
  R := fun i => rawNextR st k i
  phi := fun i => st.phiHat k i
  psi := fun i => st.psiHat k i

private theorem rawNext_x (st : State P) (k : ℕ) (i : Node P.n) :
    (rawNext st k).x i = st.xHat k i - P.gamma • st.direction i :=
  rfl

private theorem rawNext_g (st : State P) (k : ℕ) (i : Node P.n) :
    (rawNext st k).g i = P.localGradient i ((rawNext st k).x i) :=
  rfl

private theorem rawNext_phi (st : State P) (k : ℕ) (i : Node P.n) :
    (rawNext st k).phi i = st.phiHat k i :=
  rfl

private theorem rawNext_psi (st : State P) (k : ℕ) (i : Node P.n) :
    (rawNext st k).psi i = st.psiHat k i :=
  rfl

private theorem rawNext_R_of_not_endpoint (st : State P) (k : ℕ) (i : Node P.n)
    (hk : ¬ isEndpoint (P := P) k) :
    (rawNext st k).R i = st.R i := by
  simp [rawNext, rawNextR, hk]

private theorem rawNext_c_of_not_endpoint (st : State P) (k : ℕ) (i : Node P.n)
    (hk : ¬ isEndpoint (P := P) k) :
    (rawNext st k).c i = st.c i := by
  simp [rawNext, rawNextC, hk]

private theorem rawNext_R_of_endpoint (st : State P) (k : ℕ) (i : Node P.n)
    (hk : isEndpoint (P := P) k) :
    (rawNext st k).R i = st.R i + rawEndpointDecodedPayload st k i := by
  simp [rawNext, rawNextR, hk]

private theorem rawNext_c_source_of_endpoint (st : State P) (k : ℕ) (i : Node P.n)
    (hk : isEndpoint (P := P) k) (hi : i = P.roundSource k) :
    (rawNext st k).c i = st.c i + rawEndpointDecodedPayload st k i := by
  simp [rawNext, rawNextC, hk, hi]

private theorem rawNext_c_other_of_endpoint (st : State P) (k : ℕ) (i : Node P.n)
    (hk : isEndpoint (P := P) k) (hi : i ≠ P.roundSource k) :
    (rawNext st k).c i = st.c i := by
  simp [rawNext, rawNextC, hk, hi]

end State

/-- The canonical generated R/C-DGD state sequence, defined by primitive
recursion from the literal Algorithm 1 transition.

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/1`.
Quote: "r=0 ... (phi,psi)".
Source: `book/RCDGD/RCDGD.json#/algorithm_spec/output/math`.
Quote: "X_0,X_1,\ldots,X_T".
Source: `book/RCDGD/RCDGD.json#/algorithm_spec/output/description`.
Quote: "all formal per-communication-round model states".
-/
noncomputable def stateSeq (P : Setup) : ℕ → State P
  | 0 => State.initial P
  | k + 1 => State.rawNext (stateSeq P k) k

/-- Source-facing semantics for a generated R/C-DGD state sequence.

The canonical object is the generated Algorithm 1 process below; this predicate
records equality with that process rather than exposing the implementation
quotient used to realize the recursion in total Lean functions.

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/output/math`.
Quote: "X_0,X_1,\ldots,X_T".
-/
def stateSeqSemantics (P : Setup) (σ : ℕ → State P) : Prop :=
  σ = stateSeq P

/-- The recursively generated process satisfies the paper-facing state-sequence
semantics. -/
theorem stateSeq_semantics (P : Setup) :
    stateSeqSemantics P (stateSeq P) :=
  rfl

/-- Existence form of the generated process, now derived from the canonical
recursive definition rather than used to choose the process. -/
theorem stateSeqSemantics_exists (P : Setup) :
    ∃ σ : ℕ → State P, stateSeqSemantics P σ :=
  ⟨stateSeq P, stateSeq_semantics P⟩

namespace State

/-- The decoded endpoint payload `tilde z_{i,ell}=phihat/psihat` from (3.11),
exposed only at generated transaction endpoints. The denominator positivity at
the same endpoint is the derived theorem `endpoint_decode_denominator_pos`.

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/6/math`.
Quote: "k=t_\ell+H-1:\quad\widetilde z_{i,\ell}=\frac{\widehat\phi_{i,k}}{\widehat\psi_{i,k}}".
Source: `book/RCDGD/RCDGD.json#/key_lemmas/4/proof/2/math`.
Quote: "\psi_{i,t+H}=e_i^\top Pe_s=P_{is}\ge\beta>0".
-/
noncomputable def endpointDecodedPayload (P : Setup) (ell : ℕ)
    (i : Node P.n) : Vec P.d :=
  rawEndpointDecodedPayload (stateSeq P (P.transactionEnd ell)) (P.transactionEnd ell) i

end State

/-- Chronological product of the row-stochastic mixing matrices:
`W(t,0)=I` and `W(t,r+1)=A_{t+r} W(t,r)`.

The orientation matches `State.mixScalar` and `State.mixVec`, whose row `i`
forms `∑ j, A k i j * v j`. -/
private noncomputable def mixingProduct (P : Setup) (t : ℕ) :
    ℕ → Node P.n → Node P.n → ℝ
  | 0, i, j => if i = j then 1 else 0
  | r + 1, i, j => ∑ u : Node P.n, P.mixing (t + r) i u * mixingProduct P t r u j

private theorem mixingProduct_zero (P : Setup) (t : ℕ) (i j : Node P.n) :
    mixingProduct P t 0 i j = if i = j then 1 else 0 :=
  rfl

private theorem mixingProduct_succ (P : Setup) (t r : ℕ) (i j : Node P.n) :
    mixingProduct P t (r + 1) i j =
      ∑ u : Node P.n, P.mixing (t + r) i u * mixingProduct P t r u j :=
  rfl

private theorem mixingProduct_nonneg (P : Setup) (t r : ℕ) (i j : Node P.n) :
    0 ≤ mixingProduct P t r i j := by
  induction r generalizing i j with
  | zero =>
      by_cases hij : i = j <;> simp [mixingProduct_zero, hij]
  | succ r ih =>
      rw [mixingProduct_succ]
      exact Finset.sum_nonneg fun u _ =>
        mul_nonneg (P.hnetwork.row_nonneg (t + r) i u) (ih u j)

private theorem mixingProduct_row_sum (P : Setup) (t r : ℕ) (i : Node P.n) :
    (∑ j : Node P.n, mixingProduct P t r i j) = 1 := by
  induction r generalizing i with
  | zero =>
      classical
      simp [mixingProduct_zero]
  | succ r ih =>
      change
        (∑ j : Node P.n, ∑ u : Node P.n,
          P.mixing (t + r) i u * mixingProduct P t r u j) = 1
      calc
        (∑ j : Node P.n, ∑ u : Node P.n,
            P.mixing (t + r) i u * mixingProduct P t r u j)
            = ∑ u : Node P.n, ∑ j : Node P.n,
                P.mixing (t + r) i u * mixingProduct P t r u j := by
              rw [Finset.sum_comm]
        _ = ∑ u : Node P.n, P.mixing (t + r) i u *
              ∑ j : Node P.n, mixingProduct P t r u j := by
              congr
              ext u
              rw [Finset.mul_sum]
        _ = ∑ u : Node P.n, P.mixing (t + r) i u := by
              simp [ih]
        _ = 1 := P.hnetwork.row_sum (t + r) i

private theorem mixingProduct_apply_succ_smul_sum (P : Setup) (t r : ℕ)
    (i : Node P.n) (v : Node P.n → Vec P.d) :
    (∑ s : Node P.n, mixingProduct P t (r + 1) i s • v s) =
      ∑ u : Node P.n, P.mixing (t + r) i u •
        (∑ s : Node P.n, mixingProduct P t r u s • v s) := by
  classical
  calc
    (∑ s : Node P.n, mixingProduct P t (r + 1) i s • v s)
        = ∑ s : Node P.n,
            (∑ u : Node P.n, P.mixing (t + r) i u *
                mixingProduct P t r u s) • v s := by
          simp [mixingProduct_succ]
    _ = ∑ s : Node P.n,
            ∑ u : Node P.n,
              (P.mixing (t + r) i u * mixingProduct P t r u s) • v s := by
          refine Finset.sum_congr rfl ?_
          intro s _hs
          rw [Finset.sum_smul]
    _ = ∑ s : Node P.n,
            ∑ u : Node P.n,
              P.mixing (t + r) i u •
                (mixingProduct P t r u s • v s) := by
          refine Finset.sum_congr rfl ?_
          intro s _hs
          refine Finset.sum_congr rfl ?_
          intro u _hu
          rw [smul_smul]
    _ = ∑ u : Node P.n,
          ∑ s : Node P.n,
            P.mixing (t + r) i u •
              (mixingProduct P t r u s • v s) := by
          rw [Finset.sum_comm]
    _ = ∑ u : Node P.n, P.mixing (t + r) i u •
        (∑ s : Node P.n, mixingProduct P t r u s • v s) := by
          refine Finset.sum_congr rfl ?_
          intro u _hu
          rw [Finset.smul_sum]

private theorem mixingProduct_apply_zero_smul_sum (P : Setup) (t : ℕ)
    (i : Node P.n) (v : Node P.n → Vec P.d) :
    (∑ s : Node P.n, mixingProduct P t 0 i s • v s) = v i := by
  classical
  simp [mixingProduct_zero]

private theorem mixingProduct_apply_one_smul_sum (P : Setup) (t : ℕ)
    (i : Node P.n) (v : Node P.n → Vec P.d) :
    (∑ s : Node P.n, mixingProduct P t 1 i s • v s) =
      ∑ s : Node P.n, P.mixing t i s • v s := by
  classical
  rw [mixingProduct_apply_succ_smul_sum]
  simp [mixingProduct_apply_zero_smul_sum]

private theorem mixingProduct_suffix_prepend_apply_smul_sum (P : Setup)
    (t r q : ℕ) (hq : q < r) (i : Node P.n) (v : Node P.n → Vec P.d) :
    (∑ u : Node P.n, P.mixing (t + r) i u •
        (∑ s : Node P.n,
          mixingProduct P (t + q + 1) (r - 1 - q) u s • v s)) =
      ∑ s : Node P.n,
        mixingProduct P (t + q + 1) (r - q) i s • v s := by
  have htime : t + q + 1 + (r - 1 - q) = t + r := by
    omega
  have hlen : r - 1 - q + 1 = r - q := by
    omega
  calc
    (∑ u : Node P.n, P.mixing (t + r) i u •
        (∑ s : Node P.n,
          mixingProduct P (t + q + 1) (r - 1 - q) u s • v s))
        =
      (∑ u : Node P.n, P.mixing (t + q + 1 + (r - 1 - q)) i u •
        (∑ s : Node P.n,
          mixingProduct P (t + q + 1) (r - 1 - q) u s • v s)) := by
          rw [htime]
    _ =
      ∑ s : Node P.n,
        mixingProduct P (t + q + 1) ((r - 1 - q) + 1) i s • v s := by
          rw [← mixingProduct_apply_succ_smul_sum]
    _ =
      ∑ s : Node P.n,
        mixingProduct P (t + q + 1) (r - q) i s • v s := by
          rw [hlen]

private theorem finset_sum_smul_sub_gamma_smul_sum (P : Setup)
    (a : Node P.n → ℝ) (y z : Node P.n → Vec P.d) (γ : ℝ) :
    (∑ u : Node P.n, a u • (y u - γ • z u)) =
      (∑ u : Node P.n, a u • y u) -
        γ • (∑ u : Node P.n, a u • z u) := by
  classical
  calc
    (∑ u : Node P.n, a u • (y u - γ • z u))
        = ∑ u : Node P.n, (a u • y u - a u • (γ • z u)) := by
          refine Finset.sum_congr rfl ?_
          intro u _hu
          rw [smul_sub]
    _ = (∑ u : Node P.n, a u • y u) -
          ∑ u : Node P.n, a u • (γ • z u) := by
          rw [Finset.sum_sub_distrib]
    _ = (∑ u : Node P.n, a u • y u) -
          ∑ u : Node P.n, γ • (a u • z u) := by
          refine congrArg (fun w => (∑ u : Node P.n, a u • y u) - w) ?_
          refine Finset.sum_congr rfl ?_
          intro u _hu
          rw [smul_smul, smul_smul]
          ring_nf
    _ = (∑ u : Node P.n, a u • y u) -
          γ • (∑ u : Node P.n, a u • z u) := by
          rw [Finset.smul_sum]

private theorem exists_crossing_edge_of_reflTransGen_from_not_mem_to_mem
    {α : Type*} [DecidableEq α] (R : α → α → Prop) (S : Finset α)
    {x y : α} (hxy : Relation.ReflTransGen R x y) (hx : x ∉ S) (hy : y ∈ S) :
    ∃ a b, a ∉ S ∧ b ∈ S ∧ R a b := by
  induction hxy with
  | refl =>
      exact (hx hy).elim
  | tail hprev hstep ih =>
      rename_i b c
      by_cases hb : b ∈ S
      · exact ih hb
      · exact ⟨b, c, hb, hy, hstep⟩

private theorem mixingProduct_step_lower_of_edge (P : Setup) (t r : ℕ)
    (i u s : Node P.n)
    (hA : P.aMin ≤ P.mixing (t + r) i u)
    (hprev : P.aMin ^ r ≤ mixingProduct P t r u s) :
    P.aMin ^ (r + 1) ≤ mixingProduct P t (r + 1) i s := by
  classical
  rw [mixingProduct_succ]
  have hterm :
      P.aMin ^ (r + 1) ≤ P.mixing (t + r) i u * mixingProduct P t r u s := by
    calc
      P.aMin ^ (r + 1) = P.aMin ^ r * P.aMin := by
        rw [pow_succ]
      _ ≤ mixingProduct P t r u s * P.mixing (t + r) i u := by
        exact mul_le_mul hprev hA (le_of_lt P.haMin.1)
          (mixingProduct_nonneg P t r u s)
      _ = P.mixing (t + r) i u * mixingProduct P t r u s := by
        ring
  refine le_trans hterm ?_
  exact Finset.single_le_sum
    (fun v _ => mul_nonneg (P.hnetwork.row_nonneg (t + r) i v)
      (mixingProduct_nonneg P t r v s))
    (Finset.mem_univ u)

private theorem mixingProduct_step_lower_of_positive_edge (P : Setup) (t r : ℕ)
    (i u s : Node P.n)
    (hedge : 0 < P.mixing (t + r) i u)
    (hprev : P.aMin ^ r ≤ mixingProduct P t r u s) :
    P.aMin ^ (r + 1) ≤ mixingProduct P t (r + 1) i s :=
  mixingProduct_step_lower_of_edge P t r i u s
    (P.hnetwork.positive_entry_lower (t + r) i u hedge) hprev

private theorem mixingProduct_step_lower_of_diagonal (P : Setup) (t r : ℕ)
    (i s : Node P.n)
    (hprev : P.aMin ^ r ≤ mixingProduct P t r i s) :
    P.aMin ^ (r + 1) ≤ mixingProduct P t (r + 1) i s :=
  mixingProduct_step_lower_of_positive_edge P t r i i s
    (P.hnetwork.positive_diagonal (t + r) i) hprev

private theorem mixingProduct_pad_lower (P : Setup) (t r m : ℕ)
    (i s : Node P.n)
    (hprev : P.aMin ^ r ≤ mixingProduct P t r i s) :
    P.aMin ^ (r + m) ≤ mixingProduct P t (r + m) i s := by
  induction m with
  | zero =>
      simpa using hprev
  | succ m ih =>
      have hstep := mixingProduct_step_lower_of_diagonal P t (r + m) i s ih
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hstep

private theorem exists_b_window_crossing_edge_of_nonempty_ne_univ (P : Setup)
    (t : ℕ) (S : Finset (Node P.n)) (hne : S.Nonempty)
    (hproper : S ≠ Finset.univ) :
    ∃ a b : Node P.n,
      a ∉ S ∧ b ∈ S ∧ ∃ r : ℕ, r < P.B ∧ 0 < P.mixing (t + r) a b := by
  classical
  rcases hne with ⟨y, hy⟩
  have houtside : ∃ x : Node P.n, x ∉ S := by
    by_contra h
    apply hproper
    ext x
    constructor
    · intro _
      exact Finset.mem_univ x
    · intro _
      by_contra hx
      exact h ⟨x, hx⟩
  rcases houtside with ⟨x, hx⟩
  have hpath :
      Relation.ReflTransGen
        (fun u v : Node P.n => ∃ r : ℕ, r < P.B ∧ 0 < P.mixing (t + r) u v) x y := by
    simpa [bWindowReachable] using P.hnetwork.b_window_strongly_connected t x y
  exact exists_crossing_edge_of_reflTransGen_from_not_mem_to_mem
    (fun u v : Node P.n => ∃ r : ℕ, r < P.B ∧ 0 < P.mixing (t + r) u v)
    S hpath hx hy

private theorem mixingProduct_block_edge_lower (P : Setup) (t q r : ℕ)
    (a b s : Node P.n)
    (hr : r < P.B)
    (hprev : P.aMin ^ (q * P.B) ≤ mixingProduct P t (q * P.B) b s)
    (hedge : 0 < P.mixing (t + (q * P.B + r)) a b) :
    P.aMin ^ ((q + 1) * P.B) ≤
      mixingProduct P t ((q + 1) * P.B) a s := by
  have hpad_to_edge :
      P.aMin ^ (q * P.B + r) ≤ mixingProduct P t (q * P.B + r) b s :=
    mixingProduct_pad_lower P t (q * P.B) r b s hprev
  have hafter_edge :
      P.aMin ^ (q * P.B + r + 1) ≤
        mixingProduct P t (q * P.B + r + 1) a s := by
    simpa [Nat.add_assoc] using
      mixingProduct_step_lower_of_positive_edge P t (q * P.B + r) a b s hedge hpad_to_edge
  have hle : q * P.B + r + 1 ≤ (q + 1) * P.B := by
    nlinarith [hr]
  have htarget :=
    mixingProduct_pad_lower P t (q * P.B + r + 1)
      (((q + 1) * P.B) - (q * P.B + r + 1)) a s hafter_edge
  simpa [Nat.add_sub_of_le hle] using htarget

private theorem good_set_grows_over_B_window (P : Setup) (t q : ℕ)
    (s : Node P.n)
    (hproper :
      (Finset.univ.filter fun v : Node P.n =>
        P.aMin ^ (q * P.B) ≤ mixingProduct P t (q * P.B) v s) ≠ Finset.univ) :
    (Finset.univ.filter fun v : Node P.n =>
        P.aMin ^ ((q + 1) * P.B) ≤ mixingProduct P t ((q + 1) * P.B) v s).card ≥
      (Finset.univ.filter fun v : Node P.n =>
        P.aMin ^ (q * P.B) ≤ mixingProduct P t (q * P.B) v s).card + 1 := by
  classical
  let S : Finset (Node P.n) :=
    Finset.univ.filter fun v : Node P.n =>
      P.aMin ^ (q * P.B) ≤ mixingProduct P t (q * P.B) v s
  let T : Finset (Node P.n) :=
    Finset.univ.filter fun v : Node P.n =>
      P.aMin ^ ((q + 1) * P.B) ≤ mixingProduct P t ((q + 1) * P.B) v s
  have hS_def :
      S =
        Finset.univ.filter fun v : Node P.n =>
          P.aMin ^ (q * P.B) ≤ mixingProduct P t (q * P.B) v s := rfl
  have hT_def :
      T =
        Finset.univ.filter fun v : Node P.n =>
          P.aMin ^ ((q + 1) * P.B) ≤ mixingProduct P t ((q + 1) * P.B) v s := rfl
  have hSproper : S ≠ Finset.univ := by
    simpa [S] using hproper
  have hs_base : P.aMin ^ 0 ≤ mixingProduct P t 0 s s := by
    simp [mixingProduct_zero]
  have hs_mem : s ∈ S := by
    have hpad :
        P.aMin ^ (0 + q * P.B) ≤ mixingProduct P t (0 + q * P.B) s s :=
      mixingProduct_pad_lower P t 0 (q * P.B) s s hs_base
    simpa [S] using hpad
  have hS_nonempty : S.Nonempty := ⟨s, hs_mem⟩
  rcases exists_b_window_crossing_edge_of_nonempty_ne_univ P (t + q * P.B) S
      hS_nonempty hSproper with
    ⟨a, b, haS, hbS, r, hr, hedge⟩
  have hS_subset_T : S ⊆ T := by
    intro v hv
    have hv_lower :
        P.aMin ^ (q * P.B) ≤ mixingProduct P t (q * P.B) v s := by
      simpa [S] using hv
    have hpad :
        P.aMin ^ (q * P.B + P.B) ≤
          mixingProduct P t (q * P.B + P.B) v s :=
      mixingProduct_pad_lower P t (q * P.B) P.B v s hv_lower
    have hidx : q * P.B + P.B = (q + 1) * P.B := by
      ring
    simpa [T, hidx] using hpad
  have hb_lower :
      P.aMin ^ (q * P.B) ≤ mixingProduct P t (q * P.B) b s := by
    simpa [S] using hbS
  have hedge' : 0 < P.mixing (t + (q * P.B + r)) a b := by
    simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hedge
  have haT : a ∈ T := by
    have ha_lower :=
      mixingProduct_block_edge_lower P t q r a b s hr hb_lower hedge'
    simpa [T] using ha_lower
  have hinsert_subset : insert a S ⊆ T := by
    intro v hv
    simp only [Finset.mem_insert] at hv
    rcases hv with rfl | hvS
    · exact haT
    · exact hS_subset_T hvS
  have hcard_insert : (insert a S).card = S.card + 1 := by
    simpa using Finset.card_insert_of_notMem haS
  have hcard_le : (insert a S).card ≤ T.card :=
    Finset.card_le_card hinsert_subset
  have hgrowth : S.card + 1 ≤ T.card := by
    simpa [hcard_insert] using hcard_le
  simpa [S, T] using hgrowth

private theorem mixingProduct_full_blocks_lower (P : Setup) (t : ℕ)
    (s i : Node P.n) :
    P.aMin ^ ((P.n - 1) * P.B) ≤
      mixingProduct P t ((P.n - 1) * P.B) i s := by
  classical
  let Good : ℕ → Finset (Node P.n) := fun q =>
    Finset.univ.filter fun v : Node P.n =>
      P.aMin ^ (q * P.B) ≤ mixingProduct P t (q * P.B) v s
  have hmono_card : ∀ q : ℕ, (Good q).card ≤ (Good (q + 1)).card := by
    intro q
    apply Finset.card_le_card
    intro v hv
    have hv_lower :
        P.aMin ^ (q * P.B) ≤ mixingProduct P t (q * P.B) v s := by
      simpa [Good] using hv
    have hpad :
        P.aMin ^ (q * P.B + P.B) ≤
          mixingProduct P t (q * P.B + P.B) v s :=
      mixingProduct_pad_lower P t (q * P.B) P.B v s hv_lower
    have hidx : q * P.B + P.B = (q + 1) * P.B := by
      ring
    simpa [Good, hidx] using hpad
  have hcard_lower : ∀ q : ℕ, q ≤ P.n - 1 → q + 1 ≤ (Good q).card := by
    intro q hq
    induction q with
    | zero =>
        have hs_base : P.aMin ^ 0 ≤ mixingProduct P t 0 s s := by
          simp [mixingProduct_zero]
        have hs_mem : s ∈ Good 0 := by
          simpa [Good] using hs_base
        exact Finset.one_le_card.mpr ⟨s, hs_mem⟩
    | succ q ih =>
        have hqprev : q ≤ P.n - 1 := Nat.le_trans (Nat.le_succ q) hq
        have ihq : q + 1 ≤ (Good q).card := ih hqprev
        by_cases hproper : Good q ≠ Finset.univ
        · have hgrow : (Good (q + 1)).card ≥ (Good q).card + 1 := by
            simpa [Good] using good_set_grows_over_B_window P t q s hproper
          omega
        · have huniv : Good q = Finset.univ := of_not_not hproper
          have hcard_univ : (Good q).card = P.n := by
            simp [huniv, Good, Node]
          have hmono := hmono_card q
          have hq_bound : q + 2 ≤ P.n := by
            omega
          omega
  have hfinal_card : P.n ≤ (Good (P.n - 1)).card := by
    have h := hcard_lower (P.n - 1) (le_rfl)
    omega
  by_contra hnot
  have hi_not_mem : i ∉ Good (P.n - 1) := by
    simpa [Good] using hnot
  have hinsert_subset :
      insert i (Good (P.n - 1)) ⊆ (Finset.univ : Finset (Node P.n)) := by
    intro v hv
    exact Finset.mem_univ v
  have hinsert_card :
      (insert i (Good (P.n - 1))).card = (Good (P.n - 1)).card + 1 := by
    exact Finset.card_insert_of_notMem hi_not_mem
  have hle_univ :
      (insert i (Good (P.n - 1))).card ≤
        (Finset.univ : Finset (Node P.n)).card :=
    Finset.card_le_card hinsert_subset
  have hcard_univ : (Finset.univ : Finset (Node P.n)).card = P.n := by
    simp [Node]
  omega

private theorem transactionStart_add_not_start (P : Setup) (ell r : ℕ)
    (hrpos : 0 < r) (hr : r < P.H) :
    ¬ P.isTransactionStart (P.transactionStart ell + r) := by
  rw [P.isTransactionStart_iff_remainder_zero]
  unfold Setup.transactionRemainder Setup.transactionStart
  have hmod : (ell * P.H + r) % P.H = r := by
    rw [Nat.mul_comm ell P.H]
    rw [Nat.add_comm]
    rw [Nat.add_mul_mod_self_left]
    exact Nat.mod_eq_of_lt hr
  rw [hmod]
  omega

private theorem mixingProduct_onehot_lane_transport (P : Setup) (ell r : ℕ)
    (hr : r < P.H) (i : Node P.n) :
    State.psiHat (stateSeq P (P.transactionStart ell + r)) (P.transactionStart ell + r) i =
        mixingProduct P (P.transactionStart ell) (r + 1) i (P.sourceIndex ell) ∧
      State.phiHat (stateSeq P (P.transactionStart ell + r)) (P.transactionStart ell + r) i =
        mixingProduct P (P.transactionStart ell) (r + 1) i (P.sourceIndex ell) •
          State.sourcePayload (stateSeq P (P.transactionStart ell))
            (P.transactionStart ell) := by
  classical
  induction r generalizing i with
  | zero =>
      constructor
      · simp [State.psiHat, State.mixScalar, mixingProduct_succ, mixingProduct_zero,
          State.preparedPsi, P.transactionStart_isTransactionStart ell,
          P.roundSource_transactionStart ell]
      · simp [State.phiHat, State.mixVec, mixingProduct_succ, mixingProduct_zero,
          State.preparedPhi, P.transactionStart_isTransactionStart ell,
          P.roundSource_transactionStart ell]
  | succ r ih =>
      have hr_prev : r < P.H := Nat.lt_trans (Nat.lt_succ_self r) hr
      have hnot_start :
          ¬ P.isTransactionStart (P.transactionStart ell + (r + 1)) :=
        transactionStart_add_not_start P ell (r + 1) (Nat.succ_pos r) hr
      have hpsi_prep :
          ∀ u : Node P.n,
            State.preparedPsi (stateSeq P (P.transactionStart ell + (r + 1)))
                (P.transactionStart ell + (r + 1)) u =
              State.psiHat (stateSeq P (P.transactionStart ell + r))
                (P.transactionStart ell + r) u := by
        intro u
        have hseq :
            (stateSeq P (P.transactionStart ell + (r + 1))).psi u =
              State.psiHat (stateSeq P (P.transactionStart ell + r))
                (P.transactionStart ell + r) u := by
          have hnat : P.transactionStart ell + (r + 1) =
              P.transactionStart ell + r + 1 := by
            omega
          rw [hnat]
          rfl
        simp [State.preparedPsi, hnot_start, hseq]
      have hphi_prep :
          ∀ u : Node P.n,
            State.preparedPhi (stateSeq P (P.transactionStart ell + (r + 1)))
                (P.transactionStart ell + (r + 1)) u =
              State.phiHat (stateSeq P (P.transactionStart ell + r))
                (P.transactionStart ell + r) u := by
        intro u
        have hseq :
            (stateSeq P (P.transactionStart ell + (r + 1))).phi u =
              State.phiHat (stateSeq P (P.transactionStart ell + r))
                (P.transactionStart ell + r) u := by
          have hnat : P.transactionStart ell + (r + 1) =
              P.transactionStart ell + r + 1 := by
            omega
          rw [hnat]
          rfl
        simp [State.preparedPhi, hnot_start, hseq]
      constructor
      · calc
          State.psiHat (stateSeq P (P.transactionStart ell + (r + 1)))
              (P.transactionStart ell + (r + 1)) i
              = ∑ u : Node P.n,
                  P.mixing (P.transactionStart ell + (r + 1)) i u *
                    State.psiHat (stateSeq P (P.transactionStart ell + r))
                      (P.transactionStart ell + r) u := by
                simp [State.psiHat, State.mixScalar, hpsi_prep]
          _ = ∑ u : Node P.n,
                  P.mixing (P.transactionStart ell + (r + 1)) i u *
                    mixingProduct P (P.transactionStart ell) (r + 1) u
                      (P.sourceIndex ell) := by
                apply Finset.sum_congr rfl
                intro u _
                rw [(ih hr_prev u).1]
          _ = mixingProduct P (P.transactionStart ell) ((r + 1) + 1) i
                (P.sourceIndex ell) := by
                rw [mixingProduct_succ]
      · calc
          State.phiHat (stateSeq P (P.transactionStart ell + (r + 1)))
              (P.transactionStart ell + (r + 1)) i
              = ∑ u : Node P.n,
                  P.mixing (P.transactionStart ell + (r + 1)) i u •
                    State.phiHat (stateSeq P (P.transactionStart ell + r))
                      (P.transactionStart ell + r) u := by
                simp [State.phiHat, State.mixVec, hphi_prep]
          _ = ∑ u : Node P.n,
                  P.mixing (P.transactionStart ell + (r + 1)) i u •
                    (mixingProduct P (P.transactionStart ell) (r + 1) u
                      (P.sourceIndex ell) •
                        State.sourcePayload (stateSeq P (P.transactionStart ell))
                          (P.transactionStart ell)) := by
                apply Finset.sum_congr rfl
                intro u _
                rw [(ih hr_prev u).2]
          _ = ∑ u : Node P.n,
                  (P.mixing (P.transactionStart ell + (r + 1)) i u *
                    mixingProduct P (P.transactionStart ell) (r + 1) u
                      (P.sourceIndex ell)) •
                        State.sourcePayload (stateSeq P (P.transactionStart ell))
                          (P.transactionStart ell) := by
                apply Finset.sum_congr rfl
                intro u _
                simp [smul_smul]
          _ = (∑ u : Node P.n,
                  P.mixing (P.transactionStart ell + (r + 1)) i u *
                    mixingProduct P (P.transactionStart ell) (r + 1) u
                      (P.sourceIndex ell)) •
                State.sourcePayload (stateSeq P (P.transactionStart ell))
                  (P.transactionStart ell) := by
                rw [← Finset.sum_smul]
          _ = mixingProduct P (P.transactionStart ell) ((r + 1) + 1) i
                (P.sourceIndex ell) •
                State.sourcePayload (stateSeq P (P.transactionStart ell))
                  (P.transactionStart ell) := by
                rw [mixingProduct_succ]

private theorem mixingProduct_h_round_mass_lower_bound (P : Setup) (t : ℕ)
    (s i : Node P.n) :
    P.beta ≤ mixingProduct P t P.H i s := by
  classical
  have hblocks :
      P.aMin ^ ((P.n - 1) * P.B) ≤
        mixingProduct P t ((P.n - 1) * P.B) i s :=
    mixingProduct_full_blocks_lower P t s i
  have hleH : (P.n - 1) * P.B ≤ P.H := by
    unfold Setup.H
    exact le_max_right 1 ((P.n - 1) * P.B)
  have hpad :=
    mixingProduct_pad_lower P t ((P.n - 1) * P.B)
      (P.H - ((P.n - 1) * P.B)) i s hblocks
  simpa [Setup.beta, Nat.add_sub_of_le hleH] using hpad

private theorem mixingProduct_h_round_residual_nonneg (P : Setup) (t : ℕ)
    (i s : Node P.n) :
    0 ≤ mixingProduct P t P.H i s - P.beta := by
  exact sub_nonneg.mpr (mixingProduct_h_round_mass_lower_bound P t s i)

private theorem n_mul_beta_le_one_of_h_round_product (P : Setup) :
    (P.n : ℝ) * P.beta ≤ 1 := by
  classical
  let i0 : Node P.n := P.sourceIndex 0
  have hsum_le :
      (∑ s : Node P.n, P.beta) ≤
        ∑ s : Node P.n, mixingProduct P 0 P.H i0 s := by
    exact Finset.sum_le_sum fun s _ =>
      mixingProduct_h_round_mass_lower_bound P 0 s i0
  have hsum_const :
      (∑ _s : Node P.n, P.beta) = (Fintype.card (Node P.n) : ℝ) * P.beta := by
    simp
  have hcard : (Fintype.card (Node P.n) : ℝ) = (P.n : ℝ) := by
    simp [Node]
  calc
    (P.n : ℝ) * P.beta = ∑ s : Node P.n, P.beta := by
      rw [hsum_const, hcard]
    _ ≤ ∑ s : Node P.n, mixingProduct P 0 P.H i0 s := hsum_le
    _ = 1 := mixingProduct_row_sum P 0 P.H i0

/-- The generated model stack `X_k`.

Source: `book/RCDGD/RCDGD.json#/setup/variable_space/math`.
Quote: "X_k=[x_{1,k}^\top;\ldots;x_{n,k}^\top]\in\R^{n\times d}".
-/
noncomputable def X (P : Setup) (k : ℕ) : Node P.n → Vec P.d :=
  (stateSeq P k).x

/-- The generated current-gradient stack `g_{i,k}=∇f_i(x_{i,k})`.

Source: `book/RCDGD/RCDGD.json#/setup/variable_space/math`.
Quote: "g_{i,k}:=\nabla f_i(x_{i,k})".
-/
noncomputable def G (P : Setup) (k : ℕ) : Node P.n → Vec P.d :=
  (stateSeq P k).g

/-- The arithmetic mean `bar x_k = n^{-1} 1^T X_k` from (2.2).

Source: `book/RCDGD/RCDGD.json#/setup/variable_space/math`.
Quote: "\bar x_k=\frac1n\mathbf 1^\top X_k".
-/
noncomputable def xBar (P : Setup) (k : ℕ) : Vec P.d :=
  ((P.n : ℝ)⁻¹) • ∑ i : Node P.n, X P k i

/-- The consensus diameter `Delta_k=max_{i,j} ||x_{i,k}-x_{j,k}||` from (2.2).

Source: `book/RCDGD/RCDGD.json#/setup/variable_space/math`.
Quote: "\Delta_k=\max_{i,j}\|x_{i,k}-x_{j,k}\|".
-/
noncomputable def Delta (P : Setup) (k : ℕ) : ℝ :=
  Finset.univ.sup'
    (show (Finset.univ : Finset (Node P.n × Node P.n)).Nonempty from
      ⟨(P.sourceIndex 0, P.sourceIndex 0), Finset.mem_univ _⟩)
    (fun p : Node P.n × Node P.n => ‖X P k p.1 - X P k p.2‖)

/-- The one-round displacement `a_k=max_i ||x_{i,k+1}-x_{i,k}||` from (2.2).

Source: `book/RCDGD/RCDGD.json#/setup/variable_space/math`.
Quote: "a_k:=\max_i\|x_{i,k+1}-x_{i,k}\|".
-/
noncomputable def roundDisplacement (P : Setup) (k : ℕ) : ℝ :=
  Finset.univ.sup'
    (show (Finset.univ : Finset (Node P.n)).Nonempty from
      ⟨P.sourceIndex 0, Finset.mem_univ _⟩)
    (fun i : Node P.n => ‖X P (k + 1) i - X P k i‖)

namespace Setup

/-- The contraction constant `rho = 1 - n beta` from (4.1).

Source: `book/RCDGD/RCDGD.json#/key_lemmas/7/statement_math`.
Quote: "\rho=1-n\beta".
-/
noncomputable def rho (P : Setup) : ℝ :=
  1 - (P.n : ℝ) * P.beta

/-- The disagreement gain constant `C_N = 6H/(n beta)` from (4.1).

Source: `book/RCDGD/RCDGD.json#/key_lemmas/7/statement_math`.
Quote: "C_N=\frac{6H}{n\beta}".
-/
noncomputable def C_N (P : Setup) : ℝ :=
  (6 * (P.H : ℝ)) / ((P.n : ℝ) * P.beta)

/-- The denominator `n β` in `C_N=6H/(nβ)` is source-derived positive, so the
displayed quotient is not relying on Lean's totalized division at zero.

Source: `book/RCDGD/RCDGD.json#/key_lemmas/7/proof/1/math`.
Quote: "0\le\rho<1" is derived from row-stochasticity and positive H-step mass.
Source: `book/RCDGD/RCDGD.json#/key_lemmas/3/statement_math`.
Quote: "P_{is}\ge\beta=a_{\min}^H>0".
-/
theorem C_N_denominator_pos (P : Setup) :
    0 < (P.n : ℝ) * P.beta := by
  exact mul_pos P.n_pos_real P.beta_pos

/-- Nonzero form of the source-derived denominator condition for `C_N`. -/
theorem C_N_denominator_ne_zero (P : Setup) :
    (P.n : ℝ) * P.beta ≠ 0 :=
  ne_of_gt P.C_N_denominator_pos

/-- The paper-derived range of the Dobrushin factor `rho=1-nβ`.

This is a proof obligation from the network assumptions and Lemma 5.1, not a
primitive setup assumption.

Source: `book/RCDGD/RCDGD.json#/key_lemmas/7/proof/1/math`.
Quote: "0\le\rho<1".
-/
theorem rho_range (P : Setup) : 0 ≤ P.rho ∧ P.rho < 1 := by
  have hnbeta : (P.n : ℝ) * P.beta ≤ 1 :=
    n_mul_beta_le_one_of_h_round_product P
  have hnbeta_pos : 0 < (P.n : ℝ) * P.beta :=
    P.C_N_denominator_pos
  unfold rho
  constructor <;> nlinarith

/-- The finite-prefix displacement `A_pre = sum_{k=0}^{K_0-1} a_k` from (4.2).

Source: `book/RCDGD/RCDGD.json#/key_lemmas/7/statement_math`.
Quote: "A_{\rm pre}=\sum_{k=0}^{K_0-1}a_k".
-/
noncomputable def A_pre (P : Setup) : ℝ :=
  ∑ k ∈ Finset.range P.K0, roundDisplacement P k

/-- The finite-prefix gradient energy `C_pre` from (4.2).

Source: `book/RCDGD/RCDGD.json#/key_lemmas/7/statement_math`.
Quote: "C_{\rm pre}=\sum_{k=0}^{K_0-1}\|\nabla f(\bar x_k)\|^2".
-/
noncomputable def C_pre (P : Setup) : ℝ :=
  ∑ k ∈ Finset.range P.K0, ‖P.aggregateGradient (xBar P k)‖ ^ (2 : ℕ)

/-- The initial disagreement constant `A_0` from (4.2).

Source: `book/RCDGD/RCDGD.json#/key_lemmas/7/statement_math`.
Quote: "A_0=\sqrt{\frac{2H}{1-\rho^2}}\,\Delta_{K_0}".
-/
noncomputable def A_0 (P : Setup) : ℝ :=
  Real.sqrt ((2 * (P.H : ℝ)) / (1 - P.rho ^ (2 : ℕ))) * Delta P P.K0

/-- The denominator `1-rho^2` in `A_0` is source-derived positive from
`0≤rho<1`; the displayed square-root quotient is therefore the paper
expression, not a Lean fallback at a zero denominator.

Source: `book/RCDGD/RCDGD.json#/key_lemmas/7/proof/1/math`.
Quote: "0\le\rho<1".
Source: `book/RCDGD/RCDGD.json#/key_lemmas/7/statement_math`.
Quote: "A_0=\sqrt{\frac{2H}{1-\rho^2}}\,\Delta_{K_0}".
-/
theorem A_0_denominator_pos (P : Setup) :
    0 < 1 - P.rho ^ (2 : ℕ) := by
  rcases P.rho_range with ⟨hrho_nonneg, hrho_lt⟩
  nlinarith [sq_nonneg P.rho]

/-- Nonzero form of the source-derived denominator condition for `A_0`. -/
theorem A_0_denominator_ne_zero (P : Setup) :
    1 - P.rho ^ (2 : ℕ) ≠ 0 :=
  ne_of_gt P.A_0_denominator_pos

/-- The stale-prefix constant `H_0 = L sqrt(D) A_pre` from (4.2).

Source: `book/RCDGD/RCDGD.json#/key_lemmas/7/statement_math`.
Quote: "H_0=L\sqrt D\,A_{\rm pre}".
-/
noncomputable def H_0 (P : Setup) : ℝ :=
  P.L * Real.sqrt (P.D : ℝ) * P.A_pre

/-- The closed stale-error constant `B_0` from (4.3).

Source: `book/RCDGD/RCDGD.json#/key_lemmas/7/statement_math`.
Quote: "B_0=2[H_0+LD(1+\gamma L)A_0]".
-/
noncomputable def B_0 (P : Setup) : ℝ :=
  2 * (P.H_0 + P.L * (P.D : ℝ) * (1 + P.gamma * P.L) * P.A_0)

/-- The closed disagreement constant `A_1` from (4.3).

Source: `book/RCDGD/RCDGD.json#/key_lemmas/7/statement_math`.
Quote: "A_1=A_0+C_N\gamma B_0".
-/
noncomputable def A_1 (P : Setup) : ℝ :=
  P.A_0 + P.C_N * P.gamma * P.B_0

/-- The main theorem constant `C_RC` from (4.8).

Source: `book/RCDGD/RCDGD.json#/main_theorem/statement_math`.
Quote: "C_{\rm RC}:=C_{\rm pre}+\frac{4(f(\bar x_{K_0})-f_*)}{\gamma}+16(L+\gamma^{-1})^2A_1^2".
-/
noncomputable def C_RC (P : Setup) : ℝ :=
  P.C_pre + 4 * (P.aggregateObjective (xBar P P.K0) - P.fStar) / P.gamma +
    16 * (P.L + P.gamma⁻¹) ^ (2 : ℕ) * P.A_1 ^ (2 : ℕ)

/-- The stepsize condition (4.6) for Theorem 4.2.

Source: `book/RCDGD/RCDGD.json#/assumptions/3/math`.
Quote: "0<\gamma\le\min\left\{\frac1{4L},\frac1{16LD(C_N+2)}\right\}".
-/
noncomputable def theoremStepsizeCondition (P : Setup) : Prop :=
  0 < P.gamma ∧
    P.gamma ≤ min ((4 * P.L)⁻¹)
      ((16 * P.L * (P.D : ℝ) * (P.C_N + 2))⁻¹)

end Setup

private theorem mixingProduct_h_round_residual_row_sum_eq_rho
    (P : Setup) (t : ℕ) (i : Node P.n) :
    (∑ s : Node P.n, (mixingProduct P t P.H i s - P.beta)) = P.rho := by
  classical
  have hsum_const :
      (∑ _s : Node P.n, P.beta) = (Fintype.card (Node P.n) : ℝ) * P.beta := by
    simp
  have hcard : (Fintype.card (Node P.n) : ℝ) = (P.n : ℝ) := by
    simp [Node]
  calc
    (∑ s : Node P.n, (mixingProduct P t P.H i s - P.beta))
        = (∑ s : Node P.n, mixingProduct P t P.H i s) -
            ∑ _s : Node P.n, P.beta := by
          rw [Finset.sum_sub_distrib]
    _ = 1 - (P.n : ℝ) * P.beta := by
          rw [mixingProduct_row_sum P t P.H i, hsum_const, hcard]
    _ = P.rho := by
          rw [Setup.rho]

private theorem mixingProduct_h_round_residual_smul_sum_sub
    (P : Setup) (t k : ℕ) (i : Node P.n) :
    (∑ s : Node P.n, (mixingProduct P t P.H i s - P.beta) • X P k s) =
      (∑ s : Node P.n, mixingProduct P t P.H i s • X P k s) -
        ∑ s : Node P.n, P.beta • X P k s := by
  classical
  calc
    (∑ s : Node P.n, (mixingProduct P t P.H i s - P.beta) • X P k s)
        = ∑ s : Node P.n,
            (mixingProduct P t P.H i s • X P k s - P.beta • X P k s) := by
          refine Finset.sum_congr rfl ?_
          intro s _hs
          rw [sub_smul]
    _ = (∑ s : Node P.n, mixingProduct P t P.H i s • X P k s) -
          ∑ s : Node P.n, P.beta • X P k s := by
          rw [Finset.sum_sub_distrib]

private theorem normalized_weighted_sum_mem_convexHull_range
    {ι E : Type*} [Fintype ι] [DecidableEq ι] [AddCommGroup E] [Module ℝ E]
    (w : ι → ℝ) (x : ι → E) (m : ℝ)
    (hm_pos : 0 < m) (hw_nonneg : ∀ i, 0 ≤ w i)
    (hw_sum : (∑ i : ι, w i) = m) :
    m⁻¹ • (∑ i : ι, w i • x i) ∈ convexHull ℝ (Set.range x) := by
  classical
  let Xset : Set E := Set.range x
  have hconv : Convex ℝ (convexHull ℝ Xset) := convex_convexHull ℝ Xset
  have hm_ne : m ≠ 0 := ne_of_gt hm_pos
  have hsum_one : (∑ i : ι, m⁻¹ * w i) = 1 := by
    calc
      (∑ i : ι, m⁻¹ * w i) = m⁻¹ * ∑ i : ι, w i := by
        rw [Finset.mul_sum]
      _ = m⁻¹ * m := by
        rw [hw_sum]
      _ = 1 := inv_mul_cancel₀ hm_ne
  have hweights_nonneg : ∀ i : ι, i ∈ (Finset.univ : Finset ι) → 0 ≤ m⁻¹ * w i := by
    intro i _hi
    exact mul_nonneg (inv_nonneg.mpr (le_of_lt hm_pos)) (hw_nonneg i)
  have hx_mem :
      ∀ i : ι, i ∈ (Finset.univ : Finset ι) → x i ∈ convexHull ℝ Xset := by
    intro i _hi
    exact (subset_convexHull ℝ Xset) (show x i ∈ Xset from ⟨i, rfl⟩)
  have hmem :
      (∑ i : ι, (m⁻¹ * w i) • x i) ∈ convexHull ℝ Xset := by
    exact hconv.sum_mem hweights_nonneg hsum_one hx_mem
  convert hmem using 1
  simp [Finset.smul_sum, smul_smul, mul_assoc]

private theorem weighted_average_pair_norm_le_mass_mul_diameter
    {ι E : Type*} [Fintype ι] [DecidableEq ι]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (w v : ι → ℝ) (x : ι → E) (m D : ℝ)
    (hw_nonneg : ∀ i, 0 ≤ w i) (hv_nonneg : ∀ i, 0 ≤ v i)
    (hw_sum : (∑ i : ι, w i) = m) (hv_sum : (∑ i : ι, v i) = m)
    (hm_nonneg : 0 ≤ m) (hdiam : ∀ i j, ‖x i - x j‖ ≤ D) :
    ‖(∑ i : ι, w i • x i) - (∑ j : ι, v j • x j)‖ ≤ m * D := by
  classical
  by_cases hm_zero : m = 0
  · have hw_sum_zero : (∑ i : ι, w i) = 0 := by simpa [hm_zero] using hw_sum
    have hv_sum_zero : (∑ i : ι, v i) = 0 := by simpa [hm_zero] using hv_sum
    have hw_zero : ∀ i : ι, w i = 0 := by
      intro i
      exact (Finset.sum_eq_zero_iff_of_nonneg (fun j _hj => hw_nonneg j)).mp
        hw_sum_zero i (Finset.mem_univ i)
    have hv_zero : ∀ i : ι, v i = 0 := by
      intro i
      exact (Finset.sum_eq_zero_iff_of_nonneg (fun j _hj => hv_nonneg j)).mp
        hv_sum_zero i (Finset.mem_univ i)
    simp [hw_zero, hv_zero, hm_zero]
  · have hm_pos : 0 < m := lt_of_le_of_ne hm_nonneg (Ne.symm hm_zero)
    let Xset : Set E := Set.range x
    let yw : E := m⁻¹ • (∑ i : ι, w i • x i)
    let yv : E := m⁻¹ • (∑ i : ι, v i • x i)
    have hyw_mem : yw ∈ convexHull ℝ Xset := by
      simpa [yw, Xset] using
        normalized_weighted_sum_mem_convexHull_range w x m hm_pos hw_nonneg hw_sum
    have hyv_mem : yv ∈ convexHull ℝ Xset := by
      simpa [yv, Xset] using
        normalized_weighted_sum_mem_convexHull_range v x m hm_pos hv_nonneg hv_sum
    have hD_nonneg : 0 ≤ D := by
      by_cases hι : Nonempty ι
      · rcases hι with ⟨i⟩
        exact le_trans (norm_nonneg (x i - x i)) (hdiam i i)
      · have hempty : IsEmpty ι := not_nonempty_iff.mp hι
        have hm_eq_zero : m = 0 := by
          haveI := hempty
          simpa using hw_sum.symm
        exact (hm_zero hm_eq_zero).elim
    have hdiam_range : Metric.diam Xset ≤ D := by
      apply Metric.diam_le_of_forall_dist_le hD_nonneg
      intro a ha b hb
      rcases ha with ⟨i, rfl⟩
      rcases hb with ⟨j, rfl⟩
      simpa [dist_eq_norm] using hdiam i j
    have hconv_diam : Metric.diam (convexHull ℝ Xset) ≤ D := by
      simpa [convexHull_diam] using hdiam_range
    have hediam_range : Metric.ediam Xset ≤ ENNReal.ofReal D := by
      apply Metric.ediam_le_of_forall_dist_le
      intro a ha b hb
      rcases ha with ⟨i, rfl⟩
      rcases hb with ⟨j, rfl⟩
      simpa [dist_eq_norm] using hdiam i j
    have hediam_conv : Metric.ediam (convexHull ℝ Xset) ≤ ENNReal.ofReal D := by
      simpa [convexHull_ediam] using hediam_range
    have hediam_ne_top : Metric.ediam (convexHull ℝ Xset) ≠ ⊤ :=
      ne_top_of_le_ne_top ENNReal.ofReal_ne_top hediam_conv
    have hdist :
        dist yw yv ≤ D := by
      exact (Metric.dist_le_diam_of_mem' hediam_ne_top hyw_mem hyv_mem).trans hconv_diam
    have hscale :
        (∑ i : ι, w i • x i) - (∑ i : ι, v i • x i) = m • (yw - yv) := by
      dsimp [yw, yv]
      rw [smul_sub, smul_smul, smul_smul]
      have hmul : m * m⁻¹ = 1 := by
        field_simp [ne_of_gt hm_pos]
      simp [hmul]
    calc
      ‖(∑ i : ι, w i • x i) - (∑ j : ι, v j • x j)‖
          = ‖m • (yw - yv)‖ := by rw [hscale]
      _ = m * ‖yw - yv‖ := by
          rw [norm_smul, Real.norm_of_nonneg hm_nonneg]
      _ = m * dist yw yv := by
          rw [dist_eq_norm]
      _ ≤ m * D := mul_le_mul_of_nonneg_left hdist hm_nonneg

theorem initial_g (P : Setup) (i : Node P.n) :
    (stateSeq P 0).g i = P.localGradient i ((stateSeq P 0).x i) :=
  by
    rfl

theorem initial_c (P : Setup) (i : Node P.n) :
    (stateSeq P 0).c i = 0 :=
  by
    rfl

theorem initial_R (P : Setup) (i : Node P.n) :
    (stateSeq P 0).R i = 0 :=
  by
    rfl

/-- The generated sequence follows the literal model-update component of
Algorithm 1. -/
theorem stateSeq_succ_x (P : Setup) (k : ℕ) :
    (stateSeq P (k + 1)).x =
      fun i => State.xHat (stateSeq P k) k i - P.gamma • State.direction (stateSeq P k) i :=
  rfl

/-- The generated iterates satisfy the paper's model update (3.9). -/
theorem X_succ (P : Setup) (k : ℕ) (i : Node P.n) :
    X P (k + 1) i =
      State.xHat (stateSeq P k) k i - P.gamma • State.direction (stateSeq P k) i :=
  by
    rfl

private theorem X_succ_eq_mixingProduct_one_sub_direction
    (P : Setup) (k : ℕ) (i : Node P.n) :
    X P (k + 1) i =
      (∑ s : Node P.n, mixingProduct P k 1 i s • X P k s) -
        P.gamma • State.direction (stateSeq P k) i := by
  rw [X_succ]
  congr 1
  rw [mixingProduct_apply_one_smul_sum]
  rfl

private theorem X_add_mixingProduct_unroll_sub_sum
    (P : Setup) (t r : ℕ) (i : Node P.n) :
    X P (t + r) i =
      (∑ s : Node P.n, mixingProduct P t r i s • X P t s) -
        P.gamma •
          (∑ q ∈ Finset.range r,
            ∑ s : Node P.n,
              mixingProduct P (t + q + 1) (r - 1 - q) i s •
                State.direction (stateSeq P (t + q)) s) := by
  classical
  induction r generalizing i with
  | zero =>
      simp [mixingProduct_apply_zero_smul_sum]
  | succ r ih =>
      let oldPert : Node P.n → Vec P.d := fun u =>
        ∑ q ∈ Finset.range r,
          ∑ s : Node P.n,
            mixingProduct P (t + q + 1) (r - 1 - q) u s •
              State.direction (stateSeq P (t + q)) s
      let newPert : ℕ → Vec P.d := fun q =>
        ∑ s : Node P.n,
          mixingProduct P (t + q + 1) (r - q) i s •
            State.direction (stateSeq P (t + q)) s
      have htime : t + (r + 1) = t + r + 1 := by omega
      have hweighted_old :
          (∑ u : Node P.n, P.mixing (t + r) i u • oldPert u) =
            ∑ q ∈ Finset.range r, newPert q := by
        calc
          (∑ u : Node P.n, P.mixing (t + r) i u • oldPert u)
              =
            ∑ u : Node P.n, ∑ q ∈ Finset.range r,
              P.mixing (t + r) i u •
                (∑ s : Node P.n,
                  mixingProduct P (t + q + 1) (r - 1 - q) u s •
                    State.direction (stateSeq P (t + q)) s) := by
                refine Finset.sum_congr rfl ?_
                intro u _hu
                simp [oldPert, Finset.smul_sum]
          _ =
            ∑ q ∈ Finset.range r, ∑ u : Node P.n,
              P.mixing (t + r) i u •
                (∑ s : Node P.n,
                  mixingProduct P (t + q + 1) (r - 1 - q) u s •
                    State.direction (stateSeq P (t + q)) s) := by
                rw [Finset.sum_comm]
          _ = ∑ q ∈ Finset.range r, newPert q := by
                refine Finset.sum_congr rfl ?_
                intro q hq
                rw [Finset.mem_range] at hq
                exact mixingProduct_suffix_prepend_apply_smul_sum
                  P t r q hq i (fun s => State.direction (stateSeq P (t + q)) s)
      have hsumX :
          (∑ u : Node P.n, P.mixing (t + r) i u • X P (t + r) u) =
            (∑ s : Node P.n, mixingProduct P t (r + 1) i s • X P t s) -
              P.gamma • (∑ q ∈ Finset.range r, newPert q) := by
        calc
          (∑ u : Node P.n, P.mixing (t + r) i u • X P (t + r) u)
              =
            ∑ u : Node P.n, P.mixing (t + r) i u •
              ((∑ s : Node P.n, mixingProduct P t r u s • X P t s) -
                P.gamma • oldPert u) := by
                refine Finset.sum_congr rfl ?_
                intro u _hu
                rw [ih u]
          _ =
            (∑ u : Node P.n, P.mixing (t + r) i u •
              (∑ s : Node P.n, mixingProduct P t r u s • X P t s)) -
                P.gamma • (∑ u : Node P.n, P.mixing (t + r) i u • oldPert u) := by
                exact finset_sum_smul_sub_gamma_smul_sum P
                  (fun u => P.mixing (t + r) i u)
                  (fun u =>
                    ∑ s : Node P.n, mixingProduct P t r u s • X P t s)
                  oldPert P.gamma
          _ =
            (∑ s : Node P.n, mixingProduct P t (r + 1) i s • X P t s) -
              P.gamma • (∑ u : Node P.n, P.mixing (t + r) i u • oldPert u) := by
                rw [mixingProduct_apply_succ_smul_sum]
          _ =
            (∑ s : Node P.n, mixingProduct P t (r + 1) i s • X P t s) -
              P.gamma • (∑ q ∈ Finset.range r, newPert q) := by
                rw [hweighted_old]
      have hrange_succ :
          (∑ q ∈ Finset.range (r + 1),
            ∑ s : Node P.n,
              mixingProduct P (t + q + 1) (r + 1 - 1 - q) i s •
                State.direction (stateSeq P (t + q)) s) =
            (∑ q ∈ Finset.range r, newPert q) +
              State.direction (stateSeq P (t + r)) i := by
        calc
          (∑ q ∈ Finset.range (r + 1),
            ∑ s : Node P.n,
              mixingProduct P (t + q + 1) (r + 1 - 1 - q) i s •
                State.direction (stateSeq P (t + q)) s)
              =
            (∑ q ∈ Finset.range r,
              ∑ s : Node P.n,
                mixingProduct P (t + q + 1) (r + 1 - 1 - q) i s •
                  State.direction (stateSeq P (t + q)) s) +
              (∑ s : Node P.n,
                mixingProduct P (t + r + 1) (r + 1 - 1 - r) i s •
                  State.direction (stateSeq P (t + r)) s) := by
                rw [Finset.sum_range_succ]
          _ =
            (∑ q ∈ Finset.range r, newPert q) +
              (∑ s : Node P.n,
                mixingProduct P (t + r + 1) 0 i s •
                  State.direction (stateSeq P (t + r)) s) := by
                have hfirst :
                    (∑ q ∈ Finset.range r,
                      ∑ s : Node P.n,
                        mixingProduct P (t + q + 1) (r + 1 - 1 - q) i s •
                          State.direction (stateSeq P (t + q)) s) =
                      ∑ q ∈ Finset.range r, newPert q := by
                  refine Finset.sum_congr rfl ?_
                  intro q hq
                  rw [Finset.mem_range] at hq
                  have hlen : r + 1 - 1 - q = r - q := by omega
                  simp [newPert, hlen]
                have hlast :
                    (∑ s : Node P.n,
                      mixingProduct P (t + r + 1) (r + 1 - 1 - r) i s •
                        State.direction (stateSeq P (t + r)) s) =
                      ∑ s : Node P.n,
                        mixingProduct P (t + r + 1) 0 i s •
                          State.direction (stateSeq P (t + r)) s := by
                  have hlen_last : r + 1 - 1 - r = 0 := by omega
                  rw [hlen_last]
                rw [hfirst, hlast]
          _ =
            (∑ q ∈ Finset.range r, newPert q) +
              State.direction (stateSeq P (t + r)) i := by
                rw [mixingProduct_apply_zero_smul_sum]
      calc
        X P (t + (r + 1)) i
            = X P (t + r + 1) i := by rw [htime]
        _ =
          (∑ u : Node P.n, P.mixing (t + r) i u • X P (t + r) u) -
            P.gamma • State.direction (stateSeq P (t + r)) i := by
              rw [X_succ_eq_mixingProduct_one_sub_direction P (t + r) i]
              rw [mixingProduct_apply_one_smul_sum]
        _ =
          ((∑ s : Node P.n, mixingProduct P t (r + 1) i s • X P t s) -
              P.gamma • (∑ q ∈ Finset.range r, newPert q)) -
            P.gamma • State.direction (stateSeq P (t + r)) i := by
              rw [hsumX]
        _ =
          (∑ s : Node P.n, mixingProduct P t (r + 1) i s • X P t s) -
            P.gamma •
              ((∑ q ∈ Finset.range r, newPert q) +
                State.direction (stateSeq P (t + r)) i) := by
              module
        _ =
          (∑ s : Node P.n, mixingProduct P t (r + 1) i s • X P t s) -
            P.gamma •
              (∑ q ∈ Finset.range (r + 1),
                ∑ s : Node P.n,
                  mixingProduct P (t + q + 1) (r + 1 - 1 - q) i s •
                    State.direction (stateSeq P (t + q)) s) := by
              rw [hrange_succ]

/-- The generated gradient stack is the canonical gradient query (3.13). -/
theorem G_eq_gradient_query (P : Setup) (k : ℕ) (i : Node P.n) :
    G P k i = P.localGradient i (X P k i) := by
  cases k <;> rfl

/-- At a generated transaction endpoint, the `R` ledger commits the decoded
payload from (3.12). The decoded payload is the generated endpoint object above,
not an arbitrary-state quotient.

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/7/math`.
Quote: "R_{i,k+1}=R_{i,k}+\widetilde z_{i,\ell}".
-/
theorem stateSeq_R_succ_transactionEnd (P : Setup) (ell : ℕ) (i : Node P.n) :
    (stateSeq P (P.transactionEnd ell + 1)).R i =
      (stateSeq P (P.transactionEnd ell)).R i + State.endpointDecodedPayload P ell i := by
  have hk : State.isEndpoint (P := P) (P.transactionEnd ell) := by
    simpa [State.isEndpoint] using P.transactionEnd_isTransactionEndpoint ell
  change (State.rawNext (stateSeq P (P.transactionEnd ell)) (P.transactionEnd ell)).R i = _
  simpa [State.endpointDecodedPayload] using
    State.rawNext_R_of_endpoint (P := P) (stateSeq P (P.transactionEnd ell))
      (P.transactionEnd ell) i hk

/-- At a generated transaction endpoint, the source node's `c` ledger commits the
decoded payload from (3.12).

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/7/math`.
Quote: "c_{i,k+1}=c_{i,k}+\mathbf 1_{\{i=s_\ell\}}\widetilde z_{i,\ell}".
-/
theorem stateSeq_c_source_succ_transactionEnd (P : Setup) (ell : ℕ) :
    (stateSeq P (P.transactionEnd ell + 1)).c (P.sourceIndex ell) =
      (stateSeq P (P.transactionEnd ell)).c (P.sourceIndex ell) +
        State.endpointDecodedPayload P ell (P.sourceIndex ell) := by
  have hk : State.isEndpoint (P := P) (P.transactionEnd ell) := by
    simpa [State.isEndpoint] using P.transactionEnd_isTransactionEndpoint ell
  have hs : P.sourceIndex ell = P.roundSource (P.transactionEnd ell) :=
    (P.roundSource_transactionEnd ell).symm
  change (State.rawNext (stateSeq P (P.transactionEnd ell)) (P.transactionEnd ell)).c
    (P.sourceIndex ell) = _
  simpa [State.endpointDecodedPayload] using
    State.rawNext_c_source_of_endpoint (P := P) (stateSeq P (P.transactionEnd ell))
      (P.transactionEnd ell) (P.sourceIndex ell) hk hs

/-- At a generated transaction endpoint, non-source nodes do not change their
`c` ledger.

Source: `book/RCDGD/RCDGD.json#/algorithm_spec/steps/7/math`.
Quote: "c_{i,k+1}=c_{i,k}+\mathbf 1_{\{i=s_\ell\}}\widetilde z_{i,\ell}".
-/
theorem stateSeq_c_other_succ_transactionEnd (P : Setup) (ell : ℕ) (i : Node P.n)
    (hi : i ≠ P.sourceIndex ell) :
    (stateSeq P (P.transactionEnd ell + 1)).c i =
      (stateSeq P (P.transactionEnd ell)).c i := by
  have hk : State.isEndpoint (P := P) (P.transactionEnd ell) := by
    simpa [State.isEndpoint] using P.transactionEnd_isTransactionEndpoint ell
  have hround : P.roundSource (P.transactionEnd ell) = P.sourceIndex ell :=
    P.roundSource_transactionEnd ell
  have hother : i ≠ P.roundSource (P.transactionEnd ell) := by
    intro h
    apply hi
    simpa [hround] using h
  change (State.rawNext (stateSeq P (P.transactionEnd ell)) (P.transactionEnd ell)).c i = _
  simpa using
    State.rawNext_c_other_of_endpoint (P := P) (stateSeq P (P.transactionEnd ell))
      (P.transactionEnd ell) i hk hother

private theorem preparedPsi_transactionStart (P : Setup) (ell : ℕ) (j : Node P.n) :
    State.preparedPsi (stateSeq P (P.transactionStart ell)) (P.transactionStart ell) j =
      if j = P.sourceIndex ell then 1 else 0 := by
  have hstart : P.isTransactionStart (P.transactionStart ell) :=
    P.transactionStart_isTransactionStart ell
  have hsource :
      P.roundSource (P.transactionStart ell) = P.sourceIndex ell :=
    P.roundSource_transactionStart ell
  simp [State.preparedPsi, hstart, hsource]

private theorem preparedPhi_transactionStart (P : Setup) (ell : ℕ) (j : Node P.n) :
    State.preparedPhi (stateSeq P (P.transactionStart ell)) (P.transactionStart ell) j =
      if j = P.sourceIndex ell then
        State.sourcePayload (stateSeq P (P.transactionStart ell)) (P.transactionStart ell)
      else
        0 := by
  have hstart : P.isTransactionStart (P.transactionStart ell) :=
    P.transactionStart_isTransactionStart ell
  have hsource :
      P.roundSource (P.transactionStart ell) = P.sourceIndex ell :=
    P.roundSource_transactionStart ell
  simp [State.preparedPhi, hstart, hsource]

private theorem endpoint_ratio_lane_transport (P : Setup) (ell : ℕ) (i : Node P.n) :
    ∃ w : ℝ, P.beta ≤ w ∧
      State.psiHat (stateSeq P (P.transactionEnd ell)) (P.transactionEnd ell) i = w ∧
      State.phiHat (stateSeq P (P.transactionEnd ell)) (P.transactionEnd ell) i =
        w • State.sourcePayload (stateSeq P (P.transactionStart ell))
          (P.transactionStart ell) := by
  classical
  let r := P.H - 1
  have hr : r < P.H := by
    dsimp [r]
    have hH := P.H_pos
    omega
  have hr_succ : r + 1 = P.H := by
    dsimp [r]
    have hH := P.H_pos
    omega
  have htime : P.transactionStart ell + r = P.transactionEnd ell := by
    dsimp [r, Setup.transactionEnd]
    have hH := P.H_pos
    omega
  let w := mixingProduct P (P.transactionStart ell) P.H i (P.sourceIndex ell)
  refine ⟨w, ?_, ?_, ?_⟩
  · exact mixingProduct_h_round_mass_lower_bound P (P.transactionStart ell)
      (P.sourceIndex ell) i
  · have htransport := (mixingProduct_onehot_lane_transport P ell r hr i).1
    simpa [w, hr_succ, htime] using htransport
  · have htransport := (mixingProduct_onehot_lane_transport P ell r hr i).2
    simpa [w, hr_succ, htime] using htransport

/-- Lemma 5.2 source-derived positivity of every endpoint decoded denominator. It is
kept as a theorem obligation rather than a setup field.

Source: `book/RCDGD/RCDGD.json#/key_lemmas/4/proof/2/math`.
Quote: "\psi_{i,t+H}=e_i^\top Pe_s=P_{is}\ge\beta>0".
-/
theorem endpoint_decode_denominator_pos (P : Setup) (ell : ℕ) (i : Node P.n) :
    0 < State.psiHat (stateSeq P (P.transactionEnd ell)) (P.transactionEnd ell) i := by
  rcases endpoint_ratio_lane_transport P ell i with ⟨w, hwβ, hψ, _hφ⟩
  rw [hψ]
  exact lt_of_lt_of_le P.beta_pos hwβ

/-- Lemma 5.2 source-derived exact ratio decoding at each generated transaction
endpoint. This bridges the generated endpoint payload to the source payload from
the transaction start.

Source: `book/RCDGD/RCDGD.json#/key_lemmas/4/statement_math`.
Quote: "式 (3.4) 的事务末端，每个节点都精确得到同一个载荷 z".
-/
theorem endpoint_decodedPayload_eq_sourcePayload (P : Setup) (ell : ℕ) (i : Node P.n) :
    State.endpointDecodedPayload P ell i =
      State.sourcePayload (stateSeq P (P.transactionStart ell)) (P.transactionStart ell) := by
  rcases endpoint_ratio_lane_transport P ell i with ⟨w, hwβ, hψ, hφ⟩
  have hwpos : 0 < w := lt_of_lt_of_le P.beta_pos hwβ
  have hwne : w ≠ 0 := ne_of_gt hwpos
  unfold State.endpointDecodedPayload State.rawEndpointDecodedPayload
  rw [hψ, hφ]
  simpa [hwne]

private theorem transactionStart_add_not_endpoint (P : Setup) (ell r : ℕ)
    (hr : r < P.H - 1) :
    ¬ State.isEndpoint (P := P) (P.transactionStart ell + r) := by
  rw [State.isEndpoint, P.isTransactionEndpoint_iff_remainder_eq]
  unfold Setup.transactionRemainder Setup.transactionStart
  have hH := P.H_pos
  have hrH : r < P.H := by omega
  have hmod : (ell * P.H + r) % P.H = r := by
    rw [Nat.mul_comm ell P.H]
    rw [Nat.add_comm]
    rw [Nat.add_mul_mod_self_left]
    exact Nat.mod_eq_of_lt hrH
  rw [hmod]
  omega

private theorem stateSeq_c_source_eq_start_before_endpoint
    (P : Setup) (ell r : ℕ) (hr : r ≤ P.H - 1) :
    (stateSeq P (P.transactionStart ell + r)).c (P.sourceIndex ell) =
      (stateSeq P (P.transactionStart ell)).c (P.sourceIndex ell) := by
  induction r with
  | zero =>
      simp
  | succ r ih =>
      have hrprev : r ≤ P.H - 1 := by omega
      have hnot :
          ¬ State.isEndpoint (P := P) (P.transactionStart ell + r) :=
        transactionStart_add_not_endpoint P ell r (by omega)
      have hstep :
          (stateSeq P (P.transactionStart ell + (r + 1))).c (P.sourceIndex ell) =
            (stateSeq P (P.transactionStart ell + r)).c (P.sourceIndex ell) := by
        have htime : P.transactionStart ell + (r + 1) =
            P.transactionStart ell + r + 1 := by
          omega
        rw [htime]
        change (State.rawNext (stateSeq P (P.transactionStart ell + r))
            (P.transactionStart ell + r)).c (P.sourceIndex ell) =
          (stateSeq P (P.transactionStart ell + r)).c (P.sourceIndex ell)
        exact State.rawNext_c_of_not_endpoint (P := P)
          (stateSeq P (P.transactionStart ell + r)) (P.transactionStart ell + r)
          (P.sourceIndex ell) hnot
      calc
        (stateSeq P (P.transactionStart ell + (r + 1))).c (P.sourceIndex ell)
            = (stateSeq P (P.transactionStart ell + r)).c (P.sourceIndex ell) := hstep
        _ = (stateSeq P (P.transactionStart ell)).c (P.sourceIndex ell) := ih hrprev

private theorem snapshot_commit_sets_c_to_sample_gradient (P : Setup) (ell : ℕ) :
    (stateSeq P (P.transactionEnd ell + 1)).c (P.sourceIndex ell) =
      (stateSeq P (P.transactionStart ell)).g (P.sourceIndex ell) := by
  have hend :
      P.transactionEnd ell = P.transactionStart ell + (P.H - 1) := by
    unfold Setup.transactionEnd
    have hH := P.H_pos
    omega
  have hc_end :
      (stateSeq P (P.transactionEnd ell)).c (P.sourceIndex ell) =
        (stateSeq P (P.transactionStart ell)).c (P.sourceIndex ell) := by
    simpa [hend] using
      stateSeq_c_source_eq_start_before_endpoint P ell (P.H - 1) (le_rfl)
  have hcommit := stateSeq_c_source_succ_transactionEnd P ell
  have hpayload :=
    endpoint_decodedPayload_eq_sourcePayload P ell (P.sourceIndex ell)
  have hround :
      P.roundSource (P.transactionStart ell) = P.sourceIndex ell :=
    P.roundSource_transactionStart ell
  calc
    (stateSeq P (P.transactionEnd ell + 1)).c (P.sourceIndex ell)
        = (stateSeq P (P.transactionEnd ell)).c (P.sourceIndex ell) +
            State.endpointDecodedPayload P ell (P.sourceIndex ell) := hcommit
    _ = (stateSeq P (P.transactionStart ell)).c (P.sourceIndex ell) +
          State.sourcePayload (stateSeq P (P.transactionStart ell))
            (P.transactionStart ell) := by
          rw [hc_end, hpayload]
    _ = (stateSeq P (P.transactionStart ell)).c (P.sourceIndex ell) +
          ((stateSeq P (P.transactionStart ell)).g (P.sourceIndex ell) -
            (stateSeq P (P.transactionStart ell)).c (P.sourceIndex ell)) := by
          simp [State.sourcePayload, hround]
    _ = (stateSeq P (P.transactionStart ell)).g (P.sourceIndex ell) := by
          abel

private theorem snapshot_origin_exists_at_source_commit (P : Setup) (ell : ℕ) :
    ∃ τ : ℕ,
      τ ≤ P.transactionEnd ell + 1 ∧
        P.transactionEnd ell + 1 ≤ τ + P.D ∧
          (stateSeq P (P.transactionEnd ell + 1)).c (P.sourceIndex ell) =
            (stateSeq P τ).g (P.sourceIndex ell) := by
  refine ⟨P.transactionStart ell, ?_, ?_, ?_⟩
  · unfold Setup.transactionEnd
    have hH := P.H_pos
    omega
  · have hcommit_time :
        P.transactionEnd ell + 1 ≤ P.transactionStart ell + P.H := by
      unfold Setup.transactionEnd
      have hH := P.H_pos
      omega
    have hHD : P.H ≤ P.D := by
      unfold Setup.D
      exact Nat.le_mul_of_pos_left P.H (Nat.succ_pos P.n)
    exact le_trans hcommit_time (Nat.add_le_add_left hHD (P.transactionStart ell))
  · exact snapshot_commit_sets_c_to_sample_gradient P ell

private theorem transactionEnd_add_one_eq_transactionStart_succ (P : Setup) (ell : ℕ) :
    P.transactionEnd ell + 1 = P.transactionStart (ell + 1) := by
  unfold Setup.transactionEnd Setup.transactionStart
  have hH := P.H_pos
  calc
    ell * P.H + P.H - 1 + 1 = ell * P.H + P.H := by omega
    _ = (ell + 1) * P.H := by ring

private theorem sourceIndex_ne_of_lt_of_lt_add_n (P : Setup) {ell q : ℕ}
    (hellq : ell < q) (hq : q < ell + P.n) :
    P.sourceIndex ell ≠ P.sourceIndex q := by
  intro hsame
  have hmod_eq : ell % P.n = q % P.n := by
    simpa [Setup.sourceIndex] using congrArg Fin.val hsame
  have hmodeq : ell ≡ q [MOD P.n] := hmod_eq
  have hellq_le : ell ≤ q := le_of_lt hellq
  have hdvd : P.n ∣ q - ell := (Nat.modEq_iff_dvd' hellq_le).mp hmodeq
  have hdiff_pos : 0 < q - ell := Nat.sub_pos_of_lt hellq
  have hdiff_lt : q - ell < P.n := by omega
  rcases hdvd with ⟨m, hm⟩
  cases m with
  | zero =>
      omega
  | succ m =>
      have hn_le : P.n ≤ P.n * (m + 1) :=
        Nat.le_mul_of_pos_right P.n (Nat.succ_pos m)
      omega

private theorem exists_sourceIndex_in_consecutive_block
    (P : Setup) (base : ℕ) (i : Node P.n) :
    ∃ ell : ℕ, base ≤ ell ∧ ell < base + P.n ∧ P.sourceIndex ell = i := by
  let q := base / P.n
  let b := base % P.n
  have hnpos : 0 < P.n := lt_of_lt_of_le (by decide : 0 < 2) P.hn
  have hb_lt : b < P.n := Nat.mod_lt base hnpos
  have hbase : q * P.n + b = base := by
    calc
      q * P.n + b = P.n * q + b := by rw [Nat.mul_comm]
      _ = base := by simpa [q, b] using Nat.div_add_mod base P.n
  have hsucc_mul : (q + 1) * P.n = q * P.n + P.n := by ring
  by_cases hb_le : b ≤ i.val
  · refine ⟨q * P.n + i.val, by omega, by omega, ?_⟩
    apply Fin.ext
    dsimp [Setup.sourceIndex]
    rw [Nat.mul_comm q P.n, Nat.add_comm, Nat.add_mul_mod_self_left,
      Nat.mod_eq_of_lt i.isLt]
  · have hi_lt_b : i.val < b := Nat.lt_of_not_ge hb_le
    refine ⟨(q + 1) * P.n + i.val, by omega, by omega, ?_⟩
    apply Fin.ext
    dsimp [Setup.sourceIndex]
    rw [Nat.mul_comm (q + 1) P.n, Nat.add_comm, Nat.add_mul_mod_self_left,
      Nat.mod_eq_of_lt i.isLt]

private theorem exists_recent_source_transaction
    (P : Setup) (k : ℕ) (i : Node P.n) (hk : P.K0 ≤ k) :
    ∃ ell : ℕ,
      P.sourceIndex ell = i ∧
        P.transactionEnd ell + 1 ≤ k ∧ k ≤ P.transactionEnd (ell + P.n) := by
  let m := P.transactionIndex k
  have hm_ge : P.n ≤ m := by
    dsimp [m]
    unfold Setup.transactionIndex
    rw [Nat.le_div_iff_mul_le P.H_pos]
    simpa [Setup.K0] using hk
  let base := m - P.n
  have hbase_add : base + P.n = m := by
    dsimp [base]
    exact Nat.sub_add_cancel hm_ge
  rcases exists_sourceIndex_in_consecutive_block P base i with
    ⟨ell, hbase_le, hell_lt, hsource⟩
  have hell_succ_le_m : ell + 1 ≤ m := by omega
  have hm_le_elln : m ≤ ell + P.n := by omega
  have hmk_lo : m * P.H ≤ k := by
    dsimp [m]
    unfold Setup.transactionIndex
    simpa [Nat.mul_comm] using Nat.div_mul_le_self k P.H
  have hdiv : m * P.H + k % P.H = k := by
    calc
      m * P.H + k % P.H = P.H * (k / P.H) + k % P.H := by
        dsimp [m]
        unfold Setup.transactionIndex
        rw [Nat.mul_comm]
      _ = k := Nat.div_add_mod k P.H
  have hrem_lt : k % P.H < P.H := Nat.mod_lt k P.H_pos
  have hmk_hi : k < (m + 1) * P.H := by
    have hsucc_mul : (m + 1) * P.H = m * P.H + P.H := by ring
    omega
  refine ⟨ell, hsource, ?_, ?_⟩
  · have hstart_succ_le : P.transactionStart (ell + 1) ≤ k := by
      unfold Setup.transactionStart
      exact le_trans (Nat.mul_le_mul_right P.H hell_succ_le_m) hmk_lo
    simpa [transactionEnd_add_one_eq_transactionStart_succ P ell] using hstart_succ_le
  · have hnext_le : (m + 1) * P.H ≤ (ell + P.n + 1) * P.H := by
      exact Nat.mul_le_mul_right P.H (Nat.succ_le_succ hm_le_elln)
    have hk_lt_next : k < (ell + P.n + 1) * P.H := lt_of_lt_of_le hmk_hi hnext_le
    have hnext_eq :
        (ell + P.n + 1) * P.H = (ell + P.n) * P.H + P.H := by ring
    unfold Setup.transactionEnd Setup.transactionStart
    have hH := P.H_pos
    omega

private theorem stateSeq_c_source_succ_eq_self_until_next_cycle
    (P : Setup) {ell k : ℕ}
    (hklo : P.transactionEnd ell + 1 ≤ k)
    (hkhi : k < P.transactionEnd (ell + P.n)) :
    (stateSeq P (k + 1)).c (P.sourceIndex ell) =
      (stateSeq P k).c (P.sourceIndex ell) := by
  by_cases hk : State.isEndpoint (P := P) k
  · let q := P.transactionIndex k
    have hk_eq : k = P.transactionEnd q := by
      simpa [State.isEndpoint, Setup.isTransactionEndpoint, Setup.currentTransactionEnd, q] using hk
    have hklo' : P.transactionEnd ell + 1 ≤ P.transactionEnd q := by
      simpa [hk_eq] using hklo
    have hkhi' : P.transactionEnd q < P.transactionEnd (ell + P.n) := by
      simpa [hk_eq] using hkhi
    have hellq : ell < q := by
      have hstart_le : P.transactionStart (ell + 1) ≤ P.transactionEnd q := by
        simpa [transactionEnd_add_one_eq_transactionStart_succ P ell] using hklo'
      have hle_div : ell + 1 ≤ q := by
        dsimp [q]
        unfold Setup.transactionIndex
        rw [Nat.le_div_iff_mul_le P.H_pos]
        calc
          (ell + 1) * P.H = P.transactionStart (ell + 1) := by rfl
          _ ≤ P.transactionEnd q := hstart_le
          _ ≤ k := by rw [hk_eq]
      omega
    have hq : q < ell + P.n := by
      by_contra hnot
      have hm_le_q : ell + P.n ≤ q := Nat.le_of_not_lt hnot
      have hstart_le :
          P.transactionStart (ell + P.n + 1) ≤ P.transactionStart (q + 1) := by
        unfold Setup.transactionStart
        exact Nat.mul_le_mul_right P.H (Nat.succ_le_succ hm_le_q)
      have hle_next :
          P.transactionEnd (ell + P.n) + 1 ≤ P.transactionEnd q + 1 := by
        simpa [transactionEnd_add_one_eq_transactionStart_succ P (ell + P.n),
          transactionEnd_add_one_eq_transactionStart_succ P q] using hstart_le
      have hlt_next : P.transactionEnd q + 1 ≤ P.transactionEnd (ell + P.n) :=
        Nat.succ_le_of_lt hkhi'
      omega
    have hneq : P.sourceIndex ell ≠ P.sourceIndex q :=
      sourceIndex_ne_of_lt_of_lt_add_n P hellq hq
    calc
      (stateSeq P (k + 1)).c (P.sourceIndex ell)
          = (stateSeq P (P.transactionEnd q + 1)).c (P.sourceIndex ell) := by
            rw [hk_eq]
      _ = (stateSeq P (P.transactionEnd q)).c (P.sourceIndex ell) := by
            exact stateSeq_c_other_succ_transactionEnd P q (P.sourceIndex ell) hneq
      _ = (stateSeq P k).c (P.sourceIndex ell) := by
            rw [hk_eq]
  · change (State.rawNext (stateSeq P k) k).c (P.sourceIndex ell) =
      (stateSeq P k).c (P.sourceIndex ell)
    exact State.rawNext_c_of_not_endpoint (P := P) (stateSeq P k) k
      (P.sourceIndex ell) hk

private theorem stateSeq_c_source_eq_sample_gradient_until_next_cycle
    (P : Setup) (ell k : ℕ)
    (hklo : P.transactionEnd ell + 1 ≤ k)
    (hkhi : k ≤ P.transactionEnd (ell + P.n)) :
    (stateSeq P k).c (P.sourceIndex ell) =
      (stateSeq P (P.transactionStart ell)).g (P.sourceIndex ell) := by
  let base := P.transactionEnd ell + 1
  let last := P.transactionEnd (ell + P.n)
  let sample := (stateSeq P (P.transactionStart ell)).g (P.sourceIndex ell)
  have hmain :
      ∀ m, base ≤ m →
        m ≤ last →
          (stateSeq P m).c (P.sourceIndex ell) = sample := by
    intro m hbm
    refine Nat.le_induction ?base_step ?succ_step m hbm
    · intro _hbase_last
      dsimp [base, sample]
      exact snapshot_commit_sets_c_to_sample_gradient P ell
    · intro t hbt iht ht_succ_last
      have ht_last : t < last := by
        dsimp [last] at ht_succ_last ⊢
        omega
      have hpreserve :
          (stateSeq P (t + 1)).c (P.sourceIndex ell) =
            (stateSeq P t).c (P.sourceIndex ell) := by
        exact stateSeq_c_source_succ_eq_self_until_next_cycle P hbt ht_last
      calc
        (stateSeq P (t + 1)).c (P.sourceIndex ell)
            = (stateSeq P t).c (P.sourceIndex ell) := hpreserve
        _ = sample := iht (by
              dsimp [last] at ht_succ_last ⊢
              omega)
  exact hmain k hklo (by simpa [last] using hkhi)

private theorem snapshot_origin_exists_after_prefix
    (P : Setup) (k : ℕ) (i : Node P.n) (hk : P.K0 ≤ k) :
    ∃ τ : ℕ,
      τ ≤ k ∧ k ≤ τ + P.D ∧
        (stateSeq P k).c i = (stateSeq P τ).g i := by
  rcases exists_recent_source_transaction P k i hk with
    ⟨ell, hsource, hklo, hkhi⟩
  refine ⟨P.transactionStart ell, ?_, ?_, ?_⟩
  · have hstart_le_commit : P.transactionStart ell ≤ P.transactionEnd ell + 1 := by
      unfold Setup.transactionEnd
      have hH := P.H_pos
      omega
    exact le_trans hstart_le_commit hklo
  · have hwindow :
        P.transactionEnd (ell + P.n) ≤ P.transactionStart ell + P.D := by
      unfold Setup.transactionEnd Setup.transactionStart Setup.D
      have hD_expand :
          (ell + P.n) * P.H + P.H = ell * P.H + (P.n + 1) * P.H := by ring
      have hH := P.H_pos
      omega
    exact le_trans hkhi hwindow
  · have hsample :=
      stateSeq_c_source_eq_sample_gradient_until_next_cycle P ell k hklo hkhi
    simpa [hsource] using hsample

private theorem snapshot_error_lipschitz_of_origin
    (P : Setup) (k τ : ℕ) (i : Node P.n)
    (horigin : (stateSeq P k).c i = (stateSeq P τ).g i) :
    ‖(stateSeq P k).g i - (stateSeq P k).c i‖ ≤
      P.L * ‖X P k i - X P τ i‖ := by
  have hgk : (stateSeq P k).g i = P.localGradient i (X P k i) := by
    simpa [G] using G_eq_gradient_query P k i
  have hgτ : (stateSeq P τ).g i = P.localGradient i (X P τ i) := by
    simpa [G] using G_eq_gradient_query P τ i
  calc
    ‖(stateSeq P k).g i - (stateSeq P k).c i‖
        = ‖P.localGradient i (X P k i) - P.localGradient i (X P τ i)‖ := by
          rw [horigin, hgk, hgτ]
    _ ≤ P.L * ‖X P k i - X P τ i‖ :=
          P.local_gradient_lipschitz i (X P k i) (X P τ i)

private theorem snapshot_error_lipschitz_origin_exists_after_prefix
    (P : Setup) (k : ℕ) (i : Node P.n) (hk : P.K0 ≤ k) :
    ∃ τ : ℕ,
      τ ≤ k ∧ k ≤ τ + P.D ∧
        ‖(stateSeq P k).g i - (stateSeq P k).c i‖ ≤
          P.L * ‖X P k i - X P τ i‖ := by
  rcases snapshot_origin_exists_after_prefix P k i hk with
    ⟨τ, hτ_le, hk_age, horigin⟩
  exact ⟨τ, hτ_le, hk_age, snapshot_error_lipschitz_of_origin P k τ i horigin⟩

private theorem node_step_norm_le_roundDisplacement
    (P : Setup) (t : ℕ) (i : Node P.n) :
    ‖X P (t + 1) i - X P t i‖ ≤ roundDisplacement P t := by
  classical
  unfold roundDisplacement
  exact Finset.le_sup' (s := (Finset.univ : Finset (Node P.n)))
    (f := fun i : Node P.n => ‖X P (t + 1) i - X P t i‖) (Finset.mem_univ i)

private theorem node_state_distance_le_sum_roundDisplacement
    (P : Setup) {τ k : ℕ} (i : Node P.n) (hτk : τ ≤ k) :
    ‖X P k i - X P τ i‖ ≤ ∑ t ∈ Finset.Ico τ k, roundDisplacement P t := by
  refine Nat.le_induction ?base ?succ k hτk
  · simp
  · intro m hτm ih
    have hdecomp :
        X P (m + 1) i - X P τ i =
          (X P (m + 1) i - X P m i) + (X P m i - X P τ i) := by
      abel
    have htri :
        ‖X P (m + 1) i - X P τ i‖ ≤
          ‖X P (m + 1) i - X P m i‖ + ‖X P m i - X P τ i‖ := by
      rw [hdecomp]
      exact norm_add_le (X P (m + 1) i - X P m i) (X P m i - X P τ i)
    have hstep : ‖X P (m + 1) i - X P m i‖ ≤ roundDisplacement P m :=
      node_step_norm_le_roundDisplacement P m i
    calc
      ‖X P (m + 1) i - X P τ i‖
          ≤ ‖X P (m + 1) i - X P m i‖ + ‖X P m i - X P τ i‖ := htri
      _ ≤ roundDisplacement P m + ∑ t ∈ Finset.Ico τ m, roundDisplacement P t :=
            add_le_add hstep ih
      _ = ∑ t ∈ Finset.Ico τ (m + 1), roundDisplacement P t := by
            rw [Finset.sum_Ico_succ_top hτm]
            ring

private theorem perturbed_gradient_descent_algebra
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {gamma L : ℝ} (hgamma : 0 < gamma) (hL_nonneg : 0 ≤ L)
    (hgammaL : gamma * L ≤ (1 / 4 : ℝ)) (g v : E) :
    -gamma * ‖g‖ ^ (2 : ℕ) - gamma * ⟪g, v⟫_ℝ +
        (L / 2) * (gamma ^ (2 : ℕ) * ‖g + v‖ ^ (2 : ℕ)) ≤
      -(gamma / 2) * ‖g‖ ^ (2 : ℕ) +
        2 * gamma * ‖v‖ ^ (2 : ℕ) := by
  have hcross :
      -⟪g, v⟫_ℝ ≤ (1 / 4 : ℝ) * ‖g‖ ^ (2 : ℕ) + ‖v‖ ^ (2 : ℕ) := by
    have hneg_abs : -⟪g, v⟫_ℝ ≤ |⟪g, v⟫_ℝ| := neg_le_abs _
    have hcauchy : |⟪g, v⟫_ℝ| ≤ ‖g‖ * ‖v‖ := abs_real_inner_le_norm g v
    have hyoung :
        ‖g‖ * ‖v‖ ≤ (1 / 4 : ℝ) * ‖g‖ ^ (2 : ℕ) + ‖v‖ ^ (2 : ℕ) := by
      nlinarith [sq_nonneg ((1 / 2 : ℝ) * ‖g‖ - ‖v‖)]
    nlinarith
  have hcross_scaled :
      -gamma * ⟪g, v⟫_ℝ ≤
        gamma * ((1 / 4 : ℝ) * ‖g‖ ^ (2 : ℕ) + ‖v‖ ^ (2 : ℕ)) := by
    have hmul := mul_le_mul_of_nonneg_left hcross (le_of_lt hgamma)
    nlinarith
  have hsum_sq :
      ‖g + v‖ ^ (2 : ℕ) ≤
        2 * ‖g‖ ^ (2 : ℕ) + 2 * ‖v‖ ^ (2 : ℕ) :=
    SOptLib.norm_add_sq_le_two_mul_norm_sq_add_two_mul_norm_sq g v
  have hcoef_nonneg : 0 ≤ (L / 2) * gamma ^ (2 : ℕ) := by
    positivity
  have hsum_scaled :
      (L / 2) * (gamma ^ (2 : ℕ) * ‖g + v‖ ^ (2 : ℕ)) ≤
        (L / 2) *
          (gamma ^ (2 : ℕ) *
            (2 * ‖g‖ ^ (2 : ℕ) + 2 * ‖v‖ ^ (2 : ℕ))) := by
    have hmul := mul_le_mul_of_nonneg_left hsum_sq hcoef_nonneg
    nlinarith
  have hG_nonneg : 0 ≤ ‖g‖ ^ (2 : ℕ) := sq_nonneg _
  have hV_nonneg : 0 ≤ ‖v‖ ^ (2 : ℕ) := sq_nonneg _
  have hgamma2L_le : gamma ^ (2 : ℕ) * L ≤ gamma / 4 := by
    nlinarith [hgammaL, hgamma]
  have hgamma2L_G :
      gamma ^ (2 : ℕ) * L * ‖g‖ ^ (2 : ℕ) ≤
        (gamma / 4) * ‖g‖ ^ (2 : ℕ) :=
    mul_le_mul_of_nonneg_right hgamma2L_le hG_nonneg
  have hgamma2L_V :
      gamma ^ (2 : ℕ) * L * ‖v‖ ^ (2 : ℕ) ≤
        (gamma / 4) * ‖v‖ ^ (2 : ℕ) :=
    mul_le_mul_of_nonneg_right hgamma2L_le hV_nonneg
  nlinarith [hcross_scaled, hsum_scaled, hgamma2L_G, hgamma2L_V,
    hG_nonneg, hV_nonneg]

private theorem L_pos_of_theoremStepsizeCondition
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) :
    0 < P.L := by
  have hgamma_pos : 0 < P.gamma := hstepsize.1
  have hgamma_le_inv : P.gamma ≤ (4 * P.L)⁻¹ :=
    le_trans hstepsize.2 (min_le_left _ _)
  have hinv_pos : 0 < (4 * P.L)⁻¹ := lt_of_lt_of_le hgamma_pos hgamma_le_inv
  have hmul_pos : 0 < 4 * P.L := inv_pos.mp hinv_pos
  nlinarith

private theorem gamma_mul_L_le_quarter_of_theoremStepsizeCondition
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) :
    P.gamma * P.L ≤ (1 / 4 : ℝ) := by
  have hL_pos : 0 < P.L := L_pos_of_theoremStepsizeCondition P hstepsize
  have hgamma_le_inv : P.gamma ≤ (4 * P.L)⁻¹ :=
    le_trans hstepsize.2 (min_le_left _ _)
  have hmul := mul_le_mul_of_nonneg_right hgamma_le_inv (le_of_lt hL_pos)
  have hinv_mul : (4 * P.L)⁻¹ * P.L = (1 / 4 : ℝ) := by
    field_simp [ne_of_gt hL_pos]
  calc
    P.gamma * P.L ≤ (4 * P.L)⁻¹ * P.L := hmul
    _ = (1 / 4 : ℝ) := hinv_mul

private theorem D_pos_real (P : Setup) : 0 < (P.D : ℝ) := by
  have hD_nat : 0 < P.D := by
    unfold Setup.D
    exact Nat.mul_pos (Nat.succ_pos P.n) P.H_pos
  exact_mod_cast hD_nat

private theorem C_N_pos (P : Setup) : 0 < P.C_N := by
  unfold Setup.C_N
  have hH_real : 0 < (P.H : ℝ) := by
    exact_mod_cast P.H_pos
  exact div_pos (mul_pos (by norm_num) hH_real) P.C_N_denominator_pos

private theorem small_gain_feedback_coeff_le_half
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) :
    P.L * (P.D : ℝ) * P.gamma *
        ((1 + P.gamma * P.L) * P.C_N + 2) ≤ (1 / 2 : ℝ) := by
  have hL_pos : 0 < P.L := L_pos_of_theoremStepsizeCondition P hstepsize
  have hD_pos : 0 < (P.D : ℝ) := D_pos_real P
  have hCN_pos : 0 < P.C_N := C_N_pos P
  have hgamma_pos : 0 < P.gamma := hstepsize.1
  have hgamma_le_inv :
      P.gamma ≤ (16 * P.L * (P.D : ℝ) * (P.C_N + 2))⁻¹ :=
    le_trans hstepsize.2 (min_le_right _ _)
  have hM_pos : 0 < P.L * (P.D : ℝ) * (P.C_N + 2) := by
    positivity
  have hden_pos : 0 < 16 * (P.L * (P.D : ℝ) * (P.C_N + 2)) := by
    positivity
  have hgammaM :
      P.gamma * (P.L * (P.D : ℝ) * (P.C_N + 2)) ≤ (1 / 16 : ℝ) := by
    have hmul := mul_le_mul_of_nonneg_right hgamma_le_inv (le_of_lt hM_pos)
    have hinv_mul :
        (16 * P.L * (P.D : ℝ) * (P.C_N + 2))⁻¹ *
            (P.L * (P.D : ℝ) * (P.C_N + 2)) = (1 / 16 : ℝ) := by
      have hden_ne : 16 * (P.L * (P.D : ℝ) * (P.C_N + 2)) ≠ 0 :=
        ne_of_gt hden_pos
      field_simp [hden_ne]
    calc
      P.gamma * (P.L * (P.D : ℝ) * (P.C_N + 2))
          ≤ (16 * P.L * (P.D : ℝ) * (P.C_N + 2))⁻¹ *
              (P.L * (P.D : ℝ) * (P.C_N + 2)) := hmul
      _ = (1 / 16 : ℝ) := hinv_mul
  have hgammaL : P.gamma * P.L ≤ (1 / 4 : ℝ) :=
    gamma_mul_L_le_quarter_of_theoremStepsizeCondition P hstepsize
  have hpart :
      (1 + P.gamma * P.L) * P.C_N + 2 ≤ 8 * (P.C_N + 2) := by
    nlinarith [hgammaL, le_of_lt hCN_pos]
  have hcoef_nonneg : 0 ≤ P.L * (P.D : ℝ) * P.gamma := by
    positivity
  have hmul_part :=
    mul_le_mul_of_nonneg_left hpart hcoef_nonneg
  have hscale : 8 * (P.gamma * (P.L * (P.D : ℝ) * (P.C_N + 2))) ≤
      (1 / 2 : ℝ) := by
    nlinarith [hgammaM]
  calc
    P.L * (P.D : ℝ) * P.gamma *
        ((1 + P.gamma * P.L) * P.C_N + 2)
        ≤ P.L * (P.D : ℝ) * P.gamma * (8 * (P.C_N + 2)) := hmul_part
    _ = 8 * (P.gamma * (P.L * (P.D : ℝ) * (P.C_N + 2))) := by ring
    _ ≤ (1 / 2 : ℝ) := hscale

private theorem self_le_of_le_add_mul_self_coeff_half
    {x b α : ℝ} (hx : 0 ≤ x) (hα : α ≤ (1 / 2 : ℝ))
    (h : x ≤ b + α * x) :
    x ≤ 2 * b := by
  nlinarith

private theorem finset_sum_update_eq_add
    {ι E : Type*} [Fintype ι] [DecidableEq ι] [AddCommMonoid E]
    (s : ι) (c : ι → E) (z : E) :
    (∑ i : ι, (if i = s then c i + z else c i)) = (∑ i : ι, c i) + z := by
  classical
  calc
    (∑ i : ι, (if i = s then c i + z else c i))
        = ∑ i : ι, (c i + if i = s then z else (0 : E)) := by
          refine Finset.sum_congr rfl ?_
          intro i _hi
          by_cases his : i = s <;> simp [his]
    _ = (∑ i : ι, c i) + ∑ i : ι, (if i = s then z else (0 : E)) := by
          rw [Finset.sum_add_distrib]
    _ = (∑ i : ι, c i) + z := by
          congr 1
          simpa using
            (Finset.sum_eq_single (s := Finset.univ)
              (f := fun i : ι => if i = s then z else (0 : E)) s
              (by
                intro i _hi his
                simp [his])
              (by
                intro hs
                exact (hs (Finset.mem_univ s)).elim))

/-- Lemma 5.3 ledger invariant: every node's accumulated `R` ledger equals the
global sum of official snapshots `c`.

Source: `book/RCDGD/RCDGD.json#/key_lemmas/5/statement_math`.
Quote: "R_{1,k}=\cdots=R_{n,k}=\sum_{j=1}^n c_{j,k}".
-/
private theorem snapshot_ledger_invariant (P : Setup) (k : ℕ) :
    ∀ i : Node P.n, (stateSeq P k).R i = ∑ j : Node P.n, (stateSeq P k).c j := by
  classical
  induction k with
  | zero =>
      intro i
      simp [stateSeq, State.initial]
  | succ k ih =>
      by_cases hk : State.isEndpoint (P := P) k
      · let ell := P.transactionIndex k
        have hk_eq : k = P.transactionEnd ell := by
          simpa [State.isEndpoint, Setup.isTransactionEndpoint, Setup.currentTransactionEnd, ell] using hk
        intro i
        let s : Node P.n := P.sourceIndex ell
        let z : Vec P.d := State.endpointDecodedPayload P ell s
        have hpayload_common :
            State.endpointDecodedPayload P ell i = z := by
          dsimp [z, s]
          rw [endpoint_decodedPayload_eq_sourcePayload P ell i,
            endpoint_decodedPayload_eq_sourcePayload P ell (P.sourceIndex ell)]
        have hsum :
            (∑ j : Node P.n, (stateSeq P (P.transactionEnd ell + 1)).c j) =
              (∑ j : Node P.n, (stateSeq P (P.transactionEnd ell)).c j) + z := by
          calc
            (∑ j : Node P.n, (stateSeq P (P.transactionEnd ell + 1)).c j)
                = ∑ j : Node P.n,
                    (if j = s then
                      (stateSeq P (P.transactionEnd ell)).c j + z
                    else
                      (stateSeq P (P.transactionEnd ell)).c j) := by
                  refine Finset.sum_congr rfl ?_
                  intro j _hj
                  by_cases hjs : j = s
                  · subst j
                    dsimp [s, z]
                    simpa using stateSeq_c_source_succ_transactionEnd P ell
                  · have hother :
                        (stateSeq P (P.transactionEnd ell + 1)).c j =
                          (stateSeq P (P.transactionEnd ell)).c j := by
                        exact stateSeq_c_other_succ_transactionEnd P ell j (by
                          dsimp [s] at hjs
                          exact hjs)
                    simp [hjs, hother]
            _ = (∑ j : Node P.n, (stateSeq P (P.transactionEnd ell)).c j) + z := by
                  simpa [s] using
                    finset_sum_update_eq_add (ι := Node P.n) (E := Vec P.d) s
                      (fun j => (stateSeq P (P.transactionEnd ell)).c j) z
        have hih :
            (stateSeq P (P.transactionEnd ell)).R i =
              ∑ j : Node P.n, (stateSeq P (P.transactionEnd ell)).c j := by
          simpa [← hk_eq] using ih i
        calc
          (stateSeq P (k + 1)).R i
              = (stateSeq P (P.transactionEnd ell + 1)).R i := by
                rw [hk_eq]
          _ = (stateSeq P (P.transactionEnd ell)).R i +
                  State.endpointDecodedPayload P ell i := by
                exact stateSeq_R_succ_transactionEnd P ell i
          _ = (∑ j : Node P.n, (stateSeq P (P.transactionEnd ell)).c j) + z := by
                rw [hih, hpayload_common]
          _ = ∑ j : Node P.n, (stateSeq P (P.transactionEnd ell + 1)).c j := hsum.symm
          _ = ∑ j : Node P.n, (stateSeq P (k + 1)).c j := by
                rw [hk_eq]
      · intro i
        have hR :
            (stateSeq P (k + 1)).R i = (stateSeq P k).R i := by
          change (State.rawNext (stateSeq P k) k).R i = (stateSeq P k).R i
          exact State.rawNext_R_of_not_endpoint (P := P) (stateSeq P k) k i hk
        have hc :
            ∀ j : Node P.n, (stateSeq P (k + 1)).c j = (stateSeq P k).c j := by
          intro j
          change (State.rawNext (stateSeq P k) k).c j = (stateSeq P k).c j
          exact State.rawNext_c_of_not_endpoint (P := P) (stateSeq P k) k j hk
        calc
          (stateSeq P (k + 1)).R i = (stateSeq P k).R i := hR
          _ = ∑ j : Node P.n, (stateSeq P k).c j := ih i
          _ = ∑ j : Node P.n, (stateSeq P (k + 1)).c j := by
                refine Finset.sum_congr rfl ?_
                intro j _hj
                exact (hc j).symm

/-- Lemma 5.3 direction-average identity, obtained by substituting the ledger
invariant into `d_i = R_i/n + g_i - c_i`.

Source: `book/RCDGD/RCDGD.json#/key_lemmas/5/statement_math`.
Quote: "\frac1n\sum_i d_{i,k}=\frac1n\sum_i\nabla f_i(x_{i,k})".
-/
private theorem snapshot_direction_average_eq_gradient_average (P : Setup) (k : ℕ) :
    ((P.n : ℝ)⁻¹) • (∑ i : Node P.n, State.direction (stateSeq P k) i) =
      ((P.n : ℝ)⁻¹) • (∑ i : Node P.n, (stateSeq P k).g i) := by
  classical
  let C : Vec P.d := ∑ j : Node P.n, (stateSeq P k).c j
  have hledger : ∀ i : Node P.n, (stateSeq P k).R i = C := by
    intro i
    simpa [C] using snapshot_ledger_invariant P k i
  have hcard : (Fintype.card (Node P.n) : ℝ) = (P.n : ℝ) := by
    simp [Node]
  have hn_ne : (P.n : ℝ) ≠ 0 := ne_of_gt P.n_pos_real
  have hsum_inv_R :
      (∑ i : Node P.n, ((P.n : ℝ)⁻¹) • (stateSeq P k).R i) = C := by
    calc
      (∑ i : Node P.n, ((P.n : ℝ)⁻¹) • (stateSeq P k).R i)
          = ∑ _i : Node P.n, ((P.n : ℝ)⁻¹) • C := by
              refine Finset.sum_congr rfl ?_
              intro i _hi
              rw [hledger i]
      _ = P.n • (((P.n : ℝ)⁻¹) • C) := by
              simp [Finset.sum_const, hcard]
      _ = ((P.n : ℝ) * (P.n : ℝ)⁻¹) • C := by
              rw [← Nat.cast_smul_eq_nsmul ℝ, smul_smul]
      _ = C := by
              have hmul : (P.n : ℝ) * (P.n : ℝ)⁻¹ = 1 := by
                field_simp [hn_ne]
              rw [hmul, one_smul]
  have hsum_direction :
      (∑ i : Node P.n, State.direction (stateSeq P k) i) =
        ∑ i : Node P.n, (stateSeq P k).g i := by
    calc
      (∑ i : Node P.n, State.direction (stateSeq P k) i)
          = ∑ i : Node P.n,
              (((P.n : ℝ)⁻¹) • (stateSeq P k).R i +
                (stateSeq P k).g i - (stateSeq P k).c i) := by
              simp [State.direction]
      _ =
          (∑ i : Node P.n, ((P.n : ℝ)⁻¹) • (stateSeq P k).R i) +
            (∑ i : Node P.n, (stateSeq P k).g i) -
              (∑ i : Node P.n, (stateSeq P k).c i) := by
              simp [Finset.sum_add_distrib, Finset.sum_sub_distrib]
      _ = C + (∑ i : Node P.n, (stateSeq P k).g i) - C := by
              simp [hsum_inv_R, C]
      _ = ∑ i : Node P.n, (stateSeq P k).g i := by
              abel
  rw [hsum_direction]

/-- Direction differences cancel the common ledger term from Lemma 5.3.

Source: `book/RCDGD/RCDGD.json#/key_lemmas/6/statement_math`.
Quote: "d_{i,k}-d_{j,k}=(g_{i,k}-c_{i,k})-(g_{j,k}-c_{j,k})".
-/
private theorem snapshot_direction_sub_eq_gradient_snapshot_sub
    (P : Setup) (k : ℕ) (i j : Node P.n) :
    State.direction (stateSeq P k) i - State.direction (stateSeq P k) j =
      ((stateSeq P k).g i - (stateSeq P k).c i) -
        ((stateSeq P k).g j - (stateSeq P k).c j) := by
  have hRi := snapshot_ledger_invariant P k i
  have hRj := snapshot_ledger_invariant P k j
  simp [State.direction, hRi, hRj]
  abel

/-- Packaged Lemma 5.3 ledger invariant and direction-average identity.

Source: `book/RCDGD/RCDGD.json#/key_lemmas/5/statement_math`.
Quote: "R_{1,k}=\cdots=R_{n,k}=\sum_{j=1}^n c_{j,k},\qquad
\frac1n\sum_i d_{i,k}=\frac1n\sum_i\nabla f_i(x_{i,k})".
-/
private theorem snapshot_ledger_invariant_and_direction_average (P : Setup) (k : ℕ) :
    (∀ i : Node P.n, (stateSeq P k).R i = ∑ j : Node P.n, (stateSeq P k).c j) ∧
      ((P.n : ℝ)⁻¹) • (∑ i : Node P.n, State.direction (stateSeq P k) i) =
        ((P.n : ℝ)⁻¹) • (∑ i : Node P.n, (stateSeq P k).g i) := by
  exact ⟨snapshot_ledger_invariant P k, snapshot_direction_average_eq_gradient_average P k⟩

/-- First quantitative consequence of Lemma 5.3 used in Lemma 5.6: after the
common ledger term cancels, the direction difference is controlled by the two
current-minus-snapshot errors.

Source: `book/RCDGD/RCDGD.json#/key_lemmas/11/proof/1/math`.
Quote: "\|d_{i,k}-d_{j,k}\|\le\|g_{i,k}-c_{i,k}\|+\|g_{j,k}-c_{j,k}\|".
-/
private theorem snapshot_direction_sub_norm_le_snapshot_errors
    (P : Setup) (k : ℕ) (i j : Node P.n) :
    ‖State.direction (stateSeq P k) i - State.direction (stateSeq P k) j‖ ≤
      ‖(stateSeq P k).g i - (stateSeq P k).c i‖ +
        ‖(stateSeq P k).g j - (stateSeq P k).c j‖ := by
  rw [snapshot_direction_sub_eq_gradient_snapshot_sub P k i j]
  exact norm_sub_le ((stateSeq P k).g i - (stateSeq P k).c i)
    ((stateSeq P k).g j - (stateSeq P k).c j)

/-- The paper's stale snapshot error `h_k=max_i ||g_{i,k}-c_{i,k}||`, kept
route-local for Lemmas 5.4--5.8.

Source: `book/RCDGD/RCDGD.json#/key_lemmas/9/statement_math`.
Quote: "h_k:=\max_i\|g_{i,k}-c_{i,k}\|".
-/
private noncomputable def staleError (P : Setup) (k : ℕ) : ℝ :=
  Finset.univ.sup'
    (show (Finset.univ : Finset (Node P.n)).Nonempty from
      ⟨P.sourceIndex 0, Finset.mem_univ _⟩)
    (fun i : Node P.n => ‖(stateSeq P k).g i - (stateSeq P k).c i‖)

private theorem roundDisplacement_nonneg (P : Setup) (t : ℕ) :
    0 ≤ roundDisplacement P t := by
  exact le_trans (norm_nonneg (X P (t + 1) (P.sourceIndex 0) - X P t (P.sourceIndex 0)))
    (node_step_norm_le_roundDisplacement P t (P.sourceIndex 0))

private theorem roundDisplacement_sum_Ico_mono_left
    (P : Setup) {a b c : ℕ} (hab : a ≤ b) :
    (∑ t ∈ Finset.Ico b c, roundDisplacement P t) ≤
      ∑ t ∈ Finset.Ico a c, roundDisplacement P t := by
  classical
  exact Finset.sum_le_sum_of_subset_of_nonneg
    (by
      intro t ht
      rw [Finset.mem_Ico] at ht ⊢
      exact ⟨le_trans hab ht.1, ht.2⟩)
    (by
      intro t _htfull _htnot
      exact roundDisplacement_nonneg P t)

private theorem snapshot_error_le_moving_displacement_sum
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (k : ℕ) (i : Node P.n)
    (hk : P.K0 ≤ k) :
    ‖(stateSeq P k).g i - (stateSeq P k).c i‖ ≤
      P.L * ∑ t ∈ Finset.Ico (k - P.D) k, roundDisplacement P t := by
  rcases snapshot_error_lipschitz_origin_exists_after_prefix P k i hk with
    ⟨τ, hτ_le, hk_age, hlip⟩
  have hdist :
      ‖X P k i - X P τ i‖ ≤
        ∑ t ∈ Finset.Ico τ k, roundDisplacement P t :=
    node_state_distance_le_sum_roundDisplacement P i hτ_le
  have hleft : k - P.D ≤ τ := by
    omega
  have hwindow :
      (∑ t ∈ Finset.Ico τ k, roundDisplacement P t) ≤
        ∑ t ∈ Finset.Ico (k - P.D) k, roundDisplacement P t :=
    roundDisplacement_sum_Ico_mono_left P hleft
  have hL_nonneg : 0 ≤ P.L := le_of_lt (L_pos_of_theoremStepsizeCondition P hstepsize)
  have hscaled :
      P.L * ‖X P k i - X P τ i‖ ≤
        P.L * ∑ t ∈ Finset.Ico (k - P.D) k, roundDisplacement P t :=
    mul_le_mul_of_nonneg_left (le_trans hdist hwindow) hL_nonneg
  exact le_trans hlip hscaled

private theorem staleError_le_moving_displacement_sum
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (k : ℕ)
    (hk : P.K0 ≤ k) :
    staleError P k ≤
      P.L * ∑ t ∈ Finset.Ico (k - P.D) k, roundDisplacement P t := by
  classical
  unfold staleError
  refine Finset.sup'_le
    (show (Finset.univ : Finset (Node P.n)).Nonempty from
      ⟨P.sourceIndex 0, Finset.mem_univ _⟩)
    (fun i : Node P.n => ‖(stateSeq P k).g i - (stateSeq P k).c i‖) ?_
  intro i _hi
  exact snapshot_error_le_moving_displacement_sum P hstepsize k i hk

private theorem snapshot_error_le_staleError
    (P : Setup) (k : ℕ) (i : Node P.n) :
    ‖(stateSeq P k).g i - (stateSeq P k).c i‖ ≤ staleError P k := by
  classical
  unfold staleError
  exact Finset.le_sup'
    (s := (Finset.univ : Finset (Node P.n)))
    (f := fun i : Node P.n => ‖(stateSeq P k).g i - (stateSeq P k).c i‖)
    (Finset.mem_univ i)

private theorem staleError_nonneg (P : Setup) (k : ℕ) :
    0 ≤ staleError P k := by
  exact le_trans
    (norm_nonneg ((stateSeq P k).g (P.sourceIndex 0) - (stateSeq P k).c (P.sourceIndex 0)))
    (snapshot_error_le_staleError P k (P.sourceIndex 0))

private theorem direction_diameter_le_twice_staleError
    (P : Setup) (k : ℕ) (i j : Node P.n) :
    ‖State.direction (stateSeq P k) i - State.direction (stateSeq P k) j‖ ≤
      2 * staleError P k := by
  have hi := snapshot_error_le_staleError P k i
  have hj := snapshot_error_le_staleError P k j
  calc
    ‖State.direction (stateSeq P k) i - State.direction (stateSeq P k) j‖
        ≤ ‖(stateSeq P k).g i - (stateSeq P k).c i‖ +
            ‖(stateSeq P k).g j - (stateSeq P k).c j‖ :=
          snapshot_direction_sub_norm_le_snapshot_errors P k i j
    _ ≤ staleError P k + staleError P k := add_le_add hi hj
    _ = 2 * staleError P k := by ring

private theorem mixingProduct_direction_pair_le_twice_staleError
    (P : Setup) (t r k : ℕ) (i j : Node P.n) :
    ‖(∑ s : Node P.n,
          mixingProduct P t r i s • State.direction (stateSeq P k) s) -
        (∑ s : Node P.n,
          mixingProduct P t r j s • State.direction (stateSeq P k) s)‖ ≤
      2 * staleError P k := by
  classical
  have hmass_i : (∑ s : Node P.n, mixingProduct P t r i s) = (1 : ℝ) :=
    mixingProduct_row_sum P t r i
  have hmass_j : (∑ s : Node P.n, mixingProduct P t r j s) = (1 : ℝ) :=
    mixingProduct_row_sum P t r j
  have hmass_nonneg : (0 : ℝ) ≤ 1 := by norm_num
  simpa [one_mul] using
    weighted_average_pair_norm_le_mass_mul_diameter
      (fun s : Node P.n => mixingProduct P t r i s)
      (fun s : Node P.n => mixingProduct P t r j s)
      (fun s : Node P.n => State.direction (stateSeq P k) s)
      (1 : ℝ) (2 * staleError P k)
      (fun s => mixingProduct_nonneg P t r i s)
      (fun s => mixingProduct_nonneg P t r j s)
      hmass_i hmass_j hmass_nonneg
      (direction_diameter_le_twice_staleError P k)

private theorem h_round_direction_perturbation_norm_le
    (P : Setup) (hstepsize : P.theoremStepsizeCondition)
    (t : ℕ) (i j : Node P.n) :
    ‖P.gamma •
        (∑ q ∈ Finset.range P.H,
          ((∑ s : Node P.n,
              mixingProduct P (t + q + 1) (P.H - 1 - q) i s •
                State.direction (stateSeq P (t + q)) s) -
            (∑ s : Node P.n,
              mixingProduct P (t + q + 1) (P.H - 1 - q) j s •
                State.direction (stateSeq P (t + q)) s)))‖ ≤
      P.gamma * ∑ q ∈ Finset.range P.H, 2 * staleError P (t + q) := by
  have hγ_nonneg : 0 ≤ P.gamma := le_of_lt hstepsize.1
  calc
    ‖P.gamma •
        (∑ q ∈ Finset.range P.H,
          ((∑ s : Node P.n,
              mixingProduct P (t + q + 1) (P.H - 1 - q) i s •
                State.direction (stateSeq P (t + q)) s) -
            (∑ s : Node P.n,
              mixingProduct P (t + q + 1) (P.H - 1 - q) j s •
                State.direction (stateSeq P (t + q)) s)))‖
        = P.gamma *
            ‖∑ q ∈ Finset.range P.H,
              ((∑ s : Node P.n,
                  mixingProduct P (t + q + 1) (P.H - 1 - q) i s •
                    State.direction (stateSeq P (t + q)) s) -
                (∑ s : Node P.n,
                  mixingProduct P (t + q + 1) (P.H - 1 - q) j s •
                    State.direction (stateSeq P (t + q)) s))‖ := by
          rw [norm_smul, Real.norm_of_nonneg hγ_nonneg]
    _ ≤ P.gamma *
        (∑ q ∈ Finset.range P.H,
          ‖(∑ s : Node P.n,
              mixingProduct P (t + q + 1) (P.H - 1 - q) i s •
                State.direction (stateSeq P (t + q)) s) -
            (∑ s : Node P.n,
              mixingProduct P (t + q + 1) (P.H - 1 - q) j s •
                State.direction (stateSeq P (t + q)) s)‖) := by
          exact mul_le_mul_of_nonneg_left
            (norm_sum_le _ _) hγ_nonneg
    _ ≤ P.gamma * ∑ q ∈ Finset.range P.H, 2 * staleError P (t + q) := by
          refine mul_le_mul_of_nonneg_left ?_ hγ_nonneg
          refine Finset.sum_le_sum ?_
          intro q _hq
          exact
            mixingProduct_direction_pair_le_twice_staleError
              P (t + q + 1) (P.H - 1 - q) (t + q) i j

private theorem node_pair_distance_le_Delta
    (P : Setup) (k : ℕ) (i j : Node P.n) :
    ‖X P k i - X P k j‖ ≤ Delta P k := by
  classical
  unfold Delta
  exact Finset.le_sup'
    (s := (Finset.univ : Finset (Node P.n × Node P.n)))
    (f := fun p : Node P.n × Node P.n => ‖X P k p.1 - X P k p.2‖)
    (Finset.mem_univ (i, j))

private theorem mixingProduct_X_pair_le_Delta
    (P : Setup) (t r k : ℕ) (i j : Node P.n) :
    ‖(∑ s : Node P.n, mixingProduct P t r i s • X P k s) -
        (∑ s : Node P.n, mixingProduct P t r j s • X P k s)‖ ≤
      Delta P k := by
  classical
  have hmass_i : (∑ s : Node P.n, mixingProduct P t r i s) = (1 : ℝ) :=
    mixingProduct_row_sum P t r i
  have hmass_j : (∑ s : Node P.n, mixingProduct P t r j s) = (1 : ℝ) :=
    mixingProduct_row_sum P t r j
  have hmass_nonneg : (0 : ℝ) ≤ 1 := by norm_num
  simpa [one_mul] using
    weighted_average_pair_norm_le_mass_mul_diameter
      (fun s : Node P.n => mixingProduct P t r i s)
      (fun s : Node P.n => mixingProduct P t r j s)
      (X P k) (1 : ℝ) (Delta P k)
      (fun s => mixingProduct_nonneg P t r i s)
      (fun s => mixingProduct_nonneg P t r j s)
      hmass_i hmass_j hmass_nonneg
      (node_pair_distance_le_Delta P k)

private theorem mixingProduct_h_round_dobrushin_contraction
    (P : Setup) (t k : ℕ) (i j : Node P.n) :
    ‖(∑ s : Node P.n, mixingProduct P t P.H i s • X P k s) -
        (∑ s : Node P.n, mixingProduct P t P.H j s • X P k s)‖ ≤
      P.rho * Delta P k := by
  classical
  let ri : Node P.n → ℝ := fun s => mixingProduct P t P.H i s - P.beta
  let rj : Node P.n → ℝ := fun s => mixingProduct P t P.H j s - P.beta
  have hri_nonneg : ∀ s : Node P.n, 0 ≤ ri s := by
    intro s
    exact mixingProduct_h_round_residual_nonneg P t i s
  have hrj_nonneg : ∀ s : Node P.n, 0 ≤ rj s := by
    intro s
    exact mixingProduct_h_round_residual_nonneg P t j s
  have hri_sum : (∑ s : Node P.n, ri s) = P.rho := by
    simpa [ri] using mixingProduct_h_round_residual_row_sum_eq_rho P t i
  have hrj_sum : (∑ s : Node P.n, rj s) = P.rho := by
    simpa [rj] using mixingProduct_h_round_residual_row_sum_eq_rho P t j
  have hsplit :
      (∑ s : Node P.n, mixingProduct P t P.H i s • X P k s) -
          (∑ s : Node P.n, mixingProduct P t P.H j s • X P k s) =
        (∑ s : Node P.n, ri s • X P k s) -
          (∑ s : Node P.n, rj s • X P k s) := by
    have hi :=
      mixingProduct_h_round_residual_smul_sum_sub P t k i
    have hj :=
      mixingProduct_h_round_residual_smul_sum_sub P t k j
    dsimp [ri, rj]
    rw [hi, hj]
    abel
  have hgeom :
      ‖(∑ s : Node P.n, ri s • X P k s) -
          (∑ s : Node P.n, rj s • X P k s)‖ ≤
        P.rho * Delta P k := by
    exact
      weighted_average_pair_norm_le_mass_mul_diameter ri rj (X P k) P.rho
        (Delta P k) hri_nonneg hrj_nonneg hri_sum hrj_sum P.rho_range.1
        (node_pair_distance_le_Delta P k)
  simpa [hsplit] using hgeom

private theorem Delta_nonneg (P : Setup) (k : ℕ) :
    0 ≤ Delta P k := by
  exact le_trans (norm_nonneg (X P k (P.sourceIndex 0) - X P k (P.sourceIndex 0)))
    (node_pair_distance_le_Delta P k (P.sourceIndex 0) (P.sourceIndex 0))

private theorem node_pair_next_distance_le_delta_plus_stale
    (P : Setup) (hstepsize : P.theoremStepsizeCondition)
    (k : ℕ) (i j : Node P.n) :
    ‖X P (k + 1) i - X P (k + 1) j‖ ≤
      Delta P k + P.gamma * (2 * staleError P k) := by
  have hγ_nonneg : 0 ≤ P.gamma := le_of_lt hstepsize.1
  have hdecomp :
      X P (k + 1) i - X P (k + 1) j =
        ((∑ s : Node P.n, mixingProduct P k 1 i s • X P k s) -
          (∑ s : Node P.n, mixingProduct P k 1 j s • X P k s)) -
          P.gamma •
            (State.direction (stateSeq P k) i - State.direction (stateSeq P k) j) := by
    rw [X_succ_eq_mixingProduct_one_sub_direction P k i,
      X_succ_eq_mixingProduct_one_sub_direction P k j]
    module
  calc
    ‖X P (k + 1) i - X P (k + 1) j‖
        = ‖((∑ s : Node P.n, mixingProduct P k 1 i s • X P k s) -
              (∑ s : Node P.n, mixingProduct P k 1 j s • X P k s)) -
              P.gamma •
                (State.direction (stateSeq P k) i -
                  State.direction (stateSeq P k) j)‖ := by
            rw [hdecomp]
    _ ≤ ‖(∑ s : Node P.n, mixingProduct P k 1 i s • X P k s) -
              (∑ s : Node P.n, mixingProduct P k 1 j s • X P k s)‖ +
          ‖P.gamma •
            (State.direction (stateSeq P k) i -
              State.direction (stateSeq P k) j)‖ :=
          norm_sub_le _ _
    _ = ‖(∑ s : Node P.n, mixingProduct P k 1 i s • X P k s) -
              (∑ s : Node P.n, mixingProduct P k 1 j s • X P k s)‖ +
          P.gamma *
            ‖State.direction (stateSeq P k) i -
              State.direction (stateSeq P k) j‖ := by
          rw [norm_smul, Real.norm_of_nonneg hγ_nonneg]
    _ ≤ Delta P k + P.gamma * (2 * staleError P k) := by
          exact add_le_add
            (mixingProduct_X_pair_le_Delta P k 1 k i j)
            (mul_le_mul_of_nonneg_left
              (direction_diameter_le_twice_staleError P k i j) hγ_nonneg)

private theorem Delta_succ_le_delta_plus_stale
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (k : ℕ) :
    Delta P (k + 1) ≤ Delta P k + P.gamma * (2 * staleError P k) := by
  classical
  unfold Delta
  refine Finset.sup'_le
    (show (Finset.univ : Finset (Node P.n × Node P.n)).Nonempty from
      ⟨(P.sourceIndex 0, P.sourceIndex 0), Finset.mem_univ _⟩)
    (fun p : Node P.n × Node P.n => ‖X P (k + 1) p.1 - X P (k + 1) p.2‖) ?_
  intro p _hp
  exact node_pair_next_distance_le_delta_plus_stale P hstepsize k p.1 p.2

private theorem Delta_add_r_le_delta_plus_stale_sum
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (k r : ℕ) :
    Delta P (k + r) ≤
      Delta P k + P.gamma * ∑ q ∈ Finset.range r, 2 * staleError P (k + q) := by
  classical
  induction r with
  | zero =>
      simp
  | succ r ih =>
      have htime : k + (r + 1) = k + r + 1 := by omega
      calc
        Delta P (k + (r + 1))
            = Delta P (k + r + 1) := by rw [htime]
        _ ≤ Delta P (k + r) + P.gamma * (2 * staleError P (k + r)) :=
            Delta_succ_le_delta_plus_stale P hstepsize (k + r)
        _ ≤ (Delta P k + P.gamma * ∑ q ∈ Finset.range r,
              2 * staleError P (k + q)) +
              P.gamma * (2 * staleError P (k + r)) := by
            nlinarith
        _ = Delta P k + P.gamma *
              (∑ q ∈ Finset.range r, 2 * staleError P (k + q) +
                2 * staleError P (k + r)) := by
            ring
        _ = Delta P k + P.gamma *
              ∑ q ∈ Finset.range (r + 1), 2 * staleError P (k + q) := by
            rw [Finset.sum_range_succ]

private theorem h_round_node_pair_distance_le_rho_plus_stale_sum
    (P : Setup) (hstepsize : P.theoremStepsizeCondition)
    (k : ℕ) (i j : Node P.n) :
    ‖X P (k + P.H) i - X P (k + P.H) j‖ ≤
      P.rho * Delta P k +
        P.gamma * ∑ q ∈ Finset.range P.H, 2 * staleError P (k + q) := by
  classical
  let Yi : Vec P.d :=
    ∑ s : Node P.n, mixingProduct P k P.H i s • X P k s
  let Yj : Vec P.d :=
    ∑ s : Node P.n, mixingProduct P k P.H j s • X P k s
  let Zi : Vec P.d :=
    ∑ q ∈ Finset.range P.H,
      ∑ s : Node P.n,
        mixingProduct P (k + q + 1) (P.H - 1 - q) i s •
          State.direction (stateSeq P (k + q)) s
  let Zj : Vec P.d :=
    ∑ q ∈ Finset.range P.H,
      ∑ s : Node P.n,
        mixingProduct P (k + q + 1) (P.H - 1 - q) j s •
          State.direction (stateSeq P (k + q)) s
  have hdecomp :
      X P (k + P.H) i - X P (k + P.H) j =
        (Yi - Yj) - P.gamma • (Zi - Zj) := by
    rw [X_add_mixingProduct_unroll_sub_sum P k P.H i,
      X_add_mixingProduct_unroll_sub_sum P k P.H j]
    simp [Yi, Yj, Zi, Zj]
    module
  have hpert_form :
      P.gamma • (Zi - Zj) =
        P.gamma •
          (∑ q ∈ Finset.range P.H,
            ((∑ s : Node P.n,
                mixingProduct P (k + q + 1) (P.H - 1 - q) i s •
                  State.direction (stateSeq P (k + q)) s) -
              (∑ s : Node P.n,
                mixingProduct P (k + q + 1) (P.H - 1 - q) j s •
                  State.direction (stateSeq P (k + q)) s))) := by
    congr 1
    simp [Zi, Zj, Finset.sum_sub_distrib]
  calc
    ‖X P (k + P.H) i - X P (k + P.H) j‖
        = ‖(Yi - Yj) - P.gamma • (Zi - Zj)‖ := by
          rw [hdecomp]
    _ ≤ ‖Yi - Yj‖ + ‖P.gamma • (Zi - Zj)‖ :=
          norm_sub_le _ _
    _ ≤ P.rho * Delta P k +
        P.gamma * ∑ q ∈ Finset.range P.H, 2 * staleError P (k + q) := by
          refine add_le_add ?_ ?_
          · simpa [Yi, Yj] using
              mixingProduct_h_round_dobrushin_contraction P k k i j
          · rw [hpert_form]
            exact h_round_direction_perturbation_norm_le P hstepsize k i j

private theorem Delta_add_H_le_rho_plus_stale_sum
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (k : ℕ) :
    Delta P (k + P.H) ≤
      P.rho * Delta P k +
        P.gamma * ∑ q ∈ Finset.range P.H, 2 * staleError P (k + q) := by
  classical
  unfold Delta
  refine Finset.sup'_le
    (show (Finset.univ : Finset (Node P.n × Node P.n)).Nonempty from
      ⟨(P.sourceIndex 0, P.sourceIndex 0), Finset.mem_univ _⟩)
    (fun p : Node P.n × Node P.n => ‖X P (k + P.H) p.1 - X P (k + P.H) p.2‖) ?_
  intro p _hp
  exact h_round_node_pair_distance_le_rho_plus_stale_sum P hstepsize k p.1 p.2

private theorem finset_sum_le_sqrt_card_bound_mul_sqrt_sum_sq
    {ι : Type*} (s : Finset ι) (a : ι → ℝ) (D : ℕ)
    (hcard : s.card ≤ D) (ha_nonneg : ∀ i, i ∈ s → 0 ≤ a i) :
    (∑ i ∈ s, a i) ≤
      Real.sqrt (D : ℝ) * Real.sqrt (∑ i ∈ s, a i ^ (2 : ℕ)) := by
  classical
  have hcauchy :
      (∑ i ∈ s, (1 : ℝ) * a i) ^ (2 : ℕ) ≤
        (∑ i ∈ s, (1 : ℝ) ^ (2 : ℕ)) * ∑ i ∈ s, a i ^ (2 : ℕ) :=
    Finset.sum_mul_sq_le_sq_mul_sq s (fun _ : ι => (1 : ℝ)) a
  have hcard_real : (s.card : ℝ) ≤ (D : ℝ) := by
    exact_mod_cast hcard
  have hsq_nonneg : 0 ≤ ∑ i ∈ s, a i ^ (2 : ℕ) := by
    exact Finset.sum_nonneg (fun i _hi => sq_nonneg (a i))
  have hsquare :
      (∑ i ∈ s, a i) ^ (2 : ℕ) ≤
        (D : ℝ) * ∑ i ∈ s, a i ^ (2 : ℕ) := by
    calc
      (∑ i ∈ s, a i) ^ (2 : ℕ)
          ≤ (s.card : ℝ) * ∑ i ∈ s, a i ^ (2 : ℕ) := by
            simpa using hcauchy
      _ ≤ (D : ℝ) * ∑ i ∈ s, a i ^ (2 : ℕ) :=
            mul_le_mul_of_nonneg_right hcard_real hsq_nonneg
  have hsum_nonneg : 0 ≤ ∑ i ∈ s, a i := by
    exact Finset.sum_nonneg ha_nonneg
  have hroot := Real.sqrt_le_sqrt hsquare
  have hD_nonneg : 0 ≤ (D : ℝ) := Nat.cast_nonneg D
  calc
    (∑ i ∈ s, a i)
        = Real.sqrt ((∑ i ∈ s, a i) ^ (2 : ℕ)) := by
          rw [Real.sqrt_sq hsum_nonneg]
    _ ≤ Real.sqrt ((D : ℝ) * ∑ i ∈ s, a i ^ (2 : ℕ)) := hroot
    _ = Real.sqrt (D : ℝ) * Real.sqrt (∑ i ∈ s, a i ^ (2 : ℕ)) := by
          rw [Real.sqrt_mul hD_nonneg]

private theorem staleError_H_block_sum_le_sqrt_H_mul_range_l2
    (P : Setup) (k : ℕ) :
    (∑ q ∈ Finset.range P.H, staleError P (k + q)) ≤
      Real.sqrt (P.H : ℝ) *
        Real.sqrt (∑ q ∈ Finset.range P.H, staleError P (k + q) ^ (2 : ℕ)) := by
  exact finset_sum_le_sqrt_card_bound_mul_sqrt_sum_sq
    (Finset.range P.H) (fun q => staleError P (k + q)) P.H
    (by simp)
    (fun q _hq => staleError_nonneg P (k + q))

private theorem staleError_block_prefix_sum_le_sqrt_H_mul_range_l2
    (P : Setup) (k r : ℕ) (hr : r ≤ P.H) :
    (∑ q ∈ Finset.range r, staleError P (k + q)) ≤
      Real.sqrt (P.H : ℝ) *
        Real.sqrt (∑ q ∈ Finset.range P.H, staleError P (k + q) ^ (2 : ℕ)) := by
  have hsubset : Finset.range r ⊆ Finset.range P.H := by
    intro q hq
    rw [Finset.mem_range] at hq ⊢
    omega
  have hprefix :
      (∑ q ∈ Finset.range r, staleError P (k + q)) ≤
        ∑ q ∈ Finset.range P.H, staleError P (k + q) := by
    exact Finset.sum_le_sum_of_subset_of_nonneg hsubset
      (fun q _hqH hqr => staleError_nonneg P (k + q))
  exact le_trans hprefix (staleError_H_block_sum_le_sqrt_H_mul_range_l2 P k)

private theorem Delta_block_pointwise_le_endpoint_plus_stale_range_l2
    (P : Setup) (hstepsize : P.theoremStepsizeCondition)
    (m r : ℕ) (hr : r ≤ P.H) :
    Delta P (P.K0 + m * P.H + r) ≤
      Delta P (P.K0 + m * P.H) +
        2 * P.gamma * Real.sqrt (P.H : ℝ) *
          Real.sqrt (∑ q ∈ Finset.range P.H,
            staleError P (P.K0 + m * P.H + q) ^ (2 : ℕ)) := by
  let k := P.K0 + m * P.H
  have hγ_nonneg : 0 ≤ P.gamma := le_of_lt hstepsize.1
  have hcoef_nonneg : 0 ≤ 2 * P.gamma := by positivity
  have hdelta :
      Delta P (k + r) ≤
        Delta P k + P.gamma * ∑ q ∈ Finset.range r, 2 * staleError P (k + q) :=
    Delta_add_r_le_delta_plus_stale_sum P hstepsize k r
  have hstale :
      (∑ q ∈ Finset.range r, staleError P (k + q)) ≤
        Real.sqrt (P.H : ℝ) *
          Real.sqrt (∑ q ∈ Finset.range P.H,
            staleError P (k + q) ^ (2 : ℕ)) :=
    staleError_block_prefix_sum_le_sqrt_H_mul_range_l2 P k r hr
  calc
    Delta P (P.K0 + m * P.H + r)
        = Delta P (k + r) := by
          simp [k, Nat.add_assoc]
    _ ≤ Delta P k + P.gamma * ∑ q ∈ Finset.range r, 2 * staleError P (k + q) :=
          hdelta
    _ = Delta P k + 2 * P.gamma *
          (∑ q ∈ Finset.range r, staleError P (k + q)) := by
          rw [← Finset.mul_sum]
          ring
    _ ≤ Delta P k + 2 * P.gamma *
          (Real.sqrt (P.H : ℝ) *
            Real.sqrt (∑ q ∈ Finset.range P.H,
              staleError P (k + q) ^ (2 : ℕ))) := by
          have hmul := mul_le_mul_of_nonneg_left hstale hcoef_nonneg
          nlinarith
    _ = Delta P (P.K0 + m * P.H) +
          2 * P.gamma * Real.sqrt (P.H : ℝ) *
            Real.sqrt (∑ q ∈ Finset.range P.H,
              staleError P (P.K0 + m * P.H + q) ^ (2 : ℕ)) := by
          simp [k]
          ring

private theorem Delta_add_H_le_rho_plus_stale_range_l2
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (k : ℕ) :
    Delta P (k + P.H) ≤
      P.rho * Delta P k +
        2 * P.gamma * Real.sqrt (P.H : ℝ) *
          Real.sqrt (∑ q ∈ Finset.range P.H, staleError P (k + q) ^ (2 : ℕ)) := by
  have hγ_nonneg : 0 ≤ P.gamma := le_of_lt hstepsize.1
  have hcoef_nonneg : 0 ≤ 2 * P.gamma := by positivity
  have hblock := staleError_H_block_sum_le_sqrt_H_mul_range_l2 P k
  calc
    Delta P (k + P.H)
        ≤ P.rho * Delta P k +
            P.gamma * ∑ q ∈ Finset.range P.H, 2 * staleError P (k + q) :=
          Delta_add_H_le_rho_plus_stale_sum P hstepsize k
    _ = P.rho * Delta P k +
          2 * P.gamma * (∑ q ∈ Finset.range P.H, staleError P (k + q)) := by
          rw [← Finset.mul_sum]
          ring
    _ ≤ P.rho * Delta P k +
          2 * P.gamma *
            (Real.sqrt (P.H : ℝ) *
              Real.sqrt (∑ q ∈ Finset.range P.H,
                staleError P (k + q) ^ (2 : ℕ))) := by
          have hmul := mul_le_mul_of_nonneg_left hblock hcoef_nonneg
          nlinarith
    _ = P.rho * Delta P k +
        2 * P.gamma * Real.sqrt (P.H : ℝ) *
          Real.sqrt (∑ q ∈ Finset.range P.H, staleError P (k + q) ^ (2 : ℕ)) := by
          ring

private theorem block_endpoint_recurrence_le
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (m : ℕ) :
    Delta P (P.K0 + (m + 1) * P.H) ≤
      P.rho * Delta P (P.K0 + m * P.H) +
        2 * P.gamma * Real.sqrt (P.H : ℝ) *
          Real.sqrt (∑ q ∈ Finset.range P.H,
            staleError P (P.K0 + m * P.H + q) ^ (2 : ℕ)) := by
  let k := P.K0 + m * P.H
  have hrec := Delta_add_H_le_rho_plus_stale_range_l2 P hstepsize k
  calc
    Delta P (P.K0 + (m + 1) * P.H)
        = Delta P (k + P.H) := by
          congr 1
          simp [k, Nat.succ_mul]
          omega
    _ ≤ P.rho * Delta P k +
        2 * P.gamma * Real.sqrt (P.H : ℝ) *
          Real.sqrt (∑ q ∈ Finset.range P.H, staleError P (k + q) ^ (2 : ℕ)) :=
          hrec
    _ = P.rho * Delta P (P.K0 + m * P.H) +
        2 * P.gamma * Real.sqrt (P.H : ℝ) *
          Real.sqrt (∑ q ∈ Finset.range P.H,
            staleError P (P.K0 + m * P.H + q) ^ (2 : ℕ)) := by
          simp [k]

private theorem communication_displacement_le_Delta
    (P : Setup) (k : ℕ) (i : Node P.n) :
    ‖State.xHat (stateSeq P k) k i - X P k i‖ ≤ Delta P k := by
  classical
  have hrow := P.hnetwork.row_sum k i
  have hcenter :
      State.xHat (stateSeq P k) k i - X P k i =
        ∑ j : Node P.n, P.mixing k i j • (X P k j - X P k i) := by
    calc
      State.xHat (stateSeq P k) k i - X P k i
          = (∑ j : Node P.n, P.mixing k i j • X P k j) -
              (∑ j : Node P.n, P.mixing k i j) • X P k i := by
              simp [State.xHat, State.mixVec, X, hrow]
      _ = (∑ j : Node P.n, P.mixing k i j • X P k j) -
            ∑ j : Node P.n, P.mixing k i j • X P k i := by
              congr 1
              rw [Finset.sum_smul]
      _ = ∑ j : Node P.n,
            (P.mixing k i j • X P k j - P.mixing k i j • X P k i) := by
              rw [Finset.sum_sub_distrib]
      _ = ∑ j : Node P.n, P.mixing k i j • (X P k j - X P k i) := by
              refine Finset.sum_congr rfl ?_
              intro j _hj
              rw [smul_sub]
  calc
    ‖State.xHat (stateSeq P k) k i - X P k i‖
        = ‖∑ j : Node P.n, P.mixing k i j • (X P k j - X P k i)‖ := by
            rw [hcenter]
    _ ≤ ∑ j : Node P.n, ‖P.mixing k i j • (X P k j - X P k i)‖ :=
          norm_sum_le _ _
    _ = ∑ j : Node P.n, P.mixing k i j * ‖X P k j - X P k i‖ := by
          refine Finset.sum_congr rfl ?_
          intro j _hj
          rw [norm_smul]
          rw [Real.norm_of_nonneg (P.hnetwork.row_nonneg k i j)]
    _ ≤ ∑ j : Node P.n, P.mixing k i j * Delta P k := by
          refine Finset.sum_le_sum ?_
          intro j _hj
          exact mul_le_mul_of_nonneg_left
            (node_pair_distance_le_Delta P k j i) (P.hnetwork.row_nonneg k i j)
    _ = Delta P k := by
          rw [← Finset.sum_mul, hrow, one_mul]

private theorem node_update_displacement_le_delta_plus_direction
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (k : ℕ) (i : Node P.n) :
    ‖X P (k + 1) i - X P k i‖ ≤
      Delta P k + P.gamma * ‖State.direction (stateSeq P k) i‖ := by
  have hγ_nonneg : 0 ≤ P.gamma := le_of_lt hstepsize.1
  have hdecomp :
      X P (k + 1) i - X P k i =
        (State.xHat (stateSeq P k) k i - X P k i) -
          P.gamma • State.direction (stateSeq P k) i := by
    rw [X_succ]
    abel
  calc
    ‖X P (k + 1) i - X P k i‖
        = ‖(State.xHat (stateSeq P k) k i - X P k i) -
            P.gamma • State.direction (stateSeq P k) i‖ := by
            rw [hdecomp]
    _ ≤ ‖State.xHat (stateSeq P k) k i - X P k i‖ +
          ‖P.gamma • State.direction (stateSeq P k) i‖ :=
          norm_sub_le _ _
    _ = ‖State.xHat (stateSeq P k) k i - X P k i‖ +
          P.gamma * ‖State.direction (stateSeq P k) i‖ := by
          rw [norm_smul, Real.norm_of_nonneg hγ_nonneg]
    _ ≤ Delta P k + P.gamma * ‖State.direction (stateSeq P k) i‖ := by
          exact add_le_add (communication_displacement_le_Delta P k i) (le_refl _)

private theorem roundDisplacement_le_of_node_bound
    (P : Setup) (k : ℕ) (M : ℝ)
    (hM : ∀ i : Node P.n, ‖X P (k + 1) i - X P k i‖ ≤ M) :
    roundDisplacement P k ≤ M := by
  classical
  unfold roundDisplacement
  refine Finset.sup'_le
    (show (Finset.univ : Finset (Node P.n)).Nonempty from
      ⟨P.sourceIndex 0, Finset.mem_univ _⟩)
    (fun i : Node P.n => ‖X P (k + 1) i - X P k i‖) ?_
  intro i _hi
  exact hM i

private theorem direction_norm_le_ledger_term_plus_stale
    (P : Setup) (k : ℕ) (i : Node P.n) :
    ‖State.direction (stateSeq P k) i‖ ≤
      ‖((P.n : ℝ)⁻¹) • (stateSeq P k).R i‖ + staleError P k := by
  have hstale := snapshot_error_le_staleError P k i
  calc
    ‖State.direction (stateSeq P k) i‖
        = ‖((P.n : ℝ)⁻¹) • (stateSeq P k).R i +
            ((stateSeq P k).g i - (stateSeq P k).c i)‖ := by
            simp [State.direction]
            abel
    _ ≤ ‖((P.n : ℝ)⁻¹) • (stateSeq P k).R i‖ +
          ‖(stateSeq P k).g i - (stateSeq P k).c i‖ :=
          norm_add_le _ _
    _ ≤ ‖((P.n : ℝ)⁻¹) • (stateSeq P k).R i‖ + staleError P k :=
          add_le_add (le_refl _) hstale

private theorem roundDisplacement_le_delta_plus_gamma_of_direction_bound
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (k : ℕ) (M : ℝ)
    (hdir : ∀ i : Node P.n, ‖State.direction (stateSeq P k) i‖ ≤ M) :
    roundDisplacement P k ≤ Delta P k + P.gamma * M := by
  have hγ_nonneg : 0 ≤ P.gamma := le_of_lt hstepsize.1
  apply roundDisplacement_le_of_node_bound
  intro i
  calc
    ‖X P (k + 1) i - X P k i‖
        ≤ Delta P k + P.gamma * ‖State.direction (stateSeq P k) i‖ :=
          node_update_displacement_le_delta_plus_direction P hstepsize k i
    _ ≤ Delta P k + P.gamma * M := by
          exact add_le_add (le_refl _)
            (mul_le_mul_of_nonneg_left (hdir i) hγ_nonneg)

private theorem roundDisplacement_le_disagreement_gradient_stale_of_ledger_bound
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (k : ℕ)
    (hledger : ∀ i : Node P.n,
      ‖((P.n : ℝ)⁻¹) • (stateSeq P k).R i‖ ≤
        ‖P.aggregateGradient (xBar P k)‖ + P.L * Delta P k + staleError P k) :
    roundDisplacement P k ≤
      (1 + P.gamma * P.L) * Delta P k +
        P.gamma * ‖P.aggregateGradient (xBar P k)‖ +
          (2 * P.gamma) * staleError P k := by
  have hdir :
      ∀ i : Node P.n,
        ‖State.direction (stateSeq P k) i‖ ≤
          ‖P.aggregateGradient (xBar P k)‖ + P.L * Delta P k +
            2 * staleError P k := by
    intro i
    have hsplit := direction_norm_le_ledger_term_plus_stale P k i
    have hledger_i := hledger i
    calc
      ‖State.direction (stateSeq P k) i‖
          ≤ ‖((P.n : ℝ)⁻¹) • (stateSeq P k).R i‖ + staleError P k := hsplit
      _ ≤ (‖P.aggregateGradient (xBar P k)‖ + P.L * Delta P k + staleError P k) +
            staleError P k := by
            exact add_le_add (hledger_i) (le_refl _)
      _ = ‖P.aggregateGradient (xBar P k)‖ + P.L * Delta P k +
            2 * staleError P k := by
            ring
  calc
    roundDisplacement P k
        ≤ Delta P k +
            P.gamma *
              (‖P.aggregateGradient (xBar P k)‖ + P.L * Delta P k +
                2 * staleError P k) :=
          roundDisplacement_le_delta_plus_gamma_of_direction_bound P hstepsize k
            (‖P.aggregateGradient (xBar P k)‖ + P.L * Delta P k +
              2 * staleError P k) hdir
    _ = (1 + P.gamma * P.L) * Delta P k +
          P.gamma * ‖P.aggregateGradient (xBar P k)‖ +
            (2 * P.gamma) * staleError P k := by
          ring

/-- Finite-average calculus bridge for the aggregate objective.

Source: `book/RCDGD/RCDGD.json#/setup/problem/math`.
Quote: "f(x):=\frac1n\sum_{i=1}^n f_i(x)".
-/
private theorem aggregateGradient_eq_average_localGradient
    (P : Setup) (x : Vec P.d) :
    P.aggregateGradient x =
      ((P.n : ℝ)⁻¹) • ∑ i : Node P.n, P.localGradient i x := by
  classical
  have hF :
      ∀ i : Node P.n,
        HasGradientAt (P.localObjective i) (P.localGradient i x) x := by
    intro i
    simpa [Setup.localGradient] using
      ((P.local_differentiable i).differentiableAt (x := x)).hasGradientAt
  have hgrad :=
    SOptLib.finiteAverageObjective_hasGradientAt
      (F := fun i : Node P.n => P.localObjective i)
      (gradF := fun i : Node P.n => P.localGradient i)
      (x := x) hF
  have hcard : (Fintype.card (Node P.n) : ℝ) = (P.n : ℝ) := by
    simp [Node]
  simpa [Setup.aggregateGradient, Setup.aggregateObjective, hcard] using hgrad.gradient

private theorem aggregateObjective_hasGradientAt
    (P : Setup) (x : Vec P.d) :
    HasGradientAt P.aggregateObjective (P.aggregateGradient x) x := by
  classical
  have hF :
      ∀ i : Node P.n,
        HasGradientAt (P.localObjective i) (P.localGradient i x) x := by
    intro i
    simpa [Setup.localGradient] using
      ((P.local_differentiable i).differentiableAt (x := x)).hasGradientAt
  have hgrad :=
    SOptLib.finiteAverageObjective_hasGradientAt
      (F := fun i : Node P.n => P.localObjective i)
      (gradF := fun i : Node P.n => P.localGradient i)
      (x := x) hF
  have hcard : (Fintype.card (Node P.n) : ℝ) = (P.n : ℝ) := by
    simp [Node]
  have hgrad_eq := aggregateGradient_eq_average_localGradient P x
  simpa [Setup.aggregateObjective, hcard, hgrad_eq] using hgrad

private theorem node_to_xBar_distance_le_Delta
    (P : Setup) (k : ℕ) (i : Node P.n) :
    ‖X P k i - xBar P k‖ ≤ Delta P k := by
  classical
  have hcard : (Fintype.card (Node P.n) : ℝ) = (P.n : ℝ) := by
    simp [Node]
  have hn_ne : (P.n : ℝ) ≠ 0 := ne_of_gt P.n_pos_real
  have hrepr :
      X P k i - xBar P k =
        ((P.n : ℝ)⁻¹) • ∑ j : Node P.n, (X P k i - X P k j) := by
    calc
      X P k i - xBar P k
          = X P k i - ((P.n : ℝ)⁻¹) • ∑ j : Node P.n, X P k j := by
              simp [xBar]
      _ = ((P.n : ℝ)⁻¹) •
            (((P.n : ℝ) • X P k i) - ∑ j : Node P.n, X P k j) := by
              have hmul : (P.n : ℝ)⁻¹ * (P.n : ℝ) = 1 := by
                field_simp [hn_ne]
              rw [smul_sub, smul_smul, hmul, one_smul]
      _ = ((P.n : ℝ)⁻¹) •
            ((∑ _j : Node P.n, X P k i) - ∑ j : Node P.n, X P k j) := by
              congr 1
              simp [Finset.sum_const, hcard]
              rw [← Nat.cast_smul_eq_nsmul ℝ]
      _ = ((P.n : ℝ)⁻¹) • ∑ j : Node P.n, (X P k i - X P k j) := by
              rw [Finset.sum_sub_distrib]
  have hinv_nonneg : 0 ≤ (P.n : ℝ)⁻¹ := inv_nonneg.mpr (le_of_lt P.n_pos_real)
  calc
    ‖X P k i - xBar P k‖
        = ‖((P.n : ℝ)⁻¹) • ∑ j : Node P.n, (X P k i - X P k j)‖ := by
            rw [hrepr]
    _ = (P.n : ℝ)⁻¹ * ‖∑ j : Node P.n, (X P k i - X P k j)‖ := by
            rw [norm_smul, Real.norm_of_nonneg hinv_nonneg]
    _ ≤ (P.n : ℝ)⁻¹ * ∑ j : Node P.n, ‖X P k i - X P k j‖ := by
            exact mul_le_mul_of_nonneg_left (norm_sum_le _ _) hinv_nonneg
    _ ≤ (P.n : ℝ)⁻¹ * ∑ _j : Node P.n, Delta P k := by
            refine mul_le_mul_of_nonneg_left ?_ hinv_nonneg
            refine Finset.sum_le_sum ?_
            intro j _hj
            exact node_pair_distance_le_Delta P k i j
    _ = Delta P k := by
            have hsum :
                (∑ _j : Node P.n, Delta P k) = (P.n : ℝ) * Delta P k := by
              simp [Finset.sum_const, hcard, nsmul_eq_mul]
            rw [hsum]
            field_simp [hn_ne]

private theorem norm_inv_n_smul_sum_le_of_forall_norm_le
    (P : Setup) {v : Node P.n → Vec P.d} {B : ℝ}
    (hv : ∀ i : Node P.n, ‖v i‖ ≤ B) :
    ‖((P.n : ℝ)⁻¹) • ∑ i : Node P.n, v i‖ ≤ B := by
  classical
  have hcard : (Fintype.card (Node P.n) : ℝ) = (P.n : ℝ) := by
    simp [Node]
  have hn_ne : (P.n : ℝ) ≠ 0 := ne_of_gt P.n_pos_real
  have hinv_nonneg : 0 ≤ (P.n : ℝ)⁻¹ := inv_nonneg.mpr (le_of_lt P.n_pos_real)
  calc
    ‖((P.n : ℝ)⁻¹) • ∑ i : Node P.n, v i‖
        = (P.n : ℝ)⁻¹ * ‖∑ i : Node P.n, v i‖ := by
            rw [norm_smul, Real.norm_of_nonneg hinv_nonneg]
    _ ≤ (P.n : ℝ)⁻¹ * ∑ i : Node P.n, ‖v i‖ := by
            exact mul_le_mul_of_nonneg_left (norm_sum_le _ _) hinv_nonneg
    _ ≤ (P.n : ℝ)⁻¹ * ∑ _i : Node P.n, B := by
            refine mul_le_mul_of_nonneg_left ?_ hinv_nonneg
            exact Finset.sum_le_sum (fun i _hi => hv i)
    _ = B := by
            have hsum : (∑ _i : Node P.n, B) = (P.n : ℝ) * B := by
              simp [Finset.sum_const, hcard, nsmul_eq_mul]
            rw [hsum]
            field_simp [hn_ne]

private theorem aggregateGradient_lipschitz
    (P : Setup) (hstepsize : P.theoremStepsizeCondition)
    (x y : Vec P.d) :
    ‖P.aggregateGradient x - P.aggregateGradient y‖ ≤ P.L * ‖x - y‖ := by
  classical
  have hx := aggregateGradient_eq_average_localGradient P x
  have hy := aggregateGradient_eq_average_localGradient P y
  calc
    ‖P.aggregateGradient x - P.aggregateGradient y‖
        =
      ‖((P.n : ℝ)⁻¹) •
          ∑ i : Node P.n, (P.localGradient i x - P.localGradient i y)‖ := by
        rw [hx, hy, ← smul_sub, Finset.sum_sub_distrib]
    _ ≤ P.L * ‖x - y‖ := by
        apply norm_inv_n_smul_sum_le_of_forall_norm_le P
        intro i
        exact P.local_gradient_lipschitz i x y

private theorem aggregateObjective_smooth_quadratic_upper_bound
    (P : Setup) (hstepsize : P.theoremStepsizeCondition)
    (x y : Vec P.d) :
    P.aggregateObjective y ≤
      P.aggregateObjective x + ⟪P.aggregateGradient x, y - x⟫_ℝ +
        (P.L / 2) * ‖y - x‖ ^ (2 : ℕ) := by
  exact
    smooth_quadratic_upper_bound_of_hasGradientAt_lipschitzOn_convex
      (X := Set.univ) (f := P.aggregateObjective) (grad := P.aggregateGradient)
      (L := P.L) convex_univ
      (by
        intro z _hz
        exact aggregateObjective_hasGradientAt P z)
      (by
        intro z _hz w _hw
        exact aggregateGradient_lipschitz P hstepsize z w)
      (by simp) (by simp)

private theorem average_gradient_heterogeneity_le_L_Delta
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (k : ℕ) :
    ‖((P.n : ℝ)⁻¹) •
        ∑ j : Node P.n,
          ((stateSeq P k).g j - P.localGradient j (xBar P k))‖ ≤
      P.L * Delta P k := by
  have hL_nonneg : 0 ≤ P.L := le_of_lt (L_pos_of_theoremStepsizeCondition P hstepsize)
  apply norm_inv_n_smul_sum_le_of_forall_norm_le P
  intro j
  have hg : (stateSeq P k).g j = P.localGradient j (X P k j) := by
    simpa [G] using G_eq_gradient_query P k j
  calc
    ‖(stateSeq P k).g j - P.localGradient j (xBar P k)‖
        = ‖P.localGradient j (X P k j) - P.localGradient j (xBar P k)‖ := by
            rw [hg]
    _ ≤ P.L * ‖X P k j - xBar P k‖ := by
            simpa [Setup.localGradient] using
              P.local_gradient_lipschitz j (X P k j) (xBar P k)
    _ ≤ P.L * Delta P k := by
            exact mul_le_mul_of_nonneg_left (node_to_xBar_distance_le_Delta P k j)
              hL_nonneg

private theorem average_mixing_drift_le_Delta
    (P : Setup) (k : ℕ) :
    ‖((P.n : ℝ)⁻¹) •
        ∑ i : Node P.n, (State.xHat (stateSeq P k) k i - X P k i)‖ ≤
      Delta P k := by
  classical
  let w : Node P.n → ℝ := fun j => ∑ i : Node P.n, P.mixing k i j
  let v : Node P.n → ℝ := fun _j => 1
  have hcard : (Fintype.card (Node P.n) : ℝ) = (P.n : ℝ) := by
    simp [Node]
  have hn_pos : 0 < (P.n : ℝ) := P.n_pos_real
  have hn_nonneg : 0 ≤ (P.n : ℝ) := le_of_lt hn_pos
  have hn_ne : (P.n : ℝ) ≠ 0 := ne_of_gt hn_pos
  have hw_nonneg : ∀ j : Node P.n, 0 ≤ w j := by
    intro j
    unfold w
    exact Finset.sum_nonneg fun i _hi => P.hnetwork.row_nonneg k i j
  have hv_nonneg : ∀ j : Node P.n, 0 ≤ v j := by
    intro j
    unfold v
    norm_num
  have hw_sum : (∑ j : Node P.n, w j) = (P.n : ℝ) := by
    calc
      (∑ j : Node P.n, w j)
          = ∑ j : Node P.n, ∑ i : Node P.n, P.mixing k i j := by
              simp [w]
      _ = ∑ i : Node P.n, ∑ j : Node P.n, P.mixing k i j := by
              rw [Finset.sum_comm]
      _ = ∑ _i : Node P.n, (1 : ℝ) := by
              refine Finset.sum_congr rfl ?_
              intro i _hi
              exact P.hnetwork.row_sum k i
      _ = (P.n : ℝ) := by
              simp [hcard]
  have hv_sum : (∑ j : Node P.n, v j) = (P.n : ℝ) := by
    simp [v, hcard]
  have hsum_xHat :
      (∑ i : Node P.n, State.xHat (stateSeq P k) k i) =
        ∑ j : Node P.n, w j • X P k j := by
    calc
      (∑ i : Node P.n, State.xHat (stateSeq P k) k i)
          = ∑ i : Node P.n, ∑ j : Node P.n, P.mixing k i j • X P k j := by
              rfl
      _ = ∑ j : Node P.n, ∑ i : Node P.n, P.mixing k i j • X P k j := by
              rw [Finset.sum_comm]
      _ = ∑ j : Node P.n, w j • X P k j := by
              refine Finset.sum_congr rfl ?_
              intro j _hj
              unfold w
              rw [Finset.sum_smul]
  have hsum_x :
      (∑ i : Node P.n, X P k i) =
        ∑ j : Node P.n, v j • X P k j := by
    simp [v]
  have hsum_drift :
      (∑ i : Node P.n, (State.xHat (stateSeq P k) k i - X P k i)) =
        (∑ j : Node P.n, w j • X P k j) -
          (∑ j : Node P.n, v j • X P k j) := by
    rw [Finset.sum_sub_distrib, hsum_xHat, hsum_x]
  have hpair :
      ‖(∑ j : Node P.n, w j • X P k j) -
          (∑ j : Node P.n, v j • X P k j)‖ ≤
        (P.n : ℝ) * Delta P k :=
    weighted_average_pair_norm_le_mass_mul_diameter
      w v (fun j : Node P.n => X P k j) (P.n : ℝ) (Delta P k)
      hw_nonneg hv_nonneg hw_sum hv_sum hn_nonneg
      (fun i j => node_pair_distance_le_Delta P k i j)
  have hinv_nonneg : 0 ≤ (P.n : ℝ)⁻¹ := inv_nonneg.mpr hn_nonneg
  calc
    ‖((P.n : ℝ)⁻¹) •
        ∑ i : Node P.n, (State.xHat (stateSeq P k) k i - X P k i)‖
        =
      ‖((P.n : ℝ)⁻¹) •
        ((∑ j : Node P.n, w j • X P k j) -
          (∑ j : Node P.n, v j • X P k j))‖ := by
          rw [hsum_drift]
    _ = (P.n : ℝ)⁻¹ *
        ‖(∑ j : Node P.n, w j • X P k j) -
          (∑ j : Node P.n, v j • X P k j)‖ := by
          rw [norm_smul, Real.norm_of_nonneg hinv_nonneg]
    _ ≤ (P.n : ℝ)⁻¹ * ((P.n : ℝ) * Delta P k) := by
          exact mul_le_mul_of_nonneg_left hpair hinv_nonneg
    _ = Delta P k := by
          field_simp [hn_ne]

private theorem xBar_succ_eq_average_xHat_sub_direction
    (P : Setup) (k : ℕ) :
    xBar P (k + 1) =
      ((P.n : ℝ)⁻¹) •
          (∑ i : Node P.n, State.xHat (stateSeq P k) k i) -
        P.gamma •
          (((P.n : ℝ)⁻¹) •
            (∑ i : Node P.n, State.direction (stateSeq P k) i)) := by
  classical
  unfold xBar
  calc
    ((P.n : ℝ)⁻¹) • ∑ i : Node P.n, X P (k + 1) i
        =
      ((P.n : ℝ)⁻¹) •
        ∑ i : Node P.n,
          (State.xHat (stateSeq P k) k i -
            P.gamma • State.direction (stateSeq P k) i) := by
          simp [X_succ]
    _ =
      ((P.n : ℝ)⁻¹) •
          ((∑ i : Node P.n, State.xHat (stateSeq P k) k i) -
            ∑ i : Node P.n, P.gamma • State.direction (stateSeq P k) i) := by
          rw [Finset.sum_sub_distrib]
    _ =
      ((P.n : ℝ)⁻¹) •
          ((∑ i : Node P.n, State.xHat (stateSeq P k) k i) -
            P.gamma • ∑ i : Node P.n, State.direction (stateSeq P k) i) := by
          rw [Finset.smul_sum]
    _ =
      ((P.n : ℝ)⁻¹) •
          (∑ i : Node P.n, State.xHat (stateSeq P k) k i) -
        P.gamma •
          (((P.n : ℝ)⁻¹) •
            (∑ i : Node P.n, State.direction (stateSeq P k) i)) := by
          rw [smul_sub, smul_smul, smul_smul]
          ring_nf

private theorem average_drift_exists_and_norm_bound
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (k : ℕ) :
    ∃ v : Vec P.d,
      xBar P (k + 1) =
        xBar P k - P.gamma • (P.aggregateGradient (xBar P k) + v) ∧
      ‖v‖ ≤ (P.L + P.gamma⁻¹) * Delta P k := by
  classical
  let zeta : Vec P.d :=
    ((P.n : ℝ)⁻¹) •
      ∑ i : Node P.n, (State.xHat (stateSeq P k) k i - X P k i)
  let eg : Vec P.d :=
    ((P.n : ℝ)⁻¹) •
      ∑ i : Node P.n,
        ((stateSeq P k).g i - P.localGradient i (xBar P k))
  refine ⟨eg - P.gamma⁻¹ • zeta, ?_, ?_⟩
  · have hxbar_succ := xBar_succ_eq_average_xHat_sub_direction P k
    have hdir := snapshot_direction_average_eq_gradient_average P k
    have hgrad := aggregateGradient_eq_average_localGradient P (xBar P k)
    have havg_xHat :
        ((P.n : ℝ)⁻¹) •
            (∑ i : Node P.n, State.xHat (stateSeq P k) k i) =
          xBar P k + zeta := by
      unfold zeta xBar
      rw [Finset.sum_sub_distrib, smul_sub]
      abel
    have havg_g :
        ((P.n : ℝ)⁻¹) • (∑ i : Node P.n, (stateSeq P k).g i) =
          P.aggregateGradient (xBar P k) + eg := by
      unfold eg
      rw [Finset.sum_sub_distrib, smul_sub]
      rw [hgrad]
      abel
    calc
      xBar P (k + 1)
          =
        ((P.n : ℝ)⁻¹) •
            (∑ i : Node P.n, State.xHat (stateSeq P k) k i) -
          P.gamma •
            (((P.n : ℝ)⁻¹) •
              (∑ i : Node P.n, State.direction (stateSeq P k) i)) := hxbar_succ
      _ = (xBar P k + zeta) -
          P.gamma • (((P.n : ℝ)⁻¹) •
            (∑ i : Node P.n, (stateSeq P k).g i)) := by
          rw [havg_xHat, hdir]
      _ = (xBar P k + zeta) -
          P.gamma • (P.aggregateGradient (xBar P k) + eg) := by
          rw [havg_g]
      _ = xBar P k -
          P.gamma •
            (P.aggregateGradient (xBar P k) + (eg - P.gamma⁻¹ • zeta)) := by
          have hgamma_ne : P.gamma ≠ 0 := ne_of_gt hstepsize.1
          have hmul : P.gamma * P.gamma⁻¹ = 1 := by
            field_simp [hgamma_ne]
          simp only [smul_add, smul_sub, smul_smul, hmul, one_smul]
          abel
  · have heg : ‖eg‖ ≤ P.L * Delta P k := by
      simpa [eg] using average_gradient_heterogeneity_le_L_Delta P hstepsize k
    have hzeta : ‖zeta‖ ≤ Delta P k := by
      simpa [zeta] using average_mixing_drift_le_Delta P k
    have hgamma_inv_nonneg : 0 ≤ P.gamma⁻¹ :=
      inv_nonneg.mpr (le_of_lt hstepsize.1)
    calc
      ‖eg - P.gamma⁻¹ • zeta‖
          ≤ ‖eg‖ + ‖P.gamma⁻¹ • zeta‖ := norm_sub_le eg (P.gamma⁻¹ • zeta)
      _ = ‖eg‖ + P.gamma⁻¹ * ‖zeta‖ := by
          have hnorm_zeta :
              ‖P.gamma⁻¹ • zeta‖ = P.gamma⁻¹ * ‖zeta‖ := by
            rw [norm_smul, Real.norm_of_nonneg hgamma_inv_nonneg]
          rw [hnorm_zeta]
      _ ≤ P.L * Delta P k + P.gamma⁻¹ * Delta P k := by
          exact add_le_add heg
            (mul_le_mul_of_nonneg_left hzeta hgamma_inv_nonneg)
      _ = (P.L + P.gamma⁻¹) * Delta P k := by
          ring

private theorem drifted_descent_bound
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (k : ℕ) :
    ∃ v : Vec P.d,
      xBar P (k + 1) =
        xBar P k - P.gamma • (P.aggregateGradient (xBar P k) + v) ∧
      ‖v‖ ≤ (P.L + P.gamma⁻¹) * Delta P k ∧
      P.aggregateObjective (xBar P (k + 1)) ≤
        P.aggregateObjective (xBar P k) -
          P.gamma / 2 * ‖P.aggregateGradient (xBar P k)‖ ^ (2 : ℕ) +
        2 * P.gamma * ‖v‖ ^ (2 : ℕ) := by
  classical
  rcases average_drift_exists_and_norm_bound P hstepsize k with ⟨v, hupdate, hv⟩
  refine ⟨v, hupdate, hv, ?_⟩
  let x : Vec P.d := xBar P k
  let g : Vec P.d := P.aggregateGradient x
  have hgamma_nonneg : 0 ≤ P.gamma := le_of_lt hstepsize.1
  have hL_nonneg : 0 ≤ P.L :=
    le_of_lt (L_pos_of_theoremStepsizeCondition P hstepsize)
  have hsmooth :=
    aggregateObjective_smooth_quadratic_upper_bound P hstepsize x (xBar P (k + 1))
  have hdiff : xBar P (k + 1) - x = -(P.gamma • (g + v)) := by
    rw [hupdate]
    simp [x, g]
  have hinner :
      ⟪g, xBar P (k + 1) - x⟫_ℝ =
        -P.gamma * ‖g‖ ^ (2 : ℕ) - P.gamma * ⟪g, v⟫_ℝ := by
    rw [hdiff]
    simp [inner_add_right, inner_smul_right]
    ring
  have hquad :
      ‖xBar P (k + 1) - x‖ ^ (2 : ℕ) =
        P.gamma ^ (2 : ℕ) * ‖g + v‖ ^ (2 : ℕ) := by
    rw [hdiff, norm_neg, norm_smul, Real.norm_of_nonneg hgamma_nonneg]
    ring
  have hraw :
      P.aggregateObjective (xBar P (k + 1)) ≤
        P.aggregateObjective x +
          (-P.gamma * ‖g‖ ^ (2 : ℕ) - P.gamma * ⟪g, v⟫_ℝ) +
          (P.L / 2) *
            (P.gamma ^ (2 : ℕ) * ‖g + v‖ ^ (2 : ℕ)) := by
    calc
      P.aggregateObjective (xBar P (k + 1))
          ≤ P.aggregateObjective x +
              ⟪g, xBar P (k + 1) - x⟫_ℝ +
              (P.L / 2) * ‖xBar P (k + 1) - x‖ ^ (2 : ℕ) := by
            simpa [x, g] using hsmooth
      _ = P.aggregateObjective x +
          (-P.gamma * ‖g‖ ^ (2 : ℕ) - P.gamma * ⟪g, v⟫_ℝ) +
          (P.L / 2) *
            (P.gamma ^ (2 : ℕ) * ‖g + v‖ ^ (2 : ℕ)) := by
            rw [hinner, hquad]
  have halg :=
    perturbed_gradient_descent_algebra
      (hgamma := hstepsize.1) (hL_nonneg := hL_nonneg)
      (hgammaL := gamma_mul_L_le_quarter_of_theoremStepsizeCondition P hstepsize)
      (g := g) (v := v)
  calc
    P.aggregateObjective (xBar P (k + 1))
        ≤ P.aggregateObjective x +
          (-P.gamma * ‖g‖ ^ (2 : ℕ) - P.gamma * ⟪g, v⟫_ℝ) +
          (P.L / 2) *
            (P.gamma ^ (2 : ℕ) * ‖g + v‖ ^ (2 : ℕ)) := hraw
    _ ≤ P.aggregateObjective x -
          P.gamma / 2 * ‖g‖ ^ (2 : ℕ) +
        2 * P.gamma * ‖v‖ ^ (2 : ℕ) := by
          nlinarith [halg]
    _ = P.aggregateObjective (xBar P k) -
          P.gamma / 2 * ‖P.aggregateGradient (xBar P k)‖ ^ (2 : ℕ) +
        2 * P.gamma * ‖v‖ ^ (2 : ℕ) := by
          simp [x, g]

private theorem drifted_descent_delta_bound
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (k : ℕ) :
    P.aggregateObjective (xBar P (k + 1)) ≤
      P.aggregateObjective (xBar P k) -
        P.gamma / 2 * ‖P.aggregateGradient (xBar P k)‖ ^ (2 : ℕ) +
      2 * P.gamma *
        ((P.L + P.gamma⁻¹) ^ (2 : ℕ) * Delta P k ^ (2 : ℕ)) := by
  rcases drifted_descent_bound P hstepsize k with ⟨v, _hupdate, hv, hdesc⟩
  have hL_nonneg : 0 ≤ P.L :=
    le_of_lt (L_pos_of_theoremStepsizeCondition P hstepsize)
  have hgamma_inv_nonneg : 0 ≤ P.gamma⁻¹ :=
    inv_nonneg.mpr (le_of_lt hstepsize.1)
  have hcoef_nonneg : 0 ≤ P.L + P.gamma⁻¹ := add_nonneg hL_nonneg hgamma_inv_nonneg
  have hDelta_nonneg : 0 ≤ Delta P k := Delta_nonneg P k
  have hrhs_nonneg : 0 ≤ (P.L + P.gamma⁻¹) * Delta P k :=
    mul_nonneg hcoef_nonneg hDelta_nonneg
  have hv_sq :
      ‖v‖ ^ (2 : ℕ) ≤
        ((P.L + P.gamma⁻¹) * Delta P k) ^ (2 : ℕ) :=
    (sq_le_sq₀ (norm_nonneg v) hrhs_nonneg).mpr hv
  have hv_sq' :
      ‖v‖ ^ (2 : ℕ) ≤
        (P.L + P.gamma⁻¹) ^ (2 : ℕ) * Delta P k ^ (2 : ℕ) := by
    calc
      ‖v‖ ^ (2 : ℕ)
          ≤ ((P.L + P.gamma⁻¹) * Delta P k) ^ (2 : ℕ) := hv_sq
      _ = (P.L + P.gamma⁻¹) ^ (2 : ℕ) * Delta P k ^ (2 : ℕ) := by
          ring
  have hscale_nonneg : 0 ≤ 2 * P.gamma := by nlinarith [hstepsize.1]
  have hscaled :
      2 * P.gamma * ‖v‖ ^ (2 : ℕ) ≤
        2 * P.gamma *
          ((P.L + P.gamma⁻¹) ^ (2 : ℕ) * Delta P k ^ (2 : ℕ)) :=
    mul_le_mul_of_nonneg_left hv_sq' hscale_nonneg
  nlinarith [hdesc, hscaled]

private theorem average_snapshot_error_le_staleError
    (P : Setup) (k : ℕ) :
    ‖((P.n : ℝ)⁻¹) •
        ∑ j : Node P.n, ((stateSeq P k).c j - (stateSeq P k).g j)‖ ≤
      staleError P k := by
  apply norm_inv_n_smul_sum_le_of_forall_norm_le P
  intro j
  calc
    ‖(stateSeq P k).c j - (stateSeq P k).g j‖
        = ‖(stateSeq P k).g j - (stateSeq P k).c j‖ := by
            rw [norm_sub_rev]
    _ ≤ staleError P k := snapshot_error_le_staleError P k j

private theorem ledger_average_norm_bound
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (k : ℕ) (i : Node P.n) :
    ‖((P.n : ℝ)⁻¹) • (stateSeq P k).R i‖ ≤
      ‖P.aggregateGradient (xBar P k)‖ + P.L * Delta P k + staleError P k := by
  classical
  let avgGradErr : Vec P.d :=
    ((P.n : ℝ)⁻¹) •
      ∑ j : Node P.n,
        ((stateSeq P k).g j - P.localGradient j (xBar P k))
  let avgStaleErr : Vec P.d :=
    ((P.n : ℝ)⁻¹) •
      ∑ j : Node P.n, ((stateSeq P k).c j - (stateSeq P k).g j)
  have hsum :
      (∑ j : Node P.n, (stateSeq P k).c j) =
        (∑ j : Node P.n, P.localGradient j (xBar P k)) +
          (∑ j : Node P.n,
            ((stateSeq P k).g j - P.localGradient j (xBar P k))) +
          (∑ j : Node P.n, ((stateSeq P k).c j - (stateSeq P k).g j)) := by
    calc
      (∑ j : Node P.n, (stateSeq P k).c j)
          = ∑ j : Node P.n,
              (P.localGradient j (xBar P k) +
                ((stateSeq P k).g j - P.localGradient j (xBar P k)) +
                ((stateSeq P k).c j - (stateSeq P k).g j)) := by
                refine Finset.sum_congr rfl ?_
                intro j _hj
                abel
      _ = (∑ j : Node P.n, P.localGradient j (xBar P k)) +
            (∑ j : Node P.n,
              ((stateSeq P k).g j - P.localGradient j (xBar P k))) +
            (∑ j : Node P.n, ((stateSeq P k).c j - (stateSeq P k).g j)) := by
              simp [Finset.sum_add_distrib]
  have hdecomp :
      ((P.n : ℝ)⁻¹) • (stateSeq P k).R i =
        P.aggregateGradient (xBar P k) + avgGradErr + avgStaleErr := by
    calc
      ((P.n : ℝ)⁻¹) • (stateSeq P k).R i
          = ((P.n : ℝ)⁻¹) • ∑ j : Node P.n, (stateSeq P k).c j := by
              rw [snapshot_ledger_invariant P k i]
      _ = ((P.n : ℝ)⁻¹) •
            ((∑ j : Node P.n, P.localGradient j (xBar P k)) +
              (∑ j : Node P.n,
                ((stateSeq P k).g j - P.localGradient j (xBar P k))) +
              (∑ j : Node P.n, ((stateSeq P k).c j - (stateSeq P k).g j))) := by
              rw [hsum]
      _ = ((P.n : ℝ)⁻¹) • (∑ j : Node P.n, P.localGradient j (xBar P k)) +
            avgGradErr + avgStaleErr := by
              rw [smul_add, smul_add]
      _ = P.aggregateGradient (xBar P k) + avgGradErr + avgStaleErr := by
              rw [← aggregateGradient_eq_average_localGradient P (xBar P k)]
  have hgrad := average_gradient_heterogeneity_le_L_Delta P hstepsize k
  have hstale := average_snapshot_error_le_staleError P k
  have htri :
      ‖P.aggregateGradient (xBar P k) + avgGradErr + avgStaleErr‖ ≤
        ‖P.aggregateGradient (xBar P k)‖ + ‖avgGradErr‖ + ‖avgStaleErr‖ := by
    calc
      ‖P.aggregateGradient (xBar P k) + avgGradErr + avgStaleErr‖
          ≤ ‖P.aggregateGradient (xBar P k) + avgGradErr‖ + ‖avgStaleErr‖ :=
              norm_add_le _ _
      _ ≤ (‖P.aggregateGradient (xBar P k)‖ + ‖avgGradErr‖) + ‖avgStaleErr‖ := by
              simpa [add_assoc, add_comm, add_left_comm] using
                add_le_add_right
                  (norm_add_le (P.aggregateGradient (xBar P k)) avgGradErr)
                  ‖avgStaleErr‖
      _ = ‖P.aggregateGradient (xBar P k)‖ + ‖avgGradErr‖ + ‖avgStaleErr‖ := by
              ring
  calc
    ‖((P.n : ℝ)⁻¹) • (stateSeq P k).R i‖
        = ‖P.aggregateGradient (xBar P k) + avgGradErr + avgStaleErr‖ := by
            rw [hdecomp]
    _ ≤ ‖P.aggregateGradient (xBar P k)‖ + ‖avgGradErr‖ + ‖avgStaleErr‖ := htri
    _ ≤ ‖P.aggregateGradient (xBar P k)‖ + P.L * Delta P k + staleError P k := by
            have hgrad' : ‖avgGradErr‖ ≤ P.L * Delta P k := by
              simpa [avgGradErr] using hgrad
            have hstale' : ‖avgStaleErr‖ ≤ staleError P k := by
              simpa [avgStaleErr] using hstale
            nlinarith

private theorem roundDisplacement_le_disagreement_gradient_stale
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (k : ℕ) :
    roundDisplacement P k ≤
      (1 + P.gamma * P.L) * Delta P k +
        P.gamma * ‖P.aggregateGradient (xBar P k)‖ +
          (2 * P.gamma) * staleError P k := by
  exact roundDisplacement_le_disagreement_gradient_stale_of_ledger_bound
    P hstepsize k (fun i => ledger_average_norm_bound P hstepsize k i)

private theorem finiteHorizonL2Norm_mono_nonneg
    {u v : ℕ → ℝ} {p q : ℕ}
    (hu_nonneg : ∀ k, k ∈ Finset.Ico p q → 0 ≤ u k)
    (huv : ∀ k, k ∈ Finset.Ico p q → u k ≤ v k) :
    Setup.finiteHorizonL2Norm u p q ≤ Setup.finiteHorizonL2Norm v p q := by
  unfold Setup.finiteHorizonL2Norm
  apply Real.sqrt_le_sqrt
  refine Finset.sum_le_sum ?_
  intro k hk
  have huk : 0 ≤ u k := hu_nonneg k hk
  have huvk : u k ≤ v k := huv k hk
  have hvk : 0 ≤ v k := le_trans huk huvk
  nlinarith [sq_nonneg (v k - u k)]

private theorem finiteHorizonL2Norm_const_mul_of_nonneg
    (u : ℕ → ℝ) (p q : ℕ) {c : ℝ} (hc : 0 ≤ c) :
    Setup.finiteHorizonL2Norm (fun k => c * u k) p q =
      c * Setup.finiteHorizonL2Norm u p q := by
  unfold Setup.finiteHorizonL2Norm
  have hsum_eq :
      (∑ k ∈ Finset.Ico p q, (c * u k) ^ (2 : ℕ)) =
        c ^ (2 : ℕ) * ∑ k ∈ Finset.Ico p q, u k ^ (2 : ℕ) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl ?_
    intro k _hk
    ring
  rw [hsum_eq]
  rw [Real.sqrt_mul (sq_nonneg c)]
  rw [Real.sqrt_sq hc]

private theorem finiteHorizonL2Norm_add_le
    (u v : ℕ → ℝ) (p q : ℕ) :
    Setup.finiteHorizonL2Norm (fun k => u k + v k) p q ≤
      Setup.finiteHorizonL2Norm u p q + Setup.finiteHorizonL2Norm v p q := by
  unfold Setup.finiteHorizonL2Norm
  let s := Finset.Ico p q
  let A : ℝ := ∑ k ∈ s, u k ^ (2 : ℕ)
  let B : ℝ := ∑ k ∈ s, v k ^ (2 : ℕ)
  let C : ℝ := ∑ k ∈ s, u k * v k
  have hA_nonneg : 0 ≤ A := by
    exact Finset.sum_nonneg (fun k _hk => sq_nonneg (u k))
  have hB_nonneg : 0 ≤ B := by
    exact Finset.sum_nonneg (fun k _hk => sq_nonneg (v k))
  have hcross : C ≤ Real.sqrt A * Real.sqrt B := by
    simpa [A, B, C, s] using Real.sum_mul_le_sqrt_mul_sqrt s u v
  have hsum_expand :
      (∑ k ∈ s, (u k + v k) ^ (2 : ℕ)) = A + 2 * C + B := by
    calc
      (∑ k ∈ s, (u k + v k) ^ (2 : ℕ))
          = ∑ k ∈ s, (u k ^ (2 : ℕ) + 2 * (u k * v k) + v k ^ (2 : ℕ)) := by
            refine Finset.sum_congr rfl ?_
            intro k _hk
            ring
      _ = (∑ k ∈ s, u k ^ (2 : ℕ)) +
            2 * (∑ k ∈ s, u k * v k) +
              ∑ k ∈ s, v k ^ (2 : ℕ) := by
            simp [Finset.sum_add_distrib, Finset.mul_sum]
      _ = A + 2 * C + B := by
            simp [A, B, C]
  have hrhs_expand :
      (Real.sqrt A + Real.sqrt B) ^ (2 : ℕ) =
        A + 2 * (Real.sqrt A * Real.sqrt B) + B := by
    calc
      (Real.sqrt A + Real.sqrt B) ^ (2 : ℕ)
          = (Real.sqrt A) ^ (2 : ℕ) +
              2 * (Real.sqrt A * Real.sqrt B) +
                (Real.sqrt B) ^ (2 : ℕ) := by
            ring
      _ = A + 2 * (Real.sqrt A * Real.sqrt B) + B := by
            rw [Real.sq_sqrt hA_nonneg, Real.sq_sqrt hB_nonneg]
  have hsquare :
      (∑ k ∈ s, (u k + v k) ^ (2 : ℕ)) ≤
        (Real.sqrt A + Real.sqrt B) ^ (2 : ℕ) := by
    rw [hsum_expand, hrhs_expand]
    nlinarith
  have hroot := Real.sqrt_le_sqrt hsquare
  simpa [A, B, s, Real.sqrt_sq (add_nonneg (Real.sqrt_nonneg A) (Real.sqrt_nonneg B))] using hroot

private theorem finiteHorizonL2Norm_three_term_le_of_pointwise
    {u a b c : ℕ → ℝ} {p q : ℕ} {α β χ : ℝ}
    (hα : 0 ≤ α) (hβ : 0 ≤ β) (hχ : 0 ≤ χ)
    (hu_nonneg : ∀ k, k ∈ Finset.Ico p q → 0 ≤ u k)
    (hpoint :
      ∀ k, k ∈ Finset.Ico p q → u k ≤ α * a k + β * b k + χ * c k) :
    Setup.finiteHorizonL2Norm u p q ≤
      α * Setup.finiteHorizonL2Norm a p q +
        β * Setup.finiteHorizonL2Norm b p q +
          χ * Setup.finiteHorizonL2Norm c p q := by
  have hmono :
      Setup.finiteHorizonL2Norm u p q ≤
        Setup.finiteHorizonL2Norm
          (fun k => α * a k + (β * b k + χ * c k)) p q := by
    apply finiteHorizonL2Norm_mono_nonneg hu_nonneg
    intro k hk
    have hkpoint := hpoint k hk
    nlinarith
  have htri₁ :
      Setup.finiteHorizonL2Norm
          (fun k => α * a k + (β * b k + χ * c k)) p q ≤
        Setup.finiteHorizonL2Norm (fun k => α * a k) p q +
          Setup.finiteHorizonL2Norm (fun k => β * b k + χ * c k) p q :=
    finiteHorizonL2Norm_add_le (fun k => α * a k) (fun k => β * b k + χ * c k) p q
  have htri₂ :
      Setup.finiteHorizonL2Norm (fun k => β * b k + χ * c k) p q ≤
        Setup.finiteHorizonL2Norm (fun k => β * b k) p q +
          Setup.finiteHorizonL2Norm (fun k => χ * c k) p q :=
    finiteHorizonL2Norm_add_le (fun k => β * b k) (fun k => χ * c k) p q
  have hαeq :
      Setup.finiteHorizonL2Norm (fun k => α * a k) p q =
        α * Setup.finiteHorizonL2Norm a p q :=
    finiteHorizonL2Norm_const_mul_of_nonneg a p q hα
  have hβeq :
      Setup.finiteHorizonL2Norm (fun k => β * b k) p q =
        β * Setup.finiteHorizonL2Norm b p q :=
    finiteHorizonL2Norm_const_mul_of_nonneg b p q hβ
  have hχeq :
      Setup.finiteHorizonL2Norm (fun k => χ * c k) p q =
        χ * Setup.finiteHorizonL2Norm c p q :=
    finiteHorizonL2Norm_const_mul_of_nonneg c p q hχ
  calc
    Setup.finiteHorizonL2Norm u p q
        ≤ Setup.finiteHorizonL2Norm
            (fun k => α * a k + (β * b k + χ * c k)) p q := hmono
    _ ≤ Setup.finiteHorizonL2Norm (fun k => α * a k) p q +
          Setup.finiteHorizonL2Norm (fun k => β * b k + χ * c k) p q := htri₁
    _ ≤ Setup.finiteHorizonL2Norm (fun k => α * a k) p q +
          (Setup.finiteHorizonL2Norm (fun k => β * b k) p q +
            Setup.finiteHorizonL2Norm (fun k => χ * c k) p q) := by
          exact add_le_add (le_refl _) htri₂
    _ = α * Setup.finiteHorizonL2Norm a p q +
          β * Setup.finiteHorizonL2Norm b p q +
            χ * Setup.finiteHorizonL2Norm c p q := by
          rw [hαeq, hβeq, hχeq]
          ring

private theorem finite_horizon_movement_norm_bound_of_pointwise
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) {T : ℕ}
    (hpoint : ∀ k, P.K0 ≤ k →
      roundDisplacement P k ≤
        (1 + P.gamma * P.L) * Delta P k +
          P.gamma * ‖P.aggregateGradient (xBar P k)‖ +
            (2 * P.gamma) * staleError P k) :
    Setup.finiteHorizonL2Norm (roundDisplacement P) P.K0 T ≤
      (1 + P.gamma * P.L) * Setup.finiteHorizonL2Norm (Delta P) P.K0 T +
        P.gamma *
          Setup.finiteHorizonL2Norm
            (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 T +
          (2 * P.gamma) * Setup.finiteHorizonL2Norm (staleError P) P.K0 T := by
  have hγ_pos : 0 < P.gamma := hstepsize.1
  have hL_pos : 0 < P.L := L_pos_of_theoremStepsizeCondition P hstepsize
  have hα : 0 ≤ 1 + P.gamma * P.L := by positivity
  have hβ : 0 ≤ P.gamma := le_of_lt hγ_pos
  have hχ : 0 ≤ 2 * P.gamma := by positivity
  exact finiteHorizonL2Norm_three_term_le_of_pointwise
    (u := roundDisplacement P)
    (a := Delta P)
    (b := fun k => ‖P.aggregateGradient (xBar P k)‖)
    (c := staleError P)
    (p := P.K0) (q := T)
    hα hβ hχ
    (fun k _hk => roundDisplacement_nonneg P k)
    (fun k hk => hpoint k (by
      rw [Finset.mem_Ico] at hk
      exact hk.1))

private theorem finite_horizon_movement_norm_bound
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) {T : ℕ} :
    Setup.finiteHorizonL2Norm (roundDisplacement P) P.K0 T ≤
      (1 + P.gamma * P.L) * Setup.finiteHorizonL2Norm (Delta P) P.K0 T +
        P.gamma *
          Setup.finiteHorizonL2Norm
            (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 T +
          (2 * P.gamma) * Setup.finiteHorizonL2Norm (staleError P) P.K0 T := by
  exact finite_horizon_movement_norm_bound_of_pointwise P hstepsize
    (fun k _hk => roundDisplacement_le_disagreement_gradient_stale P hstepsize k)

private theorem finiteHorizonL2Norm_finset_sum_le
    {ι : Type*} [DecidableEq ι] (s : Finset ι) (f : ι → ℕ → ℝ) (p q : ℕ) :
    Setup.finiteHorizonL2Norm (fun k => ∑ i ∈ s, f i k) p q ≤
      ∑ i ∈ s, Setup.finiteHorizonL2Norm (f i) p q := by
  classical
  refine Finset.induction_on s ?_ ?_
  · simp [Setup.finiteHorizonL2Norm]
  · intro a s ha ih
    calc
      Setup.finiteHorizonL2Norm (fun k => ∑ i ∈ insert a s, f i k) p q
          = Setup.finiteHorizonL2Norm
              (fun k => f a k + ∑ i ∈ s, f i k) p q := by
            simp [Finset.sum_insert, ha]
      _ ≤ Setup.finiteHorizonL2Norm (f a) p q +
            Setup.finiteHorizonL2Norm (fun k => ∑ i ∈ s, f i k) p q :=
          finiteHorizonL2Norm_add_le (f a) (fun k => ∑ i ∈ s, f i k) p q
      _ ≤ Setup.finiteHorizonL2Norm (f a) p q +
            ∑ i ∈ s, Setup.finiteHorizonL2Norm (f i) p q :=
          add_le_add_right ih _
      _ = ∑ i ∈ insert a s, Setup.finiteHorizonL2Norm (f i) p q := by
          simp [Finset.sum_insert, ha]

private theorem finiteHorizonL2Norm_congr_on
    {u v : ℕ → ℝ} {p q : ℕ}
    (huv : ∀ k, k ∈ Finset.Ico p q → u k = v k) :
    Setup.finiteHorizonL2Norm u p q = Setup.finiteHorizonL2Norm v p q := by
  unfold Setup.finiteHorizonL2Norm
  congr 1
  refine Finset.sum_congr rfl ?_
  intro k hk
  rw [huv k hk]

private theorem geom_sq_sum_le_inv_one_sub_sq
    {rho : ℝ} (hrho_nonneg : 0 ≤ rho) (hrho_lt_one : rho < 1) (M : ℕ) :
    (∑ m ∈ Finset.range M, (rho ^ (2 : ℕ)) ^ m) ≤
      (1 - rho ^ (2 : ℕ))⁻¹ := by
  let x : ℝ := rho ^ (2 : ℕ)
  have hx_nonneg : 0 ≤ x := by
    exact sq_nonneg rho
  have hx_lt_one : x < 1 := by
    dsimp [x]
    nlinarith [sq_nonneg rho]
  have hden_pos : 0 < 1 - x := by nlinarith
  have hden_nonneg : 0 ≤ 1 - x := le_of_lt hden_pos
  let S : ℝ := ∑ m ∈ Finset.range M, x ^ m
  have hgeom : S * (1 - x) = 1 - x ^ M := by
    simpa [S] using geom_sum_mul_neg x M
  have hxpow_nonneg : 0 ≤ x ^ M := pow_nonneg hx_nonneg M
  have hmul_le_one : S * (1 - x) ≤ 1 := by
    nlinarith
  calc
    (∑ m ∈ Finset.range M, (rho ^ (2 : ℕ)) ^ m)
        = S := by simp [S, x]
    _ = (S * (1 - x)) * (1 - x)⁻¹ := by
          field_simp [ne_of_gt hden_pos]
    _ ≤ 1 * (1 - x)⁻¹ :=
          mul_le_mul_of_nonneg_right hmul_le_one (inv_nonneg.mpr hden_nonneg)
    _ = (1 - rho ^ (2 : ℕ))⁻¹ := by simp [x]

private theorem finiteHorizonL2Norm_geometric_initial_le
    {rho e0 : ℝ} (hrho_nonneg : 0 ≤ rho) (hrho_lt_one : rho < 1)
    (he0_nonneg : 0 ≤ e0) (M : ℕ) :
    Setup.finiteHorizonL2Norm (fun m => rho ^ m * e0) 0 M ≤
      e0 / Real.sqrt (1 - rho ^ (2 : ℕ)) := by
  have hden_pos : 0 < 1 - rho ^ (2 : ℕ) := by
    nlinarith [sq_nonneg rho]
  have hden_nonneg : 0 ≤ 1 - rho ^ (2 : ℕ) := le_of_lt hden_pos
  have hIco_range : Finset.Ico 0 M = Finset.range M := by
    ext m
    simp [Finset.mem_Ico]
  have hsum_eq :
      (∑ m ∈ Finset.Ico 0 M, (rho ^ m * e0) ^ (2 : ℕ)) =
        e0 ^ (2 : ℕ) *
          ∑ m ∈ Finset.range M, (rho ^ (2 : ℕ)) ^ m := by
    rw [hIco_range, Finset.mul_sum]
    refine Finset.sum_congr rfl ?_
    intro m _hm
    calc
      (rho ^ m * e0) ^ (2 : ℕ)
          = (rho ^ m) ^ (2 : ℕ) * e0 ^ (2 : ℕ) := by ring
      _ = (rho ^ (2 : ℕ)) ^ m * e0 ^ (2 : ℕ) := by
          rw [← pow_mul, ← pow_mul, Nat.mul_comm]
      _ = e0 ^ (2 : ℕ) * (rho ^ (2 : ℕ)) ^ m := by ring
  have hgeom := geom_sq_sum_le_inv_one_sub_sq hrho_nonneg hrho_lt_one M
  have hscaled :
      e0 ^ (2 : ℕ) * (∑ m ∈ Finset.range M, (rho ^ (2 : ℕ)) ^ m) ≤
        e0 ^ (2 : ℕ) * (1 - rho ^ (2 : ℕ))⁻¹ :=
    mul_le_mul_of_nonneg_left hgeom (sq_nonneg e0)
  have hsqrt_le :
      Real.sqrt (∑ m ∈ Finset.Ico 0 M, (rho ^ m * e0) ^ (2 : ℕ)) ≤
        Real.sqrt (e0 ^ (2 : ℕ) * (1 - rho ^ (2 : ℕ))⁻¹) := by
    rw [hsum_eq]
    exact Real.sqrt_le_sqrt hscaled
  calc
    Setup.finiteHorizonL2Norm (fun m => rho ^ m * e0) 0 M
        = Real.sqrt (∑ m ∈ Finset.Ico 0 M, (rho ^ m * e0) ^ (2 : ℕ)) := by
          rfl
    _ ≤ Real.sqrt (e0 ^ (2 : ℕ) * (1 - rho ^ (2 : ℕ))⁻¹) := hsqrt_le
    _ = e0 / Real.sqrt (1 - rho ^ (2 : ℕ)) := by
          rw [Real.sqrt_mul (sq_nonneg e0), Real.sqrt_sq he0_nonneg,
            Real.sqrt_inv]
          ring

private theorem scalar_recursion_geometric_response_le
    {rho c : ℝ} (hrho_nonneg : 0 ≤ rho)
    (e b : ℕ → ℝ)
    (hrec : ∀ m : ℕ, e (m + 1) ≤ rho * e m + c * b m) :
    ∀ m : ℕ,
      e m ≤ rho ^ m * e 0 +
        c * ∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q := by
  intro m
  induction m with
  | zero =>
      simp
  | succ m ih =>
      have hmul :
          rho * e m ≤
            rho * (rho ^ m * e 0 +
              c * ∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q) :=
        mul_le_mul_of_nonneg_left ih hrho_nonneg
      have hstep :
          e (m + 1) ≤
            rho * (rho ^ m * e 0 +
              c * ∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q) +
              c * b m := by
        exact le_trans (hrec m) (by
          simpa [add_comm, add_left_comm, add_assoc] using
            add_le_add_right hmul (c * b m))
      have hsum_succ :
          (∑ q ∈ Finset.range (m + 1), rho ^ (m - q) * b q) =
            (∑ q ∈ Finset.range m, rho ^ (m - q) * b q) + b m := by
        rw [Finset.sum_range_succ]
        simp
      have hshift :
          rho * (∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q) =
            ∑ q ∈ Finset.range m, rho ^ (m - q) * b q := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl ?_
        intro q hq
        rw [Finset.mem_range] at hq
        by_cases hq_last : q = m
        · omega
        · have hq_lt : q < m := hq
          have hsucc : m - q = (m - 1 - q) + 1 := by omega
          rw [hsucc, pow_succ]
          ring
      calc
        e (m + 1)
            ≤ rho * (rho ^ m * e 0 +
                c * ∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q) +
                c * b m := hstep
        _ = rho ^ (m + 1) * e 0 +
              c * ∑ q ∈ Finset.range (m + 1), rho ^ (m - q) * b q := by
              rw [hsum_succ, ← hshift]
              rw [pow_succ]
              ring

private theorem sum_range_lag_if_sq_eq
    (a : ℕ → ℝ) (r M : ℕ) :
    (∑ m ∈ Finset.range M,
        (if r < m then a (m - 1 - r) else 0) ^ (2 : ℕ)) =
      ∑ t ∈ Finset.range (M - (r + 1)), a t ^ (2 : ℕ) := by
  induction M with
  | zero =>
      simp
  | succ M ih =>
      rw [Finset.sum_range_succ, ih]
      by_cases hlt : r < M
      · have hsucc : M + 1 - (r + 1) = (M - (r + 1)) + 1 := by omega
        rw [hsucc, Finset.sum_range_succ]
        have hidx : M - 1 - r = M - (r + 1) := by omega
        simp [hlt, hidx]
      · have hzero₁ : M - (r + 1) = 0 := by omega
        have hzero₂ : M + 1 - (r + 1) = 0 := by omega
        simp [hlt, hzero₁, hzero₂]

private theorem finiteHorizonL2Norm_lag_le
    (a : ℕ → ℝ) (r M : ℕ) :
    Setup.finiteHorizonL2Norm
        (fun m => if r < m then a (m - 1 - r) else 0) 0 M ≤
      Setup.finiteHorizonL2Norm a 0 M := by
  unfold Setup.finiteHorizonL2Norm
  have hIco_range : Finset.Ico 0 M = Finset.range M := by
    ext m
    simp [Finset.mem_Ico]
  rw [hIco_range]
  have hsum_eq := sum_range_lag_if_sq_eq a r M
  have hsubset : Finset.range (M - (r + 1)) ⊆ Finset.range M := by
    intro t ht
    rw [Finset.mem_range] at ht ⊢
    omega
  have hsum_le :
      (∑ t ∈ Finset.range (M - (r + 1)), a t ^ (2 : ℕ)) ≤
        ∑ t ∈ Finset.range M, a t ^ (2 : ℕ) :=
    Finset.sum_le_sum_of_subset_of_nonneg hsubset
      (fun t _htM _httail => sq_nonneg (a t))
  exact Real.sqrt_le_sqrt (by
    rw [hsum_eq]
    exact hsum_le)

private theorem finiteHorizonL2Norm_lag_kernel_le
    {rho : ℝ} (hrho_nonneg : 0 ≤ rho) (b : ℕ → ℝ) (r M : ℕ) :
    Setup.finiteHorizonL2Norm
        (fun m => if r < m then rho ^ r * b (m - 1 - r) else 0) 0 M ≤
      rho ^ r * Setup.finiteHorizonL2Norm b 0 M := by
  have hrpow_nonneg : 0 ≤ rho ^ r := pow_nonneg hrho_nonneg r
  have hrepr :
      Setup.finiteHorizonL2Norm
          (fun m => if r < m then rho ^ r * b (m - 1 - r) else 0) 0 M =
        Setup.finiteHorizonL2Norm
          (fun m => rho ^ r * (if r < m then b (m - 1 - r) else 0)) 0 M := by
    congr 1
    funext m
    by_cases h : r < m <;> simp [h]
  calc
    Setup.finiteHorizonL2Norm
        (fun m => if r < m then rho ^ r * b (m - 1 - r) else 0) 0 M
        =
      Setup.finiteHorizonL2Norm
        (fun m => rho ^ r * (if r < m then b (m - 1 - r) else 0)) 0 M := hrepr
    _ = rho ^ r *
          Setup.finiteHorizonL2Norm
            (fun m => if r < m then b (m - 1 - r) else 0) 0 M :=
          finiteHorizonL2Norm_const_mul_of_nonneg
            (fun m => if r < m then b (m - 1 - r) else 0) 0 M hrpow_nonneg
    _ ≤ rho ^ r * Setup.finiteHorizonL2Norm b 0 M :=
          mul_le_mul_of_nonneg_left (finiteHorizonL2Norm_lag_le b r M) hrpow_nonneg

private theorem geom_sum_le_inv_one_sub
    {rho : ℝ} (hrho_nonneg : 0 ≤ rho) (hrho_lt_one : rho < 1) (M : ℕ) :
    (∑ r ∈ Finset.range M, rho ^ r) ≤ (1 - rho)⁻¹ := by
  have hden_pos : 0 < 1 - rho := by nlinarith
  have hden_nonneg : 0 ≤ 1 - rho := le_of_lt hden_pos
  let S : ℝ := ∑ r ∈ Finset.range M, rho ^ r
  have hgeom : S * (1 - rho) = 1 - rho ^ M := by
    simpa [S] using geom_sum_mul_neg rho M
  have hpow_nonneg : 0 ≤ rho ^ M := pow_nonneg hrho_nonneg M
  have hmul_le_one : S * (1 - rho) ≤ 1 := by
    nlinarith
  calc
    (∑ r ∈ Finset.range M, rho ^ r)
        = S := by simp [S]
    _ = (S * (1 - rho)) * (1 - rho)⁻¹ := by
          field_simp [ne_of_gt hden_pos]
    _ ≤ 1 * (1 - rho)⁻¹ :=
          mul_le_mul_of_nonneg_right hmul_le_one (inv_nonneg.mpr hden_nonneg)
    _ = (1 - rho)⁻¹ := by ring

private theorem finite_geometric_convolution_l2_le
    {rho : ℝ} (hrho_nonneg : 0 ≤ rho) (hrho_lt_one : rho < 1)
    (b : ℕ → ℝ) (M : ℕ) :
    Setup.finiteHorizonL2Norm
        (fun m => ∑ r ∈ Finset.range M,
          if r < m then rho ^ r * b (m - 1 - r) else 0) 0 M ≤
      (1 - rho)⁻¹ * Setup.finiteHorizonL2Norm b 0 M := by
  have hnorm_nonneg : 0 ≤ Setup.finiteHorizonL2Norm b 0 M := by
    unfold Setup.finiteHorizonL2Norm
    exact Real.sqrt_nonneg _
  calc
    Setup.finiteHorizonL2Norm
        (fun m => ∑ r ∈ Finset.range M,
          if r < m then rho ^ r * b (m - 1 - r) else 0) 0 M
        ≤ ∑ r ∈ Finset.range M,
            Setup.finiteHorizonL2Norm
              (fun m => if r < m then rho ^ r * b (m - 1 - r) else 0) 0 M :=
          finiteHorizonL2Norm_finset_sum_le (Finset.range M)
            (fun r m => if r < m then rho ^ r * b (m - 1 - r) else 0) 0 M
    _ ≤ ∑ r ∈ Finset.range M, rho ^ r * Setup.finiteHorizonL2Norm b 0 M := by
          refine Finset.sum_le_sum ?_
          intro r _hr
          exact finiteHorizonL2Norm_lag_kernel_le hrho_nonneg b r M
    _ = (∑ r ∈ Finset.range M, rho ^ r) *
          Setup.finiteHorizonL2Norm b 0 M := by
          rw [Finset.sum_mul]
    _ ≤ (1 - rho)⁻¹ * Setup.finiteHorizonL2Norm b 0 M :=
          mul_le_mul_of_nonneg_right
            (geom_sum_le_inv_one_sub hrho_nonneg hrho_lt_one M) hnorm_nonneg

private theorem sum_range_extend_by_zero
    {α : Type*} [AddCommMonoid α] (f : ℕ → α) {m M : ℕ} (hm : m ≤ M) :
    (∑ r ∈ Finset.range M, if r < m then f r else 0) =
      ∑ r ∈ Finset.range m, f r := by
  rw [← Finset.sum_filter]
  have hfilter : (Finset.range M).filter (fun r => r < m) = Finset.range m := by
    ext r
    simp [Finset.mem_range]
    omega
  rw [hfilter]

private theorem geometric_convolution_reverse
    (rho : ℝ) (b : ℕ → ℝ) (m : ℕ) :
    (∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q) =
      ∑ r ∈ Finset.range m, rho ^ r * b (m - 1 - r) := by
  have h := Finset.sum_range_reflect
    (fun r => rho ^ r * b (m - 1 - r)) m
  calc
    (∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q)
        = ∑ q ∈ Finset.range m,
            (fun r => rho ^ r * b (m - 1 - r)) (m - 1 - q) := by
          refine Finset.sum_congr rfl ?_
          intro q hq
          rw [Finset.mem_range] at hq
          have hidx : m - 1 - (m - 1 - q) = q := by omega
          simp [hidx]
    _ = ∑ r ∈ Finset.range m, rho ^ r * b (m - 1 - r) := h

private theorem finite_geometric_convolution_l2_le_range
    {rho : ℝ} (hrho_nonneg : 0 ≤ rho) (hrho_lt_one : rho < 1)
    (b : ℕ → ℝ) (M : ℕ) :
    Setup.finiteHorizonL2Norm
        (fun m => ∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q) 0 M ≤
      (1 - rho)⁻¹ * Setup.finiteHorizonL2Norm b 0 M := by
  have hcongr :
      Setup.finiteHorizonL2Norm
          (fun m => ∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q) 0 M =
        Setup.finiteHorizonL2Norm
          (fun m => ∑ r ∈ Finset.range M,
            if r < m then rho ^ r * b (m - 1 - r) else 0) 0 M := by
    apply finiteHorizonL2Norm_congr_on
    intro m hm
    rw [Finset.mem_Ico] at hm
    have hmM : m ≤ M := le_of_lt hm.2
    calc
      (∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q)
          = ∑ r ∈ Finset.range m, rho ^ r * b (m - 1 - r) :=
            geometric_convolution_reverse rho b m
      _ = ∑ r ∈ Finset.range M,
            if r < m then rho ^ r * b (m - 1 - r) else 0 := by
            exact (sum_range_extend_by_zero
              (fun r => rho ^ r * b (m - 1 - r)) hmM).symm
  rw [hcongr]
  exact finite_geometric_convolution_l2_le hrho_nonneg hrho_lt_one b M

private theorem scalar_endpoint_recursion_l2_gain
    {rho c : ℝ} (hrho_nonneg : 0 ≤ rho) (hrho_lt_one : rho < 1)
    (hc_nonneg : 0 ≤ c) (e b : ℕ → ℝ)
    (he_nonneg : ∀ m, 0 ≤ e m)
    (he0_nonneg : 0 ≤ e 0)
    (hrec : ∀ m : ℕ, e (m + 1) ≤ rho * e m + c * b m)
    (M : ℕ) :
    Setup.finiteHorizonL2Norm e 0 M ≤
      e 0 / Real.sqrt (1 - rho ^ (2 : ℕ)) +
        c * (1 - rho)⁻¹ * Setup.finiteHorizonL2Norm b 0 M := by
  let conv : ℕ → ℝ :=
    fun m => ∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q
  have hresp :
      ∀ m : ℕ, e m ≤ rho ^ m * e 0 + c * conv m := by
    intro m
    simpa [conv] using
      scalar_recursion_geometric_response_le hrho_nonneg e b hrec m
  have hmono :
      Setup.finiteHorizonL2Norm e 0 M ≤
        Setup.finiteHorizonL2Norm
          (fun m => rho ^ m * e 0 + c * conv m) 0 M := by
    apply finiteHorizonL2Norm_mono_nonneg
    · intro m _hm
      exact he_nonneg m
    · intro m _hm
      exact hresp m
  have htri :
      Setup.finiteHorizonL2Norm
          (fun m => rho ^ m * e 0 + c * conv m) 0 M ≤
        Setup.finiteHorizonL2Norm (fun m => rho ^ m * e 0) 0 M +
          Setup.finiteHorizonL2Norm (fun m => c * conv m) 0 M :=
    finiteHorizonL2Norm_add_le (fun m => rho ^ m * e 0) (fun m => c * conv m) 0 M
  have hinit :
      Setup.finiteHorizonL2Norm (fun m => rho ^ m * e 0) 0 M ≤
        e 0 / Real.sqrt (1 - rho ^ (2 : ℕ)) :=
    finiteHorizonL2Norm_geometric_initial_le
      hrho_nonneg hrho_lt_one he0_nonneg M
  have hconv :
      Setup.finiteHorizonL2Norm conv 0 M ≤
        (1 - rho)⁻¹ * Setup.finiteHorizonL2Norm b 0 M := by
    simpa [conv] using finite_geometric_convolution_l2_le_range
      hrho_nonneg hrho_lt_one b M
  have hcconv :
      Setup.finiteHorizonL2Norm (fun m => c * conv m) 0 M ≤
        c * ((1 - rho)⁻¹ * Setup.finiteHorizonL2Norm b 0 M) := by
    rw [finiteHorizonL2Norm_const_mul_of_nonneg conv 0 M hc_nonneg]
    exact mul_le_mul_of_nonneg_left hconv hc_nonneg
  calc
    Setup.finiteHorizonL2Norm e 0 M
        ≤ Setup.finiteHorizonL2Norm
          (fun m => rho ^ m * e 0 + c * conv m) 0 M := hmono
    _ ≤ Setup.finiteHorizonL2Norm (fun m => rho ^ m * e 0) 0 M +
          Setup.finiteHorizonL2Norm (fun m => c * conv m) 0 M := htri
    _ ≤ e 0 / Real.sqrt (1 - rho ^ (2 : ℕ)) +
          c * ((1 - rho)⁻¹ * Setup.finiteHorizonL2Norm b 0 M) :=
          add_le_add hinit hcconv
    _ = e 0 / Real.sqrt (1 - rho ^ (2 : ℕ)) +
          c * (1 - rho)⁻¹ * Setup.finiteHorizonL2Norm b 0 M := by
          ring

private theorem scalar_recursion_geometric_response_le_on_range
    {rho c : ℝ} (hrho_nonneg : 0 ≤ rho)
    (e b : ℕ → ℝ) {M : ℕ}
    (hrec : ∀ m : ℕ, m + 1 < M →
      e (m + 1) ≤ rho * e m + c * b m) :
    ∀ m : ℕ, m < M →
      e m ≤ rho ^ m * e 0 +
        c * ∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q := by
  intro m hm
  induction m with
  | zero =>
      simp
  | succ m ih =>
      have hmM : m < M := lt_trans (Nat.lt_succ_self m) hm
      have hmul :
          rho * e m ≤
            rho * (rho ^ m * e 0 +
              c * ∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q) :=
        mul_le_mul_of_nonneg_left (ih hmM) hrho_nonneg
      have hstep :
          e (m + 1) ≤
            rho * (rho ^ m * e 0 +
              c * ∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q) +
              c * b m := by
        exact le_trans (hrec m hm) (by
          simpa [add_comm, add_left_comm, add_assoc] using
            add_le_add_right hmul (c * b m))
      have hsum_succ :
          (∑ q ∈ Finset.range (m + 1), rho ^ (m - q) * b q) =
            (∑ q ∈ Finset.range m, rho ^ (m - q) * b q) + b m := by
        rw [Finset.sum_range_succ]
        simp
      have hshift :
          rho * (∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q) =
            ∑ q ∈ Finset.range m, rho ^ (m - q) * b q := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl ?_
        intro q hq
        rw [Finset.mem_range] at hq
        by_cases hq_last : q = m
        · omega
        · have hq_lt : q < m := hq
          have hsucc : m - q = (m - 1 - q) + 1 := by omega
          rw [hsucc, pow_succ]
          ring
      calc
        e (m + 1)
            ≤ rho * (rho ^ m * e 0 +
                c * ∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q) +
                c * b m := hstep
        _ = rho ^ (m + 1) * e 0 +
              c * ∑ q ∈ Finset.range (m + 1), rho ^ (m - q) * b q := by
              rw [hsum_succ, ← hshift]
              rw [pow_succ]
              ring

private theorem scalar_endpoint_recursion_l2_gain_on_range
    {rho c : ℝ} (hrho_nonneg : 0 ≤ rho) (hrho_lt_one : rho < 1)
    (hc_nonneg : 0 ≤ c) (e b : ℕ → ℝ)
    (he_nonneg : ∀ m, 0 ≤ e m)
    (he0_nonneg : 0 ≤ e 0)
    (M : ℕ)
    (hrec : ∀ m : ℕ, m + 1 < M →
      e (m + 1) ≤ rho * e m + c * b m) :
    Setup.finiteHorizonL2Norm e 0 M ≤
      e 0 / Real.sqrt (1 - rho ^ (2 : ℕ)) +
        c * (1 - rho)⁻¹ * Setup.finiteHorizonL2Norm b 0 M := by
  let conv : ℕ → ℝ :=
    fun m => ∑ q ∈ Finset.range m, rho ^ (m - 1 - q) * b q
  have hresp :
      ∀ m : ℕ, m < M → e m ≤ rho ^ m * e 0 + c * conv m := by
    intro m hm
    simpa [conv] using
      scalar_recursion_geometric_response_le_on_range
        hrho_nonneg e b hrec m hm
  have hmono :
      Setup.finiteHorizonL2Norm e 0 M ≤
        Setup.finiteHorizonL2Norm
          (fun m => rho ^ m * e 0 + c * conv m) 0 M := by
    apply finiteHorizonL2Norm_mono_nonneg
    · intro m _hm
      exact he_nonneg m
    · intro m hm
      rw [Finset.mem_Ico] at hm
      exact hresp m hm.2
  have htri :
      Setup.finiteHorizonL2Norm
          (fun m => rho ^ m * e 0 + c * conv m) 0 M ≤
        Setup.finiteHorizonL2Norm (fun m => rho ^ m * e 0) 0 M +
          Setup.finiteHorizonL2Norm (fun m => c * conv m) 0 M :=
    finiteHorizonL2Norm_add_le (fun m => rho ^ m * e 0) (fun m => c * conv m) 0 M
  have hinit :
      Setup.finiteHorizonL2Norm (fun m => rho ^ m * e 0) 0 M ≤
        e 0 / Real.sqrt (1 - rho ^ (2 : ℕ)) :=
    finiteHorizonL2Norm_geometric_initial_le
      hrho_nonneg hrho_lt_one he0_nonneg M
  have hconv :
      Setup.finiteHorizonL2Norm conv 0 M ≤
        (1 - rho)⁻¹ * Setup.finiteHorizonL2Norm b 0 M := by
    simpa [conv] using finite_geometric_convolution_l2_le_range
      hrho_nonneg hrho_lt_one b M
  have hcconv :
      Setup.finiteHorizonL2Norm (fun m => c * conv m) 0 M ≤
        c * ((1 - rho)⁻¹ * Setup.finiteHorizonL2Norm b 0 M) := by
    rw [finiteHorizonL2Norm_const_mul_of_nonneg conv 0 M hc_nonneg]
    exact mul_le_mul_of_nonneg_left hconv hc_nonneg
  calc
    Setup.finiteHorizonL2Norm e 0 M
        ≤ Setup.finiteHorizonL2Norm
          (fun m => rho ^ m * e 0 + c * conv m) 0 M := hmono
    _ ≤ Setup.finiteHorizonL2Norm (fun m => rho ^ m * e 0) 0 M +
          Setup.finiteHorizonL2Norm (fun m => c * conv m) 0 M := htri
    _ ≤ e 0 / Real.sqrt (1 - rho ^ (2 : ℕ)) +
          c * ((1 - rho)⁻¹ * Setup.finiteHorizonL2Norm b 0 M) :=
          add_le_add hinit hcconv
    _ = e 0 / Real.sqrt (1 - rho ^ (2 : ℕ)) +
          c * (1 - rho)⁻¹ * Setup.finiteHorizonL2Norm b 0 M := by
          ring

private theorem nat_mul_add_div_right_eq
    {m q H : ℕ} (hq : q < H) (hH : 0 < H) :
    (m * H + q) / H = m := by
  calc
    (m * H + q) / H = (q + m * H) / H := by rw [Nat.add_comm]
    _ = q / H + m := by
      rw [Nat.add_mul_div_right q m hH]
    _ = m := by
      rw [Nat.div_eq_of_lt hq]
      simp

private theorem nat_mul_add_mod_right_eq
    {m q H : ℕ} (hq : q < H) :
    (m * H + q) % H = q := by
  calc
    (m * H + q) % H = (q + m * H) % H := by rw [Nat.add_comm]
    _ = q % H := by
      rw [Nat.add_mul_mod_self_right]
    _ = q := by
      rw [Nat.mod_eq_of_lt hq]

private theorem staleError_block_prefix_sum_le_sqrt_H_mul_truncated_l2
    (P : Setup) {k r T : ℕ} (hr : r ≤ P.H)
    (hprefix_lt : ∀ q, q ∈ Finset.range r → k + q < T) :
    (∑ q ∈ Finset.range r, staleError P (k + q)) ≤
      Real.sqrt (P.H : ℝ) *
        Real.sqrt (∑ q ∈ Finset.range P.H,
          (if k + q < T then staleError P (k + q) ^ (2 : ℕ) else 0)) := by
  have hcard : (Finset.range r).card ≤ P.H := by
    simpa using hr
  have hprefix_l2 :
      (∑ q ∈ Finset.range r, staleError P (k + q)) ≤
        Real.sqrt (P.H : ℝ) *
          Real.sqrt (∑ q ∈ Finset.range r, staleError P (k + q) ^ (2 : ℕ)) :=
    finset_sum_le_sqrt_card_bound_mul_sqrt_sum_sq
      (Finset.range r) (fun q => staleError P (k + q)) P.H hcard
      (fun q _hq => staleError_nonneg P (k + q))
  have hsubset : Finset.range r ⊆ Finset.range P.H := by
    intro q hq
    rw [Finset.mem_range] at hq ⊢
    omega
  have hsumsq_le :
      (∑ q ∈ Finset.range r, staleError P (k + q) ^ (2 : ℕ)) ≤
        ∑ q ∈ Finset.range P.H,
          (if k + q < T then staleError P (k + q) ^ (2 : ℕ) else 0) := by
    calc
      (∑ q ∈ Finset.range r, staleError P (k + q) ^ (2 : ℕ))
          =
        ∑ q ∈ Finset.range r,
          (if k + q < T then staleError P (k + q) ^ (2 : ℕ) else 0) := by
          refine Finset.sum_congr rfl ?_
          intro q hq
          simp [hprefix_lt q hq]
      _ ≤ ∑ q ∈ Finset.range P.H,
          (if k + q < T then staleError P (k + q) ^ (2 : ℕ) else 0) :=
          Finset.sum_le_sum_of_subset_of_nonneg hsubset
            (fun q _hqH hqr => by
              by_cases hqT : k + q < T
              · simpa [hqT] using sq_nonneg (staleError P (k + q))
              · simp [hqT])
  have hsqrt_le :
      Real.sqrt (∑ q ∈ Finset.range r, staleError P (k + q) ^ (2 : ℕ)) ≤
        Real.sqrt (∑ q ∈ Finset.range P.H,
          (if k + q < T then staleError P (k + q) ^ (2 : ℕ) else 0)) :=
    Real.sqrt_le_sqrt hsumsq_le
  have hsqrtH_nonneg : 0 ≤ Real.sqrt (P.H : ℝ) := Real.sqrt_nonneg _
  calc
    (∑ q ∈ Finset.range r, staleError P (k + q))
        ≤ Real.sqrt (P.H : ℝ) *
          Real.sqrt (∑ q ∈ Finset.range r, staleError P (k + q) ^ (2 : ℕ)) :=
          hprefix_l2
    _ ≤ Real.sqrt (P.H : ℝ) *
        Real.sqrt (∑ q ∈ Finset.range P.H,
          (if k + q < T then staleError P (k + q) ^ (2 : ℕ) else 0)) :=
          mul_le_mul_of_nonneg_left hsqrt_le hsqrtH_nonneg

private theorem moving_window_count_le_length (p D T t : ℕ) :
    ((Finset.Ico p T).filter (fun k => t ∈ Finset.Ico (k - D) k)).card ≤ D := by
  classical
  have hsubset :
      (Finset.Ico p T).filter (fun k => t ∈ Finset.Ico (k - D) k) ⊆
        Finset.Ioc t (t + D) := by
    intro k hk
    simp at hk ⊢
    omega
  exact (Finset.card_le_card hsubset).trans (by simp [Nat.card_Ioc])

private theorem moving_window_indicator_l2_le_sqrt_length_mul
    (a : ℕ → ℝ) (ha : ∀ t, 0 ≤ a t) (p D T t : ℕ) :
    Setup.finiteHorizonL2Norm
        (fun k => if t ∈ Finset.Ico (k - D) k then a t else 0) p T ≤
      Real.sqrt (D : ℝ) * a t := by
  unfold Setup.finiteHorizonL2Norm
  let K := Finset.Ico p T
  have hsum_if :
      (∑ k ∈ K, (if t ∈ Finset.Ico (k - D) k then a t else 0) ^ (2 : ℕ)) =
        ∑ k ∈ K, if t ∈ Finset.Ico (k - D) k then a t ^ (2 : ℕ) else 0 := by
    refine Finset.sum_congr rfl ?_
    intro k _hk
    by_cases hmem : t ∈ Finset.Ico (k - D) k <;> simp [hmem]
  have hsum_eq :
      (∑ k ∈ K, if t ∈ Finset.Ico (k - D) k then a t ^ (2 : ℕ) else 0) =
        (((K.filter (fun k => t ∈ Finset.Ico (k - D) k)).card : ℝ) *
          a t ^ (2 : ℕ)) := by
    rw [← Finset.sum_filter]
    simp
  have hcount_nat :
      (K.filter (fun k => t ∈ Finset.Ico (k - D) k)).card ≤ D := by
    simpa [K] using moving_window_count_le_length p D T t
  have hcount_real :
      (((K.filter (fun k => t ∈ Finset.Ico (k - D) k)).card : ℝ) : ℝ) ≤ (D : ℝ) := by
    exact_mod_cast hcount_nat
  have hsquare :
      (∑ k ∈ K, (if t ∈ Finset.Ico (k - D) k then a t else 0) ^ (2 : ℕ)) ≤
        (D : ℝ) * a t ^ (2 : ℕ) := by
    rw [hsum_if, hsum_eq]
    exact mul_le_mul_of_nonneg_right hcount_real (sq_nonneg (a t))
  have hroot := Real.sqrt_le_sqrt hsquare
  have hD_nonneg : 0 ≤ (D : ℝ) := Nat.cast_nonneg D
  calc
    Real.sqrt
        (∑ k ∈ K, (if t ∈ Finset.Ico (k - D) k then a t else 0) ^ (2 : ℕ))
        ≤ Real.sqrt ((D : ℝ) * a t ^ (2 : ℕ)) := hroot
    _ = Real.sqrt (D : ℝ) * a t := by
          rw [Real.sqrt_mul hD_nonneg]
          rw [Real.sqrt_sq (ha t)]

private theorem moving_window_prefix_l2_le_sqrt_length_mul_sum
    (a : ℕ → ℝ) (ha : ∀ t, 0 ≤ a t) (p D T : ℕ) :
    Setup.finiteHorizonL2Norm
        (fun k => ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => t < p), a t) p T ≤
      Real.sqrt (D : ℝ) * ∑ t ∈ Finset.range p, a t := by
  classical
  have hrepr :
      Setup.finiteHorizonL2Norm
          (fun k => ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => t < p), a t) p T =
        Setup.finiteHorizonL2Norm
          (fun k => ∑ t ∈ Finset.range p,
            if t ∈ Finset.Ico (k - D) k then a t else 0) p T := by
    congr 1
    funext k
    rw [← Finset.sum_filter]
    refine Finset.sum_congr ?_ (fun _ _ => rfl)
    ext t
    simp [and_comm, and_left_comm, and_assoc]
  calc
    Setup.finiteHorizonL2Norm
        (fun k => ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => t < p), a t) p T
        =
      Setup.finiteHorizonL2Norm
        (fun k => ∑ t ∈ Finset.range p,
          if t ∈ Finset.Ico (k - D) k then a t else 0) p T := hrepr
    _ ≤ ∑ t ∈ Finset.range p,
          Setup.finiteHorizonL2Norm
            (fun k => if t ∈ Finset.Ico (k - D) k then a t else 0) p T :=
          finiteHorizonL2Norm_finset_sum_le (Finset.range p)
            (fun t k => if t ∈ Finset.Ico (k - D) k then a t else 0) p T
    _ ≤ ∑ t ∈ Finset.range p, Real.sqrt (D : ℝ) * a t := by
          refine Finset.sum_le_sum ?_
          intro t _ht
          exact moving_window_indicator_l2_le_sqrt_length_mul a ha p D T t
    _ = Real.sqrt (D : ℝ) * ∑ t ∈ Finset.range p, a t := by
          rw [Finset.mul_sum]

private theorem finset_sum_sq_le_card_bound_mul_sum_sq
    (a : ℕ → ℝ) (s : Finset ℕ) (D : ℕ) (hcard : s.card ≤ D) :
    (∑ t ∈ s, a t) ^ (2 : ℕ) ≤ (D : ℝ) * ∑ t ∈ s, a t ^ (2 : ℕ) := by
  have hcauchy :
      (∑ t ∈ s, (1 : ℝ) * a t) ^ (2 : ℕ) ≤
        (∑ t ∈ s, (1 : ℝ) ^ (2 : ℕ)) * ∑ t ∈ s, a t ^ (2 : ℕ) :=
    Finset.sum_mul_sq_le_sq_mul_sq s (fun _ : ℕ => (1 : ℝ)) a
  have hcard_real : (s.card : ℝ) ≤ (D : ℝ) := by
    exact_mod_cast hcard
  have hsum_nonneg : 0 ≤ ∑ t ∈ s, a t ^ (2 : ℕ) := by
    exact Finset.sum_nonneg (fun t _ht => sq_nonneg (a t))
  calc
    (∑ t ∈ s, a t) ^ (2 : ℕ)
        ≤ (s.card : ℝ) * ∑ t ∈ s, a t ^ (2 : ℕ) := by
          simpa using hcauchy
    _ ≤ (D : ℝ) * ∑ t ∈ s, a t ^ (2 : ℕ) :=
          mul_le_mul_of_nonneg_right hcard_real hsum_nonneg

private theorem moving_window_post_prefix_square_sum_le_length_mul
    (a : ℕ → ℝ) (p D T : ℕ) :
    (∑ k ∈ Finset.Ico p T,
        ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t ^ (2 : ℕ)) ≤
      (D : ℝ) * ∑ t ∈ Finset.Ico p T, a t ^ (2 : ℕ) := by
  classical
  let K := Finset.Ico p T
  let U := Finset.Ico p T
  have hlocal :
      (∑ k ∈ K,
          ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t ^ (2 : ℕ)) =
        ∑ k ∈ K, ∑ t ∈ U, if t ∈ Finset.Ico (k - D) k then a t ^ (2 : ℕ) else 0 := by
    refine Finset.sum_congr rfl ?_
    intro k hk
    rw [← Finset.sum_filter]
    refine Finset.sum_congr ?_ (fun _ _ => rfl)
    ext t
    simp [K, U] at hk ⊢
    constructor <;> intro ht <;> omega
  have hswap :
      (∑ k ∈ K, ∑ t ∈ U, if t ∈ Finset.Ico (k - D) k then a t ^ (2 : ℕ) else 0) =
        ∑ t ∈ U, ∑ k ∈ K, if t ∈ Finset.Ico (k - D) k then a t ^ (2 : ℕ) else 0 := by
    exact Finset.sum_comm
  have hfiber :
      (∑ t ∈ U, ∑ k ∈ K, if t ∈ Finset.Ico (k - D) k then a t ^ (2 : ℕ) else 0) =
        ∑ t ∈ U,
          (((K.filter (fun k => t ∈ Finset.Ico (k - D) k)).card : ℝ) *
            a t ^ (2 : ℕ)) := by
    refine Finset.sum_congr rfl ?_
    intro t ht
    rw [← Finset.sum_filter]
    simp
  rw [hlocal, hswap, hfiber]
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum ?_
  intro t ht
  have hcard_nat :
      (K.filter (fun k => t ∈ Finset.Ico (k - D) k)).card ≤ D := by
    simpa [K] using moving_window_count_le_length p D T t
  have hcard_real :
      (((K.filter (fun k => t ∈ Finset.Ico (k - D) k)).card : ℝ) : ℝ) ≤ (D : ℝ) := by
    exact_mod_cast hcard_nat
  exact mul_le_mul_of_nonneg_right hcard_real (sq_nonneg (a t))

private theorem moving_window_card_le_length (p D k : ℕ) :
    ((Finset.Ico (k - D) k).filter (fun t => p ≤ t)).card ≤ D := by
  have hsubset :
      (Finset.Ico (k - D) k).filter (fun t => p ≤ t) ⊆ Finset.Ico (k - D) k :=
    Finset.filter_subset _ _
  exact (Finset.card_le_card hsubset).trans (by simp [Nat.card_Ico]; omega)

private theorem moving_window_post_prefix_window_square_sum_le_length_sq_mul
    (a : ℕ → ℝ) (p D T : ℕ) :
    (∑ k ∈ Finset.Ico p T,
        (∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t) ^ (2 : ℕ)) ≤
      (D : ℝ) ^ (2 : ℕ) * ∑ t ∈ Finset.Ico p T, a t ^ (2 : ℕ) := by
  have hpoint :
      (∑ k ∈ Finset.Ico p T,
          (∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t) ^ (2 : ℕ)) ≤
        ∑ k ∈ Finset.Ico p T,
          (D : ℝ) *
            ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t ^ (2 : ℕ) := by
    refine Finset.sum_le_sum ?_
    intro k _hk
    exact finset_sum_sq_le_card_bound_mul_sum_sq a
      ((Finset.Ico (k - D) k).filter (fun t => p ≤ t)) D
      (moving_window_card_le_length p D k)
  have hdouble := moving_window_post_prefix_square_sum_le_length_mul a p D T
  have hD_nonneg : 0 ≤ (D : ℝ) := Nat.cast_nonneg D
  calc
    (∑ k ∈ Finset.Ico p T,
        (∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t) ^ (2 : ℕ))
        ≤ ∑ k ∈ Finset.Ico p T,
          (D : ℝ) *
            ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t ^ (2 : ℕ) :=
          hpoint
    _ = (D : ℝ) *
          (∑ k ∈ Finset.Ico p T,
            ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t ^ (2 : ℕ)) := by
          rw [Finset.mul_sum]
    _ ≤ (D : ℝ) * ((D : ℝ) * ∑ t ∈ Finset.Ico p T, a t ^ (2 : ℕ)) :=
          mul_le_mul_of_nonneg_left hdouble hD_nonneg
    _ = (D : ℝ) ^ (2 : ℕ) * ∑ t ∈ Finset.Ico p T, a t ^ (2 : ℕ) := by
          ring

private theorem moving_window_post_prefix_l2_le_length_mul
    (a : ℕ → ℝ) (p D T : ℕ) :
    Setup.finiteHorizonL2Norm
        (fun k => ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t) p T ≤
      (D : ℝ) * Setup.finiteHorizonL2Norm a p T := by
  unfold Setup.finiteHorizonL2Norm
  have hsquare := moving_window_post_prefix_window_square_sum_le_length_sq_mul a p D T
  have hroot := Real.sqrt_le_sqrt hsquare
  have hD_nonneg : 0 ≤ (D : ℝ) := Nat.cast_nonneg D
  have hsum_nonneg : 0 ≤ ∑ t ∈ Finset.Ico p T, a t ^ (2 : ℕ) := by
    exact Finset.sum_nonneg (fun t _ht => sq_nonneg (a t))
  calc
    Real.sqrt
        (∑ k ∈ Finset.Ico p T,
          (∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t) ^ (2 : ℕ))
        ≤ Real.sqrt ((D : ℝ) ^ (2 : ℕ) * ∑ t ∈ Finset.Ico p T, a t ^ (2 : ℕ)) :=
          hroot
    _ = (D : ℝ) * Real.sqrt (∑ t ∈ Finset.Ico p T, a t ^ (2 : ℕ)) := by
          rw [Real.sqrt_mul (sq_nonneg (D : ℝ))]
          rw [Real.sqrt_sq hD_nonneg]

private theorem moving_window_post_prefix_scaled_l2_le_length_mul
    (a : ℕ → ℝ) (p D T : ℕ) {c : ℝ} (hc : 0 ≤ c) :
    Setup.finiteHorizonL2Norm
        (fun k => c * ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t)
        p T ≤
      c * (D : ℝ) * Setup.finiteHorizonL2Norm a p T := by
  calc
    Setup.finiteHorizonL2Norm
        (fun k => c * ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t)
        p T
        = c *
          Setup.finiteHorizonL2Norm
            (fun k => ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t)
            p T := by
          rw [finiteHorizonL2Norm_const_mul_of_nonneg
            (fun k => ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t)
            p T hc]
    _ ≤ c * ((D : ℝ) * Setup.finiteHorizonL2Norm a p T) :=
          mul_le_mul_of_nonneg_left
            (moving_window_post_prefix_l2_le_length_mul a p D T) hc
    _ = c * (D : ℝ) * Setup.finiteHorizonL2Norm a p T := by
          ring

private theorem moving_window_l2_le_prefix_add_tail
    (a : ℕ → ℝ) (ha : ∀ t, 0 ≤ a t) (p D T : ℕ) {c : ℝ} (hc : 0 ≤ c) :
    Setup.finiteHorizonL2Norm
        (fun k => c * ∑ t ∈ Finset.Ico (k - D) k, a t) p T ≤
      c * Real.sqrt (D : ℝ) * ∑ t ∈ Finset.range p, a t +
        c * (D : ℝ) * Setup.finiteHorizonL2Norm a p T := by
  classical
  let pref := fun k => ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => t < p), a t
  let tail := fun k => ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t
  have hsplit :
      Setup.finiteHorizonL2Norm
          (fun k => c * ∑ t ∈ Finset.Ico (k - D) k, a t) p T =
        Setup.finiteHorizonL2Norm (fun k => c * pref k + c * tail k) p T := by
    congr 1
    funext k
    have hsum_split :
        (∑ t ∈ Finset.Ico (k - D) k, a t) = pref k + tail k := by
      unfold pref tail
      have hnot :
          (Finset.Ico (k - D) k).filter (fun t => ¬ t < p) =
            (Finset.Ico (k - D) k).filter (fun t => p ≤ t) := by
        ext t
        simp [not_lt]
      calc
        (∑ t ∈ Finset.Ico (k - D) k, a t)
            = (∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => t < p), a t) +
                ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => ¬ t < p), a t := by
              exact (Finset.sum_filter_add_sum_filter_not
                (s := Finset.Ico (k - D) k) (p := fun t => t < p) (f := a)).symm
        _ = (∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => t < p), a t) +
              ∑ t ∈ (Finset.Ico (k - D) k).filter (fun t => p ≤ t), a t := by
              rw [hnot]
    rw [hsum_split]
    ring
  have htri :
      Setup.finiteHorizonL2Norm (fun k => c * pref k + c * tail k) p T ≤
        Setup.finiteHorizonL2Norm (fun k => c * pref k) p T +
          Setup.finiteHorizonL2Norm (fun k => c * tail k) p T :=
    finiteHorizonL2Norm_add_le (fun k => c * pref k) (fun k => c * tail k) p T
  have hprefix :
      Setup.finiteHorizonL2Norm (fun k => c * pref k) p T ≤
        c * Real.sqrt (D : ℝ) * ∑ t ∈ Finset.range p, a t := by
    calc
      Setup.finiteHorizonL2Norm (fun k => c * pref k) p T
          = c * Setup.finiteHorizonL2Norm pref p T := by
            rw [finiteHorizonL2Norm_const_mul_of_nonneg pref p T hc]
      _ ≤ c * (Real.sqrt (D : ℝ) * ∑ t ∈ Finset.range p, a t) :=
            mul_le_mul_of_nonneg_left
              (by
                unfold pref
                exact moving_window_prefix_l2_le_sqrt_length_mul_sum a ha p D T)
              hc
      _ = c * Real.sqrt (D : ℝ) * ∑ t ∈ Finset.range p, a t := by
            ring
  have htail :
      Setup.finiteHorizonL2Norm (fun k => c * tail k) p T ≤
        c * (D : ℝ) * Setup.finiteHorizonL2Norm a p T := by
    unfold tail
    exact moving_window_post_prefix_scaled_l2_le_length_mul a p D T hc
  calc
    Setup.finiteHorizonL2Norm
        (fun k => c * ∑ t ∈ Finset.Ico (k - D) k, a t) p T
        = Setup.finiteHorizonL2Norm (fun k => c * pref k + c * tail k) p T :=
          hsplit
    _ ≤ Setup.finiteHorizonL2Norm (fun k => c * pref k) p T +
          Setup.finiteHorizonL2Norm (fun k => c * tail k) p T :=
          htri
    _ ≤ c * Real.sqrt (D : ℝ) * ∑ t ∈ Finset.range p, a t +
          c * (D : ℝ) * Setup.finiteHorizonL2Norm a p T :=
          add_le_add hprefix htail

private theorem finite_horizon_window_displacement_le_H0_add_tail
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) {T : ℕ} :
    Setup.finiteHorizonL2Norm
        (fun k => P.L * ∑ t ∈ Finset.Ico (k - P.D) k, roundDisplacement P t)
        P.K0 T ≤
      P.H_0 + P.L * (P.D : ℝ) *
        Setup.finiteHorizonL2Norm (roundDisplacement P) P.K0 T := by
  have hL_nonneg : 0 ≤ P.L := le_of_lt (L_pos_of_theoremStepsizeCondition P hstepsize)
  have h :=
    moving_window_l2_le_prefix_add_tail
      (roundDisplacement P) (roundDisplacement_nonneg P) P.K0 P.D T hL_nonneg
  simpa [Setup.H_0, Setup.A_pre, mul_assoc] using h

private theorem finite_horizon_staleError_le_window_norm
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) {T : ℕ}
    (hT : P.K0 ≤ T) :
    Setup.finiteHorizonL2Norm (staleError P) P.K0 T ≤
      Setup.finiteHorizonL2Norm
        (fun k => P.L * ∑ t ∈ Finset.Ico (k - P.D) k, roundDisplacement P t)
        P.K0 T := by
  apply finiteHorizonL2Norm_mono_nonneg
  · intro k _hk
    exact staleError_nonneg P k
  · intro k hk
    exact staleError_le_moving_displacement_sum P hstepsize k
      (by
        rw [Finset.mem_Ico] at hk
        exact hk.1)

private theorem finite_horizon_staleError_le_movement_norm
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) {T : ℕ}
    (hT : P.K0 ≤ T) :
    Setup.finiteHorizonL2Norm (staleError P) P.K0 T ≤
      P.H_0 + P.L * (P.D : ℝ) *
        Setup.finiteHorizonL2Norm (roundDisplacement P) P.K0 T := by
  exact le_trans
    (finite_horizon_staleError_le_window_norm P hstepsize hT)
    (finite_horizon_window_displacement_le_H0_add_tail P hstepsize)

private theorem finite_horizon_staleError_le_raw_feedback
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) {T : ℕ}
    (hT : P.K0 ≤ T) :
    Setup.finiteHorizonL2Norm (staleError P) P.K0 T ≤
      P.H_0 + P.L * (P.D : ℝ) *
        ((1 + P.gamma * P.L) * Setup.finiteHorizonL2Norm (Delta P) P.K0 T +
          P.gamma *
            Setup.finiteHorizonL2Norm
              (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 T +
          (2 * P.gamma) * Setup.finiteHorizonL2Norm (staleError P) P.K0 T) := by
  have hL_nonneg : 0 ≤ P.L := le_of_lt (L_pos_of_theoremStepsizeCondition P hstepsize)
  have hLD_nonneg : 0 ≤ P.L * (P.D : ℝ) := mul_nonneg hL_nonneg (Nat.cast_nonneg P.D)
  calc
    Setup.finiteHorizonL2Norm (staleError P) P.K0 T
        ≤ P.H_0 + P.L * (P.D : ℝ) *
            Setup.finiteHorizonL2Norm (roundDisplacement P) P.K0 T :=
          finite_horizon_staleError_le_movement_norm P hstepsize hT
    _ ≤ P.H_0 + P.L * (P.D : ℝ) *
        ((1 + P.gamma * P.L) * Setup.finiteHorizonL2Norm (Delta P) P.K0 T +
          P.gamma *
            Setup.finiteHorizonL2Norm
              (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 T +
          (2 * P.gamma) * Setup.finiteHorizonL2Norm (staleError P) P.K0 T) := by
          simpa [add_assoc, add_comm, add_left_comm] using
            add_le_add_left
              (mul_le_mul_of_nonneg_left
                (finite_horizon_movement_norm_bound P hstepsize (T := T))
                hLD_nonneg) P.H_0

private theorem sum_truncated_blocks_sq_eq
    (u : ℕ → ℝ) {K T H : ℕ} (hKT : K ≤ T) (hH : 0 < H) :
    (∑ m ∈ Finset.Ico 0 ((T - K) / H + 1), ∑ q ∈ Finset.range H,
      (if K + m * H + q < T then u (K + m * H + q) ^ (2 : ℕ) else 0)) =
      ∑ k ∈ Finset.Ico K T, u k ^ (2 : ℕ) := by
  classical
  let B : Finset (Sigma fun _m : ℕ => ℕ) :=
    (Finset.Ico 0 ((T - K) / H + 1)).sigma (fun _ => Finset.range H)
  have hsum_sigma :
      (∑ m ∈ Finset.Ico 0 ((T - K) / H + 1), ∑ q ∈ Finset.range H,
        (if K + m * H + q < T then u (K + m * H + q) ^ (2 : ℕ) else 0)) =
        ∑ p ∈ B,
          (if K + p.1 * H + p.2 < T then
            u (K + p.1 * H + p.2) ^ (2 : ℕ)
          else 0) := by
    simp [B, Finset.sum_sigma']
  rw [hsum_sigma]
  rw [← Finset.sum_filter]
  refine Finset.sum_bij
    (fun p _hp => K + p.1 * H + p.2)
    ?mem ?inj ?surj ?sum_eq
  · intro p hp
    have hpT : K + p.1 * H + p.2 < T := (Finset.mem_filter.mp hp).2
    rw [Finset.mem_Ico]
    constructor
    · exact (Nat.le_add_right K (p.1 * H)).trans (Nat.le_add_right (K + p.1 * H) p.2)
    · exact hpT
  · intro p₁ hp₁ p₂ hp₂ hidx
    rcases p₁ with ⟨m₁, q₁⟩
    rcases p₂ with ⟨m₂, q₂⟩
    have hp₁B : Sigma.mk m₁ q₁ ∈ B := (Finset.mem_filter.mp hp₁).1
    have hp₂B : Sigma.mk m₂ q₂ ∈ B := (Finset.mem_filter.mp hp₂).1
    have hq₁ : q₁ < H := by
      have h := (Finset.mem_sigma.mp hp₁B).2
      simpa using h
    have hq₂ : q₂ < H := by
      have h := (Finset.mem_sigma.mp hp₂B).2
      simpa using h
    have hsub₁ : K + m₁ * H + q₁ - K = m₁ * H + q₁ := by omega
    have hsub₂ : K + m₂ * H + q₂ - K = m₂ * H + q₂ := by omega
    have hidx_nat : K + m₁ * H + q₁ = K + m₂ * H + q₂ := by
      simpa using hidx
    have hm : m₁ = m₂ := by
      calc
        m₁ = (K + m₁ * H + q₁ - K) / H := by
          rw [hsub₁]
          exact (nat_mul_add_div_right_eq hq₁ hH).symm
        _ = (K + m₂ * H + q₂ - K) / H := by rw [hidx_nat]
        _ = m₂ := by
          rw [hsub₂]
          exact nat_mul_add_div_right_eq hq₂ hH
    have hq : q₁ = q₂ := by
      calc
        q₁ = (K + m₁ * H + q₁ - K) % H := by
          rw [hsub₁]
          exact (nat_mul_add_mod_right_eq hq₁).symm
        _ = (K + m₂ * H + q₂ - K) % H := by rw [hidx_nat]
        _ = q₂ := by
          rw [hsub₂]
          exact nat_mul_add_mod_right_eq hq₂
    cases hm
    cases hq
    rfl
  · intro k hk
    let m : ℕ := (k - K) / H
    let q : ℕ := (k - K) % H
    have hkIco := Finset.mem_Ico.mp hk
    have hidx : K + m * H + q = k := by
      have hdiv := Nat.div_add_mod (k - K) H
      unfold m q
      rw [Nat.mul_comm H ((k - K) / H)] at hdiv
      omega
    have hm_lt : m < (T - K) / H + 1 := by
      have hsub_le : k - K ≤ T - K := by omega
      have hdiv_le : (k - K) / H ≤ (T - K) / H :=
        Nat.div_le_div_right hsub_le
      unfold m
      omega
    have hq_lt : q < H := by
      unfold q
      exact Nat.mod_lt (k - K) hH
    refine ⟨Sigma.mk m q, ?_, ?_⟩
    · rw [Finset.mem_filter, Finset.mem_sigma]
      constructor
      · constructor
        · rw [Finset.mem_Ico]
          exact ⟨Nat.zero_le m, hm_lt⟩
        · rw [Finset.mem_range]
          exact hq_lt
      · rw [hidx]
        exact hkIco.2
    · exact hidx
  · intro p hp
    have hpT : K + p.1 * H + p.2 < T := (Finset.mem_filter.mp hp).2
    simp [hpT]

private theorem finiteHorizonL2Norm_truncated_blocks_eq
    (u : ℕ → ℝ) {K T H : ℕ} (hKT : K ≤ T) (hH : 0 < H) :
    Setup.finiteHorizonL2Norm
        (fun m => Real.sqrt (∑ q ∈ Finset.range H,
          (if K + m * H + q < T then
            u (K + m * H + q) ^ (2 : ℕ)
          else 0)))
        0 ((T - K) / H + 1) =
      Setup.finiteHorizonL2Norm u K T := by
  unfold Setup.finiteHorizonL2Norm
  congr 1
  calc
    (∑ m ∈ Finset.Ico 0 ((T - K) / H + 1),
        (Real.sqrt (∑ q ∈ Finset.range H,
          (if K + m * H + q < T then
            u (K + m * H + q) ^ (2 : ℕ)
          else 0))) ^ (2 : ℕ))
        =
      ∑ m ∈ Finset.Ico 0 ((T - K) / H + 1), ∑ q ∈ Finset.range H,
        (if K + m * H + q < T then u (K + m * H + q) ^ (2 : ℕ) else 0) := by
        refine Finset.sum_congr rfl ?_
        intro m _hm
        rw [Real.sq_sqrt]
        exact Finset.sum_nonneg (fun q _hq => by
          by_cases hqT : K + m * H + q < T
          · simpa [hqT] using sq_nonneg (u (K + m * H + q))
          · simp [hqT])
    _ = ∑ k ∈ Finset.Ico K T, u k ^ (2 : ℕ) :=
        sum_truncated_blocks_sq_eq u hKT hH

private theorem finiteHorizonL2Norm_quotient_le_sqrt_H_mul
    (u : ℕ → ℝ) {K T H : ℕ} (hKT : K ≤ T) (hH : 0 < H) :
    Setup.finiteHorizonL2Norm (fun k => u ((k - K) / H)) K T ≤
      Real.sqrt (H : ℝ) *
        Setup.finiteHorizonL2Norm u 0 ((T - K) / H + 1) := by
  unfold Setup.finiteHorizonL2Norm
  have hsum_eq :
      (∑ k ∈ Finset.Ico K T, (u ((k - K) / H)) ^ (2 : ℕ)) =
        ∑ m ∈ Finset.Ico 0 ((T - K) / H + 1), ∑ q ∈ Finset.range H,
          (if K + m * H + q < T then
            (u (((K + m * H + q) - K) / H)) ^ (2 : ℕ)
          else 0) := by
    symm
    exact sum_truncated_blocks_sq_eq (fun k => u ((k - K) / H)) hKT hH
  have hsum_le :
      (∑ k ∈ Finset.Ico K T, (u ((k - K) / H)) ^ (2 : ℕ)) ≤
        (H : ℝ) * ∑ m ∈ Finset.Ico 0 ((T - K) / H + 1), u m ^ (2 : ℕ) := by
    rw [hsum_eq]
    calc
      (∑ m ∈ Finset.Ico 0 ((T - K) / H + 1), ∑ q ∈ Finset.range H,
          (if K + m * H + q < T then
            (u (((K + m * H + q) - K) / H)) ^ (2 : ℕ)
          else 0))
          ≤ ∑ m ∈ Finset.Ico 0 ((T - K) / H + 1), ∑ q ∈ Finset.range H,
              u m ^ (2 : ℕ) := by
            refine Finset.sum_le_sum ?_
            intro m hm
            refine Finset.sum_le_sum ?_
            intro q hq
            rw [Finset.mem_range] at hq
            by_cases hqT : K + m * H + q < T
            · have hsub : K + m * H + q - K = m * H + q := by omega
              have hdiv : ((K + m * H + q) - K) / H = m := by
                rw [hsub]
                exact nat_mul_add_div_right_eq hq hH
              simp [hqT, hdiv]
            · simp [hqT, sq_nonneg (u m)]
      _ = (H : ℝ) * ∑ m ∈ Finset.Ico 0 ((T - K) / H + 1), u m ^ (2 : ℕ) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl ?_
            intro m _hm
            simp [Finset.sum_const, nsmul_eq_mul, mul_comm]
  have hsqrt_le := Real.sqrt_le_sqrt hsum_le
  simpa [Real.sqrt_mul (Nat.cast_nonneg H)] using hsqrt_le

private theorem finite_horizon_disagreement_gain
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) {T : ℕ}
    (hT : P.K0 ≤ T) :
    Setup.finiteHorizonL2Norm (Delta P) P.K0 T ≤
      P.A_0 + P.C_N * P.gamma *
        Setup.finiteHorizonL2Norm (staleError P) P.K0 T := by
  classical
  have hrho_range : 0 ≤ P.rho ∧ P.rho < 1 := P.rho_range
  have hH_pos : 0 < P.H := P.H_pos
  have hA_den_pos : 0 < 1 - P.rho ^ (2 : ℕ) := P.A_0_denominator_pos
  have hC_den_pos : 0 < (P.n : ℝ) * P.beta := P.C_N_denominator_pos
  have hDelta_nonneg : ∀ k, 0 ≤ Delta P k := Delta_nonneg P
  have hStale_nonneg : ∀ k, 0 ≤ staleError P k := staleError_nonneg P
  have hgamma_nonneg : 0 ≤ P.gamma := le_of_lt hstepsize.1
  have hendpoint :
      ∀ m : ℕ,
        Delta P (P.K0 + (m + 1) * P.H) ≤
          P.rho * Delta P (P.K0 + m * P.H) +
            2 * P.gamma * Real.sqrt (P.H : ℝ) *
              Real.sqrt (∑ q ∈ Finset.range P.H,
                staleError P (P.K0 + m * P.H + q) ^ (2 : ℕ)) := by
    intro m
    exact block_endpoint_recurrence_le P hstepsize m
  have hwithin :
      ∀ m r : ℕ, r ≤ P.H →
        Delta P (P.K0 + m * P.H + r) ≤
          Delta P (P.K0 + m * P.H) +
            2 * P.gamma * Real.sqrt (P.H : ℝ) *
              Real.sqrt (∑ q ∈ Finset.range P.H,
                staleError P (P.K0 + m * P.H + q) ^ (2 : ℕ)) := by
    intro m r hr
    exact Delta_block_pointwise_le_endpoint_plus_stale_range_l2 P hstepsize m r hr
  have hsource_recursion_consumed :
      (∀ m : ℕ,
        Delta P (P.K0 + (m + 1) * P.H) ≤
          P.rho * Delta P (P.K0 + m * P.H) +
            2 * P.gamma * Real.sqrt (P.H : ℝ) *
              Real.sqrt (∑ q ∈ Finset.range P.H,
                staleError P (P.K0 + m * P.H + q) ^ (2 : ℕ))) ∧
      (∀ m r : ℕ, r ≤ P.H →
        Delta P (P.K0 + m * P.H + r) ≤
          Delta P (P.K0 + m * P.H) +
            2 * P.gamma * Real.sqrt (P.H : ℝ) *
              Real.sqrt (∑ q ∈ Finset.range P.H,
                staleError P (P.K0 + m * P.H + q) ^ (2 : ℕ))) := by
    exact ⟨hendpoint, hwithin⟩
  have hinitial_geometric :
      ∀ M : ℕ,
        Setup.finiteHorizonL2Norm
            (fun m => P.rho ^ m * Delta P P.K0) 0 M ≤
          Delta P P.K0 / Real.sqrt (1 - P.rho ^ (2 : ℕ)) := by
    intro M
    exact finiteHorizonL2Norm_geometric_initial_le
      hrho_range.1 hrho_range.2 (hDelta_nonneg P.K0) M
  let bBlock : ℕ → ℝ := fun m =>
    Real.sqrt (∑ q ∈ Finset.range P.H,
      staleError P (P.K0 + m * P.H + q) ^ (2 : ℕ))
  have hendpoint_gain :
      ∀ M : ℕ,
        Setup.finiteHorizonL2Norm
            (fun m => Delta P (P.K0 + m * P.H)) 0 M ≤
          Delta P P.K0 / Real.sqrt (1 - P.rho ^ (2 : ℕ)) +
            (2 * P.gamma * Real.sqrt (P.H : ℝ)) * (1 - P.rho)⁻¹ *
              Setup.finiteHorizonL2Norm bBlock 0 M := by
    intro M
    let eBlock : ℕ → ℝ := fun m => Delta P (P.K0 + m * P.H)
    have hc_nonneg : 0 ≤ 2 * P.gamma * Real.sqrt (P.H : ℝ) := by
      positivity
    have he_nonneg : ∀ m, 0 ≤ eBlock m := by
      intro m
      exact hDelta_nonneg (P.K0 + m * P.H)
    have he0_nonneg : 0 ≤ eBlock 0 := by
      simpa [eBlock] using hDelta_nonneg P.K0
    have hrec :
        ∀ m : ℕ,
          eBlock (m + 1) ≤
            P.rho * eBlock m +
              (2 * P.gamma * Real.sqrt (P.H : ℝ)) * bBlock m := by
      intro m
      simpa [eBlock, bBlock, mul_assoc] using hendpoint m
    have hgain :=
      scalar_endpoint_recursion_l2_gain
        hrho_range.1 hrho_range.2 hc_nonneg eBlock bBlock he_nonneg
        he0_nonneg hrec M
    simpa [eBlock, bBlock, mul_assoc] using hgain
  let N : ℕ := T - P.K0
  let M : ℕ := N / P.H + 1
  let bTrunc : ℕ → ℝ := fun m =>
    Real.sqrt (∑ q ∈ Finset.range P.H,
      (if P.K0 + m * P.H + q < T then
        staleError P (P.K0 + m * P.H + q) ^ (2 : ℕ)
      else 0))
  have hendpoint_gain_truncated :
      Setup.finiteHorizonL2Norm
          (fun m => Delta P (P.K0 + m * P.H)) 0 M ≤
        Delta P P.K0 / Real.sqrt (1 - P.rho ^ (2 : ℕ)) +
          (2 * P.gamma * Real.sqrt (P.H : ℝ)) * (1 - P.rho)⁻¹ *
            Setup.finiteHorizonL2Norm bTrunc 0 M := by
    let eBlock : ℕ → ℝ := fun m => Delta P (P.K0 + m * P.H)
    have hc_nonneg : 0 ≤ 2 * P.gamma * Real.sqrt (P.H : ℝ) := by
      positivity
    have he_nonneg : ∀ m, 0 ≤ eBlock m := by
      intro m
      exact hDelta_nonneg (P.K0 + m * P.H)
    have he0_nonneg : 0 ≤ eBlock 0 := by
      simpa [eBlock] using hDelta_nonneg P.K0
    have hrec :
        ∀ m : ℕ, m + 1 < M →
          eBlock (m + 1) ≤
            P.rho * eBlock m +
              (2 * P.gamma * Real.sqrt (P.H : ℝ)) * bTrunc m := by
      intro m hm
      have hblock_eq : bTrunc m = bBlock m := by
        unfold bTrunc bBlock
        congr 1
        refine Finset.sum_congr rfl ?_
        intro q hq
        rw [Finset.mem_range] at hq
        have hm_div : m < N / P.H := by
          unfold M at hm
          omega
        have hmH_le : (m + 1) * P.H ≤ (N / P.H) * P.H := by
          exact Nat.mul_le_mul_right P.H (Nat.succ_le_of_lt hm_div)
        have hdiv_le : (N / P.H) * P.H ≤ N := by
          simpa [Nat.mul_comm] using Nat.div_mul_le_self N P.H
        have hmq_lt_N : m * P.H + q < N := by
          calc
            m * P.H + q < m * P.H + P.H :=
              Nat.add_lt_add_left hq (m * P.H)
            _ = (m + 1) * P.H := by
              rw [Nat.succ_mul]
            _ ≤ (N / P.H) * P.H := hmH_le
            _ ≤ N := hdiv_le
        have hidx_lt : P.K0 + m * P.H + q < T := by
          unfold N at hmq_lt_N
          omega
        simp [hidx_lt]
      have hfull := hendpoint m
      simpa [eBlock, hblock_eq, mul_assoc] using hfull
    have hgain :=
      scalar_endpoint_recursion_l2_gain_on_range
        hrho_range.1 hrho_range.2 hc_nonneg eBlock bTrunc he_nonneg
        he0_nonneg M hrec
    simpa [eBlock, bTrunc, mul_assoc] using hgain
  have hwithin_truncated :
      ∀ k, k ∈ Finset.Ico P.K0 T →
        Delta P k ≤
          Delta P (P.K0 + ((k - P.K0) / P.H) * P.H) +
            2 * P.gamma * Real.sqrt (P.H : ℝ) *
              bTrunc ((k - P.K0) / P.H) := by
    intro k hk
    rw [Finset.mem_Ico] at hk
    let m : ℕ := (k - P.K0) / P.H
    let r : ℕ := (k - P.K0) % P.H
    let base : ℕ := P.K0 + m * P.H
    have hr_lt : r < P.H := Nat.mod_lt (k - P.K0) hH_pos
    have hr : r ≤ P.H := le_of_lt hr_lt
    have hsub_decomp : k - P.K0 = m * P.H + r := by
      have hdiv := Nat.div_add_mod (k - P.K0) P.H
      unfold m r
      rw [Nat.mul_comm P.H ((k - P.K0) / P.H)] at hdiv
      omega
    have hk_decomp : k = base + r := by
      unfold base
      omega
    have hdelta :
        Delta P (base + r) ≤
          Delta P base + P.gamma * ∑ q ∈ Finset.range r, 2 * staleError P (base + q) :=
      Delta_add_r_le_delta_plus_stale_sum P hstepsize base r
    have hprefix_lt :
        ∀ q, q ∈ Finset.range r → base + q < T := by
      intro q hq
      rw [Finset.mem_range] at hq
      have hq_lt_k : base + q < k := by
        rw [hk_decomp]
        exact Nat.add_lt_add_left hq base
      exact lt_trans hq_lt_k hk.2
    have hstale :
        (∑ q ∈ Finset.range r, staleError P (base + q)) ≤
          Real.sqrt (P.H : ℝ) * bTrunc m := by
      have h :=
        staleError_block_prefix_sum_le_sqrt_H_mul_truncated_l2
          P (k := base) (r := r) (T := T) hr hprefix_lt
      simpa [bTrunc, base, m] using h
    have hcoef_nonneg : 0 ≤ 2 * P.gamma := by positivity
    calc
      Delta P k = Delta P (base + r) := by rw [hk_decomp]
      _ ≤ Delta P base + P.gamma * ∑ q ∈ Finset.range r, 2 * staleError P (base + q) :=
          hdelta
      _ = Delta P base + 2 * P.gamma *
            (∑ q ∈ Finset.range r, staleError P (base + q)) := by
          rw [← Finset.mul_sum]
          ring
      _ ≤ Delta P base + 2 * P.gamma *
            (Real.sqrt (P.H : ℝ) * bTrunc m) := by
          have hmul := mul_le_mul_of_nonneg_left hstale hcoef_nonneg
          nlinarith
      _ = Delta P (P.K0 + ((k - P.K0) / P.H) * P.H) +
            2 * P.gamma * Real.sqrt (P.H : ℝ) *
              bTrunc ((k - P.K0) / P.H) := by
          simp [base, m]
          ring
  -- Remaining source step: scalar geometric L2 gain, block-to-horizon
  -- truncation, and normalization to `A_0` and `C_N`.
  have hBlockNorm :
      Setup.finiteHorizonL2Norm bTrunc 0 M =
        Setup.finiteHorizonL2Norm (staleError P) P.K0 T := by
    unfold bTrunc M N
    simpa using
      (finiteHorizonL2Norm_truncated_blocks_eq
        (staleError P) (K := P.K0) (T := T) (H := P.H) hT hH_pos)
  let eBlock : ℕ → ℝ := fun m => Delta P (P.K0 + m * P.H)
  let cWithin : ℝ := 2 * P.gamma * Real.sqrt (P.H : ℝ)
  have hcWithin_nonneg : 0 ≤ cWithin := by
    unfold cWithin
    positivity
  have hsqrtH_mul :
      Real.sqrt (P.H : ℝ) * Real.sqrt (P.H : ℝ) = (P.H : ℝ) := by
    rw [← sq]
    exact Real.sq_sqrt (Nat.cast_nonneg P.H)
  have hDeltaLift :
      Setup.finiteHorizonL2Norm (Delta P) P.K0 T ≤
        Real.sqrt (P.H : ℝ) *
          Setup.finiteHorizonL2Norm eBlock 0 M +
          (2 * P.gamma * (P.H : ℝ)) *
            Setup.finiteHorizonL2Norm bTrunc 0 M := by
    have hmono :
        Setup.finiteHorizonL2Norm (Delta P) P.K0 T ≤
          Setup.finiteHorizonL2Norm
            (fun k => eBlock ((k - P.K0) / P.H) +
              cWithin * bTrunc ((k - P.K0) / P.H)) P.K0 T := by
      apply finiteHorizonL2Norm_mono_nonneg
      · intro k hk
        exact hDelta_nonneg k
      · intro k hk
        have hpoint := hwithin_truncated k hk
        simpa [eBlock, cWithin, mul_assoc] using hpoint
    have htri :
        Setup.finiteHorizonL2Norm
            (fun k => eBlock ((k - P.K0) / P.H) +
              cWithin * bTrunc ((k - P.K0) / P.H)) P.K0 T ≤
          Setup.finiteHorizonL2Norm
              (fun k => eBlock ((k - P.K0) / P.H)) P.K0 T +
            Setup.finiteHorizonL2Norm
              (fun k => cWithin * bTrunc ((k - P.K0) / P.H)) P.K0 T :=
      finiteHorizonL2Norm_add_le
        (fun k => eBlock ((k - P.K0) / P.H))
        (fun k => cWithin * bTrunc ((k - P.K0) / P.H)) P.K0 T
    have he_count :
        Setup.finiteHorizonL2Norm
            (fun k => eBlock ((k - P.K0) / P.H)) P.K0 T ≤
          Real.sqrt (P.H : ℝ) * Setup.finiteHorizonL2Norm eBlock 0 M := by
      unfold M N
      exact finiteHorizonL2Norm_quotient_le_sqrt_H_mul
        eBlock (K := P.K0) (T := T) (H := P.H) hT hH_pos
    have hb_count :
        Setup.finiteHorizonL2Norm
            (fun k => bTrunc ((k - P.K0) / P.H)) P.K0 T ≤
          Real.sqrt (P.H : ℝ) * Setup.finiteHorizonL2Norm bTrunc 0 M := by
      unfold M N
      exact finiteHorizonL2Norm_quotient_le_sqrt_H_mul
        bTrunc (K := P.K0) (T := T) (H := P.H) hT hH_pos
    have hscale :
        Setup.finiteHorizonL2Norm
            (fun k => cWithin * bTrunc ((k - P.K0) / P.H)) P.K0 T =
          cWithin *
            Setup.finiteHorizonL2Norm
              (fun k => bTrunc ((k - P.K0) / P.H)) P.K0 T :=
      finiteHorizonL2Norm_const_mul_of_nonneg
        (fun k => bTrunc ((k - P.K0) / P.H)) P.K0 T hcWithin_nonneg
    calc
      Setup.finiteHorizonL2Norm (Delta P) P.K0 T
          ≤ Setup.finiteHorizonL2Norm
            (fun k => eBlock ((k - P.K0) / P.H) +
              cWithin * bTrunc ((k - P.K0) / P.H)) P.K0 T := hmono
      _ ≤ Setup.finiteHorizonL2Norm
              (fun k => eBlock ((k - P.K0) / P.H)) P.K0 T +
            Setup.finiteHorizonL2Norm
              (fun k => cWithin * bTrunc ((k - P.K0) / P.H)) P.K0 T := htri
      _ = Setup.finiteHorizonL2Norm
              (fun k => eBlock ((k - P.K0) / P.H)) P.K0 T +
            cWithin *
              Setup.finiteHorizonL2Norm
                (fun k => bTrunc ((k - P.K0) / P.H)) P.K0 T := by
            rw [hscale]
      _ ≤ Real.sqrt (P.H : ℝ) * Setup.finiteHorizonL2Norm eBlock 0 M +
            cWithin * (Real.sqrt (P.H : ℝ) *
              Setup.finiteHorizonL2Norm bTrunc 0 M) := by
            exact add_le_add he_count
              (mul_le_mul_of_nonneg_left hb_count hcWithin_nonneg)
      _ = Real.sqrt (P.H : ℝ) *
            Setup.finiteHorizonL2Norm eBlock 0 M +
            (2 * P.gamma * (P.H : ℝ)) *
              Setup.finiteHorizonL2Norm bTrunc 0 M := by
            unfold cWithin
            calc
              Real.sqrt (P.H : ℝ) *
                    Setup.finiteHorizonL2Norm eBlock 0 M +
                  2 * P.gamma * Real.sqrt (P.H : ℝ) *
                    (Real.sqrt (P.H : ℝ) *
                      Setup.finiteHorizonL2Norm bTrunc 0 M)
                  =
                Real.sqrt (P.H : ℝ) *
                    Setup.finiteHorizonL2Norm eBlock 0 M +
                  2 * P.gamma *
                    (Real.sqrt (P.H : ℝ) * Real.sqrt (P.H : ℝ)) *
                      Setup.finiteHorizonL2Norm bTrunc 0 M := by
                  ring
              _ = Real.sqrt (P.H : ℝ) *
                    Setup.finiteHorizonL2Norm eBlock 0 M +
                  (2 * P.gamma * (P.H : ℝ)) *
                    Setup.finiteHorizonL2Norm bTrunc 0 M := by
                  rw [hsqrtH_mul]
  suffices hfinal :
      Setup.finiteHorizonL2Norm (Delta P) P.K0 T ≤
        P.A_0 + P.C_N * P.gamma * Setup.finiteHorizonL2Norm bTrunc 0 M by
    rwa [hBlockNorm] at hfinal
  calc
    Setup.finiteHorizonL2Norm (Delta P) P.K0 T
        ≤ Real.sqrt (P.H : ℝ) *
            Setup.finiteHorizonL2Norm eBlock 0 M +
          (2 * P.gamma * (P.H : ℝ)) *
            Setup.finiteHorizonL2Norm bTrunc 0 M := hDeltaLift
    _ ≤ P.A_0 + P.C_N * P.gamma * Setup.finiteHorizonL2Norm bTrunc 0 M := by
      have hden_nonneg : 0 ≤ 1 - P.rho ^ (2 : ℕ) := le_of_lt hA_den_pos
      have hnum_nonneg : 0 ≤ 2 * (P.H : ℝ) := by positivity
      have hHcast_nonneg : 0 ≤ (P.H : ℝ) := Nat.cast_nonneg P.H
      have hinit_nonneg :
          0 ≤ Delta P P.K0 / Real.sqrt (1 - P.rho ^ (2 : ℕ)) := by
        exact div_nonneg (hDelta_nonneg P.K0) (Real.sqrt_nonneg _)
      have hsqrtH_le_sqrt2H :
          Real.sqrt (P.H : ℝ) ≤ Real.sqrt (2 * (P.H : ℝ)) := by
        apply Real.sqrt_le_sqrt
        nlinarith [hHcast_nonneg]
      have hinit_le :
          Real.sqrt (P.H : ℝ) *
              (Delta P P.K0 / Real.sqrt (1 - P.rho ^ (2 : ℕ))) ≤
            P.A_0 := by
        calc
          Real.sqrt (P.H : ℝ) *
              (Delta P P.K0 / Real.sqrt (1 - P.rho ^ (2 : ℕ)))
              ≤ Real.sqrt (2 * (P.H : ℝ)) *
                  (Delta P P.K0 / Real.sqrt (1 - P.rho ^ (2 : ℕ))) := by
                exact mul_le_mul_of_nonneg_right
                  hsqrtH_le_sqrt2H hinit_nonneg
          _ = P.A_0 := by
                unfold Setup.A_0
                rw [Real.sqrt_div hnum_nonneg]
                ring
      have hB_nonneg : 0 ≤ Setup.finiteHorizonL2Norm bTrunc 0 M := by
        unfold Setup.finiteHorizonL2Norm
        positivity
      have hone_sub_rho : 1 - P.rho = (P.n : ℝ) * P.beta := by
        unfold Setup.rho
        ring
      have hnbeta_le_one : (P.n : ℝ) * P.beta ≤ 1 :=
        n_mul_beta_le_one_of_h_round_product P
      have hone_le_inv : 1 ≤ (1 - P.rho)⁻¹ := by
        rw [hone_sub_rho]
        exact (one_le_inv₀ hC_den_pos).mpr hnbeta_le_one
      have hsqrtH_nonneg : 0 ≤ Real.sqrt (P.H : ℝ) := Real.sqrt_nonneg _
      have hend_scaled :
          Real.sqrt (P.H : ℝ) * Setup.finiteHorizonL2Norm eBlock 0 M ≤
            P.A_0 + (2 * P.gamma * (P.H : ℝ)) * (1 - P.rho)⁻¹ *
              Setup.finiteHorizonL2Norm bTrunc 0 M := by
        have hmul := mul_le_mul_of_nonneg_left hendpoint_gain_truncated hsqrtH_nonneg
        calc
          Real.sqrt (P.H : ℝ) * Setup.finiteHorizonL2Norm eBlock 0 M
              ≤ Real.sqrt (P.H : ℝ) *
                  (Delta P P.K0 / Real.sqrt (1 - P.rho ^ (2 : ℕ)) +
                    2 * P.gamma * Real.sqrt (P.H : ℝ) * (1 - P.rho)⁻¹ *
                      Setup.finiteHorizonL2Norm bTrunc 0 M) := hmul
          _ = Real.sqrt (P.H : ℝ) *
                  (Delta P P.K0 / Real.sqrt (1 - P.rho ^ (2 : ℕ))) +
                (2 * P.gamma *
                    (Real.sqrt (P.H : ℝ) * Real.sqrt (P.H : ℝ))) *
                  (1 - P.rho)⁻¹ * Setup.finiteHorizonL2Norm bTrunc 0 M := by
                ring
          _ = Real.sqrt (P.H : ℝ) *
                  (Delta P P.K0 / Real.sqrt (1 - P.rho ^ (2 : ℕ))) +
                (2 * P.gamma * (P.H : ℝ)) * (1 - P.rho)⁻¹ *
                  Setup.finiteHorizonL2Norm bTrunc 0 M := by
                rw [hsqrtH_mul]
          _ ≤ P.A_0 + (2 * P.gamma * (P.H : ℝ)) * (1 - P.rho)⁻¹ *
                  Setup.finiteHorizonL2Norm bTrunc 0 M := by
                exact add_le_add hinit_le le_rfl
      have hcoef_nonneg : 0 ≤ 2 * P.gamma * (P.H : ℝ) := by positivity
      have hfeedback_le_inverted :
          (2 * P.gamma * (P.H : ℝ)) *
              Setup.finiteHorizonL2Norm bTrunc 0 M ≤
            (2 * P.gamma * (P.H : ℝ)) * (1 - P.rho)⁻¹ *
              Setup.finiteHorizonL2Norm bTrunc 0 M := by
        have htmp : (2 * P.gamma * (P.H : ℝ)) * 1 ≤
            (2 * P.gamma * (P.H : ℝ)) * (1 - P.rho)⁻¹ := by
          exact mul_le_mul_of_nonneg_left hone_le_inv hcoef_nonneg
        calc
          (2 * P.gamma * (P.H : ℝ)) * Setup.finiteHorizonL2Norm bTrunc 0 M
              = ((2 * P.gamma * (P.H : ℝ)) * 1) *
                  Setup.finiteHorizonL2Norm bTrunc 0 M := by
                ring
          _ ≤ ((2 * P.gamma * (P.H : ℝ)) * (1 - P.rho)⁻¹) *
                  Setup.finiteHorizonL2Norm bTrunc 0 M := by
                exact mul_le_mul_of_nonneg_right htmp hB_nonneg
          _ = (2 * P.gamma * (P.H : ℝ)) * (1 - P.rho)⁻¹ *
                  Setup.finiteHorizonL2Norm bTrunc 0 M := by
                ring
      have hCN_base : 4 * (P.H : ℝ) * (1 - P.rho)⁻¹ ≤ P.C_N := by
        rw [hone_sub_rho]
        unfold Setup.C_N
        have h4le6 : 4 * (P.H : ℝ) ≤ 6 * (P.H : ℝ) := by
          nlinarith [hHcast_nonneg]
        calc
          4 * (P.H : ℝ) * ((P.n : ℝ) * P.beta)⁻¹
              = (4 * (P.H : ℝ)) / ((P.n : ℝ) * P.beta) := by
                rw [div_eq_mul_inv]
          _ ≤ (6 * (P.H : ℝ)) / ((P.n : ℝ) * P.beta) := by
                exact div_le_div_of_nonneg_right h4le6 (le_of_lt hC_den_pos)
      have hgammaB_nonneg :
          0 ≤ P.gamma * Setup.finiteHorizonL2Norm bTrunc 0 M :=
        mul_nonneg hgamma_nonneg hB_nonneg
      have hCN_feedback :
          ((4 * (P.H : ℝ) * (1 - P.rho)⁻¹) *
              (P.gamma * Setup.finiteHorizonL2Norm bTrunc 0 M)) ≤
            P.C_N * (P.gamma * Setup.finiteHorizonL2Norm bTrunc 0 M) := by
        exact mul_le_mul_of_nonneg_right hCN_base hgammaB_nonneg
      have hfeedback_total :
          (2 * P.gamma * (P.H : ℝ)) * (1 - P.rho)⁻¹ *
                Setup.finiteHorizonL2Norm bTrunc 0 M +
              (2 * P.gamma * (P.H : ℝ)) *
                Setup.finiteHorizonL2Norm bTrunc 0 M ≤
            P.C_N * P.gamma * Setup.finiteHorizonL2Norm bTrunc 0 M := by
        calc
          (2 * P.gamma * (P.H : ℝ)) * (1 - P.rho)⁻¹ *
                Setup.finiteHorizonL2Norm bTrunc 0 M +
              (2 * P.gamma * (P.H : ℝ)) *
                Setup.finiteHorizonL2Norm bTrunc 0 M
              ≤ (2 * P.gamma * (P.H : ℝ)) * (1 - P.rho)⁻¹ *
                  Setup.finiteHorizonL2Norm bTrunc 0 M +
                (2 * P.gamma * (P.H : ℝ)) * (1 - P.rho)⁻¹ *
                  Setup.finiteHorizonL2Norm bTrunc 0 M := by
                exact add_le_add le_rfl hfeedback_le_inverted
          _ = (4 * (P.H : ℝ) * (1 - P.rho)⁻¹) *
                (P.gamma * Setup.finiteHorizonL2Norm bTrunc 0 M) := by
                ring
          _ ≤ P.C_N * (P.gamma * Setup.finiteHorizonL2Norm bTrunc 0 M) :=
                hCN_feedback
          _ = P.C_N * P.gamma * Setup.finiteHorizonL2Norm bTrunc 0 M := by
                ring
      calc
        Real.sqrt (P.H : ℝ) * Setup.finiteHorizonL2Norm eBlock 0 M +
            2 * P.gamma * (P.H : ℝ) *
              Setup.finiteHorizonL2Norm bTrunc 0 M
            ≤ (P.A_0 + (2 * P.gamma * (P.H : ℝ)) * (1 - P.rho)⁻¹ *
                Setup.finiteHorizonL2Norm bTrunc 0 M) +
              2 * P.gamma * (P.H : ℝ) *
                Setup.finiteHorizonL2Norm bTrunc 0 M := by
              exact add_le_add hend_scaled le_rfl
        _ = P.A_0 +
              ((2 * P.gamma * (P.H : ℝ)) * (1 - P.rho)⁻¹ *
                Setup.finiteHorizonL2Norm bTrunc 0 M +
              (2 * P.gamma * (P.H : ℝ)) *
                Setup.finiteHorizonL2Norm bTrunc 0 M) := by
              ring
        _ ≤ P.A_0 + P.C_N * P.gamma *
              Setup.finiteHorizonL2Norm bTrunc 0 M := by
              exact add_le_add le_rfl hfeedback_total

private theorem finite_horizon_snapshot_disagreement_small_gain
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) {T : ℕ}
    (hT : P.K0 ≤ T) :
    Setup.finiteHorizonL2Norm (staleError P) P.K0 T ≤
        P.B_0 + 2 * P.L * (P.D : ℝ) * P.gamma *
          Setup.finiteHorizonL2Norm
            (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 T ∧
      Setup.finiteHorizonL2Norm (Delta P) P.K0 T ≤
        P.A_1 + 2 * P.C_N * P.L * (P.D : ℝ) *
          P.gamma ^ (2 : ℕ) *
            Setup.finiteHorizonL2Norm
              (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 T := by
  classical
  let Hnorm : ℝ := Setup.finiteHorizonL2Norm (staleError P) P.K0 T
  let Dnorm : ℝ := Setup.finiteHorizonL2Norm (Delta P) P.K0 T
  let Gnorm : ℝ :=
    Setup.finiteHorizonL2Norm
      (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 T
  have hH_nonneg : 0 ≤ Hnorm := by
    unfold Hnorm Setup.finiteHorizonL2Norm
    positivity
  have hD_le : Dnorm ≤ P.A_0 + P.C_N * P.gamma * Hnorm := by
    simpa [Dnorm, Hnorm] using
      (finite_horizon_disagreement_gain P hstepsize (T := T) hT)
  have hraw :
      Hnorm ≤
        P.H_0 + P.L * (P.D : ℝ) *
          ((1 + P.gamma * P.L) * Dnorm +
            P.gamma * Gnorm + (2 * P.gamma) * Hnorm) := by
    simpa [Hnorm, Dnorm, Gnorm, add_assoc, add_comm, add_left_comm] using
      (finite_horizon_staleError_le_raw_feedback P hstepsize (T := T) hT)
  have hL_nonneg : 0 ≤ P.L :=
    le_of_lt (L_pos_of_theoremStepsizeCondition P hstepsize)
  have hD_nonneg : 0 ≤ (P.D : ℝ) := le_of_lt (D_pos_real P)
  have hgamma_nonneg : 0 ≤ P.gamma := le_of_lt hstepsize.1
  have hCN_nonneg : 0 ≤ P.C_N := le_of_lt (C_N_pos P)
  have h_one_gammaL_nonneg : 0 ≤ 1 + P.gamma * P.L := by
    positivity
  have hLD_nonneg : 0 ≤ P.L * (P.D : ℝ) := by
    positivity
  have hraw_substituted :
      Hnorm ≤
        P.H_0 + P.L * (P.D : ℝ) *
          ((1 + P.gamma * P.L) *
              (P.A_0 + P.C_N * P.gamma * Hnorm) +
            P.gamma * Gnorm + (2 * P.gamma) * Hnorm) := by
    have hdelta_scaled :
        (1 + P.gamma * P.L) * Dnorm ≤
          (1 + P.gamma * P.L) *
            (P.A_0 + P.C_N * P.gamma * Hnorm) :=
      mul_le_mul_of_nonneg_left hD_le h_one_gammaL_nonneg
    calc
      Hnorm ≤
        P.H_0 + P.L * (P.D : ℝ) *
          ((1 + P.gamma * P.L) * Dnorm +
            P.gamma * Gnorm + (2 * P.gamma) * Hnorm) := hraw
      _ ≤
        P.H_0 + P.L * (P.D : ℝ) *
          ((1 + P.gamma * P.L) *
              (P.A_0 + P.C_N * P.gamma * Hnorm) +
            P.gamma * Gnorm + (2 * P.gamma) * Hnorm) := by
          have hinner :
              (1 + P.gamma * P.L) * Dnorm +
                  P.gamma * Gnorm + (2 * P.gamma) * Hnorm ≤
                (1 + P.gamma * P.L) *
                    (P.A_0 + P.C_N * P.gamma * Hnorm) +
                  P.gamma * Gnorm + (2 * P.gamma) * Hnorm := by
            nlinarith
          have hmul := mul_le_mul_of_nonneg_left hinner hLD_nonneg
          nlinarith
  let alpha : ℝ :=
    P.L * (P.D : ℝ) * P.gamma *
      ((1 + P.gamma * P.L) * P.C_N + 2)
  let base : ℝ :=
    P.H_0 + P.L * (P.D : ℝ) * (1 + P.gamma * P.L) * P.A_0 +
      P.L * (P.D : ℝ) * P.gamma * Gnorm
  have hraw_collected : Hnorm ≤ base + alpha * Hnorm := by
    calc
      Hnorm ≤
        P.H_0 + P.L * (P.D : ℝ) *
          ((1 + P.gamma * P.L) *
              (P.A_0 + P.C_N * P.gamma * Hnorm) +
            P.gamma * Gnorm + (2 * P.gamma) * Hnorm) := hraw_substituted
      _ = base + alpha * Hnorm := by
          unfold base alpha
          ring
  have halpha_half : alpha ≤ (1 / 2 : ℝ) := by
    simpa [alpha] using small_gain_feedback_coeff_le_half P hstepsize
  have hH_two_base : Hnorm ≤ 2 * base :=
    self_le_of_le_add_mul_self_coeff_half hH_nonneg halpha_half hraw_collected
  have hstale :
      Hnorm ≤
        P.B_0 + 2 * P.L * (P.D : ℝ) * P.gamma * Gnorm := by
    calc
      Hnorm ≤ 2 * base := hH_two_base
      _ = P.B_0 + 2 * P.L * (P.D : ℝ) * P.gamma * Gnorm := by
          unfold base Setup.B_0
          ring
  have hCN_gamma_nonneg : 0 ≤ P.C_N * P.gamma := by
    positivity
  have hdelta :
      Dnorm ≤
        P.A_1 + 2 * P.C_N * P.L * (P.D : ℝ) *
          P.gamma ^ (2 : ℕ) * Gnorm := by
    calc
      Dnorm ≤ P.A_0 + P.C_N * P.gamma * Hnorm := hD_le
      _ ≤ P.A_0 + P.C_N * P.gamma *
          (P.B_0 + 2 * P.L * (P.D : ℝ) * P.gamma * Gnorm) := by
          have hmul := mul_le_mul_of_nonneg_left hstale hCN_gamma_nonneg
          nlinarith
      _ = P.A_1 + 2 * P.C_N * P.L * (P.D : ℝ) *
          P.gamma ^ (2 : ℕ) * Gnorm := by
          unfold Setup.A_1
          ring
  exact ⟨by simpa [Hnorm, Gnorm] using hstale,
    by simpa [Dnorm, Gnorm] using hdelta⟩

private theorem finiteHorizonL2Norm_sq_eq_sum
    (u : ℕ → ℝ) (p q : ℕ) :
    Setup.finiteHorizonL2Norm u p q ^ (2 : ℕ) =
      ∑ k ∈ Finset.Ico p q, u k ^ (2 : ℕ) := by
  unfold Setup.finiteHorizonL2Norm
  rw [Real.sq_sqrt]
  exact Finset.sum_nonneg (fun k _hk => sq_nonneg (u k))

private theorem drifted_descent_sum_terminal_bound
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) {T : ℕ}
    (hT : P.K0 ≤ T) :
    (P.gamma / 2) *
        Setup.finiteHorizonL2Norm
          (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 T ^ (2 : ℕ) ≤
      P.aggregateObjective (xBar P P.K0) -
          P.aggregateObjective (xBar P T) +
        2 * P.gamma * (P.L + P.gamma⁻¹) ^ (2 : ℕ) *
          Setup.finiteHorizonL2Norm (Delta P) P.K0 T ^ (2 : ℕ) := by
  classical
  refine Nat.le_induction ?base ?step T hT
  · simp [finiteHorizonL2Norm_sq_eq_sum]
  · intro m hKm ih
    have hdescent := drifted_descent_delta_bound P hstepsize m
    have hstep :
        (P.gamma / 2) *
            ‖P.aggregateGradient (xBar P m)‖ ^ (2 : ℕ) ≤
          P.aggregateObjective (xBar P m) -
              P.aggregateObjective (xBar P (m + 1)) +
            2 * P.gamma * (P.L + P.gamma⁻¹) ^ (2 : ℕ) *
              Delta P m ^ (2 : ℕ) := by
      nlinarith
    have hG_succ :
        Setup.finiteHorizonL2Norm
            (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 (m + 1) ^ (2 : ℕ) =
          Setup.finiteHorizonL2Norm
            (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 m ^ (2 : ℕ) +
            ‖P.aggregateGradient (xBar P m)‖ ^ (2 : ℕ) := by
      rw [finiteHorizonL2Norm_sq_eq_sum, finiteHorizonL2Norm_sq_eq_sum,
        Finset.sum_Ico_succ_top hKm]
    have hD_succ :
        Setup.finiteHorizonL2Norm (Delta P) P.K0 (m + 1) ^ (2 : ℕ) =
          Setup.finiteHorizonL2Norm (Delta P) P.K0 m ^ (2 : ℕ) +
            Delta P m ^ (2 : ℕ) := by
      rw [finiteHorizonL2Norm_sq_eq_sum, finiteHorizonL2Norm_sq_eq_sum,
        Finset.sum_Ico_succ_top hKm]
    calc
      (P.gamma / 2) *
          Setup.finiteHorizonL2Norm
            (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 (m + 1) ^ (2 : ℕ)
          =
        (P.gamma / 2) *
            Setup.finiteHorizonL2Norm
              (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 m ^ (2 : ℕ) +
          (P.gamma / 2) *
            ‖P.aggregateGradient (xBar P m)‖ ^ (2 : ℕ) := by
          rw [hG_succ]
          ring
      _ ≤
        (P.aggregateObjective (xBar P P.K0) -
            P.aggregateObjective (xBar P m) +
          2 * P.gamma * (P.L + P.gamma⁻¹) ^ (2 : ℕ) *
            Setup.finiteHorizonL2Norm (Delta P) P.K0 m ^ (2 : ℕ)) +
          (P.aggregateObjective (xBar P m) -
            P.aggregateObjective (xBar P (m + 1)) +
          2 * P.gamma * (P.L + P.gamma⁻¹) ^ (2 : ℕ) *
            Delta P m ^ (2 : ℕ)) := by
          exact add_le_add ih hstep
      _ =
        P.aggregateObjective (xBar P P.K0) -
            P.aggregateObjective (xBar P (m + 1)) +
          2 * P.gamma * (P.L + P.gamma⁻¹) ^ (2 : ℕ) *
            Setup.finiteHorizonL2Norm (Delta P) P.K0 (m + 1) ^ (2 : ℕ) := by
          rw [hD_succ]
          ring

private theorem square_le_two_sq_add_two_sq_of_nonneg_le_add
    {x a b : ℝ} (hx : 0 ≤ x) (ha : 0 ≤ a) (hb : 0 ≤ b)
    (hxab : x ≤ a + b) :
    x ^ (2 : ℕ) ≤ 2 * a ^ (2 : ℕ) + 2 * b ^ (2 : ℕ) := by
  have hx_sq_le : x ^ (2 : ℕ) ≤ (a + b) ^ (2 : ℕ) := by
    nlinarith [hxab, hx, ha, hb]
  have hab_sq : (a + b) ^ (2 : ℕ) ≤
      2 * a ^ (2 : ℕ) + 2 * b ^ (2 : ℕ) := by
    nlinarith [sq_nonneg (a - b)]
  exact le_trans hx_sq_le hab_sq

private theorem theorem_feedback_gain_le_quarter
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) :
    (P.L + P.gamma⁻¹) *
        (2 * P.C_N * P.L * (P.D : ℝ) * P.gamma ^ (2 : ℕ)) ≤
      (1 / 4 : ℝ) := by
  have hL_pos : 0 < P.L := L_pos_of_theoremStepsizeCondition P hstepsize
  have hD_pos : 0 < (P.D : ℝ) := D_pos_real P
  have hCN_pos : 0 < P.C_N := C_N_pos P
  have hgamma_pos : 0 < P.gamma := hstepsize.1
  have hgammaL : P.gamma * P.L ≤ (1 / 4 : ℝ) :=
    gamma_mul_L_le_quarter_of_theoremStepsizeCondition P hstepsize
  have hgamma_le_inv :
      P.gamma ≤ (16 * P.L * (P.D : ℝ) * (P.C_N + 2))⁻¹ :=
    le_trans hstepsize.2 (min_le_right _ _)
  have hM_pos : 0 < P.L * (P.D : ℝ) * (P.C_N + 2) := by
    positivity
  have hgammaM :
      P.gamma * (P.L * (P.D : ℝ) * (P.C_N + 2)) ≤ (1 / 16 : ℝ) := by
    have hmul := mul_le_mul_of_nonneg_right hgamma_le_inv (le_of_lt hM_pos)
    have hinv_mul :
        (16 * P.L * (P.D : ℝ) * (P.C_N + 2))⁻¹ *
            (P.L * (P.D : ℝ) * (P.C_N + 2)) = (1 / 16 : ℝ) := by
      field_simp [ne_of_gt hL_pos, ne_of_gt hD_pos, ne_of_gt hCN_pos]
    calc
      P.gamma * (P.L * (P.D : ℝ) * (P.C_N + 2))
          ≤ (16 * P.L * (P.D : ℝ) * (P.C_N + 2))⁻¹ *
              (P.L * (P.D : ℝ) * (P.C_N + 2)) := hmul
      _ = (1 / 16 : ℝ) := hinv_mul
  have hgammaLDFull :
      P.gamma * P.L * (P.D : ℝ) * P.C_N ≤ (1 / 16 : ℝ) := by
    have hCN_le : P.C_N ≤ P.C_N + 2 := by nlinarith
    have hbase_nonneg : 0 ≤ P.gamma * P.L * (P.D : ℝ) := by positivity
    have hmul :=
      mul_le_mul_of_nonneg_left hCN_le hbase_nonneg
    nlinarith [hmul, hgammaM]
  have hgain_rewrite :
      (P.L + P.gamma⁻¹) *
          (2 * P.C_N * P.L * (P.D : ℝ) * P.gamma ^ (2 : ℕ)) =
        2 * (P.gamma * P.L * (P.D : ℝ) * P.C_N) *
          (1 + P.gamma * P.L) := by
    field_simp [ne_of_gt hgamma_pos]
    ring
  have hscale :
      2 * (P.gamma * P.L * (P.D : ℝ) * P.C_N) *
          (1 + P.gamma * P.L) ≤ (1 / 4 : ℝ) := by
    have hfactor : 1 + P.gamma * P.L ≤ (5 / 4 : ℝ) := by nlinarith
    have hbase_nonneg : 0 ≤ P.gamma * P.L * (P.D : ℝ) * P.C_N := by
      positivity
    have hfactor_nonneg : 0 ≤ 1 + P.gamma * P.L := by positivity
    have hmul := mul_le_mul hgammaLDFull hfactor hfactor_nonneg (by norm_num)
    nlinarith
  rwa [hgain_rewrite]

private theorem A_1_nonneg_of_theoremStepsizeCondition
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) :
    0 ≤ P.A_1 := by
  have hL_nonneg : 0 ≤ P.L :=
    le_of_lt (L_pos_of_theoremStepsizeCondition P hstepsize)
  have hgamma_nonneg : 0 ≤ P.gamma := le_of_lt hstepsize.1
  have hCN_nonneg : 0 ≤ P.C_N := le_of_lt (C_N_pos P)
  have hApre_nonneg : 0 ≤ P.A_pre := by
    unfold Setup.A_pre
    exact Finset.sum_nonneg (fun k _hk => roundDisplacement_nonneg P k)
  have hA0_nonneg : 0 ≤ P.A_0 := by
    unfold Setup.A_0
    exact mul_nonneg (Real.sqrt_nonneg _) (Delta_nonneg P P.K0)
  have hH0_nonneg : 0 ≤ P.H_0 := by
    unfold Setup.H_0
    positivity
  have hB0_nonneg : 0 ≤ P.B_0 := by
    unfold Setup.B_0
    positivity
  unfold Setup.A_1
  positivity

private theorem post_prefix_gradient_energy_bound
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) {T : ℕ}
    (hT : P.K0 ≤ T) :
    Setup.finiteHorizonL2Norm
        (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 T ^ (2 : ℕ) ≤
      4 * (P.aggregateObjective (xBar P P.K0) - P.fStar) / P.gamma +
        16 * (P.L + P.gamma⁻¹) ^ (2 : ℕ) * P.A_1 ^ (2 : ℕ) := by
  classical
  let G : ℝ :=
    Setup.finiteHorizonL2Norm
      (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 T
  let Dnorm : ℝ := Setup.finiteHorizonL2Norm (Delta P) P.K0 T
  let c : ℝ := (P.L + P.gamma⁻¹) ^ (2 : ℕ)
  let q : ℝ := 2 * P.C_N * P.L * (P.D : ℝ) * P.gamma ^ (2 : ℕ)
  have hgamma_pos : 0 < P.gamma := hstepsize.1
  have hgamma_nonneg : 0 ≤ P.gamma := le_of_lt hgamma_pos
  have hL_nonneg : 0 ≤ P.L :=
    le_of_lt (L_pos_of_theoremStepsizeCondition P hstepsize)
  have hD_nonneg : 0 ≤ (P.D : ℝ) := le_of_lt (D_pos_real P)
  have hCN_nonneg : 0 ≤ P.C_N := le_of_lt (C_N_pos P)
  have hinv_nonneg : 0 ≤ P.gamma⁻¹ := inv_nonneg.mpr hgamma_nonneg
  have hc_nonneg : 0 ≤ c := by
    unfold c
    positivity
  have hq_nonneg : 0 ≤ q := by
    unfold q
    positivity
  have hG_nonneg : 0 ≤ G := by
    unfold G Setup.finiteHorizonL2Norm
    positivity
  have hDnorm_nonneg : 0 ≤ Dnorm := by
    unfold Dnorm Setup.finiteHorizonL2Norm
    positivity
  have hA1_nonneg : 0 ≤ P.A_1 :=
    A_1_nonneg_of_theoremStepsizeCondition P hstepsize
  have hterminal :
      (P.gamma / 2) * G ^ (2 : ℕ) ≤
        P.aggregateObjective (xBar P P.K0) -
            P.aggregateObjective (xBar P T) +
          2 * P.gamma * c * Dnorm ^ (2 : ℕ) := by
    simpa [G, Dnorm, c] using
      (drifted_descent_sum_terminal_bound P hstepsize (T := T) hT)
  have htail_lower :
      P.fStar ≤ P.aggregateObjective (xBar P T) :=
    P.fStar_le_aggregateObjective (xBar P T)
  have hpre :
      (P.gamma / 2) * G ^ (2 : ℕ) ≤
        P.aggregateObjective (xBar P P.K0) - P.fStar +
          2 * P.gamma * c * Dnorm ^ (2 : ℕ) := by
    nlinarith
  have hsmall :
      Dnorm ≤ P.A_1 + q * G := by
    have h := (finite_horizon_snapshot_disagreement_small_gain
      P hstepsize (T := T) hT).2
    simpa [Dnorm, G, q, mul_assoc] using h
  have hqG_nonneg : 0 ≤ q * G := mul_nonneg hq_nonneg hG_nonneg
  have hD_sq :
      Dnorm ^ (2 : ℕ) ≤
        2 * P.A_1 ^ (2 : ℕ) + 2 * (q * G) ^ (2 : ℕ) :=
    square_le_two_sq_add_two_sq_of_nonneg_le_add
      hDnorm_nonneg hA1_nonneg hqG_nonneg hsmall
  have hD_scaled :
      2 * P.gamma * c * Dnorm ^ (2 : ℕ) ≤
        2 * P.gamma * c *
          (2 * P.A_1 ^ (2 : ℕ) + 2 * (q * G) ^ (2 : ℕ)) := by
    have hcoef_nonneg : 0 ≤ 2 * P.gamma * c := by positivity
    exact mul_le_mul_of_nonneg_left hD_sq hcoef_nonneg
  have hpre_absorb :
      (P.gamma / 2) * G ^ (2 : ℕ) ≤
        P.aggregateObjective (xBar P P.K0) - P.fStar +
          4 * P.gamma * c * P.A_1 ^ (2 : ℕ) +
            4 * P.gamma * c * q ^ (2 : ℕ) * G ^ (2 : ℕ) := by
    nlinarith
  have hgain :
      (P.L + P.gamma⁻¹) * q ≤ (1 / 4 : ℝ) := by
    simpa [q] using theorem_feedback_gain_le_quarter P hstepsize
  have hcoef_nonneg : 0 ≤ P.L + P.gamma⁻¹ := add_nonneg hL_nonneg hinv_nonneg
  have hprod_nonneg : 0 ≤ (P.L + P.gamma⁻¹) * q :=
    mul_nonneg hcoef_nonneg hq_nonneg
  have hprod_sq :
      ((P.L + P.gamma⁻¹) * q) ^ (2 : ℕ) ≤ (1 / 4 : ℝ) ^ (2 : ℕ) := by
    nlinarith [hgain, hprod_nonneg]
  have hfeedback_coeff :
      4 * P.gamma * c * q ^ (2 : ℕ) ≤ P.gamma / 4 := by
    calc
      4 * P.gamma * c * q ^ (2 : ℕ)
          = 4 * P.gamma * ((P.L + P.gamma⁻¹) * q) ^ (2 : ℕ) := by
            unfold c
            ring
      _ ≤ 4 * P.gamma * (1 / 4 : ℝ) ^ (2 : ℕ) := by
            exact mul_le_mul_of_nonneg_left hprod_sq (by positivity)
      _ = P.gamma / 4 := by
            ring
  have hfeedback_term :
      4 * P.gamma * c * q ^ (2 : ℕ) * G ^ (2 : ℕ) ≤
        (P.gamma / 4) * G ^ (2 : ℕ) := by
    exact mul_le_mul_of_nonneg_right hfeedback_coeff (sq_nonneg G)
  have habsorbed :
      (P.gamma / 4) * G ^ (2 : ℕ) ≤
        P.aggregateObjective (xBar P P.K0) - P.fStar +
          4 * P.gamma * c * P.A_1 ^ (2 : ℕ) := by
    nlinarith [hpre_absorb, hfeedback_term]
  have hscale_nonneg : 0 ≤ 4 / P.gamma := by positivity
  have hscaled := mul_le_mul_of_nonneg_left habsorbed hscale_nonneg
  calc
    Setup.finiteHorizonL2Norm
        (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 T ^ (2 : ℕ)
        = (4 / P.gamma) * ((P.gamma / 4) * G ^ (2 : ℕ)) := by
          unfold G
          field_simp [ne_of_gt hgamma_pos]
    _ ≤ (4 / P.gamma) *
        (P.aggregateObjective (xBar P P.K0) - P.fStar +
          4 * P.gamma * c * P.A_1 ^ (2 : ℕ)) := hscaled
    _ =
      4 * (P.aggregateObjective (xBar P P.K0) - P.fStar) / P.gamma +
        16 * (P.L + P.gamma⁻¹) ^ (2 : ℕ) * P.A_1 ^ (2 : ℕ) := by
        unfold c
        field_simp [ne_of_gt hgamma_pos]
        ring

private theorem main_rate_bound_from_post_prefix_gradient_energy
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (T : ℕ)
    (hT : 1 ≤ T) :
    ((1 : ℝ) / (T : ℝ)) *
        (∑ k ∈ Finset.range T, ‖P.aggregateGradient (xBar P k)‖ ^ (2 : ℕ)) ≤
      P.C_RC / (T : ℝ) := by
  classical
  have hT_pos_real : 0 < (T : ℝ) := by exact_mod_cast hT
  have hscale_nonneg : 0 ≤ (1 : ℝ) / (T : ℝ) := by positivity
  have hgap_nonneg :
      0 ≤ P.aggregateObjective (xBar P P.K0) - P.fStar := by
    have h := P.fStar_le_aggregateObjective (xBar P P.K0)
    nlinarith
  have hgamma_pos : 0 < P.gamma := hstepsize.1
  have hgamma_nonneg : 0 ≤ P.gamma := le_of_lt hgamma_pos
  have hL_nonneg : 0 ≤ P.L :=
    le_of_lt (L_pos_of_theoremStepsizeCondition P hstepsize)
  have hinv_nonneg : 0 ≤ P.gamma⁻¹ := inv_nonneg.mpr hgamma_nonneg
  have htail_nonneg :
      0 ≤ 4 * (P.aggregateObjective (xBar P P.K0) - P.fStar) / P.gamma +
        16 * (P.L + P.gamma⁻¹) ^ (2 : ℕ) * P.A_1 ^ (2 : ℕ) := by
    have hc_nonneg : 0 ≤ (P.L + P.gamma⁻¹) ^ (2 : ℕ) := sq_nonneg _
    have hA1_sq_nonneg : 0 ≤ P.A_1 ^ (2 : ℕ) := sq_nonneg _
    positivity
  have hC_pre_nonneg : 0 ≤ P.C_pre := by
    unfold Setup.C_pre
    exact Finset.sum_nonneg
      (fun k _hk => sq_nonneg (‖P.aggregateGradient (xBar P k)‖))
  have hC_RC_ge_C_pre : P.C_pre ≤ P.C_RC := by
    unfold Setup.C_RC
    nlinarith [htail_nonneg]
  have hsum_le_C :
      (∑ k ∈ Finset.range T, ‖P.aggregateGradient (xBar P k)‖ ^ (2 : ℕ)) ≤
        P.C_RC := by
    by_cases hKT : P.K0 ≤ T
    · have hpost := post_prefix_gradient_energy_bound P hstepsize (T := T) hKT
      have hpost_sum :
          (∑ k ∈ Finset.Ico P.K0 T,
              ‖P.aggregateGradient (xBar P k)‖ ^ (2 : ℕ)) ≤
            4 * (P.aggregateObjective (xBar P P.K0) - P.fStar) / P.gamma +
              16 * (P.L + P.gamma⁻¹) ^ (2 : ℕ) * P.A_1 ^ (2 : ℕ) := by
        simpa [finiteHorizonL2Norm_sq_eq_sum] using hpost
      have hsplit :
          (∑ k ∈ Finset.range T,
              ‖P.aggregateGradient (xBar P k)‖ ^ (2 : ℕ)) =
            P.C_pre +
              ∑ k ∈ Finset.Ico P.K0 T,
                ‖P.aggregateGradient (xBar P k)‖ ^ (2 : ℕ) := by
        rw [← Finset.sum_range_add_sum_Ico
          (fun k => ‖P.aggregateGradient (xBar P k)‖ ^ (2 : ℕ)) hKT]
        unfold Setup.C_pre
        rfl
      calc
        (∑ k ∈ Finset.range T,
            ‖P.aggregateGradient (xBar P k)‖ ^ (2 : ℕ))
            = P.C_pre +
              ∑ k ∈ Finset.Ico P.K0 T,
                ‖P.aggregateGradient (xBar P k)‖ ^ (2 : ℕ) := hsplit
        _ ≤ P.C_pre +
            (4 * (P.aggregateObjective (xBar P P.K0) - P.fStar) / P.gamma +
              16 * (P.L + P.gamma⁻¹) ^ (2 : ℕ) * P.A_1 ^ (2 : ℕ)) := by
              exact add_le_add le_rfl hpost_sum
        _ = P.C_RC := by
              unfold Setup.C_RC
              ring
    · have hT_le_K0 : T ≤ P.K0 := by omega
      have hsubset : Finset.range T ⊆ Finset.range P.K0 := by
        intro k hk
        rw [Finset.mem_range] at hk ⊢
        omega
      have hprefix :
          (∑ k ∈ Finset.range T,
              ‖P.aggregateGradient (xBar P k)‖ ^ (2 : ℕ)) ≤ P.C_pre := by
        unfold Setup.C_pre
        exact Finset.sum_le_sum_of_subset_of_nonneg hsubset
          (by
            intro k _hkK hknT
            exact sq_nonneg (‖P.aggregateGradient (xBar P k)‖))
      exact le_trans hprefix hC_RC_ge_C_pre
  have hscaled := mul_le_mul_of_nonneg_left hsum_le_C hscale_nonneg
  calc
    ((1 : ℝ) / (T : ℝ)) *
        (∑ k ∈ Finset.range T, ‖P.aggregateGradient (xBar P k)‖ ^ (2 : ℕ))
        ≤ ((1 : ℝ) / (T : ℝ)) * P.C_RC := hscaled
    _ = P.C_RC / (T : ℝ) := by ring

private theorem delta_square_partial_sum_uniform_bound
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) :
    ∃ Cδ : ℝ, ∀ N : ℕ,
      (∑ k ∈ Finset.range N, Delta P k ^ (2 : ℕ)) ≤ Cδ := by
  classical
  let c : ℝ := (P.L + P.gamma⁻¹) ^ (2 : ℕ)
  let q : ℝ := 2 * P.C_N * P.L * (P.D : ℝ) * P.gamma ^ (2 : ℕ)
  let Bpost : ℝ :=
    4 * (P.aggregateObjective (xBar P P.K0) - P.fStar) / P.gamma +
      16 * c * P.A_1 ^ (2 : ℕ)
  let Cδ : ℝ :=
    (∑ k ∈ Finset.range P.K0, Delta P k ^ (2 : ℕ)) +
      (2 * P.A_1 ^ (2 : ℕ) + 2 * q ^ (2 : ℕ) * Bpost)
  refine ⟨Cδ, ?_⟩
  intro N
  have hgamma_nonneg : 0 ≤ P.gamma := le_of_lt hstepsize.1
  have hL_nonneg : 0 ≤ P.L :=
    le_of_lt (L_pos_of_theoremStepsizeCondition P hstepsize)
  have hD_nonneg : 0 ≤ (P.D : ℝ) := le_of_lt (D_pos_real P)
  have hCN_nonneg : 0 ≤ P.C_N := le_of_lt (C_N_pos P)
  have hq_nonneg : 0 ≤ q := by
    unfold q
    positivity
  have hA1_nonneg : 0 ≤ P.A_1 :=
    A_1_nonneg_of_theoremStepsizeCondition P hstepsize
  by_cases hKN : P.K0 ≤ N
  · let G : ℝ :=
      Setup.finiteHorizonL2Norm
        (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 N
    let Dnorm : ℝ := Setup.finiteHorizonL2Norm (Delta P) P.K0 N
    have hG_nonneg : 0 ≤ G := by
      unfold G Setup.finiteHorizonL2Norm
      positivity
    have hDnorm_nonneg : 0 ≤ Dnorm := by
      unfold Dnorm Setup.finiteHorizonL2Norm
      positivity
    have hsmall :
        Dnorm ≤ P.A_1 + q * G := by
      have h := (finite_horizon_snapshot_disagreement_small_gain
        P hstepsize (T := N) hKN).2
      simpa [Dnorm, G, q, mul_assoc] using h
    have hqG_nonneg : 0 ≤ q * G := mul_nonneg hq_nonneg hG_nonneg
    have hD_sq :
        Dnorm ^ (2 : ℕ) ≤
          2 * P.A_1 ^ (2 : ℕ) + 2 * (q * G) ^ (2 : ℕ) :=
      square_le_two_sq_add_two_sq_of_nonneg_le_add
        hDnorm_nonneg hA1_nonneg hqG_nonneg hsmall
    have hG_bound : G ^ (2 : ℕ) ≤ Bpost := by
      have h := post_prefix_gradient_energy_bound P hstepsize (T := N) hKN
      simpa [G, Bpost, c] using h
    have hqG_sq_bound :
        (q * G) ^ (2 : ℕ) ≤ q ^ (2 : ℕ) * Bpost := by
      have hmul := mul_le_mul_of_nonneg_left hG_bound (sq_nonneg q)
      calc
        (q * G) ^ (2 : ℕ) = q ^ (2 : ℕ) * G ^ (2 : ℕ) := by ring
        _ ≤ q ^ (2 : ℕ) * Bpost := hmul
    have hpost_delta :
        (∑ k ∈ Finset.Ico P.K0 N, Delta P k ^ (2 : ℕ)) ≤
          2 * P.A_1 ^ (2 : ℕ) + 2 * q ^ (2 : ℕ) * Bpost := by
      calc
        (∑ k ∈ Finset.Ico P.K0 N, Delta P k ^ (2 : ℕ))
            = Dnorm ^ (2 : ℕ) := by
              rw [finiteHorizonL2Norm_sq_eq_sum]
        _ ≤ 2 * P.A_1 ^ (2 : ℕ) + 2 * (q * G) ^ (2 : ℕ) := hD_sq
        _ ≤ 2 * P.A_1 ^ (2 : ℕ) + 2 * (q ^ (2 : ℕ) * Bpost) := by
              have hcoef : 0 ≤ (2 : ℝ) := by norm_num
              exact add_le_add le_rfl
                (mul_le_mul_of_nonneg_left hqG_sq_bound hcoef)
        _ = 2 * P.A_1 ^ (2 : ℕ) + 2 * q ^ (2 : ℕ) * Bpost := by ring
    have hsplit :
        (∑ k ∈ Finset.range N, Delta P k ^ (2 : ℕ)) =
          (∑ k ∈ Finset.range P.K0, Delta P k ^ (2 : ℕ)) +
            ∑ k ∈ Finset.Ico P.K0 N, Delta P k ^ (2 : ℕ) := by
      rw [← Finset.sum_range_add_sum_Ico
        (fun k => Delta P k ^ (2 : ℕ)) hKN]
    calc
      (∑ k ∈ Finset.range N, Delta P k ^ (2 : ℕ))
          =
        (∑ k ∈ Finset.range P.K0, Delta P k ^ (2 : ℕ)) +
          ∑ k ∈ Finset.Ico P.K0 N, Delta P k ^ (2 : ℕ) := hsplit
      _ ≤
        (∑ k ∈ Finset.range P.K0, Delta P k ^ (2 : ℕ)) +
          (2 * P.A_1 ^ (2 : ℕ) + 2 * q ^ (2 : ℕ) * Bpost) := by
          exact add_le_add le_rfl hpost_delta
      _ = Cδ := by
          unfold Cδ
          rfl
  · have hN_le_K0 : N ≤ P.K0 := by omega
    have hsubset : Finset.range N ⊆ Finset.range P.K0 := by
      intro k hk
      rw [Finset.mem_range] at hk ⊢
      omega
    have hprefix :
        (∑ k ∈ Finset.range N, Delta P k ^ (2 : ℕ)) ≤
          ∑ k ∈ Finset.range P.K0, Delta P k ^ (2 : ℕ) := by
      exact Finset.sum_le_sum_of_subset_of_nonneg hsubset
        (by
          intro k _hkK hknN
          exact sq_nonneg (Delta P k))
    have htail_nonneg :
        0 ≤ 2 * P.A_1 ^ (2 : ℕ) + 2 * q ^ (2 : ℕ) * Bpost := by
      have hK_post := post_prefix_gradient_energy_bound
        P hstepsize (T := P.K0) le_rfl
      have hBpost_nonneg : 0 ≤ Bpost := by
        have hzero :
            (0 : ℝ) ≤
              Setup.finiteHorizonL2Norm
                (fun k => ‖P.aggregateGradient (xBar P k)‖) P.K0 P.K0 ^ (2 : ℕ) :=
          sq_nonneg _
        simpa [Bpost, c] using le_trans hzero hK_post
      positivity
    calc
      (∑ k ∈ Finset.range N, Delta P k ^ (2 : ℕ))
          ≤ ∑ k ∈ Finset.range P.K0, Delta P k ^ (2 : ℕ) := hprefix
      _ ≤ Cδ := by
          unfold Cδ
          nlinarith

private theorem delta_square_summable_of_post_prefix_bounds
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) :
    Summable (fun k : ℕ => Delta P k ^ (2 : ℕ)) := by
  rcases delta_square_partial_sum_uniform_bound P hstepsize with ⟨Cδ, hCδ⟩
  exact summable_of_sum_range_le
    (fun k => sq_nonneg (Delta P k)) hCδ

private theorem delta_tendsto_zero_of_square_summable
    (P : Setup)
    (hsum : Summable (fun k : ℕ => Delta P k ^ (2 : ℕ))) :
    Filter.Tendsto (fun k : ℕ => Delta P k) Filter.atTop (nhds 0) := by
  have hsquare_zero :
      Filter.Tendsto (fun k : ℕ => Delta P k ^ (2 : ℕ))
        Filter.atTop (nhds 0) :=
    hsum.tendsto_atTop_zero
  have hsqrt_zero :
      Filter.Tendsto (fun k : ℕ => Real.sqrt (Delta P k ^ (2 : ℕ)))
        Filter.atTop (nhds 0) := by
    simpa using
      (Real.continuous_sqrt.continuousAt.tendsto.comp hsquare_zero)
  have hsqrt_eq :
      (fun k : ℕ => Real.sqrt (Delta P k ^ (2 : ℕ))) =
        fun k : ℕ => Delta P k := by
    funext k
    exact Real.sqrt_sq (Delta_nonneg P k)
  simpa [hsqrt_eq] using hsqrt_zero

/-- Theorem 4.2, deterministic single-loop nonconvex convergence, with the
paper constants (4.1)--(4.3), (4.8) and the stepsize condition (4.6).

Source: `book/RCDGD/RCDGD.json#/main_theorem/statement_math`.
Quote: "在假设 2.1--2.2 下，若 ... (4.6) ... 则对任意允许的拓扑序列和任意
T\ge 1，算法 1 满足 ... (4.7) ... 此外， ... (4.9)."
-/
theorem theorem_4_2_deterministic_single_loop_nonconvex_convergence
    (P : Setup) (hstepsize : P.theoremStepsizeCondition) (T : ℕ) (hT : 1 ≤ T) :
    ((1 : ℝ) / (T : ℝ)) *
        (∑ k ∈ Finset.range T, ‖P.aggregateGradient (xBar P k)‖ ^ (2 : ℕ)) ≤
          P.C_RC / (T : ℝ) ∧
      Summable (fun k : ℕ => Delta P k ^ (2 : ℕ)) ∧
        Filter.Tendsto (fun k : ℕ => Delta P k) Filter.atTop (nhds 0) := by
  refine ⟨main_rate_bound_from_post_prefix_gradient_energy P hstepsize T hT, ?_⟩
  have hsum : Summable (fun k : ℕ => Delta P k ^ (2 : ℕ)) :=
    delta_square_summable_of_post_prefix_bounds P hstepsize
  exact ⟨hsum, delta_tendsto_zero_of_square_summable P hsum⟩

