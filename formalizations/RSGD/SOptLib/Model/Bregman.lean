    {X : Set E} {f : {x : E // x ∈ X} → ℝ}
    {x y : {x : E // x ∈ X}} {g : E} {L C : ℝ}
    (hL_nonneg : 0 ≤ L)
    (hg : g ∈ carrierSubdifferential f x)
    (hmix_mem : ∀ ⦃a b : ℝ⦄,
      0 ≤ a → 0 ≤ b → a + b = 1 → a • x.1 + b • y.1 ∈ X)
    (hstrong : ∀ ⦃a b : ℝ⦄, (ha : 0 ≤ a) → (hb : 0 ≤ b) → (hab : a + b = 1) →
      C / 2 * a * b * ‖x.1 - y.1‖ ^ 2 ≤
        L * (a * f x + b * f y -
          f ⟨a • x.1 + b • y.1, hmix_mem ha hb hab⟩)) :
