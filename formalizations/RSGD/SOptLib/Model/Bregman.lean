    intro s hspos hsle
    have hsnonneg : 0 ≤ s := le_of_lt hspos
    have hone_minus_nonneg : 0 ≤ 1 - s := sub_nonneg.mpr hsle
    let mix : {x : E // x ∈ X} :=
      ⟨(1 - s) • x.1 + s • y.1,
        hmix_mem hone_minus_nonneg hsnonneg (by ring)⟩
    have hStrong :
        C / 2 * (1 - s) * s * ‖x.1 - y.1‖ ^ 2 ≤
          L * ((1 - s) * f x + s * f y - f mix) := by
      simpa [mix] using
        hstrong (a := 1 - s) (b := s) hone_minus_nonneg hsnonneg (by ring)
    have hStrongA :
        A * (1 - s) * s ≤
          L * ((1 - s) * f x + s * f y - f mix) := by
      dsimp [A]
      nlinarith [hStrong]
    have hmix_sub : mix.1 - x.1 = s • (y.1 - x.1) := by
      dsimp [mix]
      module
    have hgap_upper :
        (1 - s) * f x + s * f y - f mix ≤
          s * _root_.carrierBregmanDivergence f (fun _ => g) x y :=
      selectedCarrierBregman_secant_gap_le_smul
        (f := f) (x := x) (y := y) (mix := mix) (g := g) (s := s) hg hmix_sub
    have hscaled_upper :
        L * ((1 - s) * f x + s * f y - f mix) ≤
          L * (s * _root_.carrierBregmanDivergence f (fun _ => g) x y) :=
      mul_le_mul_of_nonneg_left hgap_upper hL_nonneg
    have hprod : A * (1 - s) * s ≤ s * B := by
      calc
        A * (1 - s) * s ≤
            L * ((1 - s) * f x + s * f y - f mix) := hStrongA
