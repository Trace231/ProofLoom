      nlinarith [hB_nonneg]
    have hs_bound := hkey s hspos hsle
    have hs_eq : A * (1 - s) = (A + B) / 2 := by
      dsimp [s]
      field_simp [hA_pos.ne']
      ring
    nlinarith [hs_bound, hs_eq]
  simpa [A, B] using hlimit

