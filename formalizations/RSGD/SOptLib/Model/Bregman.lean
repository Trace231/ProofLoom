/-- Convexity gives nonnegativity of the canonical ambient Bregman divergence at a
point where the Mathlib gradient realizes the supporting hyperplane.
Layer: Model | Gap: Level 2 (Bregman nonnegativity)
Proof: Restrict `v` to the segment from `x` to `z`, compare the derivative at `0`
  with the secant slope for a convex one-dimensional restriction, and expand.
Source: Lan, First-order and Stochastic Optimization Methods for Machine Learning,
  Proposition 3.1 / Bregman divergence nonnegativity.
Used in: `V_nonneg`, stochastic mirror descent Bregman geometry
Book citation: `book/FOML/StochasticMirrorDescent.json#/assumptions/5/math`
Origin algorithm: FOML stochastic mirror descent -/
theorem bregmanDivergence_nonneg_of_convexOn
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {X : Set E} {v : E → ℝ} {x z : E}
    (hv : ConvexOn ℝ X v)
    (hx : x ∈ X) (hz : z ∈ X)
    (hgrad : HasGradientAt v (∇ v x) x) :
    0 ≤ bregmanDivergence v x z := by
  unfold bregmanDivergence
  have hsupport : v x + ⟪∇ v x, z - x⟫_ℝ ≤ v z := by
    set g : ℝ → ℝ := fun t => v (AffineMap.lineMap x z t)
    have hline_mem : Set.Icc (0 : ℝ) 1 ⊆ (AffineMap.lineMap x z) ⁻¹' X := by
      intro t ht
      have ht0 : 0 ≤ t := ht.1
      have ht1 : t ≤ 1 := ht.2
      have h1t : 0 ≤ 1 - t := sub_nonneg.mpr ht1
      have hsum : 1 - t + t = 1 := by ring
      have hmem : (1 - t) • x + t • z ∈ X := hv.1 hx hz h1t ht0 hsum
      change AffineMap.lineMap x z t ∈ X
      rw [AffineMap.lineMap_apply_module']
      convert hmem using 1
      module
    have hg_conv : ConvexOn ℝ (Set.Icc (0 : ℝ) 1) g := by
      simpa [g] using
        (hv.comp_affineMap (AffineMap.lineMap x z)).subset hline_mem (convex_Icc 0 1)
    have hg_deriv : HasDerivAt g (⟪∇ v x, z - x⟫_ℝ) 0 := by
      have hg_eq_line : g = fun t : ℝ => v (x + t • (z - x)) := by
        ext t
        simp only [g, AffineMap.lineMap_apply_module']
        congr 1
        module
      rw [hg_eq_line]
      have hfderiv : HasFDerivAt v (InnerProductSpace.toDual ℝ E (∇ v x))
          (x + (0 : ℝ) • (z - x)) := by
        simpa using hgrad.hasFDerivAt
      have hline : HasDerivAt (fun t : ℝ => x + t • (z - x)) ((1 : ℝ) • (z - x)) 0 := by
        exact (hasDerivAt_id 0).smul_const (z - x) |>.const_add x
      have hcomp := hfderiv.comp_hasDerivAt 0 (hline.congr_deriv (one_smul ℝ (z - x)))
      simpa [Function.comp_def, InnerProductSpace.toDual_apply_apply] using hcomp
    have hslope := hg_conv.le_slope_of_hasDerivAt (by norm_num) (by norm_num) zero_lt_one hg_deriv
    simp [g, slope_def_field, AffineMap.lineMap_apply_module'] at hslope
    linarith
  linarith

/-- Strong convexity implies nonnegativity of the canonical ambient Bregman divergence.
Layer: Model | Gap: Level 1 (Bregman nonnegativity)
Proof: Forget the strong-convexity modulus to convexity, then apply the convex
  supporting-hyperplane form.
Source: Lan, First-order and Stochastic Optimization Methods for Machine Learning,
  Proposition 3.1 / Bregman divergence nonnegativity.
Used in: `V_nonneg`, stochastic mirror descent Bregman geometry
Book citation: `book/FOML/StochasticMirrorDescent.json#/assumptions/5/math`
Origin algorithm: FOML stochastic mirror descent -/
theorem bregmanDivergence_nonneg_of_strongConvexOn
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {X : Set E} {v : E → ℝ} {x z : E}
    (hv : StrongConvexOn X 1 v)
    (hx : x ∈ X) (hz : z ∈ X)
    (hgrad : HasGradientAt v (∇ v x) x) :
    0 ≤ bregmanDivergence v x z := by
  have hconv : ConvexOn ℝ X v := by
    have hv0 : StrongConvexOn X 0 v := hv.mono (by norm_num : (0 : ℝ) ≤ 1)
    simpa using hv0
  exact bregmanDivergence_nonneg_of_convexOn hconv hx hz hgrad

/-- Symmetric half-squared-distance Bregman lower bounds give a squared-distance bound.

If each directed Bregman term lower-bounds one half of the squared norm distance,
then their two-direction sum lower-bounds the full squared norm distance.

Layer: Model | Gap: Level 0 (symmetric Bregman lower bound)
Proof: rewrite the reversed norm with `norm_sub_rev`, transfer the second
  half-bound to the same squared distance, and combine the two real inequalities
  by linear arithmetic.
Source: Mathlib normed additive groups and real linear arithmetic APIs
Used in: stochastic mirror descent conversion from symmetric Bregman control to
  squared-distance control under strong convexity
Book citation: book/FOML/StochasticMirrorDescent.json#/algorithm_spec
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for
  Machine Learning, stochastic mirror descent -/
theorem sq_norm_le_bregman_add_swap_of_half_lower_bound
    {P : Type*} {E : Type*} [NormedAddCommGroup E]
    (V : P → P → ℝ) (eval : P → E) (x y : P)
    (hxy : (1 / 2 : ℝ) * ‖eval x - eval y‖ ^ 2 ≤ V x y)
    (hyx : (1 / 2 : ℝ) * ‖eval y - eval x‖ ^ 2 ≤ V y x) :
    ‖eval x - eval y‖ ^ 2 ≤ V x y + V y x := by
  have hnorm : ‖eval y - eval x‖ = ‖eval x - eval y‖ := by
    simpa using norm_sub_rev (eval y) (eval x)
  have hyx' : (1 / 2 : ℝ) * ‖eval x - eval y‖ ^ 2 ≤ V y x := by
    simpa [hnorm] using hyx
  linarith

/-- A continuous real-valued function nonnegative on a dense set is nonnegative everywhere.

Layer: Model | Gap: Level 1 (dense-to-global nonnegativity transfer)
Proof: push the `MapsTo` nonnegativity statement through closure using
  `Set.MapsTo.closure_of_continuousOn`; density puts every point in `closure s`,
  and closedness of `Set.Ici 0` in `ℝ` removes the codomain closure.
Source: Mathlib dense-set closure and closed-order topology APIs
Used in: Bregman divergence nonnegativity on the full feasible carrier from a
  dense model domain
Book citation: book/FOML/StochasticMirrorDescent.json#/algorithm_spec
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for
  Machine Learning, stochastic mirror descent -/
private theorem nonneg_of_continuousOn_of_dense_nonneg_for_model
    {α : Type*} [TopologicalSpace α]
    (D : α → ℝ) (s : Set α)
    (hcont : ContinuousOn D Set.univ)
    (hdense : Dense s)
    (hnonneg : Set.MapsTo D s (Set.Ici (0 : ℝ)))
    (a : α) :
    0 ≤ D a := by
  have hall :
      Set.MapsTo D (closure s) (closure (Set.Ici (0 : ℝ))) :=
    hnonneg.closure_of_continuousOn (by
      exact hcont.mono (by intro y hy; simp))
  have ha : a ∈ closure s := by
    rw [Dense.closure_eq hdense]
    simp
  have h := hall ha
  have hIci_closed : closure (Set.Ici (0 : ℝ)) = Set.Ici 0 := isClosed_Ici.closure_eq
  rw [hIci_closed] at h
  exact h

