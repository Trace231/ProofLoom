  have hDYden_nonneg : 0 ≤ 2 * DY ^ 2 := by positivity
  have hscaled :
      ((1 / 2 : ℝ) * pX ((WithLp.ofLp y).fst - (WithLp.ofLp z).fst) ^ 2) /
            (2 * DX ^ 2) +
          ((1 / 2 : ℝ) * pY ((WithLp.ofLp y).snd - (WithLp.ofLp z).snd) ^ 2) /
            (2 * DY ^ 2) ≤ prox := by
