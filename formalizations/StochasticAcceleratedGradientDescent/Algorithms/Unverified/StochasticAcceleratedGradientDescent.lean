private theorem _voucher_step_acsa_prop42_displacement_absorption_35
    (t : {n : ℕ // 1 ≤ n})
    {γ Ares₀ Cres₀ K coeff gradB linB linC Nlin Ad Dd Cd : ℝ}
    {prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X}
    {z xUnder g η xPlus : E} {p : E → ℝ}
    (hgamma_pos : 0 < γ)
    (hden_pos : 0 < 1 + setup.mu * γ - setup.L * setup.alpha t.1 * γ)
    (hAres₀_nonneg : 0 ≤ Ares₀)
    (hCres₀_nonneg : 0 ≤ Cres₀)
    (hK_nonneg : 0 ≤ K)
    (hcoeff_def :
      coeff =
        4 + Ares₀ + Cres₀ + ‖setup.gradF setup.xStar‖ +
          setup.L + setup.M + setup.mu + K + 1 +
          γ * (setup.L + setup.M + setup.mu + K + 1))
    (hgradB_def : gradB = coeff ^ 2 + 1)
    (hlinB_def : linB = 2 * gradB)
    (hlinC_def : linC = 2 * coeff ^ 2 + 2 * K ^ 2)
    (hNlin_nonneg : 0 ≤ Nlin)
    (hAd_def : Ad = 8 * Ares₀ + 8 * γ * linB)
    (hDd_def : Dd = 8 * (γ ^ 2 / (1 + setup.mu * γ) + γ * Nlin) + 1)
    (hCd_def : Cd = 8 * Cres₀ + 8 * γ * linC)
    (hh_lip_on_X :
      ∀ x, x ∈ setup.X → ∀ y, y ∈ setup.X →
        |setup.h x - setup.h y| ≤ K * ‖x - y‖)
    (hmin_xStar :
      setup.proxObjective t prev.x xUnder g z ≤
        setup.proxObjective t prev.x xUnder g setup.xStar)
    (hlemma35 :
      p z + (γ * setup.mu) * setup.V xUnder z +
          (1 : ℝ) * setup.V prev.x z ≤
        p setup.xStar + (γ * setup.mu) * setup.V xUnder setup.xStar +
          (1 : ℝ) * setup.V prev.x setup.xStar -
            ((γ * setup.mu) + (1 : ℝ)) * setup.V z setup.xStar)
    (hweighted_absorb :
      ((1 + setup.mu * γ) / (2 * γ)) * ‖z - xPlus‖ ^ 2 ≤
        (1 / γ) * setup.V prev.x z +
          setup.mu * setup.V xUnder z)
    (hDeltaSquare_local :
      setup.alpha t.1 *
          (setup.M * ‖z - xPlus‖ - ⟪η, z - xPlus⟫_ℝ -
            (1 + setup.mu * γ - setup.L * setup.alpha t.1 * γ) /
              (2 * γ) * ‖z - xPlus‖ ^ 2) ≤
        setup.alpha t.1 * γ *
          (setup.M + SOptLib.dualNorm η) ^ 2 /
            (2 * (1 + setup.mu * γ - setup.L * setup.alpha t.1 * γ)))
    (hresidual :
      setup.V prev.x xPlus + γ * setup.mu * setup.V xUnder xPlus ≤
        Ares₀ * (‖setup.xStar - prev.x‖ ^ 2 + ‖setup.xStar - xUnder‖ ^ 2) +
          Cres₀)
    (hsource_budget :
      ((1 + setup.mu * γ) / 4) * ‖z - xPlus‖ ^ 2 ≤
        Ares₀ * (‖setup.xStar - prev.x‖ ^ 2 + ‖setup.xStar - xUnder‖ ^ 2) +
          Cres₀ + γ * (linB *
            (‖setup.xStar - prev.x‖ ^ 2 + ‖setup.xStar - xUnder‖ ^ 2) +
              linC) +
          (γ ^ 2 / (1 + setup.mu * γ) + γ * Nlin) * ‖η‖ ^ 2) :
    ‖z - xPlus‖ ^ 2 ≤
      Ad * (‖setup.xStar - prev.x‖ ^ 2 + ‖setup.xStar - xUnder‖ ^ 2) +
        Dd * ‖η‖ ^ 2 + Cd := by
  have hgamma_nonneg : 0 ≤ γ := le_of_lt hgamma_pos
  have hc_ge_one : 1 ≤ 1 + setup.mu * γ := by
    have hmul_nonneg : 0 ≤ setup.mu * γ :=
      mul_nonneg setup.hmu_nonneg hgamma_nonneg
    linarith
  have hstate_nonneg :
      0 ≤ ‖setup.xStar - prev.x‖ ^ 2 + ‖setup.xStar - xUnder‖ ^ 2 := by
    positivity
  have hlinB_nonneg : 0 ≤ linB := by
    rw [hlinB_def, hgradB_def]
    nlinarith [sq_nonneg coeff]
  have hlinC_nonneg : 0 ≤ linC := by
    rw [hlinC_def]
    nlinarith [sq_nonneg coeff, sq_nonneg K]
  have hQ_nonneg :
      0 ≤ γ ^ 2 / (1 + setup.mu * γ) + γ * Nlin := by
    have hc_pos : 0 < 1 + setup.mu * γ := by linarith
    have hq1 : 0 ≤ γ ^ 2 / (1 + setup.mu * γ) := by positivity
    have hq2 : 0 ≤ γ * Nlin := mul_nonneg hgamma_nonneg hNlin_nonneg
    exact add_nonneg hq1 hq2
  have hraw :=
    acsa_scalar_sq_le_of_budgeted_coercive_with_noise_live
      (r := ‖z - xPlus‖) (c := 1 + setup.mu * γ) (γ := γ)
      (A := Ares₀) (C := Cres₀) (N := ‖η‖ ^ 2)
      (B := linB) (B0 := linC)
      (Q := γ ^ 2 / (1 + setup.mu * γ) + γ * Nlin)
      (St := ‖setup.xStar - prev.x‖ ^ 2 + ‖setup.xStar - xUnder‖ ^ 2)
      (norm_nonneg _) hc_ge_one hgamma_nonneg hAres₀_nonneg hCres₀_nonneg
      (sq_nonneg _) hlinB_nonneg hlinC_nonneg hQ_nonneg hstate_nonneg
      hsource_budget
  simpa [hAd_def, hDd_def, hCd_def] using hraw

