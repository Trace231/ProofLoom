private theorem acsa_prop42_tail_absorption_route_local
    {a L M gamma D breg tailNoise : ℝ} {δ d : E}
    (hgamma : 0 < gamma)
    (hBregScaled :
      a * (((D + L * a * gamma) / (2 * gamma)) * ‖d‖ ^ 2) ≤ a * breg)
    (hDeltaSquareNorm :
      a * (M * ‖d‖ - ⟪δ, d⟫_ℝ -
        D / (2 * gamma) * ‖d‖ ^ 2) ≤
          a * gamma * (M + ‖δ‖) ^ 2 / (2 * D)) :
    L / 2 * (a * ‖d‖) ^ 2 + M * (a * ‖d‖) - a * breg +
        (a * tailNoise - a * ⟪δ, d⟫_ℝ) ≤
      a * gamma * (M + ‖δ‖) ^ 2 / (2 * D) + a * tailNoise := by
  exact smooth_quadratic_tail_absorption_of_bregman_and_completion_square
    (E := E) hgamma hBregScaled hDeltaSquareNorm

/-- Iter-25 compiled voucher step: once the source qz-coupling has been
established, the remaining source-budget inequality is pure order algebra.

