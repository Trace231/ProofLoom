/-! Used in: `two_bregman_argmin_variational_inequality`
(right derivative of the literal AC-SA Bregman term). -/
private theorem acsa_bregman_segment_difference_hasDerivWithinAt_zero
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    {x xp u : E} (hxp : xp ∈ setup.X) :
    let d : E := u - xp
    let β : ℝ → ℝ := fun t =>
      if ht : t ∈ Set.Icc (0 : ℝ) 1 then
        setup.V x (AffineMap.lineMap xp u t) - setup.V x xp
      else 0
    HasDerivWithinAt β
      ⟪setup.gradNu xp - setup.gradNu x, d⟫_ℝ
      (Set.Icc (0 : ℝ) 1) 0 := by
  classical
  let d : E := u - xp
  let s : Set ℝ := Set.Icc (0 : ℝ) 1
  let line : ℝ → E := fun t => AffineMap.lineMap xp u t
  let β : ℝ → ℝ := fun t =>
    if _ht : t ∈ Set.Icc (0 : ℝ) 1 then
      setup.V x (AffineMap.lineMap xp u t) - setup.V x xp
    else 0
  have hline_deriv : HasDerivWithinAt line d s 0 := by
    simpa [line, d] using
      (AffineMap.hasDerivWithinAt_lineMap (a := xp) (b := u)
        (s := s) (x := (0 : ℝ)))
  have hνseg : HasDerivWithinAt (fun t => setup.nu (line t))
      ⟪setup.gradNu xp, d⟫_ℝ s 0 := by
    have hcomp :=
      (setup.nu_hasGradientAt xp hxp).hasFDerivAt.comp_hasDerivWithinAt_of_eq
        (x := (0 : ℝ)) hline_deriv (by simp [line])
    simpa [Function.comp_def, line, d, InnerProductSpace.toDual_apply_apply] using hcomp
  have hlin : HasDerivWithinAt (fun t : ℝ => t * ⟪setup.gradNu x, d⟫_ℝ)
      ⟪setup.gradNu x, d⟫_ℝ s 0 := by
    simpa using (hasDerivWithinAt_id (x := (0 : ℝ)) (s := s)).mul_const
      ⟪setup.gradNu x, d⟫_ℝ
  have hderiv_expr : HasDerivWithinAt
      (fun t : ℝ => (setup.nu (line t) - setup.nu xp) -
        t * ⟪setup.gradNu x, d⟫_ℝ)
      (⟪setup.gradNu xp, d⟫_ℝ - ⟪setup.gradNu x, d⟫_ℝ) s 0 := by
    exact (hνseg.sub_const (setup.nu xp)).sub hlin
  have heq : ∀ t ∈ s, β t =
      (fun t : ℝ => (setup.nu (line t) - setup.nu xp) -
        t * ⟪setup.gradNu x, d⟫_ℝ) t := by
    intro t ht
    have htI : t ∈ Set.Icc (0 : ℝ) 1 := by simpa [s] using ht
    have hseg_sub : (AffineMap.lineMap xp u t) - xp = t • d := by
      simp [d, AffineMap.lineMap_apply_module']
    have hinner_diff :
        ⟪setup.gradNu x, (AffineMap.lineMap xp u t) - x⟫_ℝ -
            ⟪setup.gradNu x, xp - x⟫_ℝ =
          t * ⟪setup.gradNu x, d⟫_ℝ := by
      calc
        ⟪setup.gradNu x, (AffineMap.lineMap xp u t) - x⟫_ℝ -
            ⟪setup.gradNu x, xp - x⟫_ℝ =
            ⟪setup.gradNu x, ((AffineMap.lineMap xp u t) - x) - (xp - x)⟫_ℝ := by
          rw [← inner_sub_right]
        _ = ⟪setup.gradNu x, (AffineMap.lineMap xp u t) - xp⟫_ℝ := by
          congr 1
          abel
        _ = ⟪setup.gradNu x, t • d⟫_ℝ := by
          rw [hseg_sub]
        _ = t * ⟪setup.gradNu x, d⟫_ℝ := by
          simp [inner_smul_right]
    calc
      β t = setup.V x (AffineMap.lineMap xp u t) - setup.V x xp := by
        simp only [β]
        rw [dif_pos htI]
      _ = (setup.nu (line t) - setup.nu xp) - t * ⟪setup.gradNu x, d⟫_ℝ := by
        unfold StochasticAcceleratedGradientDescentSetup.V carrierBregmanFormula
        rw [← hinner_diff]
        simp [line]
        ring
  have hβ : HasDerivWithinAt β
      (⟪setup.gradNu xp, d⟫_ℝ - ⟪setup.gradNu x, d⟫_ℝ) s 0 := by
    exact hderiv_expr.congr heq (heq 0 (by norm_num [s]))
  have hval : ⟪setup.gradNu xp, d⟫_ℝ - ⟪setup.gradNu x, d⟫_ℝ =
      ⟪setup.gradNu xp - setup.gradNu x, d⟫_ℝ := by
    rw [inner_sub_left]
  simpa [d, s, β, hval] using hβ

/-! Used in: `lemma_3_5` (Lan Lemma 3.5 nonsmooth argmin first-order bridge). -/
private theorem two_bregman_argmin_variational_inequality
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (p : E → ℝ)
    (hp_convex : ConvexOn ℝ setup.X p)
    {xTilde yTilde uHat : E} {mu1 mu2 : ℝ}
    (hxTilde : xTilde ∈ setup.X)
    (hyTilde : yTilde ∈ setup.X)
    (huHat : uHat ∈ setup.X)
    (hmu1 : 0 ≤ mu1)
    (hmu2 : 0 ≤ mu2)
    (h_opt :
      ∀ u, u ∈ setup.X →
        p uHat + mu1 * setup.V xTilde uHat + mu2 * setup.V yTilde uHat ≤
          p u + mu1 * setup.V xTilde u + mu2 * setup.V yTilde u) :
    ∀ u, u ∈ setup.X →
      0 ≤ p u - p uHat +
        mu1 * ⟪setup.gradNu uHat - setup.gradNu xTilde, u - uHat⟫_ℝ +
        mu2 * ⟪setup.gradNu uHat - setup.gradNu yTilde, u - uHat⟫_ℝ := by
  -- Aligns with Lan Lemma 3.5, proof steps 1 and 3.  The searched SOptLib
  -- candidate `prox_variational_inequality_of_isMinOn_linear_bregman` covers a
  -- linear objective plus one Bregman term, while this paper bridge keeps the
  -- convex nonsmooth `p` and two weighted Bregman terms.
  intro u hu
  classical
  let d : E := u - uHat
  let s : Set ℝ := Set.Icc (0 : ℝ) 1
  let βx : ℝ → ℝ := fun t =>
    if ht : t ∈ Set.Icc (0 : ℝ) 1 then
      setup.V xTilde (AffineMap.lineMap uHat u t) - setup.V xTilde uHat
    else 0
  let βy : ℝ → ℝ := fun t =>
    if ht : t ∈ Set.Icc (0 : ℝ) 1 then
      setup.V yTilde (AffineMap.lineMap uHat u t) - setup.V yTilde uHat
    else 0
  let φ : ℝ → ℝ := fun t =>
    t * (p u - p uHat) + mu1 * βx t + mu2 * βy t
  have hβxderiv : HasDerivWithinAt βx
      ⟪setup.gradNu uHat - setup.gradNu xTilde, d⟫_ℝ s 0 := by
    simpa [βx, d, s] using
      (acsa_bregman_segment_difference_hasDerivWithinAt_zero
        (setup := setup) (x := xTilde) (xp := uHat) (u := u) huHat)
  have hβyderiv : HasDerivWithinAt βy
      ⟪setup.gradNu uHat - setup.gradNu yTilde, d⟫_ℝ s 0 := by
    simpa [βy, d, s] using
      (acsa_bregman_segment_difference_hasDerivWithinAt_zero
        (setup := setup) (x := yTilde) (xp := uHat) (u := u) huHat)
  have hpderiv : HasDerivWithinAt (fun t : ℝ => t * (p u - p uHat))
      (p u - p uHat) s 0 := by
    simpa using (hasDerivWithinAt_id (x := (0 : ℝ)) (s := s)).mul_const
      (p u - p uHat)
  have hφderiv : HasDerivWithinAt φ
      (p u - p uHat +
        mu1 * ⟪setup.gradNu uHat - setup.gradNu xTilde, d⟫_ℝ +
        mu2 * ⟪setup.gradNu uHat - setup.gradNu yTilde, d⟫_ℝ) s 0 := by
    have hxmul : HasDerivWithinAt (fun t : ℝ => mu1 * βx t)
        (mu1 * ⟪setup.gradNu uHat - setup.gradNu xTilde, d⟫_ℝ) s 0 := by
      simpa using hβxderiv.const_mul mu1
    have hymul : HasDerivWithinAt (fun t : ℝ => mu2 * βy t)
        (mu2 * ⟪setup.gradNu uHat - setup.gradNu yTilde, d⟫_ℝ) s 0 := by
      simpa using hβyderiv.const_mul mu2
    simpa [φ, add_assoc] using (hpderiv.add hxmul).add hymul
  have hφmin : ∀ t ∈ s, φ 0 ≤ φ t := by
    intro t ht
    have htI : t ∈ Set.Icc (0 : ℝ) 1 := by simpa [s] using ht
    rcases Set.mem_Icc.mp htI with ⟨ht0, ht1⟩
    let w : E := AffineMap.lineMap uHat u t
    have hw : w ∈ setup.X := by
      simpa [w] using setup.hX_convex.lineMap_mem huHat hu htI
    have hline_conv :
        w = (1 - t) • uHat + t • u := by
      simp [w, AffineMap.lineMap_apply_module']
      module
    have hpseg : p w - p uHat ≤ t * (p u - p uHat) := by
      have hconv :=
        hp_convex.2 huHat hu (sub_nonneg.mpr ht1) ht0 (by ring)
      rw [← hline_conv] at hconv
      have hconv' : p w ≤ (1 - t) * p uHat + t * p u := by
        simpa [smul_eq_mul] using hconv
      nlinarith
    have hmin := h_opt w hw
    have hFdiff :
        0 ≤ (p w - p uHat) +
          mu1 * (setup.V xTilde w - setup.V xTilde uHat) +
          mu2 * (setup.V yTilde w - setup.V yTilde uHat) := by
      nlinarith
    have hβx_eval : βx t = setup.V xTilde w - setup.V xTilde uHat := by
      dsimp [βx, w]
      rw [if_pos htI]
    have hβy_eval : βy t = setup.V yTilde w - setup.V yTilde uHat := by
      dsimp [βy, w]
      rw [if_pos htI]
    have hφ0 : φ 0 = 0 := by
      simp [φ, βx, βy, d, AffineMap.lineMap_apply_module']
    have hupper :
        (p w - p uHat) +
          mu1 * (setup.V xTilde w - setup.V xTilde uHat) +
          mu2 * (setup.V yTilde w - setup.V yTilde uHat) ≤ φ t := by
      dsimp [φ]
      rw [hβx_eval, hβy_eval]
      nlinarith
    rw [hφ0]
    exact le_trans hFdiff hupper
  have hnonneg := right_derivative_nonneg_of_min_on_Icc hφderiv hφmin
  simpa [d] using hnonneg

/-! Used in: `proposition_4_2_under_run_contract` (prox-inequality step for the AC-SA update). -/
theorem lemma_3_5
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (p : E → ℝ)
    (hp_convex : ConvexOn ℝ setup.X p)
    {xTilde yTilde uHat : E} {mu1 mu2 : ℝ}
    (hxTilde : xTilde ∈ setup.X)
    (hyTilde : yTilde ∈ setup.X)
    (huHat : uHat ∈ setup.X)
    (hmu1 : 0 ≤ mu1)
    (hmu2 : 0 ≤ mu2)
    (h_opt :
      ∀ u, u ∈ setup.X →
        p uHat + mu1 * setup.V xTilde uHat + mu2 * setup.V yTilde uHat ≤
          p u + mu1 * setup.V xTilde u + mu2 * setup.V yTilde u) :
    ∀ u, u ∈ setup.X →
      p uHat + mu1 * setup.V xTilde uHat + mu2 * setup.V yTilde uHat ≤
        p u + mu1 * setup.V xTilde u + mu2 * setup.V yTilde u -
          (mu1 + mu2) * setup.V uHat u := by
  have _ : xTilde ∈ setup.X := hxTilde
  have _ : yTilde ∈ setup.X := hyTilde
  exact
    SOptLib.two_bregman_argmin_descent setup.X p setup.V setup.gradNu hp_convex
      huHat hmu1 hmu2
      (fun a z u hz => by
        simpa using
          acsa_bregman_segment_difference_hasDerivWithinAt_zero
            (setup := setup) (x := a) (xp := z) (u := u) hz)
      (fun a b c => acsa_bregman_three_point_identity setup a b c)
      h_opt

/-! Used in: `proposition_4_2_under_run_contract` (affine transport from the
smoothness displacement to the prox displacement). -/
private theorem xbar_sub_xunder_eq_alpha_smul_xiter_sub_xplus
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (realization : StochasticAcceleratedGradientDescentRealization (E := E) (S := S) setup Ω)
    (run :
      StochasticAcceleratedGradientDescentRealization.StochasticAcceleratedGradientDescentRunContract
        realization)
    (t : ℕ) (ht : 1 ≤ t) (ω : Ω) :
    realization.xBarIter run t ω - realization.xUnder run ⟨t, ht⟩ ω =
      setup.alpha t •
        (realization.xIter run t ω - realization.xPlus run ⟨t, ht⟩ ω) := by
  -- Aligns with Lan Eqs. (4.2.5), (4.2.7), (4.2.9), and (4.2.14).
  -- Considered the pre-searched SOptLib recursion/block-update candidates and
  -- local update lemmas; the reusable recursion facts expose updates, while
  -- this paper-specific bridge needs the AC-SA quotient relation.
  let τ : {n : ℕ // 1 ≤ n} := ⟨t, ht⟩
  have htadd : t - 1 + 1 = t := Nat.sub_add_cancel ht
  have hτ : SOptLib.natSuccPositiveTime (t - 1) = τ := by
    apply Subtype.ext
    simp [SOptLib.natSuccPositiveTime, τ, htadd]
  have hden : 1 + setup.mu * setup.gamma t ≠ 0 := by
    simpa [τ] using
      StochasticAcceleratedGradientDescentRealization.xPlus_denominator_under_run_contract
        realization run τ
  have hrel_poly :
      setup.q t * (1 - setup.alpha t) * (1 + setup.mu * setup.gamma t) =
        setup.alpha t * (1 - setup.q t) := by
    simpa [τ] using setup.q_relation_displayed τ
  have hcoef_bar :
      -setup.alpha t + setup.q t =
        setup.alpha t * setup.q t * setup.mu * setup.gamma t *
            (1 + setup.mu * setup.gamma t)⁻¹ -
          setup.alpha t * setup.mu * setup.gamma t *
            (1 + setup.mu * setup.gamma t)⁻¹ := by
    field_simp [hden]
    nlinarith [hrel_poly]
  have hcoef_prev :
      -setup.q t =
        -(setup.alpha t * setup.q t * setup.mu * setup.gamma t *
            (1 + setup.mu * setup.gamma t)⁻¹) -
          setup.alpha t * (1 + setup.mu * setup.gamma t)⁻¹ := by
    field_simp [hden]
    nlinarith [hrel_poly]
  have hbarAvg :
      realization.xBarIter run t ω =
        (1 - setup.alpha t) • realization.xBarIter run (t - 1) ω +
          setup.alpha t • realization.xIter run t ω := by
    rw [← htadd]
    rw [realization.xBarIter_succ_eq_averagePoint]
    rw [realization.xIter_succ_eq_proxStep]
    simp [hτ, τ, htadd, StochasticAcceleratedGradientDescentSetup.averagePoint,
      StochasticAcceleratedGradientDescentRealization.xBarIter]
  calc
    realization.xBarIter run t ω - realization.xUnder run τ ω
        = ((1 - setup.alpha t) • realization.xBarIter run (t - 1) ω +
            setup.alpha t • realization.xIter run t ω) -
            realization.xUnder run τ ω := by
          rw [hbarAvg]
    _ = setup.alpha t • (realization.xIter run t ω - realization.xPlus run τ ω) := by
          simp [StochasticAcceleratedGradientDescentRealization.xUnder,
            StochasticAcceleratedGradientDescentRealization.xPlus,
            acsaCheckedQuotient, τ]
          calc
            ((1 - setup.alpha t) • realization.xBarIter run (t - 1) ω +
                setup.alpha t • realization.xIter run t ω) -
                ((1 - setup.q t) • realization.xBarIter run (t - 1) ω +
                  setup.q t • realization.xIter run (t - 1) ω)
                = setup.alpha t • realization.xIter run t ω +
                    (-setup.alpha t + setup.q t) •
                      realization.xBarIter run (t - 1) ω +
                    (-setup.q t) • realization.xIter run (t - 1) ω := by
                    module
            _ = setup.alpha t • realization.xIter run t ω +
                  (setup.alpha t * setup.q t * setup.mu * setup.gamma t *
                      (1 + setup.mu * setup.gamma t)⁻¹ -
                    setup.alpha t * setup.mu * setup.gamma t *
                      (1 + setup.mu * setup.gamma t)⁻¹) •
                    realization.xBarIter run (t - 1) ω +
                  (-(setup.alpha t * setup.q t * setup.mu * setup.gamma t *
                      (1 + setup.mu * setup.gamma t)⁻¹) -
                    setup.alpha t * (1 + setup.mu * setup.gamma t)⁻¹) •
                    realization.xIter run (t - 1) ω := by
                    rw [hcoef_bar, hcoef_prev]
            _ = setup.alpha t •
                  (realization.xIter run t ω -
                    ((setup.mu * setup.gamma t / (1 + setup.mu * setup.gamma t)) •
                        (1 - setup.q t) • realization.xBarIter run (t - 1) ω +
                      (setup.mu * setup.gamma t / (1 + setup.mu * setup.gamma t)) •
                        setup.q t • realization.xIter run (t - 1) ω +
                      (1 + setup.mu * setup.gamma t)⁻¹ •
                        realization.xIter run (t - 1) ω)) := by
                    module

/-! Used in: `proposition_4_2_under_run_contract` (Lan Eqs. (4.2.17)-(4.2.18)).
No direct SOptLib match: searched `Bregman lower norm square xPlus weighted
strong convexity` and `convex norm squared ConvexOn norm_sq`; checked the
pre-searched Bregman lower-bound candidates, which provide the half-squared
lower bound for a single Bregman term but not this weighted barycenter algebra. -/
private theorem weighted_sq_norm_center_le
    {u v y : E} {r : ℝ} (hr : 0 ≤ r) :
    ((1 + r) / 2) *
        ‖y - ((r / (1 + r)) • u + (1 / (1 + r)) • v)‖ ^ 2 ≤
      (1 / 2) * ‖v - y‖ ^ 2 + (r / 2) * ‖u - y‖ ^ 2 := by
  exact weighted_sq_norm_sub_center_le (E := E) (u := u) (v := v) (y := y)
    (r := r) hr

/-! Used in: `proposition_4_2_under_run_contract` (Lan Eqs. (4.2.17)-(4.2.18)).
Aligns with the paper's strong-convexity step: the reusable SOptLib candidate is
`setup.V_lower` for each Bregman term, and the AC-SA-specific part is the
weighted `xPlus` barycenter algebra proved by `weighted_sq_norm_center_le`. -/
private theorem acsa_weighted_bregman_absorbs_xplus_sq
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (realization : StochasticAcceleratedGradientDescentRealization (E := E) (S := S) setup Ω)
    (run :
      StochasticAcceleratedGradientDescentRealization.StochasticAcceleratedGradientDescentRunContract
        realization)
    (t : ℕ) (ht : 1 ≤ t) (ω : Ω)
    (hxPrev : realization.xIter run (t - 1) ω ∈ setup.X)
    (hU_mem : realization.xUnder run ⟨t, ht⟩ ω ∈ setup.X)
    (hx_t : realization.xIter run t ω ∈ setup.X) :
    ((1 + setup.mu * setup.gamma t) / (2 * setup.gamma t)) *
        ‖realization.xIter run t ω - realization.xPlus run ⟨t, ht⟩ ω‖ ^ 2 ≤
      (1 / setup.gamma t) *
          setup.V (realization.xIter run (t - 1) ω) (realization.xIter run t ω) +
        setup.mu * setup.V (realization.xUnder run ⟨t, ht⟩ ω)
          (realization.xIter run t ω) := by
  let τ : {n : ℕ // 1 ≤ n} := ⟨t, ht⟩
  let xPrev : E := realization.xIter run (t - 1) ω
  let xUnder : E := realization.xUnder run τ ω
  let xNext : E := realization.xIter run t ω
  have hgamma_pos : 0 < setup.gamma t := run.hgamma_pos τ
  have hgamma_nonneg : 0 ≤ setup.gamma t := le_of_lt hgamma_pos
  have hgamma_ne : setup.gamma t ≠ 0 := ne_of_gt hgamma_pos
  have hr_nonneg : 0 ≤ setup.mu * setup.gamma t :=
    mul_nonneg setup.hmu_nonneg hgamma_nonneg
  have hden_pos : 0 < 1 + setup.mu * setup.gamma t := by
    nlinarith
  have hden_ne : 1 + setup.mu * setup.gamma t ≠ 0 := ne_of_gt hden_pos
  have hxplus :
      realization.xPlus run τ ω =
        (setup.mu * setup.gamma t / (1 + setup.mu * setup.gamma t)) • xUnder +
          (1 / (1 + setup.mu * setup.gamma t)) • xPrev := by
    simpa [τ, xPrev, xUnder, acsaCheckedQuotient] using
      realization.xPlus_checked_formula run τ ω
  have hgeom :=
    weighted_sq_norm_center_le (E := E) (u := xUnder) (v := xPrev) (y := xNext)
      (r := setup.mu * setup.gamma t) hr_nonneg
  have hgeom_scaled :
      ((1 + setup.mu * setup.gamma t) / (2 * setup.gamma t)) *
          ‖xNext - realization.xPlus run τ ω‖ ^ 2 ≤
        (1 / (2 * setup.gamma t)) * ‖xPrev - xNext‖ ^ 2 +
          (setup.mu / 2) * ‖xUnder - xNext‖ ^ 2 := by
    rw [hxplus]
    have hinv_nonneg : 0 ≤ 1 / setup.gamma t := by positivity
    have hmul' := mul_le_mul_of_nonneg_left hgeom hinv_nonneg
    convert hmul' using 1 <;> field_simp [hgamma_ne] <;> ring
  have hVprev := setup.V_lower xPrev hxPrev xNext hx_t
  have hVunder := setup.V_lower xUnder hU_mem xNext hx_t
  have hVprev_scaled :
      (1 / (2 * setup.gamma t)) * ‖xPrev - xNext‖ ^ 2 ≤
        (1 / setup.gamma t) * setup.V xPrev xNext := by
    have hinv_nonneg : 0 ≤ 1 / setup.gamma t := by positivity
    have hmul' := mul_le_mul_of_nonneg_left hVprev hinv_nonneg
    convert hmul' using 1 <;> ring
  have hVunder_scaled :
      (setup.mu / 2) * ‖xUnder - xNext‖ ^ 2 ≤
        setup.mu * setup.V xUnder xNext := by
    have hmul := mul_le_mul_of_nonneg_left hVunder setup.hmu_nonneg
    convert hmul using 1 <;> ring
  calc
    ((1 + setup.mu * setup.gamma t) / (2 * setup.gamma t)) *
        ‖realization.xIter run t ω - realization.xPlus run ⟨t, ht⟩ ω‖ ^ 2
        = ((1 + setup.mu * setup.gamma t) / (2 * setup.gamma t)) *
            ‖xNext - realization.xPlus run τ ω‖ ^ 2 := by
            simp [τ, xNext]
    _ ≤ (1 / (2 * setup.gamma t)) * ‖xPrev - xNext‖ ^ 2 +
          (setup.mu / 2) * ‖xUnder - xNext‖ ^ 2 := hgeom_scaled
    _ ≤ (1 / setup.gamma t) * setup.V xPrev xNext +
          setup.mu * setup.V xUnder xNext := add_le_add hVprev_scaled hVunder_scaled
    _ = (1 / setup.gamma t) *
          setup.V (realization.xIter run (t - 1) ω) (realization.xIter run t ω) +
        setup.mu * setup.V (realization.xUnder run ⟨t, ht⟩ ω)
          (realization.xIter run t ω) := by
          simp [τ, xPrev, xUnder, xNext]

/-! Used in: `proposition_4_2_under_run_contract` (Lan Eq. (4.2.19) plus the
simple inequality (3.1.6) controlling the stochastic error term). Considered
`mul_le_half_sq_add_two_mul_sq_of_le_mul_add` and
`inner_sub_sub_bregman_le_half_dual_sq`; those are respectively a differently
weighted product absorption and a Bregman-residual estimate, while this proof
needs the literal AC-SA denominator
`1 + μ γ_t - L α_t γ_t` and the Euclidean `SOptLib.dualNorm` realization. -/
private theorem acsa_delta_completion_square
    {M gamma D a : ℝ} {δ d : E}
    (ha : 0 ≤ a) (hgamma : 0 < gamma) (hD : 0 < D) (hM : 0 ≤ M) :
    a * (M * ‖d‖ - ⟪δ, d⟫_ℝ - D / (2 * gamma) * ‖d‖ ^ 2) ≤
      a * gamma * (M + SOptLib.dualNorm δ) ^ 2 / (2 * D) := by
  simpa [SOptLib.dualNorm_eq_norm] using
    scaled_linear_inner_quadratic_le_square_over_denominator
      (E := E) (M := M) (gamma := gamma) (D := D) (a := a)
      (δ := δ) (d := d) ha hgamma hD

/-! Conditional realization form of Proposition 4.2. The source proposition is
stated for iterates computed by Eqs. (4.2.5)-(4.2.7); the extra Lean run
contract is disclosed in the name rather than hidden in a paper-named theorem
head. -/
theorem proposition_4_2_under_run_contract
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (realization : StochasticAcceleratedGradientDescentRealization (E := E) (S := S) setup Ω)
    (run :
      StochasticAcceleratedGradientDescentRealization.StochasticAcceleratedGradientDescentRunContract
        realization)
    (t : ℕ) (ht : 1 ≤ t) (x : E) (hx : x ∈ setup.X) (ω : Ω) :
    setup.Psi (realization.xBarIter run t ω) ≤
      (1 - setup.alpha t) * setup.Psi (realization.xBarIter run (t - 1) ω) +
        setup.alpha t * realization.lPsi run ⟨t, ht⟩ ω x +
        (setup.alpha t / setup.gamma t) *
          (setup.V (realization.xIter run (t - 1) ω) x -
            (1 + setup.mu * setup.gamma t) * setup.V (realization.xIter run t ω) x) +
        realization.Delta run ⟨t, ht⟩ ω x := by
  let τ : {n : ℕ // 1 ≤ n} := ⟨t, ht⟩
  have hAffine :=
    xbar_sub_xunder_eq_alpha_smul_xiter_sub_xplus setup realization run t ht ω
  have hxBarPrev : realization.xBarIter run (t - 1) ω ∈ setup.X := by
    simpa [StochasticAcceleratedGradientDescentRealization.xBarIter]
      using (realization.process run (t - 1) ω).hxBar
  have hxPrev : realization.xIter run (t - 1) ω ∈ setup.X := by
    simpa [StochasticAcceleratedGradientDescentRealization.xIter]
      using (realization.process run (t - 1) ω).hx
  have hx_t : realization.xIter run t ω ∈ setup.X := by
    simpa [StochasticAcceleratedGradientDescentRealization.xIter]
      using (realization.process run t ω).hx
  have hU_mem : realization.xUnder run τ ω ∈ setup.X := by
    simpa [τ] using realization.xUnder_mem run τ ω
  have htadd : t - 1 + 1 = t := Nat.sub_add_cancel ht
  have hτ : SOptLib.natSuccPositiveTime (t - 1) = τ := by
    apply Subtype.ext
    simp [SOptLib.natSuccPositiveTime, τ, htadd]
  have hbarAvg :
      realization.xBarIter run t ω =
        (1 - setup.alpha t) • realization.xBarIter run (t - 1) ω +
          setup.alpha t • realization.xIter run t ω := by
    rw [← htadd]
    rw [realization.xBarIter_succ_eq_averagePoint]
    rw [realization.xIter_succ_eq_proxStep]
    simp [hτ, τ, htadd, StochasticAcceleratedGradientDescentSetup.averagePoint,
      StochasticAcceleratedGradientDescentRealization.xBarIter]
  have hUpperRaw :=
    lemma_4_4 setup (run.halpha_mem_Icc τ) hxBarPrev hx_t hU_mem
  have hUpper :
      setup.Psi (realization.xBarIter run t ω) ≤
        (1 - setup.alpha t) * setup.Psi (realization.xBarIter run (t - 1) ω) +
          setup.alpha t *
            (setup.f (realization.xUnder run τ ω) +
              ⟪setup.gradF (realization.xUnder run τ ω),
                realization.xIter run t ω - realization.xUnder run τ ω⟫_ℝ +
              setup.h (realization.xIter run t ω)) +
          (setup.L / 2) *
            ‖setup.alpha t •
              (realization.xIter run t ω - realization.xPlus run τ ω)‖ ^ 2 +
          setup.M *
            ‖setup.alpha t •
              (realization.xIter run t ω - realization.xPlus run τ ω)‖ := by
    rw [← hbarAvg] at hUpperRaw
    rw [hAffine] at hUpperRaw
    simpa [τ] using hUpperRaw
  have hUeq :
      realization.xUnder run τ ω =
        setup.searchPoint τ (realization.process run (t - 1) ω) := by
    rw [← hτ]
    exact realization.xUnder_succ_eq_searchPoint run (t - 1) ω
  have hxteq :
      realization.xIter run t ω =
        run.proxStep τ (realization.process run (t - 1) ω) ω := by
    rw [← htadd]
    rw [realization.xIter_succ_eq_proxStep]
    simp [hτ]
  have hxteq_process :
      (realization.process run t ω).x =
        run.proxStep τ (realization.process run (t - 1) ω) ω := by
    simpa [StochasticAcceleratedGradientDescentRealization.xIter] using hxteq
  have hstep : setup.IsProxStep τ
      (realization.xIter run (t - 1) ω)
      (realization.xUnder run τ ω)
      (realization.sampledGradient t (realization.xUnder run τ ω) ω)
      (realization.xIter run t ω) := by
    have hraw := run.proxStep_spec τ (realization.process run (t - 1) ω) ω
    simpa [τ, StochasticAcceleratedGradientDescentRealization.xIter, hUeq, hxteq_process]
      using hraw
  let g : E := realization.sampledGradient t (realization.xUnder run τ ω) ω
  let p : E → ℝ := fun u => setup.gamma t * (⟪g, u⟫_ℝ + setup.h u)
  have hp_convex : ConvexOn ℝ setup.X p := by
    refine ⟨setup.hX_convex, ?_⟩
    intro y hy z hz a b ha hb hab
    have hh := (IsAcsSimpleConvexTerm.convex setup.hh_simple).2 hy hz ha hb hab
    have hinner : ⟪g, a • y + b • z⟫_ℝ =
        a * ⟪g, y⟫_ℝ + b * ⟪g, z⟫_ℝ := by
      simp [inner_add_right, inner_smul_right]
    have hγ_nonneg : 0 ≤ setup.gamma t := le_of_lt (run.hgamma_pos τ)
    simp [p, hinner, smul_eq_mul]
    have hhconv : setup.h (a • y + b • z) ≤ a * setup.h y + b * setup.h z := by
      simpa [smul_eq_mul] using hh
    nlinarith [mul_le_mul_of_nonneg_left hhconv hγ_nonneg]
  have hmu1 : 0 ≤ setup.gamma t * setup.mu := by
    exact mul_nonneg (le_of_lt (run.hgamma_pos τ)) setup.hmu_nonneg
  have hopt :
      ∀ u, u ∈ setup.X →
        p (realization.xIter run t ω) +
            (setup.gamma t * setup.mu) *
              setup.V (realization.xUnder run τ ω) (realization.xIter run t ω) +
            (1 : ℝ) *
              setup.V (realization.xIter run (t - 1) ω) (realization.xIter run t ω) ≤
          p u +
            (setup.gamma t * setup.mu) * setup.V (realization.xUnder run τ ω) u +
            (1 : ℝ) * setup.V (realization.xIter run (t - 1) ω) u := by
    intro u hu
    have hmin := hstep.2 hu
    unfold StochasticAcceleratedGradientDescentSetup.proxObjective acsaProxObjective
      SOptLib.acceleratedCompositeProxObjective at hmin
    dsimp [p, g] at hmin
    nlinarith
  have hProxRaw :=
    lemma_3_5 setup p hp_convex hU_mem hxPrev hx_t hmu1 (by norm_num) hopt x hx
  have hγpos : 0 < setup.gamma t := run.hgamma_pos τ
  have hγne : setup.gamma t ≠ 0 := ne_of_gt hγpos
  have hdelta : g = setup.gradF (realization.xUnder run τ ω) + realization.delta run τ ω := by
    rw [realization.delta_eq_sampledGradient_sub_gradF]
    simp [g, τ]
  have hProxModel :
      setup.f (realization.xUnder run τ ω) +
          ⟪setup.gradF (realization.xUnder run τ ω),
            realization.xIter run t ω - realization.xUnder run τ ω⟫_ℝ +
          setup.h (realization.xIter run t ω) ≤
        realization.lPsi run τ ω x +
          (1 / setup.gamma t) *
            (setup.V (realization.xIter run (t - 1) ω) x -
              (1 + setup.mu * setup.gamma t) * setup.V (realization.xIter run t ω) x) -
          ((1 / setup.gamma t) *
              setup.V (realization.xIter run (t - 1) ω) (realization.xIter run t ω) +
            setup.mu * setup.V (realization.xUnder run τ ω) (realization.xIter run t ω)) +
          ⟪realization.delta run τ ω, x - realization.xIter run t ω⟫_ℝ := by
    have hraw := hProxRaw
    dsimp [p] at hraw
    rw [hdelta] at hraw
    unfold StochasticAcceleratedGradientDescentRealization.lPsi
    simp [inner_add_left, inner_add_right, sub_eq_add_neg] at hraw ⊢
    field_simp [hγne]
    nlinarith [hraw]
  have ha_nonneg : 0 ≤ setup.alpha t := (Set.mem_Icc.mp (run.halpha_mem_Icc τ)).1
  let d : E := realization.xIter run t ω - realization.xPlus run τ ω
  let D : ℝ :=
    1 + setup.mu * setup.gamma t - setup.L * setup.alpha t * setup.gamma t
  have hDpos : 0 < D := by
    simpa [D, τ] using setup.error_denominator_pos τ
  have hBregLower :
      ((1 + setup.mu * setup.gamma t) / (2 * setup.gamma t)) * ‖d‖ ^ 2 ≤
        (1 / setup.gamma t) *
            setup.V (realization.xIter run (t - 1) ω) (realization.xIter run t ω) +
          setup.mu * setup.V (realization.xUnder run τ ω) (realization.xIter run t ω) := by
    simpa [d, τ] using
      acsa_weighted_bregman_absorbs_xplus_sq setup realization run t ht ω
        hxPrev hU_mem hx_t
  have hDeltaSquare :
      setup.alpha t *
          (setup.M * ‖d‖ - ⟪realization.delta run τ ω, d⟫_ℝ -
            D / (2 * setup.gamma t) * ‖d‖ ^ 2) ≤
        setup.alpha t * setup.gamma t *
          (setup.M + SOptLib.dualNorm (realization.delta run τ ω)) ^ 2 /
            (2 * D) := by
    exact acsa_delta_completion_square (E := E) (M := setup.M)
      (gamma := setup.gamma t) (D := D) (a := setup.alpha t)
      (δ := realization.delta run τ ω) (d := d)
      ha_nonneg hγpos hDpos setup.hM_nonneg
  simpa [τ, d, D, StochasticAcceleratedGradientDescentRealization.Delta,
    SOptLib.acceleratedStochasticError, SOptLib.dualNorm_eq_norm] using
    accelerated_composite_one_step_recursion
      (Psi := setup.Psi) (lowerModel := realization.lPsi run τ ω)
      (V := setup.V)
      (alpha := setup.alpha t) (gamma := setup.gamma t)
      (mu := setup.mu) (L := setup.L) (M := setup.M)
      (localModel :=
        setup.f (realization.xUnder run τ ω) +
          ⟪setup.gradF (realization.xUnder run τ ω),
            realization.xIter run t ω - realization.xUnder run τ ω⟫_ℝ +
          setup.h (realization.xIter run t ω))
      (xBarPrev := realization.xBarIter run (t - 1) ω)
      (xPrev := realization.xIter run (t - 1) ω)
      (xUnder := realization.xUnder run τ ω)
      (xNext := realization.xIter run t ω)
      (xBar := realization.xBarIter run t ω)
      (xPlus := realization.xPlus run τ ω)
      (xRef := x)
      (delta := realization.delta run τ ω)
      ha_nonneg hγpos
      (by simpa [d] using hUpper)
      (by simpa [d] using hProxModel)
      (by simpa [d] using hBregLower)
      (by simpa [D, d, SOptLib.dualNorm_eq_norm] using hDeltaSquare)

/-! Scalar Γ-weighted telescope used in Proposition 4.3. Considered
`outputWindow_sum_sub_succ`, `expectedOutput_eq_weighted_sum_div`,
`outputWindow_sum_sub_succ_le_first_of_last_nonneg`, and
`weighted_output_gap_le_initial_potential_add_noise`: those SOptLib candidates
handle generic output-window normalization or raw successive-difference
telescopes, while Lan's Proposition 4.3 requires the literal Γ-recurrence
`Γ_{t+1} = (1 - α_{t+1}) Γ_t` applied to the one-step AC-SA recursion. -/
private theorem acsa_weighted_descent_telescope
    (A L B D alpha gamma Gamma : ℕ → ℝ)
    (k : ℕ) (hk : 1 ≤ k)
    (halpha_mem_Icc : ∀ t, 1 ≤ t → alpha t ∈ Set.Icc (0 : ℝ) 1)
    (hgamma_ne : ∀ t, 1 ≤ t → gamma t ≠ 0)
    (hGamma_ne : ∀ t, 1 ≤ t → Gamma t ≠ 0)
    (hGamma_one : Gamma 1 = 1)
    (halpha_one : alpha 1 = 1)
    (hGamma_succ : ∀ t, 1 ≤ t → Gamma (t + 1) = (1 - alpha (t + 1)) * Gamma t)
    (hstep : ∀ t, 1 ≤ t →
      A t ≤ (1 - alpha t) * A (t - 1) + alpha t * L t +
        alpha t / gamma t * B t + D t) :
    A k - Gamma k *
        Finset.sum (Finset.Icc 1 k)
          (fun t => alpha t / Gamma t * L t) ≤
      Gamma k * (1 - alpha 1) * A 0 +
        Gamma k *
          Finset.sum (Finset.Icc 1 k)
            (fun t => alpha t / (gamma t * Gamma t) * B t) +
        Gamma k *
          Finset.sum (Finset.Icc 1 k)
            (fun t => D t / Gamma t) := by
  classical
  let SL : ℕ → ℝ := fun m =>
    Finset.sum (Finset.Icc 1 m) (fun t => alpha t / Gamma t * L t)
  let SB : ℕ → ℝ := fun m =>
    Finset.sum (Finset.Icc 1 m) (fun t => alpha t / (gamma t * Gamma t) * B t)
  let SD : ℕ → ℝ := fun m =>
    Finset.sum (Finset.Icc 1 m) (fun t => D t / Gamma t)
  change
    A k - Gamma k * SL k ≤
      Gamma k * (1 - alpha 1) * A 0 + Gamma k * SB k + Gamma k * SD k
  refine Nat.le_induction ?base ?step k hk
  · have hstep1 := hstep 1 le_rfl
    have hstep1' :
        A 1 ≤ L 1 + (1 / gamma 1) * B 1 + D 1 := by
      simpa [halpha_one] using hstep1
    rw [one_div] at hstep1'
    simp [SL, SB, SD, hGamma_one, halpha_one]
    linarith
  · intro n hn ih
    have hn1 : 1 ≤ n + 1 := Nat.succ_le_succ (Nat.zero_le n)
    have hcoef_nonneg : 0 ≤ 1 - alpha (n + 1) := by
      exact sub_nonneg.mpr (Set.mem_Icc.mp (halpha_mem_Icc (n + 1) hn1)).2
    have hrec := hGamma_succ n hn
    have hGtop : Gamma (n + 1) ≠ 0 := hGamma_ne (n + 1) hn1
    have hγtop : gamma (n + 1) ≠ 0 := hgamma_ne (n + 1) hn1
    have hSL_succ :
        SL (n + 1) =
          SL n + alpha (n + 1) / Gamma (n + 1) * L (n + 1) := by
      dsimp [SL]
      rw [Finset.sum_Icc_succ_top hn1]
    have hSB_succ :
        SB (n + 1) =
          SB n + alpha (n + 1) / (gamma (n + 1) * Gamma (n + 1)) * B (n + 1) := by
      dsimp [SB]
      rw [Finset.sum_Icc_succ_top hn1]
    have hSD_succ :
        SD (n + 1) =
          SD n + D (n + 1) / Gamma (n + 1) := by
      dsimp [SD]
      rw [Finset.sum_Icc_succ_top hn1]
    have htopL :
        Gamma (n + 1) *
            (alpha (n + 1) / Gamma (n + 1) * L (n + 1)) =
          alpha (n + 1) * L (n + 1) := by
      field_simp [hGtop]
    have htopB :
        Gamma (n + 1) *
            (alpha (n + 1) / (gamma (n + 1) * Gamma (n + 1)) * B (n + 1)) =
          alpha (n + 1) / gamma (n + 1) * B (n + 1) := by
      field_simp [hγtop, hGtop]
    have htopD :
        Gamma (n + 1) * (D (n + 1) / Gamma (n + 1)) = D (n + 1) := by
      field_simp [hGtop]
    have hih_scaled :=
      mul_le_mul_of_nonneg_left ih hcoef_nonneg
    have hstep_top :
        A (n + 1) ≤
          (1 - alpha (n + 1)) * A n + alpha (n + 1) * L (n + 1) +
            alpha (n + 1) / gamma (n + 1) * B (n + 1) + D (n + 1) := by
      simpa using hstep (n + 1) hn1
    calc
      A (n + 1) - Gamma (n + 1) * SL (n + 1)
          = A (n + 1) -
              Gamma (n + 1) *
                (SL n + alpha (n + 1) / Gamma (n + 1) * L (n + 1)) := by
              rw [hSL_succ]
      _ = A (n + 1) - Gamma (n + 1) * SL n -
            alpha (n + 1) * L (n + 1) := by
              rw [mul_add, htopL]
              ring
      _ ≤ (1 - alpha (n + 1)) * (A n - Gamma n * SL n) +
            alpha (n + 1) / gamma (n + 1) * B (n + 1) + D (n + 1) := by
              rw [hrec]
              nlinarith
      _ ≤ (1 - alpha (n + 1)) *
              (Gamma n * (1 - alpha 1) * A 0 + Gamma n * SB n + Gamma n * SD n) +
            alpha (n + 1) / gamma (n + 1) * B (n + 1) + D (n + 1) := by
              nlinarith
      _ =
          Gamma (n + 1) * (1 - alpha 1) * A 0 +
            (Gamma (n + 1) * SB n +
              alpha (n + 1) / gamma (n + 1) * B (n + 1)) +
            (Gamma (n + 1) * SD n + D (n + 1)) := by
              rw [hrec]
              ring
      _ =
          Gamma (n + 1) * (1 - alpha 1) * A 0 +
            Gamma (n + 1) * SB (n + 1) +
            Gamma (n + 1) * SD (n + 1) := by
              rw [hSB_succ, hSD_succ]
              rw [mul_add, mul_add, htopB, htopD]

/-! Conditional realization form of Proposition 4.3. The source proposition is
stated for the computed AC-SA algorithm; the Lean run contract carries only the
non-source realization facts needed to interpret that computation. -/
theorem proposition_4_3_under_run_contract
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (realization : StochasticAcceleratedGradientDescentRealization (E := E) (S := S) setup Ω)
    (run :
      StochasticAcceleratedGradientDescentRealization.StochasticAcceleratedGradientDescentRunContract
        realization)
    (k : ℕ) (hk : 1 ≤ k) (x : E) (hx : x ∈ setup.X) (ω : Ω) :
    setup.Psi (realization.output run k ω) -
      setup.Gamma ⟨k, hk⟩ *
        Finset.sum (Finset.Icc 1 k).attach (fun t =>
          let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
          setup.alpha t.1 / setup.Gamma τ * realization.lPsi run τ ω x) ≤
      setup.Gamma ⟨k, hk⟩ * (1 - setup.alpha 1) *
          setup.Psi (realization.xBarIter run 0 ω) +
        setup.Gamma ⟨k, hk⟩ *
          Finset.sum (Finset.Icc 1 k).attach (fun t =>
            let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
            setup.alpha t.1 / (setup.gamma t.1 * setup.Gamma τ) *
              (setup.V (realization.xIter run (t.1 - 1) ω) x -
                (1 + setup.mu * setup.gamma t.1) *
                  setup.V (realization.xIter run t.1 ω) x)) +
        setup.Gamma ⟨k, hk⟩ *
          Finset.sum (Finset.Icc 1 k).attach (fun t =>
            let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
            realization.Delta run τ ω x / setup.Gamma τ) := by
  classical
  simpa [StochasticAcceleratedGradientDescentRealization.output] using
    accelerated_pathwise_window_bound_of_one_step
      (A := fun n ω => setup.Psi (realization.xBarIter run n ω))
      (L := fun τ ω => realization.lPsi run τ ω x)
      (B := fun τ ω =>
        setup.V (realization.xIter run (τ.1 - 1) ω) x -
          (1 + setup.mu * setup.gamma τ.1) *
            setup.V (realization.xIter run τ.1 ω) x)
      (D := fun τ ω => realization.Delta run τ ω x)
      (alpha := setup.alpha)
      (gamma := setup.gamma)
      (Gamma := setup.Gamma)
      k hk ω
      (fun t ht => (Set.mem_Icc.mp (run.halpha_mem_Icc ⟨t, ht⟩)).2)
      (fun t ht => ne_of_gt (run.hgamma_pos ⟨t, ht⟩))
      (fun τ hGamma =>
        run.hweight_denominator_ne τ (by simp [hGamma]))
      (by simpa [SOptLib.positiveTimeOne] using setup.Gamma_one)
      setup.alpha_one
      (fun t ht => setup.Gamma_succ t ht)
      (fun t ht => by
        simpa using
          proposition_4_2_under_run_contract setup realization run t ht x hx ω)

/-! Eq. 4.2.28 identity: the weighted sum of step-size ratios telescopes to
`1/Γ_k`, stated under the same run boundary that supplies `Γ_t ≠ 0`. -/
theorem sum_alpha_div_Gamma_eq_under_run_contract
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (realization : StochasticAcceleratedGradientDescentRealization (E := E) (S := S) setup Ω)
    (run :
      StochasticAcceleratedGradientDescentRealization.StochasticAcceleratedGradientDescentRunContract
        realization)
    (k : ℕ) (hk : 1 ≤ k) :
    Finset.sum (Finset.Icc 1 k).attach (fun t =>
      let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
      acsaCheckedQuotient (setup.alpha t.1) (setup.Gamma τ) (by
        have hweight := run.hweight_denominator_ne τ
        intro hGamma
        exact hweight (by simp [hGamma]))) =
      acsaCheckedQuotient 1 (setup.Gamma ⟨k, hk⟩) (by
        have hweight := run.hweight_denominator_ne ⟨k, hk⟩
        intro hGamma
        exact hweight (by simp [hGamma])) := by
  unfold acsaCheckedQuotient
  have hGamma_ne :
      ∀ (n : ℕ) (hn : n ∈ Finset.Icc 1 k),
        SOptLib.acceleratedGammaSchedule setup.alpha
          ⟨n, (Finset.mem_Icc.mp hn).1⟩ ≠ 0 := by
    intro n hn hGamma
    exact run.hweight_denominator_ne ⟨n, (Finset.mem_Icc.mp hn).1⟩
      (by
        rw [StochasticAcceleratedGradientDescentSetup.Gamma]
        rw [hGamma]
        ring)
  have hGamma_ne_all :
      ∀ t : {n : ℕ // 1 ≤ n},
        SOptLib.acceleratedGammaSchedule setup.alpha t ≠ 0 := by
    intro τ hGamma
    exact run.hweight_denominator_ne τ
      (by
        rw [StochasticAcceleratedGradientDescentSetup.Gamma]
        rw [hGamma]
        ring)
  simpa [StochasticAcceleratedGradientDescentSetup.Gamma] using
    SOptLib.sum_alpha_div_acceleratedGamma_eq_inv setup.alpha setup.alpha_one
      hGamma_ne_all k hk

/-- Positivity of the AC-SA recursive weights under the concrete run contract.

No SOptLib match: searched `Gamma positive recursive parameter schedule` and
`positive recurrence product nonzero`; the only aligned hits were this file's
`Gamma_one`, `Gamma_succ`, and the run-contract denominator field, while
SOptLib's positive-weight lemmas concern generic output windows rather than
Lan's Eq. (4.2.21) recursive `Γ_t`. -/
private theorem Gamma_pos_under_run_contract
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (realization : StochasticAcceleratedGradientDescentRealization (E := E) (S := S) setup Ω)
    (run :
      StochasticAcceleratedGradientDescentRealization.StochasticAcceleratedGradientDescentRunContract
        realization) :
    ∀ t : {n : ℕ // 1 ≤ n}, 0 < setup.Gamma t := by
  exact SOptLib.acceleratedGamma_pos_of_mem_Icc_and_ne_zero
    setup.alpha setup.Gamma setup.Gamma_one
    (fun n hn => setup.Gamma_succ n hn)
    run.halpha_mem_Icc
    (fun t hGamma =>
      run.hweight_denominator_ne t (by simp [hGamma]))

/-! `lPsi` is a lower model for `Psi`: the linearization plus `h` plus strong-convexity
correction lies below `Psi`. This bridge is used when summing `lPsi` terms in
`proposition_4_3_under_run_contract` to recover a bound in terms of the canonical optimum value
`PsiStar`. -/
theorem lPsi_le_Psi
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (realization : StochasticAcceleratedGradientDescentRealization (E := E) (S := S) setup Ω)
    (run :
      StochasticAcceleratedGradientDescentRealization.StochasticAcceleratedGradientDescentRunContract
        realization)
    (t : {n : ℕ // 1 ≤ n}) (ω : Ω) (x : E) (hx : x ∈ setup.X) :
    realization.lPsi run t ω x ≤ setup.Psi x := by
  let xUnder := realization.xUnder run t ω
  have hxUnder : xUnder ∈ setup.X := by
    simpa [xUnder] using realization.xUnder_mem run t ω
  exact SOptLib.lowerModel_le_compositeObjective_of_curvature_lower
    setup.f setup.h setup.gradF setup.mu setup.V xUnder x
    ((setup.hcurvature_model xUnder hxUnder x hx).1)

/-- Source step 4 lower-model summation bound at the selected optimizer.

Aligns with `lPsi_le_Psi` and `sum_alpha_div_Gamma_eq_under_run_contract`:
the listed SOptLib/output-weight candidates do not know Lan's checked
`Γ_t` quotient identity, so this bridge specializes Eq. (4.2.28) to the
paper lower model at `x*`. -/
private theorem lower_model_weighted_sum_le_PsiStar_under_run_contract
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (realization : StochasticAcceleratedGradientDescentRealization (E := E) (S := S) setup Ω)
    (run :
      StochasticAcceleratedGradientDescentRealization.StochasticAcceleratedGradientDescentRunContract
        realization)
    (k : ℕ) (hk : 1 ≤ k) (ω : Ω) :
    setup.Gamma ⟨k, hk⟩ *
        Finset.sum (Finset.Icc 1 k).attach (fun t =>
          let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
          setup.alpha t.1 / setup.Gamma τ *
            realization.lPsi run τ ω setup.xStar) ≤
      setup.PsiStar := by
  classical
  have hPsiStar_eq_xStar : setup.Psi setup.xStar = setup.PsiStar := by
    have h :=
      SOptLib.objectiveMinimumOfFeasibleOptimizer_value setup.X setup.Psi
        setup.xStar setup.hxStar_mem setup.hxStar_minimizes
    symm
    simpa [StochasticAcceleratedGradientDescentSetup.PsiStar,
      StochasticAcceleratedGradientDescentSetup.PsiMinimum,
      StochasticAcceleratedGradientDescentSetup.PsiCarrier,
      SOptLib.ObjectiveMinimum.value] using h
  let coeff : {t : ℕ // t ∈ Finset.Icc 1 k} → ℝ := fun t =>
    let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
    setup.alpha t.1 / setup.Gamma τ
  simpa [coeff] using
    (weighted_lower_model_sum_le_optimum_of_coeff_sum
      (Finset.Icc 1 k).attach
      (fun t (_ : Ω) =>
        realization.lPsi run ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩ ω setup.xStar)
      setup.PsiStar coeff (setup.Gamma ⟨k, hk⟩) ω
      ((Gamma_pos_under_run_contract setup realization run) ⟨k, hk⟩)
      (by
        intro t ht
        have htpos : 1 ≤ t.1 := (Finset.mem_Icc.mp t.2).1
        have halpha_nonneg : 0 ≤ setup.alpha t.1 :=
          (Set.mem_Icc.mp (run.halpha_mem_Icc ⟨t.1, htpos⟩)).1
        have hGamma_nonneg :
            0 ≤ setup.Gamma ⟨t.1, htpos⟩ :=
          le_of_lt ((Gamma_pos_under_run_contract setup realization run) ⟨t.1, htpos⟩)
        exact div_nonneg halpha_nonneg hGamma_nonneg)
      (by
        intro t ht
        have htpos : 1 ≤ t.1 := (Finset.mem_Icc.mp t.2).1
        have h :=
          lPsi_le_Psi setup realization run ⟨t.1, htpos⟩ ω
            setup.xStar setup.hxStar_mem
        simpa [hPsiStar_eq_xStar] using h)
      (by
        have h :=
          sum_alpha_div_Gamma_eq_under_run_contract setup realization run k hk
        unfold acsaCheckedQuotient at h
        simpa [coeff] using h))

/-- Pathwise post-Proposition-4.3 inequality after replacing the lower-model
sum by the optimum value.

Aligns with Lan §4.2 Theorem 4.4 proof step 4: this consumes
`proposition_4_3_under_run_contract` and
`lower_model_weighted_sum_le_PsiStar_under_run_contract`, but deliberately
leaves the Bregman-weight finite sum exposed for the subsequent Eq. (4.2.22)
telescope. -/
private theorem pathwise_after_lower_model_under_run_contract
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (realization : StochasticAcceleratedGradientDescentRealization (E := E) (S := S) setup Ω)
    (run :
      StochasticAcceleratedGradientDescentRealization.StochasticAcceleratedGradientDescentRunContract
        realization)
    (k : ℕ) (hk : 1 ≤ k) (ω : Ω) :
    realization.expectedGapIntegrand run k ω ≤
      setup.Gamma ⟨k, hk⟩ * (1 - setup.alpha 1) *
          setup.Psi (realization.xBarIter run 0 ω) +
        setup.Gamma ⟨k, hk⟩ *
          Finset.sum (Finset.Icc 1 k).attach (fun t =>
            let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
            setup.alpha t.1 / (setup.gamma t.1 * setup.Gamma τ) *
              (setup.V (realization.xIter run (t.1 - 1) ω) setup.xStar -
                (1 + setup.mu * setup.gamma t.1) *
                  setup.V (realization.xIter run t.1 ω) setup.xStar)) +
        setup.Gamma ⟨k, hk⟩ *
          Finset.sum (Finset.Icc 1 k).attach (fun t =>
            let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
            realization.Delta run τ ω setup.xStar / setup.Gamma τ) := by
  unfold StochasticAcceleratedGradientDescentRealization.expectedGapIntegrand
  exact pathwise_gap_bound_after_lower_model
    (fun ω => setup.Psi (realization.output run k ω))
    (fun ω =>
      setup.Gamma ⟨k, hk⟩ *
        Finset.sum (Finset.Icc 1 k).attach (fun t =>
          let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
          setup.alpha t.1 / setup.Gamma τ *
            realization.lPsi run τ ω setup.xStar))
    (fun ω =>
      setup.Gamma ⟨k, hk⟩ * (1 - setup.alpha 1) *
        setup.Psi (realization.xBarIter run 0 ω))
    (fun ω =>
      setup.Gamma ⟨k, hk⟩ *
        Finset.sum (Finset.Icc 1 k).attach (fun t =>
          let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
          setup.alpha t.1 / (setup.gamma t.1 * setup.Gamma τ) *
            (setup.V (realization.xIter run (t.1 - 1) ω) setup.xStar -
              (1 + setup.mu * setup.gamma t.1) *
                setup.V (realization.xIter run t.1 ω) setup.xStar)))
    (fun ω =>
      setup.Gamma ⟨k, hk⟩ *
        Finset.sum (Finset.Icc 1 k).attach (fun t =>
          let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
          realization.Delta run τ ω setup.xStar / setup.Gamma τ))
    setup.PsiStar ω
    (proposition_4_3_under_run_contract setup realization run k hk
      setup.xStar setup.hxStar_mem ω)
    (lower_model_weighted_sum_le_PsiStar_under_run_contract
      setup realization run k hk ω)

/-! Scalar finite-sum telescope for Lan Eq. (4.2.30). Considered SOptLib
`integral_sum_telescope_bound_of_pointwise_lower_bound`,
`summed_one_step_gap_bound_of_telescope`, and the local
`acsa_weighted_descent_telescope`; they telescope exact successive drops or the
earlier Γ-scaled descent recursion, while this step needs the monotone
coefficient inequality `c_{t+1} ≤ c_t β_t` from Eq. (4.2.22). -/
private theorem acsa_scalar_weighted_bregman_telescope
    (c beta V : ℕ → ℝ) (k : ℕ) (hk : 1 ≤ k)
    (hV_nonneg : ∀ n, 0 ≤ V n)
    (hc_mono : ∀ n, 1 ≤ n → c (n + 1) ≤ c n * beta n)
    (hcb_nonneg : ∀ n, 1 ≤ n → 0 ≤ c n * beta n) :
    Finset.sum (Finset.Icc 1 k) (fun t =>
        c t * (V (t - 1) - beta t * V t)) ≤ c 1 * V 0 :=
  le_trans
    (sum_weighted_sub_mul_le_first_sub_tail c beta V k hk
      (fun n _hn _hnk => hV_nonneg n)
      (fun n hn _hnk => hc_mono n hn))
    (sub_le_self (c 1 * V 0) (mul_nonneg (hcb_nonneg k hk) (hV_nonneg k)))

/-! Square-moment bridge for the quadratic part of Lan Eq. (4.2.32).
Considered `finite_window_zero_mean_plus_quadratic_noise_integral_bound`,
`weighted_variance_sum_expectation_bound`, and
`integrable_of_nonneg_sq_integrable_integral_le_sq_bound_add_one`; the first two
package later finite-window summations, while this one-index bridge needs the
literal `(M + ‖δ_t‖_*)^2` integrability and expectation bound before `Δ_t` is
expanded. -/
private theorem acsa_delta_square_integrable_and_expectation_bound
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (realization :
      StochasticAcceleratedGradientDescentRealization (E := E) (S := S) setup Ω)
    (run :
      StochasticAcceleratedGradientDescentRealization.StochasticAcceleratedGradientDescentRunContract
        realization)
    (τ : {n : ℕ // 1 ≤ n}) :
    Integrable
        (fun ω =>
          (setup.M + SOptLib.dualNorm (realization.delta run τ ω)) ^ 2)
        realization.P ∧
      ∫ ω, (setup.M + SOptLib.dualNorm (realization.delta run τ ω)) ^ 2
          ∂realization.P ≤
        2 * (setup.M ^ 2 + setup.sigma ^ 2) := by
  letI : IsProbabilityMeasure realization.P := realization.hP
  let Z : Ω → ℝ := fun ω => SOptLib.dualNorm (realization.delta run τ ω)
  have hZ_sq_int : Integrable (fun ω => Z ω ^ 2) realization.P := by
    simpa [Z, StochasticAcceleratedGradientDescentRealization.delta,
      StochasticAcceleratedGradientDescentRealization.feasibleXUnderQuery,
      StochasticAcceleratedGradientDescentSetup.oracleNoise, SOptLib.dualNorm] using
      realization.delta_sq_integrable_from_random_query_variance run τ
  have hZ_sq_bound :
      ∫ ω, Z ω ^ 2 ∂realization.P ≤ setup.sigma ^ 2 := by
    simpa [Z] using realization.delta_sq_expectation_le_variance run τ
  have hZ_nonneg : ∀ᵐ ω ∂realization.P, 0 ≤ Z ω := by
    exact Filter.Eventually.of_forall (fun ω => by simp [Z, SOptLib.dualNorm])
  have hZ_meas : AEStronglyMeasurable Z realization.P :=
    AEStronglyMeasurable.of_integrable_sq_of_nonneg hZ_sq_int hZ_nonneg
  simpa [Z] using
    (integrable_sq_add_nonneg_of_integrable_sq_bound
      (μ := realization.P) (Z := Z) (M := setup.M) (sigma := setup.sigma)
      hZ_sq_int hZ_nonneg hZ_sq_bound)

/-! One-step integral bound for `Δ_t(x*)` from Lan Eq. (4.2.32), conditional
on the scalar martingale product being integrable. Considered
`finite_window_zero_mean_plus_quadratic_noise_integral_bound`,
`integral_finset_sum_const_mul_eq_zero`, and the local
`delta_inner_xStar_xPlus_integral_eq_zero`; the first two are window-level
packages, while the local cancellation theorem supplies zero mean but not the
separate `Integrable` fact needed to split this one-step Bochner integral. -/
private theorem acsa_delta_xstar_integral_bound_of_inner_integrable
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (realization :
      StochasticAcceleratedGradientDescentRealization (E := E) (S := S) setup Ω)
    (run :
      StochasticAcceleratedGradientDescentRealization.StochasticAcceleratedGradientDescentRunContract
        realization)
    (τ : {n : ℕ // 1 ≤ n})
    (hinner_int :
      Integrable
        (fun ω =>
          ⟪realization.delta run τ ω,
            setup.xStar - realization.xPlus run τ ω⟫_ℝ)
        realization.P) :
    Integrable (fun ω => realization.Delta run τ ω setup.xStar) realization.P ∧
      ∫ ω, realization.Delta run τ ω setup.xStar ∂realization.P ≤
        setup.alpha τ.1 * setup.gamma τ.1 *
          (setup.M ^ 2 + setup.sigma ^ 2) /
          (1 + setup.mu * setup.gamma τ.1 -
            setup.L * setup.alpha τ.1 * setup.gamma τ.1) := by
  let D : ℝ :=
    1 + setup.mu * setup.gamma τ.1 -
      setup.L * setup.alpha τ.1 * setup.gamma τ.1
  let squareTerm : Ω → ℝ := fun ω =>
    (setup.M + SOptLib.dualNorm (realization.delta run τ ω)) ^ 2
  let innerTerm : Ω → ℝ := fun ω =>
    ⟪realization.delta run τ ω,
      setup.xStar - realization.xPlus run τ ω⟫_ℝ
  let c : ℝ := setup.alpha τ.1 * setup.gamma τ.1 / (2 * D)
  have hDpos : 0 < D := by
    simpa [D] using setup.error_denominator_pos τ
  have hDne : D ≠ 0 := ne_of_gt hDpos
  have hsq :=
    acsa_delta_square_integrable_and_expectation_bound
      setup realization run τ
  have halpha_nonneg : 0 ≤ setup.alpha τ.1 :=
    (Set.mem_Icc.mp (run.halpha_mem_Icc τ)).1
  have hgamma_nonneg : 0 ≤ setup.gamma τ.1 :=
    le_of_lt (run.hgamma_pos τ)
  have hc_nonneg : 0 ≤ c := by
    dsimp [c]
    exact div_nonneg (mul_nonneg halpha_nonneg hgamma_nonneg)
      (mul_nonneg (by norm_num) (le_of_lt hDpos))
  have hbound :=
    stochastic_error_integral_bound_of_square_and_inner_zero
      (P := realization.P)
      (Delta := fun ω => realization.Delta run τ ω setup.xStar)
      (squareTerm := squareTerm)
      (innerTerm := innerTerm)
      (c := c)
      (a := setup.alpha τ.1)
      (B := 2 * (setup.M ^ 2 + setup.sigma ^ 2))
      (by
        filter_upwards with ω
        unfold StochasticAcceleratedGradientDescentRealization.Delta
        unfold SOptLib.acceleratedStochasticError
        dsimp [squareTerm, innerTerm, c, D]
        ring)
      (by simpa [squareTerm] using hsq.1)
      (by simpa [innerTerm] using hinner_int)
      (by simpa [squareTerm] using hsq.2)
      (by
        simpa [innerTerm] using
          realization.delta_inner_xStar_xPlus_integral_eq_zero run τ)
      (by simpa [c] using hc_nonneg)
  refine ⟨hbound.1, ?_⟩
  calc
    ∫ ω, realization.Delta run τ ω setup.xStar ∂realization.P
        ≤ c * (2 * (setup.M ^ 2 + setup.sigma ^ 2)) := hbound.2
    _ = setup.alpha τ.1 * setup.gamma τ.1 *
          (setup.M ^ 2 + setup.sigma ^ 2) / D := by
          dsimp [c]
          field_simp [hDne]

/-- Conditional realization form of Theorem 4.4's expected suboptimality bound.

This is not the unqualified source theorem: the head explicitly carries
`StochasticAcceleratedGradientDescentRunContract`, the disclosed realization
boundary for parameter admissibility, selected Eq. (4.2.6) argmins, and final
expected-gap well-definedness. The source-facing Theorem 4.4 statement should be
added only once those realization facts are derived rather than assumed. -/
theorem theorem_4_4_under_run_contract
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (realization : StochasticAcceleratedGradientDescentRealization (E := E) (S := S) setup Ω)
    (run :
      StochasticAcceleratedGradientDescentRealization.StochasticAcceleratedGradientDescentRunContract
        realization)
    (k : ℕ) (hk : 1 ≤ k) :
    SOptLib.expectationWellDefined realization.P
        (realization.expectedGapIntegrand run k) ∧
      realization.expectedGap run k ≤ realization.B_e run ⟨k, hk⟩ := by
  classical
    have hBe := realization.B_e_denominators_under_run_contract run ⟨k, hk⟩
    have hxPlusDen := fun t =>
      realization.xPlus_denominator_under_run_contract run t
    have hqRel := fun t =>
      realization.q_relation_under_run_contract run t
    have hWeightMono := fun t =>
      realization.weight_mono_under_run_contract run t
    have hGamma_pos :
        ∀ τ : {n : ℕ // 1 ≤ n}, 0 < setup.Gamma τ :=
      Gamma_pos_under_run_contract setup realization run
    have hGamma_pos_on_Icc :
        ∀ t, (ht : t ∈ Finset.Icc 1 k) →
          0 < setup.Gamma ⟨t, (Finset.mem_Icc.mp ht).1⟩ := by
      intro t ht
      exact hGamma_pos ⟨t, (Finset.mem_Icc.mp ht).1⟩
    have hDelta_sq_expectation :
        ∀ τ : {n : ℕ // 1 ≤ n},
          ∫ ω, SOptLib.dualNorm (realization.delta run τ ω) ^ 2 ∂realization.P ≤
            setup.sigma ^ 2 := by
      intro τ
      exact realization.delta_sq_expectation_le_variance run τ
    have hDelta_inner_cancel :
        ∀ τ : {n : ℕ // 1 ≤ n},
          ∫ ω, ⟪realization.delta run τ ω,
              setup.xStar - realization.xPlus run τ ω⟫_ℝ ∂realization.P = 0 := by
      intro τ
      exact (realization.delta_inner_xStar_xPlus_integrable_and_integral_eq_zero run τ).2
    have hDelta_inner_integrable :
        ∀ τ : {n : ℕ // 1 ≤ n},
          Integrable
            (fun ω =>
              ⟪realization.delta run τ ω,
                setup.xStar - realization.xPlus run τ ω⟫_ℝ)
            realization.P := by
      intro τ
      exact (realization.delta_inner_xStar_xPlus_integrable_and_integral_eq_zero run τ).1
    have hDelta_expectation_bound :
        ∀ τ : {n : ℕ // 1 ≤ n},
          Integrable (fun ω => realization.Delta run τ ω setup.xStar) realization.P ∧
            ∫ ω, realization.Delta run τ ω setup.xStar ∂realization.P ≤
              setup.alpha τ.1 * setup.gamma τ.1 *
                (setup.M ^ 2 + setup.sigma ^ 2) /
                (1 + setup.mu * setup.gamma τ.1 -
                  setup.L * setup.alpha τ.1 * setup.gamma τ.1) := by
      intro τ
      exact acsa_delta_xstar_integral_bound_of_inner_integrable
        setup realization run τ (hDelta_inner_integrable τ)
    have hLowerModel :
        ∀ ω,
          setup.Gamma ⟨k, hk⟩ *
              Finset.sum (Finset.Icc 1 k).attach (fun t =>
                let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
                setup.alpha t.1 / setup.Gamma τ *
                  realization.lPsi run τ ω setup.xStar) ≤
            setup.PsiStar := by
      intro ω
      exact lower_model_weighted_sum_le_PsiStar_under_run_contract
        setup realization run k hk ω
    have hPathwiseAfterLower :
        ∀ ω,
          realization.expectedGapIntegrand run k ω ≤
            setup.Gamma ⟨k, hk⟩ * (1 - setup.alpha 1) *
                setup.Psi (realization.xBarIter run 0 ω) +
              setup.Gamma ⟨k, hk⟩ *
                Finset.sum (Finset.Icc 1 k).attach (fun t =>
                  let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
                  setup.alpha t.1 / (setup.gamma t.1 * setup.Gamma τ) *
                    (setup.V (realization.xIter run (t.1 - 1) ω) setup.xStar -
                      (1 + setup.mu * setup.gamma t.1) *
                        setup.V (realization.xIter run t.1 ω) setup.xStar)) +
              setup.Gamma ⟨k, hk⟩ *
                Finset.sum (Finset.Icc 1 k).attach (fun t =>
                  let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
                  realization.Delta run τ ω setup.xStar / setup.Gamma τ) := by
      intro ω
      exact pathwise_after_lower_model_under_run_contract setup realization run k hk ω
    have hBregTel :
        ∀ ω,
          setup.Gamma ⟨k, hk⟩ *
              Finset.sum (Finset.Icc 1 k).attach (fun t =>
                let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
                setup.alpha t.1 / (setup.gamma t.1 * setup.Gamma τ) *
                  (setup.V (realization.xIter run (t.1 - 1) ω) setup.xStar -
                    (1 + setup.mu * setup.gamma t.1) *
                      setup.V (realization.xIter run t.1 ω) setup.xStar)) ≤
            acsaCheckedQuotient (setup.Gamma ⟨k, hk⟩) (setup.gamma 1) hBe.1 *
              setup.V setup.w0 setup.xStar := by
      intro ω
      let c : ℕ → ℝ := fun n =>
        if hn : 1 ≤ n then
          setup.alpha n / (setup.gamma n * setup.Gamma ⟨n, hn⟩)
        else 0
      let beta : ℕ → ℝ := fun n => 1 + setup.mu * setup.gamma n
      let Vseq : ℕ → ℝ := fun n =>
        setup.V (realization.xIter run n ω) setup.xStar
      have hV_nonneg : ∀ n, 0 ≤ Vseq n := by
        intro n
        have hx : realization.xIter run n ω ∈ setup.X := by
          simpa [StochasticAcceleratedGradientDescentRealization.xIter]
            using (realization.process run n ω).hx
        have hV := setup.V_lower (realization.xIter run n ω) hx
          setup.xStar setup.hxStar_mem
        have hsq_nonneg :
            0 ≤ (1 / 2 : ℝ) *
              ‖realization.xIter run n ω - setup.xStar‖ ^ 2 := by
          positivity
        exact le_trans hsq_nonneg hV
      have hc_mono : ∀ n, 1 ≤ n → c (n + 1) ≤ c n * beta n := by
        intro n hn
        have hmono := (hWeightMono ⟨n, hn⟩).2.2
        unfold acsaCheckedQuotient at hmono
        have hn1 : 1 ≤ n + 1 := Nat.succ_le_succ (Nat.zero_le n)
        simp [c, beta, hn, hn1, div_eq_mul_inv, mul_assoc, mul_left_comm,
          mul_comm] at hmono ⊢
        exact hmono
      have hcb_nonneg : ∀ n, 1 ≤ n → 0 ≤ c n * beta n := by
        intro n hn
        have halpha_nonneg : 0 ≤ setup.alpha n :=
          (Set.mem_Icc.mp (run.halpha_mem_Icc ⟨n, hn⟩)).1
        have hgamma_nonneg : 0 ≤ setup.gamma n :=
          le_of_lt (run.hgamma_pos ⟨n, hn⟩)
        have hGamma_nonneg : 0 ≤ setup.Gamma ⟨n, hn⟩ :=
          le_of_lt (hGamma_pos ⟨n, hn⟩)
        have hden_nonneg : 0 ≤ setup.gamma n * setup.Gamma ⟨n, hn⟩ :=
          mul_nonneg hgamma_nonneg hGamma_nonneg
        have hbeta_nonneg : 0 ≤ beta n := by
          dsimp [beta]
          have hmul : 0 ≤ setup.mu * setup.gamma n :=
            mul_nonneg setup.hmu_nonneg hgamma_nonneg
          linarith
        have hc_nonneg : 0 ≤ c n := by
          simp [c, hn]
          exact div_nonneg halpha_nonneg hden_nonneg
        exact mul_nonneg hc_nonneg hbeta_nonneg
      have hwindow_eq :
          Finset.sum (Finset.Icc 1 k).attach (fun t =>
              let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
              setup.alpha t.1 / (setup.gamma t.1 * setup.Gamma τ) *
                (setup.V (realization.xIter run (t.1 - 1) ω) setup.xStar -
                  (1 + setup.mu * setup.gamma t.1) *
                    setup.V (realization.xIter run t.1 ω) setup.xStar)) =
            Finset.sum (Finset.Icc 1 k).attach (fun t =>
              c t.1 * (Vseq (t.1 - 1) - beta t.1 * Vseq t.1)) := by
        refine Finset.sum_congr rfl ?_
        intro t ht
        have htpos : 1 ≤ t.1 := (Finset.mem_Icc.mp t.2).1
        simp [c, beta, Vseq, htpos]
      have htail_nonneg : 0 ≤ c k * beta k * Vseq k :=
        mul_nonneg (hcb_nonneg k hk) (hV_nonneg k)
      have hc_one : c 1 = 1 / setup.gamma 1 := by
        have hGamma1 : setup.Gamma ⟨1, le_rfl⟩ = 1 := by
          simpa [SOptLib.positiveTimeOne] using setup.Gamma_one
        simp [c, setup.alpha_one, hGamma1]
      have hV_zero : Vseq 0 = setup.V setup.w0 setup.xStar := by
        have hx0 : realization.xIter run 0 ω = setup.w0 := by
          simp [StochasticAcceleratedGradientDescentRealization.xIter,
            StochasticAcceleratedGradientDescentRealization.process_zero,
            StochasticAcceleratedGradientDescentSetup.initialState]
        simp [Vseq, hx0]
      have hbudget :
          setup.Gamma ⟨k, hk⟩ *
              Finset.sum (Finset.Icc 1 k).attach (fun t =>
                c t.1 * (Vseq (t.1 - 1) - beta t.1 * Vseq t.1)) ≤
            setup.Gamma ⟨k, hk⟩ / setup.gamma 1 *
              setup.V setup.w0 setup.xStar :=
        accelerated_bregman_window_le_initial_budget c beta Vseq
          (setup.Gamma ⟨k, hk⟩) (setup.gamma 1)
          (setup.V setup.w0 setup.xStar) k hk
          (le_of_lt (hGamma_pos ⟨k, hk⟩))
          (fun n hn hnk => hV_nonneg n)
          (fun n hn hnk => hc_mono n hn)
          htail_nonneg hc_one hV_zero
      calc
        setup.Gamma ⟨k, hk⟩ *
            Finset.sum (Finset.Icc 1 k).attach (fun t =>
              let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
              setup.alpha t.1 / (setup.gamma t.1 * setup.Gamma τ) *
                  (setup.V (realization.xIter run (t.1 - 1) ω) setup.xStar -
                    (1 + setup.mu * setup.gamma t.1) *
                      setup.V (realization.xIter run t.1 ω) setup.xStar))
            =
          setup.Gamma ⟨k, hk⟩ *
              Finset.sum (Finset.Icc 1 k).attach (fun t =>
                c t.1 * (Vseq (t.1 - 1) - beta t.1 * Vseq t.1)) := by
            rw [hwindow_eq]
        _ ≤ setup.Gamma ⟨k, hk⟩ / setup.gamma 1 *
              setup.V setup.w0 setup.xStar := hbudget
        _ = acsaCheckedQuotient (setup.Gamma ⟨k, hk⟩) (setup.gamma 1) hBe.1 *
              setup.V setup.w0 setup.xStar := by
            unfold acsaCheckedQuotient
            ring
    have hPointwiseAfterBregman :
        ∀ ω,
          realization.expectedGapIntegrand run k ω ≤
            acsaCheckedQuotient (setup.Gamma ⟨k, hk⟩) (setup.gamma 1) hBe.1 *
                setup.V setup.w0 setup.xStar +
              setup.Gamma ⟨k, hk⟩ *
                Finset.sum (Finset.Icc 1 k).attach (fun t =>
                  let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
                  realization.Delta run τ ω setup.xStar / setup.Gamma τ) := by
      intro ω
      have hp := hPathwiseAfterLower ω
      have hb := hBregTel ω
      have hfirst_zero :
          setup.Gamma ⟨k, hk⟩ * (1 - setup.alpha 1) *
              setup.Psi (realization.xBarIter run 0 ω) = 0 := by
        simp [setup.alpha_one]
      linarith
    letI : IsProbabilityMeasure realization.P := realization.hP
    let A : ℝ :=
      acsaCheckedQuotient (setup.Gamma ⟨k, hk⟩) (setup.gamma 1) hBe.1 *
        setup.V setup.w0 setup.xStar
    let Dterm : {t : ℕ // t ∈ Finset.Icc 1 k} → Ω → ℝ := fun t ω =>
      let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
      realization.Delta run τ ω setup.xStar / setup.Gamma τ
    let Dsum : Ω → ℝ := fun ω =>
      setup.Gamma ⟨k, hk⟩ *
        Finset.sum (Finset.Icc 1 k).attach (fun t => Dterm t ω)
    have hDterm_int :
        ∀ t ∈ (Finset.Icc 1 k).attach, Integrable (Dterm t) realization.P := by
      intro t ht
      let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
      have hbase :
          Integrable (fun ω => realization.Delta run τ ω setup.xStar)
            realization.P := (hDelta_expectation_bound τ).1
      have hscaled := hbase.const_mul (setup.Gamma τ)⁻¹
      refine hscaled.congr ?_
      filter_upwards with ω
