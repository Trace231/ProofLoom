/-- Typechecked prox-minimality and Bregman-square-control core used by the
uniform stability voucher.

This consumes the literal Eq. (4.2.6) prox predicate, proves search-point
feasibility from `q_t ∈ [0,1]`, obtains prox minimality against `x*`, exposes
the carrier subgradient and simple-convexity facts, and derives the symmetric
Bregman control of `‖x* - z‖²`. The remaining stability leaf is the uniform
coefficient extraction from these source facts, not feasibility or Bregman API
plumbing. -/
private theorem acsa_prox_step_pointwise_bregman_square_control
    (t : {n : ℕ // 1 ≤ n})
    (hq_mem : setup.q t.1 ∈ Set.Icc (0 : ℝ) 1)
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (ξ : S) (z : E)
    (hstep :
      setup.IsProxStep t prev.x (setup.searchPoint t prev)
        (setup.stochasticGradientOracle (setup.searchPoint t prev) ξ) z) :
    ∃ R : ℝ, ‖setup.xStar - z‖ ^ 2 ≤ R := by
  classical
  let xUnder := setup.searchPoint t prev
  let g := setup.stochasticGradientOracle xUnder ξ
  have hxUnder_mem : xUnder ∈ setup.X := by
    rcases Set.mem_Icc.mp hq_mem with ⟨hq_nonneg, hq_le_one⟩
    simpa [xUnder, StochasticAcceleratedGradientDescentSetup.searchPoint] using
      setup.hX_convex prev.hxBar prev.hx (sub_nonneg.mpr hq_le_one)
        hq_nonneg (by ring)
  have hstep' :
      setup.IsProxStep t prev.x xUnder g z := by
    simpa [xUnder, g] using hstep
  have hz_mem : z ∈ setup.X :=
    StochasticAcceleratedGradientDescentSetup.IsProxStep.mem
      (setup := setup) hstep'
  have hmin_xStar :
      setup.proxObjective t prev.x xUnder g z ≤
        setup.proxObjective t prev.x xUnder g setup.xStar :=
    setup.proxStep_minimizes_of_isProxStep t prev.x xUnder g z hstep'
      setup.xStar setup.hxStar_mem
  have hz_to_star :
      (1 / 2 : ℝ) * ‖z - setup.xStar‖ ^ 2 ≤ setup.V z setup.xStar :=
    setup.V_lower z hz_mem setup.xStar setup.hxStar_mem
  have hstar_to_z :
      (1 / 2 : ℝ) * ‖setup.xStar - z‖ ^ 2 ≤ setup.V setup.xStar z :=
    setup.V_lower setup.xStar setup.hxStar_mem z hz_mem
  have hsquare_from_V :
      ‖setup.xStar - z‖ ^ 2 ≤ 2 * setup.V setup.xStar z :=
    setup.sq_norm_le_two_V setup.xStar setup.hxStar_mem z hz_mem
  have hsquare_bregman :
      ‖z - setup.xStar‖ ^ 2 ≤ setup.V z setup.xStar + setup.V setup.xStar z := by
    simpa [id] using
      sq_norm_le_bregman_add_swap_of_half_lower_bound
        setup.V id z setup.xStar hz_to_star hstar_to_z
  have hsubgrad_xUnder :=
    SOptLib.mem_carrierSubdifferential_iff.mp
      (setup.hgradF_subgrad xUnder hxUnder_mem)
  have hsimple_convex :=
    IsAcsSimpleConvexTerm.convex setup.hh_simple
  exact ⟨2 * setup.V setup.xStar z, hsquare_from_V⟩

private theorem _voucher_step_acsa_searchPoint_mem_29
    (t : {n : ℕ // 1 ≤ n})
    (hq_mem : setup.q t.1 ∈ Set.Icc (0 : ℝ) 1)
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X) :
    setup.searchPoint t prev ∈ setup.X := by
  rcases Set.mem_Icc.mp hq_mem with ⟨hq_nonneg, hq_le_one⟩
  simpa [StochasticAcceleratedGradientDescentSetup.searchPoint] using
    setup.hX_convex prev.hxBar prev.hx (sub_nonneg.mpr hq_le_one)
      hq_nonneg (by ring)

private theorem _voucher_step_acsa_searchPoint_sq_distance_affine_bound_30
    (t : {n : ℕ // 1 ≤ n})
    (hq_mem : setup.q t.1 ∈ Set.Icc (0 : ℝ) 1)
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X) :
    ‖setup.xStar - setup.searchPoint t prev‖ ^ 2 ≤
      2 * ‖setup.xStar - prev.xBar‖ ^ 2 +
        2 * ‖setup.xStar - prev.x‖ ^ 2 := by
  rcases Set.mem_Icc.mp hq_mem with ⟨hq_nonneg, hq_le_one⟩
  let q := setup.q t.1
  let a := ‖setup.xStar - prev.xBar‖
  let b := ‖setup.xStar - prev.x‖
  have hq_nonneg' : 0 ≤ q := hq_nonneg
  have hq_le_one' : q ≤ 1 := hq_le_one
  have h1q_nonneg : 0 ≤ 1 - q := sub_nonneg.mpr hq_le_one'
  have hvec :
      setup.xStar - setup.searchPoint t prev =
        (1 - q) • (setup.xStar - prev.xBar) +
          q • (setup.xStar - prev.x) := by
    simp [StochasticAcceleratedGradientDescentSetup.searchPoint, q]
    module
  have hnorm :
      ‖setup.xStar - setup.searchPoint t prev‖ ≤
        (1 - q) * a + q * b := by
    calc
      ‖setup.xStar - setup.searchPoint t prev‖
          = ‖(1 - q) • (setup.xStar - prev.xBar) +
              q • (setup.xStar - prev.x)‖ := by rw [hvec]
      _ ≤ ‖(1 - q) • (setup.xStar - prev.xBar)‖ +
            ‖q • (setup.xStar - prev.x)‖ :=
          norm_add_le _ _
      _ = (1 - q) * a + q * b := by
          simp [a, b, norm_smul, Real.norm_of_nonneg h1q_nonneg,
            Real.norm_of_nonneg hq_nonneg']
  have hright_nonneg : 0 ≤ (1 - q) * a + q * b :=
    add_nonneg (mul_nonneg h1q_nonneg (norm_nonneg _))
      (mul_nonneg hq_nonneg' (norm_nonneg _))
  have hsquare :
      ‖setup.xStar - setup.searchPoint t prev‖ ^ 2 ≤
        ((1 - q) * a + q * b) ^ 2 := by
    nlinarith [hnorm, norm_nonneg (setup.xStar - setup.searchPoint t prev),
      hright_nonneg]
  have hsum_le : (1 - q) * a + q * b ≤ a + b := by
    have ha_nonneg : 0 ≤ a := norm_nonneg _
    have hb_nonneg : 0 ≤ b := norm_nonneg _
    nlinarith [hq_nonneg', hq_le_one', ha_nonneg, hb_nonneg]
  have hcombine :
      ((1 - q) * a + q * b) ^ 2 ≤ 2 * a ^ 2 + 2 * b ^ 2 := by
    have hab_sq : (a + b) ^ 2 ≤ 2 * a ^ 2 + 2 * b ^ 2 := by
      simpa [mul_add] using
        (add_sq_le : (a + b) ^ 2 ≤ 2 * (a ^ 2 + b ^ 2))
    have hab_nonneg : 0 ≤ a + b :=
      add_nonneg (norm_nonneg (setup.xStar - prev.xBar))
        (norm_nonneg (setup.xStar - prev.x))
    nlinarith [hsum_le, hright_nonneg, hab_nonneg, hab_sq]
  simpa [a, b] using hsquare.trans hcombine

private theorem _voucher_step_acsa_prox_pointwise_core_29
    (t : {n : ℕ // 1 ≤ n})
    (hq_mem : setup.q t.1 ∈ Set.Icc (0 : ℝ) 1)
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (ξ : S) (z : E)
    (hstep :
      setup.IsProxStep t prev.x (setup.searchPoint t prev)
        (setup.stochasticGradientOracle (setup.searchPoint t prev) ξ) z) :
    ∃ R : ℝ, ‖setup.xStar - z‖ ^ 2 ≤ R := by
  exact acsa_prox_step_pointwise_bregman_square_control
    (setup := setup) t hq_mem prev ξ z hstep

private theorem _voucher_step_acsa_prox_minimization_bound_to_xStar_34
    (t : {n : ℕ // 1 ≤ n})
    (hq_mem : setup.q t.1 ∈ Set.Icc (0 : ℝ) 1)
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (ξ : S) (z : E)
    (hstep :
      setup.IsProxStep t prev.x (setup.searchPoint t prev)
        (setup.stochasticGradientOracle (setup.searchPoint t prev) ξ) z) :
    let xUnder := setup.searchPoint t prev
    let g := setup.stochasticGradientOracle xUnder ξ
    let p : E → ℝ := fun u => setup.gamma t.1 * (⟪g, u⟫_ℝ + setup.h u)
    p z + (setup.gamma t.1 * setup.mu) * setup.V xUnder z +
        (1 : ℝ) * setup.V prev.x z ≤
      p setup.xStar + (setup.gamma t.1 * setup.mu) * setup.V xUnder setup.xStar +
          (1 : ℝ) * setup.V prev.x setup.xStar := by
  classical
  let xUnder := setup.searchPoint t prev
  let g := setup.stochasticGradientOracle xUnder ξ
  let p : E → ℝ := fun u => setup.gamma t.1 * (⟪g, u⟫_ℝ + setup.h u)
  have hmin :=
    setup.proxStep_minimizes_of_isProxStep t prev.x xUnder g z
      (by simpa [xUnder, g] using hstep) setup.xStar setup.hxStar_mem
  unfold StochasticAcceleratedGradientDescentSetup.proxObjective acsaProxObjective
    SOptLib.acceleratedCompositeProxObjective at hmin
  dsimp [p, xUnder, g] at hmin
  nlinarith

private theorem _voucher_step_acsa_linearized_composite_lower_bound_43
    (xUnder : E) (hxUnder : xUnder ∈ setup.X)
    (z : E) (hz : z ∈ setup.X) :
    -((setup.L / 2) * ‖z - xUnder‖ ^ 2 + setup.M * ‖z - xUnder‖) ≤
      ⟪setup.gradF xUnder, z - setup.xStar⟫_ℝ +
        setup.h z - setup.h setup.xStar := by
  classical
  have hopt :
      setup.f setup.xStar + setup.h setup.xStar ≤ setup.f z + setup.h z := by
    simpa [StochasticAcceleratedGradientDescentSetup.Psi,
      SOptLib.compositeObjective] using setup.hxStar_minimizes z hz
  have hsub :
      setup.f xUnder + ⟪setup.gradF xUnder, setup.xStar - xUnder⟫_ℝ ≤
        setup.f setup.xStar := by
    have hs :=
      (SOptLib.mem_carrierSubdifferential_iff.mp
        (setup.hgradF_subgrad xUnder hxUnder)) ⟨setup.xStar, setup.hxStar_mem⟩
    simpa [StochasticAcceleratedGradientDescentSetup.f] using hs
  have hcurv :
      setup.f z - setup.f xUnder -
          ⟪setup.gradF xUnder, z - xUnder⟫_ℝ ≤
        (setup.L / 2) * ‖z - xUnder‖ ^ 2 + setup.M * ‖z - xUnder‖ := by
    simpa [StochasticAcceleratedGradientDescentSetup.f] using
      (setup.hcurvature_model xUnder hxUnder z hz).2
  have hnonneg :
      0 ≤
        (setup.f z - setup.f xUnder -
            ⟪setup.gradF xUnder, z - xUnder⟫_ℝ) +
          (⟪setup.gradF xUnder, z - setup.xStar⟫_ℝ +
            setup.h z - setup.h setup.xStar) := by
    have hsupport_gap :
        0 ≤ setup.f setup.xStar - setup.f xUnder -
          ⟪setup.gradF xUnder, setup.xStar - xUnder⟫_ℝ := by
      nlinarith [hsub]
    have hobjective_gap :
        0 ≤ setup.f z + setup.h z -
          (setup.f setup.xStar + setup.h setup.xStar) := by
      nlinarith [hopt]
    have hidentity :
        (setup.f z - setup.f xUnder -
            ⟪setup.gradF xUnder, z - xUnder⟫_ℝ) +
          (⟪setup.gradF xUnder, z - setup.xStar⟫_ℝ +
            setup.h z - setup.h setup.xStar) =
        (setup.f z + setup.h z -
            (setup.f setup.xStar + setup.h setup.xStar)) +
          (setup.f setup.xStar - setup.f xUnder -
            ⟪setup.gradF xUnder, setup.xStar - xUnder⟫_ℝ) := by
      rw [inner_sub_right, inner_sub_right, inner_sub_right]
      ring
    rw [hidentity]
    nlinarith [hsupport_gap, hobjective_gap]
  nlinarith [hcurv, hnonneg]

private theorem _voucher_step_oracle_noise_decomp_46
    (x : E) (ξ : S) :
