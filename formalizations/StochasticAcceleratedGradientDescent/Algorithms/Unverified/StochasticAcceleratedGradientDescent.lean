    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (t : {n : ℕ // 1 ≤ n}) :
      acsaCheckedQuotient
          (setup.alpha (t.1 + 1))
          (setup.gamma (t.1 + 1) *
            setup.Gamma ⟨t.1 + 1, Nat.succ_le_succ (Nat.zero_le t.1)⟩)
          (generated_weight_denominator_ne (setup := setup) execution
            ⟨t.1 + 1, Nat.succ_le_succ (Nat.zero_le t.1)⟩) ≤
        acsaCheckedQuotient
          (setup.alpha t.1 * (1 + setup.mu * setup.gamma t.1))
          (setup.gamma t.1 * setup.Gamma t)
          (generated_weight_denominator_ne (setup := setup) execution t) := by
  let GammaNat : ℕ → ℝ := fun n =>
    if hn : 1 ≤ n then setup.Gamma ⟨n, hn⟩ else 1
  have htpos : 1 ≤ t.1 := t.2
  have htnextpos : 1 ≤ t.1 + 1 := Nat.succ_le_succ (Nat.zero_le t.1)
  have hnext_pos :
      0 <
        setup.gamma (t.1 + 1) *
          setup.Gamma ⟨t.1 + 1, Nat.succ_le_succ (Nat.zero_le t.1)⟩ := by
    exact mul_pos
      (execution.hgamma_pos
        ⟨t.1 + 1, Nat.succ_le_succ (Nat.zero_le t.1)⟩)
      (generated_Gamma_pos (setup := setup) execution
        ⟨t.1 + 1, Nat.succ_le_succ (Nat.zero_le t.1)⟩)
  have hcurr_pos :
      0 < setup.gamma t.1 * setup.Gamma t := by
    exact mul_pos (execution.hgamma_pos t)
      (generated_Gamma_pos (setup := setup) execution t)
  have hmono := setup.weight_mono_displayed t
  simpa [acsaCheckedQuotient] using
    (div_le_div_iff₀ hnext_pos hcurr_pos).2 hmono

/-- Internal bridge from a source-generated execution to the corrected
conditional proof engine.

The theorem consumes named generated-run leaves for expected-gap
integrability, Eq. (4.2.32) scalar-product integrability, oracle-residual
measurability, and denominator semantics. This keeps those proof obligations
visible as smaller declarations instead of hiding them in `theorem_4_4` or
copying them into `SourceGeneratedAcsExecution`. -/
noncomputable def source_generated_execution_to_run_contract
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (hGapMeas :
      ∀ k : ℕ,
        AEStronglyMeasurable
          (realization.generatedExpectedGapIntegrand execution k)
          realization.P)
    (hDeltaInner :
      ∀ (proc : ℕ → Ω →
          FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X),
        proc = realization.generatedProcess execution →
        ∀ t : {n : ℕ // 1 ≤ n},
          Integrable
            (fun ω =>
              let xPrev := (proc (t.1 - 1) ω).x
              let xBarPrev := (proc (t.1 - 1) ω).xBar
              let xUnder := (1 - setup.q t.1) • xBarPrev + setup.q t.1 • xPrev
              let xPlus :=
                acsaCheckedQuotient (setup.mu * setup.gamma t.1)
                    (1 + setup.mu * setup.gamma t.1)
                    (by
                      have hpos : 0 < 1 + setup.mu * setup.gamma t.1 := by
                        have hγ_nonneg : 0 ≤ setup.gamma t.1 :=
                          le_of_lt (execution.hgamma_pos t)
                        have hmul : 0 ≤ setup.mu * setup.gamma t.1 :=
                          mul_nonneg setup.hmu_nonneg hγ_nonneg
                        linarith
                      exact ne_of_gt hpos) •
                  xUnder +
                acsaCheckedQuotient 1
                    (1 + setup.mu * setup.gamma t.1)
                    (by
                      have hpos : 0 < 1 + setup.mu * setup.gamma t.1 := by
                        have hγ_nonneg : 0 ≤ setup.gamma t.1 :=
                          le_of_lt (execution.hgamma_pos t)
                        have hmul : 0 ≤ setup.mu * setup.gamma t.1 :=
                          mul_nonneg setup.hmu_nonneg hγ_nonneg
                        linarith
                      exact ne_of_gt hpos) •
                  xPrev
              ⟪setup.oracleNoise xUnder (realization.xi t.1 ω),
                setup.xStar - xPlus⟫_ℝ)
            realization.P) :
    StochasticAcceleratedGradientDescentRunContract realization := by
  classical
  refine
    { hq_mem_Icc := execution.hq_mem_Icc
      halpha_mem_Icc := execution.halpha_mem_Icc
      hgamma_pos := execution.hgamma_pos
      hq_relation_left_denominator_ne :=
        generated_q_relation_left_denominator_ne (setup := setup) execution
      hq_relation_right_denominator_ne :=
        generated_q_relation_right_denominator_ne (setup := setup) execution
      hweight_denominator_ne :=
        generated_weight_denominator_ne (setup := setup) execution
      hq_relation_semantics :=
        generated_q_relation_semantics (setup := setup) execution
      hweight_mono_semantics :=
        generated_weight_mono_semantics (setup := setup) execution
      proxStepKernel := execution.proxStepKernel
      proxStepKernel_measurable := execution.proxStepKernel_measurable
      proxStepKernel_spec := execution.proxStepKernel_spec
      proxStep := SourceGeneratedAcsExecution.proxStep realization execution
      proxStep_eq_kernel :=
        SourceGeneratedAcsExecution.proxStep_eq_kernel realization execution
      oracleNoise_feasible_joint_measurable :=
        generated_oracleNoise_feasible_joint_measurable (setup := setup) execution
      proxStep_spec :=
        SourceGeneratedAcsExecution.proxStep_spec realization execution
      expectedGapAEStronglyMeasurable := ?_
      delta_xStar_xPlus_inner_integrable := ?_ }
  · intro k
    simpa [generatedExpectedGapIntegrand, generatedOutput, generatedProcess,
      SourceGeneratedAcsExecution.stepFromState] using
      hGapMeas k
  · intro proc hproc t
    exact hDeltaInner proc
      (by
        simpa [generatedProcess, SourceGeneratedAcsExecution.stepFromState] using hproc) t

end StochasticAcceleratedGradientDescentRealization

/-! Used in: `proposition_4_2_under_run_contract` (composite upper-model step). -/
theorem lemma_4_4
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    {alpha_t : ℝ} (halpha : alpha_t ∈ Set.Icc (0 : ℝ) 1)
    {xBarPrev x_t z : E}
    (hxBarPrev : xBarPrev ∈ setup.X)
    (hx_t : x_t ∈ setup.X)
    (hz : z ∈ setup.X) :
    setup.Psi ((1 - alpha_t) • xBarPrev + alpha_t • x_t) ≤
      (1 - alpha_t) * setup.Psi xBarPrev +
        alpha_t * (setup.f z + ⟪setup.gradF z, x_t - z⟫_ℝ + setup.h x_t) +
        (setup.L / 2) * ‖((1 - alpha_t) • xBarPrev + alpha_t • x_t) - z‖ ^ 2 +
        setup.M * ‖((1 - alpha_t) • xBarPrev + alpha_t • x_t) - z‖ := by
  let y : E := (1 - alpha_t) • xBarPrev + alpha_t • x_t
  rcases Set.mem_Icc.mp halpha with ⟨ha0, ha1⟩
  have h1ma : 0 ≤ 1 - alpha_t := sub_nonneg.mpr ha1
  have hsum : (1 - alpha_t) + alpha_t = 1 := by ring
  have hy : y ∈ setup.X := by
    simpa [y] using setup.hX_convex hxBarPrev hx_t h1ma ha0 hsum
  have hfcurv :
      setup.f y ≤ setup.f z + ⟪setup.gradF z, y - z⟫_ℝ +
        (setup.L / 2) * ‖y - z‖ ^ 2 + setup.M * ‖y - z‖ := by
    have hcurv := (setup.hcurvature_model z hz y hy).2
    unfold StochasticAcceleratedGradientDescentSetup.f
    linarith
  have hsupport :
      setup.f z + ⟪setup.gradF z, xBarPrev - z⟫_ℝ ≤ setup.f xBarPrev := by
    have hsub :=
      (SOptLib.mem_carrierSubdifferential_iff.mp (setup.hgradF_subgrad z hz))
        ⟨xBarPrev, hxBarPrev⟩
    unfold StochasticAcceleratedGradientDescentSetup.f
    linarith
  simpa [StochasticAcceleratedGradientDescentSetup.Psi, y] using
    SOptLib.composite_upper_model_at_convex_average
      (X := setup.X) (f := setup.f) (h := setup.h) (gradF := setup.gradF)
      (L := setup.L) (M := setup.M) (alpha := alpha_t)
      (xBarPrev := xBarPrev) (xNext := x_t) (z := z)
      (IsAcsSimpleConvexTerm.convex setup.hh_simple) halpha
      hxBarPrev hx_t hfcurv hsupport

