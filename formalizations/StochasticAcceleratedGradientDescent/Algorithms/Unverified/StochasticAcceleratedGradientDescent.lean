/-- Pure denominator-budget enlargement for the AC-SA completion-square tail.

This is a proof-serving scalar bridge for Lan Eq. (4.2.19)'s denominator term.
Considered the existing completion-square helpers
`acsa_delta_completion_square_route_local` and `acsa_delta_completion_square`;
they produce the source tail itself, while this helper only converts the
resulting `γ (M + ‖δ‖)^2 / den` expression into deliberately widened private
budget constants. -/
private theorem acsa_den_dualnorm_budget_enlarge
    {M γ den n : ℝ}
    (hM : 0 ≤ M) (hγ : 0 ≤ γ) (hden : 0 < den) (hn : 0 ≤ n) :
    γ * (M + n) ^ 2 / (2 * den) ≤
      (γ ^ 2 + 1) * (den⁻¹ ^ 2 + 1) * (M ^ 2 + n ^ 2 + 1) := by
  have hden_ne : den ≠ 0 := ne_of_gt hden
  have hden_inv_nonneg : 0 ≤ den⁻¹ := inv_nonneg.mpr (le_of_lt hden)
  have hgamma_sq_one_nonneg : 0 ≤ γ ^ 2 + 1 := by
    nlinarith [sq_nonneg γ]
  have hden_budget_nonneg : 0 ≤ den⁻¹ ^ 2 + 1 := by
    nlinarith [sq_nonneg den⁻¹]
  have hsum_nonneg : 0 ≤ M ^ 2 + n ^ 2 := by
    nlinarith [sq_nonneg M, sq_nonneg n]
  have hsum_budget_nonneg : 0 ≤ M ^ 2 + n ^ 2 + 1 := by
    nlinarith [sq_nonneg M, sq_nonneg n]
  have hsquare : (M + n) ^ 2 ≤ 2 * (M ^ 2 + n ^ 2) := by
    nlinarith [sq_nonneg (M - n)]
  have hleft :
      γ * (M + n) ^ 2 / (2 * den) ≤ γ * (M ^ 2 + n ^ 2) / den := by
    have hcoef : 0 ≤ γ / (2 * den) := by positivity
    have hmul := mul_le_mul_of_nonneg_left hsquare hcoef
    convert hmul using 1 <;> field_simp [hden_ne] <;> ring
  have hgamma_le : γ ≤ γ ^ 2 + 1 := by
    nlinarith [sq_nonneg (γ - 1 / 2)]
  have hden_inv_le : den⁻¹ ≤ den⁻¹ ^ 2 + 1 := by
    nlinarith [sq_nonneg (den⁻¹ - 1 / 2)]
  have hcoef_le :
      γ * den⁻¹ ≤ (γ ^ 2 + 1) * (den⁻¹ ^ 2 + 1) :=
    mul_le_mul hgamma_le hden_inv_le hden_inv_nonneg hgamma_sq_one_nonneg
  have hsum_le : M ^ 2 + n ^ 2 ≤ M ^ 2 + n ^ 2 + 1 := by linarith
  have hbudget :
      (γ * den⁻¹) * (M ^ 2 + n ^ 2) ≤
        ((γ ^ 2 + 1) * (den⁻¹ ^ 2 + 1)) * (M ^ 2 + n ^ 2 + 1) :=
    mul_le_mul hcoef_le hsum_le hsum_nonneg
      (mul_nonneg hgamma_sq_one_nonneg hden_budget_nonneg)
  calc
    γ * (M + n) ^ 2 / (2 * den)
        ≤ γ * (M ^ 2 + n ^ 2) / den := hleft
    _ = (γ * den⁻¹) * (M ^ 2 + n ^ 2) := by
      field_simp [hden_ne]
    _ ≤ ((γ ^ 2 + 1) * (den⁻¹ ^ 2 + 1)) * (M ^ 2 + n ^ 2 + 1) := hbudget
    _ = (γ ^ 2 + 1) * (den⁻¹ ^ 2 + 1) * (M ^ 2 + n ^ 2 + 1) := by ring

