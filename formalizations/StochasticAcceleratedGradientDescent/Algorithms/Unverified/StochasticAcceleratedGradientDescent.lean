  calc
    r ^ 2
        ≤ 4 * (A * St + C + γ * (B * St + B0) + Q * N) / c :=
          hscale_div
    _ = 4 * A * St * c⁻¹ + 4 * C * c⁻¹ +
          4 * γ * B * St * c⁻¹ + 4 * γ * B0 * c⁻¹ +
          4 * Q * N * c⁻¹ := by
