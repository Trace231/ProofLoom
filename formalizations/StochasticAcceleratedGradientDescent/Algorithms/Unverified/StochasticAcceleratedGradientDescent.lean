          have hrewrite :
              setup.alpha t.1 • execution.proxStepKernel t prev ξ +
                  (1 - setup.alpha t.1) • prev.xBar =
                setup.averagePoint t prev (execution.proxStepKernel t prev ξ) := by
            unfold StochasticAcceleratedGradientDescentSetup.averagePoint
            abel
          simpa [← hrewrite, add_comm] using hconv
        simpa [StochasticAcceleratedGradientDescentSetup.Psi,
          SOptLib.compositeObjective] using
          setup.hxStar_minimizes
            (setup.averagePoint t prev (execution.proxStepKernel t prev ξ))
            hxBar_mem)
      (hmodel_le := by
        have hq_mem : setup.q t.1 ∈ Set.Icc (0 : ℝ) 1 :=
          execution.hq_mem_Icc t
        have hxUnder_mem : setup.searchPoint t prev ∈ setup.X := by
          simpa using
            _voucher_step_acsa_searchPoint_mem_29 (setup := setup) t hq_mem prev
        have hcurv_lower :
            setup.mu * setup.V (setup.searchPoint t prev) setup.xStar ≤
              setup.f setup.xStar - setup.f (setup.searchPoint t prev) -
                ⟪setup.gradF (setup.searchPoint t prev),
                  setup.xStar - setup.searchPoint t prev⟫_ℝ := by
          simpa [StochasticAcceleratedGradientDescentSetup.V,
            carrierBregmanFormula, StochasticAcceleratedGradientDescentSetup.f] using
            (setup.hcurvature_model (setup.searchPoint t prev) hxUnder_mem
              setup.xStar setup.hxStar_mem).1
        unfold StochasticAcceleratedGradientDescentSetup.Psi
          SOptLib.compositeObjective
        nlinarith [hcurv_lower])
      (hVz_lower := by
        have hstep' :
            setup.IsProxStep t prev.x (setup.searchPoint t prev)
              (setup.stochasticGradientOracle (setup.searchPoint t prev) ξ)
              (execution.proxStepKernel t prev ξ) := by
          simpa using execution.proxStepKernel_spec t prev ξ
        have hz_mem : execution.proxStepKernel t prev ξ ∈ setup.X :=
          StochasticAcceleratedGradientDescentSetup.IsProxStep.mem
            (setup := setup) hstep'
        exact setup.V_lower (execution.proxStepKernel t prev ξ) hz_mem
          setup.xStar setup.hxStar_mem)

/-- Generated one-step Proposition 4.2 recurrence retaining the Bregman
difference `V(x_{t-1}, x*) - (1 + μγ_t)V(x_t, x*)`.

This is the generated-kernel form of Lan Eq. (4.2.11) after specializing
`x = x*` and using the curvature model to eliminate `l_Ψ(underline{x}_t,x*)`.
It is the recurrence that should feed the Proposition 4.3 telescope; the
endpoint theorem above is only a later metric relaxation. -/
private theorem generated_prop42_xstar_bregman_recurrence
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (t : {n : ℕ // 1 ≤ n}) :
    ∀ (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
      (ξ : S),
      let xUnder : E := setup.searchPoint t prev
      let z : E := execution.proxStepKernel t prev ξ
      let η : E := setup.oracleNoise xUnder ξ
      let xPlus : E :=
        (setup.mu * setup.gamma t.1 / (1 + setup.mu * setup.gamma t.1)) • xUnder +
          (1 / (1 + setup.mu * setup.gamma t.1)) • prev.x
      let xBar : E := setup.averagePoint t prev z
      setup.Psi xBar - setup.Psi setup.xStar ≤
        (1 - setup.alpha t.1) *
            (setup.Psi prev.xBar - setup.Psi setup.xStar) +
          setup.alpha t.1 / setup.gamma t.1 *
            (setup.V prev.x setup.xStar -
              (1 + setup.mu * setup.gamma t.1) * setup.V z setup.xStar) +
          setup.alpha t.1 * setup.gamma t.1 * (setup.M + ‖η‖) ^ 2 /
            (2 * (1 + setup.mu * setup.gamma t.1 -
              setup.L * setup.alpha t.1 * setup.gamma t.1)) +
          setup.alpha t.1 * ⟪η, setup.xStar - xPlus⟫_ℝ := by
  classical
  intro prev ξ
  let γ : ℝ := setup.gamma t.1
  let xUnder : E := setup.searchPoint t prev
  let z : E := execution.proxStepKernel t prev ξ
  let g : E := setup.stochasticGradientOracle xUnder ξ
  let η : E := setup.oracleNoise xUnder ξ
  let p : E → ℝ := fun u => γ * (⟪g, u⟫_ℝ + setup.h u)
  let xPlus : E :=
    (setup.mu * γ / (1 + setup.mu * γ)) • xUnder +
      (1 / (1 + setup.mu * γ)) • prev.x
  let xBar : E := setup.averagePoint t prev z
  have hgamma_pos : 0 < γ := by
    simpa [γ] using execution.hgamma_pos t
  have hgamma_nonneg : 0 ≤ γ := le_of_lt hgamma_pos
  have halpha_mem : setup.alpha t.1 ∈ Set.Icc (0 : ℝ) 1 :=
    execution.halpha_mem_Icc t
  have halpha_nonneg : 0 ≤ setup.alpha t.1 := (Set.mem_Icc.mp halpha_mem).1
  have hq_mem : setup.q t.1 ∈ Set.Icc (0 : ℝ) 1 :=
    execution.hq_mem_Icc t
  have hxUnder_mem : xUnder ∈ setup.X := by
    simpa [xUnder] using
      _voucher_step_acsa_searchPoint_mem_29 (setup := setup) t hq_mem prev
  have hstep' : setup.IsProxStep t prev.x xUnder g z := by
    simpa [xUnder, g, z] using execution.proxStepKernel_spec t prev ξ
  have hz_mem : z ∈ setup.X :=
    StochasticAcceleratedGradientDescentSetup.IsProxStep.mem
      (setup := setup) hstep'
  have hxPlus_formula :
      xPlus =
        (setup.mu * γ / (1 + setup.mu * γ)) • xUnder +
          (1 / (1 + setup.mu * γ)) • prev.x := rfl
  have hxPlus_formula_setup :
      xPlus =
        (setup.mu * setup.gamma t.1 / (1 + setup.mu * setup.gamma t.1)) •
            setup.searchPoint t prev +
          (1 / (1 + setup.mu * setup.gamma t.1)) • prev.x := by
    simpa [xPlus, xUnder, γ]
  exact
    accelerated_composite_gap_recurrence_of_two_center_prox_step
      setup.X setup.Psi setup.f setup.h setup.V setup.gradF setup.gradNu
      (setup.alpha t.1) γ setup.mu setup.L setup.M
      prev.xBar prev.x xUnder z setup.xStar xPlus xBar g η
      halpha_nonneg hgamma_pos setup.hmu_nonneg
      (by
        refine ⟨setup.hX_convex, ?_⟩
        intro y hy w hw a b ha hb hab
        have hh := (IsAcsSimpleConvexTerm.convex setup.hh_simple).2 hy hw ha hb hab
        have hinner :
            ⟪g, a • y + b • w⟫_ℝ =
              a * ⟪g, y⟫_ℝ + b * ⟪g, w⟫_ℝ := by
          simp [inner_add_right, inner_smul_right]
        simp [p, hinner, smul_eq_mul]
        have hhconv : setup.h (a • y + b • w) ≤ a * setup.h y + b * setup.h w := by
          simpa [smul_eq_mul] using hh
        nlinarith [mul_le_mul_of_nonneg_left hhconv hgamma_nonneg])
      hz_mem setup.hxStar_mem
      (by
        simpa [xUnder, g, η,
          StochasticAcceleratedGradientDescentSetup.oracleNoise,
          StochasticAcceleratedGradientDescentSetup.stochasticGradientOracle] using
          _voucher_step_oracle_noise_decomp_46 (setup := setup) xUnder ξ)
      (by
        intro a z u hz
        simpa using
          (_voucher_acsa_bregman_segment_difference_hasDerivWithinAt_zero
            (setup := setup) (x := a) (xp := z) (u := u) hz))
      (by
        intro a b c
        exact _voucher_acsa_bregman_three_point_identity setup a b c)
      (by
        intro u hu
        have hmin :=
          setup.proxStep_minimizes_of_isProxStep t prev.x xUnder g z hstep' u hu
        unfold StochasticAcceleratedGradientDescentSetup.proxObjective acsaProxObjective
          SOptLib.acceleratedCompositeProxObjective at hmin
        dsimp [p, γ, xUnder, g] at hmin
        nlinarith)
      (by
        simpa [xBar, xUnder, z] using
          acsa_average_under_eq_alpha_xnext_sub_xplus_deterministic
            (setup := setup) t hgamma_pos prev z xPlus hxPlus_formula_setup)
      (by
        have hUpperRaw :=
          acsa_lemma_4_4_route_local (setup := setup) halpha_mem prev.hxBar hz_mem hxUnder_mem
        have hbar :
            (1 - setup.alpha t.1) • prev.xBar + setup.alpha t.1 • z = xBar := by
          rfl
        rw [hbar] at hUpperRaw
        simpa [xBar, xUnder, pow_two] using hUpperRaw)
      (acsa_weighted_bregman_absorbs_xplus_sq_deterministic (setup := setup)
        (xPrev := prev.x) (xUnder := xUnder) (xNext := z) (xPlus := xPlus)
        (γ := γ) hgamma_pos prev.hx hxUnder_mem hz_mem hxPlus_formula)
      (by
        have hden_source_pos :
            0 < 1 + setup.mu * γ - setup.L * setup.alpha t.1 * γ := by
          simpa [γ] using setup.error_denominator_pos t
        simpa [SOptLib.dualNorm_eq_norm] using
          acsa_delta_completion_square_route_local (E := E)
            (M := setup.M) (gamma := γ)
            (D := 1 + setup.mu * γ - setup.L * setup.alpha t.1 * γ)
            (a := setup.alpha t.1) (δ := η) (d := z - xPlus)
            halpha_nonneg hgamma_pos hden_source_pos setup.hM_nonneg)
      (by
        have hcurv_lower :
            setup.mu * setup.V xUnder setup.xStar ≤
              setup.f setup.xStar - setup.f xUnder -
                ⟪setup.gradF xUnder, setup.xStar - xUnder⟫_ℝ := by
          simpa [StochasticAcceleratedGradientDescentSetup.V,
            carrierBregmanFormula, StochasticAcceleratedGradientDescentSetup.f] using
            (setup.hcurvature_model xUnder hxUnder_mem setup.xStar
              setup.hxStar_mem).1
        unfold StochasticAcceleratedGradientDescentSetup.Psi
          SOptLib.compositeObjective
        nlinarith)


/-- Natural-time generated-process form of the Prop. 4.2 Bregman recurrence.

Aligns with Lan Prop. 4.2 / Eq. (4.2.11) at `x = x*`, transported across
Eqs. (4.2.5)-(4.2.7) and Eq. (4.2.14).  Considered
`generated_prop42_xstar_bregman_recurrence`,
`generated_process_components_at_nat_succ`, `generated_xplus_raw_at_nat_succ`,
and SOptLib Bregman/telescope candidates; the first is the raw source step and
the two generated-process bridges provide the required natural-time transport,
while SOptLib has no paper-specific generated AC-SA recurrence with this
`Delta` term. -/
private theorem generated_bregman_recurrence_at_process_time
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (ω : Ω) (t : ℕ) (ht : 1 ≤ t) :
    setup.Psi (realization.generatedProcess execution t ω).xBar -
        setup.Psi setup.xStar ≤
      (1 - setup.alpha t) *
          (setup.Psi (realization.generatedProcess execution (t - 1) ω).xBar -
            setup.Psi setup.xStar) +
        setup.alpha t / setup.gamma t *
          (setup.V (realization.generatedProcess execution (t - 1) ω).x
              setup.xStar -
            (1 + setup.mu * setup.gamma t) *
              setup.V (realization.generatedProcess execution t ω).x
                setup.xStar) +
        setup.alpha ((t - 1) + 1) * setup.gamma ((t - 1) + 1) *
          (setup.M +
            ‖setup.oracleNoise
              (realization.generatedXUnder execution
                (SOptLib.natSuccPositiveTime (t - 1)) ω)
              (realization.xi ((t - 1) + 1) ω)‖) ^ 2 /
            (2 * (1 + setup.mu * setup.gamma ((t - 1) + 1) -
              setup.L * setup.alpha ((t - 1) + 1) *
                setup.gamma ((t - 1) + 1))) +
        setup.alpha ((t - 1) + 1) *
          ⟪setup.oracleNoise
              (realization.generatedXUnder execution
                (SOptLib.natSuccPositiveTime (t - 1)) ω)
              (realization.xi ((t - 1) + 1) ω),
            setup.xStar -
              realization.generatedXPlus execution
                (SOptLib.natSuccPositiveTime (t - 1)) ω⟫_ℝ := by
  exact positive_time_bregman_recurrence_transport
    (process := realization.generatedProcess execution)
    (stateX :=
      fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X => s.x)
    (stateXBar :=
      fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X => s.xBar)
    (sample := realization.xi)
    (rawXNext := fun τ prev ξ => execution.proxStepKernel τ prev ξ)
    (rawXBar := fun τ prev ξ =>
      setup.averagePoint τ prev (execution.proxStepKernel τ prev ξ))
    (rawXPlus := fun τ prev _ =>
      (setup.mu * setup.gamma τ.1 / (1 + setup.mu * setup.gamma τ.1)) •
          setup.searchPoint τ prev +
        (1 / (1 + setup.mu * setup.gamma τ.1)) • prev.x)
    (rawDelta := fun τ prev ξ => setup.oracleNoise (setup.searchPoint τ prev) ξ)
    (xPlus := realization.generatedXPlus execution)
    (delta := fun τ ω =>
      setup.oracleNoise (realization.generatedXUnder execution τ ω)
        (realization.xi τ.1 ω))
    (Psi := setup.Psi) (V := setup.V)
    (alpha := setup.alpha) (gamma := setup.gamma) (mu := setup.mu)
    (L := setup.L) (M := setup.M) (xRef := setup.xStar)
    (ω := ω) (t := t) (ht := ht)
    (hcurrX := by
      simpa using
        (generated_process_components_at_nat_succ
          (realization := realization) (setup := setup) execution ω t ht).1.symm)
    (hcurrBar := by
      simpa using
        (generated_process_components_at_nat_succ
          (realization := realization) (setup := setup) execution ω t ht).2.1.symm)
    (hxPlus := by
      simpa using
        generated_xplus_raw_at_nat_succ
          (realization := realization) (setup := setup) execution ω t ht)
    (hdelta := by
      have hcomp :=
        generated_process_components_at_nat_succ
          (realization := realization) (setup := setup) execution ω t ht
      simpa using
        congrArg
          (fun y : E =>
            setup.oracleNoise y (realization.xi ((t - 1) + 1) ω))
          hcomp.2.2)
    (hraw := by
      let τ : {m : ℕ // 1 ≤ m} := SOptLib.natSuccPositiveTime (t - 1)
      exact generated_prop42_xstar_bregman_recurrence
        (setup := setup) execution τ (realization.generatedProcess execution (t - 1) ω)
        (realization.xi τ.1 ω))

/-- One-step state-square handoff from the Bregman recurrence.

This is the local bridge that the endpoint-only recurrence could not provide:
the negative `V(z,x*)` term is still present, so the paper's DGF lower bound
`setup.sq_norm_le_two_V` converts it into control of the next state before the
finite-window telescope removes the Bregman boundary. -/
private theorem generated_prop42_xstar_bregman_state_step
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (t : {n : ℕ // 1 ≤ n}) :
    ∀ (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
      (ξ : S),
      let xUnder : E := setup.searchPoint t prev
      let z : E := execution.proxStepKernel t prev ξ
      let η : E := setup.oracleNoise xUnder ξ
      let xPlus : E :=
        (setup.mu * setup.gamma t.1 / (1 + setup.mu * setup.gamma t.1)) • xUnder +
          (1 / (1 + setup.mu * setup.gamma t.1)) • prev.x
      let xBar : E := setup.averagePoint t prev z
      setup.alpha t.1 * (1 + setup.mu * setup.gamma t.1) /
          (2 * setup.gamma t.1) * ‖z - setup.xStar‖ ^ 2 ≤
        (1 - setup.alpha t.1) *
            (setup.Psi prev.xBar - setup.Psi setup.xStar) +
          setup.alpha t.1 / setup.gamma t.1 * setup.V prev.x setup.xStar +
          setup.alpha t.1 * setup.gamma t.1 * (setup.M + ‖η‖) ^ 2 /
            (2 * (1 + setup.mu * setup.gamma t.1 -
              setup.L * setup.alpha t.1 * setup.gamma t.1)) +
          setup.alpha t.1 * ⟪η, setup.xStar - xPlus⟫_ℝ -
          (setup.Psi xBar - setup.Psi setup.xStar) := by
  intro prev ξ
  exact
    state_sq_step_of_bregman_recurrence
      (Psi := setup.Psi) (V := setup.V)
      (alpha := setup.alpha t.1) (gamma := setup.gamma t.1)
      (mu := setup.mu) (L := setup.L) (M := setup.M)
      (prevX := prev.x) (prevBar := prev.xBar)
      (z := execution.proxStepKernel t prev ξ) (xStar := setup.xStar)
      (xPlus :=
        (setup.mu * setup.gamma t.1 / (1 + setup.mu * setup.gamma t.1)) •
            setup.searchPoint t prev +
          (1 / (1 + setup.mu * setup.gamma t.1)) • prev.x)
      (xBar := setup.averagePoint t prev (execution.proxStepKernel t prev ξ))
      (eta := setup.oracleNoise (setup.searchPoint t prev) ξ)
      (by exact ne_of_gt (execution.hgamma_pos t))
      (by
        have hgamma_pos : 0 < setup.gamma t.1 := execution.hgamma_pos t
        have hgamma_nonneg : 0 ≤ setup.gamma t.1 := le_of_lt hgamma_pos
        have halpha_nonneg : 0 ≤ setup.alpha t.1 :=
          (Set.mem_Icc.mp (execution.halpha_mem_Icc t)).1
        have hc_nonneg : 0 ≤ 1 + setup.mu * setup.gamma t.1 := by
          have hmul : 0 ≤ setup.mu * setup.gamma t.1 :=
            mul_nonneg setup.hmu_nonneg hgamma_nonneg
          linarith
        positivity)
      (by
        have hq_mem : setup.q t.1 ∈ Set.Icc (0 : ℝ) 1 :=
          execution.hq_mem_Icc t
        have hxUnder_mem : setup.searchPoint t prev ∈ setup.X := by
          simpa using
            _voucher_step_acsa_searchPoint_mem_29 (setup := setup) t hq_mem prev
        have hstep' :
            setup.IsProxStep t prev.x (setup.searchPoint t prev)
              (setup.stochasticGradientOracle (setup.searchPoint t prev) ξ)
              (execution.proxStepKernel t prev ξ) := by
          simpa using execution.proxStepKernel_spec t prev ξ
        have hz_mem : execution.proxStepKernel t prev ξ ∈ setup.X :=
          StochasticAcceleratedGradientDescentSetup.IsProxStep.mem
            (setup := setup) hstep'
        simpa [norm_sub_rev] using
          setup.sq_norm_le_two_V (execution.proxStepKernel t prev ξ) hz_mem
            setup.xStar setup.hxStar_mem)
      (by
        simpa using
          generated_prop42_xstar_bregman_recurrence
            (setup := setup) execution t prev ξ)

/-- Affine transport from generated state L2 regularity to `x_{t-1}^+` L2.

This is the compiled Eq. (4.2.14) side of the new route; it reuses the existing
Mathlib `MemLp` affine-combination proof and does not require a pointwise
`‖x_t - x_{t-1}^+‖²` envelope. -/
private theorem generated_xStar_sub_xPlus_sq_integrable_from_state_l2_affine_transport
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (hstate :
      ∀ n : ℕ,
        Integrable
            (fun ω => ‖setup.xStar -
              (realization.generatedProcess execution n ω).x‖ ^ 2)
            realization.P ∧
          Integrable
            (fun ω => ‖setup.xStar -
              (realization.generatedProcess execution n ω).xBar‖ ^ 2)
            realization.P) :
    ∀ t : {n : ℕ // 1 ≤ n},
      Integrable
        (fun ω => ‖setup.xStar -
          realization.generatedXPlus execution t ω‖ ^ 2)
        realization.P := by
  exact realization.generated_xStar_sub_xPlus_sq_integrable_of_state_l2
    execution hstate

/-- Generated scalar Γ-telescope for a pathwise Prop. 4.2 recurrence.

This is the generated-execution analogue of the scalar core of Proposition
4.3.  It is intentionally stated over arbitrary scalar terms so the source
Prop. 4.2 recurrence can feed it without first manufacturing a full run
contract, whose integrability field is downstream of the current regularity
proof. -/
private theorem generated_prop43_xstar_finite_window_telescope
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (A L B D : ℕ → ℝ) (k : ℕ) (hk : 1 ≤ k)
    (hGamma_ne : ∀ t, (ht : 1 ≤ t) → setup.Gamma ⟨t, ht⟩ ≠ 0)
    (hstep : ∀ t, 1 ≤ t →
      A t ≤ (1 - setup.alpha t) * A (t - 1) + setup.alpha t * L t +
        setup.alpha t / setup.gamma t * B t + D t) :
    let GammaNat : ℕ → ℝ := fun n =>
      if hn : 1 ≤ n then setup.Gamma ⟨n, hn⟩ else 1
    A k - GammaNat k *
        Finset.sum (Finset.Icc 1 k)
          (fun t => setup.alpha t / GammaNat t * L t) ≤
      GammaNat k * (1 - setup.alpha 1) * A 0 +
        GammaNat k *
          Finset.sum (Finset.Icc 1 k)
            (fun t => setup.alpha t / (setup.gamma t * GammaNat t) * B t) +
        GammaNat k *
          Finset.sum (Finset.Icc 1 k)
            (fun t => D t / GammaNat t) := by
  classical
  let GammaNat : ℕ → ℝ := fun n =>
    if hn : 1 ≤ n then setup.Gamma ⟨n, hn⟩ else 1
  have hgamma_ne : ∀ t, 1 ≤ t → setup.gamma t ≠ 0 := by
    intro t ht
    exact ne_of_gt (execution.hgamma_pos ⟨t, ht⟩)
  have hGamma_ne_nat : ∀ t, 1 ≤ t → GammaNat t ≠ 0 := by
    intro t ht
    dsimp [GammaNat]
    simpa [ht] using hGamma_ne t ht
  have hGamma_one_nat : GammaNat 1 = 1 := by
    simpa [GammaNat, SOptLib.positiveTimeOne] using setup.Gamma_one
  have hGamma_succ_nat :
      ∀ t, 1 ≤ t → GammaNat (t + 1) = (1 - setup.alpha (t + 1)) * GammaNat t := by
    intro t ht
    have ht1 : 1 ≤ t + 1 := Nat.succ_le_succ (Nat.zero_le t)
    simp [GammaNat, ht, ht1, setup.Gamma_succ t ht]
  have halpha_le_one : ∀ t, 1 ≤ t → setup.alpha t ≤ 1 := by
    intro t ht
    exact (Set.mem_Icc.mp (execution.halpha_mem_Icc ⟨t, ht⟩)).2
  change
    A k - GammaNat k *
        Finset.sum (Finset.Icc 1 k)
          (fun t => setup.alpha t / GammaNat t * L t) ≤
      GammaNat k * (1 - setup.alpha 1) * A 0 +
        GammaNat k *
          Finset.sum (Finset.Icc 1 k)
            (fun t => setup.alpha t / (setup.gamma t * GammaNat t) * B t) +
        GammaNat k *
          Finset.sum (Finset.Icc 1 k)
            (fun t => D t / GammaNat t)
  exact
    finite_window_weighted_recurrence_telescope_with_tail_sums
      setup.alpha setup.gamma GammaNat A L B D k hk hgamma_ne hGamma_ne_nat
      hGamma_one_nat setup.alpha_one halpha_le_one hGamma_succ_nat hstep

/-- Prefix-local affine transport from predecessor state L2 to `x_{n}^+` L2.

Aligns with Lan Eq. (4.2.14).  Considered the target-file
`generated_xStar_sub_xPlus_sq_integrable_of_state_l2` and
`generated_xStar_sub_xPlus_sq_integrable_from_state_l2_affine_transport`, plus
SOptLib `memLp_two_iff_integrable_sq_norm`/`MemLp.const_smul`; the target-file
bridges require a full-horizon state premise, which is circular for the current
finite-window regularity proof, while the SOptLib lemmas provide exactly the
local affine `MemLp` closure used here. -/
private theorem generated_xplus_sq_integrable_of_previous_state_l2
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (n : ℕ)
    (hprev_x :
      Integrable
        (fun ω => ‖setup.xStar -
          (realization.generatedProcess execution n ω).x‖ ^ 2)
        realization.P)
    (hprev_xBar :
      Integrable
        (fun ω => ‖setup.xStar -
          (realization.generatedProcess execution n ω).xBar‖ ^ 2)
        realization.P) :
    Integrable
      (fun ω => ‖setup.xStar -
        realization.generatedXPlus execution (SOptLib.natSuccPositiveTime n) ω‖ ^ 2)
      realization.P := by
  classical
  letI : IsProbabilityMeasure realization.P := realization.hP
  let τ : {m : ℕ // 1 ≤ m} := SOptLib.natSuccPositiveTime n
  let den : ℝ := 1 + setup.mu * setup.gamma τ.1
