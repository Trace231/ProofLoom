/-- Affine-combination L2 bridge for generated `x_{t-1}^+`.

Once the previous AC-SA state is square-integrable, the multiplier
`x* - x_{t-1}^+` is square-integrable because `x_{t-1}^+` is a fixed affine
combination of `x̲_t`, `x_{t-1}`, and hence of `x̄_{t-1}` and `x_{t-1}`. -/
theorem generated_xStar_sub_xPlus_sq_integrable_of_state_l2
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (hstate :
      ∀ n : ℕ,
        Integrable
            (fun ω => ‖setup.xStar -
              (realization.generatedProcess execution n ω).x‖ ^ 2)
            realization.P ∧
          Integrable
            (fun ω => ‖setup.xStar -
              (realization.generatedProcess execution n ω).xBar‖ ^ 2)
            realization.P) :
    ∀ t : {n : ℕ // 1 ≤ n},
      Integrable
        (fun ω => ‖setup.xStar -
          realization.generatedXPlus execution t ω‖ ^ 2)
        realization.P := by
  intro t
  classical
  letI : IsProbabilityMeasure realization.P := realization.hP
  let n : ℕ := t.1 - 1
  let den : ℝ := 1 + setup.mu * setup.gamma t.1
  have hden_pos : 0 < den := by
    dsimp [den]
    have hγ_nonneg : 0 ≤ setup.gamma t.1 :=
      le_of_lt (execution.hgamma_pos t)
    have hmul : 0 ≤ setup.mu * setup.gamma t.1 :=
      mul_nonneg setup.hmu_nonneg hγ_nonneg
    linarith
  have hden_ne : den ≠ 0 := ne_of_gt hden_pos
  let a : ℝ := acsaCheckedQuotient (setup.mu * setup.gamma t.1) den hden_ne
  let b : ℝ := acsaCheckedQuotient 1 den hden_ne
  have hproc_sub :
      Measurable[realization.filtration.seq (n + 1)]
        (realization.generatedProcess execution n) :=
    realization.generatedProcess_measurable_wrt_samplePrefix execution n n le_rfl
  have hproc :
      Measurable (realization.generatedProcess execution n) :=
    hproc_sub.mono (realization.filtration.le (n + 1)) le_rfl
  have hcoord :
      Measurable
        (fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X =>
          (s.x, s.xBar)) :=
    feasible_state_coordinates_measurable (E := E) setup.X
  have hx_meas :
      Measurable
        (fun ω => (realization.generatedProcess execution n ω).x) :=
    hcoord.fst.comp hproc
  have hxBar_meas :
      Measurable
        (fun ω => (realization.generatedProcess execution n ω).xBar) :=
    hcoord.snd.comp hproc
  have hx_aemeas :
      AEStronglyMeasurable
        (fun ω => (realization.generatedProcess execution n ω).x) realization.P :=
    hx_meas.aestronglyMeasurable
  have hxBar_aemeas :
      AEStronglyMeasurable
        (fun ω => (realization.generatedProcess execution n ω).xBar) realization.P :=
    hxBar_meas.aestronglyMeasurable
  have hmain :=
    _root_.integrable_sq_norm_const_sub_two_stage_affine (μ := realization.P)
      setup.xStar
      (fun ω => (realization.generatedProcess execution n ω).x)
      (fun ω => (realization.generatedProcess execution n ω).xBar)
      (setup.q t.1) a b hx_aemeas hxBar_aemeas (hstate n).1 (hstate n).2
      (by
        change setup.mu * setup.gamma t.1 / den + 1 / den = 1
        calc
          setup.mu * setup.gamma t.1 / den + 1 / den
              = (setup.mu * setup.gamma t.1 + 1) / den := by ring
