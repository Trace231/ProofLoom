            (setup.hcurvature_model xUnder hxUnder_mem setup.xStar
              setup.hxStar_mem).1
        unfold StochasticAcceleratedGradientDescentSetup.Psi
          SOptLib.compositeObjective
        nlinarith [hcurv_lower])
      (setup.V_lower z hz_mem setup.xStar setup.hxStar_mem)

/-- Source-literal Proposition 4.2 boundary retaining the telescoping Bregman
