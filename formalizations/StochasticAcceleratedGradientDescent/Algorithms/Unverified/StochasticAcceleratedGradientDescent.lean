/-- Finite-horizon L2 regularity from a uniform one-step prox stability
estimate.

This is the recursive-process infrastructure behind the adapted multiplier
regularity in Eq. (4.2.32).  The induction uses
`generatedProcess_succ_eq_kernel_update`, the uniform one-step prox stability
estimate, the random-query variance theorem for `δ_t`, and closure of
integrability under finite sums and scalar affine operations. -/
theorem generated_state_sq_integrable_from_uniform_prox_stability
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup) :
    (∀ t : {n : ℕ // 1 ≤ n},
      ∃ A B D C : ℝ,
        0 ≤ A ∧ 0 ≤ B ∧ 0 ≤ D ∧ 0 ≤ C ∧
        ∀ (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
          (ξ : S),
          ‖setup.xStar -
              execution.proxStepKernel t prev ξ‖ ^ 2 ≤
            A * ‖setup.xStar - prev.x‖ ^ 2 +
            B * ‖setup.xStar - prev.xBar‖ ^ 2 +
            D * ‖setup.oracleNoise (setup.searchPoint t prev) ξ‖ ^ 2 + C) →
    ∀ n : ℕ,
      Integrable
          (fun ω => ‖setup.xStar -
            (realization.generatedProcess execution n ω).x‖ ^ 2)
          realization.P ∧
        Integrable
          (fun ω => ‖setup.xStar -
            (realization.generatedProcess execution n ω).xBar‖ ^ 2)
          realization.P := by
  intro hstab
  classical
  letI : IsProbabilityMeasure realization.P := realization.hP
  intro n
  induction n with
  | zero =>
      constructor
      · change Integrable (fun _ : Ω => ‖setup.xStar - setup.w0‖ ^ 2) realization.P
        exact integrable_const (c := ‖setup.xStar - setup.w0‖ ^ 2)
      · change Integrable (fun _ : Ω => ‖setup.xStar - setup.wbar0‖ ^ 2) realization.P
        exact integrable_const (c := ‖setup.xStar - setup.wbar0‖ ^ 2)
  | succ n ih =>
      let τ : {m : ℕ // 1 ≤ m} :=
        ⟨n + 1, Nat.succ_le_succ (Nat.zero_le n)⟩
      rcases hstab τ with ⟨A, B, D, C, hA_nonneg, hB_nonneg, hD_nonneg,
        hC_nonneg, hstabτ⟩
      have hproc_succ :
          realization.generatedProcess execution (n + 1) =
            fun ω =>
              SourceGeneratedAcsExecution.stepFromSample execution n
                (realization.generatedProcess execution n ω)
                (realization.xi (n + 1) ω) :=
        realization.generatedProcess_succ_eq_kernel_update execution n
      have hproc_meas :
          Measurable (realization.generatedProcess execution (n + 1)) := by
        have hproc_sub :
            Measurable[realization.filtration.seq ((n + 1) + 1)]
              (realization.generatedProcess execution (n + 1)) :=
          realization.generatedProcess_measurable_wrt_samplePrefix execution
            (n + 1) (n + 1) le_rfl
        exact hproc_sub.mono (realization.filtration.le ((n + 1) + 1)) le_rfl
      have hproc_prev_meas :
          Measurable (realization.generatedProcess execution n) := by
        have hproc_sub :
            Measurable[realization.filtration.seq (n + 1)]
              (realization.generatedProcess execution n) :=
          realization.generatedProcess_measurable_wrt_samplePrefix execution n n le_rfl
        exact hproc_sub.mono (realization.filtration.le (n + 1)) le_rfl
      have hcoord :
          Measurable
            (fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X =>
              (s.x, s.xBar)) :=
        feasible_state_coordinates_measurable (E := E) setup.X
      have hx_succ_meas :
          Measurable (fun ω => (realization.generatedProcess execution (n + 1) ω).x) :=
        hcoord.fst.comp hproc_meas
      have hxBar_succ_meas :
          Measurable (fun ω => (realization.generatedProcess execution (n + 1) ω).xBar) :=
        hcoord.snd.comp hproc_meas
      have hx_prev_meas :
          Measurable (fun ω => (realization.generatedProcess execution n ω).x) :=
        hcoord.fst.comp hproc_prev_meas
      have hxBar_prev_meas :
          Measurable (fun ω => (realization.generatedProcess execution n ω).xBar) :=
        hcoord.snd.comp hproc_prev_meas
      have hnoise_int :
          Integrable
            (fun ω =>
              ‖setup.oracleNoise
                  (setup.searchPoint τ (realization.generatedProcess execution n ω))
                  (realization.xi (n + 1) ω)‖ ^ 2)
            realization.P := by
        simpa [τ, generatedFeasibleXUnderQuery, generatedXUnder,
          StochasticAcceleratedGradientDescentSetup.oracleNoise,
          StochasticAcceleratedGradientDescentSetup.stochasticGradientOracle] using
          realization.generated_delta_sq_integrable_from_random_query_variance
            execution τ
      have hrhs_int :
          Integrable
            (fun ω =>
              A * ‖setup.xStar - (realization.generatedProcess execution n ω).x‖ ^ 2 +
                B * ‖setup.xStar - (realization.generatedProcess execution n ω).xBar‖ ^ 2 +
                D * ‖setup.oracleNoise
                    (setup.searchPoint τ (realization.generatedProcess execution n ω))
                    (realization.xi (n + 1) ω)‖ ^ 2 + C)
            realization.P := by
        exact (((ih.1.const_mul A).add (ih.2.const_mul B)).add
          (hnoise_int.const_mul D)).add (integrable_const (c := C))
      have hx_succ_sq_meas :
          AEStronglyMeasurable
            (fun ω => ‖setup.xStar -
              (realization.generatedProcess execution (n + 1) ω).x‖ ^ 2)
            realization.P :=
        ((measurable_const.sub hx_succ_meas).norm.pow_const 2).aestronglyMeasurable
      have hx_succ_int :
          Integrable
            (fun ω => ‖setup.xStar -
              (realization.generatedProcess execution (n + 1) ω).x‖ ^ 2)
            realization.P := by
        refine hrhs_int.mono' hx_succ_sq_meas (Filter.Eventually.of_forall ?_)
        intro ω
        have hstep :=
          hstabτ (realization.generatedProcess execution n ω) (realization.xi (n + 1) ω)
        have hsimp :
            (realization.generatedProcess execution (n + 1) ω).x =
              execution.proxStepKernel τ (realization.generatedProcess execution n ω)
                (realization.xi (n + 1) ω) := by
          have hω := congrFun hproc_succ ω
          simpa [SourceGeneratedAcsExecution.stepFromSample, τ] using congrArg
            (fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X => s.x) hω
        rw [Real.norm_of_nonneg (sq_nonneg
          ‖setup.xStar - (realization.generatedProcess execution (n + 1) ω).x‖)]
        simpa [hsimp, τ] using hstep
      have hx_succ_disp_meas :
          AEStronglyMeasurable
            (fun ω => setup.xStar -
              (realization.generatedProcess execution (n + 1) ω).x) realization.P :=
        (measurable_const.sub hx_succ_meas).aestronglyMeasurable
      have hx_succ_l2 :
          MemLp
            (fun ω => setup.xStar -
              (realization.generatedProcess execution (n + 1) ω).x) 2 realization.P :=
        (memLp_two_iff_integrable_sq_norm hx_succ_disp_meas).2 hx_succ_int
      have hxBar_prev_disp_meas :
          AEStronglyMeasurable
            (fun ω => setup.xStar -
              (realization.generatedProcess execution n ω).xBar) realization.P :=
        (measurable_const.sub hxBar_prev_meas).aestronglyMeasurable
      have hxBar_prev_l2 :
          MemLp
            (fun ω => setup.xStar -
              (realization.generatedProcess execution n ω).xBar) 2 realization.P :=
        (memLp_two_iff_integrable_sq_norm hxBar_prev_disp_meas).2 ih.2
      have hxBar_succ_combo_l2 :
          MemLp
            (fun ω =>
              (1 - setup.alpha (n + 1)) •
                  (setup.xStar - (realization.generatedProcess execution n ω).xBar) +
                setup.alpha (n + 1) •
                  (setup.xStar -
                    (realization.generatedProcess execution (n + 1) ω).x))
            2 realization.P :=
        (hxBar_prev_l2.const_smul (1 - setup.alpha (n + 1))).add
          (hx_succ_l2.const_smul (setup.alpha (n + 1)))
      have hxBar_succ_l2 :
          MemLp
            (fun ω => setup.xStar -
              (realization.generatedProcess execution (n + 1) ω).xBar) 2 realization.P := by
        refine MemLp.ae_eq (Filter.Eventually.of_forall ?_) hxBar_succ_combo_l2
        intro ω
        have hω := congrFun hproc_succ ω
        have hxbar_eq :
            (realization.generatedProcess execution (n + 1) ω).xBar =
              setup.averagePoint τ (realization.generatedProcess execution n ω)
                (execution.proxStepKernel τ (realization.generatedProcess execution n ω)
                  (realization.xi (n + 1) ω)) := by
          simpa [SourceGeneratedAcsExecution.stepFromSample, τ] using congrArg
            (fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X => s.xBar) hω
        have hx_eq :
            (realization.generatedProcess execution (n + 1) ω).x =
              execution.proxStepKernel τ (realization.generatedProcess execution n ω)
                (realization.xi (n + 1) ω) := by
          simpa [SourceGeneratedAcsExecution.stepFromSample, τ] using congrArg
            (fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X => s.x) hω
        simp [hxbar_eq, hx_eq, StochasticAcceleratedGradientDescentSetup.averagePoint,
          sub_add_eq_add_sub, sub_eq_add_neg, add_comm, add_left_comm, add_assoc,
          smul_add]
        module
      have hxBar_succ_int :
          Integrable
            (fun ω => ‖setup.xStar -
              (realization.generatedProcess execution (n + 1) ω).xBar‖ ^ 2)
            realization.P :=
        (memLp_two_iff_integrable_sq_norm hxBar_succ_l2.aestronglyMeasurable).1
          hxBar_succ_l2
      exact ⟨hx_succ_int, hxBar_succ_int⟩

/-
/-- Deterministic one-step AC-SA prox growth from the literal Eq. (4.2.6)
minimality condition.

This is the source-facing finite-dimensional regularity bridge needed before
applying `generated_state_sq_integrable_from_uniform_prox_stability`. It aligns
with Lan §4.2 around Eqs. (4.2.5)-(4.2.7): the searched SOptLib candidates
`SOptLib.proxStep_state_oracle_distance_bound` and
`prox_points_scaled_dist_le_oracle_dist_of_variational` cover one-Bregman
state/oracle stability, while this AC-SA step has the paper's two-center
objective, composite `h`, and curvature-model `gradF` term. -/
private theorem acsa_prox_step_state_growth_from_minimality
    (t : {n : ℕ // 1 ≤ n})
    (hq_mem : setup.q t.1 ∈ Set.Icc (0 : ℝ) 1)
    (halpha_mem : setup.alpha t.1 ∈ Set.Icc (0 : ℝ) 1)
    (hgamma_pos : 0 < setup.gamma t.1) :
    ∃ A B D C : ℝ,
      0 ≤ A ∧ 0 ≤ B ∧ 0 ≤ D ∧ 0 ≤ C ∧
      ∀ (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
        (ξ : S) (z : E),
        setup.IsProxStep t prev.x (setup.searchPoint t prev)
          (setup.stochasticGradientOracle (setup.searchPoint t prev) ξ) z →
        ‖setup.xStar - z‖ ^ 2 ≤
          A * ‖setup.xStar - prev.x‖ ^ 2 +
          B * ‖setup.xStar - prev.xBar‖ ^ 2 +
          D * ‖setup.oracleNoise (setup.searchPoint t prev) ξ‖ ^ 2 + C := by
  classical
  rcases AcsSimpleTermExpr.exists_lipschitz_eval
      setup.hh_simple.knownStructure with ⟨K, hK_nonneg, hK_lip⟩
  have hh_lip_on_X :
      ∀ x, x ∈ setup.X → ∀ y, y ∈ setup.X →
        |setup.h x - setup.h y| ≤ K * ‖x - y‖ := by
    intro x hx y hy
    have hraw := hK_lip x y
    simpa [setup.hh_simple.agreesOn x hx, setup.hh_simple.agreesOn y hy] using hraw
  have hgamma_nonneg : 0 ≤ setup.gamma t.1 := le_of_lt hgamma_pos
  have halpha_nonneg : 0 ≤ setup.alpha t.1 := (Set.mem_Icc.mp halpha_mem).1
  have halpha_le_one : setup.alpha t.1 ≤ 1 := (Set.mem_Icc.mp halpha_mem).2
  have hq_nonneg : 0 ≤ setup.q t.1 := (Set.mem_Icc.mp hq_mem).1
  have hq_le_one : setup.q t.1 ≤ 1 := (Set.mem_Icc.mp hq_mem).2
  rcases acsa_two_center_prox_growth_to_search_state (setup := setup) t hq_mem
      halpha_mem hgamma_pos K hK_nonneg hh_lip_on_X with
    ⟨A0, D0, C0, hA0, hD0, hC0, hsearch_bound⟩
  refine ⟨3 * A0, 2 * A0, D0, C0, ?_, ?_, hD0, hC0, ?_⟩
  · nlinarith
  · nlinarith
  intro prev ξ z hstep
  have hmain := hsearch_bound prev ξ z hstep
  have hsearch_sq :=
    _voucher_step_acsa_searchPoint_sq_distance_affine_bound_30
      (setup := setup) t hq_mem prev
  have hstate_nonneg : 0 ≤ ‖setup.xStar - prev.x‖ ^ 2 := sq_nonneg _
  have hbar_nonneg : 0 ≤ ‖setup.xStar - prev.xBar‖ ^ 2 := sq_nonneg _
  have hnoise_nonneg :
      0 ≤ ‖setup.oracleNoise (setup.searchPoint t prev) ξ‖ ^ 2 := sq_nonneg _
  nlinarith

/-- Kernel form of the deterministic AC-SA prox growth estimate.

This packages the source-generated selector with its `proxStepKernel_spec`, so
the recursive L2 theorem sees exactly the uniform one-step stability premise it
expects. -/
private theorem acsa_proxStepKernel_uniform_state_distance_bound
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (t : {n : ℕ // 1 ≤ n}) :
    ∃ A B D C : ℝ,
      0 ≤ A ∧ 0 ≤ B ∧ 0 ≤ D ∧ 0 ≤ C ∧
      ∀ (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
        (ξ : S),
        ‖setup.xStar - execution.proxStepKernel t prev ξ‖ ^ 2 ≤
          A * ‖setup.xStar - prev.x‖ ^ 2 +
          B * ‖setup.xStar - prev.xBar‖ ^ 2 +
          D * ‖setup.oracleNoise (setup.searchPoint t prev) ξ‖ ^ 2 + C := by
  rcases acsa_prox_step_state_growth_from_minimality (setup := setup) t
      (execution.hq_mem_Icc t) (execution.halpha_mem_Icc t)
      (execution.hgamma_pos t) with
    ⟨A, B, D, C, hA, hB, hD, hC, hbound⟩
  refine ⟨A, B, D, C, hA, hB, hD, hC, ?_⟩
  intro prev ξ
  exact hbound prev ξ (execution.proxStepKernel t prev ξ)
    (execution.proxStepKernel_spec t prev ξ)

