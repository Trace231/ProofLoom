/-- Generated-process scalar-product integrability for Eq. (4.2.32), reduced to
the L2 regularity of the adapted multiplier `x* - x_{t-1}^+`. -/
theorem generated_delta_xStar_xPlus_inner_integrable_of_xPlus_l2
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (hxPlus_l2 :
      ∀ t : {n : ℕ // 1 ≤ n},
        Integrable
          (fun ω => ‖setup.xStar - realization.generatedXPlus execution t ω‖ ^ 2)
          realization.P) :
    ∀ (proc : ℕ → Ω →
        FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X),
      proc = realization.generatedProcess execution →
      ∀ t : {n : ℕ // 1 ≤ n},
        Integrable
          (fun ω =>
            let xPrev := (proc (t.1 - 1) ω).x
            let xBarPrev := (proc (t.1 - 1) ω).xBar
            let xUnder := (1 - setup.q t.1) • xBarPrev + setup.q t.1 • xPrev
            let xPlus :=
              acsaCheckedQuotient (setup.mu * setup.gamma t.1)
                  (1 + setup.mu * setup.gamma t.1)
                  (by
                    have hpos : 0 < 1 + setup.mu * setup.gamma t.1 := by
                      have hγ_nonneg : 0 ≤ setup.gamma t.1 :=
                        le_of_lt (execution.hgamma_pos t)
                      have hmul : 0 ≤ setup.mu * setup.gamma t.1 :=
                        mul_nonneg setup.hmu_nonneg hγ_nonneg
                      linarith
                    exact ne_of_gt hpos) •
                xUnder +
              acsaCheckedQuotient 1
                  (1 + setup.mu * setup.gamma t.1)
                  (by
                    have hpos : 0 < 1 + setup.mu * setup.gamma t.1 := by
                      have hγ_nonneg : 0 ≤ setup.gamma t.1 :=
                        le_of_lt (execution.hgamma_pos t)
                      have hmul : 0 ≤ setup.mu * setup.gamma t.1 :=
                        mul_nonneg setup.hmu_nonneg hγ_nonneg
                      linarith
                    exact ne_of_gt hpos) •
                xPrev
            ⟪setup.oracleNoise xUnder (realization.xi t.1 ω),
              setup.xStar - xPlus⟫_ℝ)
          realization.P := by
  intro proc hproc t
  let u : Ω → E := fun ω =>
    setup.oracleNoise (realization.generatedXUnder execution t ω)
      (realization.xi t.1 ω)
  let v : Ω → E := fun ω =>
    setup.xStar - realization.generatedXPlus execution t ω
  have hu_meas : AEStronglyMeasurable u realization.P := by
    simpa [u] using
      realization.generated_delta_aestronglyMeasurable execution t
  have hv_meas : AEStronglyMeasurable v realization.P := by
