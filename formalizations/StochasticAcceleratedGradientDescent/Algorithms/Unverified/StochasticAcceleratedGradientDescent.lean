/-- Borel measurability bridge for a finite-dimensional closed-carrier convex
function once its carrier regularity is known.

The convexity and closed-carrier hypotheses are retained for callers that need
the source geometry, but the Borel conclusion is deliberately not derived from
convexity alone.  Iteration 41 established that Haar null-measurability of convex
sublevels is too weak for arbitrary generated-process laws. -/
theorem carrierConvexOn_measurable_of_closed
    {X : Set E} {φ : {x : E // x ∈ X} → ℝ}
    (hX_closed : IsClosed X)
    (hconv : ConvexOn ℝ X (SOptLib.totalizeOn X φ))
    (hmeas : Measurable φ) :
    Measurable φ := by
  classical
  exact hmeas

theorem PsiCarrier_measurable
    (hPsi : Measurable setup.PsiCarrier) :
    Measurable setup.PsiCarrier := by
  /- This is intentionally a theorem obligation, not a field of `Setup` or
     `IsAcsSimpleConvexTerm`.  Section 4.2 states that `f : X → ℝ` and `h` is
     simple convex with known structure, but the checked source text does not
     state Borel measurability as a primitive assumption.  A source-faithful
     proof must derive this carrier measurability from the selected concrete
     simple/objective structure, or keep the generated theorem conditional on
     explicit regularity instead of storing it in the paper setup. -/
  exact hPsi

/-- Canonical selected feasible minimizer of the paper composite objective over `X`.

Aligns with `SOptLib.objectiveMinimumOfFeasibleOptimizer`; unlike the earlier
theorem-backed choice wrapper, the selected `x*` is the paper optimum appearing
in Theorem 4.4 and the setup problem statement `Ψ* := min_{x ∈ X} Ψ(x)`. -/
noncomputable def PsiMinimum : SOptLib.ObjectiveMinimum setup.PsiCarrier :=
  SOptLib.objectiveMinimumOfFeasibleOptimizer setup.X setup.Psi setup.xStar
    setup.hxStar_mem setup.hxStar_minimizes

/-- Canonical paper optimum value `Ψ* = min_{x ∈ X} Ψ(x)`.

Aligns with `SOptLib.objectiveMinimumValue` / `ObjectiveMinimum.value`, using
the feasible-carrier objective so the source-facing theorem states the paper's
`Ψ*` rather than taking an optimizer witness in the theorem head. -/
noncomputable def PsiStar : ℝ :=
  SOptLib.objectiveMinimumValue setup.PsiCarrier setup.PsiMinimum

/-- The canonical optimum value lower-bounds every feasible objective value. -/
theorem PsiStar_le (x : E) (hx : x ∈ setup.X) :
    setup.PsiStar ≤ setup.Psi x := by
  simpa [PsiStar, PsiCarrier] using
    objectiveMinimumValue_le_of_mem (X := setup.X) setup.Psi setup.PsiMinimum hx

/-- The selected optimizer realizes the canonical optimum value `Ψ*`. -/
theorem PsiStar_eq_selected :
    setup.PsiStar = setup.Psi setup.PsiMinimum.val.1 := by
  simp [PsiStar, PsiCarrier]

/-- Setup-specialized AC-SA weight schedule `Γ_t` from Eq. (4.2.21), exposed
only on positive paper times.

Aligns with `SOptLib.natSuccPositiveTime`/positive-time iterate helpers for the
indexing convention; the staged recursive carrier's zero branch is not part of
the paper-facing API. -/
def Gamma (t : {n : ℕ // 1 ≤ n}) : ℝ :=
  SOptLib.acceleratedGammaSchedule setup.alpha t

/-- Defining base equation for the canonical AC-SA schedule `Γ_1 = 1`
from Eq. (4.2.21). -/
theorem Gamma_one : setup.Gamma SOptLib.positiveTimeOne = 1 := by
  rfl

/-- Defining recurrence for the canonical AC-SA schedule `Γ_t` from Eq. (4.2.21). -/
theorem Gamma_succ (t : ℕ) (ht : 1 ≤ t) :
    setup.Gamma ⟨t + 1, Nat.succ_le_succ (Nat.zero_le t)⟩ =
      (1 - setup.alpha (t + 1)) * setup.Gamma ⟨t, ht⟩ := by
  cases t with
  | zero =>
      cases ht
  | succ t =>
      rfl

/-- Paper parameter datum `α_1 = 1`. -/
theorem alpha_one : setup.alpha 1 = 1 :=
  setup.hparams.1.1

/-- Eq. (4.2.10) strict step condition. -/
theorem step_condition (t : {n : ℕ // 1 ≤ n}) :
    setup.L * setup.alpha t.1 * setup.gamma t.1 < 1 + setup.mu * setup.gamma t.1 := by
  rcases setup.hparams.1 with ⟨_, _, hstep, _⟩
  exact hstep t.1 t.2

/-- Eq. (4.2.9), recorded at the paper-facing parameter object without adding
the missing denominator facts to the setup. Checked quotient semantics are
provided by the conditional run contract. -/
theorem q_relation_displayed (t : {n : ℕ // 1 ≤ n}) :
    setup.q t.1 * (1 - setup.alpha t.1) *
        (1 + setup.mu * setup.gamma t.1) =
      setup.alpha t.1 * (1 - setup.q t.1) := by
  exact setup.hparams.1.2.1 t.1 t.2

/-- The left denominator in the quotient presentation of Eq. (4.2.9) vanishes
at the initial accelerated step.

This is why the checked-quotient run boundary below only attaches a left
denominator witness for `2 ≤ t`: the paper also states `α_1 = 1`, and the
denominator-free displayed relation then forces `α_1(1-q_1)=0`. -/
theorem q_relation_left_denominator_eq_zero_at_one :
    setup.alpha 1 * (1 - setup.q 1) = 0 := by
  have hrel := setup.q_relation_displayed SOptLib.positiveTimeOne
  simpa [SOptLib.positiveTimeOne, setup.alpha_one] using hrel.symm

/-- Non-initial domain condition implicit in the fractional Eq. (4.2.9). -/
theorem q_relation_left_denominator_ne_of_params
    (t : {n : ℕ // 1 ≤ n}) (htwo : 2 ≤ t.1) :
    setup.alpha t.1 * (1 - setup.q t.1) ≠ 0 :=
  setup.hparams.2 t.1 htwo

/-- Eq. (4.2.22), recorded at the paper-facing parameter object without adding
the missing denominator facts to the setup. Checked quotient semantics are
provided by the conditional run contract. -/
theorem weight_mono_displayed (t : {n : ℕ // 1 ≤ n}) :
    setup.alpha (t.1 + 1) * (setup.gamma t.1 * setup.Gamma t) ≤
      (setup.alpha t.1 * (1 + setup.mu * setup.gamma t.1)) *
        (setup.gamma (t.1 + 1) *
          setup.Gamma ⟨t.1 + 1, Nat.succ_le_succ (Nat.zero_le t.1)⟩) := by
  simpa [StochasticAcceleratedGradientDescentSetup.Gamma] using
    setup.hparams.1.2.2.2 t.1 t.2

/-- Positivity of the stochastic-error denominator
`1 + μ γ_t - L α_t γ_t` in Theorem 4.4. -/
theorem error_denominator_pos (t : {n : ℕ // 1 ≤ n}) :
    0 < 1 + setup.mu * setup.gamma t.1 - setup.L * setup.alpha t.1 * setup.gamma t.1 := by
  have hstep : setup.L * setup.alpha t.1 * setup.gamma t.1 <
      1 + setup.mu * setup.gamma t.1 :=
    setup.step_condition t
  linarith

/-- Bregman divergence induced by `nu` and its gradient `gradNu`.

No SOptLib match: searched `Bregman divergence` and scanned
`SOptLib/Model/Bregman.lean`; `SOptLib.bregmanDivergence` uses Mathlib's ambient
`∇ nu`, while Eq. (3.2.2) in this file keeps the paper's explicit gradient
oracle `gradNu` as setup data with `HasGradientAt` evidence. -/
noncomputable def V (x z : E) : ℝ :=
  carrierBregmanFormula setup.nu id setup.gradNu x z

/-- Continuous-gradient component of the paper distance-generating assumption. -/
theorem gradNu_continuousOn :
    ContinuousOn setup.gradNu setup.X :=
  setup.hnu_dgf.1

/-- Gradient-realization component of the paper distance-generating assumption. -/
theorem nu_hasGradientAt (x : E) (hx : x ∈ setup.X) :
    HasGradientAt setup.nu (setup.gradNu x) x :=
  setup.hnu_dgf.2.1 x hx

/-- Strong-convexity/Bregman lower-bound component of the paper
distance-generating assumption. -/
theorem V_lower (x : E) (hx : x ∈ setup.X) (z : E) (hz : z ∈ setup.X) :
    (1 / 2 : ℝ) * ‖x - z‖ ^ 2 ≤ setup.V x z := by
  exact IsDistanceGeneratingFunctionOn.half_sq_norm_le_bregman
    setup.hnu_dgf x hx z hz (by rfl)

/-- Squared-distance control supplied by the paper DGF lower bound.

This is the direction available from the stated distance-generating assumption:
`V(x,z)` controls `‖x-z‖²` from below. The generated L2 route may use this
bridge directly, but it should not pretend that the converse upper-growth
estimate follows from the same source assumption. -/
theorem sq_norm_le_two_V (x : E) (hx : x ∈ setup.X) (z : E) (hz : z ∈ setup.X) :
    ‖x - z‖ ^ 2 ≤ 2 * setup.V x z := by
  exact sq_norm_le_two_mul_of_half_sq_norm_le setup.V (fun y : E => y) x z
    (setup.V_lower x hx z hz)

/-- The AC-SA composite prox objective from Eq. (4.2.6).

No SOptLib match: searched `prox argmin mirror descent Bregman`, checked
`SOptLib.proxStep`, `SOptLib.proxStep_minimizes_expanded`, and scanned
`SOptLib/Model/Prox.lean`; those candidates model `γ * ⟪g, y⟫ + V(x,y)` and
do not include the paper's composite term `γ h(y)` nor the additional
`γ μ V(x_under,y)` term from Eq. (4.2.6). -/
noncomputable def proxObjective
    (t : {n : ℕ // 1 ≤ n}) (xPrev xUnder g x : E) : ℝ :=
  acsaProxObjective setup.gamma setup.mu setup.h setup.V t.1 xPrev xUnder g x

/-- The paper argmin predicate for the AC-SA prox update in Eq. (4.2.6).

This is the source-facing semantics of the displayed `argmin`. The actual
recursive selector is supplied only by the disclosed conditional run contract,
which records that the selected point satisfies this predicate for the realized
updates. -/
def IsProxStep (t : {n : ℕ // 1 ≤ n})
    (xPrev xUnder g z : E) : Prop :=
  IsCompositeProxStepOn setup.X setup.proxObjective t xPrev xUnder g z

/-- Feasibility component of the paper argmin predicate in Eq. (4.2.6). -/
theorem IsProxStep.mem {t : {n : ℕ // 1 ≤ n}} {xPrev xUnder g z : E}
    (hstep : setup.IsProxStep t xPrev xUnder g z) :
    z ∈ setup.X :=
  hstep.1

/-- Minimization component of the paper argmin predicate in Eq. (4.2.6). -/
theorem IsProxStep.isMinOn {t : {n : ℕ // 1 ≤ n}} {xPrev xUnder g z : E}
    (hstep : setup.IsProxStep t xPrev xUnder g z) :
    IsMinOn (setup.proxObjective t xPrev xUnder g) setup.X z :=
  hstep.2

/-- Expanded minimization property for any realized AC-SA prox update satisfying
the paper argmin predicate. -/
theorem proxStep_minimizes_of_isProxStep (t : {n : ℕ // 1 ≤ n})
    (xPrev xUnder g z : E)
    (hstep : setup.IsProxStep t xPrev xUnder g z)
    (y : E) (hy : y ∈ setup.X) :
    setup.proxObjective t xPrev xUnder g z ≤
      setup.proxObjective t xPrev xUnder g y :=
  hstep.2 hy

/-- The canonical selected optimizer is feasible. -/
theorem xStar_mem : setup.xStar ∈ setup.X :=
  setup.hxStar_mem

/-- Initial feasible AC-SA state `(x_0, x̄_0)` from the paper initialization.

This is separated from the recursive process so that the process can be
constructed by the canonical `SOptLib.recursiveIterateProcess` primitive rather
than by an ad hoc local recursion. -/
def initialState : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X :=
  ⟨setup.w0, setup.wbar0, setup.hw0_mem, setup.hwbar0_mem⟩

/-- Search point computation `x̲_t = (1-q_t)x̄_{t-1}+q_t x_{t-1}` from Eq. (4.2.5),
specialized from the staged accelerated two-sequence search-point model. -/
def searchPoint (t : {n : ℕ // 1 ≤ n})
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X) : E :=
  SOptLib.acceleratedSearchPoint setup.q t prev.xBar prev.x

/-- Averaging update `x̄_t = (1-α_t)x̄_{t-1}+α_t x_t` from Eq. (4.2.7).

No SOptLib match: checked the pre-searched weighted-output candidates and
searched `weighted output average convex combination`; those candidates model
finite normalized output averages, while Eq. (4.2.7) is the stepwise accelerated
state update. -/
def averagePoint (t : {n : ℕ // 1 ≤ n})
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (xNext : E) : E :=
  (1 - setup.alpha t.1) • prev.xBar + setup.alpha t.1 • xNext

end StochasticAcceleratedGradientDescentSetup

namespace StochasticAcceleratedGradientDescentRealization

variable {setup : StochasticAcceleratedGradientDescentSetup E S}
variable (realization : StochasticAcceleratedGradientDescentRealization (E := E) (S := S) setup Ω)

/-- Sampled stochastic gradient process `G(x, ξ_t)` aligned with
`SOptLib.oracleKernel`, specialized to the AC-SA oracle in Eq. (4.1.3). -/
def sampledGradient (t : ℕ) (x : E) : Ω → E :=
  SOptLib.oracleKernel setup.stochasticGradientOracle (realization.xi t) x

/-- Defining formula for the realized sampled stochastic gradient. -/
theorem sampledGradient_apply (t : ℕ) (x : E) (ω : Ω) :
    realization.sampledGradient t x ω = setup.stochasticGradientOracle x (realization.xi t ω) := by
  rfl

/-- Natural filtration generated by the realized sample process, aligned with
`SOptLib.filtration` for sample-prefix filtrations. -/
noncomputable def filtration : Filtration ℕ ‹MeasurableSpace Ω› :=
  SOptLib.filtration realization.xi realization.hxi_meas

/-- Conditional AC-SA one-step transition built from an explicit run selector.

This helper is intentionally not a paper-facing canonical object. It is the
single realization boundary required when the source-stated algorithm uses
fractions, convex combinations, and the Eq. (4.2.6) argmin without separately
stating all Lean-side domain and selection facts. -/
noncomputable def conditionalStepFromData
    (halpha_mem_Icc : ∀ t : {n : ℕ // 1 ≤ n},
      setup.alpha t.1 ∈ Set.Icc (0 : ℝ) 1)
    (proxStep : ∀ t : {n : ℕ // 1 ≤ n},
      FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X → Ω → E)
    (hprox_mem : ∀ (t : {n : ℕ // 1 ≤ n})
      (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
      (ω : Ω), proxStep t prev ω ∈ setup.X)
    (k : ℕ)
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (ω : Ω) :
    FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X :=
  let t := SOptLib.natSuccPositiveTime k
  let xNext := proxStep t prev ω
  let hxNext := hprox_mem t prev ω
  let xBarNext := setup.averagePoint t prev xNext
  let hxBarNext : xBarNext ∈ setup.X := by
    rcases Set.mem_Icc.mp (halpha_mem_Icc t) with ⟨halpha_nonneg, halpha_le_one⟩
    exact setup.hX_convex prev.hxBar hxNext (sub_nonneg.mpr halpha_le_one)
      halpha_nonneg (by ring)
  ⟨xNext, xBarNext, hxNext, hxBarNext⟩

/-- Disclosed conditional realization/run contract for the AC-SA recursion.

The book states the displayed parameter relations, the update formulas
(4.2.5)-(4.2.7), and the expected bound in Theorem 4.4, but it does not state
the Lean-facing domain facts for all fractions, all-states prox solvability, or
final expected-gap integrability. This structure is the only place where those
realization-only facts live. It is consumed by the recursive process and by
Theorem 4.4, and it is deliberately separate from the paper setup and
`AcsaDisplayedParameterRelations`.

The prox update is exposed as a measurable sample kernel. This matches
Eq. (4.2.6), where the selected minimizer is a function of the previous AC-SA
state and the fresh sample `ξ_t`. The omega-indexed `proxStep` remains only as a
compatibility view of that kernel along the realized sample stream. -/
structure StochasticAcceleratedGradientDescentRunContract where
  hq_mem_Icc :
    ∀ t : {n : ℕ // 1 ≤ n}, setup.q t.1 ∈ Set.Icc (0 : ℝ) 1
  halpha_mem_Icc :
    ∀ t : {n : ℕ // 1 ≤ n}, setup.alpha t.1 ∈ Set.Icc (0 : ℝ) 1
  hgamma_pos :
    ∀ t : {n : ℕ // 1 ≤ n}, 0 < setup.gamma t.1
  hq_relation_left_denominator_ne :
    ∀ t : {n : ℕ // 1 ≤ n}, 2 ≤ t.1 → setup.alpha t.1 * (1 - setup.q t.1) ≠ 0
  hq_relation_right_denominator_ne :
    ∀ t : {n : ℕ // 1 ≤ n}, 1 + setup.mu * setup.gamma t.1 ≠ 0
  hweight_denominator_ne :
    ∀ t : {n : ℕ // 1 ≤ n}, setup.gamma t.1 * setup.Gamma t ≠ 0
  hq_relation_semantics :
    ∀ (t : {n : ℕ // 1 ≤ n}) (htwo : 2 ≤ t.1),
      acsaCheckedQuotient
          (setup.q t.1 * (1 - setup.alpha t.1))
          (setup.alpha t.1 * (1 - setup.q t.1))
          (hq_relation_left_denominator_ne t htwo) =
        acsaCheckedQuotient 1
          (1 + setup.mu * setup.gamma t.1)
          (hq_relation_right_denominator_ne t)
  hweight_mono_semantics :
    ∀ t : {n : ℕ // 1 ≤ n},
      acsaCheckedQuotient
          (setup.alpha (t.1 + 1))
          (setup.gamma (t.1 + 1) *
            setup.Gamma ⟨t.1 + 1, Nat.succ_le_succ (Nat.zero_le t.1)⟩)
          (hweight_denominator_ne
            ⟨t.1 + 1, Nat.succ_le_succ (Nat.zero_le t.1)⟩) ≤
        acsaCheckedQuotient
          (setup.alpha t.1 * (1 + setup.mu * setup.gamma t.1))
          (setup.gamma t.1 * setup.Gamma t)
          (hweight_denominator_ne t)
  proxStepKernel :
    ∀ t : {n : ℕ // 1 ≤ n},
      FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X → S → E
  proxStepKernel_measurable :
    ∀ t : {n : ℕ // 1 ≤ n},
      Measurable
        (fun p : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X × S =>
          proxStepKernel t p.1 p.2)
  proxStepKernel_spec :
    ∀ (t : {n : ℕ // 1 ≤ n})
      (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
      (ξ : S),
      setup.IsProxStep t prev.x (setup.searchPoint t prev)
        (setup.stochasticGradientOracle (setup.searchPoint t prev) ξ)
        (proxStepKernel t prev ξ)
  proxStep :
    ∀ t : {n : ℕ // 1 ≤ n},
      FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X → Ω → E
  proxStep_eq_kernel :
    ∀ (t : {n : ℕ // 1 ≤ n})
      (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
      (ω : Ω),
      proxStep t prev ω = proxStepKernel t prev (realization.xi t.1 ω)
  /- Realization-boundary measurability for the oracle residual evaluated at
     feasible random queries. The source proof of Theorem 4.4 conditions on the
     strict past and then applies oracle unbiasedness at the random search
     point; Lean needs this joint measurability to instantiate the generic
     random-query conditional-expectation theorem. This is not a martingale or
     expectation-bound assumption. -/
  oracleNoise_feasible_joint_measurable :
    Measurable
      (fun p : {x : E // x ∈ setup.X} × S =>
        setup.oracleNoise p.1.1 p.2)
  proxStep_spec :
    ∀ (t : {n : ℕ // 1 ≤ n})
      (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
      (ω : Ω),
      setup.IsProxStep t prev.x (setup.searchPoint t prev)
        (realization.sampledGradient t.1 (setup.searchPoint t prev) ω)
        (proxStep t prev ω)
  expectedGapAEStronglyMeasurable :
    ∀ k : ℕ,
      AEStronglyMeasurable
        (fun ω =>
          setup.Psi
              ((SOptLib.recursiveIterateProcess setup.initialState
                (conditionalStepFromData (setup := setup) halpha_mem_Icc proxStep
                  (fun t prev ω => (proxStep_spec t prev ω).1)) k ω).xBar) -
            setup.PsiStar)
        realization.P
  /- Lean well-definedness for the scalar martingale product in Eq. (4.2.32)
     and JSON main_theorem.proof[4].

     The source proof takes the conditional expectation of
     `⟪δ_t, x* - x_{t-1}^+⟫`. The zero conditional expectation is derived below
     from unbiasedness and adaptedness; this field supplies only the scalar
     product integrability needed for Bochner splitting in Theorem 4.4. It is a
     run-regularity boundary fact, not a setup assumption and not the martingale
     cancellation itself.

     This field uses the unfolded recursive process because `xPlus` and `delta`
     are post-contract notation. The theorem
     `delta_xStar_xPlus_inner_integrable` below is the public bridge back to the
     paper names. -/
  delta_xStar_xPlus_inner_integrable :
    ∀ (proc : ℕ → Ω →
        FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X),
      proc =
        SOptLib.recursiveIterateProcess setup.initialState
          (conditionalStepFromData (setup := setup) halpha_mem_Icc proxStep
            (fun t prev ω => (proxStep_spec t prev ω).1)) →
      ∀ t : {n : ℕ // 1 ≤ n},
        Integrable
          (fun ω =>
            let xPrev := (proc (t.1 - 1) ω).x
            let xBarPrev := (proc (t.1 - 1) ω).xBar
            let xUnder := (1 - setup.q t.1) • xBarPrev + setup.q t.1 • xPrev
            let xPlus :=
              acsaCheckedQuotient (setup.mu * setup.gamma t.1)
                  (1 + setup.mu * setup.gamma t.1)
                  (hq_relation_right_denominator_ne t) •
                xUnder +
              acsaCheckedQuotient 1
                  (1 + setup.mu * setup.gamma t.1)
                  (hq_relation_right_denominator_ne t) •
                xPrev
            ⟪setup.oracleNoise xUnder (realization.xi t.1 ω),
              setup.xStar - xPlus⟫_ℝ)
          realization.P

/-- Source-generated AC-SA execution interface for Eqs. (4.2.5)-(4.2.7).

This is the paper-level generated-run object missing from the previous
refactor: the stochastic step is specified only by the causal sample kernel
`(previous state, ξ_t) ↦ x_t` satisfying the Eq. (4.2.6) argmin predicate.
The omega-indexed selector is derived below by composition with the realized
sample stream, rather than stored as primitive execution data.

This public execution object deliberately does not carry the legacy
`RunContract` quotient semantics, expected-gap well-definedness, or Eq. (4.2.32)
scalar-product integrability fields. Those are proof obligations for deriving a
conditional run internally, not source data of the generated algorithm. -/
structure SourceGeneratedAcsExecution
    (setup : StochasticAcceleratedGradientDescentSetup E S) extends
  SOptLib.AcceleratedSampleKernelExecution
    (E := E)
    (Time := {n : ℕ // 1 ≤ n})
    (State := FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (Sample := S)
    (q := fun t => setup.q t.1)
    (alpha := fun t => setup.alpha t.1)
    (gamma := fun t => setup.gamma t.1)
    (stepPredicate := fun t prev ξ xNext =>
      setup.IsProxStep t prev.x (setup.searchPoint t prev)
        (setup.stochasticGradientOracle (setup.searchPoint t prev) ξ) xNext)

/-- Omega-indexed view of a source-generated AC-SA sample kernel. -/
noncomputable def SourceGeneratedAcsExecution.proxStep
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (t : {n : ℕ // 1 ≤ n})
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (ω : Ω) : E :=
  execution.proxStepKernel t prev (realization.xi t.1 ω)

/-- The omega-indexed view of a source-generated AC-SA step is exactly the
causal sample kernel evaluated at the fresh sample `ξ_t`.

This is the named adapter needed when legacy conditional-run proofs ask for an
omega-indexed `proxStep_eq_kernel`; it is not an additional execution
assumption. -/
theorem SourceGeneratedAcsExecution.proxStep_eq_kernel
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (t : {n : ℕ // 1 ≤ n})
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (ω : Ω) :
    SourceGeneratedAcsExecution.proxStep realization execution t prev ω =
      execution.proxStepKernel t prev (realization.xi t.1 ω) := by
  rfl

/-- The source-generated omega view satisfies the Eq. (4.2.6) argmin predicate. -/
theorem SourceGeneratedAcsExecution.proxStep_spec
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (t : {n : ℕ // 1 ≤ n})
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (ω : Ω) :
    setup.IsProxStep t prev.x (setup.searchPoint t prev)
      (realization.sampledGradient t.1 (setup.searchPoint t prev) ω)
      (SourceGeneratedAcsExecution.proxStep realization execution t prev ω) := by
  simpa [SourceGeneratedAcsExecution.proxStep, sampledGradient] using
    execution.proxStepKernel_spec t prev (realization.xi t.1 ω)

variable (run : StochasticAcceleratedGradientDescentRunContract realization)

/-- The legacy omega-indexed prox-step specification is derivable from the
causal sample kernel. This is the bridge that replaces the old unconstrained
selector semantics: proofs needing Eq. (4.2.6) can use the kernel spec together
with `proxStep_eq_kernel`, while existing descent proofs may continue using
`run.proxStep_spec`. -/
theorem StochasticAcceleratedGradientDescentRunContract.proxStep_spec_from_kernel
    (run : StochasticAcceleratedGradientDescentRunContract realization)
    (t : {n : ℕ // 1 ≤ n})
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (ω : Ω) :
    setup.IsProxStep t prev.x (setup.searchPoint t prev)
      (realization.sampledGradient t.1 (setup.searchPoint t prev) ω)
      (run.proxStep t prev ω) := by
  rw [StochasticAcceleratedGradientDescentRunContract.proxStep_eq_kernel run t prev ω]
  simpa [sampledGradient] using
    StochasticAcceleratedGradientDescentRunContract.proxStepKernel_spec run t prev
      (realization.xi t.1 ω)

/-- Eq. (4.2.9) with the run contract's denominator boundary attached away from
the initial step.

The displayed quotient relation remains setup data; the non-source
well-definedness facts for using it in a concrete execution are exposed only
through this conditional realization theorem. At `t = 1`, the source datum
`α_1 = 1` makes the left denominator zero, so consumers must use
`q_relation_displayed` instead of this checked-quotient view. -/
theorem q_relation_under_run_contract
    (run : StochasticAcceleratedGradientDescentRunContract realization)
    (t : {n : ℕ // 1 ≤ n}) (htwo : 2 ≤ t.1) :
    setup.alpha t.1 * (1 - setup.q t.1) ≠ 0 ∧
      1 + setup.mu * setup.gamma t.1 ≠ 0 ∧
      acsaCheckedQuotient
          (setup.q t.1 * (1 - setup.alpha t.1))
          (setup.alpha t.1 * (1 - setup.q t.1))
          (StochasticAcceleratedGradientDescentRunContract.hq_relation_left_denominator_ne run t htwo) =
        acsaCheckedQuotient 1
          (1 + setup.mu * setup.gamma t.1)
          (StochasticAcceleratedGradientDescentRunContract.hq_relation_right_denominator_ne run t) := by
  exact ⟨StochasticAcceleratedGradientDescentRunContract.hq_relation_left_denominator_ne run t htwo,
    StochasticAcceleratedGradientDescentRunContract.hq_relation_right_denominator_ne run t,
    StochasticAcceleratedGradientDescentRunContract.hq_relation_semantics run t htwo⟩

/-- Eq. (4.2.22) with the run contract's denominator boundary attached. -/
theorem weight_mono_under_run_contract
    (run : StochasticAcceleratedGradientDescentRunContract realization)
    (t : {n : ℕ // 1 ≤ n}) :
    setup.gamma (t.1 + 1) *
        setup.Gamma ⟨t.1 + 1, Nat.succ_le_succ (Nat.zero_le t.1)⟩ ≠ 0 ∧
      setup.gamma t.1 * setup.Gamma t ≠ 0 ∧
      acsaCheckedQuotient
          (setup.alpha (t.1 + 1))
          (setup.gamma (t.1 + 1) *
            setup.Gamma ⟨t.1 + 1, Nat.succ_le_succ (Nat.zero_le t.1)⟩)
          (StochasticAcceleratedGradientDescentRunContract.hweight_denominator_ne run
            ⟨t.1 + 1, Nat.succ_le_succ (Nat.zero_le t.1)⟩) ≤
        acsaCheckedQuotient
          (setup.alpha t.1 * (1 + setup.mu * setup.gamma t.1))
          (setup.gamma t.1 * setup.Gamma t)
          (StochasticAcceleratedGradientDescentRunContract.hweight_denominator_ne run t) := by
  exact ⟨StochasticAcceleratedGradientDescentRunContract.hweight_denominator_ne run
      ⟨t.1 + 1, Nat.succ_le_succ (Nat.zero_le t.1)⟩,
    StochasticAcceleratedGradientDescentRunContract.hweight_denominator_ne run t,
    StochasticAcceleratedGradientDescentRunContract.hweight_mono_semantics run t⟩

/-- Denominator boundary for the paper formula `x_{t-1}^+` in Eq. (4.2.14). -/
theorem xPlus_denominator_under_run_contract
    (run : StochasticAcceleratedGradientDescentRunContract realization)
    (t : {n : ℕ // 1 ≤ n}) :
    1 + setup.mu * setup.gamma t.1 ≠ 0 :=
  StochasticAcceleratedGradientDescentRunContract.hq_relation_right_denominator_ne run t

/-- Denominator boundary for `Δ_t(x)` from Eq. (4.2.13), derived from the
source-stated strict inequality (4.2.10). -/
theorem Delta_denominator_ne (t : {n : ℕ // 1 ≤ n}) :
    2 * (1 + setup.mu * setup.gamma t.1 -
      setup.L * setup.alpha t.1 * setup.gamma t.1) ≠ 0 := by
  exact mul_ne_zero two_ne_zero (ne_of_gt (setup.error_denominator_pos t))

/-- Denominator boundary for the displayed expected-error bound `B_e(k)` in
Theorem 4.4. The `γ_1` and `Γ_t` nonvanishing facts are realization-only and
therefore come from the run contract; positivity of the stochastic-error
denominator is source-derived from (4.2.10). -/
theorem B_e_denominators_under_run_contract
    (run : StochasticAcceleratedGradientDescentRunContract realization)
    (k : {n : ℕ // 1 ≤ n}) :
    setup.gamma 1 ≠ 0 ∧
      (∀ t, (ht : t ∈ Finset.Icc 1 k.1) →
        setup.Gamma ⟨t, (Finset.mem_Icc.mp ht).1⟩ *
          (1 + setup.mu * setup.gamma t -
            setup.L * setup.alpha t * setup.gamma t) ≠ 0) := by
  exact SOptLib.accelerated_error_bound_denominators setup.gamma setup.alpha setup.Gamma
    setup.mu setup.L k
    (ne_of_gt (StochasticAcceleratedGradientDescentRunContract.hgamma_pos run
      SOptLib.positiveTimeOne))
    (fun t ht => by
      let τ : {n : ℕ // 1 ≤ n} := ⟨t, (Finset.mem_Icc.mp ht).1⟩
      have hweight :=
        StochasticAcceleratedGradientDescentRunContract.hweight_denominator_ne run τ
      intro hGamma
      have hGammaτ : setup.Gamma τ = 0 := by
        simpa [τ] using hGamma
      exact hweight (by simp [hGammaτ]))
    (fun t ht => by
      exact ne_of_gt (setup.error_denominator_pos ⟨t, (Finset.mem_Icc.mp ht).1⟩))

/-- Expected-error bound `B_e(k)` from Theorem 4.4, exposed only through the
conditional run boundary.

Book citation:
`book/FOML/StochasticAcceleratedGradientDescent.json#/main_theorem/statement_math`
states
`B_e(k) := Γ_k/γ_1 V(x_0,x*) + Γ_k ∑_{t=1}^k α_t γ_t(M^2+σ^2)/(Γ_t(1+μγ_t-Lα_tγ_t))`.
The source does not separately state `γ_1 ≠ 0` or `Γ_t ≠ 0`, so the Lean
definition uses domain-checked quotients from
`B_e_denominators_under_run_contract` rather than a source-facing totalized
division formula on `Setup`. -/
noncomputable def B_e
    (run : StochasticAcceleratedGradientDescentRunContract realization)
    (k : {n : ℕ // 1 ≤ n}) : ℝ :=
  acsaCheckedQuotient (setup.Gamma k) (setup.gamma 1)
      (realization.B_e_denominators_under_run_contract run k).1 *
    setup.V setup.w0 setup.xStar +
    setup.Gamma k *
      Finset.sum (Finset.Icc 1 k.1).attach fun t =>
        let τ : {n : ℕ // 1 ≤ n} := ⟨t.1, (Finset.mem_Icc.mp t.2).1⟩
        acsaCheckedQuotient
          (setup.alpha t.1 * setup.gamma t.1 * (setup.M ^ 2 + setup.sigma ^ 2))
          (setup.Gamma τ *
            (1 + setup.mu * setup.gamma t.1 - setup.L * setup.alpha t.1 * setup.gamma t.1))
          ((realization.B_e_denominators_under_run_contract run k).2 t.1 t.2)

/-- Feasibility of the realized AC-SA search point from Eq. (4.2.5), under the
conditional run contract's parameter-admissibility boundary. -/
theorem searchPoint_mem
    (run : StochasticAcceleratedGradientDescentRunContract realization)
    (t : {n : ℕ // 1 ≤ n})
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X) :
    setup.searchPoint t prev ∈ setup.X := by
  simpa [StochasticAcceleratedGradientDescentSetup.searchPoint, SOptLib.acceleratedSearchPoint] using
    (SOptLib.acceleratedSearchPoint_mem (E := E) (X := setup.X) setup.hX_convex
      (q := setup.q t.1)
      (StochasticAcceleratedGradientDescentRunContract.hq_mem_Icc run t)
      (xBarPrev := prev.xBar) (xPrev := prev.x) prev.hxBar prev.hx)

/-- Feasibility of the realized AC-SA averaging update from Eq. (4.2.7), under
the conditional run contract's parameter-admissibility boundary. -/
theorem averagePoint_mem
    (run : StochasticAcceleratedGradientDescentRunContract realization)
    (t : {n : ℕ // 1 ≤ n})
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    {xNext : E} (hxNext : xNext ∈ setup.X) :
    setup.averagePoint t prev xNext ∈ setup.X := by
  simpa [StochasticAcceleratedGradientDescentSetup.averagePoint] using
    (SOptLib.acceleratedAveragePoint_mem setup.hX_convex setup.alpha t
      (StochasticAcceleratedGradientDescentRunContract.halpha_mem_Icc run t)
      prev.hxBar hxNext)

/-- Canonical one-step AC-SA transition from Eqs. (4.2.5)-(4.2.7).

The generic candidate `SOptLib.proxOracleStep` was checked and rejected here:
it represents a single-state mirror-prox update `prox x (G k x ω) γ_k`, whereas
AC-SA's paper step updates the bundled state `(x_t, x̄_t)` through the search
point `x̲_t`, a run-contracted Eq. (4.2.6) argmin, and the averaging equation
(4.2.7). -/
noncomputable def stepFromState
    (k : ℕ)
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (ω : Ω) :
    FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X :=
  SOptLib.accelerated_step_from_state setup.alpha setup.hX_convex
    run.halpha_mem_Icc run.proxStep
    (fun t prev ω => (run.proxStep_spec t prev ω).1) k prev ω

/-- Sample-kernel form of the AC-SA one-step transition.

This is the process transition exposed by Eq. (4.2.6): once the previous state
is fixed, the only stochastic input to the prox update is the fresh sample
`ξ_t`. It is separate from `stepFromState` so adaptedness proofs can use a
state/sample measurable map rather than an arbitrary `Ω`-indexed selector. -/
noncomputable def stepFromSample
    (k : ℕ)
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (ξ : S) :
    FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X :=
  SOptLib.accelerated_step_from_sample SOptLib.natSuccPositiveTime
    setup.averagePoint run.proxStepKernel
    (fun t prev ξ => (run.proxStepKernel_spec t prev ξ).1)
    (fun t prev {_xNext} hxNext => averagePoint_mem realization run t prev hxNext)
    k prev ξ

/-- The omega-indexed transition is exactly the sample-kernel transition along
the realized current sample. This is the concrete consumer of
`proxStep_eq_kernel` needed before applying recursive-process adaptedness
lemmas. -/
theorem stepFromState_eq_stepFromSample
    (k : ℕ)
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (ω : Ω) :
    realization.stepFromState run k prev ω =
      realization.stepFromSample run k prev (realization.xi (k + 1) ω) := by
  exact SOptLib.accelerated_step_from_state_eq_step_from_sample setup.alpha
    setup.hX_convex run.halpha_mem_Icc realization.xi run.proxStep
    run.proxStepKernel
    (fun t prev ω => (run.proxStep_spec t prev ω).1)
    (fun t prev ξ => (run.proxStepKernel_spec t prev ξ).1)
    setup.averagePoint
    (fun t prev {_xNext} hxNext => averagePoint_mem realization run t prev hxNext)
    k prev ω
    (run.proxStep_eq_kernel (SOptLib.natSuccPositiveTime k) prev ω)
    (by
      rfl)

/-- The sample-kernel state transition is measurable as a map of previous state
and current sample. This packages the run contract's measurable prox kernel with
the deterministic averaging equation (4.2.7), giving FILL the `h_step` premise
for `SOptLib.recursiveProcess_measurable_wrt_strictPast`. -/
theorem stepFromSample_measurable (k : ℕ) :
    Measurable
      (fun p : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X × S =>
        realization.stepFromSample run k p.1 p.2) := by
  let t := SOptLib.natSuccPositiveTime k
  have hxNext :
      Measurable
        (fun p : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X × S =>
          run.proxStepKernel t p.1 p.2) :=
    run.proxStepKernel_measurable t
  have hcoord :
      Measurable
        (fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X =>
          (s.x, s.xBar)) :=
    feasible_state_coordinates_measurable (E := E) setup.X
  have hxPrevBar :
      Measurable
        (fun p : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X × S =>
          p.1.xBar) :=
    hcoord.snd.comp measurable_fst
  have hxBarNext :
      Measurable
        (fun p : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X × S =>
          setup.averagePoint t p.1 (run.proxStepKernel t p.1 p.2)) := by
    simpa [StochasticAcceleratedGradientDescentSetup.averagePoint] using
      (hxPrevBar.const_smul (1 - setup.alpha t.1)).add
        (hxNext.const_smul (setup.alpha t.1))
  have hpair :
      Measurable
        (fun p : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X × S =>
          (run.proxStepKernel t p.1 p.2,
            setup.averagePoint t p.1 (run.proxStepKernel t p.1 p.2))) :=
    hxNext.prodMk hxBarNext
  have hpairStep :
      Measurable
        (fun p : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X × S =>
          ((realization.stepFromSample run k p.1 p.2).x,
            (realization.stepFromSample run k p.1 p.2).xBar)) := by
    simpa [stepFromSample, t] using hpair
  exact SOptLib.measurable_to_comap_state_of_measurable_coordinates
    (coord :=
      fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X =>
        (s.x, s.xBar))
    (f :=
      fun p : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X × S =>
        realization.stepFromSample run k p.1 p.2)
    hpairStep (by
      simp [feasibleStateMeasurableSpace, SOptLib.feasibleAcceleratedStateMeasurableSpace])

/-- The realized sample objective has the canonical paper expected value `f`.
This bridges the paper law of `ξ` to the concrete process `ξ_t`; later proof
work transports the integral across `realization.hxi_law`. -/
theorem objectiveExpectation_eq_f (x : E) (hx : x ∈ setup.X) (t : ℕ) :
    ∫ ω, setup.oracleValue x (realization.xi t ω) ∂realization.P = setup.f x := by
  have hY : AEMeasurable (realization.xi t) realization.P :=
    (realization.hxi_meas t).aemeasurable
  have hF :
      AEStronglyMeasurable (fun s : S => setup.oracleValue x s)
        setup.sampleMeasure := by
    simpa [SOptLib.objectiveKernel] using
      (setup.objectiveWellDefined x hx).aestronglyMeasurable
  simpa [StochasticAcceleratedGradientDescentSetup.f] using
    (SOptLib.objectiveExpectation_eq_integral_of_map_eq realization.P
      setup.sampleMeasure setup.oracleValue (realization.xi t) x hY hF
      (realization.hxi_law t))

/-- Mean-oracle form of the unbiasedness assumption for realized samples. -/
theorem oracleMean_eq_gradF (x : E) (hx : x ∈ setup.X) (t : ℕ) :
    SOptLib.oracleMean realization.P setup.stochasticGradientOracle (realization.xi t) x =
      setup.gradF x := by
  rw [SOptLib.oracleMean_def]
  have hY : AEMeasurable (realization.xi t) realization.P :=
    (realization.hxi_meas t).aemeasurable
  have hG :
      AEStronglyMeasurable (fun s : S => setup.stochasticGradientOracle x s)
        setup.sampleMeasure := by
    simpa [StochasticAcceleratedGradientDescentSetup.stochasticGradientOracle,
      SOptLib.oracleKernel] using
      (setup.oracleWellDefined x hx).aestronglyMeasurable
  exact oracleMean_stream_eq_of_map_eq realization.P setup.sampleMeasure
    setup.stochasticGradientOracle setup.gradF (realization.xi t) x hY hG
    (realization.hxi_law t) (setup.oracleMean_eq_gradF x hx)

/-- Realized bounded-variance bridge for Assumption 3. -/
theorem oracleVariance_bound (x : E) (hx : x ∈ setup.X) (t : ℕ) :
    SOptLib.expectation realization.P
        (fun ω => SOptLib.dualNorm (setup.oracleNoise x (realization.xi t ω)) ^ 2) ≤
      setup.sigma ^ 2 := by
  have hY : AEMeasurable (realization.xi t) realization.P :=
    (realization.hxi_meas t).aemeasurable
  have hAesm :
      AEStronglyMeasurable
        (fun s : S => SOptLib.dualNorm (setup.oracleNoise x s) ^ 2)
        setup.sampleMeasure :=
    (setup.oracleVarianceWellDefined x hx).aestronglyMeasurable
  have hBound :
      (∫ s, SOptLib.dualNorm (setup.oracleNoise x s) ^ 2
          ∂setup.sampleMeasure) ≤
        setup.sigma ^ 2 := by
    simpa [SOptLib.expectation] using setup.oracleVariance_bound x hx
  simpa [SOptLib.expectation] using
    (blockOracleSecondMoment_stream_le_sq_of_map_eq realization.P
      setup.sampleMeasure realization.xi setup.oracleNoise SOptLib.dualNorm
      setup.sigma x t hY (realization.hxi_law t) hAesm hBound)

/-- Recursive feasible AC-SA process, generated by the canonical recursive
process primitive from the paper one-step transition. At time `t + 1`, the
method forms `x̲_{t+1}`, applies the feasible positive-time argmin update, and
updates the accelerated average. -/
noncomputable def process :
    ℕ → Ω → FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X :=
  SOptLib.recursiveIterateProcess setup.initialState (realization.stepFromState run)

/-- The AC-SA recursive process has the paper initialization. -/
theorem process_zero (ω : Ω) :
    realization.process run 0 ω = setup.initialState := by
  rfl

/-- Successor unfolding of the canonical AC-SA recursive process. -/
theorem process_succ (k : ℕ) (ω : Ω) :
    realization.process run (k + 1) ω =
      realization.stepFromState run k (realization.process run k ω) ω := by
  rfl

/-- Function-level bridge from the canonical recursive process primitive to the
AC-SA one-step transition. -/
theorem process_succ_eq (k : ℕ) :
    realization.process run (k + 1) =
      fun ω => realization.stepFromState run k (realization.process run k ω) ω := by
  exact SOptLib.iterateProcess_bridge_of_recursiveProcess
    (realization.process run) setup.initialState (realization.stepFromState run) rfl k

/-- Function-level successor equation for the recursive process through the
sample-kernel transition. This is the SOptLib-compatible recursion shape:
`process (k+1) = stepFromSample k (process k) (ξ_{k+1})`. -/
theorem process_succ_eq_kernel_update (k : ℕ) :
    realization.process run (k + 1) =
      fun ω =>
        realization.stepFromSample run k (realization.process run k ω)
          (realization.xi (k + 1) ω) := by
  exact SOptLib.recursiveProcess_succ_eq_sample_update
    (process := realization.process run)
    (initial := setup.initialState)
    (omegaStep := realization.stepFromState run)
    (driver := fun n ω => realization.xi (n + 1) ω)
    (sampleStep := realization.stepFromSample run)
    rfl
    (by
      intro n state ω
      exact realization.stepFromState_eq_stepFromSample run n state ω)
    k

/-- Prefix measurability of the AC-SA state process from the sample-kernel
recursion.

This is the compiled SOptLib consumer requested by the Phase 2b audit: it
rewrites the concrete recursive process through `stepFromSample` and invokes
the sample-prefix recursive measurability bridge. The remaining leaves are the
deterministic initialization, sample-coordinate prefix measurability, update
measurability, and the kernel-update recursion equation. -/
theorem process_measurable_wrt_samplePrefix (N n : ℕ) (hn : n ≤ N) :
    Measurable[realization.filtration.seq (N + 1)] (realization.process run n) := by
  classical
  exact
    SOptLib.recursive_process_measurable_wrt_sample_prefix
      (past := fun N : ℕ => realization.filtration.seq N)
      (process := realization.process run)
      (driver := fun n ω => realization.xi (n + 1) ω)
      (step := fun n prev ξ => realization.stepFromSample run n prev ξ)
      N n
      (fun {a b} h => realization.filtration.mono h)
      (by
        change Measurable[realization.filtration.seq (N + 1)]
          (fun _ : Ω => setup.initialState)
        exact measurable_const)
      (by
        intro j _hj
        exact
          SOptLib.measurable_sample_le_prefixFiltration realization.xi realization.hxi_meas
            (j + 1))
      (by
        intro j _hj
        exact realization.stepFromSample_measurable run j)
      (by
        intro j _hj
        exact realization.process_succ_eq_kernel_update run j)
      hn

/-- Pointwise AC-SA state update obtained from the canonical recursive process.

Aligns with `SOptLib.recursiveIterateProcess_succ`: the SOptLib theorem unfolds
the generic recursion, and this paper-specialized bridge exposes the concrete
Eq. (4.2.5)-Eq. (4.2.7) state components produced by `stepFromState`. -/
theorem process_succ_eq_acsa_update (k : ℕ) (ω : Ω) :
    realization.process run (k + 1) ω =
      let prev := realization.process run k ω
      let t := SOptLib.natSuccPositiveTime k
      let xUnder := setup.searchPoint t prev
      let g := realization.sampledGradient t.1 xUnder ω
      let xNext := run.proxStep t prev ω
      let hxNext := (run.proxStep_spec t prev ω).1
      let xBarNext := setup.averagePoint t prev xNext
      let hxBarNext := averagePoint_mem realization run t prev hxNext
      ⟨xNext, xBarNext, hxNext, hxBarNext⟩ := by
  rfl

/-- The prox iterate `x_t`. -/
noncomputable def xIter (t : ℕ) (ω : Ω) : E :=
  (realization.process run t ω).x

/-- The accelerated average `x̄_t`. -/
noncomputable def xBarIter (t : ℕ) (ω : Ω) : E :=
  (realization.process run t ω).xBar

/-- Positive-time prox iterate update, specialized from the canonical AC-SA
state recursion and the selected argmin in Eq. (4.2.6). -/
theorem xIter_succ_eq_proxStep (k : ℕ) (ω : Ω) :
    realization.xIter run (k + 1) ω =
      let prev := realization.process run k ω
      let t := SOptLib.natSuccPositiveTime k
      run.proxStep t prev ω := by
  rfl

/-- Positive-time accelerated-average update from Eq. (4.2.7), specialized from
the canonical AC-SA state recursion. -/
theorem xBarIter_succ_eq_averagePoint (k : ℕ) (ω : Ω) :
    realization.xBarIter run (k + 1) ω =
      let prev := realization.process run k ω
      let t := SOptLib.natSuccPositiveTime k
      let xNext := run.proxStep t prev ω
      setup.averagePoint t prev xNext := by
  rfl

/-- The search point `x̲_t = (1-q_t)x̄_{t-1} + q_t x_{t-1}` from Eq. (4.2.5),
exposed only on positive paper times.

Aligns with `SOptLib.natSuccPositiveTime`: SOptLib supplies the positive-time
index wrapper, while this local definition gives the AC-SA-specific
two-sequence convex combination. The old `ℕ`-totalized zero case was only a
Lean recursion carrier and is intentionally not part of this paper-facing API. -/
noncomputable def xUnder (t : {n : ℕ // 1 ≤ n}) (ω : Ω) : E :=
  SOptLib.acceleratedSearchPoint setup.q t
    (realization.xBarIter run (t.1 - 1) ω)
    (realization.xIter run (t.1 - 1) ω)

/-- Positive-time unfolding of the search point through the canonical state
transition object from Eq. (4.2.5). -/
theorem xUnder_succ_eq_searchPoint (k : ℕ) (ω : Ω) :
    realization.xUnder run (SOptLib.natSuccPositiveTime k) ω =
      setup.searchPoint (SOptLib.natSuccPositiveTime k) (realization.process run k ω) := by
  simp [xUnder, SOptLib.natSuccPositiveTime, StochasticAcceleratedGradientDescentSetup.searchPoint,
    xIter, xBarIter]

/-- Positive-time feasibility of the paper search point `x̲_t`. -/
theorem xUnder_mem (t : {n : ℕ // 1 ≤ n}) (ω : Ω) :
    realization.xUnder run t ω ∈ setup.X := by
  simpa [xUnder, xIter, xBarIter, StochasticAcceleratedGradientDescentSetup.searchPoint]
    using searchPoint_mem realization run t (realization.process run (t.1 - 1) ω)

/-- Succ-index convenience form of positive-time search-point feasibility. -/
theorem xUnder_succ_mem (k : ℕ) (ω : Ω) :
    realization.xUnder run (SOptLib.natSuccPositiveTime k) ω ∈ setup.X :=
  realization.xUnder_mem run (SOptLib.natSuccPositiveTime k) ω

/-- Strict-past measurability of the search point `x̲_t`.

The proof route is now fixed by `process_measurable_wrt_samplePrefix`: rewrite
`x̲_t` as the deterministic affine map of the process state at `t-1`, then use
the prefix measurability of that state. -/
theorem xUnder_strictPast_measurable (t : {n : ℕ // 1 ≤ n}) :
    Measurable[realization.filtration.seq t.1] (realization.xUnder run t) := by
  classical
  have hproc :
      Measurable[realization.filtration.seq ((t.1 - 1) + 1)]
        (realization.process run (t.1 - 1)) :=
    realization.process_measurable_wrt_samplePrefix run (t.1 - 1) (t.1 - 1) le_rfl
  have hseq : (t.1 - 1) + 1 = t.1 := Nat.sub_add_cancel t.2
  have hproc' :
      Measurable[realization.filtration.seq t.1]
        (realization.process run (t.1 - 1)) := by
    rw [← hseq]
    exact hproc
  have hcoord :
      Measurable
        (fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X =>
          (s.x, s.xBar)) :=
    feasible_state_coordinates_measurable (E := E) setup.X
  have hxPrev :
      Measurable[realization.filtration.seq t.1]
        (fun ω => (realization.process run (t.1 - 1) ω).x) :=
    hcoord.fst.comp hproc'
  have hxBarPrev :
      Measurable[realization.filtration.seq t.1]
        (fun ω => (realization.process run (t.1 - 1) ω).xBar) :=
    hcoord.snd.comp hproc'
  simpa [xUnder, xIter, xBarIter] using
    SOptLib.acceleratedSearchPoint_strictPast_measurable
      (past := fun t => realization.filtration.seq t.1)
      (q := setup.q)
      (xBarPrev := fun t ω => realization.xBarIter run (t.1 - 1) ω)
      (xPrev := fun t ω => realization.xIter run (t.1 - 1) ω)
      t hxBarPrev hxPrev

/-- The auxiliary point `x_{t-1}^+` from Eq. 4.2.14, indexed by the current
positive step `t` so that it has no arbitrary `t = 0` value.

Book citation:
`book/FOML/StochasticAcceleratedGradientDescent.json#/algorithm_spec/parameters[2]/math`
states
`x_{t-1}^+ := μγ_t/(1+μγ_t) x̲_t + 1/(1+μγ_t) x_{t-1}`.
The denominator witness is realization-only and therefore comes from the run
contract instead of Lean's total division semantics. -/
noncomputable def xPlus (t : {n : ℕ // 1 ≤ n}) (ω : Ω) : E :=
  SOptLib.acceleratedAuxiliaryPoint setup.mu setup.gamma (realization.xUnder run)
    (realization.xIter run) t ω

/-- Checked-quotient defining formula for `x_{t-1}^+` in Eq. (4.2.14). -/
theorem xPlus_checked_formula (t : {n : ℕ // 1 ≤ n}) (ω : Ω) :
    realization.xPlus run t ω =
      acsaCheckedQuotient (setup.mu * setup.gamma t.1)
          (1 + setup.mu * setup.gamma t.1)
          (StochasticAcceleratedGradientDescentRunContract.hq_relation_right_denominator_ne run t) •
        realization.xUnder run t ω +
      acsaCheckedQuotient 1
          (1 + setup.mu * setup.gamma t.1)
          (StochasticAcceleratedGradientDescentRunContract.hq_relation_right_denominator_ne run t) •
        realization.xIter run (t.1 - 1) ω := by
  rfl

/-- Strict-past measurability of `x_{t-1}^+` from Eq. (4.2.14).

This packages the exact adapted multiplier used in Eq. (4.2.32): after
`xUnder_strictPast_measurable`, the only extra ingredient is the same
strict-past measurability of the previous state coordinate `x_{t-1}`. -/
theorem xPlus_strictPast_measurable (t : {n : ℕ // 1 ≤ n}) :
    Measurable[realization.filtration.seq t.1] (realization.xPlus run t) := by
  classical
  have hxUnder : Measurable[realization.filtration.seq t.1] (realization.xUnder run t) :=
    realization.xUnder_strictPast_measurable run t
  have hproc :
      Measurable[realization.filtration.seq ((t.1 - 1) + 1)]
        (realization.process run (t.1 - 1)) :=
    realization.process_measurable_wrt_samplePrefix run (t.1 - 1) (t.1 - 1) le_rfl
  have hseq : (t.1 - 1) + 1 = t.1 := Nat.sub_add_cancel t.2
  have hproc' :
      Measurable[realization.filtration.seq t.1]
        (realization.process run (t.1 - 1)) := by
    rw [← hseq]
    exact hproc
  have hcoord :
      Measurable
        (fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X =>
          (s.x, s.xBar)) :=
    feasible_state_coordinates_measurable (E := E) setup.X
  have hxPrev :
      Measurable[realization.filtration.seq t.1]
        (fun ω => (realization.process run (t.1 - 1) ω).x) :=
    hcoord.fst.comp hproc'
  simpa [xPlus, xIter] using
    (hxUnder.const_smul
      (acsaCheckedQuotient (setup.mu * setup.gamma t.1)
        (1 + setup.mu * setup.gamma t.1)
        (StochasticAcceleratedGradientDescentRunContract.hq_relation_right_denominator_ne run t))).add
      (hxPrev.const_smul
        (acsaCheckedQuotient 1
          (1 + setup.mu * setup.gamma t.1)
          (StochasticAcceleratedGradientDescentRunContract.hq_relation_right_denominator_ne run t)))

/-- Noise term `δ_t = G(x̲_t, ξ_t) - f'(x̲_t)` for positive paper time.

Book citation:
`book/FOML/StochasticAcceleratedGradientDescent.json#/algorithm_spec/parameters[1]/math`
states `δ_t := G(x̲_t, ξ_t) - f'(x̲_t)`. -/
noncomputable def delta (t : {n : ℕ // 1 ≤ n}) (ω : Ω) : E :=
  SOptLib.oracleNoiseAtAdaptedQuery setup.oracleNoise (realization.xUnder run)
    realization.xi (fun t : {n : ℕ // 1 ≤ n} => t.1) t ω

/-- Defining formula for `δ_t` through the realized oracle kernel. -/
theorem delta_eq_sampledGradient_sub_gradF (t : {n : ℕ // 1 ≤ n}) (ω : Ω) :
    realization.delta run t ω =
      realization.sampledGradient t.1 (realization.xUnder run t ω) ω -
        setup.gradF (realization.xUnder run t ω) := by
  rfl

/-- Integrability of the scalar product in Eq. (4.2.32) in paper notation.

This is the clean bridge from the run contract's unfolded regularity field to
the actual martingale product used when splitting the one-step error term
`Δ_t(x*)`. The field supplies only integrability; the zero integral remains the
derived theorem `delta_inner_xStar_xPlus_integral_eq_zero`. -/
theorem delta_xStar_xPlus_inner_integrable
    (t : {n : ℕ // 1 ≤ n}) :
    Integrable
      (fun ω =>
        ⟪realization.delta run t ω,
          setup.xStar - realization.xPlus run t ω⟫_ℝ)
      realization.P := by
  simpa [delta, xPlus, acsaCheckedQuotient, xUnder, xIter, xBarIter, process,
    stepFromState] using
    StochasticAcceleratedGradientDescentRunContract.delta_xStar_xPlus_inner_integrable
      run (realization.process run) rfl t

/-- Feasible-subtype query used for oracle-conditioning lemmas.

The conditional-expectation API quantifies fixed-query centering over the whole
query type. Using the feasible subtype, rather than ambient `E`, matches the
source assumption `E[G(x, ξ)] = f'(x)` for `x ∈ X` without strengthening that
assumption to infeasible points. -/
noncomputable def feasibleXUnderQuery
    (t : {n : ℕ // 1 ≤ n}) (ω : Ω) : {x : E // x ∈ setup.X} :=
  ⟨realization.xUnder run t ω, realization.xUnder_mem run t ω⟩

/-- The feasible query coerces to the paper search point. -/
theorem feasibleXUnderQuery_coe (t : {n : ℕ // 1 ≤ n}) (ω : Ω) :
    (realization.feasibleXUnderQuery run t ω : E) =
      realization.xUnder run t ω := by
  rfl

/-- Strict-past measurability of the feasible-subtype search query. -/
theorem feasibleXUnderQuery_strictPast_measurable
    (t : {n : ℕ // 1 ≤ n}) :
    Measurable[realization.filtration.seq t.1]
      (realization.feasibleXUnderQuery run t) := by
  exact (realization.xUnder_strictPast_measurable run t).subtype_mk

/-- Full measurability of the feasible-subtype search query, obtained by
forgetting from the strict-past sigma-algebra to the ambient one. -/
theorem feasibleXUnderQuery_measurable
    (t : {n : ℕ // 1 ≤ n}) :
    Measurable (realization.feasibleXUnderQuery run t) := by
  exact (realization.feasibleXUnderQuery_strictPast_measurable run t).mono
    (realization.filtration.le t.1) le_rfl

/-- The feasible search query is independent of the fresh sample `ξ_t`. -/
theorem feasibleXUnderQuery_indep_current_sample
    (t : {n : ℕ // 1 ≤ n}) :
    IndepFun (realization.feasibleXUnderQuery run t) (realization.xi t.1)
      realization.P := by
  exact indepFun_of_past_measurable_current_iid_sample
    (realization.feasibleXUnderQuery_strictPast_measurable run t)
    (samplePrefixFiltration_indep_current realization.xi realization.hxi_meas
      realization.hxi_indep t.1)

/-- Square-integrability of the random-query oracle noise follows from the
fixed-query variance assumption and fresh-sample independence.

This is the integrability bridge needed before applying the generic
conditional-expectation cancellation theorem. -/
theorem delta_sq_integrable_from_random_query_variance
    (t : {n : ℕ // 1 ≤ n}) :
    Integrable (fun ω =>
      ‖setup.stochasticGradientOracle
          (realization.feasibleXUnderQuery run t ω).1 (realization.xi t.1 ω) -
        setup.gradF (realization.feasibleXUnderQuery run t ω).1‖ ^ 2)
      realization.P := by
  letI : IsProbabilityMeasure realization.P := realization.hP
  let G : {x : E // x ∈ setup.X} → S → E :=
    fun x ξ => setup.stochasticGradientOracle x.1 ξ
  let target : {x : E // x ∈ setup.X} → E :=
    fun x => setup.gradF x.1
  have hres_meas :
      Measurable (fun p : {x : E // x ∈ setup.X} × S =>
        G p.1 p.2 - target p.1) := by
    simpa [G, target, StochasticAcceleratedGradientDescentSetup.oracleNoise] using
      run.oracleNoise_feasible_joint_measurable
  have hindep :
      IndepFun (realization.feasibleXUnderQuery run t) (realization.xi t.1)
        realization.P :=
    indepFun_of_past_measurable_current_iid_sample
      (realization.feasibleXUnderQuery_strictPast_measurable run t)
      (samplePrefixFiltration_indep_current realization.xi realization.hxi_meas
        realization.hxi_indep t.1)
  have hfixed_int :
      ∀ x : {x : E // x ∈ setup.X},
        Integrable (fun s => ‖G x s - target x‖ ^ 2) setup.sampleMeasure := by
    intro x
    simpa [G, target, StochasticAcceleratedGradientDescentSetup.oracleNoise,
      StochasticAcceleratedGradientDescentSetup.stochasticGradientOracle,
      SOptLib.expectationWellDefined, SOptLib.dualNorm] using
      setup.oracleVarianceWellDefined x.1 x.2
  have hfixed_bound :
      ∀ x : {x : E // x ∈ setup.X},
        ∫ s, ‖G x s - target x‖ ^ 2 ∂setup.sampleMeasure ≤ setup.sigma ^ 2 := by
    intro x
    simpa [G, target, StochasticAcceleratedGradientDescentSetup.oracleNoise,
      StochasticAcceleratedGradientDescentSetup.stochasticGradientOracle,
      SOptLib.expectation, SOptLib.dualNorm] using
      setup.oracleVariance_bound x.1 x.2
  simpa [G, target] using
    integrable_sq_oracleResidual_of_indep_fixed_variance_bound
      realization.P setup.sampleMeasure
      (realization.feasibleXUnderQuery run t) (realization.xi t.1)
      G target (setup.sigma ^ 2) hres_meas
      (realization.feasibleXUnderQuery_measurable run t)
      (realization.hxi_meas t.1) hindep (realization.hxi_law t.1)
      (sq_nonneg setup.sigma) hfixed_int hfixed_bound

/-- Random-query second-moment bound for the realized oracle noise.

Aligns with `integral_sq_oracleResidual_le_of_indep_fixed_variance`: this is
the paper's Eq. (4.2.32) variance step specialized to the feasible adapted
search query `x̲_t` and fresh sample `ξ_t`. -/
theorem delta_sq_expectation_le_variance
    (t : {n : ℕ // 1 ≤ n}) :
    ∫ ω, SOptLib.dualNorm (realization.delta run t ω) ^ 2 ∂realization.P ≤
      setup.sigma ^ 2 := by
  letI : IsProbabilityMeasure realization.P := realization.hP
  letI : IsProbabilityMeasure setup.sampleMeasure := setup.hsampleMeasure
  let G : {x : E // x ∈ setup.X} → S → E :=
    fun x ξ => setup.stochasticGradientOracle x.1 ξ
  let target : {x : E // x ∈ setup.X} → E :=
    fun x => setup.gradF x.1
  have hres_meas :
      Measurable (fun p : {x : E // x ∈ setup.X} × S =>
        G p.1 p.2 - target p.1) := by
    simpa [G, target, StochasticAcceleratedGradientDescentSetup.oracleNoise] using
      run.oracleNoise_feasible_joint_measurable
  have hindep :
      IndepFun (realization.feasibleXUnderQuery run t) (realization.xi t.1)
        realization.P :=
    indepFun_of_past_measurable_current_iid_sample
      (realization.feasibleXUnderQuery_strictPast_measurable run t)
      (samplePrefixFiltration_indep_current realization.xi realization.hxi_meas
        realization.hxi_indep t.1)
  have hfixed_bound :
      ∀ x : {x : E // x ∈ setup.X},
        ∫ s, ‖G x s - target x‖ ^ 2 ∂setup.sampleMeasure ≤ setup.sigma ^ 2 := by
    intro x
    simpa [G, target, StochasticAcceleratedGradientDescentSetup.oracleNoise,
      StochasticAcceleratedGradientDescentSetup.stochasticGradientOracle,
      SOptLib.expectation, SOptLib.dualNorm] using
      setup.oracleVariance_bound x.1 x.2
  simpa [G, target, delta, feasibleXUnderQuery,
    StochasticAcceleratedGradientDescentSetup.oracleNoise, SOptLib.dualNorm] using
    integral_sq_oracleResidual_le_of_indep_fixed_variance
      realization.P setup.sampleMeasure
      (realization.feasibleXUnderQuery run t) (realization.xi t.1)
      G target (setup.sigma ^ 2) hres_meas
      (realization.feasibleXUnderQuery_measurable run t)
      (realization.hxi_meas t.1) hindep (realization.hxi_law t.1)
      (sq_nonneg setup.sigma) hfixed_bound

/-- Integrability of `δ_t` at the adapted random search point. -/
theorem delta_integrable_from_random_query_variance
    (t : {n : ℕ // 1 ≤ n}) :
    Integrable (realization.delta run t) realization.P := by
  letI : IsProbabilityMeasure realization.P := realization.hP
  let G : {x : E // x ∈ setup.X} → S → E :=
    fun x ξ => setup.stochasticGradientOracle x.1 ξ
  let target : {x : E // x ∈ setup.X} → E :=
    fun x => setup.gradF x.1
  simpa [G, target, delta, feasibleXUnderQuery,
    StochasticAcceleratedGradientDescentSetup.oracleNoise] using
    integrable_oracle_residual_of_integrable_sq_random_query
      realization.P (realization.feasibleXUnderQuery run t) (realization.xi t.1)
      G target
      (by
        simpa [G, target, StochasticAcceleratedGradientDescentSetup.oracleNoise] using
          run.oracleNoise_feasible_joint_measurable)
      (realization.feasibleXUnderQuery_measurable run t)
      (realization.hxi_meas t.1)
      (by
        simpa [G, target] using
          realization.delta_sq_integrable_from_random_query_variance run t)

/-- Conditional mean-zero identity for the AC-SA oracle noise at the adapted
search point.

This is Eq. (4.2.32)'s martingale-noise premise in Lean form. It derives the
conditional expectation from IID fresh-sample independence, strict-past
measurability of `x̲_t`, feasible-query oracle unbiasedness, and the
random-query integrability bridge above; it does not assume the final
inner-product cancellation or the final `Δ_t` expectation bound. -/
theorem delta_condExp_zero_from_iid_unbiased
    (t : {n : ℕ // 1 ≤ n}) :
    realization.P[realization.delta run t | realization.filtration.seq t.1] =ᵐ[realization.P]
      0 := by
  letI : IsProbabilityMeasure realization.P := realization.hP
  let G : {x : E // x ∈ setup.X} → S → E :=
    fun x ξ => setup.stochasticGradientOracle x.1 ξ
  let g : {x : E // x ∈ setup.X} → E :=
    fun x => setup.gradF x.1
  have hGg_meas :
      Measurable (fun p : {x : E // x ∈ setup.X} × S => G p.1 p.2 - g p.1) := by
    simpa [G, g, StochasticAcceleratedGradientDescentSetup.oracleNoise] using
      run.oracleNoise_feasible_joint_measurable
  have hfixed_zero :
      ∀ z : {x : E // x ∈ setup.X},
        ∫ y, G z y - g z ∂(Measure.map (realization.xi t.1) realization.P) = 0 := by
    intro z
    rw [realization.hxi_law t.1]
    simpa [G, g, StochasticAcceleratedGradientDescentSetup.oracleNoise] using
      setup.oracleNoise_integral_eq_zero z.1 z.2
  have hcond :
      realization.P[
        (fun ω =>
          G (realization.feasibleXUnderQuery run t ω) (realization.xi t.1 ω) -
            g (realization.feasibleXUnderQuery run t ω)) |
          realization.filtration.seq t.1] =ᵐ[realization.P] 0 := by
    refine condExp_oracle_noise_eq_zero_of_iid_adapted
      realization.P (realization.filtration.seq t.1) ?hm G g
      (realization.feasibleXUnderQuery run t) (realization.xi t.1)
      hGg_meas
      (realization.feasibleXUnderQuery_strictPast_measurable run t)
      (realization.feasibleXUnderQuery_measurable run t)
      (realization.hxi_meas t.1) ?hindep
      ?hint hfixed_zero
    · -- The prefix filtration is a sub-sigma-algebra of the ambient space.
      exact realization.filtration.le t.1
    · intro s hs
      -- FILL: combine measurability of the event indicator and the feasible
      -- query under the past sigma-algebra, then use
      -- `samplePrefixFiltration_indep_current`.
      have hind :
          Measurable[realization.filtration.seq t.1]
            (fun ω => s.indicator (fun _ => (1 : ℝ)) ω) :=
        measurable_const.indicator hs
      have hpair :
          Measurable[realization.filtration.seq t.1]
            (fun ω => (s.indicator (fun _ => (1 : ℝ)) ω,
              realization.feasibleXUnderQuery run t ω)) :=
        hind.prodMk (realization.feasibleXUnderQuery_strictPast_measurable run t)
      exact indepFun_of_past_measurable_current_iid_sample hpair
        (samplePrefixFiltration_indep_current realization.xi realization.hxi_meas
          realization.hxi_indep t.1)
    · simpa [G, g, delta, feasibleXUnderQuery,
        StochasticAcceleratedGradientDescentSetup.oracleNoise] using
        realization.delta_integrable_from_random_query_variance run t
  simpa [G, g, delta, feasibleXUnderQuery,
    StochasticAcceleratedGradientDescentSetup.oracleNoise] using hcond

/-- Martingale cancellation for the inner-product term in `Δ_t(x*)`.

Aligns with `integral_inner_sub_const_eq_zero_of_condExp_eq_zero`: the SOptLib
lemma cancels the adapted multiplier `xPlus_t - x*`; this bridge rewrites the
paper's displayed sign `x* - xPlus_t` and handles Mathlib's totalized
nonintegrable branch. Bochner splitting later uses the separate
`delta_xStar_xPlus_inner_integrable` run-regularity field, so this theorem
remains only the martingale-cancellation part of Eq. (4.2.32). -/
theorem delta_inner_xStar_xPlus_integral_eq_zero
    (t : {n : ℕ // 1 ≤ n}) :
    ∫ ω, ⟪realization.delta run t ω,
        setup.xStar - realization.xPlus run t ω⟫_ℝ ∂realization.P = 0 := by
  letI : IsProbabilityMeasure realization.P := realization.hP
  exact integral_inner_const_sub_eq_zero_of_condExp_eq_zero
    (P := realization.P) (m := realization.filtration.seq t.1)
    (hm := realization.filtration.le t.1)
    (δ := realization.delta run t) (x := realization.xPlus run t)
    (c := setup.xStar)
    (realization.xPlus_strictPast_measurable run t)
    (realization.delta_condExp_zero_from_iid_unbiased run t)
    (realization.delta_integrable_from_random_query_variance run t)

/-- Eq. (4.2.32) packaged for Bochner integral algebra: the scalar martingale
product is integrable and has zero integral. -/
theorem delta_inner_xStar_xPlus_integrable_and_integral_eq_zero
    (t : {n : ℕ // 1 ≤ n}) :
    Integrable
        (fun ω =>
          ⟪realization.delta run t ω,
            setup.xStar - realization.xPlus run t ω⟫_ℝ)
        realization.P ∧
      ∫ ω, ⟪realization.delta run t ω,
          setup.xStar - realization.xPlus run t ω⟫_ℝ ∂realization.P = 0 :=
  ⟨realization.delta_xStar_xPlus_inner_integrable run t,
    realization.delta_inner_xStar_xPlus_integral_eq_zero run t⟩

/-- Composite upper model `l_Ψ(x̲_t, x)` from Eq. 4.2.12, indexed by positive
paper time. -/
noncomputable def lPsi (t : {n : ℕ // 1 ≤ n}) (ω : Ω) (x : E) : ℝ :=
  SOptLib.compositeLinearizedModel setup.f setup.gradF setup.h setup.mu setup.V
    (realization.xUnder run t ω) x

/-- Error term `Δ_t(x)` from Eq. 4.2.13, indexed by positive paper time. -/
noncomputable def Delta (t : {n : ℕ // 1 ≤ n}) (ω : Ω) (x : E) : ℝ :=
  SOptLib.acceleratedStochasticError
    (fun t : {n : ℕ // 1 ≤ n} => t.1)
    setup.alpha setup.gamma setup.M setup.mu setup.L SOptLib.dualNorm
    (realization.delta run) (realization.xPlus run) t ω x

/-- Output iterate `x̄_k`. -/
noncomputable def output (k : ℕ) (ω : Ω) : E :=
  realization.xBarIter run k ω

/-- Paper expected suboptimality integrand `Ψ(x̃_k) - Ψ*` for a concrete
realization of the IID sample stream. -/
noncomputable def expectedGapIntegrand (k : ℕ) (ω : Ω) : ℝ :=
  setup.Psi (realization.output run k ω) - setup.PsiStar

/-- Paper expectation of the AC-SA suboptimality gap over the realization
probability space, matching `𝔼[Ψ(x̃_k)-Ψ*]` in Theorem 4.4. -/
noncomputable def expectedGap (k : ℕ) : ℝ :=
  SOptLib.expectation realization.P (realization.expectedGapIntegrand run k)

/-- The conditional expected-gap integrand is pointwise nonnegative. -/
theorem expectedGapIntegrand_nonneg (k : ℕ) (ω : Ω) :
    0 ≤ realization.expectedGapIntegrand run k ω := by
  exact sub_nonneg.mpr
    (setup.PsiStar_le (realization.output run k ω)
      (by
        simpa [output, xBarIter] using
          (realization.process run k ω).hxBar))

/-- Measurability leaf for the final expected suboptimality gap in Theorem 4.4.

The proof of Theorem 4.4 derives integrability from the pathwise dominated
bound, so the run boundary only needs the regularity required by
`Integrable.mono'`. -/
theorem expectedGap_aestronglyMeasurable (k : ℕ) :
    AEStronglyMeasurable
      (realization.expectedGapIntegrand run k) realization.P := by
  simpa [expectedGapIntegrand, output, xBarIter, process]
    using run.expectedGapAEStronglyMeasurable k

/-- Source-generated one-step transition associated to an AC-SA execution kernel. -/
noncomputable def SourceGeneratedAcsExecution.stepFromState
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (k : ℕ)
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (ω : Ω) :
    FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X :=
  conditionalStepFromData (setup := setup) execution.halpha_mem_Icc
    (SourceGeneratedAcsExecution.proxStep realization execution)
    (fun t prev ω => (SourceGeneratedAcsExecution.proxStep_spec realization execution t prev ω).1)
    k prev ω

/-- Sample-kernel transition for the source-generated AC-SA execution.

This is the generated-process analogue of `stepFromSample`: the recursive
state update is a measurable function of the previous feasible state and the
fresh sample, with no omega-indexed selector stored in the execution object. -/
noncomputable def SourceGeneratedAcsExecution.stepFromSample
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (k : ℕ)
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (ξ : S) :
    FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X :=
  let t := SOptLib.natSuccPositiveTime k
  let xNext := execution.proxStepKernel t prev ξ
  let hxNext := (execution.proxStepKernel_spec t prev ξ).1
  let xBarNext := setup.averagePoint t prev xNext
  let hxBarNext : xBarNext ∈ setup.X := by
    rcases Set.mem_Icc.mp (execution.halpha_mem_Icc t) with
      ⟨halpha_nonneg, halpha_le_one⟩
    exact setup.hX_convex prev.hxBar hxNext (sub_nonneg.mpr halpha_le_one)
      halpha_nonneg (by ring)
  ⟨xNext, xBarNext, hxNext, hxBarNext⟩

/-- The generated omega-indexed transition is the sample-kernel transition
along the realized fresh sample. -/
theorem SourceGeneratedAcsExecution.stepFromState_eq_stepFromSample
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (k : ℕ)
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (ω : Ω) :
    SourceGeneratedAcsExecution.stepFromState realization execution k prev ω =
      SourceGeneratedAcsExecution.stepFromSample execution k prev
        (realization.xi (k + 1) ω) := by
  simp [SourceGeneratedAcsExecution.stepFromState,
    SourceGeneratedAcsExecution.stepFromSample, conditionalStepFromData,
    SOptLib.natSuccPositiveTime, SourceGeneratedAcsExecution.proxStep]

/-- Measurability of the generated source sample-kernel transition. -/
theorem SourceGeneratedAcsExecution.stepFromSample_measurable
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (k : ℕ) :
    Measurable
      (fun p : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X × S =>
        SourceGeneratedAcsExecution.stepFromSample execution k p.1 p.2) := by
  exact
    SOptLib.state_sample_step_measurable_of_coordinate_kernel_average
      (coord :=
        fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X =>
          (s.x, s.xBar))
      (kernel := fun prev ξ =>
        execution.proxStepKernel (SOptLib.natSuccPositiveTime k) prev ξ)
      (average := fun prev xNext =>
        setup.averagePoint (SOptLib.natSuccPositiveTime k) prev xNext)
      (step := fun prev ξ =>
        SourceGeneratedAcsExecution.stepFromSample execution k prev ξ)
      (leftWeight := 1 - setup.alpha (SOptLib.natSuccPositiveTime k).1)
      (rightWeight := setup.alpha (SOptLib.natSuccPositiveTime k).1)
      (feasible_state_coordinates_measurable (E := E) setup.X)
      (by simp [feasibleStateMeasurableSpace, SOptLib.feasibleAcceleratedStateMeasurableSpace])
      (execution.proxStepKernel_measurable (SOptLib.natSuccPositiveTime k))
      (by
        intro s ξ
        simp [StochasticAcceleratedGradientDescentSetup.averagePoint])
      (by
        intro s ξ
        simp [SourceGeneratedAcsExecution.stepFromSample])

/-- Generated AC-SA process associated to the source execution object.

This unfolds directly to `SOptLib.recursiveIterateProcess` applied to the causal
sample-kernel step, not to a chosen or copied `RunContract`. -/
noncomputable def generatedProcess
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup) :
    ℕ → Ω → FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X :=
  SOptLib.recursiveIterateProcess setup.initialState
    (SourceGeneratedAcsExecution.stepFromState realization execution)

/-- Successor equation for the generated process through the source sample
kernel. -/
theorem generatedProcess_succ_eq_kernel_update
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (k : ℕ) :
    realization.generatedProcess execution (k + 1) =
      fun ω =>
        SourceGeneratedAcsExecution.stepFromSample execution k
          (realization.generatedProcess execution k ω)
          (realization.xi (k + 1) ω) := by
  exact
    SOptLib.recursiveProcess_succ_eq_sample_update
      (process := realization.generatedProcess execution)
      (initial := setup.initialState)
      (omegaStep := SourceGeneratedAcsExecution.stepFromState realization execution)
      (driver := fun n ω => realization.xi (n + 1) ω)
      (sampleStep := SourceGeneratedAcsExecution.stepFromSample execution)
      (h_process := by rfl)
      (h_step := by
        intro n prev ω
        exact SourceGeneratedAcsExecution.stepFromState_eq_stepFromSample
          (realization := realization) execution n prev ω)
      k

/-- Prefix measurability of the generated AC-SA process. -/
theorem generatedProcess_measurable_wrt_samplePrefix
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (N n : ℕ) (hn : n ≤ N) :
    Measurable[realization.filtration.seq (N + 1)]
      (realization.generatedProcess execution n) := by
  classical
  refine
    SOptLib.recursiveProcess_measurable_wrt_strictPast
      (past := fun N : ℕ => realization.filtration.seq (N + 1))
      (process := realization.generatedProcess execution)
      (driver := fun n ω => realization.xi (n + 1) ω)
      (step := fun n prev ξ => SourceGeneratedAcsExecution.stepFromSample execution n prev ξ)
      N N ?_ ?_ ?_ ?_ n hn
  · change Measurable[realization.filtration.seq (N + 1)]
      (fun _ : Ω => setup.initialState)
    exact measurable_const
  · intro j hj _hprev
