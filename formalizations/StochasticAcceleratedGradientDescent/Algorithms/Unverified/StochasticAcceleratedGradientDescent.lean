      StochasticAcceleratedGradientDescentSetup.oracleNoise] using
      realization.generated_delta_sq_integrable_from_random_query_variance execution t
  have hv_sq : Integrable (fun ω => ‖v ω‖ ^ 2) realization.P := by
    simpa [v] using hxPlus_l2 t
  have hinner : Integrable (fun ω => ⟪u ω, v ω⟫_ℝ) realization.P :=
    integrable_inner_of_integrable_sq_norm hu_meas hv_meas hu_sq hv_sq
  refine hinner.congr ?_
  filter_upwards with ω
  subst proc
  simp [u, v, generatedXUnder, generatedXPlus,
    StochasticAcceleratedGradientDescentSetup.searchPoint,
    StochasticAcceleratedGradientDescentSetup.oracleNoise,
    acsaCheckedQuotient]

