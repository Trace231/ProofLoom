    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup) :
    ∀ n : ℕ,
      Integrable
          (fun ω => ‖setup.xStar -
            (realization.generatedProcess execution n ω).x‖ ^ 2)
          realization.P ∧
        Integrable
          (fun ω => ‖setup.xStar -
            (realization.generatedProcess execution n ω).xBar‖ ^ 2)
          realization.P := by
  classical
  letI : IsProbabilityMeasure realization.P := realization.hP
  have hnoise :
      ∀ t : {n : ℕ // 1 ≤ n},
        Integrable
          (fun ω =>
            ‖setup.oracleNoise
              (realization.generatedXUnder execution t ω)
              (realization.xi t.1 ω)‖ ^ 2)
          realization.P := by
    intro t
    exact generated_prop42_noise_square_integrable_for_telescope
      (realization := realization) (setup := setup) execution t
  have hrec := generated_prop42_xstar_pathwise_recurrence
    (setup := setup) execution
  have hbreg_rec := generated_prop42_xstar_bregman_recurrence
    (setup := setup) execution
  have hbreg_state := generated_prop42_xstar_bregman_state_step
    (setup := setup) execution
  have htelescope := generated_prop43_xstar_finite_window_telescope
    (setup := setup) execution
  have hprefix_xPlus :
      ∀ n : ℕ,
        Integrable
            (fun ω => ‖setup.xStar -
              (realization.generatedProcess execution n ω).x‖ ^ 2)
            realization.P →
        Integrable
            (fun ω => ‖setup.xStar -
              (realization.generatedProcess execution n ω).xBar‖ ^ 2)
            realization.P →
        Integrable
          (fun ω => ‖setup.xStar -
            realization.generatedXPlus execution (SOptLib.natSuccPositiveTime n) ω‖ ^ 2)
          realization.P := by
    intro n hx hxBar
    exact generated_xplus_sq_integrable_of_previous_state_l2
      (realization := realization) (setup := setup) execution n hx hxBar
