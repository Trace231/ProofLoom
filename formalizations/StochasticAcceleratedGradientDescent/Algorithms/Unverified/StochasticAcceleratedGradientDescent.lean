      ∀ n : ℕ,
        Integrable
            (fun ω => ‖setup.xStar -
              (realization.generatedProcess execution n ω).x‖ ^ 2)
            realization.P →
        Integrable
            (fun ω => ‖setup.xStar -
              (realization.generatedProcess execution n ω).xBar‖ ^ 2)
            realization.P →
        Integrable
          (fun ω =>
            setup.alpha (n + 1) * setup.gamma (n + 1) *
                (setup.M +
                  ‖setup.oracleNoise
                    (realization.generatedXUnder execution (SOptLib.natSuccPositiveTime n) ω)
                    (realization.xi (n + 1) ω)‖) ^ 2 /
                  (2 * (1 + setup.mu * setup.gamma (n + 1) -
                    setup.L * setup.alpha (n + 1) * setup.gamma (n + 1))) +
              setup.alpha (n + 1) *
                ⟪setup.oracleNoise
                    (realization.generatedXUnder execution (SOptLib.natSuccPositiveTime n) ω)
                    (realization.xi (n + 1) ω),
                  setup.xStar -
                    realization.generatedXPlus execution (SOptLib.natSuccPositiveTime n) ω⟫_ℝ)
          realization.P := by
    intro n hx hxBar
    exact generated_prop42_delta_summand_integrable_of_previous_state_l2
