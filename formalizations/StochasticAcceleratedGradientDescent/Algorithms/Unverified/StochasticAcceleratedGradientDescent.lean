private theorem _voucher_step_inner_le_norm_mul_46
    (u v : E) :
    ⟪u, v⟫_ℝ ≤ ‖u‖ * ‖v‖ := by
  calc
    ⟪u, v⟫_ℝ ≤ |⟪u, v⟫_ℝ| :=
      le_abs_self _
    _ = ‖⟪u, v⟫_ℝ‖ := by
