private theorem _voucher_step_two_mul_norm_young_46
    (u v : E) :
    2 * ‖u‖ * ‖v‖ ≤ ‖u‖ ^ 2 + ‖v‖ ^ 2 := by
  nlinarith [sq_nonneg (‖u‖ - ‖v‖)]

/-! Scaled Cauchy-Schwarz/Young bound used for xPlus displacement absorption.
Considered SOptLib's `mul_le_half_sq_add_two_mul_sq_of_le_mul_add` and
`inner_sub_sub_bregman_le_half_dual_sq`; their weights are specialized to
different prox estimates, while this local helper exposes the literal
quarter-square coefficient needed for the AC-SA `1 + μγ` coercivity term. -/
private theorem inner_mul_le_scaled_quarter_sq
    {u v : E} {γ c : ℝ}
    (hgamma_nonneg : 0 ≤ γ) (hc_pos : 0 < c) :
    γ * ⟪u, v⟫_ℝ ≤ (c / 4) * ‖v‖ ^ 2 + (γ ^ 2 / c) * ‖u‖ ^ 2 := by
  have hinner : ⟪u, v⟫_ℝ ≤ ‖u‖ * ‖v‖ :=
    _voucher_step_inner_le_norm_mul_46 u v
  have hmul :
      γ * ⟪u, v⟫_ℝ ≤ γ * (‖u‖ * ‖v‖) :=
    mul_le_mul_of_nonneg_left hinner hgamma_nonneg
  have hsquare : 0 ≤ (c * ‖v‖ - 2 * γ * ‖u‖) ^ 2 :=
    sq_nonneg _
  have hscalar :
      γ * (‖u‖ * ‖v‖) ≤ (c / 4) * ‖v‖ ^ 2 + (γ ^ 2 / c) * ‖u‖ ^ 2 := by
    field_simp [ne_of_gt hc_pos]
    nlinarith [hsquare]
  exact hmul.trans hscalar

