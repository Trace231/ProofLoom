/-- Scalar absorption for the prox-aware displacement route.

This is not a paper primitive: it is the algebraic Young-inequality bridge
needed after prox coercivity has reduced the AC-SA step to a linear growth
term in `‖z - xPlus‖`.  Considered `inner_mul_le_scaled_quarter_sq`,
`SOptLib.inner_sub_sub_bregman_le_half_dual_sq`, and the prox FOC candidates;
those package vector/prox estimates, while this helper only normalizes the
remaining real scalar budget before the source-specific chord-growth bound is
inserted. -/
private theorem acsa_scalar_sq_le_of_coercive_linear_growth
    {r c γ A C N G B B0 St : ℝ}
    (hr_nonneg : 0 ≤ r)
    (hc_ge_one : 1 ≤ c)
    (hgamma_nonneg : 0 ≤ γ)
    (hA_nonneg : 0 ≤ A)
    (hC_nonneg : 0 ≤ C)
    (hN_nonneg : 0 ≤ N)
    (hG_nonneg : 0 ≤ G)
    (hB_nonneg : 0 ≤ B)
    (hB0_nonneg : 0 ≤ B0)
    (hcoercive :
      (c / 4) * r ^ 2 ≤ A * St + C + γ * G * r + (γ ^ 2 / c) * N)
    (hGsq : G ^ 2 ≤ B * St + B0)
    (hS_nonneg : 0 ≤ St) :
    r ^ 2 ≤
      (8 * A + 16 * γ ^ 2 * B) * St +
        (8 * γ ^ 2 + 1) * N +
        (8 * C + 16 * γ ^ 2 * B0) := by
  have hc_pos : 0 < c := by linarith
  have hc_nonneg : 0 ≤ c := le_of_lt hc_pos
  have hc_inv_le_one : c⁻¹ ≤ 1 := by
    have h := inv_le_one_of_one_le₀ hc_ge_one
    simpa using h
  have hc_inv_nonneg : 0 ≤ c⁻¹ := inv_nonneg.mpr (le_of_lt hc_pos)
  have hc_inv_sq_le_one : c⁻¹ ^ 2 ≤ 1 := by
    nlinarith [hc_inv_nonneg, hc_inv_le_one]
  have hc_inv_nonneg : 0 ≤ c⁻¹ := inv_nonneg.mpr hc_nonneg
  have hc_inv_sq_nonneg : 0 ≤ c⁻¹ ^ 2 := sq_nonneg c⁻¹
  have hc_inv_sq_le_one : c⁻¹ ^ 2 ≤ 1 := by
    nlinarith [hc_inv_nonneg, hc_inv_le_one]
  have hyoung :
      γ * G * r ≤ (c / 8) * r ^ 2 + (2 * γ ^ 2 * G ^ 2) / c := by
    field_simp [ne_of_gt hc_pos]
    nlinarith [sq_nonneg (c * r - 4 * γ * G)]
  have hcoercive' :
      (c / 8) * r ^ 2 ≤ A * St + C + (2 * γ ^ 2 * G ^ 2) / c +
          (γ ^ 2 / c) * N := by
    nlinarith [hcoercive, hyoung]
  have hscale :
      r ^ 2 ≤
        8 * (A * St + C + (2 * γ ^ 2 * G ^ 2) / c +
          (γ ^ 2 / c) * N) / c := by
    have hmul := mul_le_mul_of_nonneg_left hcoercive' (by positivity : 0 ≤ 8 / c)
    field_simp [ne_of_gt hc_pos] at hmul ⊢
    nlinarith
  have hG_budget_nonneg : 0 ≤ B * St + B0 := by
    nlinarith [mul_nonneg hB_nonneg hS_nonneg, hB0_nonneg]
  have hGsq_nonneg : 0 ≤ G ^ 2 := sq_nonneg G
  have hG_term :
      16 * γ ^ 2 * G ^ 2 * c⁻¹ ^ 2 ≤
        16 * γ ^ 2 * (B * St + B0) := by
    have hleft :
        G ^ 2 * c⁻¹ ^ 2 ≤ B * St + B0 := by
      have htmp := mul_le_mul hGsq hc_inv_sq_le_one hc_inv_sq_nonneg hG_budget_nonneg
      nlinarith [htmp, hGsq]
    have hcoef_nonneg : 0 ≤ 16 * γ ^ 2 := by positivity
    have htmp := mul_le_mul_of_nonneg_left hleft hcoef_nonneg
    nlinarith [htmp]
  have hA_term : 8 * A * St * c⁻¹ ≤ 8 * A * St := by
    have hAS_nonneg : 0 ≤ 8 * A * St := by positivity
    have htmp := mul_le_mul_of_nonneg_left hc_inv_le_one hAS_nonneg
    nlinarith [htmp]
  have hC_term : 8 * C * c⁻¹ ≤ 8 * C := by
    have hC8_nonneg : 0 ≤ 8 * C := by positivity
    have htmp := mul_le_mul_of_nonneg_left hc_inv_le_one hC8_nonneg
    nlinarith [htmp]
  have hN_term : 8 * γ ^ 2 * N * c⁻¹ ^ 2 ≤ (8 * γ ^ 2 + 1) * N := by
    have hleft :
        8 * γ ^ 2 * N * c⁻¹ ^ 2 ≤ 8 * γ ^ 2 * N := by
      have hcoef_nonneg : 0 ≤ 8 * γ ^ 2 * N := by positivity
      have htmp := mul_le_mul_of_nonneg_left hc_inv_sq_le_one hcoef_nonneg
      nlinarith [htmp]
    nlinarith [hleft, hN_nonneg]
  calc
    r ^ 2
        ≤ 8 * (A * St + C + (2 * γ ^ 2 * G ^ 2) / c +
            (γ ^ 2 / c) * N) / c := hscale
    _ = 8 * A * St * c⁻¹ + 8 * C * c⁻¹ +
          16 * γ ^ 2 * G ^ 2 * c⁻¹ ^ 2 +
          8 * γ ^ 2 * N * c⁻¹ ^ 2 := by
        field_simp [ne_of_gt hc_pos]
        ring
    _ ≤ 8 * A * St + 8 * C +
          16 * γ ^ 2 * (B * St + B0) +
          (8 * γ ^ 2 + 1) * N := by
        nlinarith [hA_term, hC_term, hG_term, hN_term]
    _ = (8 * A + 16 * γ ^ 2 * B) * St +
          (8 * γ ^ 2 + 1) * N +
          (8 * C + 16 * γ ^ 2 * B0) := by
        ring

/-- Scalar absorption for the repaired prox-displacement bridge.

This direct-budget variant is not a paper primitive; it is the local real
algebra needed once the deterministic composite term has been converted into a
concrete affine budget in the search-state variable. -/
private theorem acsa_scalar_sq_le_of_budgeted_coercive
    {r c γ A C N B B0 St : ℝ}
    (hr_nonneg : 0 ≤ r)
    (hc_ge_one : 1 ≤ c)
    (hgamma_nonneg : 0 ≤ γ)
    (hA_nonneg : 0 ≤ A)
    (hC_nonneg : 0 ≤ C)
    (hN_nonneg : 0 ≤ N)
    (hB_nonneg : 0 ≤ B)
    (hB0_nonneg : 0 ≤ B0)
    (hS_nonneg : 0 ≤ St)
    (hcoercive :
      (c / 4) * r ^ 2 ≤ A * St + C + γ * (B * St + B0) + (γ ^ 2 / c) * N) :
    r ^ 2 ≤
      (8 * A + 8 * γ * B) * St +
        (8 * γ ^ 2 + 1) * N +
        (8 * C + 8 * γ * B0) := by
  have hc_pos : 0 < c := by linarith
  have hc_inv_le_one : c⁻¹ ≤ 1 := by
    have h := inv_le_one_of_one_le₀ hc_ge_one
    simpa using h
  have hc_inv_nonneg : 0 ≤ c⁻¹ := inv_nonneg.mpr (le_of_lt hc_pos)
  have hc_inv_sq_le_one : c⁻¹ ^ 2 ≤ 1 := by
    nlinarith [hc_inv_nonneg, hc_inv_le_one]
  have hbudget_nonneg :
      0 ≤ A * St + C + γ * (B * St + B0) + (γ ^ 2 / c) * N := by
    have hBbudget_nonneg : 0 ≤ B * St + B0 := by
      nlinarith [mul_nonneg hB_nonneg hS_nonneg, hB0_nonneg]
    have hden_nonneg : 0 ≤ γ ^ 2 / c := by positivity
    nlinarith [mul_nonneg hA_nonneg hS_nonneg, hC_nonneg,
      mul_nonneg hgamma_nonneg hBbudget_nonneg,
      mul_nonneg hden_nonneg hN_nonneg]
  have hscale_div :
      r ^ 2 ≤
        4 * (A * St + C + γ * (B * St + B0) + (γ ^ 2 / c) * N) / c := by
    have hmul := mul_le_mul_of_nonneg_left hcoercive (by positivity : 0 ≤ 4 / c)
    field_simp [ne_of_gt hc_pos] at hmul ⊢
    nlinarith
  calc
    r ^ 2
        ≤ 4 * (A * St + C + γ * (B * St + B0) + (γ ^ 2 / c) * N) / c :=
          hscale_div
    _ = 4 * A * St * c⁻¹ + 4 * C * c⁻¹ +
          4 * γ * B * St * c⁻¹ + 4 * γ * B0 * c⁻¹ +
          4 * γ ^ 2 * N * c⁻¹ ^ 2 := by
        field_simp [ne_of_gt hc_pos]
        ring
    _ ≤ 8 * A * St + 8 * C +
          8 * γ * B * St + 8 * γ * B0 +
          (8 * γ ^ 2 + 1) * N := by
        have hASt_nonneg : 0 ≤ A * St := mul_nonneg hA_nonneg hS_nonneg
        have hBSt_nonneg : 0 ≤ B * St := mul_nonneg hB_nonneg hS_nonneg
        have hgBSt_nonneg : 0 ≤ γ * B * St := by positivity
        have hgB0_nonneg : 0 ≤ γ * B0 := mul_nonneg hgamma_nonneg hB0_nonneg
        have hA_term : 4 * A * St * c⁻¹ ≤ 8 * A * St := by
          have htmp := mul_le_mul_of_nonneg_left hc_inv_le_one
            (by positivity : 0 ≤ 4 * A * St)
          nlinarith [htmp, hASt_nonneg]
        have hC_term : 4 * C * c⁻¹ ≤ 8 * C := by
          have htmp := mul_le_mul_of_nonneg_left hc_inv_le_one
            (by positivity : 0 ≤ 4 * C)
          nlinarith [htmp, hC_nonneg]
        have hB_term : 4 * γ * B * St * c⁻¹ ≤ 8 * γ * B * St := by
          have htmp := mul_le_mul_of_nonneg_left hc_inv_le_one
            (by positivity : 0 ≤ 4 * γ * B * St)
          nlinarith [htmp, hgBSt_nonneg]
        have hB0_term : 4 * γ * B0 * c⁻¹ ≤ 8 * γ * B0 := by
          have htmp := mul_le_mul_of_nonneg_left hc_inv_le_one
            (by positivity : 0 ≤ 4 * γ * B0)
          nlinarith [htmp, hgB0_nonneg]
        have hN_term : 4 * γ ^ 2 * N * c⁻¹ ^ 2 ≤ (8 * γ ^ 2 + 1) * N := by
          have hleft : 4 * γ ^ 2 * N * c⁻¹ ^ 2 ≤ 4 * γ ^ 2 * N := by
            have hcoef : 0 ≤ 4 * γ ^ 2 * N := by positivity
            have htmp := mul_le_mul_of_nonneg_left hc_inv_sq_le_one hcoef
            nlinarith [htmp]
          have hcoef_large : 4 * γ ^ 2 * N ≤ (8 * γ ^ 2 + 1) * N := by
            nlinarith [sq_nonneg γ, hN_nonneg]
          exact hleft.trans hcoef_large
        nlinarith [hA_term, hC_term, hB_term, hB0_term, hN_term]
    _ = (8 * A + 8 * γ * B) * St +
          (8 * γ ^ 2 + 1) * N +
          (8 * C + 8 * γ * B0) := by
        ring

