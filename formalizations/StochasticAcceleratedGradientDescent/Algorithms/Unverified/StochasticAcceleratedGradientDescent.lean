`summed_one_step_gap_bound_of_telescope`, and
`sum_range_sub_succ_le_first_of_last_nonneg`; the later private theorem is
declaration-order inaccessible here and drops this tail in its public
conclusion, while the SOptLib/Glue candidates telescope exact successive drops
or drop a nonnegative tail rather than preserving the source endpoint term. -/
private theorem acsa_scalar_weighted_bregman_telescope_with_tail
    (c beta V : ℕ → ℝ) (k : ℕ) (hk : 1 ≤ k)
    (hV_nonneg : ∀ n, 0 ≤ V n)
    (hc_mono : ∀ n, 1 ≤ n → c (n + 1) ≤ c n * beta n)
    (hcb_nonneg : ∀ n, 1 ≤ n → 0 ≤ c n * beta n) :
    Finset.sum (Finset.Icc 1 k) (fun t =>
        c t * (V (t - 1) - beta t * V t)) ≤
      c 1 * V 0 - c k * beta k * V k := by
  classical
  induction k, hk using Nat.le_induction with
  | base =>
      simp
      nlinarith
  | succ n hn ih =>
      have hn1 : 1 ≤ n + 1 := Nat.succ_le_succ (Nat.zero_le n)
      rw [Finset.sum_Icc_succ_top hn1]
      have hpred : n + 1 - 1 = n := Nat.succ_sub_one n
      have hbridge : 0 ≤ (c n * beta n - c (n + 1)) * V n := by
        exact mul_nonneg (sub_nonneg.mpr (hc_mono n hn)) (hV_nonneg n)
      rw [hpred]
      nlinarith

/-- Final generated finite-window regularity closure from the source
