/-- Successor state L2 transport from an `x_t - x_{t-1}^+` displacement bound.

Aligns with Lan Eqs. (4.2.5), (4.2.7), and (4.2.14): searched
`Integrable norm square generatedXPlus MemLp state_l2` and
`integrable square norm affine combination MemLp const_smul add`; the reusable
target-file bridge `generated_xStar_sub_xPlus_sq_integrable_of_state_l2`
requires a full-horizon state premise, while the SOptLib hits are generic
`MemLp` closure lemmas.  This helper isolates the one-step affine bookkeeping
needed after the source Prop. 4.2 tail supplies the displacement L2 premise. -/
private theorem generated_successor_state_l2_from_xplus_displacement
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (n : ℕ)
    (hprev_x :
      Integrable
        (fun ω => ‖setup.xStar -
          (realization.generatedProcess execution n ω).x‖ ^ 2)
        realization.P)
    (hprev_xBar :
      Integrable
        (fun ω => ‖setup.xStar -
          (realization.generatedProcess execution n ω).xBar‖ ^ 2)
        realization.P)
    (hdisp :
      Integrable
        (fun ω => ‖(realization.generatedProcess execution (n + 1) ω).x -
          realization.generatedXPlus execution (SOptLib.natSuccPositiveTime n) ω‖ ^ 2)
        realization.P) :
    Integrable
        (fun ω => ‖setup.xStar -
          (realization.generatedProcess execution (n + 1) ω).x‖ ^ 2)
        realization.P ∧
      Integrable
        (fun ω => ‖setup.xStar -
          (realization.generatedProcess execution (n + 1) ω).xBar‖ ^ 2)
        realization.P := by
  classical
  letI : IsProbabilityMeasure realization.P := realization.hP
  let τ : {m : ℕ // 1 ≤ m} := SOptLib.natSuccPositiveTime n
  have hproc_succ :
      realization.generatedProcess execution (n + 1) =
        fun ω =>
          SourceGeneratedAcsExecution.stepFromSample execution n
            (realization.generatedProcess execution n ω)
            (realization.xi (n + 1) ω) :=
    realization.generatedProcess_succ_eq_kernel_update execution n
  have hproc_prev_meas :
      Measurable (realization.generatedProcess execution n) := by
    have hproc_sub :
        Measurable[realization.filtration.seq (n + 1)]
          (realization.generatedProcess execution n) :=
      realization.generatedProcess_measurable_wrt_samplePrefix execution n n le_rfl
    exact hproc_sub.mono (realization.filtration.le (n + 1)) le_rfl
  have hproc_succ_meas :
      Measurable (realization.generatedProcess execution (n + 1)) := by
    have hproc_sub :
        Measurable[realization.filtration.seq ((n + 1) + 1)]
          (realization.generatedProcess execution (n + 1)) :=
      realization.generatedProcess_measurable_wrt_samplePrefix execution
        (n + 1) (n + 1) le_rfl
    exact hproc_sub.mono (realization.filtration.le ((n + 1) + 1)) le_rfl
  have hcoord :
      Measurable
        (fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X =>
          (s.x, s.xBar)) :=
    feasible_state_coordinates_measurable (E := E) setup.X
  have hx_prev_meas :
      Measurable (fun ω => (realization.generatedProcess execution n ω).x) :=
    hcoord.fst.comp hproc_prev_meas
  have hxBar_prev_meas :
      Measurable (fun ω => (realization.generatedProcess execution n ω).xBar) :=
    hcoord.snd.comp hproc_prev_meas
  have hx_succ_meas :
      Measurable (fun ω => (realization.generatedProcess execution (n + 1) ω).x) :=
    hcoord.fst.comp hproc_succ_meas
  have hxBar_succ_meas :
      Measurable (fun ω => (realization.generatedProcess execution (n + 1) ω).xBar) :=
    hcoord.snd.comp hproc_succ_meas
  have hx_prev_disp_meas :
      AEStronglyMeasurable
        (fun ω => setup.xStar -
          (realization.generatedProcess execution n ω).x) realization.P :=
    (measurable_const.sub hx_prev_meas).aestronglyMeasurable
  have hxBar_prev_disp_meas :
      AEStronglyMeasurable
        (fun ω => setup.xStar -
          (realization.generatedProcess execution n ω).xBar) realization.P :=
    (measurable_const.sub hxBar_prev_meas).aestronglyMeasurable
  have hx_prev_disp_l2 :
      MemLp
        (fun ω => setup.xStar -
          (realization.generatedProcess execution n ω).x) 2 realization.P :=
    (memLp_two_iff_integrable_sq_norm hx_prev_disp_meas).2 hprev_x
  have hxBar_prev_disp_l2 :
      MemLp
        (fun ω => setup.xStar -
          (realization.generatedProcess execution n ω).xBar) 2 realization.P :=
    (memLp_two_iff_integrable_sq_norm hxBar_prev_disp_meas).2 hprev_xBar
  have hx_prev_l2 :
      MemLp (fun ω => (realization.generatedProcess execution n ω).x)
        2 realization.P := by
    have hconst : MemLp (fun _ : Ω => setup.xStar) 2 realization.P :=
      memLp_const setup.xStar
    have hraw := hconst.sub hx_prev_disp_l2
    exact MemLp.ae_eq
      (Filter.Eventually.of_forall (fun ω => by
        simpa [Pi.sub_apply] using
          (sub_sub_cancel setup.xStar
            (realization.generatedProcess execution n ω).x)))
      hraw
  have hxBar_prev_l2 :
      MemLp (fun ω => (realization.generatedProcess execution n ω).xBar)
        2 realization.P := by
    have hconst : MemLp (fun _ : Ω => setup.xStar) 2 realization.P :=
      memLp_const setup.xStar
    have hraw := hconst.sub hxBar_prev_disp_l2
    exact MemLp.ae_eq
      (Filter.Eventually.of_forall (fun ω => by
        simpa [Pi.sub_apply] using
          (sub_sub_cancel setup.xStar
            (realization.generatedProcess execution n ω).xBar)))
      hraw
  have hxUnder_l2 :
      MemLp (realization.generatedXUnder execution τ) 2 realization.P := by
    have hxBar_scaled :
        MemLp
          (fun ω =>
            (1 - setup.q τ.1) •
              (realization.generatedProcess execution n ω).xBar)
          2 realization.P :=
      hxBar_prev_l2.const_smul (1 - setup.q τ.1)
    have hx_scaled :
        MemLp
          (fun ω =>
            setup.q τ.1 •
              (realization.generatedProcess execution n ω).x)
          2 realization.P :=
      hx_prev_l2.const_smul (setup.q τ.1)
    have hsum := hxBar_scaled.add hx_scaled
    simpa [generatedXUnder, StochasticAcceleratedGradientDescentSetup.searchPoint,
      τ, SOptLib.natSuccPositiveTime] using hsum
  have hxPlus_l2 :
      MemLp (realization.generatedXPlus execution τ) 2 realization.P := by
    let a : ℝ :=
      acsaCheckedQuotient (setup.mu * setup.gamma τ.1)
        (1 + setup.mu * setup.gamma τ.1)
        (by
          have hγ_nonneg : 0 ≤ setup.gamma τ.1 :=
            le_of_lt (execution.hgamma_pos τ)
          have hmul : 0 ≤ setup.mu * setup.gamma τ.1 :=
            mul_nonneg setup.hmu_nonneg hγ_nonneg
          exact ne_of_gt (by linarith : 0 < 1 + setup.mu * setup.gamma τ.1))
    let b : ℝ :=
      acsaCheckedQuotient 1
        (1 + setup.mu * setup.gamma τ.1)
        (by
          have hγ_nonneg : 0 ≤ setup.gamma τ.1 :=
            le_of_lt (execution.hgamma_pos τ)
          have hmul : 0 ≤ setup.mu * setup.gamma τ.1 :=
            mul_nonneg setup.hmu_nonneg hγ_nonneg
          exact ne_of_gt (by linarith : 0 < 1 + setup.mu * setup.gamma τ.1))
    have hleft :
        MemLp (fun ω => a • realization.generatedXUnder execution τ ω)
          2 realization.P :=
      hxUnder_l2.const_smul a
    have hright :
        MemLp
          (fun ω => b • (realization.generatedProcess execution n ω).x)
          2 realization.P :=
      hx_prev_l2.const_smul b
    have hsum := hleft.add hright
    simpa [generatedXPlus, a, b, τ, SOptLib.natSuccPositiveTime] using hsum
  have hdisp_meas :
      AEStronglyMeasurable
        (fun ω => (realization.generatedProcess execution (n + 1) ω).x -
          realization.generatedXPlus execution τ ω) realization.P :=
    (hx_succ_meas.sub (realization.generatedXPlus_measurable execution τ)).aestronglyMeasurable
  have hdisp_l2 :
      MemLp
        (fun ω => (realization.generatedProcess execution (n + 1) ω).x -
          realization.generatedXPlus execution τ ω) 2 realization.P :=
    (memLp_two_iff_integrable_sq_norm hdisp_meas).2 (by
      simpa [τ] using hdisp)
  have hx_succ_l2 :
      MemLp (fun ω => (realization.generatedProcess execution (n + 1) ω).x)
        2 realization.P := by
    have hraw := hxPlus_l2.add hdisp_l2
    exact MemLp.ae_eq
      (Filter.Eventually.of_forall (fun ω => by
        change realization.generatedXPlus execution τ ω +
            ((realization.generatedProcess execution (n + 1) ω).x -
              realization.generatedXPlus execution τ ω) =
          (realization.generatedProcess execution (n + 1) ω).x
        abel))
      hraw
  have hx_succ_center_l2 :
      MemLp
        (fun ω => setup.xStar -
          (realization.generatedProcess execution (n + 1) ω).x) 2 realization.P := by
    have hconst : MemLp (fun _ : Ω => setup.xStar) 2 realization.P :=
      memLp_const setup.xStar
    exact hconst.sub hx_succ_l2
  have hx_succ_int :
      Integrable
        (fun ω => ‖setup.xStar -
          (realization.generatedProcess execution (n + 1) ω).x‖ ^ 2)
        realization.P :=
    (memLp_two_iff_integrable_sq_norm hx_succ_center_l2.aestronglyMeasurable).1
      hx_succ_center_l2
  have hxBar_succ_combo_l2 :
      MemLp
        (fun ω =>
          (1 - setup.alpha (n + 1)) •
              (setup.xStar - (realization.generatedProcess execution n ω).xBar) +
            setup.alpha (n + 1) •
              (setup.xStar -
                (realization.generatedProcess execution (n + 1) ω).x))
        2 realization.P :=
    (hxBar_prev_disp_l2.const_smul (1 - setup.alpha (n + 1))).add
      (hx_succ_center_l2.const_smul (setup.alpha (n + 1)))
  have hxBar_succ_l2 :
      MemLp
        (fun ω => setup.xStar -
          (realization.generatedProcess execution (n + 1) ω).xBar) 2 realization.P := by
    refine MemLp.ae_eq (Filter.Eventually.of_forall ?_) hxBar_succ_combo_l2
    intro ω
    have hω := congrFun hproc_succ ω
    have hxbar_eq :
        (realization.generatedProcess execution (n + 1) ω).xBar =
          setup.averagePoint τ (realization.generatedProcess execution n ω)
            (execution.proxStepKernel τ (realization.generatedProcess execution n ω)
              (realization.xi (n + 1) ω)) := by
      simpa [SourceGeneratedAcsExecution.stepFromSample, τ, SOptLib.natSuccPositiveTime] using
        congrArg
          (fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X =>
            s.xBar) hω
    have hx_eq :
        (realization.generatedProcess execution (n + 1) ω).x =
          execution.proxStepKernel τ (realization.generatedProcess execution n ω)
            (realization.xi (n + 1) ω) := by
      simpa [SourceGeneratedAcsExecution.stepFromSample, τ, SOptLib.natSuccPositiveTime] using
        congrArg
          (fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X =>
            s.x) hω
    simp [hxbar_eq, hx_eq, StochasticAcceleratedGradientDescentSetup.averagePoint,
      τ, SOptLib.natSuccPositiveTime, sub_add_eq_add_sub, sub_eq_add_neg,
      add_comm, add_left_comm, add_assoc, smul_add]
    module
  have hxBar_succ_int :
      Integrable
        (fun ω => ‖setup.xStar -
          (realization.generatedProcess execution (n + 1) ω).xBar‖ ^ 2)
        realization.P :=
    (memLp_two_iff_integrable_sq_norm hxBar_succ_l2.aestronglyMeasurable).1
      hxBar_succ_l2
  exact ⟨hx_succ_int, hxBar_succ_int⟩

/-- Displacement L2 from a pointwise Prop. 4.2-style envelope.

Aligns with Lan Eq. (4.2.19) and Eq. (4.2.32) well-definedness: searched
`displacement integrable pointwise bound oracle variance` and reused the
target-file random-query theorem
`generated_delta_sq_integrable_from_random_query_variance`; SOptLib provides
generic integrability closure but no generated AC-SA displacement envelope. -/
private theorem generated_displacement_l2_of_pointwise_bound
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (n : ℕ) (A B D C : ℝ)
    (hprev_x :
      Integrable
        (fun ω => ‖setup.xStar -
          (realization.generatedProcess execution n ω).x‖ ^ 2)
        realization.P)
    (hprev_xBar :
      Integrable
        (fun ω => ‖setup.xStar -
          (realization.generatedProcess execution n ω).xBar‖ ^ 2)
        realization.P)
    (hpoint :
      ∀ ω,
        ‖(realization.generatedProcess execution (n + 1) ω).x -
            realization.generatedXPlus execution (SOptLib.natSuccPositiveTime n) ω‖ ^ 2 ≤
          A * ‖setup.xStar - (realization.generatedProcess execution n ω).x‖ ^ 2 +
            B * ‖setup.xStar - (realization.generatedProcess execution n ω).xBar‖ ^ 2 +
            D * ‖setup.oracleNoise
                (realization.generatedXUnder execution (SOptLib.natSuccPositiveTime n) ω)
                (realization.xi (n + 1) ω)‖ ^ 2 + C) :
    Integrable
      (fun ω => ‖(realization.generatedProcess execution (n + 1) ω).x -
          realization.generatedXPlus execution (SOptLib.natSuccPositiveTime n) ω‖ ^ 2)
      realization.P := by
  classical
  letI : IsProbabilityMeasure realization.P := realization.hP
  let τ : {m : ℕ // 1 ≤ m} := SOptLib.natSuccPositiveTime n
  have hproc_succ_meas :
      Measurable (realization.generatedProcess execution (n + 1)) := by
    have hproc_sub :
        Measurable[realization.filtration.seq ((n + 1) + 1)]
          (realization.generatedProcess execution (n + 1)) :=
      realization.generatedProcess_measurable_wrt_samplePrefix execution
        (n + 1) (n + 1) le_rfl
    exact hproc_sub.mono (realization.filtration.le ((n + 1) + 1)) le_rfl
  have hcoord :
      Measurable
        (fun s : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X =>
          (s.x, s.xBar)) :=
    feasible_state_coordinates_measurable (E := E) setup.X
  have hx_succ_meas :
      Measurable (fun ω => (realization.generatedProcess execution (n + 1) ω).x) :=
    hcoord.fst.comp hproc_succ_meas
  have hdisp_sq_meas :
      AEStronglyMeasurable
        (fun ω => ‖(realization.generatedProcess execution (n + 1) ω).x -
          realization.generatedXPlus execution τ ω‖ ^ 2) realization.P :=
    ((hx_succ_meas.sub
      (realization.generatedXPlus_measurable execution τ)).norm.pow_const 2).aestronglyMeasurable
  have hnoise_int :
      Integrable
        (fun ω =>
          ‖setup.oracleNoise
              (realization.generatedXUnder execution τ ω)
              (realization.xi (n + 1) ω)‖ ^ 2)
        realization.P := by
    simpa [τ, SOptLib.natSuccPositiveTime, generatedFeasibleXUnderQuery, generatedXUnder,
      StochasticAcceleratedGradientDescentSetup.oracleNoise,
      StochasticAcceleratedGradientDescentSetup.stochasticGradientOracle] using
      realization.generated_delta_sq_integrable_from_random_query_variance
        execution τ
  have hrhs_int :
      Integrable
        (fun ω =>
          A * ‖setup.xStar - (realization.generatedProcess execution n ω).x‖ ^ 2 +
            B * ‖setup.xStar - (realization.generatedProcess execution n ω).xBar‖ ^ 2 +
            D * ‖setup.oracleNoise
                (realization.generatedXUnder execution τ ω)
                (realization.xi (n + 1) ω)‖ ^ 2 + C)
        realization.P := by
    exact (((hprev_x.const_mul A).add (hprev_xBar.const_mul B)).add
      (hnoise_int.const_mul D)).add (integrable_const (c := C))
  refine hrhs_int.mono' hdisp_sq_meas (Filter.Eventually.of_forall ?_)
  intro ω
  rw [Real.norm_of_nonneg (sq_nonneg
    ‖(realization.generatedProcess execution (n + 1) ω).x -
      realization.generatedXPlus execution τ ω‖)]
  simpa [τ] using hpoint ω

/-- Eq. (4.2.14) `xPlus` state control after eliminating the search point.

Aligns with Lan Eqs. (4.2.5) and (4.2.14).  Considered
`acsa_xplus_mem_and_state_sq_bound`, `_voucher_step_acsa_searchPoint_sq_distance_affine_bound_30`,
and SOptLib/Model/Iterates affine-output helpers; the two target-file lemmas are
the exact local ingredients, while SOptLib has only process/integrability
transport rather than this deterministic two-radius scalar normalization. -/
private theorem acsa_xplus_expr_state_sq_bound
    (t : {n : ℕ // 1 ≤ n})
    (hq_mem : setup.q t.1 ∈ Set.Icc (0 : ℝ) 1)
    (hgamma_pos : 0 < setup.gamma t.1)
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X) :
    ‖setup.xStar -
        ((setup.mu * setup.gamma t.1 / (1 + setup.mu * setup.gamma t.1)) •
            setup.searchPoint t prev +
          (1 / (1 + setup.mu * setup.gamma t.1)) • prev.x)‖ ^ 2 ≤
      6 * ‖setup.xStar - prev.x‖ ^ 2 +
        4 * ‖setup.xStar - prev.xBar‖ ^ 2 := by
  let xUnder : E := setup.searchPoint t prev
  let xPlus : E :=
    (setup.mu * setup.gamma t.1 / (1 + setup.mu * setup.gamma t.1)) • xUnder +
      (1 / (1 + setup.mu * setup.gamma t.1)) • prev.x
  have hxUnder_mem : xUnder ∈ setup.X := by
    simpa [xUnder] using
      _voucher_step_acsa_searchPoint_mem_29 (setup := setup) t hq_mem prev
  have hxPlus_formula :
      xPlus =
        (setup.mu * setup.gamma t.1 / (1 + setup.mu * setup.gamma t.1)) • xUnder +
          (1 / (1 + setup.mu * setup.gamma t.1)) • prev.x := rfl
  have hxPlus_bound :
      ‖setup.xStar - xPlus‖ ^ 2 ≤
        2 * (‖setup.xStar - prev.x‖ ^ 2 +
          ‖setup.xStar - xUnder‖ ^ 2) :=
    (acsa_xplus_mem_and_state_sq_bound (setup := setup)
      (xPrev := prev.x) (xUnder := xUnder) (xPlus := xPlus)
      (γ := setup.gamma t.1) hgamma_pos prev.hx hxUnder_mem hxPlus_formula).2
  have hsearch_bound :
      ‖setup.xStar - xUnder‖ ^ 2 ≤
        2 * ‖setup.xStar - prev.xBar‖ ^ 2 +
          2 * ‖setup.xStar - prev.x‖ ^ 2 := by
    simpa [xUnder] using
      _voucher_step_acsa_searchPoint_sq_distance_affine_bound_30
        (setup := setup) t hq_mem prev
  have hgoal :
      ‖setup.xStar - xPlus‖ ^ 2 ≤
        6 * ‖setup.xStar - prev.x‖ ^ 2 +
          4 * ‖setup.xStar - prev.xBar‖ ^ 2 := by
    nlinarith
  simpa [xPlus, xUnder] using hgoal

/-- Metric conversion from endpoint state growth to the requested `xPlus`
displacement envelope.

No SOptLib match: searched `triangle endpoint growth to displacement xplus` and
checked `norm_sq_xstar_z_from_xplus_and_displacement`; that lemma has the
opposite endpoint direction, so this private helper proves the required
triangle/Young conversion directly. -/
private theorem acsa_displacement_from_endpoint_and_xplus_state
    {xStar z xPlus η : E} {X Y N A B D C : ℝ}
    (hend :
      ‖xStar - z‖ ^ 2 ≤ A * X + B * Y + D * N + C)
    (hxPlus :
      ‖xStar - xPlus‖ ^ 2 ≤ 6 * X + 4 * Y) :
    ‖z - xPlus‖ ^ 2 ≤
      (2 * A + 12) * X + (2 * B + 8) * Y + (2 * D) * N + 2 * C := by
  have htri : ‖z - xPlus‖ ≤ ‖xStar - z‖ + ‖xStar - xPlus‖ := by
    calc
      ‖z - xPlus‖ = ‖(z - xStar) + (xStar - xPlus)‖ := by
        congr 1
        module
      _ ≤ ‖z - xStar‖ + ‖xStar - xPlus‖ := norm_add_le _ _
      _ = ‖xStar - z‖ + ‖xStar - xPlus‖ := by rw [norm_sub_rev z xStar]
  have hsum_nonneg : 0 ≤ ‖xStar - z‖ + ‖xStar - xPlus‖ := by positivity
  have hsq_mono :
      ‖z - xPlus‖ ^ 2 ≤ (‖xStar - z‖ + ‖xStar - xPlus‖) ^ 2 := by
    have hmul := mul_le_mul htri htri (norm_nonneg _) hsum_nonneg
    simpa [pow_two] using hmul
  have hyoung :
      (‖xStar - z‖ + ‖xStar - xPlus‖) ^ 2 ≤
        2 * ‖xStar - z‖ ^ 2 + 2 * ‖xStar - xPlus‖ ^ 2 := by
    nlinarith [sq_nonneg (‖xStar - z‖ - ‖xStar - xPlus‖)]
  have hmetric :
      ‖z - xPlus‖ ^ 2 ≤
        2 * ‖xStar - z‖ ^ 2 + 2 * ‖xStar - xPlus‖ ^ 2 :=
    hsq_mono.trans hyoung
  nlinarith

/-- Source-literal Proposition 4.2 one-step recurrence at `x = xStar`.

Aligns with Lan Eqs. (4.2.15)-(4.2.19): the local source facts considered were
`hUpperAlpha`, `hlemma35`, and the proved alpha-scaled tail
`_voucher_step_acsa_prop42_alpha_scaled_tail_43`; SOptLib has prox/Bregman
building blocks but no AC-SA two-center recurrence with this paper's `Delta`
term, so this route-local helper specializes the public run-contract proof
without changing any source-facing theorem head. -/
private theorem acsa_prop42_local_recurrence_at_xstar
    (t : {n : ℕ // 1 ≤ n})
    {γ : ℝ}
    {prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X}
    {z xUnder g η xPlus xBar : E} {p : E → ℝ}
    (halpha_nonneg : 0 ≤ setup.alpha t.1)
    (hgamma_pos : 0 < γ)
    (hp_def : p = fun u => γ * (⟪g, u⟫_ℝ + setup.h u))
    (hnoise_decomp : g = setup.gradF xUnder + η)
    (havg_under : xBar - xUnder = setup.alpha t.1 • (z - xPlus))
    (hUpperAlpha :
      setup.Psi xBar ≤
        (1 - setup.alpha t.1) * setup.Psi prev.xBar +
          setup.alpha t.1 *
            (setup.f xUnder + ⟪setup.gradF xUnder, z - xUnder⟫_ℝ + setup.h z) +
          (setup.L / 2) * (setup.alpha t.1 * ‖z - xPlus‖) ^ 2 +
          setup.M * (setup.alpha t.1 * ‖z - xPlus‖))
    (hlemma35 :
      p z + (γ * setup.mu) * setup.V xUnder z +
          (1 : ℝ) * setup.V prev.x z ≤
        p setup.xStar + (γ * setup.mu) * setup.V xUnder setup.xStar +
          (1 : ℝ) * setup.V prev.x setup.xStar -
            ((γ * setup.mu) + (1 : ℝ)) * setup.V z setup.xStar)
    (hsource_alpha_tail :
      setup.L / 2 * (setup.alpha t.1 * ‖z - xPlus‖) ^ 2 +
          setup.M * (setup.alpha t.1 * ‖z - xPlus‖) -
          setup.alpha t.1 *
            ((1 / γ) * setup.V prev.x z + setup.mu * setup.V xUnder z) -
          setup.alpha t.1 * ⟪η, z - xPlus⟫_ℝ ≤
        setup.alpha t.1 * γ * (setup.M + ‖η‖) ^ 2 /
          (2 * (1 + setup.mu * γ - setup.L * setup.alpha t.1 * γ))) :
    setup.Psi xBar ≤
      (1 - setup.alpha t.1) * setup.Psi prev.xBar +
        setup.alpha t.1 *
          (setup.f xUnder +
