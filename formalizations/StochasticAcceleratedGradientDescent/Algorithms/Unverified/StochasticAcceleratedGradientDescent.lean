/-- Refutation certificate for the retired standalone deterministic `qz`
budget.

The old frontier attempted to prove an affine bound on the curvature remainder
before using the denominator-retaining prox displacement inequality.  As a
scalar statement that is false: with zero state and zero affine budget, a
positive `qz` forces `1 ≤ 0`. -/
private theorem _reconstruct_acsa_two_center_prox_growth_deterministic_budget_legacy_refutable :
    ¬ (∀ γ Bgap qz linB linC state : ℝ,
      0 < γ →
      0 ≤ state →
      Bgap = 0 →
      qz = 1 →
      linB = 0 →
      linC = 0 →
      state = 0 →
      γ * (Bgap * (2 * state + 1) + qz) ≤ γ * (linB * state + linC)) := by
  intro hlegacy
