process. It is deliberately not stored as component measurability on the setup:
the book states `f(x)=E[F(x,ξ)]` and `h` simple convex, not global measurability
of the ambient extensions. -/
theorem generatedCompositeObjective_aestronglyMeasurable
    (execution : SourceGeneratedAcsExecution (E := E) (S := S) setup)
    (k : ℕ)
    (hPsi : Measurable setup.PsiCarrier) :
    AEStronglyMeasurable
      (fun ω => setup.Psi (realization.generatedOutput execution k ω))
      realization.P := by
  exact SOptLib.carrierObjective_comp_aestronglyMeasurable
    (μ := realization.P)
    (X := setup.X)
    (objective := setup.Psi)
    (carrierObjective := setup.PsiCarrier)
    (output := realization.generatedOutput execution k)
    (setup.PsiCarrier_measurable hPsi)
    (realization.generatedOutput_measurable execution k)
    (realization.generatedOutput_mem execution k)
    (by
      intro x hx
      rfl)

