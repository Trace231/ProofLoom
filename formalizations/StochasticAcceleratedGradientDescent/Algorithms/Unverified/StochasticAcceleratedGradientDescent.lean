          setup.alpha t.1 *
            (setup.f xUnder + ⟪setup.gradF xUnder, z - xUnder⟫_ℝ + setup.h z) +
          (setup.L / 2) * (setup.alpha t.1 * ‖z - xPlus‖) ^ 2 +
