/-- Live Lan Proposition 4.2 endpoint boundary for the two-center prox bridge.

This is the source-facing replacement for the retired deterministic Euclidean
budget leaf.  Lan Proposition 4.2 keeps the objective boundary and the Bregman
term `V(prev.x, x*)` for the Proposition 4.3 telescope; it does not prove a
standalone pointwise estimate of
`γ * (⟪gradF xUnder, xPlus - z⟫ + h xPlus - h z)` by a Euclidean state budget. -/
private theorem acsa_prop42_source_budget_live
    (t : {n : ℕ // 1 ≤ n})
    {γ : ℝ}
    {prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X}
    {z xUnder g η xPlus xBar : E} {p : E → ℝ}
    (halpha_nonneg : 0 ≤ setup.alpha t.1)
    (halpha_pos : 0 < setup.alpha t.1)
    (hgamma_pos : 0 < γ)
    (hxBar_mem : xBar ∈ setup.X)
    (hxUnder_mem : xUnder ∈ setup.X)
    (hz_mem : z ∈ setup.X)
    (hp_def : p = fun u => γ * (⟪g, u⟫_ℝ + setup.h u))
    (hnoise_decomp : g = setup.gradF xUnder + η)
    (havg_under : xBar - xUnder = setup.alpha t.1 • (z - xPlus))
    (hUpperAlpha :
      setup.Psi xBar ≤
        (1 - setup.alpha t.1) * setup.Psi prev.xBar +
          setup.alpha t.1 *
            (setup.f xUnder + ⟪setup.gradF xUnder, z - xUnder⟫_ℝ + setup.h z) +
          (setup.L / 2) * (setup.alpha t.1 * ‖z - xPlus‖) ^ 2 +
          setup.M * (setup.alpha t.1 * ‖z - xPlus‖))
    (hlemma35 :
      p z + (γ * setup.mu) * setup.V xUnder z +
          (1 : ℝ) * setup.V prev.x z ≤
        p setup.xStar + (γ * setup.mu) * setup.V xUnder setup.xStar +
          (1 : ℝ) * setup.V prev.x setup.xStar -
            ((γ * setup.mu) + (1 : ℝ)) * setup.V z setup.xStar)
    (hweighted_absorb :
      ((1 + setup.mu * γ) / (2 * γ)) * ‖z - xPlus‖ ^ 2 ≤
        (1 / γ) * setup.V prev.x z +
          setup.mu * setup.V xUnder z)
    (hDeltaSquare_local :
      setup.alpha t.1 *
          (setup.M * ‖z - xPlus‖ - ⟪η, z - xPlus⟫_ℝ -
            (1 + setup.mu * γ - setup.L * setup.alpha t.1 * γ) /
              (2 * γ) * ‖z - xPlus‖ ^ 2) ≤
        setup.alpha t.1 * γ *
          (setup.M + SOptLib.dualNorm η) ^ 2 /
            (2 * (1 + setup.mu * γ - setup.L * setup.alpha t.1 * γ))) :
    setup.alpha t.1 / (2 * γ) * ‖z - setup.xStar‖ ^ 2 ≤
      (1 - setup.alpha t.1) *
          (setup.Psi prev.xBar - setup.Psi setup.xStar) +
        setup.alpha t.1 / γ * setup.V prev.x setup.xStar +
        setup.alpha t.1 * γ * (setup.M + ‖η‖) ^ 2 /
          (2 * (1 + setup.mu * γ - setup.L * setup.alpha t.1 * γ)) +
        setup.alpha t.1 * ⟪η, setup.xStar - xPlus⟫_ℝ := by
  exact
    sq_norm_endpoint_le_of_two_center_prox_context
      setup.Psi setup.f setup.h setup.V setup.gradF
      (setup.alpha t.1) γ setup.mu setup.L setup.M
      prev.xBar prev.x xUnder z setup.xStar xPlus xBar g η
      halpha_nonneg halpha_pos hgamma_pos setup.hmu_nonneg hnoise_decomp
      hUpperAlpha
      (by simpa [hp_def] using hlemma35)
      hweighted_absorb
      (by simpa [SOptLib.dualNorm_eq_norm] using hDeltaSquare_local)
      (by
        simpa [StochasticAcceleratedGradientDescentSetup.Psi,
          SOptLib.compositeObjective] using
