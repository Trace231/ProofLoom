                    (SOptLib.natSuccPositiveTime (t - 1)) ω)
                  (realization.xi ((t - 1) + 1) ω)‖) ^ 2 /
                (2 * (1 + setup.mu * setup.gamma ((t - 1) + 1) -
                  setup.L * setup.alpha ((t - 1) + 1) *
                    setup.gamma ((t - 1) + 1))) +
            setup.alpha ((t - 1) + 1) *
              ⟪setup.oracleNoise
                  (realization.generatedXUnder execution
                    (SOptLib.natSuccPositiveTime (t - 1)) ω)
                  (realization.xi ((t - 1) + 1) ω),
