  · have hk0 : k = 0 := by omega
    have hconst :
        realization.generatedExpectedGapIntegrand execution k =
          fun _ : Ω => setup.Psi setup.wbar0 - setup.PsiStar := by
      funext ω
      subst k
      simp [StochasticAcceleratedGradientDescentRealization.generatedExpectedGapIntegrand,
