/-! Used in: `_voucher_two_bregman_argmin_variational_inequality_no_center_mem`
(right derivative of the literal AC-SA Bregman term). -/
private theorem _voucher_acsa_bregman_segment_difference_hasDerivWithinAt_zero
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    {x xp u : E} (hxp : xp ∈ setup.X) :
    let d : E := u - xp
    let β : ℝ → ℝ := fun t =>
      if ht : t ∈ Set.Icc (0 : ℝ) 1 then
        setup.V x (AffineMap.lineMap xp u t) - setup.V x xp
      else 0
    HasDerivWithinAt β
      ⟪setup.gradNu xp - setup.gradNu x, d⟫_ℝ
      (Set.Icc (0 : ℝ) 1) 0 := by
  simpa [StochasticAcceleratedGradientDescentSetup.V] using
    (bregman_segment_difference_hasDerivWithinAt_zero
      (v := setup.nu) (grad := setup.gradNu) (x := x) (xp := xp) (u := u)
      (setup.nu_hasGradientAt xp hxp))

/-! Used in: `_voucher_lemma_3_5_no_center_mem`
(Lan Lemma 3.5 nonsmooth argmin first-order bridge).  The later source-facing
`lemma_3_5` and SOptLib candidates were considered; the scalar voucher lacks
an explicit `xUnder ∈ X` hypothesis, while the derivative proof only uses
feasibility of the minimizer/comparison segment, so this private route-local
variant keeps the same Eq. (3.2.2) algebra without center-membership premises. -/
private theorem _voucher_two_bregman_argmin_variational_inequality_no_center_mem
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (p : E → ℝ)
    (hp_convex : ConvexOn ℝ setup.X p)
    {xTilde yTilde uHat : E} {mu1 mu2 : ℝ}
    (huHat : uHat ∈ setup.X)
    (hmu1 : 0 ≤ mu1)
    (hmu2 : 0 ≤ mu2)
    (h_opt :
      ∀ u, u ∈ setup.X →
        p uHat + mu1 * setup.V xTilde uHat + mu2 * setup.V yTilde uHat ≤
          p u + mu1 * setup.V xTilde u + mu2 * setup.V yTilde u) :
    ∀ u, u ∈ setup.X →
      0 ≤ p u - p uHat +
        mu1 * ⟪setup.gradNu uHat - setup.gradNu xTilde, u - uHat⟫_ℝ +
        mu2 * ⟪setup.gradNu uHat - setup.gradNu yTilde, u - uHat⟫_ℝ := by
  exact
    SOptLib.two_bregman_argmin_variational_inequality_no_center_mem
      setup.X p setup.V setup.gradNu hp_convex huHat
      (by
        intro a z u hz
        simpa using
          (_voucher_acsa_bregman_segment_difference_hasDerivWithinAt_zero
            (setup := setup) (x := a) (xp := z) (u := u) hz))
      h_opt

/-! Deterministic Lan Lemma 3.5 bridge for the AC-SA prox objective. -/
private theorem _voucher_lemma_3_5_no_center_mem
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    (p : E → ℝ)
    (hp_convex : ConvexOn ℝ setup.X p)
    {xTilde yTilde uHat : E} {mu1 mu2 : ℝ}
    (huHat : uHat ∈ setup.X)
    (hmu1 : 0 ≤ mu1)
    (hmu2 : 0 ≤ mu2)
    (h_opt :
      ∀ u, u ∈ setup.X →
        p uHat + mu1 * setup.V xTilde uHat + mu2 * setup.V yTilde uHat ≤
          p u + mu1 * setup.V xTilde u + mu2 * setup.V yTilde u) :
    ∀ u, u ∈ setup.X →
      p uHat + mu1 * setup.V xTilde uHat + mu2 * setup.V yTilde uHat ≤
        p u + mu1 * setup.V xTilde u + mu2 * setup.V yTilde u -
          (mu1 + mu2) * setup.V uHat u := by
  intro u hu
  have hvar :=
    _voucher_two_bregman_argmin_variational_inequality_no_center_mem
      setup p hp_convex huHat hmu1 hmu2 h_opt u hu
  have h3x := _voucher_acsa_bregman_three_point_identity setup xTilde uHat u
  have h3y := _voucher_acsa_bregman_three_point_identity setup yTilde uHat u
  nlinarith

/-! Deterministic Lan Eqs. (4.2.17)-(4.2.18) weighted Bregman bridge.
Aligns with the source weighted Bregman coercivity step.  The pre-searched
probability/oracle/telescope candidates (`integral_selected_finite_index_prod_eq_sum_weights`,
`weighted_variance_sum_expectation_bound`,
`selected_block_estimator_minus_weighted_sum_integral_eq_zero`,
`convexOn_weighted_average_le_weighted_sum`,
`weighted_average_sub_baseline_le_weighted_gap`) were checked and rejected
because they address expectation/Jensen telescoping rather than the deterministic
two-center Bregman lower bound.  The SOptLib Bregman candidates provide the
single-term lower bound; the AC-SA-specific work here is the Eq. (4.2.14)
weighted-center algebra. -/
private theorem acsa_weighted_bregman_absorbs_xplus_sq_deterministic
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    {xPrev xUnder xNext xPlus : E} {γ : ℝ}
    (hgamma_pos : 0 < γ)
    (hxPrev : xPrev ∈ setup.X)
    (hxUnder : xUnder ∈ setup.X)
    (hxNext : xNext ∈ setup.X)
    (hxplus :
      xPlus =
        (setup.mu * γ / (1 + setup.mu * γ)) • xUnder +
          (1 / (1 + setup.mu * γ)) • xPrev) :
    ((1 + setup.mu * γ) / (2 * γ)) *
        ‖xNext - xPlus‖ ^ 2 ≤
      (1 / γ) * setup.V xPrev xNext +
        setup.mu * setup.V xUnder xNext := by
  exact
    two_center_bregman_absorbs_weighted_center_sq (V := setup.V)
      (mu := setup.mu) (gamma := γ) (xPrev := xPrev) (xUnder := xUnder)
      (xNext := xNext) (xPlus := xPlus) setup.hmu_nonneg hgamma_pos hxplus
      (setup.V_lower xPrev hxPrev xNext hxNext)
      (setup.V_lower xUnder hxUnder xNext hxNext)

/-! Eq. (4.2.14) xPlus feasibility and Euclidean state control.
Aligns with Lan Eq. (4.2.14): the candidate
`acsa_weighted_bregman_absorbs_xplus_sq_deterministic` was considered and kept
for the later displacement absorption step, while this helper isolates the
separate convex-combination membership and triangle/Young distance bookkeeping
needed before invoking prox minimality. -/
private theorem acsa_xplus_mem_and_state_sq_bound
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    {xPrev xUnder xPlus : E} {γ : ℝ}
    (hgamma_pos : 0 < γ)
    (hxPrev : xPrev ∈ setup.X)
    (hxUnder : xUnder ∈ setup.X)
    (hxplus :
      xPlus =
        (setup.mu * γ / (1 + setup.mu * γ)) • xUnder +
          (1 / (1 + setup.mu * γ)) • xPrev) :
    xPlus ∈ setup.X ∧
      ‖setup.xStar - xPlus‖ ^ 2 ≤
        2 * (‖setup.xStar - xPrev‖ ^ 2 + ‖setup.xStar - xUnder‖ ^ 2) := by
  exact
    weighted_center_mem_and_sq_distance_bound (X := setup.X)
      (xStar := setup.xStar) (xPrev := xPrev) (xUnder := xUnder)
      (xPlus := xPlus) (mu := setup.mu) (gamma := γ)
      setup.hX_convex setup.hmu_nonneg hgamma_pos hxPrev hxUnder hxplus

/-! Curvature-model removal of the weighted Bregman residual at Eq. (4.2.14).
Aligns with Lan Eq. (4.2.2) as used near Eqs. (4.2.17)-(4.2.18).  Considered
`acsa_weighted_bregman_absorbs_xplus_sq_deterministic`,
`sq_norm_le_bregman_add_swap_of_half_lower_bound`, and the pre-searched
probability/oracle/telescope candidates; the first is the lower coercivity
step, the second goes in the wrong direction for residual removal, and the
probability/telescope facts do not apply to this deterministic xPlus residual. -/
private theorem acsa_weighted_bregman_xplus_residual_bound
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    {xPrev xUnder xPlus : E} {γ : ℝ}
    (hgamma_pos : 0 < γ)
    (hxPrev : xPrev ∈ setup.X)
    (hxUnder : xUnder ∈ setup.X)
    (hxPlus : xPlus ∈ setup.X)
    (hxplus :
      xPlus =
        (setup.mu * γ / (1 + setup.mu * γ)) • xUnder +
          (1 / (1 + setup.mu * γ)) • xPrev)
    (hxStar_xPlus_sq_bound :
      ‖setup.xStar - xPlus‖ ^ 2 ≤
        2 * (‖setup.xStar - xPrev‖ ^ 2 + ‖setup.xStar - xUnder‖ ^ 2)) :
    ∃ A C : ℝ,
      0 ≤ A ∧ 0 ≤ C ∧
        setup.V xPrev xPlus + γ * setup.mu * setup.V xUnder xPlus ≤
          A * (‖setup.xStar - xPrev‖ ^ 2 +
            ‖setup.xStar - xUnder‖ ^ 2) + C := by
  have hgamma_nonneg : 0 ≤ γ := le_of_lt hgamma_pos
  let state : ℝ :=
    ‖setup.xStar - xPrev‖ ^ 2 + ‖setup.xStar - xUnder‖ ^ 2
  have hstate_nonneg : 0 ≤ state := by
    dsimp [state]
    positivity
  have hxPlus_endpoint_sq :
      ∀ y : E, ‖setup.xStar - y‖ ^ 2 ≤ state →
        ‖xPlus - y‖ ^ 2 ≤ 6 * state := by
    intro y hy
    have htri : ‖xPlus - y‖ ≤ ‖xPlus - setup.xStar‖ + ‖setup.xStar - y‖ := by
      calc
        ‖xPlus - y‖ =
            ‖(xPlus - setup.xStar) + (setup.xStar - y)‖ := by
              congr 1
              module
        _ ≤ ‖xPlus - setup.xStar‖ + ‖setup.xStar - y‖ := norm_add_le _ _
    have hsum_nonneg : 0 ≤ ‖xPlus - setup.xStar‖ + ‖setup.xStar - y‖ := by
      positivity
    have hsq_mono :
        ‖xPlus - y‖ ^ 2 ≤
          (‖xPlus - setup.xStar‖ + ‖setup.xStar - y‖) ^ 2 := by
      have hmul := mul_le_mul htri htri (norm_nonneg _) hsum_nonneg
      simpa [pow_two] using hmul
    have hxPlus_rev :
        ‖xPlus - setup.xStar‖ ^ 2 ≤ 2 * state := by
      simpa [state, norm_sub_rev] using hxStar_xPlus_sq_bound
    have hyoung :
        (‖xPlus - setup.xStar‖ + ‖setup.xStar - y‖) ^ 2 ≤
          2 * (‖xPlus - setup.xStar‖ ^ 2 + ‖setup.xStar - y‖ ^ 2) := by
      nlinarith [sq_nonneg (‖xPlus - setup.xStar‖ - ‖setup.xStar - y‖)]
    have hcombo :
        2 * (‖xPlus - setup.xStar‖ ^ 2 + ‖setup.xStar - y‖ ^ 2) ≤
          6 * state := by
      nlinarith
    exact hsq_mono.trans (hyoung.trans hcombo)
  have hprev_state : ‖setup.xStar - xPrev‖ ^ 2 ≤ state := by
    dsimp [state]
    nlinarith [sq_nonneg (‖setup.xStar - xUnder‖)]
  have hunder_state : ‖setup.xStar - xUnder‖ ^ 2 ≤ state := by
    dsimp [state]
    nlinarith [sq_nonneg (‖setup.xStar - xPrev‖)]
  have hprev_dist_sq : ‖xPlus - xPrev‖ ^ 2 ≤ 6 * state :=
    hxPlus_endpoint_sq xPrev hprev_state
  have hunder_dist_sq : ‖xPlus - xUnder‖ ^ 2 ≤ 6 * state :=
    hxPlus_endpoint_sq xUnder hunder_state
  have hquad_bound :
      ∀ d : ℝ, 0 ≤ d → d ^ 2 ≤ 6 * state →
        (setup.L / 2) * d ^ 2 + setup.M * d ≤
          (3 * setup.L + 6 * setup.M) * state + setup.M := by
    intro d hd_nonneg hd_sq
    have hlin : d ≤ d ^ 2 + 1 := by
      nlinarith [sq_nonneg (d - (1 / 2 : ℝ))]
    have hMlin :
        setup.M * d ≤ setup.M * (d ^ 2 + 1) :=
      mul_le_mul_of_nonneg_left hlin setup.hM_nonneg
    have hMsq :
        setup.M * d ^ 2 ≤ setup.M * (6 * state) :=
      mul_le_mul_of_nonneg_left hd_sq setup.hM_nonneg
    have hLsq :
        (setup.L / 2) * d ^ 2 ≤ (setup.L / 2) * (6 * state) :=
      mul_le_mul_of_nonneg_left hd_sq (by nlinarith [setup.hL_nonneg])
    nlinarith
  by_cases hmu_zero : setup.mu = 0
  · refine ⟨0, 0, by norm_num, by norm_num, ?_⟩
    have hxplus_prev : xPlus = xPrev := by
      rw [hxplus, hmu_zero]
      simp
    have hVself : setup.V xPrev xPrev = 0 := by
      simp [StochasticAcceleratedGradientDescentSetup.V, carrierBregmanFormula]
    rw [hxplus_prev, hmu_zero, hVself]
    simp
  · have hmu_pos : 0 < setup.mu := lt_of_le_of_ne setup.hmu_nonneg (Ne.symm hmu_zero)
    let B : ℝ := (3 * setup.L + 6 * setup.M)
    let A : ℝ := (1 / setup.mu + γ) * B + 1
    let C : ℝ := (1 / setup.mu + γ) * setup.M + 1
    refine ⟨A, C, ?_, ?_, ?_⟩
    · have hfactor : 0 ≤ 1 / setup.mu + γ := by positivity
      have hB : 0 ≤ B := by
        dsimp [B]
        nlinarith [setup.hL_nonneg, setup.hM_nonneg]
      dsimp [A]
      nlinarith [mul_nonneg hfactor hB]
    · have hfactor : 0 ≤ 1 / setup.mu + γ := by positivity
      dsimp [C]
      nlinarith [mul_nonneg hfactor setup.hM_nonneg]
    · let qPrev : ℝ := (setup.L / 2) * ‖xPlus - xPrev‖ ^ 2 +
        setup.M * ‖xPlus - xPrev‖
      let qUnder : ℝ := (setup.L / 2) * ‖xPlus - xUnder‖ ^ 2 +
        setup.M * ‖xPlus - xUnder‖
      have hcurvPrev_mu :
          setup.mu * setup.V xPrev xPlus ≤ qPrev := by
        have hcurv := setup.hcurvature_model xPrev hxPrev xPlus hxPlus
        have h := hcurv.1.trans hcurv.2
        simpa [qPrev, StochasticAcceleratedGradientDescentSetup.V, norm_sub_rev] using h
      have hVprev_le : setup.V xPrev xPlus ≤ (1 / setup.mu) * qPrev := by
        have hmul := mul_le_mul_of_nonneg_left hcurvPrev_mu (by positivity : 0 ≤ 1 / setup.mu)
        convert hmul using 1 <;> field_simp [ne_of_gt hmu_pos] <;> ring
      have hcurvUnder_mu :
          setup.mu * setup.V xUnder xPlus ≤ qUnder := by
        have hcurv := setup.hcurvature_model xUnder hxUnder xPlus hxPlus
        have h := hcurv.1.trans hcurv.2
        simpa [qUnder, StochasticAcceleratedGradientDescentSetup.V, norm_sub_rev] using h
      have hVunder_scaled :
          γ * setup.mu * setup.V xUnder xPlus ≤ γ * qUnder := by
        have hmul := mul_le_mul_of_nonneg_left hcurvUnder_mu hgamma_nonneg
        nlinarith
      have hqPrev_bound : qPrev ≤ B * state + setup.M := by
        dsimp [qPrev, B]
        exact hquad_bound ‖xPlus - xPrev‖ (norm_nonneg _) hprev_dist_sq
      have hqUnder_bound : qUnder ≤ B * state + setup.M := by
        dsimp [qUnder, B]
        exact hquad_bound ‖xPlus - xUnder‖ (norm_nonneg _) hunder_dist_sq
      have hprev_scaled :
          (1 / setup.mu) * qPrev ≤ (1 / setup.mu) * (B * state + setup.M) :=
        mul_le_mul_of_nonneg_left hqPrev_bound (by positivity)
      have hunder_scaled :
          γ * qUnder ≤ γ * (B * state + setup.M) :=
        mul_le_mul_of_nonneg_left hqUnder_bound hgamma_nonneg
      have hres_le :
          setup.V xPrev xPlus + γ * setup.mu * setup.V xUnder xPlus ≤
            (1 / setup.mu) * qPrev + γ * qUnder := by
        exact add_le_add hVprev_le hVunder_scaled
      have hbudget :
          (1 / setup.mu) * qPrev + γ * qUnder ≤
            (1 / setup.mu + γ) * (B * state + setup.M) := by
        nlinarith [hprev_scaled, hunder_scaled]
      calc
        setup.V xPrev xPlus + γ * setup.mu * setup.V xUnder xPlus
            ≤ (1 / setup.mu) * qPrev + γ * qUnder := hres_le
        _ ≤ (1 / setup.mu + γ) * (B * state + setup.M) := hbudget
        _ ≤ A * state + C := by
          dsimp [A, C]
          nlinarith [hstate_nonneg]

/-! Uniform curvature-model removal of the weighted Bregman residual at
Eq. (4.2.14).

Aligns with Lan Eq. (4.2.2) as used near Eqs. (4.2.17)-(4.2.18), but chooses
the constants before the AC-SA state/sample are introduced.  Considered the
proved pointwise helper `acsa_weighted_bregman_xplus_residual_bound`,
`acsa_weighted_bregman_absorbs_xplus_sq_deterministic`,
`sq_norm_le_bregman_add_swap_of_half_lower_bound`, and the pre-searched
probability/oracle/telescope candidates; only the pointwise helper's
curvature-model proof has the right paper residual, while the others are lower
coercivity, wrong-direction symmetric Bregman control, or unrelated stochastic
aggregation facts. -/
private theorem acsa_weighted_bregman_xplus_residual_bound_uniform
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    {γ : ℝ}
    (hgamma_pos : 0 < γ) :
    ∃ A C : ℝ,
      0 ≤ A ∧ 0 ≤ C ∧
        ∀ {xPrev xUnder xPlus : E},
          xPrev ∈ setup.X →
          xUnder ∈ setup.X →
          xPlus ∈ setup.X →
          xPlus =
            (setup.mu * γ / (1 + setup.mu * γ)) • xUnder +
              (1 / (1 + setup.mu * γ)) • xPrev →
          ‖setup.xStar - xPlus‖ ^ 2 ≤
            2 * (‖setup.xStar - xPrev‖ ^ 2 +
              ‖setup.xStar - xUnder‖ ^ 2) →
          setup.V xPrev xPlus + γ * setup.mu * setup.V xUnder xPlus ≤
            A * (‖setup.xStar - xPrev‖ ^ 2 +
              ‖setup.xStar - xUnder‖ ^ 2) + C := by
  have hgamma_nonneg : 0 ≤ γ := le_of_lt hgamma_pos
  by_cases hmu_zero : setup.mu = 0
  · refine ⟨0, 0, by norm_num, by norm_num, ?_⟩
    intro xPrev xUnder xPlus hxPrev hxUnder hxPlus hxplus hxStar_xPlus_sq_bound
    have hxplus_prev : xPlus = xPrev := by
      rw [hxplus, hmu_zero]
      simp
    have hVself : setup.V xPrev xPrev = 0 := by
      simp [StochasticAcceleratedGradientDescentSetup.V, carrierBregmanFormula]
    rw [hxplus_prev, hmu_zero, hVself]
    simp
  · have hmu_pos : 0 < setup.mu := lt_of_le_of_ne setup.hmu_nonneg (Ne.symm hmu_zero)
    let B : ℝ := (3 * setup.L + 6 * setup.M)
    let A : ℝ := (1 / setup.mu + γ) * B + 1
    let C : ℝ := (1 / setup.mu + γ) * setup.M + 1
    refine ⟨A, C, ?_, ?_, ?_⟩
    · have hfactor : 0 ≤ 1 / setup.mu + γ := by positivity
      have hB : 0 ≤ B := by
        dsimp [B]
        nlinarith [setup.hL_nonneg, setup.hM_nonneg]
      dsimp [A]
      nlinarith [mul_nonneg hfactor hB]
    · have hfactor : 0 ≤ 1 / setup.mu + γ := by positivity
      dsimp [C]
      nlinarith [mul_nonneg hfactor setup.hM_nonneg]
    · intro xPrev xUnder xPlus hxPrev hxUnder hxPlus hxplus hxStar_xPlus_sq_bound
      let state : ℝ :=
        ‖setup.xStar - xPrev‖ ^ 2 + ‖setup.xStar - xUnder‖ ^ 2
      have hstate_nonneg : 0 ≤ state := by
        dsimp [state]
        positivity
      have hxPlus_endpoint_sq :
          ∀ y : E, ‖setup.xStar - y‖ ^ 2 ≤ state →
            ‖xPlus - y‖ ^ 2 ≤ 6 * state := by
        intro y hy
        have htri : ‖xPlus - y‖ ≤ ‖xPlus - setup.xStar‖ + ‖setup.xStar - y‖ := by
          calc
            ‖xPlus - y‖ =
                ‖(xPlus - setup.xStar) + (setup.xStar - y)‖ := by
                  congr 1
                  module
            _ ≤ ‖xPlus - setup.xStar‖ + ‖setup.xStar - y‖ := norm_add_le _ _
        have hsum_nonneg : 0 ≤ ‖xPlus - setup.xStar‖ + ‖setup.xStar - y‖ := by
          positivity
        have hsq_mono :
            ‖xPlus - y‖ ^ 2 ≤
              (‖xPlus - setup.xStar‖ + ‖setup.xStar - y‖) ^ 2 := by
          have hmul := mul_le_mul htri htri (norm_nonneg _) hsum_nonneg
          simpa [pow_two] using hmul
        have hxPlus_rev :
            ‖xPlus - setup.xStar‖ ^ 2 ≤ 2 * state := by
          simpa [state, norm_sub_rev] using hxStar_xPlus_sq_bound
        have hyoung :
            (‖xPlus - setup.xStar‖ + ‖setup.xStar - y‖) ^ 2 ≤
              2 * (‖xPlus - setup.xStar‖ ^ 2 + ‖setup.xStar - y‖ ^ 2) := by
          nlinarith [sq_nonneg (‖xPlus - setup.xStar‖ - ‖setup.xStar - y‖)]
        have hcombo :
            2 * (‖xPlus - setup.xStar‖ ^ 2 + ‖setup.xStar - y‖ ^ 2) ≤
              6 * state := by
          nlinarith
        exact hsq_mono.trans (hyoung.trans hcombo)
      have hprev_state : ‖setup.xStar - xPrev‖ ^ 2 ≤ state := by
        dsimp [state]
        nlinarith [sq_nonneg (‖setup.xStar - xUnder‖)]
      have hunder_state : ‖setup.xStar - xUnder‖ ^ 2 ≤ state := by
        dsimp [state]
        nlinarith [sq_nonneg (‖setup.xStar - xPrev‖)]
      have hprev_dist_sq : ‖xPlus - xPrev‖ ^ 2 ≤ 6 * state :=
        hxPlus_endpoint_sq xPrev hprev_state
      have hunder_dist_sq : ‖xPlus - xUnder‖ ^ 2 ≤ 6 * state :=
        hxPlus_endpoint_sq xUnder hunder_state
      have hquad_bound :
          ∀ d : ℝ, 0 ≤ d → d ^ 2 ≤ 6 * state →
            (setup.L / 2) * d ^ 2 + setup.M * d ≤
              B * state + setup.M := by
        intro d hd_nonneg hd_sq
        have hlin : d ≤ d ^ 2 + 1 := by
          nlinarith [sq_nonneg (d - (1 / 2 : ℝ))]
        have hMlin :
            setup.M * d ≤ setup.M * (d ^ 2 + 1) :=
          mul_le_mul_of_nonneg_left hlin setup.hM_nonneg
        have hMsq :
            setup.M * d ^ 2 ≤ setup.M * (6 * state) :=
          mul_le_mul_of_nonneg_left hd_sq setup.hM_nonneg
        have hLsq :
            (setup.L / 2) * d ^ 2 ≤ (setup.L / 2) * (6 * state) :=
          mul_le_mul_of_nonneg_left hd_sq (by nlinarith [setup.hL_nonneg])
        dsimp [B]
        nlinarith
      let qPrev : ℝ := (setup.L / 2) * ‖xPlus - xPrev‖ ^ 2 +
        setup.M * ‖xPlus - xPrev‖
      let qUnder : ℝ := (setup.L / 2) * ‖xPlus - xUnder‖ ^ 2 +
        setup.M * ‖xPlus - xUnder‖
      have hcurvPrev_mu :
          setup.mu * setup.V xPrev xPlus ≤ qPrev := by
        have hcurv := setup.hcurvature_model xPrev hxPrev xPlus hxPlus
        have h := hcurv.1.trans hcurv.2
        simpa [qPrev, StochasticAcceleratedGradientDescentSetup.V, norm_sub_rev] using h
      have hVprev_le : setup.V xPrev xPlus ≤ (1 / setup.mu) * qPrev := by
        have hmul := mul_le_mul_of_nonneg_left hcurvPrev_mu (by positivity : 0 ≤ 1 / setup.mu)
        convert hmul using 1 <;> field_simp [ne_of_gt hmu_pos] <;> ring
      have hcurvUnder_mu :
          setup.mu * setup.V xUnder xPlus ≤ qUnder := by
        have hcurv := setup.hcurvature_model xUnder hxUnder xPlus hxPlus
        have h := hcurv.1.trans hcurv.2
        simpa [qUnder, StochasticAcceleratedGradientDescentSetup.V, norm_sub_rev] using h
      have hVunder_scaled :
          γ * setup.mu * setup.V xUnder xPlus ≤ γ * qUnder := by
        have hmul := mul_le_mul_of_nonneg_left hcurvUnder_mu hgamma_nonneg
        nlinarith
      have hqPrev_bound : qPrev ≤ B * state + setup.M := by
        dsimp [qPrev]
        exact hquad_bound ‖xPlus - xPrev‖ (norm_nonneg _) hprev_dist_sq
      have hqUnder_bound : qUnder ≤ B * state + setup.M := by
        dsimp [qUnder]
        exact hquad_bound ‖xPlus - xUnder‖ (norm_nonneg _) hunder_dist_sq
      have hprev_scaled :
          (1 / setup.mu) * qPrev ≤ (1 / setup.mu) * (B * state + setup.M) :=
        mul_le_mul_of_nonneg_left hqPrev_bound (by positivity)
      have hunder_scaled :
          γ * qUnder ≤ γ * (B * state + setup.M) :=
        mul_le_mul_of_nonneg_left hqUnder_bound hgamma_nonneg
      have hres_le :
          setup.V xPrev xPlus + γ * setup.mu * setup.V xUnder xPlus ≤
            (1 / setup.mu) * qPrev + γ * qUnder := by
        exact add_le_add hVprev_le hVunder_scaled
      have hbudget :
          (1 / setup.mu) * qPrev + γ * qUnder ≤
            (1 / setup.mu + γ) * (B * state + setup.M) := by
        nlinarith [hprev_scaled, hunder_scaled]
      calc
        setup.V xPrev xPlus + γ * setup.mu * setup.V xUnder xPlus
            ≤ (1 / setup.mu) * qPrev + γ * qUnder := hres_le
        _ ≤ (1 / setup.mu + γ) * (B * state + setup.M) := hbudget
        _ ≤ A * state + C := by
          dsimp [A, C]
          nlinarith [hstate_nonneg]

/-- Final metric conversion for the AC-SA prox regularity route.

No exact SOptLib match: searched `triangle norm square xStar z xPlus` and
`norm squared add triangle`; the hits were generic `norm_add_le`/`norm_add_sq`
APIs and Bregman/integrability facts, while this route needs the literal
two-center endpoint conversion from an `xPlus` state bound and a displacement
bound. -/
private theorem norm_sq_xstar_z_from_xplus_and_displacement
    {xStar z xPlus : E} {S T : ℝ}
    (hxPlus : ‖xStar - xPlus‖ ^ 2 ≤ S)
    (hdisp : ‖z - xPlus‖ ^ 2 ≤ T) :
    ‖xStar - z‖ ^ 2 ≤ 2 * S + 2 * T := by
  have htri : ‖xStar - z‖ ≤ ‖xStar - xPlus‖ + ‖z - xPlus‖ := by
    calc
      ‖xStar - z‖ = ‖(xStar - xPlus) + (xPlus - z)‖ := by
        congr 1
        module
      _ ≤ ‖xStar - xPlus‖ + ‖xPlus - z‖ := norm_add_le _ _
      _ = ‖xStar - xPlus‖ + ‖z - xPlus‖ := by rw [norm_sub_rev xPlus z]
  have hsum_nonneg : 0 ≤ ‖xStar - xPlus‖ + ‖z - xPlus‖ := by positivity
  have hsq_mono :
      ‖xStar - z‖ ^ 2 ≤ (‖xStar - xPlus‖ + ‖z - xPlus‖) ^ 2 := by
    have hmul := mul_le_mul htri htri (norm_nonneg _) hsum_nonneg
    simpa [pow_two] using hmul
  have hyoung :
      (‖xStar - xPlus‖ + ‖z - xPlus‖) ^ 2 ≤
        2 * (‖xStar - xPlus‖ ^ 2 + ‖z - xPlus‖ ^ 2) := by
    nlinarith [sq_nonneg (‖xStar - xPlus‖ - ‖z - xPlus‖)]
  exact hsq_mono.trans (by nlinarith)

/-- Composite objective growth from the selected optimizer to a feasible point.

This is the source-aligned part of the deterministic AC-SA absorption route:
curvature from `x*`, the carrier subgradient model, optimizer minimality, and
the supplied Lipschitz control of `h` bound the paper composite gap by a
quadratic state radius.  Considered the pre-searched Lipschitz/subgradient
candidates `lipschitzWith_of_norm_sub_le_mul`,
`abs_sub_le_of_subgradient_norm_bound`, and
`lipschitzOn_of_forall_subgradient_norm_le`; those require a uniform
subgradient-norm hypothesis, while this proof uses only the local curvature
model at `x*` plus the given `h` Lipschitz estimate. -/
private theorem acsa_composite_gap_upper_from_xStar
    (K : ℝ)
    (hK_nonneg : 0 ≤ K)
    (hh_lip_on_X :
      ∀ x, x ∈ setup.X → ∀ y, y ∈ setup.X →
        |setup.h x - setup.h y| ≤ K * ‖x - y‖)
    {y : E} (hy : y ∈ setup.X) :
    setup.Psi y - setup.Psi setup.xStar ≤
      (‖setup.gradF setup.xStar‖ + setup.L + setup.M + K + 1) *
        (‖setup.xStar - y‖ ^ 2 + 1) := by
  classical
  let d : ℝ := ‖setup.xStar - y‖
  let B : ℝ := ‖setup.gradF setup.xStar‖ + setup.L + setup.M + K + 1
  have hd_nonneg : 0 ≤ d := norm_nonneg _
  have hD_nonneg : 0 ≤ d ^ 2 + 1 := by nlinarith [sq_nonneg d]
  have hB_nonneg : 0 ≤ B := by
    dsimp [B]
    nlinarith [norm_nonneg (setup.gradF setup.xStar), setup.hL_nonneg,
      setup.hM_nonneg, hK_nonneg]
  have hcurv :
      setup.f y - setup.f setup.xStar ≤
        ⟪setup.gradF setup.xStar, y - setup.xStar⟫_ℝ +
          (setup.L / 2) * d ^ 2 + setup.M * d := by
    have hcurv_raw :=
      (setup.hcurvature_model setup.xStar setup.hxStar_mem y hy).2
    have hcurv' :
        setup.f y - setup.f setup.xStar -
            ⟪setup.gradF setup.xStar, y - setup.xStar⟫_ℝ ≤
          (setup.L / 2) * d ^ 2 + setup.M * d := by
      simpa [StochasticAcceleratedGradientDescentSetup.f, d, norm_sub_rev] using hcurv_raw
    linarith
  have hinner :
      ⟪setup.gradF setup.xStar, y - setup.xStar⟫_ℝ ≤
        ‖setup.gradF setup.xStar‖ * d := by
    simpa [d, norm_sub_rev] using
      _voucher_step_inner_le_norm_mul_46 (setup.gradF setup.xStar)
        (y - setup.xStar)
  have hh :
      setup.h y - setup.h setup.xStar ≤ K * d := by
    have h :=
      hh_lip_on_X y hy setup.xStar setup.hxStar_mem
    have habs : setup.h y - setup.h setup.xStar ≤
        |setup.h y - setup.h setup.xStar| := le_abs_self _
    exact habs.trans (by simpa [d, norm_sub_rev] using h)
  have hgap_raw :
      setup.Psi y - setup.Psi setup.xStar ≤
        (‖setup.gradF setup.xStar‖ + setup.M + K) * d +
          (setup.L / 2) * d ^ 2 := by
    unfold StochasticAcceleratedGradientDescentSetup.Psi SOptLib.compositeObjective
    nlinarith [hcurv, hinner, hh]
  have hd_le_D : d ≤ d ^ 2 + 1 := by
    nlinarith [sq_nonneg (d - 1)]
  have hlinear_le :
      (‖setup.gradF setup.xStar‖ + setup.M + K) * d ≤
        (‖setup.gradF setup.xStar‖ + setup.M + K) * (d ^ 2 + 1) := by
    have hcoef_nonneg :
        0 ≤ ‖setup.gradF setup.xStar‖ + setup.M + K := by
      nlinarith [norm_nonneg (setup.gradF setup.xStar), setup.hM_nonneg, hK_nonneg]
    exact mul_le_mul_of_nonneg_left hd_le_D hcoef_nonneg
  have hquad_le :
      (setup.L / 2) * d ^ 2 ≤ setup.L * (d ^ 2 + 1) := by
    nlinarith [setup.hL_nonneg, sq_nonneg d]
  have hsum_le :
      (‖setup.gradF setup.xStar‖ + setup.M + K) * d +
          (setup.L / 2) * d ^ 2 ≤
        (‖setup.gradF setup.xStar‖ + setup.L + setup.M + K) *
          (d ^ 2 + 1) := by
    nlinarith [hlinear_le, hquad_le]
  have hB_enlarge :
      (‖setup.gradF setup.xStar‖ + setup.L + setup.M + K) *
          (d ^ 2 + 1) ≤
        B * (d ^ 2 + 1) := by
    dsimp [B]
    nlinarith [hD_nonneg]
  exact hgap_raw.trans (hsum_le.trans (by simpa [B, d] using hB_enlarge))

/-- Deterministic linearized-composite term reduced to a source composite gap
and the local curvature remainder.

This is the first non-wrapper bridge for the selected AC-SA regularity leaf.
Search checked `_voucher_step_acsa_linearized_composite_lower_bound_43`,
`SOptLib.compositeObjective`, and the Lipschitz/subgradient candidates; none
packages this two-direction split.  The proof uses the carrier subgradient at
`xUnder`, the curvature upper model from `xUnder` to `z`, and optimizer
minimality of `x*`, so the only remaining growth work is bounding the displayed
gap and curvature radius. -/
private theorem acsa_linearized_composite_le_xplus_gap_add_curvature
    {xUnder xPlus z : E}
    (hxUnder : xUnder ∈ setup.X)
    (hxPlus : xPlus ∈ setup.X)
    (hz : z ∈ setup.X) :
    ⟪setup.gradF xUnder, xPlus - z⟫_ℝ + setup.h xPlus - setup.h z ≤
      setup.Psi xPlus - setup.Psi setup.xStar +
        (setup.L / 2) * ‖z - xUnder‖ ^ 2 + setup.M * ‖z - xUnder‖ := by
  classical
  let q : ℝ := (setup.L / 2) * ‖z - xUnder‖ ^ 2 + setup.M * ‖z - xUnder‖
  have hsub_xPlus :
      setup.f xUnder + ⟪setup.gradF xUnder, xPlus - xUnder⟫_ℝ ≤
        setup.f xPlus := by
    have hs :=
      (SOptLib.mem_carrierSubdifferential_iff.mp
        (setup.hgradF_subgrad xUnder hxUnder)) ⟨xPlus, hxPlus⟩
    simpa [StochasticAcceleratedGradientDescentSetup.f] using hs
  have hA :
      ⟪setup.gradF xUnder, xPlus - xUnder⟫_ℝ +
          setup.h xPlus - setup.h xUnder ≤
        setup.Psi xPlus - setup.Psi xUnder := by
    unfold StochasticAcceleratedGradientDescentSetup.Psi SOptLib.compositeObjective
    nlinarith [hsub_xPlus]
  have hcurv_z :
      setup.f z - setup.f xUnder -
          ⟪setup.gradF xUnder, z - xUnder⟫_ℝ ≤ q := by
    have hcurv_raw := (setup.hcurvature_model xUnder hxUnder z hz).2
    simpa [StochasticAcceleratedGradientDescentSetup.f, q] using hcurv_raw
  have hinner_rev :
      ⟪setup.gradF xUnder, xUnder - z⟫_ℝ =
        -⟪setup.gradF xUnder, z - xUnder⟫_ℝ := by
    have hv : xUnder - z = -(z - xUnder) := by
      abel
    rw [hv, inner_neg_right]
  have hB :
      ⟪setup.gradF xUnder, xUnder - z⟫_ℝ +
          setup.h xUnder - setup.h z ≤
        setup.Psi xUnder - setup.Psi z + q := by
    unfold StochasticAcceleratedGradientDescentSetup.Psi SOptLib.compositeObjective
    rw [hinner_rev]
    nlinarith [hcurv_z]
  have hsplit :
      ⟪setup.gradF xUnder, xPlus - z⟫_ℝ + setup.h xPlus - setup.h z =
        (⟪setup.gradF xUnder, xPlus - xUnder⟫_ℝ +
            setup.h xPlus - setup.h xUnder) +
          (⟪setup.gradF xUnder, xUnder - z⟫_ℝ +
            setup.h xUnder - setup.h z) := by
    have hv : xPlus - z = (xPlus - xUnder) + (xUnder - z) := by
      abel
    rw [hv, inner_add_right]
    ring
  have hto_z :
      ⟪setup.gradF xUnder, xPlus - z⟫_ℝ + setup.h xPlus - setup.h z ≤
        setup.Psi xPlus - setup.Psi z + q := by
    rw [hsplit]
    nlinarith [hA, hB]
  have hopt_z : setup.Psi setup.xStar ≤ setup.Psi z := by
    simpa [StochasticAcceleratedGradientDescentSetup.Psi,
      StochasticAcceleratedGradientDescentSetup.f, SOptLib.compositeObjective] using
      setup.hxStar_minimizes z hz
  dsimp [q] at hto_z
  nlinarith [hto_z, hopt_z]

/-! Deterministic affine transport from Lan Eqs. (4.2.5), (4.2.7),
(4.2.9), and (4.2.14).

Aligns with the later run-level theorem
`xbar_sub_xunder_eq_alpha_smul_xiter_sub_xplus`, but avoids its realization
boundary.  The pre-searched measurability/oracle candidates were checked and
rejected because this proof is pure affine parameter algebra, not a stochastic
measurability or oracle statement. -/
private theorem acsa_average_under_eq_alpha_xnext_sub_xplus_deterministic
    (t : {n : ℕ // 1 ≤ n})
    (hgamma_pos : 0 < setup.gamma t.1)
    (prev : FeasibleStochasticAcceleratedGradientDescentState (E := E) setup.X)
    (z xPlus : E)
    (hxPlus :
      xPlus =
        (setup.mu * setup.gamma t.1 / (1 + setup.mu * setup.gamma t.1)) •
            setup.searchPoint t prev +
          (1 / (1 + setup.mu * setup.gamma t.1)) • prev.x) :
    setup.averagePoint t prev z - setup.searchPoint t prev =
      setup.alpha t.1 • (z - xPlus) := by
  have hden : 1 + setup.mu * setup.gamma t.1 ≠ 0 := by
    have hmul_nonneg : 0 ≤ setup.mu * setup.gamma t.1 :=
      mul_nonneg setup.hmu_nonneg (le_of_lt hgamma_pos)
    exact ne_of_gt (by linarith)
  simpa [StochasticAcceleratedGradientDescentSetup.averagePoint] using
    average_sub_search_eq_alpha_smul_step_sub_weighted_center
      (alpha := setup.alpha t.1) (q := setup.q t.1)
      (mu := setup.mu) (gamma := setup.gamma t.1)
      (xBarPrev := prev.xBar) (xPrev := prev.x)
      (xUnder := setup.searchPoint t prev) (xNext := z) (xPlus := xPlus)
      hden (by simpa using setup.q_relation_displayed t)
      (by
        unfold StochasticAcceleratedGradientDescentSetup.searchPoint
          SOptLib.acceleratedSearchPoint
        rfl)
      hxPlus

/-! Route-local copy of Lan Lemma 4.4 for the earlier generated-regularity
section.

The public `lemma_4_4` below has the same mathematical statement but is declared
after the selected regularity helper; using it here would require a public
declaration-order refactor.  The searched SOptLib curvature/subgradient
candidates expose the component facts, not this composite averaged upper-model
form, so this private bridge keeps the source Eq. (4.4) step available locally. -/
private theorem acsa_lemma_4_4_route_local
    (setup : StochasticAcceleratedGradientDescentSetup E S)
    {alpha_t : ℝ} (halpha : alpha_t ∈ Set.Icc (0 : ℝ) 1)
    {xBarPrev x_t z : E}
    (hxBarPrev : xBarPrev ∈ setup.X)
    (hx_t : x_t ∈ setup.X)
    (hz : z ∈ setup.X) :
    setup.Psi ((1 - alpha_t) • xBarPrev + alpha_t • x_t) ≤
      (1 - alpha_t) * setup.Psi xBarPrev +
        alpha_t * (setup.f z + ⟪setup.gradF z, x_t - z⟫_ℝ + setup.h x_t) +
        (setup.L / 2) * ‖((1 - alpha_t) • xBarPrev + alpha_t • x_t) - z‖ ^ 2 +
        setup.M * ‖((1 - alpha_t) • xBarPrev + alpha_t • x_t) - z‖ := by
  let y : E := (1 - alpha_t) • xBarPrev + alpha_t • x_t
  rcases Set.mem_Icc.mp halpha with ⟨ha0, ha1⟩
  have h1ma : 0 ≤ 1 - alpha_t := sub_nonneg.mpr ha1
  have hsum : (1 - alpha_t) + alpha_t = 1 := by ring
  have hy : y ∈ setup.X := by
    simpa [y] using setup.hX_convex hxBarPrev hx_t h1ma ha0 hsum
  have hfcurv :
      setup.f y ≤ setup.f z + ⟪setup.gradF z, y - z⟫_ℝ +
        (setup.L / 2) * ‖y - z‖ ^ 2 + setup.M * ‖y - z‖ := by
    have hcurv := (setup.hcurvature_model z hz y hy).2
    unfold StochasticAcceleratedGradientDescentSetup.f
    linarith
  have hsupport :
      setup.f z + ⟪setup.gradF z, xBarPrev - z⟫_ℝ ≤ setup.f xBarPrev := by
    have hsub :=
      (SOptLib.mem_carrierSubdifferential_iff.mp (setup.hgradF_subgrad z hz))
        ⟨xBarPrev, hxBarPrev⟩
    unfold StochasticAcceleratedGradientDescentSetup.f
    linarith
  simpa [StochasticAcceleratedGradientDescentSetup.Psi, y] using
    SOptLib.composite_upper_model_at_convex_average
      (X := setup.X) (f := setup.f) (h := setup.h) (gradF := setup.gradF)
      (L := setup.L) (M := setup.M) (alpha := alpha_t)
      (xBarPrev := xBarPrev) (xNext := x_t) (z := z)
      (IsAcsSimpleConvexTerm.convex setup.hh_simple) halpha
      hxBarPrev hx_t hfcurv hsupport

/-! Endpoint conversion for the selected AC-SA regularity route.

This is a scalar/metric consequence of the already searched and proved
`norm_sq_xstar_z_from_xplus_and_displacement`; it is separated from the large
prox proof so the remaining source absorption hole stays focused on the
`z - xPlus` displacement bound. -/
private theorem acsa_endpoint_from_displacement_budget
    {xStar z xPlus η : E} {state coeff γ : ℝ}
    (hxPlus :
      ‖xStar - xPlus‖ ^ 2 ≤ 2 * state)
    (hdisp :
      ‖z - xPlus‖ ^ 2 ≤
        coeff * state + (γ ^ 2 / 2) * ‖η‖ ^ 2 + coeff)
    (hstate_nonneg : 0 ≤ state)
    (hcoeff_ge_three : 3 ≤ coeff) :
    ‖xStar - z‖ ^ 2 ≤
      (coeff ^ 2 + 1) * state + (γ ^ 2 + 1) * ‖η‖ ^ 2 +
        (coeff ^ 2 + γ ^ 2 + 1) := by
  have hmetric :
      ‖xStar - z‖ ^ 2 ≤
        2 * (2 * state) +
          2 * (coeff * state + (γ ^ 2 / 2) * ‖η‖ ^ 2 + coeff) :=
    norm_sq_xstar_z_from_xplus_and_displacement
      (xStar := xStar) (z := z) (xPlus := xPlus) hxPlus hdisp
  have hcoeff_sq_large : 2 * coeff + 4 ≤ coeff ^ 2 + 1 := by
    have hleft : 0 ≤ coeff - 3 := sub_nonneg.mpr hcoeff_ge_three
    have hright : 0 ≤ coeff + 1 := by linarith only [hcoeff_ge_three]
    have hmul := mul_nonneg hleft hright
    nlinarith only [hmul]
  have hconst_large : 2 * coeff ≤ coeff ^ 2 + γ ^ 2 + 1 := by
    have hsqc : 0 ≤ (coeff - 1) ^ 2 := sq_nonneg _
    have hsqg : 0 ≤ γ ^ 2 := sq_nonneg _
    nlinarith only [hsqc, hsqg]
  have hnoise_nonneg : 0 ≤ ‖η‖ ^ 2 := sq_nonneg _
  have hgamma_sq_nonneg : 0 ≤ γ ^ 2 := sq_nonneg γ
  nlinarith [hmetric, hcoeff_sq_large, hconst_large, hstate_nonneg,
    hnoise_nonneg, hgamma_sq_nonneg]

/-! General endpoint conversion for the selected AC-SA regularity route.

The earlier `acsa_endpoint_from_displacement_budget` was considered, but it
hard-codes the refuted `γ^2 / 2` noise coefficient.  This helper keeps the same
proved metric core `norm_sq_xstar_z_from_xplus_and_displacement` and allows the
source absorption step to supply any nonnegative displacement budget constants,
which is the private scaffold shape needed here rather than a paper primitive. -/
private theorem acsa_endpoint_from_displacement_budget_general
    {xStar z xPlus η : E} {state Ad Dd Cd : ℝ}
    (hxPlus :
      ‖xStar - xPlus‖ ^ 2 ≤ 2 * state)
    (hdisp :
      ‖z - xPlus‖ ^ 2 ≤ Ad * state + Dd * ‖η‖ ^ 2 + Cd)
    (hstate_nonneg : 0 ≤ state) :
    ‖xStar - z‖ ^ 2 ≤
      (4 + 2 * Ad) * state + (2 * Dd + 1) * ‖η‖ ^ 2 + (2 * Cd + 1) := by
  have hmetric :
      ‖xStar - z‖ ^ 2 ≤
        2 * (2 * state) +
          2 * (Ad * state + Dd * ‖η‖ ^ 2 + Cd) :=
    norm_sq_xstar_z_from_xplus_and_displacement
      (xStar := xStar) (z := z) (xPlus := xPlus) hxPlus hdisp
  have hnoise_nonneg : 0 ≤ ‖η‖ ^ 2 := sq_nonneg _
  nlinarith [hmetric, hstate_nonneg, hnoise_nonneg]

/-- Scalar endpoint normalization after the AC-SA search-point affine bound.

This keeps the final coefficient arithmetic out of the large prox proof
context. -/
private theorem acsa_endpoint_search_affine_normalize
    {lhs X Y Z N Ad Dd Cd : ℝ}
    (hendpoint :
      lhs ≤ (4 + 2 * Ad) * (X + Y) + (2 * Dd + 1) * N + (2 * Cd + 1))
    (hsearch : Y ≤ 2 * Z + 2 * X)
    (hAd : 0 ≤ Ad) :
    lhs ≤ (12 + 6 * Ad) * X + (8 + 4 * Ad) * Z +
      (2 * Dd + 1) * N + (2 * Cd + 1) := by
  have hcoef_nonneg : 0 ≤ 4 + 2 * Ad := by nlinarith
  have hmul := mul_le_mul_of_nonneg_left hsearch hcoef_nonneg
  nlinarith

/-! Route-local copy of the AC-SA denominator completion-square step.

The later `acsa_delta_completion_square` was found by symbol search and matches
Lan Eq. (4.2.19), but it is declared after this private regularity bridge.  This
copy keeps the same source scalar form available here; SOptLib's generic Young
helpers have different weights and do not expose the literal denominator
`1 + μγ_t - Lα_tγ_t`. -/
private theorem acsa_delta_completion_square_route_local
    {M gamma D a : ℝ} {δ d : E}
    (ha : 0 ≤ a) (hgamma : 0 < gamma) (hD : 0 < D) (hM : 0 ≤ M) :
    a * (M * ‖d‖ - ⟪δ, d⟫_ℝ - D / (2 * gamma) * ‖d‖ ^ 2) ≤
      a * gamma * (M + SOptLib.dualNorm δ) ^ 2 / (2 * D) := by
  rw [SOptLib.dualNorm_eq_norm]
  have hinner_abs : |⟪δ, d⟫_ℝ| ≤ ‖δ‖ * ‖d‖ :=
    abs_real_inner_le_norm δ d
  have hinner : -⟪δ, d⟫_ℝ ≤ ‖δ‖ * ‖d‖ := by
    exact le_trans (neg_le_abs _) hinner_abs
  have hlinear :
      M * ‖d‖ - ⟪δ, d⟫_ℝ ≤ (M + ‖δ‖) * ‖d‖ := by
    nlinarith [hinner, norm_nonneg d]
  have hsq : 0 ≤ (D * ‖d‖ - gamma * (M + ‖δ‖)) ^ 2 :=
    sq_nonneg _
  have hyoung :
      (M + ‖δ‖) * ‖d‖ - D / (2 * gamma) * ‖d‖ ^ 2 ≤
        gamma * (M + ‖δ‖) ^ 2 / (2 * D) := by
    field_simp [ne_of_gt hgamma, ne_of_gt hD]
    nlinarith [hsq, hgamma, hD]
  have hscalar :
      M * ‖d‖ - ⟪δ, d⟫_ℝ - D / (2 * gamma) * ‖d‖ ^ 2 ≤
        gamma * (M + ‖δ‖) ^ 2 / (2 * D) := by
    linarith
  have hmul := mul_le_mul_of_nonneg_left hscalar ha
  calc
    a * (M * ‖d‖ - ⟪δ, d⟫_ℝ - D / (2 * gamma) * ‖d‖ ^ 2)
        ≤ a * (gamma * (M + ‖δ‖) ^ 2 / (2 * D)) := hmul
    _ = a * gamma * (M + ‖δ‖) ^ 2 / (2 * D) := by ring

/-- Route-local Lan (4.2.17)-(4.2.19) tail absorption.

This is the scalar/vector tail step used in the public proof of
`proposition_4_2_under_run_contract`, factored out for the earlier generated
regularity frontier.  It keeps the source denominator `D` and the stochastic
