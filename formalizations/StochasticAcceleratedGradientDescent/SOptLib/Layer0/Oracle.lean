theorem stochastic_error_integral_bound_of_square_and_inner_zero
    {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    (Delta squareTerm innerTerm : Ω → ℝ)
    (c a B : ℝ)
    (hDelta_eq :
      Delta =ᵐ[P] fun ω => c * squareTerm ω + a * innerTerm ω)
    (hsquare_int : Integrable squareTerm P)
    (hinner_int : Integrable innerTerm P)
    (hsquare_bound : ∫ ω, squareTerm ω ∂P ≤ B)
    (hinner_zero : ∫ ω, innerTerm ω ∂P = 0)
    (hc_nonneg : 0 ≤ c) :
    Integrable Delta P ∧ ∫ ω, Delta ω ∂P ≤ c * B := by
  have hsum_int :
      Integrable (fun ω => c * squareTerm ω + a * innerTerm ω) P :=
    (hsquare_int.const_mul c).add (hinner_int.const_mul a)
  have hDelta_int : Integrable Delta P := by
    refine hsum_int.congr ?_
    filter_upwards [hDelta_eq] with ω hω
    exact hω.symm
  refine ⟨hDelta_int, ?_⟩
  calc
    ∫ ω, Delta ω ∂P
        = ∫ ω, c * squareTerm ω + a * innerTerm ω ∂P := by
          exact integral_congr_ae hDelta_eq
    _ = c * (∫ ω, squareTerm ω ∂P) +
          a * (∫ ω, innerTerm ω ∂P) := by
          rw [integral_add (hsquare_int.const_mul c)
            (hinner_int.const_mul a)]
          rw [integral_const_mul, integral_const_mul]
    _ = c * (∫ ω, squareTerm ω ∂P) := by
          rw [hinner_zero]
          ring
