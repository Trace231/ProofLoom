  have h_sample_eq_mean :
      ∫ ω, ⟪d ω, G (x ω) (sample ω) - G (y ω) (sample ω)⟫_ℝ ∂P =
        ∫ ω, ⟪d ω, target (x ω) - target (y ω)⟫_ℝ ∂P := by
    calc
