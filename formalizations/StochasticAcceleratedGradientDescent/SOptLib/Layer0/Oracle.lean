/-- A fresh sample is independent of the sample-prefix natural filtration.

For an independent sample stream `ξ`, the sigma-algebra generated by the current
coordinate `ξ t` is independent of the filtration generated by the strict sample
prefix before time `t`.

Layer: Model | Gap: Level 1 (fresh-sample independence from generated past)
Proof: unfold the sample-prefix filtration at time `t` and apply Mathlib's
  `iIndepFun.indep_past_iSup_current` independence theorem for independent
  function families.
Source: Mathlib probability independence APIs for `iIndepFun` and past `iSup`
  sigma-algebras
Used in: stochastic mirror descent oracle-noise conditioning with an iid fresh
  sample independent of the generated sample history
Book citation: book/FOML/StochasticMirrorDescent.json#/algorithm_spec
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for
  Machine Learning, stochastic mirror descent -/
theorem samplePrefixFiltration_indep_current
    {Ω S : Type*} [MeasurableSpace Ω] [MeasurableSpace S]
    {μ : Measure Ω}
    (ξ : ℕ → Ω → S)
    (hξ_measurable : ∀ n, Measurable (ξ n))
    (hξ_iIndep : iIndepFun ξ μ)
    (t : ℕ) :
    Indep ((SOptLib.filtration ξ hξ_measurable).seq t)
      (MeasurableSpace.comap (ξ t)
        (by infer_instance : MeasurableSpace S)) μ := by
  simpa [SOptLib.filtration_seq] using
    (ProbabilityTheory.iIndepFun.indep_past_iSup_current
      (ξ := ξ) (μ := μ) (t := t) hξ_measurable hξ_iIndep)

/-- A jointly measurable oracle residual is a.e. strongly measurable at
measurable random query and sample inputs.

If the residual kernel is measurable on the query/sample product and both
random inputs are measurable, then the sampled residual process is
`AEStronglyMeasurable` under any base measure.

Layer: Layer0 | Gap: Level 0 (random-query oracle residual measurability)
Proof: build the measurable product map `(query, sample)`, compose it with the
  jointly measurable residual kernel, and use the standard measurable to
  a.e.-strongly-measurable bridge.
Source: Mathlib measure theory product-measurability, composition, and strongly
  measurable APIs
Used in: stochastic accelerated gradient descent martingale-noise conditioning
  at a generated feasible search point and fresh oracle sample
Book citation: book/FOML/StochasticAcceleratedGradientDescent.json#/algorithm_spec
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for
  Machine Learning, stochastic accelerated gradient descent -/
theorem oracleResidual_aestronglyMeasurable_of_query_sample_measurable
    {Ω X S E : Type*} [MeasurableSpace Ω] [MeasurableSpace X] [MeasurableSpace S]
    [MeasurableSpace E] [TopologicalSpace E]
    [TopologicalSpace.PseudoMetrizableSpace E]
    [SecondCountableTopology E] [OpensMeasurableSpace E]
    (P : Measure Ω) {query : Ω → X} {sample : Ω → S}
    {residual : X → S → E}
    (hquery : Measurable query) (hsample : Measurable sample)
    (hresidual : Measurable (fun p : X × S => residual p.1 p.2)) :
    AEStronglyMeasurable (fun ω => residual (query ω) (sample ω)) P := by
  have hpair : Measurable (fun ω => (query ω, sample ω)) :=
    hquery.prodMk hsample
  have hcomp :
      Measurable (fun ω => residual (query ω) (sample ω)) :=
    hresidual.comp hpair
  exact hcomp.aestronglyMeasurable_measure

/-- A sampled oracle residual has integrable inner product with any L2 multiplier.

If the centered residual kernel `G x s - target x` is jointly measurable, the
query and sample processes are measurable, and both the sampled residual and the
multiplier have integrable squared norms, then their real Hilbert inner product
is Bochner integrable.

Layer: Layer0 | Gap: Level 0 (random-query oracle residual scalar integrability)
Proof: compose the jointly measurable residual kernel with the measurable
  `(query, sample)` pair to obtain a.e. strong measurability, then apply the
  L2 inner-product integrability bridge to the sampled residual and multiplier.
Source: Mathlib measure-theory product measurability, strongly measurable
  functions, Lp-space, and real Hilbert inner-product APIs
Used in: stochastic accelerated gradient descent martingale-noise
  inner-product side condition before oracle-noise cancellation
Book citation: book/FOML/StochasticAcceleratedGradientDescent.json#/algorithm_spec
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for
  Machine Learning, stochastic accelerated gradient descent -/
theorem integrable_oracle_residual_inner_of_l2_multiplier
    {Ω X S E : Type*} [MeasurableSpace Ω] [MeasurableSpace X] [MeasurableSpace S]
    [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (P : Measure Ω) {query : Ω → X} {sample : Ω → S}
    (G : X → S → E) (target : X → E) (multiplier : Ω → E)
    (hquery : Measurable query) (hsample : Measurable sample)
    (hres_meas : Measurable (fun p : X × S => G p.1 p.2 - target p.1))
    (hmult_meas : AEStronglyMeasurable multiplier P)
    (hres_sq :
      Integrable
        (fun ω => ‖G (query ω) (sample ω) - target (query ω)‖ ^ 2) P)
    (hmult_sq : Integrable (fun ω => ‖multiplier ω‖ ^ 2) P) :
    Integrable
      (fun ω => ⟪G (query ω) (sample ω) - target (query ω),
        multiplier ω⟫_ℝ) P := by
  have hpair : Measurable (fun ω => (query ω, sample ω)) :=
    hquery.prodMk hsample
  have hres_comp :
      Measurable (fun ω => G (query ω) (sample ω) - target (query ω)) :=
    hres_meas.comp hpair
  exact
    integrable_inner_of_integrable_sq_norm
      hres_comp.aestronglyMeasurable_measure hmult_meas hres_sq hmult_sq

/-- A shifted square noise budget plus a scaled Hilbert scalarization is integrable.

If `noise` is square-integrable and its inner product with a multiplier is
integrable, then any real scalar multiple of `(M + ‖noise‖)^2` divided by a
constant denominator can be added to any real scalar multiple of that inner
product while preserving integrability.

Layer: Layer0 | Gap: Level 0 (shifted-square stochastic-error integrability)
Proof: derive `L¹` integrability of `noise` from its squared norm, expand the
  shifted square into constant, norm, and squared-norm terms, then close under
  scalar multiplication and addition with the given inner-product summand.
Source: Mathlib Bochner integrability APIs for finite measures, norm powers,
  scalar multiplication, and additive closure
Used in: stochastic accelerated gradient descent finite-window stochastic-error
  summand before martingale-noise cancellation and telescoping
Book citation: book/FOML/StochasticAcceleratedGradientDescent.json#/algorithm_spec
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for
  Machine Learning, stochastic accelerated gradient descent -/
theorem integrable_scaled_noise_square_plus_inner_of_l2
    {Ω E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {μ : Measure Ω} [IsFiniteMeasure μ]
    (noise multiplier : Ω → E) (a b M den : ℝ)
    (hnoise_meas : AEStronglyMeasurable noise μ)
    (hnoise_sq : Integrable (fun ω => ‖noise ω‖ ^ 2) μ)
    (hinner :
      Integrable (fun ω => ⟪noise ω, multiplier ω⟫_ℝ) μ) :
    Integrable
      (fun ω =>
        a * b * (M + ‖noise ω‖) ^ 2 / (2 * den) +
          a * ⟪noise ω, multiplier ω⟫_ℝ)
      μ := by
  have hnoise_int : Integrable noise μ :=
    integrable_of_integrable_norm_sq hnoise_meas hnoise_sq
  have hnorm_int : Integrable (fun ω => ‖noise ω‖) μ :=
    hnoise_int.norm
  have htail_poly_int :
      Integrable
        (fun ω => M ^ 2 + (2 * M) * ‖noise ω‖ + ‖noise ω‖ ^ 2)
        μ :=
    ((integrable_const (c := M ^ 2)).add
      (hnorm_int.const_mul (2 * M))).add hnoise_sq
  have htail_sq_int :
      Integrable (fun ω => (M + ‖noise ω‖) ^ 2) μ := by
    refine htail_poly_int.congr ?_
    filter_upwards with ω
    ring
  have htail_int :
      Integrable
        (fun ω => a * b * (M + ‖noise ω‖) ^ 2 / (2 * den))
        μ := by
    refine (htail_sq_int.const_mul (a * b / (2 * den))).congr ?_
    filter_upwards with ω
    ring
  have hscaled_inner :
      Integrable (fun ω => a * ⟪noise ω, multiplier ω⟫_ℝ) μ :=
    hinner.const_mul a
  exact htail_int.add hscaled_inner

/-- A sampled oracle variance bound follows from uniform fixed-argument variance bounds.

If every fixed query point has an integrable squared oracle error bounded by `σ2`,
then the sampled oracle error at the chosen point `x` and sample index `t` is also
bounded by `σ2`.

Layer: Layer0 | Gap: Level 0 (fixed-sample oracle variance bound)
Proof: specialize the all-arguments hypothesis to `x` and project the variance
  inequality component.
Source: Mathlib measure-theory Bochner integration and ordered real APIs
Used in: stochastic mirror descent sampled oracle variance control
Book citation: book/FOML/StochasticMirrorDescent.json#/algorithm_spec
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for Machine Learning, stochastic mirror descent -/
theorem sample_oracle_variance_bound
    {Ω X S E T : Type*} [MeasurableSpace Ω] [NormedAddCommGroup E]
    (P : Measure Ω) (G : X → S → E) (g : X → E) (β : T → Ω → S)
    (normDual : E → ℝ) (σ2 : ℝ) (x : X) (t : T)
    (h_fixed :
      ∀ z : X,
        Integrable (fun ω => normDual (G z (β t ω) - g z) ^ 2) P ∧
          ∫ ω, normDual (G z (β t ω) - g z) ^ 2 ∂P ≤ σ2) :
    ∫ ω, normDual (G x (β t ω) - g x) ^ 2 ∂P ≤ σ2 := by
  exact h_fixed x |>.2

/-- Transfer a fixed-parameter oracle variance bound to an independent random iterate.

If the current sample `Y` has law `ν`, the random iterate `x` is independent of `Y`,
and every fixed fiber `s ↦ G z s - g z` has squared norm integrable and bounded by
`σ2` along `Y`, then the random-iterate squared deviation has the same integrability
and variance bound.

Layer: Layer0 | Gap: Level 1 (random-iterate variance transfer)
Proof: push the fixed bounds to the sample law, then apply the product-law/Fubini
  transfer lemmas for independent random parameters.
Source: Mathlib product-measure integration and independence APIs
Used in: stochastic mirror descent random-iterate oracle variance bridge
Book citation: book/PAPER/ALG.json#/stochastic_mirror_descent
Origin algorithm: Lan stochastic mirror descent variance transfer -/
theorem randomIterate_variance_bound_of_fixed_variance
    {Ω X S E : Type*} [MeasurableSpace Ω] [MeasurableSpace X] [MeasurableSpace S]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    {P : Measure Ω} {ν : Measure S} [IsProbabilityMeasure P] [IsProbabilityMeasure ν]
    (G : X → S → E) (g : X → E) (x : Ω → X) (Y : Ω → S) (σ2 : ℝ)
    (hdev_meas : Measurable (fun p : X × S => G p.1 p.2 - g p.1))
    (hx_meas : Measurable x) (hY_meas : Measurable Y)
    (h_indep : IndepFun x Y P)
    (h_dist : Measure.map Y P = ν)
    (hσ2_nonneg : 0 ≤ σ2)
    (hfixed_int : ∀ z, Integrable (fun ω => ‖G z (Y ω) - g z‖ ^ 2) P)
    (hfixed_bound : ∀ z, ∫ ω, ‖G z (Y ω) - g z‖ ^ 2 ∂P ≤ σ2) :
    Integrable (fun ω => ‖G (x ω) (Y ω) - g (x ω)‖ ^ 2) P ∧
      ∫ ω, ‖G (x ω) (Y ω) - g (x ω)‖ ^ 2 ∂P ≤ σ2 := by
  classical
  let φ : X → S → ℝ := fun z s => ‖G z s - g z‖ ^ 2
  have hφ : Measurable (Function.uncurry φ) := by
    simpa [φ, Function.uncurry] using hdev_meas.norm.pow_const 2
  have hφ_nonneg : ∀ z s, 0 ≤ φ z s := by
    intro z s
    exact sq_nonneg _
  have hfixed_int_law : ∀ z, Integrable (fun s => φ z s) ν := by
    intro z
    have hfib : Measurable (fun s : S => φ z s) := by
      simpa [φ, Function.uncurry] using
        hφ.comp (measurable_const.prodMk measurable_id)
    have hmap :
        Integrable (fun s : S => φ z s) (Measure.map Y P) :=
      (integrable_map_measure hfib.aestronglyMeasurable hY_meas.aemeasurable).mpr
        (by simpa [φ] using hfixed_int z)
    simpa [h_dist] using hmap
  have hfixed_bound_law : ∀ z, ∫ s, φ z s ∂ν ≤ σ2 := by
    intro z
    have hfib : Measurable (fun s : S => φ z s) := by
      simpa [φ, Function.uncurry] using
        hφ.comp (measurable_const.prodMk measurable_id)
    have hmap : (∫ s, φ z s ∂ν) = ∫ ω, φ z (Y ω) ∂P := by
      rw [← h_dist]
      exact integral_map hY_meas.aemeasurable hfib.aestronglyMeasurable
    rw [hmap]
    simpa [φ] using hfixed_bound z
  have hint : Integrable (fun ω => φ (x ω) (Y ω)) P :=
    integrable_comp_of_indep_fixed_integral_bound
      (P := P) (ν := ν) (φ := φ) (X := x) (Y := Y) (C := σ2)
      hφ hx_meas hY_meas h_indep h_dist hφ_nonneg hσ2_nonneg
      hfixed_int_law hfixed_bound_law
  have hbound : ∫ ω, φ (x ω) (Y ω) ∂P ≤ σ2 :=
    integral_comp_le_of_indep_fixed_integral_bound
      (P := P) (ν := ν) (φ := φ) (X := x) (Y := Y) (C := σ2)
      hφ hx_meas hY_meas h_indep h_dist hint hfixed_bound_law
  exact ⟨by simpa [φ] using hint, by simpa [φ] using hbound⟩



/-- Set-integral cancellation for a centered oracle noise over a past-measurable event.

Layer: Layer0 | Gap: Level 1 (past event/product-law oracle cancellation)
Proof: encode the event as an indicator coefficient, pair it with the past-measurable
  random parameter, use independence to transfer fixed-fiber zero integrals, and
  rewrite the composed kernel as the restricted integral.
Source: Mathlib product-measure integration and independence APIs
Used in: stochastic mirror descent conditional-unbiasedness bridge
Book citation: book/PAPER/ALG.json#/stochastic_mirror_descent
Origin algorithm: Lan stochastic mirror descent oracle noise martingale step -/
theorem oracle_noise_setIntegral_eq_zero_of_past_measurable
    {Ω X S E : Type*} [mΩ : MeasurableSpace Ω] [MeasurableSpace X] [MeasurableSpace S]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (μ : @Measure Ω mΩ) [IsFiniteMeasure μ]
    (m : MeasurableSpace Ω) (hm : m ≤ mΩ)
    (G : X → S → E) (g : X → E) (x : Ω → X) (Y : Ω → S)
    (s : Set Ω)
    (hs : @MeasurableSet Ω m s)
    (hGg_meas : Measurable (fun p : X × S => G p.1 p.2 - g p.1))
    (hx_past : @Measurable Ω X m _ x)
    (hx : @Measurable Ω X mΩ _ x)
    (hY : @Measurable Ω S mΩ _ Y)
    (h_indep :
      IndepFun (fun ω => (s.indicator (fun _ => (1 : ℝ)) ω, x ω)) Y μ)
    (h_int : Integrable (fun ω => G (x ω) (Y ω) - g (x ω)) μ)
    (hfixed_zero :
      ∀ z : X, ∫ y, G z y - g z ∂(@Measure.map Ω S mΩ _ Y μ) = 0) :
    ∫ ω in s, G (x ω) (Y ω) - g (x ω) ∂μ = 0 := by
  classical
  let a : Ω → ℝ := s.indicator (fun _ => (1 : ℝ))
  let Z : Ω → ℝ × X := fun ω => (a ω, x ω)
  let ν : Measure S := @Measure.map Ω S mΩ _ Y μ
  let φ : (ℝ × X) → S → E := fun z y => z.1 • (G z.2 y - g z.2)
  have hs_top : @MeasurableSet Ω mΩ s := hm _ hs
  have ha_past : @Measurable Ω ℝ m _ a := by
    have hconst : @Measurable Ω ℝ m _ (fun _ : Ω => (1 : ℝ)) := measurable_const
    simpa [a] using hconst.indicator hs
  have hZpast : @Measurable Ω (ℝ × X) m _ Z := by
    exact ha_past.prodMk hx_past
  have ha_top : @Measurable Ω ℝ mΩ _ a := by
    have hconst : @Measurable Ω ℝ mΩ _ (fun _ : Ω => (1 : ℝ)) := measurable_const
    simpa [a] using hconst.indicator hs_top
  have hZ : @Measurable Ω (ℝ × X) mΩ _ Z := by
    exact ha_top.prodMk hx
  have h_indep_Z : IndepFun Z Y μ := by
    simpa [Z, a] using h_indep
  have hφ_meas : Measurable (Function.uncurry φ) := by
    have hpair : Measurable (fun p : (ℝ × X) × S => (p.1.2, p.2)) :=
      (measurable_snd.comp measurable_fst).prodMk measurable_snd
    have hnoise : Measurable (fun p : (ℝ × X) × S => G p.1.2 p.2 - g p.1.2) :=
      hGg_meas.comp hpair
    have hcoef : Measurable (fun p : (ℝ × X) × S => p.1.1) :=
      measurable_fst.comp measurable_fst
    simpa [φ, Function.uncurry] using hcoef.smul hnoise
  have hφ_eq :
      (fun ω => φ (Z ω) (Y ω)) =
        s.indicator (fun ω => G (x ω) (Y ω) - g (x ω)) := by
    funext ω
    by_cases hω : ω ∈ s <;> simp [φ, Z, a, hω]
  have hφ_int : Integrable (fun ω => φ (Z ω) (Y ω)) μ := by
    simpa [hφ_eq] using h_int.indicator hs_top
  have hφ_fixed_zero : ∀ z : ℝ × X, ∫ y, φ z y ∂ν = 0 := by
    intro z
    rcases z with ⟨c, z⟩
    have hcenter : ∫ y, G z y - g z ∂ν = 0 := by
      simpa [ν] using hfixed_zero z
    calc
      ∫ y, φ (c, z) y ∂ν = c • ∫ y, G z y - g z ∂ν := by
        simpa [φ] using (integral_smul c (fun y : S => G z y - g z) (μ := ν))
      _ = 0 := by simp [hcenter]
  have hmain : ∫ ω, φ (Z ω) (Y ω) ∂μ = 0 := by
    exact @integral_comp_eq_zero_of_indep_fixed_integral_zero
      Ω (ℝ × X) S E mΩ inferInstance inferInstance inferInstance inferInstance
      inferInstance inferInstance inferInstance inferInstance
      μ ν inferInstance inferInstance φ Z Y
      hφ_meas hZ hY h_indep_Z rfl hφ_int hφ_fixed_zero
  rw [← MeasureTheory.integral_indicator (μ := μ)
    (f := fun ω => G (x ω) (Y ω) - g (x ω)) hs_top]
  simpa [hφ_eq] using hmain



