    calc
      ⟪lift i ζ, d⟫_ℝ = ⟪d, lift i ζ⟫_ℝ := by rw [real_inner_comm]
      _ = ⟪coord i d, ζ⟫_ℝ := by rw [← hpair]
      _ = ⟪ζ, coord i d⟫_ℝ := by rw [real_inner_comm]
  have hsupport_R :
      |⟪ζ, coord i d⟫_ℝ| ≤ dualNorm i ζ * R i :=
    hsupport.trans (mul_le_mul_of_nonneg_left hradius hdual_nonneg)
  calc
    |⟪c • lift i ζ, d⟫_ℝ|
        = c * |⟪ζ, coord i d⟫_ℝ| := by
            simp [inner_smul_left, hpair', abs_mul, abs_of_nonneg hc_nonneg]
    _ ≤ c * (dualNorm i ζ * R i) :=
          mul_le_mul_of_nonneg_left hsupport_R hc_nonneg
