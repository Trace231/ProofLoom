theorem wolfeGap_le_maxLinearModel_add_estimatorError_mul_diameter
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {X : Set E} (grad : E → E) (maximizer : E → {y : E // y ∈ X})
    (maxLinearModel : E → E → ℝ) (D : ℝ) (x G : E)
    (maxLinearModel_bound_at :
      ⟪G, x - (maximizer x : E)⟫_ℝ ≤ maxLinearModel x G)
    (diameter_bound_at :
      ‖x - (maximizer x : E)‖ ≤ D) :
    wolfeGap grad maximizer x ≤
      maxLinearModel x G + ‖G - grad x‖ * D := by
  classical
  let z : {y : E // y ∈ X} := maximizer x
  let v : E := x - (z : E)
  have hmodel : ⟪G, v⟫_ℝ ≤ maxLinearModel x G := by
    simpa [v, z] using maxLinearModel_bound_at
  have herr : -⟪G - grad x, v⟫_ℝ ≤ ‖G - grad x‖ * D := by
    have h_abs : -⟪G - grad x, v⟫_ℝ ≤ |⟪G - grad x, v⟫_ℝ| :=
      neg_le_abs _
    have h_cauchy :
        |⟪G - grad x, v⟫_ℝ| ≤ ‖G - grad x‖ * ‖v‖ :=
      abs_real_inner_le_norm (G - grad x) v
    have h_diam :
        ‖G - grad x‖ * ‖v‖ ≤ ‖G - grad x‖ * D := by
      exact mul_le_mul_of_nonneg_left
        (by simpa [v, z] using diameter_bound_at)
        (norm_nonneg _)
    exact h_abs.trans (h_cauchy.trans h_diam)
  calc
    wolfeGap grad maximizer x = ⟪grad x, v⟫_ℝ := by
      simp [wolfeGap, z, v]
    _ = ⟪G, v⟫_ℝ - ⟪G - grad x, v⟫_ℝ := by
      rw [sub_eq_add_neg, inner_sub_left]
      ring
    _ ≤ maxLinearModel x G + ‖G - grad x‖ * D := by
      linarith

