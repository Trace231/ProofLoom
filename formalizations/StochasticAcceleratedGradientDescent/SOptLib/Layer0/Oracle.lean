          ⟪q.2, target q.1.1 - target q.1.2⟫_ℝ) :
    ∫ ω,
        ⟪d ω,
          (G (x ω) (sample ω) - G (y ω) (sample ω)) -
            (target (x ω) - target (y ω))⟫_ℝ ∂P = 0 := by
  classical
  let query : Ω → (Z × Z) × E := fun ω => ((x ω, y ω), d ω)
  let oracleScalar : ((Z × Z) × E) × S → ℝ := fun p =>
    ⟪p.1.2, G p.1.1.1 p.2 - G p.1.1.2 p.2⟫_ℝ
