        ∫ ω in s, G (x ω) (Y ω) - g (x ω) ∂μ = 0) :
    μ[(fun ω => G (x ω) (Y ω) - g (x ω)) | m] =ᵐ[μ] 0 := by
  classical
  let δ : Ω → E := fun ω => G (x ω) (Y ω) - g (x ω)
  have hzero : (fun _ : Ω => (0 : E)) =ᵐ[μ] μ[δ | m] := by
    refine ae_eq_condExp_of_forall_setIntegral_eq
      (μ := μ) (m := m) (m₀ := mΩ) hm h_int ?hg_int ?hg_eq ?hg_meas
    · intro s _hs _hfin
