theorem integral_inner_oracle_difference_eq_inner_mean_difference
    {Ω S Z E : Type*} [MeasurableSpace Ω] [MeasurableSpace S]
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (P : Measure Ω) (Y : Ω → S) (G : Z → S → E) (target : Z → E)
    (x y : Z) (d : E)
    (hY : Measurable Y)
    (hGx_aesm : AEStronglyMeasurable (fun s : S => G x s) (Measure.map Y P))
    (hGy_aesm : AEStronglyMeasurable (fun s : S => G y s) (Measure.map Y P))
    (hx_int : Integrable (fun ω : Ω => G x (Y ω)) P)
    (hy_int : Integrable (fun ω : Ω => G y (Y ω)) P)
    (hx_mean : ∫ ω, G x (Y ω) ∂P = target x)
    (hy_mean : ∫ ω, G y (Y ω) ∂P = target y) :
    ∫ s, ⟪d, G x s - G y s⟫_ℝ ∂Measure.map Y P =
      ⟪d, target x - target y⟫_ℝ := by
  let ν : Measure S := Measure.map Y P
  have hx_int_map : Integrable (fun s : S => G x s) ν :=
    (integrable_map_measure hGx_aesm hY.aemeasurable).mpr hx_int
  have hy_int_map : Integrable (fun s : S => G y s) ν :=
    (integrable_map_measure hGy_aesm hY.aemeasurable).mpr hy_int
  have hx_mean_map : ∫ s, G x s ∂ν = target x := by
    calc
      ∫ s, G x s ∂ν = ∫ ω, G x (Y ω) ∂P := by
        exact integral_map hY.aemeasurable hGx_aesm
      _ = target x := hx_mean
  have hy_mean_map : ∫ s, G y s ∂ν = target y := by
    calc
      ∫ s, G y s ∂ν = ∫ ω, G y (Y ω) ∂P := by
        exact integral_map hY.aemeasurable hGy_aesm
      _ = target y := hy_mean
  let φ : S → E := fun s => G x s - G y s
  have hφ_int : Integrable φ ν := hx_int_map.sub hy_int_map
  have hφ_mean : ∫ s, φ s ∂ν = target x - target y := by
    dsimp [φ]
    rw [integral_sub hx_int_map hy_int_map, hx_mean_map, hy_mean_map]
  have hlin := ContinuousLinearMap.integral_comp_comm (L := (innerSL ℝ) d) hφ_int
  calc
