/-- A selected finite-block scalar majorant has an inverse-probability weighted `L¹` bound.

For scalar fiber majorants `Z i`, nonnegative radii `R i`, and positive sampling
weights `p i`, the product-law integral of the selected term
`p_{q.2}^{-1} Z_{q.2}(q.1) R_{q.2}` is bounded by the full finite sum of the
fiber bounds. The bound is intentionally law-agnostic in the selected index:
only that the index law is a probability measure is used.

Layer: Layer0 | Gap: Level 1 (finite selected-block scalar majorant integral bound)
Proof: decompose the selected term into finite singleton-index indicators for
  integrability, dominate it pointwise by the full finite block sum, integrate
  the sum through the product first-coordinate projection, and apply the fiber
  `L¹` bounds with nonnegative coefficients.
Source: Mathlib finite-sum order lemmas and product-measure Bochner integration APIs
Used in: stochastic block mirror descent scalar oracle-noise integrability and expectation majorant for the sampled block
Book citation: book/FOML/StochasticBlockMirrorDescent.json#/algorithm_spec
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for Machine Learning, stochastic block mirror descent -/
theorem selected_block_majorant_integral_le_sum_inv_prob_bound
    {S ι : Type*} [MeasurableSpace S] [MeasurableSpace ι] [Fintype ι]
    [MeasurableSingletonClass ι]
    (μ : Measure S) [SFinite μ] (ν : Measure ι) [IsProbabilityMeasure ν]
    (p : ι → ℝ) (Z : ι → S → ℝ) (R B : ι → ℝ)
    (hp_pos : ∀ i, 0 < p i)
    (hR_nonneg : ∀ i, 0 ≤ R i)
    (hZ_nonneg : ∀ i s, 0 ≤ Z i s)
    (hZ_int : ∀ i, Integrable (Z i) μ)
    (hZ_bound : ∀ i, ∫ s, Z i s ∂μ ≤ B i) :
    Integrable
        (fun q : S × ι => (p q.2)⁻¹ * Z q.2 q.1 * R q.2)
        (μ.prod ν) ∧
      ∫ q : S × ι, (p q.2)⁻¹ * Z q.2 q.1 * R q.2 ∂(μ.prod ν) ≤
        Finset.sum Finset.univ (fun i => (p i)⁻¹ * R i * B i) := by
  classical
  let T : S × ι → ℝ := fun q => (p q.2)⁻¹ * Z q.2 q.1 * R q.2
  let G : ι → S × ι → ℝ := fun i q =>
    ({r : S × ι | r.2 = i}.indicator
      (fun q => (p i)⁻¹ * Z i q.1 * R i) q)
  have hGint : ∀ i ∈ Finset.univ, Integrable (G i) (μ.prod ν) := by
    intro i _hi
    have hbaseS : Integrable (fun s => (p i)⁻¹ * Z i s * R i) μ := by
      simpa [mul_assoc, mul_comm, mul_left_comm] using
        (hZ_int i).const_mul ((p i)⁻¹ * R i)
    have hbaseProd :
        Integrable (fun q : S × ι => (p i)⁻¹ * Z i q.1 * R i) (μ.prod ν) := by
      simpa using hbaseS.comp_fst ν
    have hset : MeasurableSet ({r : S × ι | r.2 = i} : Set (S × ι)) := by
      exact measurable_snd (measurableSet_singleton i)
    exact hbaseProd.indicator hset
  have hT_int : Integrable T (μ.prod ν) := by
    have hsum : Integrable (fun q => Finset.sum Finset.univ (fun i => G i q))
        (μ.prod ν) :=
      MeasureTheory.integrable_finset_sum (s := Finset.univ) (μ := μ.prod ν) hGint
    refine hsum.congr ?_
    filter_upwards with q
    dsimp [T, G]
    symm
    rw [Finset.sum_eq_single q.2]
    · simp
    · intro j _hj hji
      have hq : q.2 ≠ j := fun h => hji h.symm
      simp [hq]
    · intro hnot
      exact False.elim (hnot (Finset.mem_univ q.2))
  let H : S × ι → ℝ := fun q =>
    Finset.sum Finset.univ (fun i => (p i)⁻¹ * Z i q.1 * R i)
  have hH_int : Integrable H (μ.prod ν) := by
    refine MeasureTheory.integrable_finset_sum
      (s := Finset.univ) (μ := μ.prod ν) ?_
    intro i _hi
    have hbaseS : Integrable (fun s => (p i)⁻¹ * Z i s * R i) μ := by
      simpa [mul_assoc, mul_comm, mul_left_comm] using
        (hZ_int i).const_mul ((p i)⁻¹ * R i)
    simpa [H] using hbaseS.comp_fst ν
  have hT_le_H : T ≤ H := by
    intro q
    dsimp [T, H]
    let F : ι → ℝ := fun i => (p i)⁻¹ * Z i q.1 * R i
    change F q.2 ≤ Finset.sum Finset.univ F
    refine Finset.single_le_sum (s := Finset.univ) (f := F) ?_ (Finset.mem_univ q.2)
    intro i _hi
    dsimp [F]
    exact mul_nonneg
      (mul_nonneg (inv_nonneg.mpr (le_of_lt (hp_pos i))) (hZ_nonneg i q.1))
      (hR_nonneg i)
  refine ⟨by simpa [T] using hT_int, ?_⟩
  have hint_le : ∫ q, T q ∂(μ.prod ν) ≤ ∫ q, H q ∂(μ.prod ν) :=
    integral_mono hT_int hH_int hT_le_H
  have hH_bound :
      ∫ q, H q ∂(μ.prod ν) ≤
        Finset.sum Finset.univ (fun i => (p i)⁻¹ * R i * B i) := by
    calc
      ∫ q, H q ∂(μ.prod ν)
          = Finset.sum Finset.univ (fun i =>
              ∫ q : S × ι, (p i)⁻¹ * Z i q.1 * R i ∂(μ.prod ν)) := by
              rw [integral_finset_sum]
              intro i _hi
              have hbaseS : Integrable (fun s => (p i)⁻¹ * Z i s * R i) μ := by
                simpa [mul_assoc, mul_comm, mul_left_comm] using
                  (hZ_int i).const_mul ((p i)⁻¹ * R i)
              simpa [H] using hbaseS.comp_fst ν
      _ ≤ Finset.sum Finset.univ (fun i => (p i)⁻¹ * R i * B i) := by
          refine Finset.sum_le_sum ?_
          intro i _hi
          have hcoeff_nonneg : 0 ≤ (p i)⁻¹ * R i :=
            mul_nonneg (inv_nonneg.mpr (le_of_lt (hp_pos i))) (hR_nonneg i)
          calc
            ∫ q : S × ι, (p i)⁻¹ * Z i q.1 * R i ∂(μ.prod ν)
                = ∫ s : S, (p i)⁻¹ * Z i s * R i ∂μ := by
                    let f : S → ℝ := fun s => (p i)⁻¹ * Z i s * R i
                    change ∫ q : S × ι, f q.1 ∂(μ.prod ν) = ∫ s : S, f s ∂μ
                    rw [MeasureTheory.integral_fun_fst (μ := μ) (ν := ν) (f := f)]
                    simp
            _ = ((p i)⁻¹ * R i) * ∫ s : S, Z i s ∂μ := by
                    let f : S → ℝ := fun s => Z i s
                    calc
                      ∫ s : S, (p i)⁻¹ * Z i s * R i ∂μ
                          = ∫ s : S, ((p i)⁻¹ * R i) * f s ∂μ := by
                              apply integral_congr_ae
                              filter_upwards with s
                              simp [f, mul_comm, mul_left_comm]
                      _ = ((p i)⁻¹ * R i) * ∫ s : S, f s ∂μ := by
                            rw [integral_const_mul]
            _ ≤ ((p i)⁻¹ * R i) * B i :=
                  mul_le_mul_of_nonneg_left (hZ_bound i) hcoeff_nonneg
            _ = (p i)⁻¹ * R i * B i := by ring
  exact hint_le.trans hH_bound

/-- A scalarized oracle deviation is bounded by sampled and mean pairing majorants.

For pointwise vector samples, if the sampled pairing and the deterministic mean
pairing against the same displacement have scalar majorants, then the scalar
oracle-noise pairing with `sample - mean` is bounded by the sum of those majorants.

