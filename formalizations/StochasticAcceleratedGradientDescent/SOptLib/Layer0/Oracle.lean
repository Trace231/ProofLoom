theorem abs_scalar_block_oracle_noise_le_sample_majorant_add_mean_bound
    {Ω E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (sample mean displacement : Ω → E) (sampleMajorant meanMajorant : Ω → ℝ)
    (hsample : ∀ ω, |⟪sample ω, displacement ω⟫_ℝ| ≤ sampleMajorant ω)
    (hmean : ∀ ω, |⟪mean ω, displacement ω⟫_ℝ| ≤ meanMajorant ω)
    (ω : Ω) :
    ‖⟪sample ω - mean ω, displacement ω⟫_ℝ - (0 : ℝ)‖ ≤
      sampleMajorant ω + meanMajorant ω := by
  have htri :
      |⟪sample ω, displacement ω⟫_ℝ - ⟪mean ω, displacement ω⟫_ℝ| ≤
        |⟪sample ω, displacement ω⟫_ℝ| + |⟪mean ω, displacement ω⟫_ℝ| := by
    simpa using abs_sub ⟪sample ω, displacement ω⟫_ℝ ⟪mean ω, displacement ω⟫_ℝ
  calc
    ‖⟪sample ω - mean ω, displacement ω⟫_ℝ - (0 : ℝ)‖
        = |⟪sample ω, displacement ω⟫_ℝ - ⟪mean ω, displacement ω⟫_ℝ| := by
          simp [inner_sub_left, Real.norm_eq_abs]
    _ ≤ |⟪sample ω, displacement ω⟫_ℝ| + |⟪mean ω, displacement ω⟫_ℝ| := htri
    _ ≤ sampleMajorant ω + meanMajorant ω := add_le_add (hsample ω) (hmean ω)

