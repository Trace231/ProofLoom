/-- The selected `Q_1(t)` satisfies the checked-source formula. -/
theorem Q1_formula (S : Setup Ξ Ζ E) (t : {n : ℕ // 1 ≤ n}) :
    S.Q1Spec t (S.Q1 t) :=
  Classical.choose_spec (S.Q1_exists t)

/-- The expected-gap regularity needed to read the Bochner integral as the
paper expectation is derived under Assumption 10 from the source setup and
stochastic recursion. The Bochner-integral boundary is only meaningful on the
probability-space regime used by Theorem 4.10. -/
theorem expectedGap_well_defined [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E] [BorelSpace E]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) [IsProbabilityMeasure μ]
    (xiLaw : Measure Ξ) (zetaLaw : Measure Ζ)
    (_hMean : S.OracleUnbiasedLaw xiLaw zetaLaw)
    (_h10 : S.Assumption10 sample μ)
    (hHistory : S.SAMPInterleavedOracleHistoryBoundary sample) (n : ℕ) :
    SOptLib.expectationWellDefined μ (S.expectedGapIntegrand sample μ n) := by
  have hbar : Measurable (fun ω => S.barSeq (sample ω) n) :=
    S.barSeq_measurable sample hHistory n
  exact (SOptLib.expectationWellDefined_iff_integrable
      (μ := μ) (Z := S.expectedGapIntegrand sample μ n)).2
    (S.expectedGapIntegrand_integrable_of_Assumption10 sample μ xiLaw zetaLaw
      _hMean _h10 n hbar)

/-- A measurable and uniformly bounded gap integrand is integrable on a finite
measure space. -/
theorem expectedGapIntegrable_of_measurable_bounded_real [MeasurableSpace Ω]
    (S : Setup Ξ Ζ E) [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) [IsFiniteMeasure μ]
    (n : ℕ) (hmeas : Measurable (S.expectedGapIntegrand sample μ n))
    (hbound : ∃ C : ℝ, ∀ ω, ‖S.expectedGapIntegrand sample μ n ω‖ ≤ C) :
    Integrable (S.expectedGapIntegrand sample μ n) μ := by
  rcases hbound with ⟨C, hC⟩
  exact integrable_of_measurable_bounded_real hmeas hC

/-- Source residual `U_t` from (4.5.45), written with the local zero-based
iteration index `i = 0, ..., t-1` and `paperTime i = i+1`. -/
private noncomputable def theorem410_Ut [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    (sample : Ω → SamplePath Ξ Ζ) (t : {n : ℕ // 1 ≤ n}) : Ω → ℝ :=
  fun ω =>
    (Finset.range t.1).sum fun i =>
      (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
          (2 * S.Gamma (paperTime i).1)) *
          S.dualNorm (S.deltaHEven (sample ω) i + S.deltaG (sample ω) i) ^ (2 : ℕ) +
        (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
          (2 * (1 - S.q) * S.Gamma (paperTime i).1)) *
          S.dualNorm (S.deltaG (sample ω) i) ^ (2 : ℕ) +
        (3 * S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
          (2 * S.Gamma (paperTime i).1)) *
          (S.dualNorm (S.deltaHEven (sample ω) i) ^ (2 : ℕ) +
            S.dualNorm (S.deltaHOdd (sample ω) i) ^ (2 : ℕ)) -
        (S.alpha (paperTime i).1 / S.Gamma (paperTime i).1) *
          ⟪S.deltaG (sample ω) i,
            (S.rSeq (sample ω) i).1 - (S.auxiliarySeq (sample ω) i).1⟫_ℝ -
        (S.alpha (paperTime i).1 / S.Gamma (paperTime i).1) *
          ⟪S.deltaHEven (sample ω) i,
            (S.firstProx (sample ω) i (S.stateProcess (sample ω) i)).1 -
              (S.auxiliarySeq (sample ω) i).1⟫_ℝ

