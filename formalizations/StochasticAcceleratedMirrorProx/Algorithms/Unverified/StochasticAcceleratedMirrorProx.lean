/-- The DGF core `X^o` from Section 3.2:
points in `X` minimizing a linear perturbation of the distance-generating
function. -/
def distanceGeneratingCore
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (X : Set E) (omega : E → ℝ) : Set E :=
  {x : E | x ∈ X ∧ ∃ p : E, IsMinOn (fun u : E => ⟪p, u⟫_ℝ + omega u) X x}

/-- Carrier-form distance-generating-function contract for the SAMP prox
geometry.  Section 3.2 places differentiability and strong convexity on the DGF
core `X^o`; the SAMP carrier `Z` itself is only the closed convex feasible set.

The Bregman gradient is not an input: below it is the canonical within-gradient
on the feasible carrier `Z` used by the displayed SAMP prox formula (4.5.10),
with compatibility against the Section 3.2 DGF core recorded as a separate proof
obligation. -/
def IsCarrierDistanceGeneratingFunction
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (X : Set E) (p : Seminorm ℝ E) (omega : E → ℝ) : Prop :=
  ConvexOn ℝ X omega ∧
    ContinuousOn omega X ∧
    Convex ℝ (distanceGeneratingCore X omega) ∧
    ContDiffOn ℝ 1 omega (distanceGeneratingCore X omega) ∧
    StrongConvexOnWithGauge (distanceGeneratingCore X omega) 1 p omega ∧
    intrinsicInterior ℝ X ⊆ distanceGeneratingCore X omega

/-- The Section 3.2 source gradient of the distance-generating function, taken
on the DGF core `X^o` rather than on the whole carrier. -/
noncomputable def dgfCoreGradient
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (X : Set E) (omega : E → ℝ)
    (z : {x : E // x ∈ distanceGeneratingCore X omega}) : E :=
  gradientWithin omega (distanceGeneratingCore X omega) z.1

/-- Domain-correct Bregman prox function generated by the Section 3.2 DGF-core
gradient.  Its base point lies in `X^o` and its endpoint lies in `X`, matching
the source type `V : X^o × X → R+` from (3.2.2). -/
noncomputable def dgfCarrierBregman
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (X : Set E) (omega : E → ℝ)
    (z : {x : E // x ∈ distanceGeneratingCore X omega}) (u : {x : E // x ∈ X}) : ℝ :=
  omega u.1 - omega z.1 - ⟪dgfCoreGradient X omega z, u.1 - z.1⟫_ℝ

/-- Algorithm 4.4's displayed carrier-wide Bregman prox function from (4.5.10):
`V(z,u) = omega(u) - omega(z) - <grad omega(z), u-z>` for all `u,z in Z`.

This is the source-facing SAMP object.  The Section 3.2 DGF-core domain is kept
separately above because the book later writes Algorithm 4.4 over all feasible
carrier points. -/
noncomputable def paperSAMPCarrierBregmanOn
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (X : Set E) (omega : E → ℝ) (_homega : DifferentiableOn ℝ omega X)
    (z u : {x : E // x ∈ X}) : ℝ :=
  SOptLib.carrierBregmanDivergence
    (X := X) (fun x : {x : E // x ∈ X} => omega x.1)
    (fun x : {x : E // x ∈ X} => gradientWithin omega X x.1) z u

/-- The SAMP prox subproblem objective from (4.5.12)-(4.5.13):
`gamma * [<eta, u - r> + J(u)] + V(r,u)`. -/
noncomputable def paperSAMPProxObjectiveOn
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (X : Set E) (omega J : E → ℝ)
    (homega : DifferentiableOn ℝ omega X)
    (r : {x : E // x ∈ X}) (eta : E) (gamma : ℝ)
    (u : {x : E // x ∈ X}) : ℝ :=
  gamma * (⟪eta, u.1 - r.1⟫_ℝ + J u.1) +
    paperSAMPCarrierBregmanOn X omega homega r u

/-- Source-facing SAMP prox-step predicate: the selected point minimizes the
displayed Algorithm 4.4 prox objective over the feasible carrier. -/
def IsSAMPProxStepOn
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (X : Set E) (omega J : E → ℝ)
    (homega : DifferentiableOn ℝ omega X)
    (r : {x : E // x ∈ X}) (eta : E) (gamma : ℝ)
    (z : {x : E // x ∈ X}) : Prop :=
  IsMinOn (paperSAMPProxObjectiveOn X omega J homega r eta gamma) Set.univ z

/-- Paper-level setup for the stochastic accelerated mirror-prox method.

The fields are the stated problem data and assumptions from Section 4.5:
the finite-dimensional feasible carrier `Z`, stochastic oracle kernels `Gsample`
and `Hsample`, their mean representatives, the simple convex term `J`, the
distance-generating potential `omega`, schedules, constants, and the
source-facing scalar side conditions.  Algorithmic objects such as `w_t`,
`r_t`, `bar w_t`, and the Bregman prox kernel `V` are defined below from this
data rather than stored here as witnesses. -/
structure Setup (Ξ Ζ E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] where
  Z : Set E
  Z_nonempty : Z.Nonempty
  Z_closed : IsClosed Z
  Z_convex : Convex ℝ Z
  primalSeminorm : Seminorm ℝ E
  primalSeminorm_separating : primalSeminorm.IsSeparating
  Gsample : E → Ξ → E
  Hsample : E → Ζ → E
  Gvalue : E → ℝ
  gradG : E → E
  Hmean : E → E
  J : E → ℝ
  Jsubgrad : E → E
  J_simple : SOptLib.IsSimpleConvexTermOn Z J
  Jsubgrad_mem :
    ∀ u : {z : E // z ∈ Z},
      Jsubgrad u.1 ∈
        SOptLib.carrierSubdifferential
          (X := Z) (fun z : {z : E // z ∈ Z} => J z.1) u
  omega : E → ℝ
  omega_dgf : IsCarrierDistanceGeneratingFunction Z primalSeminorm omega
  omega_differentiableOn_Z : DifferentiableOn ℝ omega Z
  alpha : ℕ → ℝ
  gamma : ℕ → ℝ
  gamma_pos : ∀ t : {n : ℕ // 1 ≤ n}, 0 < gamma t.1
  prox_solvable :
    ∀ t : {n : ℕ // 1 ≤ n}, ∀ r : {z : E // z ∈ Z}, ∀ eta : E,
      ∃ z : {z : E // z ∈ Z},
        IsSAMPProxStepOn Z omega J omega_differentiableOn_Z r eta (gamma t.1) z
  q : ℝ
  L : ℝ
  M : ℝ
  sigmaG : ℝ
  sigmaH : ℝ
  sigmaG_nonneg : 0 ≤ sigmaG
  sigmaH_nonneg : 0 ≤ sigmaH
  DZ : ℝ
  DZ_nonneg : 0 ≤ DZ
  uStar : E
  uStar_mem : uStar ∈ Z
  r₁ : E
  r₁_mem : r₁ ∈ Z
  H_monotone : ∀ ⦃w v : E⦄, w ∈ Z → v ∈ Z → 0 ≤ ⟪Hmean w - Hmean v, w - v⟫_ℝ
  H_lipschitz :
    ∀ ⦃w v : E⦄, w ∈ Z → v ∈ Z →
      SOptLib.canonicalDualNorm primalSeminorm (Hmean w - Hmean v) ≤
        M * primalSeminorm (w - v)
  G_convex_smooth :
    ∀ ⦃w v : E⦄, w ∈ Z → v ∈ Z →
      0 ≤ Gvalue w - Gvalue v - ⟪gradG v, w - v⟫_ℝ ∧
        Gvalue w - Gvalue v - ⟪gradG v, w - v⟫_ℝ ≤
          (L / 2) * primalSeminorm (w - v) ^ 2
  alpha_range : ∀ t : {n : ℕ // 1 ≤ n}, alpha t.1 ∈ Set.Icc (0 : ℝ) 1
  alpha_one : alpha 1 = 1
  q_mem : q ∈ Set.Ioo (0 : ℝ) 1
  parameter_condition :
    ∀ t : {n : ℕ // 1 ≤ n}, 0 ≤ q - L * alpha t.1 * gamma t.1 - 3 * M ^ 2 * gamma t.1 ^ 2
  gamma_ratio_mono :
    ∀ t : {n : ℕ // 1 ≤ n},
      ∃ rho_t rho_next : ℝ,
        SOptLib.checked_quotient_spec
          (alpha t.1) (SOptLib.acceleratedGammaSchedule alpha t * gamma t.1) rho_t ∧
        SOptLib.checked_quotient_spec
          (alpha (t.1 + 1))
          (SOptLib.acceleratedGammaSchedule alpha
            ⟨t.1 + 1, Nat.succ_le_succ (Nat.zero_le t.1)⟩ * gamma (t.1 + 1))
          rho_next ∧
        rho_t ≤ rho_next
  bounded_bregman_diameter :
    ∀ z₁ z₂ : {z : E // z ∈ Z},
      paperSAMPCarrierBregmanOn Z omega omega_differentiableOn_Z z₁ z₂ ≤ DZ ^ 2
  weak_solution_property :
    ∀ ⦃u : E⦄, u ∈ Z →
      ⟪gradG u + Hmean u + Jsubgrad u, uStar - u⟫_ℝ ≤ 0

namespace Setup

variable {Ξ Ζ E Ω : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E]

/-- The feasible carrier subtype of the SVI set `Z`. -/
abbrev Point (S : Setup Ξ Ζ E) : Type _ := {z : E // z ∈ S.Z}

/-- The paper's primal norm, represented as a Mathlib seminorm datum so that
the associated dual norm can be constructed canonically. -/
def primalNorm (S : Setup Ξ Ζ E) (x : E) : ℝ :=
  S.primalSeminorm x

/-- The canonical dual norm `||.||_*` associated with the paper primal norm. -/
noncomputable def dualNorm (S : Setup Ξ Ζ E) (x : E) : ℝ :=
  SOptLib.canonicalDualNorm S.primalSeminorm x

/-- The defining support-function formula for the paper dual norm. -/
theorem dualNorm_eq_canonicalDualNorm (S : Setup Ξ Ζ E) (x : E) :
    S.dualNorm x = SOptLib.canonicalDualNorm S.primalSeminorm x := by
  rfl

/-- The paper dual norm is even, by reduction to the canonical support-function dual norm. -/
theorem dualNorm_neg (S : Setup Ξ Ζ E) (x : E) :
    S.dualNorm (-x) = S.dualNorm x := by
  change SOptLib.canonicalDualNorm S.primalSeminorm (-x) =
    SOptLib.canonicalDualNorm S.primalSeminorm x
  exact SOptLib.canonicalDualNorm_neg S.primalSeminorm x

/-- The paper primal norm is nondegenerate. -/
theorem primalNorm_eq_zero_iff (S : Setup Ξ Ζ E) (x : E) :
    S.primalNorm x = 0 ↔ x = 0 :=
  S.primalSeminorm_separating x

/-- The paper's simple convex term is convex on the feasible carrier. -/
theorem J_convexOn (S : Setup Ξ Ζ E) :
    ConvexOn ℝ S.Z S.J :=
  S.J_simple.convex

/-- The paper's structurally simple convex term is continuous on the feasible carrier. -/
theorem J_continuousOn (S : Setup Ξ Ζ E) :
    ContinuousOn S.J S.Z :=
  S.J_simple.continuousOn

/-- The carrier restriction of the simple convex term is measurable. -/
theorem J_carrier_measurable (S : Setup Ξ Ζ E) [MeasurableSpace E] [BorelSpace E] :
    Measurable (fun z : S.Point => S.J z.1) :=
  S.J_simple.carrier_measurable

/-- The selected `J'(u)` belongs to the carrier subdifferential of `J` at `u`. -/
theorem Jsubgrad_mem_carrierSubdifferential (S : Setup Ξ Ζ E) (u : S.Point) :
    S.Jsubgrad u.1 ∈
      SOptLib.carrierSubdifferential
        (X := S.Z) (fun z : S.Point => S.J z.1) u :=
  S.Jsubgrad_mem u

/-- The distance-generating potential is convex on the feasible carrier. -/
theorem omega_convexOn (S : Setup Ξ Ζ E) :
    ConvexOn ℝ S.Z S.omega :=
  S.omega_dgf.1

/-- The distance-generating potential is continuous on the feasible carrier. -/
theorem omega_continuousOn (S : Setup Ξ Ζ E) :
    ContinuousOn S.omega S.Z :=
  S.omega_dgf.2.1

/-- The DGF core `Z^o` associated with the paper potential. -/
def dgfCore (S : Setup Ξ Ζ E) : Set E :=
  distanceGeneratingCore S.Z S.omega

/-- Section 3.2 base points for the DGF-core prox function `V : Z^o × Z → R+`. -/
abbrev DGFBase (S : Setup Ξ Ζ E) : Type _ := {z : E // z ∈ S.dgfCore}

/-- The paper's DGF core is convex. -/
theorem dgfCore_convex (S : Setup Ξ Ζ E) :
    Convex ℝ S.dgfCore :=
  S.omega_dgf.2.2.1

/-- Source-derived boundary fact from Section 3.2: the DGF core contains the
relative/intrinsic interior of the carrier. -/
theorem intrinsicInterior_subset_dgfCore (S : Setup Ξ Ζ E) :
    intrinsicInterior ℝ S.Z ⊆ S.dgfCore :=
  S.omega_dgf.2.2.2.2.2

/-- The distance-generating potential is continuously differentiable on `Z^o`. -/
theorem omega_contDiffOn_dgfCore (S : Setup Ξ Ζ E) :
    ContDiffOn ℝ 1 S.omega S.dgfCore :=
  S.omega_dgf.2.2.2.1

/-- The distance-generating potential is one-strongly convex on `Z^o` with
respect to the paper norm. -/
theorem omega_strongConvexOn_dgfCore (S : Setup Ξ Ζ E) :
    StrongConvexOnWithGauge S.dgfCore 1 S.primalSeminorm S.omega :=
  S.omega_dgf.2.2.2.2.1

/-- Algorithm 4.4 writes `∇ω(z)` for every feasible prox center `z ∈ Z`.
This source-facing boundary prevents Mathlib's total `gradientWithin` from
being the hidden meaning of the displayed carrier-wide gradient. -/
theorem omega_differentiableOn_carrier (S : Setup Ξ Ζ E) :
    DifferentiableOn ℝ S.omega S.Z :=
  S.omega_differentiableOn_Z

/-- Canonical carrier restriction of the paper DGF. -/
def omegaOnCarrier (S : Setup Ξ Ζ E) (z : S.Point) : ℝ :=
  S.omega z.1

/-- The Algorithm 4.4 carrier gradient used in (4.5.10), represented by
Mathlib's within-gradient on the feasible carrier `Z`. -/
noncomputable def gradOmega (S : Setup Ξ Ζ E) (z : S.Point) : E :=
  gradientWithin S.omega S.Z z.1

/-- Definitional bridge identifying the SAMP gradient with the carrier
within-gradient displayed in (4.5.10). -/
theorem gradOmega_eq_gradientWithin_Z (S : Setup Ξ Ζ E) (z : S.Point) :
    S.gradOmega z = gradientWithin S.omega S.Z z.1 := by
  rfl

/-- The displayed all-carrier gradient in (4.5.10) is backed by
differentiability of `ω` at each feasible base point. -/
theorem gradOmega_source_defined (S : Setup Ξ Ζ E) (z : S.Point) :
    DifferentiableWithinAt ℝ S.omega S.Z z.1 :=
  S.omega_differentiableOn_carrier z.1 z.2

/-- A DGF-core base point is also a feasible carrier point by definition of
`Z^o`. -/
def dgfBasePoint (S : Setup Ξ Ζ E) (z : S.DGFBase) : S.Point :=
  ⟨z.1, z.2.1⟩

/-- Canonical carrier Bregman divergence generated by `omega` and its
within-gradient on the feasible carrier, matching (4.5.10). -/
noncomputable def carrierBregman (S : Setup Ξ Ζ E) (z u : S.Point) : ℝ :=
  paperSAMPCarrierBregmanOn S.Z S.omega S.omega_differentiableOn_Z z u

/-- The Bregman prox function `V(z,u)` generated by the paper's
distance-generating function `omega` on the Algorithm 4.4 carrier `Z × Z`. -/
noncomputable def V (S : Setup Ξ Ζ E) (z u : S.Point) : ℝ :=
  S.carrierBregman z u

/-- On its source domain, `V` is exactly the carrier Bregman divergence generated
by `omega` and the carrier within-gradient at the base point. -/
theorem V_eq_carrierBregman (S : Setup Ξ Ζ E) (z u : S.Point) :
    S.V z u = S.carrierBregman z u := by
  rfl

/-- Restrict the DGF-core strong-convexity contract to the intrinsic interior of
the carrier. -/
theorem intrinsic_interior_strong_convexity_from_dgf_core (S : Setup Ξ Ζ E) :
    StrongConvexOnWithGauge (intrinsicInterior ℝ S.Z) 1 S.primalSeminorm S.omega := by
  intro x hx y hy a b ha hb hab
  exact S.omega_strongConvexOn_dgfCore
    (S.intrinsicInterior_subset_dgfCore hx)
    (S.intrinsicInterior_subset_dgfCore hy)
    ha hb hab

/-- Source-derived closure step behind the all-carrier notation in (4.5.26):
the Section 3.2 strong-convexity inequality on the DGF core extends from the
dense intrinsic interior to all feasible carrier points. -/
theorem omega_strongConvexOn_carrier_from_dgf_core (S : Setup Ξ Ζ E) :
    StrongConvexOnWithGauge S.Z 1 S.primalSeminorm S.omega := by
  intro x hx y hy a b ha hb hab
  let U : Set S.Point := {z | (z : E) ∈ intrinsicInterior ℝ S.Z}
  let R : S.Point × S.Point → ℝ := fun p =>
    a * S.omega p.1.1 + b * S.omega p.2.1 -
      S.omega (a • p.1.1 + b • p.2.1) -
        (1 / 2 : ℝ) * a * b * (S.primalSeminorm (p.1.1 - p.2.1)) ^ 2
  have hU_dense : Dense U := by
    exact dense_subtype_of_subset_closure
      (X := S.Z) (U := intrinsicInterior ℝ S.Z)
      intrinsicInterior_subset
      (subset_closure_intrinsicInterior_of_nonempty_convex S.Z_convex S.Z_nonempty)
  have hpair_dense : Dense {p : S.Point × S.Point | p.1 ∈ U ∧ p.2 ∈ U} := by
    simpa [Set.prod, U] using hU_dense.prod hU_dense
  have homega_subtype : Continuous (fun z : S.Point => S.omega z.1) := by
    exact continuous_subtype_of_continuousOn_ambient
      (X := S.Z) (f := fun z : S.Point => S.omega z.1) (F := S.omega)
      S.omega_continuousOn (by intro z; rfl)
  have hcomb_cont :
      Continuous (fun p : S.Point × S.Point => a • (p.1 : E) + b • (p.2 : E)) := by
    exact
      (continuous_const.smul (continuous_subtype_val.comp continuous_fst)).add
        (continuous_const.smul (continuous_subtype_val.comp continuous_snd))
  have hcomb_maps :
      Set.MapsTo (fun p : S.Point × S.Point => a • (p.1 : E) + b • (p.2 : E))
        Set.univ S.Z := by
    intro p hp
    exact S.Z_convex p.1.2 p.2.2 ha hb hab
  have hR_cont : ContinuousOn R Set.univ := by
    have h1 : ContinuousOn (fun p : S.Point × S.Point => S.omega p.1.1) Set.univ :=
      (homega_subtype.comp continuous_fst).continuousOn
    have h2 : ContinuousOn (fun p : S.Point × S.Point => S.omega p.2.1) Set.univ :=
      (homega_subtype.comp continuous_snd).continuousOn
    have h3 : ContinuousOn
        (fun p : S.Point × S.Point => S.omega (a • p.1.1 + b • p.2.1)) Set.univ :=
      S.omega_continuousOn.comp hcomb_cont.continuousOn hcomb_maps
    have h4 : ContinuousOn
        (fun p : S.Point × S.Point => S.primalSeminorm (p.1.1 - p.2.1)) Set.univ :=
      ((S.primalSeminorm.continuous_of_finiteDimensional.comp
        ((continuous_subtype_val.comp continuous_fst).sub
          (continuous_subtype_val.comp continuous_snd)))).continuousOn
    simpa [R, mul_assoc, sub_eq_add_neg] using
      (((continuousOn_const.mul h1).add (continuousOn_const.mul h2)).sub h3).sub
        (((continuousOn_const.mul continuousOn_const).mul continuousOn_const).mul (h4.pow 2))
  have hR_nonneg_all : ∀ p : S.Point × S.Point, 0 ≤ R p := by
    exact nonneg_of_continuousOn_of_dense_nonneg R
      {p : S.Point × S.Point | p.1 ∈ U ∧ p.2 ∈ U} hR_cont hpair_dense
      (by
        intro p hp
        have hp1 : (p.1 : E) ∈ intrinsicInterior ℝ S.Z := by
          simpa [U] using hp.1
        have hp2 : (p.2 : E) ∈ intrinsicInterior ℝ S.Z := by
          simpa [U] using hp.2
        have hineq :=
          S.intrinsic_interior_strong_convexity_from_dgf_core
            hp1 hp2 ha hb hab
        simpa [R, sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using
          (sub_nonneg.mpr hineq))
  have hR_nonneg : 0 ≤ R (⟨x, hx⟩, ⟨y, hy⟩) := hR_nonneg_all _ 
  have hR_nonneg' :
      0 ≤ a * S.omega x + b * S.omega y -
        S.omega (a • x + b • y) -
          (1 / 2 : ℝ) * a * b * S.primalSeminorm (x - y) ^ 2 := by
    simpa [R, sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using hR_nonneg
  have hgoal :
      S.omega (a • x + b • y) ≤
    a * S.omega x + b * S.omega y -
      1 / 2 * a * b * S.primalSeminorm (x - y) ^ 2 := by
    nlinarith [hR_nonneg']
  simpa [R] using hgoal

/-- Definitional expansion of the paper Bregman prox function on `Z`. -/
theorem V_formula (S : Setup Ξ Ζ E) (z u : S.Point) :
    S.V z u =
      S.omega u.1 - S.omega z.1 - ⟪S.gradOmega z, u.1 - z.1⟫_ℝ := by
  rfl

/-- The modulus-one lower bound for the SAMP Bregman prox function, stated in
the all-carrier form used in (4.5.26).  Its proof must bridge the Section 3.2
`X^o × X` DGF lower bound to the Algorithm 4.4 carrier-wide prox notation. -/
theorem half_primalNorm_sq_le_V (S : Setup Ξ Ζ E) (z u : S.Point) :
    (1 / 2 : ℝ) * S.primalNorm (z.1 - u.1) ^ 2 ≤ S.V z u := by
  have hlower :
      (1 / 2 : ℝ) * S.primalSeminorm (u.1 - z.1) ^ 2 ≤
        S.omega u.1 -
          (S.omega z.1 + ⟪gradientWithin S.omega S.Z z.1, u.1 - z.1⟫_ℝ) := by
    exact bregman_lower_bound_of_strongConvexOnWithSeminorm_differentiableWithinAt
      (X := S.Z) (ν := S.omega) (p := S.primalSeminorm)
      (z := z.1) (x := u.1)
      S.Z_convex (S.gradOmega_source_defined z)
      S.omega_strongConvexOn_carrier_from_dgf_core z.2 u.2
  have hnorm : S.primalNorm (z.1 - u.1) = S.primalSeminorm (u.1 - z.1) := by
    calc
      S.primalNorm (z.1 - u.1) = S.primalSeminorm (z.1 - u.1) := rfl
      _ = S.primalSeminorm (-(u.1 - z.1)) := by
        congr 1
        abel
      _ = S.primalSeminorm (u.1 - z.1) := by
        rw [map_neg_eq_map]
  have hV :
      S.V z u =
        S.omega u.1 - S.omega z.1 -
          ⟪gradientWithin S.omega S.Z z.1, u.1 - z.1⟫_ℝ := by
    simpa [V, carrierBregman, paperSAMPCarrierBregmanOn] using
      (carrierBregmanDivergence_def
        (v := fun x : S.Point => S.omega x.1)
        (grad := fun x : S.Point => gradientWithin S.omega S.Z x.1)
        (x := z) (z := u))
  rw [hnorm, hV]
  nlinarith

/-- The bounded-diameter assumption (4.5.36) stated for the canonical
Algorithm 4.4 Bregman prox function on `Z × Z`. -/
theorem V_le_diameter (S : Setup Ξ Ζ E) (z u : S.Point) :
    S.V z u ≤ S.DZ ^ 2 := by
  exact S.bounded_bregman_diameter z u

/-- Assumption 10 states that the oracle standard-deviation constants are
nonnegative. -/
theorem sigmaG_nonnegative (S : Setup Ξ Ζ E) : 0 ≤ S.sigmaG :=
  S.sigmaG_nonneg

/-- Assumption 10 states that the oracle standard-deviation constants are
nonnegative. -/
theorem sigmaH_nonnegative (S : Setup Ξ Ζ E) : 0 ≤ S.sigmaH :=
  S.sigmaH_nonneg

/-- Theorem 4.10 uses `D_Z` as a diameter scale in the linear
high-probability term `Q_1(t)`, not only through the squared bound `D_Z^2`. -/
theorem DZ_nonnegative (S : Setup Ξ Ζ E) : 0 ≤ S.DZ :=
  S.DZ_nonneg

/-- The fixed weak solution `u*` of the source SVI problem. -/
def weakSolution (S : Setup Ξ Ζ E) : S.Point :=
  ⟨S.uStar, S.uStar_mem⟩

/-- The sampled SVI operator from (4.5.2):
`F(u; xi, zeta) = G(u; xi) + H(u; zeta) + J'(u)`. -/
def sampleOperator (S : Setup Ξ Ζ E) (u : E) (xi : Ξ) (zeta : Ζ) : E :=
  S.Gsample u xi + S.Hsample u zeta + S.Jsubgrad u

/-- Definitional expansion of the paper sampled operator `F(u; xi, zeta)`. -/
theorem sampleOperator_decomposition (S : Setup Ξ Ζ E) (u : E) (xi : Ξ) (zeta : Ζ) :
    S.sampleOperator u xi zeta = S.Gsample u xi + S.Hsample u zeta + S.Jsubgrad u := by
  rfl

/-- The deterministic mean SVI operator from (4.5.5):
`F(u) = grad G(u) + H(u) + J'(u)`. -/
def meanOperator (S : Setup Ξ Ζ E) (u : E) : E :=
  S.gradG u + S.Hmean u + S.Jsubgrad u

/-- Definitional expansion of the paper mean operator `F(u)`. -/
theorem meanOperator_formula (S : Setup Ξ Ζ E) (u : E) :
    S.meanOperator u = S.gradG u + S.Hmean u + S.Jsubgrad u := by
  rfl

/-- Canonical fixed-query mean of the sampled `G` oracle under a sample law. -/
noncomputable def GmeanFromLaw [MeasurableSpace Ξ] (S : Setup Ξ Ζ E)
    (xiLaw : Measure Ξ) (u : S.Point) : E :=
  SOptLib.oracleMean xiLaw (fun v : S.Point => fun xi => S.Gsample v.1 xi) id u

/-- Canonical fixed-query mean of the sampled `H` oracle under a sample law. -/
noncomputable def HmeanFromLaw [MeasurableSpace Ζ] (S : Setup Ξ Ζ E)
    (zetaLaw : Measure Ζ) (u : S.Point) : E :=
  SOptLib.oracleMean zetaLaw (fun v : S.Point => fun zeta => S.Hsample v.1 zeta) id u

/-- Law-realized version of the paper mean operator, before applying the
unbiasedness assumptions identifying the two oracle means with `grad G` and
`H`. -/
noncomputable def meanOperatorFromLaws [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (S : Setup Ξ Ζ E) (xiLaw : Measure Ξ) (zetaLaw : Measure Ζ) (u : S.Point) : E :=
  S.GmeanFromLaw xiLaw u + S.HmeanFromLaw zetaLaw u + S.Jsubgrad u.1

/-- The weak SVI solution inequality (4.5.1) for the fixed source point `u*`. -/
theorem weakSolution_property (S : Setup Ξ Ζ E) (u : S.Point) :
    ⟪S.meanOperator u.1, S.weakSolution.1 - u.1⟫_ℝ ≤ 0 := by
  simpa [meanOperator] using
  S.weak_solution_property u.2

/-- A sample path supplies the two independent oracle streams used by SAMP. -/
structure SamplePath (Ξ Ζ : Type*) where
  xi : ℕ → Ξ
  zeta : ℕ → Ζ

/-- The sample-path measurable space is generated by the two oracle streams. -/
@[reducible]
def samplePathMeasurableSpace [MeasurableSpace Ξ] [MeasurableSpace Ζ] :
    MeasurableSpace (SamplePath Ξ Ζ) :=
  MeasurableSpace.comap (fun p : SamplePath Ξ Ζ => p.xi) inferInstance ⊔
    MeasurableSpace.comap (fun p : SamplePath Ξ Ζ => p.zeta) inferInstance

instance [MeasurableSpace Ξ] [MeasurableSpace Ζ] :
    MeasurableSpace (SamplePath Ξ Ζ) :=
  samplePathMeasurableSpace

@[simp]
theorem samplePathMeasurableSpace_def [MeasurableSpace Ξ] [MeasurableSpace Ζ] :
    (samplePathMeasurableSpace (Ξ := Ξ) (Ζ := Ζ) :
      MeasurableSpace (SamplePath Ξ Ζ)) =
      MeasurableSpace.comap (fun p : SamplePath Ξ Ζ => p.xi) inferInstance ⊔
        MeasurableSpace.comap (fun p : SamplePath Ξ Ζ => p.zeta) inferInstance := by
  rfl

/-- The first sample-path coordinate stream is measurable for the generated
sample-path sigma-algebra. -/
theorem samplePath_xi_measurable [MeasurableSpace Ξ] [MeasurableSpace Ζ] :
    Measurable (fun p : SamplePath Ξ Ζ => p.xi) := by
  exact Measurable.of_comap_le le_sup_left

/-- The second sample-path coordinate stream is measurable for the generated
sample-path sigma-algebra. -/
theorem samplePath_zeta_measurable [MeasurableSpace Ξ] [MeasurableSpace Ζ] :
    Measurable (fun p : SamplePath Ξ Ζ => p.zeta) := by
  exact Measurable.of_comap_le le_sup_right

/-- Coordinatewise measurability of a sample path implies measurability of the
whole sample-path map. -/
theorem samplePath_measurable_of_coordinates [MeasurableSpace Ω]
    [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ)
    (hxi : Measurable (fun ω => (sample ω).xi))
    (hzeta : Measurable (fun ω => (sample ω).zeta)) :
    Measurable sample := by
  refine Measurable.of_comap_le ?_
  change MeasurableSpace.comap sample
      (samplePathMeasurableSpace (Ξ := Ξ) (Ζ := Ζ)) ≤ (inferInstance : MeasurableSpace Ω)
  rw [samplePathMeasurableSpace_def, MeasurableSpace.comap_sup]
  exact sup_le
    (by simpa [MeasurableSpace.comap_comp] using hxi.comap_le)
    (by simpa [MeasurableSpace.comap_comp] using hzeta.comap_le)

/-- Positive paper time `t = n + 1` attached to a zero-based recursion index. -/
def paperTime (n : ℕ) : {t : ℕ // 1 ≤ t} :=
  ⟨n + 1, Nat.succ_le_succ (Nat.zero_le n)⟩

/-- Canonical positive-time `Gamma_t` schedule from (4.5.17), with a harmless
zero-time totalization for Lean formulas that use natural-number indices. -/
def Gamma (S : Setup Ξ Ζ E) (t : ℕ) : ℝ :=
  if ht : 1 ≤ t then SOptLib.acceleratedGammaSchedule S.alpha ⟨t, ht⟩ else 1

@[simp]
theorem Gamma_one (S : Setup Ξ Ζ E) :
    S.Gamma 1 = 1 := by
  simp [Gamma]

/-- On positive paper times, the local notation is exactly SOptLib's canonical
accelerated Gamma schedule. -/
theorem Gamma_eq_acceleratedGammaSchedule (S : Setup Ξ Ζ E) (t : {n : ℕ // 1 ≤ n}) :
    S.Gamma t.1 = SOptLib.acceleratedGammaSchedule S.alpha t := by
  simp [Gamma, t.2]

/-- The canonical `Gamma_t` schedule satisfies the paper recurrence for `t>1`. -/
theorem Gamma_succ (S : Setup Ξ Ζ E) ⦃t : ℕ⦄ (ht : 1 < t) :
    S.Gamma t = (1 - S.alpha t) * S.Gamma (t - 1) := by
  cases t with
  | zero =>
      omega
  | succ t =>
      cases t with
      | zero =>
          omega
      | succ t =>
          rfl

/-- The parameter monotonicity condition rewritten through the local `Gamma`
notation used in Theorem 4.10, retaining the denominator witnesses for the two
displayed quotients. -/
theorem gamma_ratio_mono_with_Gamma (S : Setup Ξ Ζ E) (t : {n : ℕ // 1 ≤ n}) :
    ∃ rho_t rho_next : ℝ,
      SOptLib.checked_quotient_spec
        (S.alpha t.1) (S.Gamma t.1 * S.gamma t.1) rho_t ∧
      SOptLib.checked_quotient_spec
        (S.alpha (t.1 + 1))
        (S.Gamma (t.1 + 1) * S.gamma (t.1 + 1)) rho_next ∧
      rho_t ≤ rho_next := by
  simpa [Gamma, t.2] using S.gamma_ratio_mono t

/-- The source stepsize sequence `gamma_t` is positive on paper times. -/
theorem gamma_positive (S : Setup Ξ Ζ E) (t : {n : ℕ // 1 ≤ n}) :
    0 < S.gamma t.1 :=
  S.gamma_pos t

/-- The canonical accelerated `Gamma_t` weights are positive on paper times.

The proof combines the printed `alpha_t in [0,1]` range with the checked
quotient denominators in the parameter monotonicity condition; the new
`gamma_pos` stepsize boundary separates Gamma nonzeroness from the product
denominator. -/
theorem Gamma_pos (S : Setup Ξ Ζ E) (t : {n : ℕ // 1 ≤ n}) :
    0 < S.Gamma t.1 := by
  let GammaPos : {n : ℕ // 1 ≤ n} → ℝ := fun τ => S.Gamma τ.1
  have hGamma_one : GammaPos ⟨1, le_rfl⟩ = 1 := by
    simp [GammaPos]
  have hGamma_succ :
      ∀ (n : ℕ) (hn : 1 ≤ n),
        GammaPos ⟨n + 1, Nat.succ_le_succ (Nat.zero_le n)⟩ =
          (1 - S.alpha (n + 1)) * GammaPos ⟨n, hn⟩ := by
    intro n hn
    have hlt : 1 < n + 1 := Nat.lt_add_one_of_le hn
    simpa [GammaPos, Nat.add_sub_cancel] using
      (S.Gamma_succ (t := n + 1) hlt)
  have hGamma_ne : ∀ τ : {n : ℕ // 1 ≤ n}, GammaPos τ ≠ 0 := by
    intro τ hzero
    rcases S.gamma_ratio_mono_with_Gamma τ with ⟨rho_t, rho_next, hqt, _hqn, _hle⟩
    exact hqt.1 (by simp [GammaPos, hzero])
  have hpos :
      ∀ τ : {n : ℕ // 1 ≤ n}, 0 < GammaPos τ :=
    SOptLib.acceleratedGamma_pos_of_mem_Icc_and_ne_zero
      S.alpha GammaPos hGamma_one hGamma_succ S.alpha_range hGamma_ne
  simpa [GammaPos] using hpos t

/-- Raw square-noise weights `alpha_i * gamma_i / Gamma_i` are nonnegative on
zero-based horizons corresponding to positive paper times. -/
theorem weightedSquareWeight_nonneg (S : Setup Ξ Ζ E) (i : ℕ) :
    0 ≤ S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
        S.Gamma (paperTime i).1 := by
  have halpha : 0 ≤ S.alpha (paperTime i).1 :=
    (Set.mem_Icc.mp (S.alpha_range (paperTime i))).1
  have hgamma : 0 ≤ S.gamma (paperTime i).1 :=
    le_of_lt (S.gamma_pos (paperTime i))
  have hnum : 0 ≤ S.alpha (paperTime i).1 * S.gamma (paperTime i).1 :=
    mul_nonneg halpha hgamma
  exact div_nonneg hnum (le_of_lt (S.Gamma_pos (paperTime i)))

/-- The first raw square-noise weight is strictly positive, so every nonempty
paper horizon has positive total mass. -/
theorem weightedSquareWeight_zero_pos (S : Setup Ξ Ζ E) :
    0 < S.alpha (paperTime 0).1 * S.gamma (paperTime 0).1 /
        S.Gamma (paperTime 0).1 := by
  have hgamma : 0 < S.gamma 1 := S.gamma_pos ⟨1, le_rfl⟩
  simpa [paperTime, S.alpha_one, S.Gamma_one] using hgamma

/-- Finite-horizon raw square-noise weights are nonnegative on the source
window `i = 0, ..., t-1`. -/
theorem weightedSquareWeights_nonneg (S : Setup Ξ Ζ E) (t : {n : ℕ // 1 ≤ n}) :
    ∀ i ∈ Finset.range t.1,
      0 ≤ S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
        S.Gamma (paperTime i).1 := by
  intro i _hi
  exact S.weightedSquareWeight_nonneg i

/-- The finite source weight mass `S = sum_i alpha_i gamma_i / Gamma_i` is
strictly positive on every positive horizon. -/
theorem weightedSquareWeights_sum_pos (S : Setup Ξ Ζ E) (t : {n : ℕ // 1 ≤ n}) :
    0 < (Finset.range t.1).sum
      (fun i => S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
        S.Gamma (paperTime i).1) := by
  refine Finset.sum_pos' (S.weightedSquareWeights_nonneg t) ?_
  refine ⟨0, ?_, S.weightedSquareWeight_zero_pos⟩
  exact Finset.mem_range.mpr t.2

/-- Normalized square-noise weights are nonnegative, as required by finite
Jensen for the exponential function. -/
theorem weightedSquareNormalizedWeights_nonneg (S : Setup Ξ Ζ E)
    (t : {n : ℕ // 1 ≤ n}) :
    ∀ i ∈ Finset.range t.1,
      0 ≤
        (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
          S.Gamma (paperTime i).1) /
          ((Finset.range t.1).sum
            (fun j => S.alpha (paperTime j).1 * S.gamma (paperTime j).1 /
              S.Gamma (paperTime j).1)) := by
  intro i hi
  exact div_nonneg (S.weightedSquareWeight_nonneg i)
    (le_of_lt (S.weightedSquareWeights_sum_pos t))

/-- Normalized square-noise weights sum to one on every positive horizon. -/
theorem weightedSquareNormalizedWeights_sum (S : Setup Ξ Ζ E)
    (t : {n : ℕ // 1 ≤ n}) :
    (Finset.range t.1).sum
      (fun i =>
        (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
          S.Gamma (paperTime i).1) /
          ((Finset.range t.1).sum
            (fun j => S.alpha (paperTime j).1 * S.gamma (paperTime j).1 /
              S.Gamma (paperTime j).1))) = 1 := by
  let weight : ℕ → ℝ := fun i =>
    S.alpha (paperTime i).1 * S.gamma (paperTime i).1 / S.Gamma (paperTime i).1
  have hsum_pos : 0 < (Finset.range t.1).sum weight := by
    simpa [weight] using S.weightedSquareWeights_sum_pos t
  have hsum :
      (Finset.range t.1).sum
        (fun i => weight i / (Finset.range t.1).sum weight) = 1 := by
    simpa using
      (Finset.sum_div_sum_eq_one (s := Finset.range t.1) (w := weight)
        ((Finset.range t.1).sum weight) rfl (ne_of_gt hsum_pos))
  simpa [weight] using hsum

/-- Initial state `r_1 = w_1 = bar w_1` from Algorithm 4.4, as a feasible point. -/
def initialPoint (S : Setup Ξ Ζ E) : S.Point :=
  ⟨S.r₁, S.r₁_mem⟩

/-- SAMP state storing the two recursive carrier-valued sequences exactly as in
Algorithm 4.4.  The search sequence `w_t` is a derived object. -/
structure State (S : Setup Ξ Ζ E) where
  r : S.Point
  bar : S.Point

/-- The recursive state measurable space is generated by the two carrier
coordinates of the state. -/
@[reducible]
def stateMeasurableSpace (S : Setup Ξ Ζ E) [MeasurableSpace E] :
    MeasurableSpace S.State :=
  MeasurableSpace.comap (fun s : S.State => s.r) inferInstance ⊔
    MeasurableSpace.comap (fun s : S.State => s.bar) inferInstance

instance (S : Setup Ξ Ζ E) [MeasurableSpace E] :
    MeasurableSpace S.State :=
  stateMeasurableSpace S

@[simp]
theorem stateMeasurableSpace_def (S : Setup Ξ Ζ E) [MeasurableSpace E] :
    (stateMeasurableSpace S :
      MeasurableSpace S.State) =
      MeasurableSpace.comap (fun s : S.State => s.r) inferInstance ⊔
        MeasurableSpace.comap (fun s : S.State => s.bar) inferInstance := by
  rfl

/-- Algorithm 4.4 starts from `r_1 = w_1 = bar w_1`. -/
noncomputable def initialState (S : Setup Ξ Ζ E) : S.State where
  r := S.initialPoint
  bar := S.initialPoint

/-- The search point `w_t = (1 - alpha_t) bar w_t + alpha_t r_t`. -/
def searchPoint (S : Setup Ξ Ζ E) (n : ℕ) (x : S.State) : E :=
  SOptLib.acceleratedSearchPoint S.alpha (paperTime n) x.bar.1 x.r.1

/-- The search point lies in `Z`; this is a derived consequence of convexity and
the source-side schedule range, not a state field. -/
theorem searchPoint_mem (S : Setup Ξ Ζ E) (n : ℕ) (x : S.State) :
    S.searchPoint n x ∈ S.Z :=
  SOptLib.acceleratedSearchPoint_mem S.Z_convex (S.alpha_range (paperTime n))
    x.bar.2 x.r.2

/-- Carrier-valued version of the derived search point. -/
def searchPointPoint (S : Setup Ξ Ζ E) (n : ℕ) (x : S.State) : S.Point :=
  ⟨S.searchPoint n x, S.searchPoint_mem n x⟩

/-- The SAMP prox subproblem objective
`gamma * [<eta, u - r> + J(u)] + V(r,u)`. -/
noncomputable def proxObjective (S : Setup Ξ Ζ E) (r : S.Point) (eta : E)
    (gamma : ℝ) (u : S.Point) : ℝ :=
  paperSAMPProxObjectiveOn S.Z S.omega S.J S.omega_differentiableOn_Z r eta gamma u

/-- The paper prox-step relation, specialized to the displayed SAMP one-center
objective over the feasible carrier. -/
def IsProxStep (S : Setup Ξ Ζ E) (r : S.Point) (eta : E) (gamma : ℝ)
    (z : S.Point) : Prop :=
  IsSAMPProxStepOn S.Z S.omega S.J S.omega_differentiableOn_Z r eta gamma z

/-- Formula bridge from the SAMP prox relation to the displayed minimization
inequality. -/
theorem IsProxStep.le (S : Setup Ξ Ζ E) {r : S.Point} {eta : E} {gamma : ℝ}
    {z : S.Point} (hz : S.IsProxStep r eta gamma z) (u : S.Point) :
    S.proxObjective r eta gamma z ≤ S.proxObjective r eta gamma u := by
  simpa [IsProxStep, proxObjective] using
    (isMinOn_univ_iff.mp hz) u

/-- First oracle vector in (4.5.12). -/
def firstOracle (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ)
    (x : S.State) : E :=
  let t := (paperTime n).1
  S.Hsample x.r.1 (path.zeta (2 * t - 1)) +
    S.Gsample (S.searchPoint n x) (path.xi t)

/-- Second oracle vector in (4.5.13). -/
def secondOracle (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ)
    (x : S.State) (wNext : S.Point) : E :=
  let t := (paperTime n).1
  S.Hsample wNext.1 (path.zeta (2 * t)) +
    S.Gsample (S.searchPoint n x) (path.xi t)

/-- Source-facing existence obligation for the first Algorithm 4.4 prox update.
The PDF assumes the prox subproblem can be solved; the selected iterate below is
constructed from the paper-level schedule-indexed solvability boundary. -/
theorem firstProx_exists (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ)
    (x : S.State) :
    ∃ z : S.Point,
      S.IsProxStep x.r (S.firstOracle path n x) (S.gamma (paperTime n).1) z := by
  exact S.prox_solvable (paperTime n) x.r (S.firstOracle path n x)

/-- Continuity of the fixed-base SAMP prox objective on the feasible carrier. -/
private theorem proxObjective_continuous (S : Setup Ξ Ζ E) (r : S.Point) (eta : E)
    (gamma : ℝ) :
    Continuous (fun u : S.Point => S.proxObjective r eta gamma u) := by
  have hJ : Continuous (fun u : S.Point => S.J u.1) := by
    exact continuous_subtype_of_continuousOn_ambient
      (f := fun u : S.Point => S.J u.1) (F := S.J)
      (hF := S.J_continuousOn) (by intro u; rfl)
  have homega : Continuous (fun u : S.Point => S.omega u.1) := by
    exact continuous_subtype_of_continuousOn_ambient
      (f := fun u : S.Point => S.omega u.1) (F := S.omega)
      (hF := S.omega_continuousOn) (by intro u; rfl)
  have hV : Continuous (fun u : S.Point => S.V r u) := by
    have homega_r : Continuous (fun _ : S.Point => S.omega r.1) := continuous_const
    have hinner :
        Continuous (fun u : S.Point =>
          ⟪gradientWithin S.omega S.Z r.1, u.1 - r.1⟫_ℝ) := by
      have hgrad : Continuous (fun _ : S.Point => (gradientWithin S.omega S.Z r.1 : E)) :=
        continuous_const
      have hsub : Continuous (fun u : S.Point => u.1 - r.1) := by
        simpa using
          (continuous_subtype_val.sub
            (continuous_const : Continuous fun _ : S.Point => (r.1 : E)))
      simpa [sub_eq_add_neg] using hgrad.inner hsub
    have hV0 : Continuous (fun u : S.Point =>
        S.omega u.1 - S.omega r.1 -
          ⟪gradientWithin S.omega S.Z r.1, u.1 - r.1⟫_ℝ) := by
      simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using
        (homega.sub homega_r).sub hinner
    simpa [V, carrierBregman, paperSAMPCarrierBregmanOn,
      carrierBregmanDivergence] using hV0
  have hlin : Continuous (fun u : S.Point => ⟪eta, u.1 - r.1⟫_ℝ + S.J u.1) := by
    exact (continuous_const.inner (continuous_subtype_val.sub continuous_const)).add hJ
  have hscaled : Continuous (fun u : S.Point =>
      gamma * (⟪eta, u.1 - r.1⟫_ℝ + S.J u.1)) := by
    simpa using (continuous_const.mul hlin)
  simpa [proxObjective] using hscaled.add hV

/-- Inline boundedness witness used before the public boundedness theorem. -/
private theorem carrier_boundedness_from_bregman_diameter_aux (S : Setup Ξ Ζ E) :
    Bornology.IsBounded S.Z := by
  classical
  rcases Seminorm.exists_norm_le_mul_self_of_finiteDimensional_separating
      (p := S.primalSeminorm) S.primalSeminorm_separating with
    ⟨C, hC_nonneg, hC⟩
  have hball : ∀ u : S.Point,
      u.1 ∈ Metric.closedBall S.uStar (C * (2 * S.DZ ^ 2 + 1)) := by
    intro u
    have hdiam : ∀ u : S.Point, S.primalNorm (u.1 - S.uStar) ^ 2 ≤ 2 * S.DZ ^ 2 := by
      intro u
      let uStarP : S.Point := S.weakSolution
      have hV := S.V_le_diameter uStarP u
      have hV' := S.half_primalNorm_sq_le_V uStarP u
      have htmp : (1 / 2 : ℝ) * S.primalNorm (S.weakSolution.1 - u.1) ^ 2 ≤ S.DZ ^ 2 := by
        exact le_trans hV' hV
      have hnorm :
          S.primalNorm (u.1 - S.uStar) = S.primalNorm (S.weakSolution.1 - u.1) := by
        change S.primalSeminorm (u.1 - S.uStar) = S.primalSeminorm (S.uStar - u.1)
        calc
          S.primalSeminorm (u.1 - S.uStar) = S.primalSeminorm (-(S.uStar - u.1)) := by
            congr 1
            abel
          _ = S.primalSeminorm (S.uStar - u.1) := by
            rw [map_neg_eq_map]
      have hV'' : (1 / 2 : ℝ) * S.primalNorm (u.1 - S.uStar) ^ 2 ≤ S.DZ ^ 2 := by
        simpa [hnorm] using htmp
      nlinarith [hV'']
    have hprimal : ∀ u : S.Point, S.primalNorm (u.1 - S.uStar) ≤ 2 * S.DZ ^ 2 + 1 := by
      intro u
      have hsq := hdiam u
      nlinarith [sq_nonneg (S.primalNorm (u.1 - S.uStar))]
    have hnorm : ‖u.1 - S.uStar‖ ≤ C * (2 * S.DZ ^ 2 + 1) := by
      calc
        ‖u.1 - S.uStar‖ ≤ C * S.primalNorm (u.1 - S.uStar) := by
          simpa [Setup.primalNorm] using hC (u.1 - S.uStar)
        _ ≤ C * (2 * S.DZ ^ 2 + 1) := by
          nlinarith [hprimal u, hC_nonneg]
    simpa [Metric.mem_closedBall, dist_eq_norm] using hnorm
  exact (Metric.isBounded_iff_subset_closedBall S.uStar).2
    ⟨C * (2 * S.DZ ^ 2 + 1), fun x hx => by
      simpa using hball ⟨x, hx⟩⟩

/-- First prox update `w_{t+1}` from (4.5.12). -/
private noncomputable def firstProxArgmin (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ)
    (n : ℕ) (x : S.State) : {z : S.Point // S.IsProxStep x.r (S.firstOracle path n x)
    (S.gamma (paperTime n).1) z} :=
  by
    classical
    have hcomp : IsCompact (Set.univ : Set { z : E // z ∈ S.Z }) := by
      simpa using
        (isCompact_univ_subtype_of_isClosed_isBounded (E := E) (X := S.Z)
          S.Z_closed (carrier_boundedness_from_bregman_diameter_aux S))
    letI : CompactSpace { z : E // z ∈ S.Z } := ⟨hcomp⟩
    have hmin :
        ∃ z : S.Point,
          ∀ y : S.Point,
            S.proxObjective x.r (S.firstOracle path n x) (S.gamma (paperTime n).1) z ≤
              S.proxObjective x.r (S.firstOracle path n x) (S.gamma (paperTime n).1) y := by
      simpa using
        (SOptLib.objectiveMinimum_exists_of_isCompact_continuousOn
          (f := fun u : S.Point =>
            S.proxObjective x.r (S.firstOracle path n x)
              (S.gamma (paperTime n).1) u)
          (X := Set.univ)
          (hX_compact := isCompact_univ)
          (hX_nonempty := by exact ⟨x.r, by simp⟩)
          (hcont := (S.proxObjective_continuous x.r (S.firstOracle path n x)
            (S.gamma (paperTime n).1)).continuousOn))
    refine ⟨Classical.choose hmin, ?_⟩
    exact isMinOn_univ_iff.mpr (Classical.choose_spec hmin)

/-- First prox update `w_{t+1}` from (4.5.12), as the point projection of a
bundled minimizer witness. -/
noncomputable def firstProx (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ)
    (x : S.State) : S.Point :=
  (S.firstProxArgmin path n x).1

/-- The first prox update satisfies the displayed argmin relation. -/
theorem firstProx_spec (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ)
    (x : S.State) :
    S.IsProxStep x.r (S.firstOracle path n x) (S.gamma (paperTime n).1)
      (S.firstProx path n x) := by
  simpa [firstProx] using (S.firstProxArgmin path n x).2

/-- Source-facing existence obligation for the second Algorithm 4.4 prox update,
after the first selected prox point has been constructed. -/
theorem secondProx_exists (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ)
    (x : S.State) :
    ∃ z : S.Point,
      S.IsProxStep x.r (S.secondOracle path n x (S.firstProx path n x))
        (S.gamma (paperTime n).1) z := by
  exact S.prox_solvable (paperTime n) x.r
    (S.secondOracle path n x (S.firstProx path n x))

/-- Feasible second prox update selected by the displayed argmin in (4.5.13). -/
private noncomputable def secondProxArgmin (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ)
    (n : ℕ) (x : S.State) : {z : S.Point //
      S.IsProxStep x.r (S.secondOracle path n x (S.firstProx path n x))
        (S.gamma (paperTime n).1) z} :=
  by
    classical
    have hcomp : IsCompact (Set.univ : Set { z : E // z ∈ S.Z }) := by
      simpa using
        (isCompact_univ_subtype_of_isClosed_isBounded (E := E) (X := S.Z)
          S.Z_closed (carrier_boundedness_from_bregman_diameter_aux S))
    letI : CompactSpace { z : E // z ∈ S.Z } := ⟨hcomp⟩
    have hmin :
        ∃ z : S.Point,
          ∀ y : S.Point,
            S.proxObjective x.r (S.secondOracle path n x (S.firstProx path n x))
              (S.gamma (paperTime n).1) z ≤
              S.proxObjective x.r (S.secondOracle path n x (S.firstProx path n x))
                (S.gamma (paperTime n).1) y := by
      simpa using
        (SOptLib.objectiveMinimum_exists_of_isCompact_continuousOn
          (f := fun u : S.Point =>
            S.proxObjective x.r (S.secondOracle path n x (S.firstProx path n x))
              (S.gamma (paperTime n).1) u)
          (X := Set.univ)
          (hX_compact := isCompact_univ)
          (hX_nonempty := by exact ⟨x.r, by simp⟩)
          (hcont := (S.proxObjective_continuous x.r
            (S.secondOracle path n x (S.firstProx path n x))
            (S.gamma (paperTime n).1)).continuousOn))
    refine ⟨Classical.choose hmin, ?_⟩
    exact isMinOn_univ_iff.mpr (Classical.choose_spec hmin)

/-- Second prox update `r_{t+1}` from (4.5.13), as the carrier-valued optimizer
selected by the displayed argmin over `Z`. -/
noncomputable def secondProxPoint (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ)
    (x : S.State) : S.Point :=
  (S.secondProxArgmin path n x).1

/-- The feasible second prox update satisfies the displayed argmin relation. -/
theorem secondProxPoint_spec (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ)
    (x : S.State) :
    S.IsProxStep x.r (S.secondOracle path n x (S.firstProx path n x))
      (S.gamma (paperTime n).1) (S.secondProxPoint path n x) := by
  simpa [secondProxPoint] using (S.secondProxArgmin path n x).2

/-- Second prox update `r_{t+1}` from (4.5.13), as the carrier-valued optimizer
selected by the displayed argmin over `Z`. -/
noncomputable def secondProx (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ)
    (x : S.State) : S.Point :=
  S.secondProxPoint path n x

/-- The second prox update satisfies the displayed argmin relation. -/
theorem secondProx_spec (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ)
    (x : S.State) :
    S.IsProxStep x.r (S.secondOracle path n x (S.firstProx path n x))
      (S.gamma (paperTime n).1) (S.secondProx path n x) := by
  simpa [secondProx] using S.secondProxPoint_spec path n x

/-- Aggregate update `bar w_{t+1} = (1 - alpha_t) bar w_t + alpha_t w_{t+1}`. -/
def aggregatePoint (S : Setup Ξ Ζ E) (n : ℕ) (x : S.State)
    (wNext : S.Point) : S.Point :=
  ⟨SOptLib.acceleratedAveragePoint S.alpha (paperTime n) x.bar.1 wNext.1,
    SOptLib.acceleratedAveragePoint_mem S.Z_convex S.alpha (paperTime n)
      (S.alpha_range (paperTime n)) x.bar.2 wNext.2⟩

/-- One canonical SAMP transition of Algorithm 4.4. -/
noncomputable def transition (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ)
    (n : ℕ) (x : S.State) : S.State :=
  let wNext := S.firstProx path n x
  { r := S.secondProx path n x
    bar := S.aggregatePoint n x wNext }

/-- Generated SAMP state process; no iterate is an input witness. -/
noncomputable def stateProcess (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) :
    ℕ → S.State :=
  fun n =>
    SOptLib.recursiveIterateProcess S.initialState
      (fun n x _ => S.transition path n x) n ()

@[simp]
theorem stateProcess_zero (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) :
    S.stateProcess path 0 = S.initialState := by
  rfl

@[simp]
theorem stateProcess_succ (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ) :
    S.stateProcess path (n + 1) =
      S.transition path n (S.stateProcess path n) := by
  rfl

/-- The generated averaged iterate stays in the feasible carrier at every time. -/
theorem stateProcess_bar_mem (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) :
    ∀ n : ℕ, (S.stateProcess path n).bar.1 ∈ S.Z := by
  intro n
  induction n with
  | zero =>
      simpa [stateProcess, initialState, initialPoint] using S.r₁_mem
  | succ n ih =>
      simp [stateProcess_succ, stateProcess, transition, aggregatePoint,
        ih, S.firstProx_spec path n (S.stateProcess path n)]

/-- Derived `r_t` sequence, with zero-based Lean index `n` representing paper
time `t = n + 1`. -/
noncomputable def rSeq (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ) : S.Point :=
  (S.stateProcess path n).r

/-- Derived averaged sequence `bar w_t`, with zero-based Lean index. -/
noncomputable def barSeq (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ) : S.Point :=
  (S.stateProcess path n).bar

/-- The `r` coordinate of the recursive state is measurable for the generated
state sigma-algebra. -/
theorem state_r_measurable (S : Setup Ξ Ζ E) [MeasurableSpace E] :
    Measurable (fun s : S.State => s.r) := by
  exact Measurable.of_comap_le le_sup_left

/-- The averaged coordinate of the recursive state is measurable for the
generated state sigma-algebra. -/
theorem state_bar_measurable (S : Setup Ξ Ζ E) [MeasurableSpace E] :
    Measurable (fun s : S.State => s.bar) := by
  exact Measurable.of_comap_le le_sup_right

/-- Coordinatewise measurability of a recursive state implies measurability of
the whole state map. -/
theorem state_measurable_of_coordinates [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E]
    (state : Ω → S.State)
    (hr : Measurable (fun ω => (state ω).r))
    (hbar : Measurable (fun ω => (state ω).bar)) :
    Measurable state := by
  refine Measurable.of_comap_le ?_
  change MeasurableSpace.comap state (stateMeasurableSpace S) ≤ (inferInstance : MeasurableSpace Ω)
  rw [stateMeasurableSpace_def, MeasurableSpace.comap_sup]
  exact sup_le
    (by simpa [MeasurableSpace.comap_comp] using hr.comap_le)
    (by simpa [MeasurableSpace.comap_comp] using hbar.comap_le)

/-- Derived search sequence `w_t`, with zero-based Lean index. -/
noncomputable def wSeq (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ) : S.Point :=
  S.searchPointPoint n (S.stateProcess path n)

/-- Noise `Delta G_t = G(w_t; xi_t) - grad G(w_t)` from (4.5.29). -/
noncomputable def deltaG (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ) : E :=
  let t := (paperTime n).1
  S.Gsample (S.wSeq path n).1 (path.xi t) - S.gradG (S.wSeq path n).1

/-- Noise `Delta H_{2t-1} = H(r_t; zeta_{2t-1}) - H(r_t)` from (4.5.29). -/
noncomputable def deltaHOdd (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ) : E :=
  let t := (paperTime n).1
  S.Hsample (S.rSeq path n).1 (path.zeta (2 * t - 1)) - S.Hmean (S.rSeq path n).1

/-- Noise `Delta H_{2t} = H(w_{t+1}; zeta_{2t}) - H(w_{t+1})` from (4.5.29). -/
noncomputable def deltaHEven (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ) : E :=
  let t := (paperTime n).1
  let wNext := S.firstProx path n (S.stateProcess path n)
  S.Hsample wNext.1 (path.zeta (2 * t)) - S.Hmean wNext.1

/-- The source perturbation `Delta_i = Delta H^{2i} + Delta G^i` used in the
auxiliary recursion (4.5.34) during the proof of Theorem 4.10. -/
noncomputable def auxiliaryDelta (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ)
    (n : ℕ) : E :=
  S.deltaHEven path n + S.deltaG path n

private theorem samp_secondOracle_residual_decomposition
    (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ) :
    S.secondOracle path n (S.stateProcess path n)
        (S.firstProx path n (S.stateProcess path n)) =
      S.Hmean (S.firstProx path n (S.stateProcess path n)).1 +
        S.gradG (S.wSeq path n).1 +
        (S.deltaHEven path n + S.deltaG path n) := by
  simp [secondOracle, deltaHEven, deltaG, wSeq, searchPointPoint,
    sub_eq_add_neg, add_comm, add_left_comm, add_assoc]

/-- Auxiliary prox objective from Lemma 4.15 specialized as in (4.5.43):
`- gamma_i <Delta_i, u> + V(w_i^v,u)`, with zero-based Lean index. -/
noncomputable def auxiliaryProxObjective (S : Setup Ξ Ζ E) (center : S.Point)
    (delta : E) (gamma : ℝ) (u : S.Point) : ℝ :=
  -(gamma * ⟪delta, u.1⟫_ℝ) + S.V center u

/-- Source-facing auxiliary prox-step relation for (4.5.34). -/
def IsAuxiliaryProxStep (S : Setup Ξ Ζ E) (center : S.Point) (delta : E)
    (gamma : ℝ) (z : S.Point) : Prop :=
  IsMinOn (S.auxiliaryProxObjective center delta gamma) Set.univ z

/-- The auxiliary prox objective has a minimizer on the compact feasible carrier.
This is the source solvability obligation behind the argmin in (4.5.34), derived
from the same compact-carrier route used by the algorithmic prox selectors. -/
theorem auxiliaryProx_exists (S : Setup Ξ Ζ E) (center : S.Point)
    (delta : E) (gamma : ℝ) :
    ∃ z : S.Point, S.IsAuxiliaryProxStep center delta gamma z := by
  classical
  have hcomp : IsCompact (Set.univ : Set { z : E // z ∈ S.Z }) := by
    simpa using
      (isCompact_univ_subtype_of_isClosed_isBounded (E := E) (X := S.Z)
        S.Z_closed (carrier_boundedness_from_bregman_diameter_aux S))
  letI : CompactSpace { z : E // z ∈ S.Z } := ⟨hcomp⟩
  have hV : Continuous (fun u : S.Point => S.V center u) := by
    have hprox := S.proxObjective_continuous center delta 0
    simpa [proxObjective, paperSAMPProxObjectiveOn] using hprox
  have hlin : Continuous (fun u : S.Point => -(gamma * ⟪delta, u.1⟫_ℝ)) := by
    have hinner : Continuous (fun u : S.Point => ⟪delta, u.1⟫_ℝ) := by
      simpa using
        (continuous_const.inner continuous_subtype_val :
          Continuous (fun u : S.Point => ⟪delta, u.1⟫_ℝ))
    simpa using (continuous_const.mul hinner).neg
  have hcont : Continuous (fun u : S.Point =>
      S.auxiliaryProxObjective center delta gamma u) := by
    convert hlin.add hV using 1
  have hmin :
      ∃ z : S.Point,
        ∀ y : S.Point,
          S.auxiliaryProxObjective center delta gamma z ≤
            S.auxiliaryProxObjective center delta gamma y := by
    simpa using
      (SOptLib.objectiveMinimum_exists_of_isCompact_continuousOn
        (f := fun u : S.Point => S.auxiliaryProxObjective center delta gamma u)
        (X := Set.univ)
        (hX_compact := isCompact_univ)
        (hX_nonempty := by exact ⟨center, by simp⟩)
        (hcont := hcont.continuousOn))
  refine ⟨Classical.choose hmin, ?_⟩
  exact isMinOn_univ_iff.mpr (Classical.choose_spec hmin)

/-- Selected auxiliary prox update from (4.5.34). -/
noncomputable def auxiliaryProx (S : Setup Ξ Ζ E) (center : S.Point)
    (delta : E) (gamma : ℝ) : S.Point :=
  Classical.choose (S.auxiliaryProx_exists center delta gamma)

/-- The selected auxiliary prox update satisfies the displayed argmin relation
from (4.5.34). -/
theorem auxiliaryProx_spec (S : Setup Ξ Ζ E) (center : S.Point)
    (delta : E) (gamma : ℝ) :
    S.IsAuxiliaryProxStep center delta gamma (S.auxiliaryProx center delta gamma) :=
  Classical.choose_spec (S.auxiliaryProx_exists center delta gamma)

/-- Generated auxiliary sequence `w_i^v` from Lemma 4.15/(4.5.34), specialized
to `Delta_i = Delta H^{2i} + Delta G^i` as in the proof of Theorem 4.10.
Zero-based Lean index `0` denotes the paper point `w_1^v = w_1`. -/
noncomputable def auxiliarySeq (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) :
    ℕ → S.Point :=
  fun n =>
    SOptLib.recursiveIterateProcess S.initialPoint
      (fun n center _ =>
        S.auxiliaryProx center (S.auxiliaryDelta path n) (S.gamma (paperTime n).1))
      n ()

@[simp]
theorem auxiliarySeq_zero (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) :
    S.auxiliarySeq path 0 = S.initialPoint := by
  rfl

@[simp]
theorem auxiliarySeq_succ (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ) :
    S.auxiliarySeq path (n + 1) =
      S.auxiliaryProx (S.auxiliarySeq path n)
        (S.auxiliaryDelta path n) (S.gamma (paperTime n).1) := by
  rfl

/-- The generated auxiliary sequence stays in the feasible carrier by type. -/
theorem auxiliarySeq_mem (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ) :
    (S.auxiliarySeq path n).1 ∈ S.Z :=
  (S.auxiliarySeq path n).2

/-- Defining argmin property of the generated auxiliary recursion (4.5.34). -/
theorem auxiliarySeq_succ_spec (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ) :
    S.IsAuxiliaryProxStep (S.auxiliarySeq path n) (S.auxiliaryDelta path n)
      (S.gamma (paperTime n).1) (S.auxiliarySeq path (n + 1)) := by
  simpa [auxiliarySeq_succ] using
    S.auxiliaryProx_spec (S.auxiliarySeq path n)
      (S.auxiliaryDelta path n) (S.gamma (paperTime n).1)

/-- The SVI merit expression `Q(tilde u,u)` from (4.5.15). -/
noncomputable def Q (S : Setup Ξ Ζ E) (utilde u : E) : ℝ :=
  S.Gvalue utilde - S.Gvalue u +
    ⟪S.Hmean u, utilde - u⟫_ℝ + S.J utilde - S.J u

/-- Gap function `g(tilde u) = sup_{u in Z} Q(tilde u,u)` from (4.5.16). -/
noncomputable def gap (S : Setup Ξ Ζ E) (utilde : E) : ℝ :=
  sSup ((fun u : E => S.Q utilde u) '' S.Z)

/-- The Bregman-diameter hypothesis implies that the feasible carrier is
bounded in the ambient norm. -/
theorem carrier_boundedness_from_bregman_diameter (S : Setup Ξ Ζ E) :
    Bornology.IsBounded S.Z := by
  classical
  rcases Seminorm.exists_norm_le_mul_self_of_finiteDimensional_separating
      (p := S.primalSeminorm) S.primalSeminorm_separating with
    ⟨C, hC_nonneg, hC⟩
  have hball : ∀ u : S.Point,
      u.1 ∈ Metric.closedBall S.uStar (C * (2 * S.DZ ^ 2 + 1)) := by
    intro u
    have hdiam : ∀ u : S.Point, S.primalNorm (u.1 - S.uStar) ^ 2 ≤ 2 * S.DZ ^ 2 := by
      intro u
      let uStarP : S.Point := S.weakSolution
      have hV := S.V_le_diameter uStarP u
      have hV' := S.half_primalNorm_sq_le_V uStarP u
      have htmp : (1 / 2 : ℝ) * S.primalNorm (S.weakSolution.1 - u.1) ^ 2 ≤ S.DZ ^ 2 := by
        exact le_trans hV' hV
      have hnorm :
          S.primalNorm (u.1 - S.uStar) = S.primalNorm (S.weakSolution.1 - u.1) := by
        change S.primalSeminorm (u.1 - S.uStar) = S.primalSeminorm (S.uStar - u.1)
        calc
          S.primalSeminorm (u.1 - S.uStar) = S.primalSeminorm (-(S.uStar - u.1)) := by
            congr 1
            abel
          _ = S.primalSeminorm (S.uStar - u.1) := by
            rw [map_neg_eq_map]
      have hV'' : (1 / 2 : ℝ) * S.primalNorm (u.1 - S.uStar) ^ 2 ≤ S.DZ ^ 2 := by
        simpa [hnorm] using htmp
      nlinarith [hV'']
    have hprimal : ∀ u : S.Point, S.primalNorm (u.1 - S.uStar) ≤ 2 * S.DZ ^ 2 + 1 := by
      intro u
      have hsq := hdiam u
      nlinarith [sq_nonneg (S.primalNorm (u.1 - S.uStar))]
    have hnorm : ‖u.1 - S.uStar‖ ≤ C * (2 * S.DZ ^ 2 + 1) := by
      calc
        ‖u.1 - S.uStar‖ ≤ C * S.primalNorm (u.1 - S.uStar) := by
          simpa [Setup.primalNorm] using hC (u.1 - S.uStar)
        _ ≤ C * (2 * S.DZ ^ 2 + 1) := by
          nlinarith [hprimal u, hC_nonneg]
    simpa [Metric.mem_closedBall, dist_eq_norm] using hnorm
  exact (Metric.isBounded_iff_subset_closedBall S.uStar).2
    ⟨C * (2 * S.DZ ^ 2 + 1), fun x hx => by
      simpa using hball ⟨x, hx⟩⟩

/-- The Bregman-diameter hypothesis and closedness make the source feasible
carrier compact in the finite-dimensional ambient space. -/
theorem Z_isCompact (S : Setup Ξ Ζ E) : IsCompact S.Z :=
  Metric.isCompact_of_isClosed_isBounded S.Z_closed S.carrier_boundedness_from_bregman_diameter

/-- The source convexity and monotonicity data turn carrier boundedness into a
real upper bound for the gap integrand. -/
theorem gap_upper_bound_from_bounded_carrier (S : Setup Ξ Ζ E) (utilde : S.Point)
    (hbounded : Bornology.IsBounded S.Z) :
    BddAbove ((fun u : E => S.Q utilde.1 u) '' S.Z) := by
  classical
  rcases hbounded.subset_closedBall S.uStar with ⟨R, hR⟩
  have hdist : ∀ u : S.Point, ‖utilde.1 - u.1‖ ≤ 2 * R := by
    intro u
    have hutilde : ‖utilde.1 - S.uStar‖ ≤ R := by
      simpa [Metric.mem_closedBall, dist_eq_norm] using hR utilde.2
    have hu : ‖u.1 - S.uStar‖ ≤ R := by
      simpa [norm_sub_rev, Metric.mem_closedBall, dist_eq_norm] using hR u.2
    have hu' : ‖S.uStar - u.1‖ ≤ R := by
      simpa [norm_sub_rev] using hu
    calc
      ‖utilde.1 - u.1‖ = ‖(utilde.1 - S.uStar) + (S.uStar - u.1)‖ := by
        abel
      _ ≤ ‖utilde.1 - S.uStar‖ + ‖S.uStar - u.1‖ := by
        exact norm_add_le _ _
      _ ≤ R + R := by
        gcongr
      _ = 2 * R := by ring
  have hQub :
      ∀ u : S.Point,
        S.Q utilde.1 u.1 ≤
          ‖S.gradG utilde.1 + S.Hmean utilde.1 + S.Jsubgrad utilde.1‖ * (2 * R) := by
    intro u
    have hG :
        S.Gvalue utilde.1 - S.Gvalue u.1 ≤
          ⟪S.gradG utilde.1, utilde.1 - u.1⟫_ℝ := by
      have h0 := (S.G_convex_smooth (w := u.1) (v := utilde.1) u.2 utilde.2).1
      have hinner :
          ⟪S.gradG utilde.1, utilde.1 - u.1⟫_ℝ =
            -⟪S.gradG utilde.1, u.1 - utilde.1⟫_ℝ := by
        simp [sub_eq_add_neg, inner_add_right, inner_sub_right, add_comm, add_left_comm,
          add_assoc]
      nlinarith [h0, hinner]
    have hH :
        ⟪S.Hmean u.1, utilde.1 - u.1⟫_ℝ ≤
          ⟪S.Hmean utilde.1, utilde.1 - u.1⟫_ℝ := by
      have h0 := S.H_monotone utilde.2 u.2
      have h0' :
          0 ≤
            ⟪S.Hmean utilde.1, utilde.1 - u.1⟫_ℝ -
              ⟪S.Hmean u.1, utilde.1 - u.1⟫_ℝ := by
        simpa [sub_eq_add_neg, inner_add_left, inner_add_right,
          add_comm, add_left_comm, add_assoc] using h0
      linarith
    have hJ :
        S.J utilde.1 - S.J u.1 ≤
          ⟪S.Jsubgrad utilde.1, utilde.1 - u.1⟫_ℝ := by
      have hsub := S.Jsubgrad_mem_carrierSubdifferential utilde
      have h0 :=
        (SOptLib.mem_carrierSubdifferential_iff
          (X := S.Z)
          (f := fun z : S.Point => S.J z.1)
          (w := utilde)
          (g := S.Jsubgrad utilde.1)).1 hsub u
      have hinner :
          ⟪S.Jsubgrad utilde.1, utilde.1 - u.1⟫_ℝ =
            -⟪S.Jsubgrad utilde.1, u.1 - utilde.1⟫_ℝ := by
        simp [sub_eq_add_neg, inner_add_right, inner_sub_right, add_comm, add_left_comm,
          add_assoc]
      nlinarith [h0, hinner]
    have hlin :
        S.Q utilde.1 u.1 ≤
          ⟪S.gradG utilde.1 + S.Hmean utilde.1 + S.Jsubgrad utilde.1,
            utilde.1 - u.1⟫_ℝ := by
      unfold Q
      simp [inner_add_left, inner_add_right, add_comm, add_left_comm, add_assoc]
      nlinarith
    have hcs :
        ⟪S.gradG utilde.1 + S.Hmean utilde.1 + S.Jsubgrad utilde.1,
          utilde.1 - u.1⟫_ℝ ≤
          ‖S.gradG utilde.1 + S.Hmean utilde.1 + S.Jsubgrad utilde.1‖ *
            ‖utilde.1 - u.1‖ := by
      have habs :
          |⟪S.gradG utilde.1 + S.Hmean utilde.1 + S.Jsubgrad utilde.1,
            utilde.1 - u.1⟫_ℝ| ≤
            ‖S.gradG utilde.1 + S.Hmean utilde.1 + S.Jsubgrad utilde.1‖ *
              ‖utilde.1 - u.1‖ := by
        simpa using
          (norm_inner_le_norm (𝕜 := ℝ)
            (S.gradG utilde.1 + S.Hmean utilde.1 + S.Jsubgrad utilde.1)
            (utilde.1 - u.1))
      have habs' :
          |⟪S.gradG utilde.1 + S.Hmean utilde.1 + S.Jsubgrad utilde.1,
            utilde.1 - u.1⟫_ℝ| ≤
            ‖S.gradG utilde.1 + S.Hmean utilde.1 + S.Jsubgrad utilde.1‖ *
              ‖utilde.1 - u.1‖ := by
        simpa using habs
      exact le_trans (le_abs_self _) habs'
    calc
      S.Q utilde.1 u.1 ≤
          ⟪S.gradG utilde.1 + S.Hmean utilde.1 + S.Jsubgrad utilde.1,
            utilde.1 - u.1⟫_ℝ := hlin
      _ ≤ ‖S.gradG utilde.1 + S.Hmean utilde.1 + S.Jsubgrad utilde.1‖ *
            ‖utilde.1 - u.1‖ := hcs
      _ ≤ ‖S.gradG utilde.1 + S.Hmean utilde.1 + S.Jsubgrad utilde.1‖ *
            (2 * R) := by
        gcongr
        exact hdist u
  refine ⟨‖S.gradG utilde.1 + S.Hmean utilde.1 + S.Jsubgrad utilde.1‖ * (2 * R), ?_⟩
  intro r hr
  rcases hr with ⟨u, hu, rfl⟩
  exact hQub ⟨u, hu⟩

/-- Nonempty/bounded-above boundary for the displayed supremum defining `g`.
This records the mathematical domain of (4.5.16) separately from Lean's total
`sSup`; it is a proof obligation from the bounded-diameter theorem setup. -/
theorem gap_well_defined (S : Setup Ξ Ζ E) (utilde : S.Point) :
    ((fun u : E => S.Q utilde.1 u) '' S.Z).Nonempty ∧
      BddAbove ((fun u : E => S.Q utilde.1 u) '' S.Z) := by
  constructor
  · exact ⟨S.Q utilde.1 utilde.1, ⟨utilde.1, utilde.2, rfl⟩⟩
  · exact S.gap_upper_bound_from_bounded_carrier utilde
      (S.carrier_boundedness_from_bregman_diameter)

/-- The displayed gap agrees with the least upper bound of its nonempty,
bounded-above source set. -/
theorem gap_isLUB (S : Setup Ξ Ζ E) (utilde : S.Point) :
    IsLUB ((fun u : E => S.Q utilde.1 u) '' S.Z) (S.gap utilde.1) := by
  obtain ⟨hne, hbdd⟩ := S.gap_well_defined utilde
  exact isLUB_csSup hne hbdd

/-- The displayed gap is nonnegative because the feasible set contributes the
zero value at its own point. -/
theorem gap_nonneg (S : Setup Ξ Ζ E) (utilde : S.Point) :
    0 ≤ S.gap utilde.1 := by
  have hmem : 0 ∈ ((fun u : E => S.Q utilde.1 u) '' S.Z) := by
    refine ⟨utilde.1, utilde.2, ?_⟩
    simp [Q]
  change 0 ≤ sSup ((fun u : E => S.Q utilde.1 u) '' S.Z)
  exact le_csSup (S.gap_well_defined utilde).2 hmem

/-- The expected-gap integrand in Theorem 4.10(a), evaluated on the generated
averaged iterate. -/
noncomputable def expectedGapIntegrand [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    (sample : Ω → SamplePath Ξ Ζ) (_μ : Measure Ω) (n : ℕ) : Ω → ℝ :=
  fun ω => S.gap (S.barSeq (sample ω) n).1

/-- Strict gap-tail event for a generated averaged iterate and a real threshold. -/
noncomputable def strictGapTailEvent [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    (sample : Ω → SamplePath Ξ Ζ) (n : ℕ) (threshold : ℝ) : Set Ω :=
  {ω | S.gap (S.barSeq (sample ω) n).1 > threshold}

/-- The `xi_i` oracle-sample coordinate stream induced by a run sample map. -/
def xiStream (sample : Ω → SamplePath Ξ Ζ) : ℕ → Ω → Ξ :=
  fun i ω => (sample ω).xi i

/-- The `zeta_i` oracle-sample coordinate stream induced by a run sample map. -/
def zetaStream (sample : Ω → SamplePath Ξ Ζ) : ℕ → Ω → Ζ :=
  fun i ω => (sample ω).zeta i

/-- The actual law of the `xi_i` coordinate used by the generated SAMP run. -/
noncomputable def xiCoordinateLaw [MeasurableSpace Ω] [MeasurableSpace Ξ]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) (i : ℕ) : Measure Ξ :=
  Measure.map (xiStream sample i) μ

/-- The actual law of the `zeta_i` coordinate used by the generated SAMP run. -/
noncomputable def zetaCoordinateLaw [MeasurableSpace Ω] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) (i : ℕ) : Measure Ζ :=
  Measure.map (zetaStream sample i) μ

/-- Law-level sampling boundary for the two independently distributed SFO sample
streams.  This records the source's random-sample boundary separately from the
fixed-query oracle moment contracts.

Book JSON Assumption 10/`Oracle_independence` describes `xi_i` and `zeta_i` as
independently distributed random samples; in Lean, each coordinate must be a
measurable random variable before the independence and law clauses can be used
as a probability-space boundary. -/
def OracleSampleBoundary [MeasurableSpace Ω] [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω)
    (xiLaw : Measure Ξ) (zetaLaw : Measure Ζ) : Prop :=
  (∀ i : ℕ, Measurable (xiStream sample i)) ∧
    (∀ i : ℕ, Measurable (zetaStream sample i)) ∧
    iIndepFun (xiStream sample) μ ∧
    iIndepFun (zetaStream sample) μ ∧
    IndepFun (fun ω => (sample ω).xi) (fun ω => (sample ω).zeta) μ ∧
    (∀ i : ℕ, Measure.map (xiStream sample i) μ = xiLaw) ∧
    (∀ i : ℕ, Measure.map (zetaStream sample i) μ = zetaLaw)

/-- The source-level same-call independence statement from Assumption 10:
`xi_i` and `zeta_i` are independently distributed random samples.  This is kept
separate from the stronger stream boundary containing iid and fixed-marginal
realization data. -/
def SourceIndependentOracleSamples [MeasurableSpace Ω] [MeasurableSpace Ξ]
    [MeasurableSpace Ζ] (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) : Prop :=
  ∀ i : ℕ, IndepFun (xiStream sample i) (zetaStream sample i) μ

/-- The interleaved SAMP oracle block
`chi_i = (zeta_{2i-1}, xi_i, zeta_{2i})`, represented with zero-based Lean index
`i`, so paper time is `i + 1`. -/
def interleavedOracleBlock (sample : Ω → SamplePath Ξ Ζ) (i : ℕ) (ω : Ω) : Ζ × Ξ × Ζ :=
  ((sample ω).zeta (2 * (i + 1) - 1), (sample ω).xi (i + 1),
    (sample ω).zeta (2 * (i + 1)))

@[simp]
theorem interleavedOracleBlock_spec (sample : Ω → SamplePath Ξ Ζ)
    (i : ℕ) (ω : Ω) :
    interleavedOracleBlock sample i ω =
      ((sample ω).zeta (2 * (i + 1) - 1), (sample ω).xi (i + 1),
        (sample ω).zeta (2 * (i + 1))) := by
  rfl

/-- The finite block history `chi_[i-1]` generated by the interleaved oracle
blocks before iteration `i`. -/
def interleavedBlockPrefix (sample : Ω → SamplePath Ξ Ζ) (i : ℕ)
    (ω : Ω) : Fin i → Ζ × Ξ × Ζ :=
  fun j => interleavedOracleBlock sample j.1 ω

/-- Sigma-algebra generated by the prior interleaved oracle blocks
`chi_1, ..., chi_{i-1}`. -/
@[reducible]
def interleavedPriorHistory [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (i : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (interleavedBlockPrefix sample i) inferInstance

/-- Pre-`G` call history in iteration `i`: prior blocks plus the odd `H`
coordinate `zeta_{2i-1}`. -/
@[reducible]
def interleavedGHistory [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (i : ℕ) : MeasurableSpace Ω :=
  interleavedPriorHistory sample i ⊔
    MeasurableSpace.comap (fun ω => (sample ω).zeta (2 * (i + 1) - 1)) inferInstance

/-- Pre-even-`H` call history in iteration `i`: prior blocks, the odd `H`
coordinate, and the `G` coordinate. -/
@[reducible]
def interleavedEvenHHistory [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (i : ℕ) : MeasurableSpace Ω :=
  interleavedGHistory sample i ⊔
    MeasurableSpace.comap (fun ω => (sample ω).xi (i + 1)) inferInstance

/-- Current sigma-algebra after observing the odd `H` coordinate. -/
@[reducible]
def interleavedOddHCurrent [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (i : ℕ) : MeasurableSpace Ω :=
  interleavedPriorHistory sample i ⊔
    MeasurableSpace.comap (fun ω => (sample ω).zeta (2 * (i + 1) - 1)) inferInstance

/-- Current sigma-algebra after observing the `G` coordinate. -/
@[reducible]
def interleavedGCurrent [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (i : ℕ) : MeasurableSpace Ω :=
  interleavedGHistory sample i ⊔
    MeasurableSpace.comap (fun ω => (sample ω).xi (i + 1)) inferInstance

/-- Current sigma-algebra after observing the even `H` coordinate. -/
@[reducible]
def interleavedEvenHCurrent [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (i : ℕ) : MeasurableSpace Ω :=
  interleavedEvenHHistory sample i ⊔
    MeasurableSpace.comap (fun ω => (sample ω).zeta (2 * (i + 1))) inferInstance

/-- Earlier pre-`G` current information is contained in a later interleaved
block prefix. -/
private theorem interleavedGCurrent_le_interleavedPriorHistory_of_lt
    [MeasurableSpace Ω] [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) {j k : ℕ} (hjk : j < k) :
    interleavedGCurrent sample j ≤ interleavedPriorHistory sample k := by
  have hprefix_k :
      Measurable[interleavedPriorHistory sample k] (interleavedBlockPrefix sample k) := by
    simpa [interleavedPriorHistory] using
      (comap_measurable (interleavedBlockPrefix sample k))
  have hblock_j :
      Measurable[interleavedPriorHistory sample k] (interleavedOracleBlock sample j) := by
    have hcoord :=
      (measurable_pi_apply (⟨j, hjk⟩ : Fin k)).comp hprefix_k
    simpa [interleavedBlockPrefix] using hcoord
  have hprior_j :
      interleavedPriorHistory sample j ≤ interleavedPriorHistory sample k := by
    have hprefix_j :
        Measurable[interleavedPriorHistory sample k] (interleavedBlockPrefix sample j) := by
      refine
        @measurable_pi_lambda Ω (Fin j) (fun _ : Fin j => Ζ × Ξ × Ζ)
          (interleavedPriorHistory sample k) (fun _ => inferInstance)
          (interleavedBlockPrefix sample j) ?_
      intro r
      have hrk : r.1 < k := Nat.lt_trans r.2 hjk
      have hcoord :=
        (measurable_pi_apply (⟨r.1, hrk⟩ : Fin k)).comp hprefix_k
      simpa [interleavedBlockPrefix] using hcoord
    simpa [interleavedPriorHistory] using hprefix_j.comap_le
  have hodd :
      MeasurableSpace.comap
          (fun ω => (sample ω).zeta (2 * (j + 1) - 1)) inferInstance ≤
        interleavedPriorHistory sample k := by
    have hmeas :
        Measurable[interleavedPriorHistory sample k]
          (fun ω => (sample ω).zeta (2 * (j + 1) - 1)) := by
      simpa [interleavedOracleBlock] using measurable_fst.comp hblock_j
    exact hmeas.comap_le
  have hxi :
      MeasurableSpace.comap (fun ω => (sample ω).xi (j + 1)) inferInstance ≤
        interleavedPriorHistory sample k := by
    have hmeas :
        Measurable[interleavedPriorHistory sample k]
          (fun ω => (sample ω).xi (j + 1)) := by
      simpa [interleavedOracleBlock] using
        (measurable_fst.comp (measurable_snd.comp hblock_j))
    exact hmeas.comap_le
  unfold interleavedGCurrent interleavedGHistory
  exact sup_le (sup_le hprior_j hodd) hxi

/-- Earlier even-`H` current information is contained in a later interleaved
block prefix. -/
private theorem interleavedEvenHCurrent_le_interleavedPriorHistory_of_lt
    [MeasurableSpace Ω] [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) {j k : ℕ} (hjk : j < k) :
    interleavedEvenHCurrent sample j ≤ interleavedPriorHistory sample k := by
  have hprefix_k :
      Measurable[interleavedPriorHistory sample k] (interleavedBlockPrefix sample k) := by
    simpa [interleavedPriorHistory] using
      (comap_measurable (interleavedBlockPrefix sample k))
  have hblock_j :
      Measurable[interleavedPriorHistory sample k] (interleavedOracleBlock sample j) := by
    have hcoord :=
      (measurable_pi_apply (⟨j, hjk⟩ : Fin k)).comp hprefix_k
    simpa [interleavedBlockPrefix] using hcoord
  have hG_le :
      interleavedGCurrent sample j ≤ interleavedPriorHistory sample k :=
    interleavedGCurrent_le_interleavedPriorHistory_of_lt sample hjk
  have heven :
      MeasurableSpace.comap (fun ω => (sample ω).zeta (2 * (j + 1))) inferInstance ≤
        interleavedPriorHistory sample k := by
    have hmeas :
        Measurable[interleavedPriorHistory sample k]
          (fun ω => (sample ω).zeta (2 * (j + 1))) := by
      simpa [interleavedOracleBlock] using
        (measurable_snd.comp (measurable_snd.comp hblock_j))
    exact hmeas.comap_le
  unfold interleavedEvenHCurrent interleavedEvenHHistory interleavedGCurrent at *
  exact sup_le hG_le heven

/-- Generated `Delta G^i` residual process, as a random variable on the run
probability space. -/
noncomputable def deltaGProcess [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    (sample : Ω → SamplePath Ξ Ζ) : ℕ → Ω → E :=
  fun i ω => S.deltaG (sample ω) i

/-- Generated odd `Delta H^{2i-1}` residual process, as a random variable on
the run probability space. -/
noncomputable def deltaHOddProcess [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    (sample : Ω → SamplePath Ξ Ζ) : ℕ → Ω → E :=
  fun i ω => S.deltaHOdd (sample ω) i

/-- Generated even `Delta H^{2i}` residual process, as a random variable on the
run probability space. -/
noncomputable def deltaHEvenProcess [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    (sample : Ω → SamplePath Ξ Ζ) : ℕ → Ω → E :=
  fun i ω => S.deltaHEven (sample ω) i

/-- Conditional upper bound for a real random variable.  This is the
nonfallback Mathlib conditional expectation, together with the a.e. inequality
against a history-measurable budget process. -/
noncomputable def ConditionalRealExpectationLe [mΩ : MeasurableSpace Ω]
    (μ : Measure Ω) (past : MeasurableSpace Ω)
    (X bound : Ω → ℝ) : Prop :=
  @SOptLib.ConditionalExpectation.conditionalExpectationWellDefined Ω ℝ mΩ _ μ past X ∧
    @MeasureTheory.condExp Ω ℝ past (m₀ := mΩ) _ _ _ μ X ≤ᵐ[μ] bound

/-- Conditional second-moment budget for a residual process at the pre-call
history. -/
noncomputable def ConditionalDualSecondMomentProcess [MeasurableSpace Ω]
    (μ : Measure Ω) (past : ℕ → MeasurableSpace Ω)
    (delta : ℕ → Ω → E) (dualNorm : E → ℝ) (varianceBound : ℕ → ℝ) : Prop :=
  ∀ i : ℕ,
    ConditionalRealExpectationLe μ (past i)
      (fun ω => dualNorm (delta i ω) ^ (2 : ℕ))
      (fun _ => varianceBound i)

/-- Dual-norm version of an adaptive centered residual process: conditional
mean zero and conditional dual second-moment budget relative to the pre-call
history, plus observability after the corresponding fresh coordinate is
revealed. -/
def AdaptiveDualCenteredOracleProcess [MeasurableSpace Ω] [MeasurableSpace E]
    (μ : Measure Ω) (past current : ℕ → MeasurableSpace Ω)
  (delta : ℕ → Ω → E) (dualNorm : E → ℝ) (varianceBound : ℕ → ℝ) : Prop :=
  (∀ i : ℕ,
    SOptLib.ConditionalExpectation.conditionalExpectationEq μ (past i) (delta i)
      (0 : Ω → E)) ∧
  ConditionalDualSecondMomentProcess μ past delta dualNorm varianceBound ∧
  (∀ i : ℕ, Measurable[current i] (delta i))

/-- Partial real quotient relation for source-displayed formulas.

This relation records the domain and value of a mathematical quotient without
using Lean's total `/` value at a zero denominator. -/
def sourceQuotient (num den q : ℝ) : Prop :=
  den ≠ 0 ∧ q * den = num

/-- Domain/value bridge for source-displayed quotients. -/
theorem sourceQuotient_spec (num den q : ℝ) :
    sourceQuotient num den q ↔ den ≠ 0 ∧ q * den = num := by
  rfl

/-- A checked source quotient agrees with Lean's division when the denominator
is known nonzero. -/
private theorem sourceQuotient_eq_div {num den q : ℝ}
    (h : sourceQuotient num den q) : q = num / den := by
  rcases h with ⟨hden, hmul⟩
  rw [← hmul]
  field_simp [hden]

/-- Conditional zero-pairing interface used immediately before (4.5.47):
the residual has zero conditional pairing against a vector observable at the
corresponding pre-call history. -/
def ConditionalInnerProductZeroProcess [MeasurableSpace Ω] [MeasurableSpace E]
    (μ : Measure Ω) (past : ℕ → MeasurableSpace Ω)
    (delta pair : ℕ → Ω → E) : Prop :=
  ∀ i : ℕ,
    SOptLib.ConditionalExpectation.conditionalExpectationEq μ (past i)
      (fun ω => ⟪delta i ω, pair i ω⟫_ℝ) (0 : Ω → ℝ)

/-- Conditional exponential-moment bound for a source quotient representative
at a pre-call history. -/
noncomputable def ConditionalExpMomentLe [mΩ : MeasurableSpace Ω]
    (μ : Measure Ω) (past : MeasurableSpace Ω)
    (exponent : Ω → ℝ) (bound : ℝ) : Prop :=
  @ConditionalRealExpectationLe Ω mΩ μ past
    (fun ω => Real.exp (exponent ω)) (fun _ => bound)

/-- Convert a conditional exponential-moment bound into the unconditional
moment bound used by the paper's finite Jensen step.  The probability-space
precondition is essential: for a non-probability finite measure the constant
budget integrates to `bound * μ univ`, not to `bound`. -/
private theorem ConditionalExpMomentLe.integrable_exp_and_integral_le
    [mΩ : MeasurableSpace Ω] (μ : @Measure Ω mΩ) [IsProbabilityMeasure μ]
    (past : MeasurableSpace Ω) (exponent : Ω → ℝ) (bound : ℝ)
    (h : @ConditionalExpMomentLe Ω mΩ μ past exponent bound) :
    @SOptLib.expectationWellDefined Ω ℝ mΩ _ _ μ
        (fun ω => Real.exp (exponent ω)) ∧
      (@MeasureTheory.integral Ω ℝ _ _ mΩ μ
        (fun ω => Real.exp (exponent ω))) ≤ bound := by
  rcases h with ⟨hwd, hcond_le⟩
  let ce : Ω → ℝ :=
    @MeasureTheory.condExp Ω ℝ past mΩ _ _ _ μ
      (fun ω => Real.exp (exponent ω))
  have hint : @Integrable ℝ _ _ Ω mΩ (fun ω => Real.exp (exponent ω)) μ :=
    @SOptLib.ConditionalExpectation.conditionalExpectationWellDefined.integrable
      Ω ℝ mΩ _ μ past (fun ω => Real.exp (exponent ω)) hwd
  constructor
  · exact hint
  · have hcond_int : @Integrable ℝ _ _ Ω mΩ ce μ := by
      dsimp [ce]
      exact @MeasureTheory.integrable_condExp Ω ℝ past mΩ μ
        (fun ω => Real.exp (exponent ω)) _ _ _
    have hconst_int : @Integrable ℝ _ _ Ω mΩ (fun _ : Ω => bound) μ :=
      integrable_const bound
    have hmono :
        (@MeasureTheory.integral Ω ℝ _ _ mΩ μ ce) ≤
          @MeasureTheory.integral Ω ℝ _ _ mΩ μ (fun _ : Ω => bound) := by
      have hcond_le' : ce ≤ᵐ[μ] (fun _ : Ω => bound) := by
        simpa [ce] using hcond_le
      exact integral_mono_ae hcond_int hconst_int hcond_le'
    calc
      (@MeasureTheory.integral Ω ℝ _ _ mΩ μ
          (fun ω => Real.exp (exponent ω)))
          = @MeasureTheory.integral Ω ℝ _ _ mΩ μ ce := by
              exact
                (@SOptLib.ConditionalExpectation.conditionalExpectationWellDefined.integral_condExp
                  Ω ℝ mΩ _ _ _ μ past
                  (fun ω => Real.exp (exponent ω)) hwd).symm
      _ ≤ @MeasureTheory.integral Ω ℝ _ _ mΩ μ (fun _ : Ω => bound) := hmono
      _ = bound := by
        simp

/-- Convert a conditional scalar upper bound into the unconditional integral
bound used in the expectation part of Theorem 4.10. -/
private theorem ConditionalRealExpectationLe.integrable_and_integral_le_const
    [mΩ : MeasurableSpace Ω] (μ : @Measure Ω mΩ) [IsProbabilityMeasure μ]
    (past : MeasurableSpace Ω) (X : Ω → ℝ) (bound : ℝ)
    (h : @ConditionalRealExpectationLe Ω mΩ μ past X (fun _ => bound)) :
    @Integrable ℝ _ _ Ω mΩ X μ ∧
      (@MeasureTheory.integral Ω ℝ _ _ mΩ μ X) ≤ bound := by
  rcases h with ⟨hwd, hcond_le⟩
  let ce : Ω → ℝ :=
    @MeasureTheory.condExp Ω ℝ past (m₀ := mΩ) _ _ _ μ X
  have hint : @Integrable ℝ _ _ Ω mΩ X μ :=
    @SOptLib.ConditionalExpectation.conditionalExpectationWellDefined.integrable
      Ω ℝ mΩ _ μ past X hwd
  constructor
  · exact hint
  · have hcond_int : @Integrable ℝ _ _ Ω mΩ ce μ := by
      dsimp [ce]
      exact @MeasureTheory.integrable_condExp Ω ℝ past mΩ μ X _ _ _
    have hconst_int : @Integrable ℝ _ _ Ω mΩ (fun _ : Ω => bound) μ :=
      integrable_const bound
    have hmono :
        (@MeasureTheory.integral Ω ℝ _ _ mΩ μ ce) ≤
          @MeasureTheory.integral Ω ℝ _ _ mΩ μ (fun _ : Ω => bound) := by
      have hcond_le' : ce ≤ᵐ[μ] (fun _ : Ω => bound) := by
        simpa [ce] using hcond_le
      exact integral_mono_ae hcond_int hconst_int hcond_le'
    calc
      (@MeasureTheory.integral Ω ℝ _ _ mΩ μ X)
          = @MeasureTheory.integral Ω ℝ _ _ mΩ μ ce := by
              exact
                (@SOptLib.ConditionalExpectation.conditionalExpectationWellDefined.integral_condExp
                  Ω ℝ mΩ _ _ _ μ past X hwd).symm
      _ ≤ @MeasureTheory.integral Ω ℝ _ _ mΩ μ (fun _ : Ω => bound) := hmono
      _ = bound := by
        simp

/-- Bounded predictable weights can be pulled through a conditional scalar
upper bound.  This is the conditional-expectation/test-function core of the
weighted Lemma-4.1 step; the remaining prefix-MGF use requires removing the
boundedness hypothesis by truncation. -/
private theorem ConditionalRealExpectationLe.integrable_mul_and_integral_mul_le_const_of_bounded_weight
    [mΩ : MeasurableSpace Ω] (μ : @Measure Ω mΩ)
    (past : MeasurableSpace Ω) (X H : Ω → ℝ) (bound B : ℝ)
    (h : @ConditionalRealExpectationLe Ω mΩ μ past X (fun _ => bound))
    (hH_meas : Measurable[past] H)
    (hH_nonneg : ∀ ω : Ω, 0 ≤ H ω)
    (hH_int : @Integrable ℝ _ _ Ω mΩ H μ)
    (hH_bound : ∀ ω : Ω, ‖H ω‖ ≤ B) :
    @Integrable ℝ _ _ Ω mΩ (fun ω => H ω * X ω) μ ∧
      (@MeasureTheory.integral Ω ℝ _ _ mΩ μ
          (fun ω => H ω * X ω)) ≤
        bound * (@MeasureTheory.integral Ω ℝ _ _ mΩ μ H) := by
  rcases h with ⟨hwd, hcond_le⟩
  rcases hwd with ⟨hm, hsf, hX_int⟩
  letI : SigmaFinite (μ.trim hm) := hsf
  let ceX : Ω → ℝ :=
    @MeasureTheory.condExp Ω ℝ past (m₀ := mΩ) _ _ _ μ X
  have hH_aesm : AEStronglyMeasurable[mΩ] H μ :=
    ((hH_meas.mono hm le_rfl).aestronglyMeasurable)
  have hHX_int : @Integrable ℝ _ _ Ω mΩ (fun ω => H ω * X ω) μ :=
    hX_int.bdd_mul hH_aesm (Filter.Eventually.of_forall hH_bound)
  constructor
  · exact hHX_int
  · have hH_strong : StronglyMeasurable[past] H :=
      hH_meas.stronglyMeasurable
    have hpull :
        μ[(fun ω => H ω * X ω) | past] =ᵐ[μ]
          fun ω => H ω * ceX ω := by
      simpa [ceX] using
        (MeasureTheory.condExp_mul_of_stronglyMeasurable_left
          (μ := μ) (m := past) (f := H) (g := X)
          hH_strong hHX_int hX_int)
    have hcondHX_int :
        @Integrable ℝ _ _ Ω mΩ
          (@MeasureTheory.condExp Ω ℝ past (m₀ := mΩ) _ _ _ μ
            (fun ω => H ω * X ω)) μ := by
      exact @MeasureTheory.integrable_condExp Ω ℝ past mΩ μ
        (fun ω => H ω * X ω) _ _ _
    have hHce_int : @Integrable ℝ _ _ Ω mΩ (fun ω => H ω * ceX ω) μ :=
      hcondHX_int.congr hpull
    have hHbound_int :
        @Integrable ℝ _ _ Ω mΩ (fun ω => H ω * bound) μ := by
      simpa [mul_comm] using hH_int.const_mul bound
    have hmul_le :
        (fun ω => H ω * ceX ω) ≤ᵐ[μ] (fun ω => H ω * bound) := by
      have hcond_le' : ceX ≤ᵐ[μ] (fun _ : Ω => bound) := by
        simpa [ceX] using hcond_le
      filter_upwards [hcond_le'] with ω hω
      exact mul_le_mul_of_nonneg_left hω (hH_nonneg ω)
    have hmono :
        (∫ ω, H ω * ceX ω ∂μ) ≤ (∫ ω, H ω * bound ∂μ) :=
      integral_mono_ae hHce_int hHbound_int hmul_le
    calc
      ∫ ω, H ω * X ω ∂μ
          = ∫ ω, (μ[(fun ω => H ω * X ω) | past]) ω ∂μ := by
              exact (MeasureTheory.integral_condExp
                (μ := μ) (m := past)
                (f := fun ω => H ω * X ω) hm).symm
      _ = ∫ ω, H ω * ceX ω ∂μ := by
              exact integral_congr_ae hpull
      _ ≤ ∫ ω, H ω * bound ∂μ := hmono
      _ = bound * ∫ ω, H ω ∂μ := by
              rw [integral_mul_const, mul_comm]

/-- Nonnegative predictable weights can be pulled through a conditional scalar
upper bound in the exponential-MGF case.  This removes the artificial
boundedness restriction by truncating the weight and applying monotone
convergence to the nonnegative products. -/
private theorem ConditionalRealExpectationLe.integrable_mul_and_integral_mul_le_const_of_nonneg_weight
    [mΩ : MeasurableSpace Ω] (μ : @Measure Ω mΩ)
    (past : MeasurableSpace Ω) (X H : Ω → ℝ) (bound : ℝ)
    (h : @ConditionalRealExpectationLe Ω mΩ μ past X (fun _ => bound))
    (hX_nonneg : ∀ ω : Ω, 0 ≤ X ω)
    (hbound_nonneg : 0 ≤ bound)
    (hH_meas : Measurable[past] H)
    (hH_nonneg : ∀ ω : Ω, 0 ≤ H ω)
    (hH_int : @Integrable ℝ _ _ Ω mΩ H μ) :
    @Integrable ℝ _ _ Ω mΩ (fun ω => H ω * X ω) μ ∧
      (@MeasureTheory.integral Ω ℝ _ _ mΩ μ
          (fun ω => H ω * X ω)) ≤
        bound * (@MeasureTheory.integral Ω ℝ _ _ mΩ μ H) := by
  classical
  rcases h with ⟨hwd, hcond_le⟩
  let HN : ℕ → Ω → ℝ := fun n ω => min (H ω) (n : ℝ)
  have h_repack :
      @ConditionalRealExpectationLe Ω mΩ μ past X (fun _ => bound) :=
    ⟨hwd, hcond_le⟩
  have hHN_meas : ∀ n : ℕ, Measurable[past] (HN n) := by
    intro n
    exact hH_meas.min measurable_const
  have hHN_nonneg : ∀ n : ℕ, ∀ ω : Ω, 0 ≤ HN n ω := by
    intro n ω
    exact le_min (hH_nonneg ω) (Nat.cast_nonneg n)
  have hHN_le_H : ∀ n : ℕ, ∀ ω : Ω, HN n ω ≤ H ω := by
    intro n ω
    exact min_le_left _ _
  have hHN_int : ∀ n : ℕ, @Integrable ℝ _ _ Ω mΩ (HN n) μ := by
    intro n
    refine hH_int.mono' ((hHN_meas n).mono hwd.1 le_rfl).aestronglyMeasurable ?_
    filter_upwards with ω
    have hn : 0 ≤ HN n ω := hHN_nonneg n ω
    have hle : HN n ω ≤ H ω := hHN_le_H n ω
    simpa [Real.norm_of_nonneg hn] using hle
  have hHN_bound : ∀ n : ℕ, ∀ ω : Ω, ‖HN n ω‖ ≤ (n : ℝ) := by
    intro n ω
    have hn : 0 ≤ HN n ω := hHN_nonneg n ω
    have hle : HN n ω ≤ (n : ℝ) := min_le_right _ _
    simpa [Real.norm_of_nonneg hn] using hle
  have htrunc :
      ∀ n : ℕ,
        @Integrable ℝ _ _ Ω mΩ (fun ω => HN n ω * X ω) μ ∧
          (∫ ω, HN n ω * X ω ∂μ) ≤
            bound * (∫ ω, HN n ω ∂μ) := by
    intro n
    exact
      @ConditionalRealExpectationLe.integrable_mul_and_integral_mul_le_const_of_bounded_weight
        Ω mΩ μ past X (HN n) bound (n : ℝ) h_repack
        (hHN_meas n) (hHN_nonneg n) (hHN_int n) (hHN_bound n)
  have hHN_integral_le : ∀ n : ℕ, (∫ ω, HN n ω ∂μ) ≤ ∫ ω, H ω ∂μ := by
    intro n
    exact integral_mono_ae (hHN_int n) hH_int
      (Filter.Eventually.of_forall fun ω => hHN_le_H n ω)
  have hH_integral_nonneg : 0 ≤ ∫ ω, H ω ∂μ :=
    integral_nonneg fun ω => hH_nonneg ω
  have hHX_aesm :
      AEStronglyMeasurable[mΩ] (fun ω => H ω * X ω) μ := by
    have hX_int : @Integrable ℝ _ _ Ω mΩ X μ :=
      @SOptLib.ConditionalExpectation.conditionalExpectationWellDefined.integrable
        Ω ℝ mΩ _ μ past X hwd
    exact hH_int.aestronglyMeasurable.mul hX_int.aestronglyMeasurable
  have hHX_nonneg : ∀ ω : Ω, 0 ≤ H ω * X ω := by
    intro ω
    exact mul_nonneg (hH_nonneg ω) (hX_nonneg ω)
  have h_lint_tendsto :
      Filter.Tendsto
        (fun n : ℕ => ∫⁻ ω, ENNReal.ofReal (HN n ω * X ω) ∂μ)
        Filter.atTop
        (𝓝 (∫⁻ ω, ENNReal.ofReal (H ω * X ω) ∂μ)) := by
    refine lintegral_tendsto_of_tendsto_of_monotone ?_ ?_ ?_
    · intro n
      exact (htrunc n).1.aemeasurable.ennreal_ofReal
    · filter_upwards with ω
      intro n m hnm
      refine ENNReal.ofReal_le_ofReal ?_
      exact mul_le_mul_of_nonneg_right
        (min_le_min_left (H ω) (Nat.cast_le.mpr hnm)) (hX_nonneg ω)
    · filter_upwards with ω
      have hev :
          ∀ᶠ n : ℕ in Filter.atTop, HN n ω * X ω = H ω * X ω := by
        rcases exists_nat_ge (H ω) with ⟨N, hN⟩
        refine Filter.eventually_atTop.2 ⟨N, ?_⟩
        intro n hn
        have hHN_eq : HN n ω = H ω := by
          have hle : H ω ≤ (n : ℝ) := le_trans hN (Nat.cast_le.mpr hn)
          exact min_eq_left hle
        simp [HN, hHN_eq]
      exact (ENNReal.continuous_ofReal.tendsto _).comp
        (tendsto_const_nhds.congr' (Filter.EventuallyEq.symm hev))
  have h_lint_bound :
      (∫⁻ ω, ENNReal.ofReal (H ω * X ω) ∂μ) ≤
        ENNReal.ofReal (bound * ∫ ω, H ω ∂μ) := by
    refine le_of_tendsto' h_lint_tendsto ?_
    intro n
    have h_nonneg_n : ∀ᵐ ω ∂μ, 0 ≤ HN n ω * X ω :=
      Filter.Eventually.of_forall fun ω =>
        mul_nonneg (hHN_nonneg n ω) (hX_nonneg ω)
    have h_lint_eq :
        ENNReal.ofReal (∫ ω, HN n ω * X ω ∂μ) =
          ∫⁻ ω, ENNReal.ofReal (HN n ω * X ω) ∂μ := by
      exact
        (ofReal_integral_eq_lintegral_ofReal (htrunc n).1 h_nonneg_n)
    rw [← h_lint_eq]
    refine ENNReal.ofReal_le_ofReal ?_
    calc
      (∫ ω, HN n ω * X ω ∂μ)
          ≤ bound * (∫ ω, HN n ω ∂μ) := (htrunc n).2
      _ ≤ bound * (∫ ω, H ω ∂μ) :=
          mul_le_mul_of_nonneg_left (hHN_integral_le n) hbound_nonneg
  have h_lint_ne_top :
      (∫⁻ ω, ENNReal.ofReal (H ω * X ω) ∂μ) ≠ (⊤ : ENNReal) := by
    exact ne_top_of_le_ne_top ENNReal.ofReal_ne_top h_lint_bound
  have hHX_int :
      @Integrable ℝ _ _ Ω mΩ (fun ω => H ω * X ω) μ := by
    exact
      (lintegral_ofReal_ne_top_iff_integrable hHX_aesm
        (Filter.Eventually.of_forall hHX_nonneg)).1 h_lint_ne_top
  constructor
  · exact hHX_int
  · have h_nonneg_ae : ∀ᵐ ω ∂μ, 0 ≤ H ω * X ω :=
      Filter.Eventually.of_forall hHX_nonneg
    have h_lint_eq :
        ENNReal.ofReal (∫ ω, H ω * X ω ∂μ) =
          ∫⁻ ω, ENNReal.ofReal (H ω * X ω) ∂μ := by
      exact ofReal_integral_eq_lintegral_ofReal hHX_int h_nonneg_ae
    have hofreal_le :
        ENNReal.ofReal (∫ ω, H ω * X ω ∂μ) ≤
          ENNReal.ofReal (bound * ∫ ω, H ω ∂μ) := by
      simpa [h_lint_eq] using h_lint_bound
    have h_rhs_nonneg : 0 ≤ bound * ∫ ω, H ω ∂μ :=
      mul_nonneg hbound_nonneg hH_integral_nonneg
    exact (ENNReal.ofReal_le_ofReal_iff h_rhs_nonneg).1 hofreal_le

/-- A conditional one-step exponential bound gives the weighted one-step MGF
inequality required by the finite prefix recurrence. -/
private theorem ConditionalRealExpectationLe.weighted_exp_one_step_mgf
    [mΩ : MeasurableSpace Ω] (μ : @Measure Ω mΩ)
    (past : MeasurableSpace Ω) (ζ H : Ω → ℝ) (ν cost : ℝ)
    (h :
      @ConditionalRealExpectationLe Ω mΩ μ past
        (fun ω => Real.exp (ν * ζ ω)) (fun _ => Real.exp cost))
    (hH_meas : Measurable[past] H)
    (hH_nonneg : ∀ ω : Ω, 0 ≤ H ω)
    (hH_int : @Integrable ℝ _ _ Ω mΩ H μ) :
    @Integrable ℝ _ _ Ω mΩ
        (fun ω => H ω * Real.exp (ν * ζ ω)) μ ∧
      (∫ ω, H ω * Real.exp (ν * ζ ω) ∂μ) ≤
        Real.exp cost * (∫ ω, H ω ∂μ) := by
  exact
    @ConditionalRealExpectationLe.integrable_mul_and_integral_mul_le_const_of_nonneg_weight
      Ω mΩ μ past (fun ω => Real.exp (ν * ζ ω)) H (Real.exp cost) h
      (fun ω => le_of_lt (Real.exp_pos _))
      (le_of_lt (Real.exp_pos _))
      hH_meas hH_nonneg hH_int

/-- A conditional exponential-moment certificate can be tested against any
nonnegative integrable predictable weight.  This is the weighted form of the
square-exponential premise needed in the conditional Lemma-4.1 MGF bridge. -/
private theorem ConditionalExpMomentLe.weighted_exp_and_integral_le
    [mΩ : MeasurableSpace Ω] (μ : @Measure Ω mΩ)
    (past : MeasurableSpace Ω) (exponent H : Ω → ℝ) (bound : ℝ)
    (h : @ConditionalExpMomentLe Ω mΩ μ past exponent bound)
    (hbound_nonneg : 0 ≤ bound)
    (hH_meas : Measurable[past] H)
    (hH_nonneg : ∀ ω : Ω, 0 ≤ H ω)
    (hH_int : @Integrable ℝ _ _ Ω mΩ H μ) :
    @Integrable ℝ _ _ Ω mΩ
        (fun ω => H ω * Real.exp (exponent ω)) μ ∧
      (∫ ω, H ω * Real.exp (exponent ω) ∂μ) ≤
        bound * (∫ ω, H ω ∂μ) := by
  exact
    @ConditionalRealExpectationLe.integrable_mul_and_integral_mul_le_const_of_nonneg_weight
      Ω mΩ μ past (fun ω => Real.exp (exponent ω)) H bound h
      (fun ω => le_of_lt (Real.exp_pos _))
      hbound_nonneg hH_meas hH_nonneg hH_int

/-- Conditional Jensen for fractional powers, packaged in the local
`ConditionalRealExpectationLe` interface. -/
private theorem ConditionalRealExpectationLe.rpow_le_const
    [mΩ : MeasurableSpace Ω] (μ : @Measure Ω mΩ) [IsProbabilityMeasure μ]
    (past : MeasurableSpace Ω) (Z : Ω → ℝ) (B p : ℝ)
    (h : @ConditionalRealExpectationLe Ω mΩ μ past Z (fun _ => B))
    (hZ_nonneg : 0 ≤ᵐ[μ] Z)
    (hp : p ∈ Set.Icc (0 : ℝ) 1) :
    @ConditionalRealExpectationLe Ω mΩ μ past
      (fun ω => Real.rpow (Z ω) p) (fun _ => Real.rpow B p) := by
  rcases h with ⟨hwd, hcond⟩
  rcases hwd with ⟨hm, hsf, hZ_int⟩
  letI : SigmaFinite (μ.trim hm) := hsf
  have hZ_rpow_aesm :
      AEStronglyMeasurable[mΩ] (fun ω => Real.rpow (Z ω) p) μ :=
    (Real.continuous_rpow_const hp.1).comp_aestronglyMeasurable
      hZ_int.aestronglyMeasurable
  have hZ_rpow_int : Integrable (fun ω => Real.rpow (Z ω) p) μ := by
    have hmajorant_int : Integrable (fun ω => Z ω + 1) μ :=
      hZ_int.add (integrable_const (c := (1 : ℝ)))
    refine hmajorant_int.mono' hZ_rpow_aesm ?_
    filter_upwards [hZ_nonneg] with ω hZω
    have hZω' : (0 : ℝ) ≤ Z ω := by
      simpa using hZω
    have hpow_nonneg : 0 ≤ Real.rpow (Z ω) p := Real.rpow_nonneg hZω' p
    rw [Real.norm_of_nonneg hpow_nonneg]
    by_cases hZ_le_one : Z ω ≤ 1
    · have hone_le : (1 : ℝ) ≤ Z ω + 1 := by linarith
      exact le_trans (Real.rpow_le_one hZω' hZ_le_one hp.1) hone_le
    · exact le_trans
        (Real.rpow_le_self_of_one_le (le_of_lt (lt_of_not_ge hZ_le_one)) hp.2)
        (by linarith)
  constructor
  · exact ⟨hm, hsf, hZ_rpow_int⟩
  · have hJensen :
        μ[(fun ω => Real.rpow (Z ω) p) | past] ≤ᵐ[μ]
          fun ω => Real.rpow (μ[Z | past] ω) p := by
      simpa [Function.comp_def] using
        (Real.concaveOn_rpow hp.1 hp.2).condExp_map_le
          (μ := μ) (m := past) (mα := mΩ) hm
          ((Real.continuous_rpow_const hp.1).continuousOn.upperSemicontinuousOn)
          hZ_nonneg isClosed_Ici hZ_int hZ_rpow_int
    have hce_nonneg : 0 ≤ᵐ[μ] μ[Z | past] :=
      MeasureTheory.condExp_nonneg hZ_nonneg
    filter_upwards [hJensen, hcond, hce_nonneg] with ω hJ hB hnonneg
    exact hJ.trans (Real.rpow_le_rpow hnonneg hB hp.1)

/-- Conditional fractional square-exponential control obtained from the
source quotient and conditional square-exponential certificate. -/
private theorem conditional_exp_square_fractional_moment_bound
    [mΩ : MeasurableSpace Ω] (μ : @Measure Ω mΩ) [IsProbabilityMeasure μ]
    (past : MeasurableSpace Ω) (X exponent : Ω → ℝ) (σ2 p : ℝ)
    (hsquare : @ConditionalExpMomentLe Ω mΩ μ past exponent (Real.exp 1))
    (hquot : ∀ ω : Ω, sourceQuotient (X ω ^ (2 : ℕ)) σ2 (exponent ω))
    (hp : p ∈ Set.Icc (0 : ℝ) 1) :
    @ConditionalRealExpectationLe Ω mΩ μ past
      (fun ω => Real.exp (p * (X ω ^ (2 : ℕ) / σ2)))
      (fun _ => Real.exp p) := by
  have hfrac :
      @ConditionalRealExpectationLe Ω mΩ μ past
        (fun ω => Real.rpow (Real.exp (exponent ω)) p)
        (fun _ => Real.rpow (Real.exp 1) p) := by
    exact
      @ConditionalRealExpectationLe.rpow_le_const Ω mΩ μ _ past
        (fun ω => Real.exp (exponent ω)) (Real.exp 1) p hsquare
        (Filter.Eventually.of_forall fun ω => le_of_lt (Real.exp_pos _)) hp
  have hfun_eq :
      (fun ω => Real.rpow (Real.exp (exponent ω)) p) =
        (fun ω => Real.exp (p * (X ω ^ (2 : ℕ) / σ2))) := by
    funext ω
    calc
      Real.rpow (Real.exp (exponent ω)) p = Real.exp (exponent ω * p) := by
        simpa using (Real.exp_mul (exponent ω) p).symm
      _ = Real.exp (p * (X ω ^ (2 : ℕ) / σ2)) := by
        rw [sourceQuotient_eq_div (hquot ω)]
        ring
  have hbound_eq : Real.rpow (Real.exp 1) p = Real.exp p := by
    simp
  rcases hfrac with ⟨hwd, hcond⟩
  constructor
  · rcases hwd with ⟨hm, hsf, hint⟩
    exact ⟨hm, hsf, by simpa [← hfun_eq] using hint⟩
  · have hce_eq :
        μ[(fun ω => Real.exp (p * (X ω ^ (2 : ℕ) / σ2))) | past] =ᵐ[μ]
          μ[(fun ω => Real.rpow (Real.exp (exponent ω)) p) | past] := by
      exact MeasureTheory.condExp_congr_ae
        (Filter.Eventually.of_forall fun ω => by
          exact (congrFun hfun_eq ω).symm)
    filter_upwards [hce_eq, hcond] with ω hω hle
    rw [hω]
    simpa [hbound_eq] using hle

/-- Square-completion domination used in the large-parameter branch of the
conditional scalar MGF bridge. -/
private theorem linear_le_quadratic_scaled
    {σ2 : ℝ} (hσ2_pos : 0 < σ2) (ν x : ℝ) :
    ν * x ≤ 3 * ν ^ 2 * σ2 / 8 + 2 * x ^ 2 / (3 * σ2) := by
  have hnonneg :
      0 ≤
        σ2 *
          (3 * ν ^ 2 * σ2 / 8 + 2 * x ^ 2 / (3 * σ2) - ν * x) := by
    field_simp [hσ2_pos.ne']
    nlinarith [sq_nonneg (4 * x - 3 * ν * σ2)]
  have hdiff :
      0 ≤ 3 * ν ^ 2 * σ2 / 8 + 2 * x ^ 2 / (3 * σ2) - ν * x :=
    (mul_nonneg_iff_of_pos_left hσ2_pos).mp hnonneg
  linarith

/-- Conditional Lemma-4.1 scalar bridge: a conditionally centered scalar with
a checked conditional square-exponential budget has a conditional linear-MGF
bound. -/
private theorem conditional_centered_exp_square_to_conditional_linear_mgf
    [mΩ : MeasurableSpace Ω] (μ : @Measure Ω mΩ) [IsProbabilityMeasure μ]
    (past : MeasurableSpace Ω) (X exponent : Ω → ℝ) (ν σ2 : ℝ)
    (hσ2_pos : 0 < σ2)
    (hzero :
      @SOptLib.ConditionalExpectation.conditionalExpectationEq Ω ℝ mΩ _ _ _ μ
        past X (0 : Ω → ℝ))
    (hsquare : @ConditionalExpMomentLe Ω mΩ μ past exponent (Real.exp 1))
    (hquot : ∀ ω : Ω, sourceQuotient (X ω ^ (2 : ℕ)) σ2 (exponent ω)) :
    @ConditionalRealExpectationLe Ω mΩ μ past
      (fun ω => Real.exp (ν * X ω))
      (fun _ => Real.exp (3 * ν ^ 2 * σ2 / 4)) := by
  classical
  rcases
      (@SOptLib.ConditionalExpectation.conditionalExpectationEq.wellDefined
        Ω ℝ mΩ _ _ _ μ past X (0 : Ω → ℝ) hzero) with
    ⟨hm, hsf, hX_int⟩
  letI : SigmaFinite (μ.trim hm) := hsf
  by_cases hsmall : ν ^ 2 * σ2 ≤ 16 / 9
  · let p : ℝ := 9 * ν ^ 2 * σ2 / 16
    have hp_nonneg : 0 ≤ p := by
      dsimp [p]
      positivity
    have hp_le_one : p ≤ 1 := by
      dsimp [p]
      nlinarith [hsmall]
    have hp : p ∈ Set.Icc (0 : ℝ) 1 := ⟨hp_nonneg, hp_le_one⟩
    have hp_bound_target : p ≤ 3 * ν ^ 2 * σ2 / 4 := by
      dsimp [p]
      nlinarith [sq_nonneg ν, hσ2_pos.le]
    have hfrac_p :
        @ConditionalRealExpectationLe Ω mΩ μ past
          (fun ω => Real.exp (p * (X ω ^ (2 : ℕ) / σ2)))
          (fun _ => Real.exp p) :=
      @conditional_exp_square_fractional_moment_bound Ω mΩ μ _ past X exponent
        σ2 p hsquare hquot hp
    rcases hfrac_p with ⟨hfrac_wd, hfrac_cond⟩
    have hfrac_int :
        @Integrable ℝ _ _ Ω mΩ
          (fun ω => Real.exp (p * (X ω ^ (2 : ℕ) / σ2))) μ :=
      @SOptLib.ConditionalExpectation.conditionalExpectationWellDefined.integrable
        Ω ℝ mΩ _ μ past
        (fun ω => Real.exp (p * (X ω ^ (2 : ℕ) / σ2))) hfrac_wd
    have hνX_int : @Integrable ℝ _ _ Ω mΩ (fun ω => ν * X ω) μ :=
      hX_int.const_mul ν
    have hcombo_int :
        @Integrable ℝ _ _ Ω mΩ
          (fun ω => ν * X ω + Real.exp (p * (X ω ^ (2 : ℕ) / σ2))) μ :=
      hνX_int.add hfrac_int
    have hlin_int :
        @Integrable ℝ _ _ Ω mΩ (fun ω => Real.exp (ν * X ω)) μ := by
      refine Integrable.mono' ((hνX_int.norm).add hfrac_int)
        (Real.continuous_exp.comp_aestronglyMeasurable
          (hνX_int.aestronglyMeasurable)) ?_
      refine Filter.Eventually.of_forall fun ω => ?_
      have hpoint :=
        Real.exp_le_self_add_exp_nine_mul_sq_div_sixteen (ν * X ω)
      have hsq_exp :
          Real.exp (9 * (ν * X ω) ^ 2 / 16) =
            Real.exp (p * (X ω ^ (2 : ℕ) / σ2)) := by
        congr 1
        dsimp [p]
        field_simp [hσ2_pos.ne']
      have hpoint' :
          Real.exp (ν * X ω) ≤
            ν * X ω + Real.exp (p * (X ω ^ (2 : ℕ) / σ2)) := by
        simpa [hsq_exp] using hpoint
      have hnonneg : 0 ≤ Real.exp (ν * X ω) := le_of_lt (Real.exp_pos _)
      rw [Real.norm_of_nonneg hnonneg]
      have habs_bound :
          ν * X ω + Real.exp (p * (X ω ^ (2 : ℕ) / σ2)) ≤
            ‖ν * X ω‖ + Real.exp (p * (X ω ^ (2 : ℕ) / σ2)) := by
        rw [Real.norm_eq_abs]
        nlinarith [le_abs_self (ν * X ω)]
      exact hpoint'.trans habs_bound
    constructor
    · exact ⟨hm, hsf, hlin_int⟩
    · have hpoint_ae :
          (fun ω => Real.exp (ν * X ω)) ≤ᵐ[μ]
            (fun ω => ν * X ω + Real.exp (p * (X ω ^ (2 : ℕ) / σ2))) := by
        refine Filter.Eventually.of_forall fun ω => ?_
        have hbase :=
          Real.exp_le_self_add_exp_nine_mul_sq_div_sixteen (ν * X ω)
        have hsq_exp :
            Real.exp (9 * (ν * X ω) ^ 2 / 16) =
              Real.exp (p * (X ω ^ (2 : ℕ) / σ2)) := by
          congr 1
          dsimp [p]
          field_simp [hσ2_pos.ne']
        simpa [hsq_exp] using hbase
      have hmono :
          μ[(fun ω => Real.exp (ν * X ω)) | past] ≤ᵐ[μ]
            μ[(fun ω => ν * X ω +
                Real.exp (p * (X ω ^ (2 : ℕ) / σ2))) | past] :=
        MeasureTheory.condExp_mono (μ := μ) (m := past)
          hlin_int hcombo_int hpoint_ae
      have hadd :
          μ[(fun ω => ν * X ω +
              Real.exp (p * (X ω ^ (2 : ℕ) / σ2))) | past] =ᵐ[μ]
            μ[(fun ω => ν * X ω) | past] +
              μ[(fun ω => Real.exp (p * (X ω ^ (2 : ℕ) / σ2))) | past] :=
        MeasureTheory.condExp_add (μ := μ) hνX_int hfrac_int past
      have hsmul :
          μ[(fun ω => ν * X ω) | past] =ᵐ[μ]
            fun ω => ν * μ[X | past] ω := by
        simpa [Pi.smul_apply, smul_eq_mul] using
          (MeasureTheory.condExp_smul (μ := μ) (m := past) ν X)
      have hzero_ae : μ[X | past] =ᵐ[μ] (0 : Ω → ℝ) :=
        @SOptLib.ConditionalExpectation.conditionalExpectationEq.ae_eq
          Ω ℝ mΩ _ _ _ μ past X (0 : Ω → ℝ) hzero
      filter_upwards [hmono, hadd, hsmul, hzero_ae, hfrac_cond] with
        ω hmonoω haddω hsmulω hzeroω hfracω
      calc
        μ[(fun ω => Real.exp (ν * X ω)) | past] ω
            ≤ μ[(fun ω => ν * X ω +
                Real.exp (p * (X ω ^ (2 : ℕ) / σ2))) | past] ω := hmonoω
        _ = μ[(fun ω => ν * X ω) | past] ω +
              μ[(fun ω => Real.exp (p * (X ω ^ (2 : ℕ) / σ2))) | past] ω := by
              simpa [Pi.add_apply] using haddω
        _ = ν * μ[X | past] ω +
              μ[(fun ω => Real.exp (p * (X ω ^ (2 : ℕ) / σ2))) | past] ω := by
              rw [hsmulω]
        _ = μ[(fun ω => Real.exp (p * (X ω ^ (2 : ℕ) / σ2))) | past] ω := by
              have hν_zero : ν * μ[X | past] ω = 0 := by
                rw [hzeroω]
                simp
              rw [hν_zero, zero_add]
        _ ≤ Real.exp p := hfracω
        _ ≤ Real.exp (3 * ν ^ 2 * σ2 / 4) :=
              Real.exp_le_exp.mpr hp_bound_target
  · have hlarge : 16 / 9 ≤ ν ^ 2 * σ2 := le_of_not_ge hsmall
    let θ : ℝ := (2 : ℝ) / 3
    let C : ℝ := Real.exp (3 * ν ^ 2 * σ2 / 8)
    have hθ : θ ∈ Set.Icc (0 : ℝ) 1 := by
      dsimp [θ]
      norm_num
    have hfracθ :
        @ConditionalRealExpectationLe Ω mΩ μ past
          (fun ω => Real.exp (θ * (X ω ^ (2 : ℕ) / σ2)))
          (fun _ => Real.exp θ) :=
      @conditional_exp_square_fractional_moment_bound Ω mΩ μ _ past X exponent
        σ2 θ hsquare hquot hθ
    rcases hfracθ with ⟨hfrac_wd, hfrac_cond⟩
    have hfrac_int :
        @Integrable ℝ _ _ Ω mΩ
          (fun ω => Real.exp (θ * (X ω ^ (2 : ℕ) / σ2))) μ :=
      @SOptLib.ConditionalExpectation.conditionalExpectationWellDefined.integrable
        Ω ℝ mΩ _ μ past
        (fun ω => Real.exp (θ * (X ω ^ (2 : ℕ) / σ2))) hfrac_wd
    have htarget_aesm :
        AEStronglyMeasurable[mΩ] (fun ω => Real.exp (ν * X ω)) μ :=
      Real.continuous_exp.comp_aestronglyMeasurable
        ((hX_int.aestronglyMeasurable).const_mul ν)
    have hdom_int :
        @Integrable ℝ _ _ Ω mΩ
          (fun ω => C * Real.exp (θ * (X ω ^ (2 : ℕ) / σ2))) μ :=
      hfrac_int.const_mul C
    have hpoint :
        ∀ ω,
          Real.exp (ν * X ω) ≤
            C * Real.exp (θ * (X ω ^ (2 : ℕ) / σ2)) := by
      intro ω
      have hyoung :=
        linear_le_quadratic_scaled (hσ2_pos := hσ2_pos) ν (X ω)
      have hquad :
          2 * X ω ^ (2 : ℕ) / (3 * σ2) =
            θ * (X ω ^ (2 : ℕ) / σ2) := by
        dsimp [θ]
        field_simp [hσ2_pos.ne']
      calc
        Real.exp (ν * X ω)
            ≤ Real.exp
                (3 * ν ^ 2 * σ2 / 8 +
                  θ * (X ω ^ (2 : ℕ) / σ2)) :=
              Real.exp_le_exp.mpr (by simpa [hquad] using hyoung)
        _ = C * Real.exp (θ * (X ω ^ (2 : ℕ) / σ2)) := by
          dsimp [C]
          rw [Real.exp_add]
    have hlin_int :
        @Integrable ℝ _ _ Ω mΩ (fun ω => Real.exp (ν * X ω)) μ := by
      refine Integrable.mono' hdom_int htarget_aesm ?_
      refine Filter.Eventually.of_forall fun ω => ?_
      have hnonneg : 0 ≤ Real.exp (ν * X ω) := le_of_lt (Real.exp_pos _)
      rw [Real.norm_of_nonneg hnonneg]
      exact hpoint ω
    constructor
    · exact ⟨hm, hsf, hlin_int⟩
    · have hpoint_ae :
          (fun ω => Real.exp (ν * X ω)) ≤ᵐ[μ]
            (fun ω => C * Real.exp (θ * (X ω ^ (2 : ℕ) / σ2))) :=
        Filter.Eventually.of_forall hpoint
      have hmono :
          μ[(fun ω => Real.exp (ν * X ω)) | past] ≤ᵐ[μ]
            μ[(fun ω => C *
                Real.exp (θ * (X ω ^ (2 : ℕ) / σ2))) | past] :=
        MeasureTheory.condExp_mono (μ := μ) (m := past)
          hlin_int hdom_int hpoint_ae
      have hsmul :
          μ[(fun ω => C * Real.exp (θ * (X ω ^ (2 : ℕ) / σ2))) | past] =ᵐ[μ]
            fun ω =>
              C * μ[(fun ω => Real.exp (θ * (X ω ^ (2 : ℕ) / σ2))) | past] ω := by
        simpa [Pi.smul_apply, smul_eq_mul] using
          (MeasureTheory.condExp_smul (μ := μ) (m := past) C
            (fun ω => Real.exp (θ * (X ω ^ (2 : ℕ) / σ2))))
      have hconst_nonneg : 0 ≤ C := le_of_lt (Real.exp_pos _)
      have hlarge_compare :
          3 * ν ^ 2 * σ2 / 8 + θ ≤ 3 * ν ^ 2 * σ2 / 4 := by
        dsimp [θ]
        nlinarith [hlarge]
      filter_upwards [hmono, hsmul, hfrac_cond] with ω hmonoω hsmulω hfracω
      calc
        μ[(fun ω => Real.exp (ν * X ω)) | past] ω
            ≤ μ[(fun ω => C *
                Real.exp (θ * (X ω ^ (2 : ℕ) / σ2))) | past] ω := hmonoω
        _ = C *
              μ[(fun ω => Real.exp (θ * (X ω ^ (2 : ℕ) / σ2))) | past] ω := hsmulω
        _ ≤ C * Real.exp θ :=
              mul_le_mul_of_nonneg_left hfracω hconst_nonneg
        _ = Real.exp (3 * ν ^ 2 * σ2 / 8 + θ) := by
              dsimp [C]
              rw [Real.exp_add]
        _ ≤ Real.exp (3 * ν ^ 2 * σ2 / 4) :=
              Real.exp_le_exp.mpr hlarge_compare

/-- Unweighted Lemma-4.1 one-step bridge: a conditionally centered scalar with
a checked conditional square-exponential budget has the scalar linear-MGF
bound.  This is the `H = 1` core of the weighted prefix step. -/
private theorem conditional_centered_exp_square_to_unweighted_one_step_mgf
    [mΩ : MeasurableSpace Ω] (μ : @Measure Ω mΩ) [IsProbabilityMeasure μ]
    (past : MeasurableSpace Ω) (X exponent : Ω → ℝ) (ν σ2 : ℝ)
    (hσ2_pos : 0 < σ2)
    (hzero :
      @SOptLib.ConditionalExpectation.conditionalExpectationEq Ω ℝ mΩ _ _ _ μ
        past X (0 : Ω → ℝ))
    (hsquare : @ConditionalExpMomentLe Ω mΩ μ past exponent (Real.exp 1))
    (hquot : ∀ ω : Ω, sourceQuotient (X ω ^ (2 : ℕ)) σ2 (exponent ω)) :
    Integrable (fun ω => Real.exp (ν * X ω)) μ ∧
      (∫ ω, Real.exp (ν * X ω) ∂μ) ≤ Real.exp (3 * ν ^ 2 * σ2 / 4) := by
  have hX_int : Integrable X μ :=
    @SOptLib.ConditionalExpectation.conditionalExpectationWellDefined.integrable
      Ω ℝ mΩ _ μ past X
      (@SOptLib.ConditionalExpectation.conditionalExpectationEq.wellDefined
        Ω ℝ mΩ _ _ _ μ past X (0 : Ω → ℝ) hzero)
  have hX_centered : (∫ ω, X ω ∂μ) = 0 := by
    have h :=
      @SOptLib.ConditionalExpectation.conditionalExpectationEq.integral_eq
        Ω ℝ mΩ _ _ _ μ past X (0 : Ω → ℝ) hzero
    simpa using h
  have hsquare_uncond :=
    @ConditionalExpMomentLe.integrable_exp_and_integral_le
      Ω mΩ μ _ past exponent (Real.exp 1) hsquare
  have hsq_fun_eq :
      (fun ω => Real.exp (X ω ^ (2 : ℕ) / σ2)) =
        (fun ω => Real.exp (exponent ω)) := by
    funext ω
    rw [sourceQuotient_eq_div (hquot ω)]
  have hexp_sq_int :
      Integrable (fun ω => Real.exp (X ω ^ (2 : ℕ) / σ2)) μ := by
    simpa [hsq_fun_eq, SOptLib.expectationWellDefined_iff_integrable] using
      hsquare_uncond.1
  have hexp_sq_bound :
      (∫ ω, Real.exp (X ω ^ (2 : ℕ) / σ2) ∂μ) ≤ Real.exp 1 := by
    simpa [hsq_fun_eq] using hsquare_uncond.2
  exact @centered_exp_square_moment_to_linear_mgf_bound
    Ω mΩ μ _ X ν σ2
    hσ2_pos hX_int hX_centered hexp_sq_int hexp_sq_bound

/-- Conditional centering is preserved under deterministic scalar
multiplication. -/
private theorem conditionalExpectationEq_const_mul_zero
    [mΩ : MeasurableSpace Ω] (μ : @Measure Ω mΩ)
    (past : MeasurableSpace Ω) (X : Ω → ℝ) (c : ℝ)
    (hzero :
      @SOptLib.ConditionalExpectation.conditionalExpectationEq Ω ℝ mΩ _ _ _ μ
        past X (0 : Ω → ℝ)) :
    @SOptLib.ConditionalExpectation.conditionalExpectationEq Ω ℝ mΩ _ _ _ μ
      past (fun ω => c * X ω) (0 : Ω → ℝ) := by
  constructor
  · rcases
      (@SOptLib.ConditionalExpectation.conditionalExpectationEq.wellDefined
        Ω ℝ mΩ _ _ _ μ past X (0 : Ω → ℝ) hzero) with
      ⟨hm, hsf, hX_int⟩
    exact ⟨hm, hsf, hX_int.const_mul c⟩
  · have hscaled :
        μ[(fun ω => c * X ω) | past] =ᵐ[μ] c • μ[X | past] := by
      simpa [Pi.smul_apply, smul_eq_mul] using
        (MeasureTheory.condExp_smul (μ := μ) (m := past) c X)
    refine hscaled.trans ?_
    filter_upwards
      [@SOptLib.ConditionalExpectation.conditionalExpectationEq.ae_eq
        Ω ℝ mΩ _ _ _ μ past X (0 : Ω → ℝ) hzero] with ω hω
    simp [Pi.smul_apply, hω]

/-- Exponential-square transport for residuals after conditioning/adaptive-query
selection.  It represents the Assumption-11 quotient without using Lean's total
division at a zero denominator, and the exponential moment is conditioned on the
pre-call history. -/
noncomputable def ResidualLightTailProcess [MeasurableSpace Ω]
    (μ : Measure Ω) (past : ℕ → MeasurableSpace Ω)
    (delta : ℕ → Ω → E) (dualNorm : E → ℝ) (sigma : ℝ) : Prop :=
  ∃ exponent : ℕ → Ω → ℝ,
    (∀ i : ℕ, ConditionalExpMomentLe μ (past i) (exponent i) (Real.exp 1)) ∧
      (∀ i : ℕ, ∀ ω : Ω,
        sourceQuotient (dualNorm (delta i ω) ^ (2 : ℕ)) (sigma ^ (2 : ℕ))
          (exponent i ω))

/-- Inner-product light-tail interface for Lemma 4.1 applications such as
`<Delta G^i, r_i-w_i^v>` and `<Delta H^{2i}, w_{i+1}-w_i^v>`. -/
noncomputable def InnerProductLightTailProcess [MeasurableSpace Ω]
    (μ : Measure Ω) (past : ℕ → MeasurableSpace Ω)
    (delta pair : ℕ → Ω → E) (scale : ℕ → ℝ)
    (sigma D : ℝ) : Prop :=
  ∃ exponent : ℕ → Ω → ℝ,
    (∀ i : ℕ, ConditionalExpMomentLe μ (past i) (exponent i) (Real.exp 1)) ∧
      (∀ i : ℕ, ∀ ω : Ω,
        sourceQuotient ((scale i * ⟪delta i ω, pair i ω⟫_ℝ) ^ (2 : ℕ))
          (2 * (sigma * scale i * D) ^ (2 : ℕ)) (exponent i ω))

/-- Source exponent for the weighted square-noise average in (4.5.50):
`(1/S) * sum_i S_i ||Delta_i||_*^2 / sigma^2`, represented as a single
checked quotient for the whole finite horizon rather than as per-index weighted
exponents.  The Lean index `i = 0, ..., t-1` corresponds to paper
`i = 1, ..., t`. -/
noncomputable def WeightedSquareAverageExponentSpec
    (delta : ℕ → Ω → E) (dualNorm : E → ℝ)
    (weight : ℕ → ℝ) (sigma : ℝ) (t : {n : ℕ // 1 ≤ n})
    (exponent : Ω → ℝ) : Prop :=
  ∀ ω : Ω,
    sourceQuotient
      ((Finset.range t.1).sum
        (fun i => weight i * dualNorm (delta i ω) ^ (2 : ℕ)))
      (((Finset.range t.1).sum weight) * sigma ^ (2 : ℕ))
      (exponent ω)

/-- Weighted-square light-tail conclusion used for the square-noise tail terms
in (4.5.50)-(4.5.52).  This is the normalized finite weighted-average
exponential moment derived from Assumption 11 by convexity of `exp`, not a
primitive per-index light-tail assumption. -/
noncomputable def WeightedSquareLightTailProcess [MeasurableSpace Ω]
    (μ : Measure Ω) (delta : ℕ → Ω → E) (dualNorm : E → ℝ)
    (weight : ℕ → ℝ) (sigma : ℝ) : Prop :=
  ∀ t : {n : ℕ // 1 ≤ n},
    ∃ exponent : Ω → ℝ,
      WeightedSquareAverageExponentSpec delta dualNorm weight sigma t exponent ∧
        SOptLib.expectationWellDefined μ (fun ω => Real.exp (exponent ω)) ∧
          (∫ ω, Real.exp (exponent ω) ∂μ) ≤ Real.exp 1

/-- If an exponential transform is integrable, then the underlying real
random variable is a.e. strongly measurable. -/
private theorem aestronglyMeasurable_of_integrable_exp
    [MeasurableSpace Ω] {μ : Measure Ω} {U : Ω → ℝ}
    (h : Integrable (fun ω => Real.exp (U ω)) μ) :
    AEStronglyMeasurable U μ := by
  have hExpAEM : AEMeasurable (fun ω => Real.exp (U ω)) μ := h.aemeasurable
  have hlogAEM : AEMeasurable (fun ω : Ω => Real.log (Real.exp (U ω))) μ :=
    (Real.measurable_log.aemeasurable
      (μ := Measure.map (fun ω : Ω => Real.exp (U ω)) μ)).comp_aemeasurable hExpAEM
  simpa [Real.log_exp] using hlogAEM.aestronglyMeasurable

/-- Pointwise checked source quotients aggregate to the finite weighted
square-average source quotient. -/
private theorem weighted_square_sourceQuotient_of_pointwise
    {Ω E : Type*} (delta : ℕ → Ω → E) (dualNorm : E → ℝ)
    (weight : ℕ → ℝ) (sigma : ℝ) (t : {n : ℕ // 1 ≤ n})
    (singleExp : ℕ → Ω → ℝ)
    (htotal_pos : 0 < (Finset.range t.1).sum weight)
    (hsource_quot : ∀ i : ℕ, ∀ ω : Ω,
      sourceQuotient (dualNorm (delta i ω) ^ (2 : ℕ)) (sigma ^ (2 : ℕ))
        (singleExp i ω)) :
    WeightedSquareAverageExponentSpec delta dualNorm weight sigma t
      (fun ω =>
        (Finset.range t.1).sum
          (fun i => (weight i / (Finset.range t.1).sum weight) * singleExp i ω)) := by
  intro ω
  unfold sourceQuotient
  constructor
  · exact mul_ne_zero (ne_of_gt htotal_pos) (hsource_quot 0 ω).1
  · have htotal_ne : (Finset.range t.1).sum weight ≠ 0 := ne_of_gt htotal_pos
    calc
      ((Finset.range t.1).sum
          (fun i => (weight i / (Finset.range t.1).sum weight) * singleExp i ω)) *
          (((Finset.range t.1).sum weight) * sigma ^ (2 : ℕ))
          =
          (Finset.range t.1).sum
            (fun i =>
              ((weight i / (Finset.range t.1).sum weight) * singleExp i ω) *
                (((Finset.range t.1).sum weight) * sigma ^ (2 : ℕ))) := by
            rw [Finset.sum_mul]
      _ = (Finset.range t.1).sum
            (fun i => weight i * dualNorm (delta i ω) ^ (2 : ℕ)) := by
            refine Finset.sum_congr rfl ?_
            intro i _hi
            have hqi := (hsource_quot i ω).2
            calc
              ((weight i / (Finset.range t.1).sum weight) * singleExp i ω) *
                  (((Finset.range t.1).sum weight) * sigma ^ (2 : ℕ))
                  = weight i * (singleExp i ω * sigma ^ (2 : ℕ)) := by
                    field_simp [htotal_ne]
              _ = weight i * dualNorm (delta i ω) ^ (2 : ℕ) := by
                    rw [hqi]

/-- Termwise checked square light-tail exponents yield the weighted square
average exponent and its finite Jensen exponential-moment bound. -/
private theorem weighted_square_average_from_pointwise_light_tail
    [MeasurableSpace Ω] {μ : Measure Ω} {E : Type*}
    (delta : ℕ → Ω → E) (dualNorm : E → ℝ)
    (weight : ℕ → ℝ) (sigma : ℝ) (t : {n : ℕ // 1 ≤ n})
    (singleExp : ℕ → Ω → ℝ)
    (htotal_pos : 0 < (Finset.range t.1).sum weight)
    (htheta_nonneg :
      ∀ i ∈ Finset.range t.1,
        0 ≤ weight i / (Finset.range t.1).sum weight)
    (htheta_sum :
      (Finset.range t.1).sum
        (fun i => weight i / (Finset.range t.1).sum weight) = 1)
    (hterm_bound :
      ∀ i ∈ Finset.range t.1,
        SOptLib.expectationWellDefined μ
            (fun ω => Real.exp (singleExp i ω)) ∧
          (∫ ω, Real.exp (singleExp i ω) ∂μ) ≤ Real.exp 1)
    (hsource_quot : ∀ i : ℕ, ∀ ω : Ω,
      sourceQuotient (dualNorm (delta i ω) ^ (2 : ℕ)) (sigma ^ (2 : ℕ))
        (singleExp i ω)) :
    ∃ exponent : Ω → ℝ,
      WeightedSquareAverageExponentSpec delta dualNorm weight sigma t exponent ∧
        SOptLib.expectationWellDefined μ (fun ω => Real.exp (exponent ω)) ∧
          (∫ ω, Real.exp (exponent ω) ∂μ) ≤ Real.exp 1 := by
  let theta : ℕ → ℝ := fun i => weight i / (Finset.range t.1).sum weight
  let exponent : Ω → ℝ := fun ω =>
    (Finset.range t.1).sum (fun i => theta i * singleExp i ω)
  have hU_aesm :
      ∀ i ∈ Finset.range t.1, AEStronglyMeasurable (singleExp i) μ := by
    intro i hi
    exact aestronglyMeasurable_of_integrable_exp (hterm_bound i hi).1
  have hU_exp_int :
      ∀ i ∈ Finset.range t.1,
        Integrable (fun ω => Real.exp (singleExp i ω)) μ := by
    intro i hi
    simpa [SOptLib.expectationWellDefined_iff_integrable] using
      (hterm_bound i hi).1
  have hU_exp_bound :
      ∀ i ∈ Finset.range t.1,
        (∫ ω, Real.exp (singleExp i ω) ∂μ) ≤ Real.exp 1 := by
    intro i hi
    exact (hterm_bound i hi).2
  have hJ :=
    integrable_exp_weighted_sum_le_of_exp_integral_bounds μ
      (Finset.range t.1) theta singleExp (Real.exp 1)
      hU_aesm
      (by simpa [theta] using htheta_nonneg)
      (by simpa [theta] using htheta_sum)
      hU_exp_int hU_exp_bound
  refine ⟨exponent, ?_, ?_, ?_⟩
  · simpa [exponent, theta] using
      weighted_square_sourceQuotient_of_pointwise delta dualNorm weight sigma t
        singleExp htotal_pos hsource_quot
  · simpa [SOptLib.expectationWellDefined_iff_integrable, exponent] using hJ.1
  · simpa [exponent] using hJ.2

/-- Full Lean stream realization needed by the interleaved SAMP residual proof:
measurable iid coordinate streams with fixed marginal laws, independent streams,
and iid interleaved blocks `chi_i=(zeta_{2i-1}, xi_i, zeta_{2i})`.  This is not
part of the source Assumption 10 statement. -/
def SAMPOracleStreamBoundary [MeasurableSpace Ω] [MeasurableSpace Ξ]
    [MeasurableSpace Ζ] (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω)
    (xiLaw : Measure Ξ) (zetaLaw : Measure Ζ) : Prop :=
  OracleSampleBoundary sample μ xiLaw zetaLaw ∧
    iIndepFun (interleavedOracleBlock sample) μ

/-- Interleaved history/adaptedness boundary for the generated SAMP recursion.
It records the pre-call sigma-algebras used by the proof before (4.5.47);
deriving these facts requires the measurable prox-selector and auxiliary
recursion route, so they are deliberately not hidden inside Assumption 10. -/
def SAMPInterleavedOracleHistoryBoundary [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E]
    (sample : Ω → SamplePath Ξ Ζ) : Prop :=
  (∀ i : ℕ, Measurable[interleavedPriorHistory sample i]
      (fun ω => S.rSeq (sample ω) i)) ∧
  (∀ i : ℕ, Measurable[interleavedPriorHistory sample i]
      (fun ω => S.wSeq (sample ω) i)) ∧
  (∀ i : ℕ, Measurable (fun ω => S.barSeq (sample ω) i)) ∧
  (∀ i : ℕ, Measurable[interleavedPriorHistory sample i]
      (fun ω => S.auxiliarySeq (sample ω) i)) ∧
  (∀ i : ℕ, Measurable[interleavedGHistory sample i]
      (fun ω => (S.rSeq (sample ω) i).1 - (S.auxiliarySeq (sample ω) i).1)) ∧
  (∀ i : ℕ, Measurable[interleavedGCurrent sample i]
      (fun ω => S.firstProx (sample ω) i (S.stateProcess (sample ω) i))) ∧
  (∀ i : ℕ, Measurable[interleavedEvenHHistory sample i]
      (fun ω =>
        (S.firstProx (sample ω) i (S.stateProcess (sample ω) i)).1 -
          (S.auxiliarySeq (sample ω) i).1))

/-- Conditional adaptive-query oracle law boundary consumed by the expectation
part of Theorem 4.10.  The source prints fixed-query moment bounds, while the
proof uses these conditional laws at the generated adaptive queries. -/
noncomputable def SAMPInterleavedConditionalOracleLawBoundary [MeasurableSpace Ω]
    (S : Setup Ξ Ζ E) [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) : Prop :=
  AdaptiveDualCenteredOracleProcess μ
    (fun i => interleavedGHistory sample i)
    (fun i => interleavedGCurrent sample i)
    (S.deltaGProcess sample) S.dualNorm (fun _ => S.sigmaG ^ (2 : ℕ)) ∧
  AdaptiveDualCenteredOracleProcess μ
    (fun i => interleavedPriorHistory sample i)
    (fun i => interleavedOddHCurrent sample i)
    (S.deltaHOddProcess sample) S.dualNorm (fun _ => S.sigmaH ^ (2 : ℕ)) ∧
  AdaptiveDualCenteredOracleProcess μ
    (fun i => interleavedEvenHHistory sample i)
    (fun i => interleavedEvenHCurrent sample i)
    (S.deltaHEvenProcess sample) S.dualNorm (fun _ => S.sigmaH ^ (2 : ℕ)) ∧
  ConditionalInnerProductZeroProcess μ
    (fun i => interleavedGHistory sample i)
    (S.deltaGProcess sample)
    (fun i ω => (S.rSeq (sample ω) i).1 - (S.auxiliarySeq (sample ω) i).1) ∧
  ConditionalInnerProductZeroProcess μ
    (fun i => interleavedEvenHHistory sample i)
    (S.deltaHEvenProcess sample)
    (fun i ω =>
      (S.firstProx (sample ω) i (S.stateProcess (sample ω) i)).1 -
        (S.auxiliarySeq (sample ω) i).1)

/-- Conditional light-tail boundary consumed by the high-probability part of
Theorem 4.10.  Assumption 11 is fixed-query; this predicate is the explicit
adaptive-query transport needed for the Lemma 4.1 instantiation. -/
noncomputable def SAMPInterleavedLightTailBoundary [MeasurableSpace Ω]
    (S : Setup Ξ Ζ E) [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) : Prop :=
  ResidualLightTailProcess μ
      (fun i => interleavedGHistory sample i)
      (S.deltaGProcess sample) S.dualNorm S.sigmaG ∧
    ResidualLightTailProcess μ
      (fun i => interleavedPriorHistory sample i)
      (S.deltaHOddProcess sample) S.dualNorm S.sigmaH ∧
    ResidualLightTailProcess μ
      (fun i => interleavedEvenHHistory sample i)
      (S.deltaHEvenProcess sample) S.dualNorm S.sigmaH ∧
    InnerProductLightTailProcess μ
      (fun i => interleavedGHistory sample i)
      (S.deltaGProcess sample)
      (fun i ω => (S.rSeq (sample ω) i).1 - (S.auxiliarySeq (sample ω) i).1)
      (fun i => S.alpha (paperTime i).1 / S.Gamma (paperTime i).1) S.sigmaG S.DZ ∧
    InnerProductLightTailProcess μ
      (fun i => interleavedEvenHHistory sample i)
      (S.deltaHEvenProcess sample)
      (fun i ω =>
        (S.firstProx (sample ω) i (S.stateProcess (sample ω) i)).1 -
          (S.auxiliarySeq (sample ω) i).1)
      (fun i => S.alpha (paperTime i).1 / S.Gamma (paperTime i).1) S.sigmaH S.DZ

/-- The weighted G square-noise exponential average used in (4.5.50) is derived
from the G residual light-tail component of the interleaved boundary together
with the source parameter weights `S_i = alpha_i gamma_i / Gamma_i`.  The proof
is the finite Jensen/Markov transport recorded in the paper. -/
theorem SAMPInterleavedLightTailBoundary.G_weightedSquareLightTail
    [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) [IsProbabilityMeasure μ]
    (h : S.SAMPInterleavedLightTailBoundary sample μ) :
    WeightedSquareLightTailProcess μ
      (S.deltaGProcess sample) S.dualNorm
      (fun i => S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
        S.Gamma (paperTime i).1) S.sigmaG := by
  intro t
  rcases h.1 with ⟨singleExp, hsingleCond, hsingleQuot⟩
  let rawWeight : ℕ → ℝ := fun i =>
    S.alpha (paperTime i).1 * S.gamma (paperTime i).1 / S.Gamma (paperTime i).1
  let totalWeight : ℝ := (Finset.range t.1).sum rawWeight
  let theta : ℕ → ℝ := fun i => rawWeight i / totalWeight
  have htotal_pos : 0 < totalWeight := by
    simpa [rawWeight, totalWeight] using S.weightedSquareWeights_sum_pos t
  have htheta_nonneg : ∀ i ∈ Finset.range t.1, 0 ≤ theta i := by
    simpa [rawWeight, totalWeight, theta] using
      S.weightedSquareNormalizedWeights_nonneg t
  have htheta_sum : (Finset.range t.1).sum theta = 1 := by
    simpa [rawWeight, totalWeight, theta] using
      S.weightedSquareNormalizedWeights_sum t
  have hterm_bound :
      ∀ i ∈ Finset.range t.1,
        SOptLib.expectationWellDefined μ
            (fun ω => Real.exp (singleExp i ω)) ∧
          (∫ ω, Real.exp (singleExp i ω) ∂μ) ≤ Real.exp 1 := by
    intro i _hi
    exact ConditionalExpMomentLe.integrable_exp_and_integral_le
      μ (interleavedGHistory sample i) (singleExp i) (Real.exp 1)
      (hsingleCond i)
  have hsource_quot := hsingleQuot
  simpa [rawWeight] using
    weighted_square_average_from_pointwise_light_tail
      (μ := μ) (delta := S.deltaGProcess sample) (dualNorm := S.dualNorm)
      (weight := rawWeight) (sigma := S.sigmaG) (t := t)
      (singleExp := singleExp)
      (by simpa [totalWeight] using htotal_pos)
      (by simpa [theta, totalWeight] using htheta_nonneg)
      (by simpa [theta, totalWeight] using htheta_sum)
      hterm_bound hsource_quot

