/-- A weighted-square exponential-moment certificate gives the corresponding
strict Markov tail bound for the unnormalized weighted square sum. -/
private theorem weightedSquareLightTailProcess_tail_probability_le_exp_neg
    [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ] {E : Type*}
    (delta : ℕ → Ω → E) (dualNorm : E → ℝ)
    (weight : ℕ → ℝ) (sigma : ℝ) (t : {n : ℕ // 1 ≤ n}) (lambda : ℝ)
    (hden_pos : 0 < ((Finset.range t.1).sum weight) * sigma ^ (2 : ℕ))
    (h : WeightedSquareLightTailProcess μ delta dualNorm weight sigma) :
    μ {ω |
        (Finset.range t.1).sum
            (fun i => weight i * dualNorm (delta i ω) ^ (2 : ℕ)) >
          (1 + lambda) *
            (((Finset.range t.1).sum weight) * sigma ^ (2 : ℕ))} ≤
      ENNReal.ofReal (Real.exp (-lambda)) := by
  rcases h t with ⟨exponent, hquot, hexp_wd, hexp_bound⟩
  have hexp_int : Integrable (fun ω => Real.exp (exponent ω)) μ := by
    simpa [SOptLib.expectationWellDefined_iff_integrable] using hexp_wd
  have hchernoff :
      μ {ω | exponent ω > 1 + lambda} ≤
        ENNReal.ofReal (Real.exp (-lambda)) := by
    have hexp_int_one :
        Integrable (fun ω => Real.exp (1 * exponent ω)) μ := by
      simpa using hexp_int
    have hexp_bound_one :
        (∫ ω, Real.exp (1 * exponent ω) ∂μ) ≤ Real.exp 1 := by
      simpa using hexp_bound
    exact measure_gt_le_exp_neg_of_mgf_bound_at
      μ exponent 1 lambda (1 + lambda) 1
      (by norm_num)
      (by linarith)
      hexp_int_one
      hexp_bound_one
  have hsubset :
      {ω |
        (Finset.range t.1).sum
            (fun i => weight i * dualNorm (delta i ω) ^ (2 : ℕ)) >
          (1 + lambda) *
            (((Finset.range t.1).sum weight) * sigma ^ (2 : ℕ))} ⊆
        {ω | exponent ω > 1 + lambda} := by
    intro ω hω
    have hq := hquot ω
    rw [sourceQuotient] at hq
    have hmul := hq.2
    simp only [Set.mem_setOf_eq] at hω ⊢
    rw [← hmul] at hω
    exact lt_of_mul_lt_mul_right hω (le_of_lt hden_pos)
  exact (measure_mono hsubset).trans hchernoff

/-- A finite-prefix quadratic MGF budget yields the optimized strict upper-tail
bound used in the high-probability part of Theorem 4.10. -/
private theorem finitePrefix_quadratic_mgf_tail_le_exp_neg_sq_div_three
    [MeasurableSpace Ω] {μ : Measure Ω}
    (X : Ω → ℝ) (s : Finset ℕ) (scale : ℕ → ℝ) {lambda : ℝ}
    (hlambda : 0 < lambda)
    (hV_pos : 0 < s.sum fun n => (scale n) ^ (2 : ℕ))
    (hmgf : ∀ ν : ℝ,
      Integrable (fun ω => Real.exp (ν * X ω)) μ ∧
        (∫ ω, Real.exp (ν * X ω) ∂μ) ≤
          Real.exp
            (s.sum fun n =>
              3 * ν ^ (2 : ℕ) * (2 * (scale n) ^ (2 : ℕ)) / 4)) :
    μ {ω |
        X ω > lambda *
          Real.sqrt (2 * (s.sum fun n => (scale n) ^ (2 : ℕ)))} ≤
      ENNReal.ofReal (Real.exp (-(lambda ^ (2 : ℕ) / 3))) := by
  let V : ℝ := s.sum fun n => (scale n) ^ (2 : ℕ)
  let a : ℝ := lambda * Real.sqrt (2 * V)
  let ν : ℝ := a / (3 * V)
  have htwoV_pos : 0 < 2 * V := by
    dsimp [V] at hV_pos ⊢
    nlinarith
  have hsqrt_pos : 0 < Real.sqrt (2 * V) := Real.sqrt_pos.2 htwoV_pos
  have hν_pos : 0 < ν := by
    dsimp [ν, a]
    positivity
  have hC_eq :
      (s.sum fun n =>
          3 * ν ^ (2 : ℕ) * (2 * (scale n) ^ (2 : ℕ)) / 4) =
        lambda ^ (2 : ℕ) / 3 := by
    have hsum_factor :
        (s.sum fun n =>
            3 * ν ^ (2 : ℕ) * (2 * (scale n) ^ (2 : ℕ)) / 4) =
          (3 * ν ^ (2 : ℕ) * 2 / 4) * V := by
      calc
        (s.sum fun n =>
            3 * ν ^ (2 : ℕ) * (2 * (scale n) ^ (2 : ℕ)) / 4) =
            s.sum fun n => (3 * ν ^ (2 : ℕ) * 2 / 4) * (scale n) ^ (2 : ℕ) := by
              refine Finset.sum_congr rfl ?_
              intro n _hn
              ring
        _ = (3 * ν ^ (2 : ℕ) * 2 / 4) * V := by
              dsimp [V]
              rw [Finset.mul_sum]
    have hν_sq :
        ν ^ (2 : ℕ) = lambda ^ (2 : ℕ) * (2 * V) / (9 * V ^ (2 : ℕ)) := by
      have hV_ne : V ≠ 0 := ne_of_gt (by
        dsimp [V] at hV_pos ⊢
        exact hV_pos)
      dsimp [ν, a]
      rw [div_pow, mul_pow, mul_pow, Real.sq_sqrt (le_of_lt htwoV_pos)]
      field_simp [hV_ne]
      ring
    rw [hsum_factor, hν_sq]
    have hV_ne : V ≠ 0 := ne_of_gt (by
      dsimp [V] at hV_pos ⊢
      exact hV_pos)
    field_simp [hV_ne]
    ring
  have hνa_eq :
      ν * a = 2 * (lambda ^ (2 : ℕ) / 3) := by
    have hV_ne : V ≠ 0 := ne_of_gt (by
      dsimp [V] at hV_pos ⊢
      exact hV_pos)
    dsimp [ν, a]
    field_simp [hV_ne]
    exact Real.sq_sqrt (le_of_lt htwoV_pos)
  have hthreshold :
      (s.sum fun n =>
          3 * ν ^ (2 : ℕ) * (2 * (scale n) ^ (2 : ℕ)) / 4) +
        lambda ^ (2 : ℕ) / 3 ≤ ν * a := by
    rw [hC_eq, hνa_eq]
    nlinarith
  have hν_mgf := hmgf ν
  simpa [V, a] using
    measure_gt_le_exp_neg_of_mgf_bound_at
      μ X ν (lambda ^ (2 : ℕ) / 3) a
      (s.sum fun n =>
        3 * ν ^ (2 : ℕ) * (2 * (scale n) ^ (2 : ℕ)) / 4)
      hν_pos hthreshold hν_mgf.1 hν_mgf.2

/-- Five-event union bound with two `x`-tails and three `y`-tails, converted
to the real-valued probability form used in the source statement. -/
private theorem five_bad_events_union_bound_toReal
    [MeasurableSpace Ω] (μ : Measure Ω)
    {T A B C D E : Set Ω} {x y : ℝ}
    (hx_nonneg : 0 ≤ x) (hy_nonneg : 0 ≤ y)
    (hsubset : T ⊆ ((((A ∪ B) ∪ C) ∪ D) ∪ E))
    (hA : μ A ≤ ENNReal.ofReal x)
    (hB : μ B ≤ ENNReal.ofReal x)
    (hC : μ C ≤ ENNReal.ofReal y)
    (hD : μ D ≤ ENNReal.ofReal y)
    (hE : μ E ≤ ENNReal.ofReal y) :
    (μ T).toReal ≤ 2 * x + 3 * y := by
  have hAB :
      μ (A ∪ B) ≤ μ A + μ B :=
    MeasureTheory.measure_union_le A B
  have hABC :
      μ ((A ∪ B) ∪ C) ≤ (μ A + μ B) + μ C := by
    exact (MeasureTheory.measure_union_le (A ∪ B) C).trans
      (add_le_add hAB le_rfl)
  have hABCD :
      μ (((A ∪ B) ∪ C) ∪ D) ≤ ((μ A + μ B) + μ C) + μ D := by
    exact (MeasureTheory.measure_union_le ((A ∪ B) ∪ C) D).trans
      (add_le_add hABC le_rfl)
  have hABCDE :
      μ ((((A ∪ B) ∪ C) ∪ D) ∪ E) ≤
        (((μ A + μ B) + μ C) + μ D) + μ E := by
    exact (MeasureTheory.measure_union_le (((A ∪ B) ∪ C) ∪ D) E).trans
      (add_le_add hABCD le_rfl)
  have htail_sum :
      (((μ A + μ B) + μ C) + μ D) + μ E ≤
        (((ENNReal.ofReal x + ENNReal.ofReal x) + ENNReal.ofReal y) +
            ENNReal.ofReal y) + ENNReal.ofReal y := by
    have hAB_bound : μ A + μ B ≤ ENNReal.ofReal x + ENNReal.ofReal x :=
      add_le_add hA hB
    have hABC_bound :
        (μ A + μ B) + μ C ≤
          (ENNReal.ofReal x + ENNReal.ofReal x) + ENNReal.ofReal y :=
      add_le_add hAB_bound hC
    have hABCD_bound :
        ((μ A + μ B) + μ C) + μ D ≤
          ((ENNReal.ofReal x + ENNReal.ofReal x) + ENNReal.ofReal y) +
            ENNReal.ofReal y :=
      add_le_add hABC_bound hD
    exact add_le_add hABCD_bound hE
  have hT_bound :
      μ T ≤
        (((ENNReal.ofReal x + ENNReal.ofReal x) + ENNReal.ofReal y) +
            ENNReal.ofReal y) + ENNReal.ofReal y :=
    ((measure_mono hsubset).trans hABCDE).trans htail_sum
  have hR_ne_top :
      (((ENNReal.ofReal x + ENNReal.ofReal x) + ENNReal.ofReal y) +
          ENNReal.ofReal y) + ENNReal.ofReal y ≠ ⊤ := by
    simp
  calc
    (μ T).toReal ≤
        ((((ENNReal.ofReal x + ENNReal.ofReal x) + ENNReal.ofReal y) +
            ENNReal.ofReal y) + ENNReal.ofReal y).toReal :=
      ENNReal.toReal_mono hR_ne_top hT_bound
    _ = 2 * x + 3 * y := by
      rw [← ENNReal.ofReal_add hx_nonneg hx_nonneg]
      rw [← ENNReal.ofReal_add (add_nonneg hx_nonneg hx_nonneg) hy_nonneg]
      rw [← ENNReal.ofReal_add
        (add_nonneg (add_nonneg hx_nonneg hx_nonneg) hy_nonneg) hy_nonneg]
      rw [← ENNReal.ofReal_add
        (add_nonneg (add_nonneg (add_nonneg hx_nonneg hx_nonneg) hy_nonneg)
          hy_nonneg) hy_nonneg]
      rw [ENNReal.toReal_ofReal]
      · ring
      · nlinarith

/-- A probability measure cannot live on an empty measurable space. -/
private theorem nonempty_of_isProbabilityMeasure
    [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ] :
    Nonempty Ω := by
  by_contra hnonempty
  have huniv_empty : (Set.univ : Set Ω) = ∅ := by
    ext ω
    exact False.elim (hnonempty ⟨ω⟩)
  have hzero : μ Set.univ = 0 := by
    rw [huniv_empty, measure_empty]
  have hone : μ Set.univ = 1 := measure_univ
  rw [hzero] at hone
  norm_num at hone

/-- The denominator in a weighted-square light-tail certificate is positive
when the total weight is positive and the scale is nonnegative. -/
private theorem weightedSquareLightTailProcess_den_pos
    [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ] {E : Type*}
    (delta : ℕ → Ω → E) (dualNorm : E → ℝ)
    (weight : ℕ → ℝ) (sigma : ℝ) (t : {n : ℕ // 1 ≤ n})
    (htotal_pos : 0 < (Finset.range t.1).sum weight)
    (hsigma_nonneg : 0 ≤ sigma)
    (h : WeightedSquareLightTailProcess μ delta dualNorm weight sigma) :
    0 < ((Finset.range t.1).sum weight) * sigma ^ (2 : ℕ) := by
  rcases h t with ⟨exponent, hquot, _hexp_wd, _hexp_bound⟩
  obtain ⟨ω⟩ := nonempty_of_isProbabilityMeasure μ
  have hden_ne :
      ((Finset.range t.1).sum weight) * sigma ^ (2 : ℕ) ≠ 0 :=
    (hquot ω).1
  have hsigma_sq_nonneg : 0 ≤ sigma ^ (2 : ℕ) := sq_nonneg sigma
  have hsigma_sq_ne : sigma ^ (2 : ℕ) ≠ 0 := by
    intro hsigma_sq_zero
    exact hden_ne (by rw [hsigma_sq_zero, mul_zero])
  have hsigma_sq_pos : 0 < sigma ^ (2 : ℕ) :=
    lt_of_le_of_ne hsigma_sq_nonneg (Ne.symm hsigma_sq_ne)
  exact mul_pos htotal_pos hsigma_sq_pos

/-- The denominator in an inner-product light-tail certificate is positive
whenever the certificate exists.  The checked quotient supplies nonzero
denominators; positivity follows because the denominator is twice a square. -/
private theorem innerProductLightTailProcess_den_pos
    [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ] {E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (past : ℕ → MeasurableSpace Ω)
    (delta pair : ℕ → Ω → E) (scale : ℕ → ℝ) (sigma D : ℝ)
    (h : InnerProductLightTailProcess μ past delta pair scale sigma D) :
    ∀ i : ℕ, 0 < 2 * (sigma * scale i * D) ^ (2 : ℕ) := by
  rcases h with ⟨exponent, _hcond, hquot⟩
  obtain ⟨ω⟩ := nonempty_of_isProbabilityMeasure μ
  intro i
  have hden_ne : 2 * (sigma * scale i * D) ^ (2 : ℕ) ≠ 0 :=
    (hquot i ω).1
  have hden_nonneg : 0 ≤ 2 * (sigma * scale i * D) ^ (2 : ℕ) := by
    exact mul_nonneg (by norm_num) (sq_nonneg (sigma * scale i * D))
  exact lt_of_le_of_ne hden_nonneg (Ne.symm hden_ne)

/-- Unweighted one-step MGF bridge for the scaled inner-product martingale
increments appearing in the Lemma-4.1 tail applications. -/
private theorem innerProductLightTailProcess_unweighted_one_step_mgf
    [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ] {E : Type*}
    [MeasurableSpace E] [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (past : ℕ → MeasurableSpace Ω)
    (delta pair : ℕ → Ω → E) (scale : ℕ → ℝ) (sigma D : ℝ)
    (hlight : InnerProductLightTailProcess μ past delta pair scale sigma D)
    (hzero : ConditionalInnerProductZeroProcess μ past delta pair) :
    ∀ i : ℕ, ∀ ν : ℝ,
      Integrable
          (fun ω => Real.exp
            (ν * (scale i * ⟪delta i ω, pair i ω⟫_ℝ))) μ ∧
        (∫ ω, Real.exp
            (ν * (scale i * ⟪delta i ω, pair i ω⟫_ℝ)) ∂μ) ≤
          Real.exp
            (3 * ν ^ 2 * (2 * (sigma * scale i * D) ^ (2 : ℕ)) / 4) := by
  rcases hlight with ⟨exponent, hcond, hquot⟩
  intro i ν
  have hlight' : InnerProductLightTailProcess μ past delta pair scale sigma D :=
    ⟨exponent, hcond, hquot⟩
  have hσ2_pos :
      0 < 2 * (sigma * scale i * D) ^ (2 : ℕ) :=
    innerProductLightTailProcess_den_pos past delta pair scale sigma D hlight' i
  have hzero_scaled :
      SOptLib.ConditionalExpectation.conditionalExpectationEq μ (past i)
        (fun ω => scale i * ⟪delta i ω, pair i ω⟫_ℝ) (0 : Ω → ℝ) :=
    conditionalExpectationEq_const_mul_zero μ (past i)
      (fun ω => ⟪delta i ω, pair i ω⟫_ℝ) (scale i) (hzero i)
  exact conditional_centered_exp_square_to_unweighted_one_step_mgf
    μ (past i)
    (fun ω => scale i * ⟪delta i ω, pair i ω⟫_ℝ)
    (exponent i) ν (2 * (sigma * scale i * D) ^ (2 : ℕ))
    hσ2_pos hzero_scaled (hcond i) (hquot i)

/-- Weighted one-step MGF bridge for the scaled inner-product martingale
increments.  This is the conditional form required by the ordered finite-prefix
recurrence. -/
private theorem innerProductLightTailProcess_weighted_one_step_mgf
    [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ] {E : Type*}
    [MeasurableSpace E] [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (past : ℕ → MeasurableSpace Ω)
    (delta pair : ℕ → Ω → E) (scale : ℕ → ℝ) (sigma D : ℝ)
    (hlight : InnerProductLightTailProcess μ past delta pair scale sigma D)
    (hzero : ConditionalInnerProductZeroProcess μ past delta pair) :
    ∀ i : ℕ, ∀ ν : ℝ, ∀ H : Ω → ℝ,
      Measurable[past i] H →
      (∀ ω : Ω, 0 ≤ H ω) →
      Integrable H μ →
        Integrable
            (fun ω =>
              H ω * Real.exp
                (ν * (scale i * ⟪delta i ω, pair i ω⟫_ℝ))) μ ∧
          (∫ ω,
              H ω * Real.exp
                (ν * (scale i * ⟪delta i ω, pair i ω⟫_ℝ)) ∂μ) ≤
            Real.exp
              (3 * ν ^ 2 * (2 * (sigma * scale i * D) ^ (2 : ℕ)) / 4) *
              (∫ ω, H ω ∂μ) := by
  rcases hlight with ⟨exponent, hcond, hquot⟩
  intro i ν H hH_meas hH_nonneg hH_int
  have hlight' : InnerProductLightTailProcess μ past delta pair scale sigma D :=
    ⟨exponent, hcond, hquot⟩
  have hσ2_pos :
      0 < 2 * (sigma * scale i * D) ^ (2 : ℕ) :=
    innerProductLightTailProcess_den_pos past delta pair scale sigma D hlight' i
  have hzero_scaled :
      SOptLib.ConditionalExpectation.conditionalExpectationEq μ (past i)
        (fun ω => scale i * ⟪delta i ω, pair i ω⟫_ℝ) (0 : Ω → ℝ) :=
    conditionalExpectationEq_const_mul_zero μ (past i)
      (fun ω => ⟪delta i ω, pair i ω⟫_ℝ) (scale i) (hzero i)
  have hcond_linear :
      ConditionalRealExpectationLe μ (past i)
        (fun ω =>
          Real.exp (ν * (scale i * ⟪delta i ω, pair i ω⟫_ℝ)))
        (fun _ =>
          Real.exp
            (3 * ν ^ 2 * (2 * (sigma * scale i * D) ^ (2 : ℕ)) / 4)) :=
    conditional_centered_exp_square_to_conditional_linear_mgf
      μ (past i)
      (fun ω => scale i * ⟪delta i ω, pair i ω⟫_ℝ)
      (exponent i) ν (2 * (sigma * scale i * D) ^ (2 : ℕ))
      hσ2_pos hzero_scaled (hcond i) (hquot i)
  exact
    ConditionalRealExpectationLe.weighted_exp_one_step_mgf
      μ (past i) (fun ω => scale i * ⟪delta i ω, pair i ω⟫_ℝ)
      H ν (3 * ν ^ 2 * (2 * (sigma * scale i * D) ^ (2 : ℕ)) / 4)
      hcond_linear hH_meas hH_nonneg hH_int

/-- Fixed-query unbiased oracle law from the standing oracle assumptions
(4.5.3) and (4.5.4).

The `expectationWellDefined` clause records the source-displayed expectation as
a nonfallback Bochner integral rather than a separate convergence-theorem
regularity hypothesis. -/
noncomputable def FixedQueryUnbiasedOracle
    {X Sample E : Type*} [MeasurableSpace Sample] [MeasurableSpace E]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (ν : Measure Sample) (oracle : X → Sample → E) (target : X → E) : Prop :=
  ∀ x : X, SOptLib.expectationWellDefined ν (fun s => oracle x s) ∧
    (∫ s, oracle x s ∂ν) = target x

/-- Fixed-query Assumption 10 second-moment bound with residuals measured in
the paper dual norm.  The mean identity is intentionally not bundled here; it
belongs to the standing oracle assumptions (4.5.3) and (4.5.4). -/
noncomputable def FixedQueryDualSecondMomentOracle
    {X Sample E : Type*} [MeasurableSpace Sample]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (ν : Measure Sample) (oracle : X → Sample → E) (target : X → E)
    (dualNorm : E → ℝ) (sigma : ℝ) : Prop :=
  ∀ x : X,
    SOptLib.expectationWellDefined ν
      (fun s => dualNorm (oracle x s - target x) ^ (2 : ℕ)) ∧
    (∫ s, dualNorm (oracle x s - target x) ^ (2 : ℕ) ∂ν) ≤
      sigma ^ (2 : ℕ)

/-- The displayed fixed-query Assumption 11 exponent relation
`exponent = ||target x - oracle x s||_*^2 / sigma^2`, represented as a
partial source quotient rather than Lean's total division. -/
noncomputable def LightTailExponentSpec
    {X Sample E : Type*} [NormedAddCommGroup E]
    (oracle : X → Sample → E) (target : X → E)
    (dualNorm : E → ℝ) (sigma : ℝ) (exponent : X → Sample → ℝ) : Prop :=
  ∀ x : X, ∀ s : Sample,
    sourceQuotient
      (dualNorm (target x - oracle x s) ^ (2 : ℕ))
      (sigma ^ (2 : ℕ)) (exponent x s)

/-- Fixed-query light-tail oracle law from Assumption 11.

The displayed exponent contains the quotient
`||target x - oracle x s||_*^2 / sigma^2`.  The quotient is modeled by a
partial source relation so the zero-denominator case is not interpreted by
Lean's total division.

Book JSON: `book/FOML/StochasticAcceleratedMirrorProx.json#/assumptions/24`
(`Light_tail_oracle_noise`). -/
noncomputable def FixedQueryLightTailOracle
    {X Sample E : Type*} [MeasurableSpace Sample]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (ν : Measure Sample) (oracle : X → Sample → E) (target : X → E)
    (dualNorm : E → ℝ) (sigma : ℝ) : Prop :=
  ∃ exponent : X → Sample → ℝ,
    LightTailExponentSpec oracle target dualNorm sigma exponent ∧
      ∀ x : X,
        SOptLib.expectationWellDefined ν (fun s => Real.exp (exponent x s)) ∧
          (∫ s, Real.exp (exponent x s) ∂ν) ≤ Real.exp 1

/-- Assumption 11 provides integrability of the displayed fixed-query
exponential moment for the selected source quotient representatives. -/
theorem FixedQueryLightTailOracle.integrable_exp
    {X Sample E : Type*} [MeasurableSpace Sample]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {ν : Measure Sample} {oracle : X → Sample → E} {target : X → E}
    {dualNorm : E → ℝ} {sigma : ℝ}
    (h : FixedQueryLightTailOracle ν oracle target dualNorm sigma) :
    ∃ exponent : X → Sample → ℝ,
      LightTailExponentSpec oracle target dualNorm sigma exponent ∧
        ∀ x : X, Integrable (fun s => Real.exp (exponent x s)) ν := by
  obtain ⟨exponent, hquot, hmoment⟩ := h
  exact ⟨exponent, hquot, fun x => (hmoment x).1⟩

/-- Assumption 11 gives the displayed fixed-query exponential moment bound. -/
theorem FixedQueryLightTailOracle.exp_integral_le
    {X Sample E : Type*} [MeasurableSpace Sample]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {ν : Measure Sample} {oracle : X → Sample → E} {target : X → E}
    {dualNorm : E → ℝ} {sigma : ℝ}
    (h : FixedQueryLightTailOracle ν oracle target dualNorm sigma) :
    ∃ exponent : X → Sample → ℝ,
      LightTailExponentSpec oracle target dualNorm sigma exponent ∧
        ∀ x : X, (∫ s, Real.exp (exponent x s) ∂ν) ≤ Real.exp 1 := by
  obtain ⟨exponent, hquot, hmoment⟩ := h
  exact ⟨exponent, hquot, fun x => (hmoment x).2⟩

private theorem LightTailExponentSpec.exponent_nonneg
    {X Sample E : Type*} [NormedAddCommGroup E]
    {oracle : X → Sample → E} {target : X → E}
    {dualNorm : E → ℝ} {sigma : ℝ} {exponent : X → Sample → ℝ}
    (h : LightTailExponentSpec oracle target dualNorm sigma exponent)
    (x : X) (s : Sample) :
    0 ≤ exponent x s := by
  have hden_ne : sigma ^ (2 : ℕ) ≠ 0 := (h x s).1
  have hsigma_ne : sigma ≠ 0 := by
    intro hsigma
    exact hden_ne (by simp [hsigma])
  have hden_pos : 0 < sigma ^ (2 : ℕ) := by
    simpa using (sq_pos_of_ne_zero hsigma_ne)
  have hmul_nonneg : 0 ≤ exponent x s * sigma ^ (2 : ℕ) := by
    rw [(h x s).2]
    exact sq_nonneg _
  exact nonneg_of_mul_nonneg_left hmul_nonneg hden_pos

private theorem LightTailExponentSpec.residual_square_eq_sigma_sq_mul_exponent
    {X Sample E : Type*} [NormedAddCommGroup E]
    {oracle : X → Sample → E} {target : X → E}
    {dualNorm : E → ℝ} {sigma : ℝ} {exponent : X → Sample → ℝ}
    (h : LightTailExponentSpec oracle target dualNorm sigma exponent)
    (x : X) (s : Sample) :
    dualNorm (target x - oracle x s) ^ (2 : ℕ) =
      sigma ^ (2 : ℕ) * exponent x s := by
  simpa [mul_comm] using (h x s).2.symm

/-- Random-variable measurability for the SFO sample streams is a Lean
regularity obligation attached to the probability-space realization, not an
extra source assumption. -/
theorem OracleSampleBoundary_measurability_obligation [MeasurableSpace Ω]
    [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω)
    (xiLaw : Measure Ξ) (zetaLaw : Measure Ζ)
    (_h : OracleSampleBoundary sample μ xiLaw zetaLaw) :
    (∀ i : ℕ, Measurable (xiStream sample i)) ∧
      (∀ i : ℕ, Measurable (zetaStream sample i)) := by
  exact ⟨_h.1, _h.2.1⟩

/-- Fixed-query oracle integrability is a proof obligation for interpreting the
standing unbiasedness expectations, not an additional convergence-theorem
assumption. -/
theorem FixedQueryUnbiasedOracle_regularity_obligation
    {X Sample E : Type*} [MeasurableSpace Sample] [MeasurableSpace E]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (ν : Measure Sample) (oracle : X → Sample → E) (target : X → E)
    (_h : FixedQueryUnbiasedOracle ν oracle target) :
    ∀ x : X, Integrable (fun s => oracle x s) ν := by
  intro x
  exact (_h x).1

/-- Fixed-query residual-square integrability follows from the displayed
Assumption 10 second-moment bound. -/
theorem FixedQueryDualSecondMomentOracle_regularity_obligation
    {X Sample E : Type*} [MeasurableSpace Sample]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (ν : Measure Sample) (oracle : X → Sample → E) (target : X → E)
    (dualNorm : E → ℝ) (sigma : ℝ)
    (_h : FixedQueryDualSecondMomentOracle ν oracle target dualNorm sigma) :
    ∀ x : X, Integrable (fun s => dualNorm (oracle x s - target x) ^ (2 : ℕ)) ν := by
  intro x
  exact (_h x).1

/-- Under the standing fixed-query unbiasedness assumption (4.5.4), the
canonical law-mean of `G(u; xi)` is the source field `grad G(u)`. -/
theorem GmeanFromLaw_eq_gradG [MeasurableSpace Ξ] [MeasurableSpace E]
    (S : Setup Ξ Ζ E) (xiLaw : Measure Ξ)
    (hG : FixedQueryUnbiasedOracle xiLaw
      (fun u : S.Point => fun xi => S.Gsample u.1 xi)
      (fun u : S.Point => S.gradG u.1))
    (u : S.Point) :
    S.GmeanFromLaw xiLaw u = S.gradG u.1 := by
  simpa [GmeanFromLaw, SOptLib.oracleMean_def] using (hG u).2

/-- Under the standing fixed-query unbiasedness assumption (4.5.3), the
canonical law-mean of `H(u; zeta)` is the source field `H(u)`. -/
theorem HmeanFromLaw_eq_Hmean [MeasurableSpace Ζ] [MeasurableSpace E]
    (S : Setup Ξ Ζ E) (zetaLaw : Measure Ζ)
    (hH : FixedQueryUnbiasedOracle zetaLaw
      (fun u : S.Point => fun zeta => S.Hsample u.1 zeta)
      (fun u : S.Point => S.Hmean u.1))
    (u : S.Point) :
    S.HmeanFromLaw zetaLaw u = S.Hmean u.1 := by
  simpa [HmeanFromLaw, SOptLib.oracleMean_def] using (hH u).2

/-- Standing fixed-query unbiased oracle laws from (4.5.3) and (4.5.4), separated
from the variance/light-tail alternatives in Assumptions 10 and 11. -/
noncomputable def OracleUnbiasedLaw (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E]
    (xiLaw : Measure Ξ) (zetaLaw : Measure Ζ) : Prop :=
  FixedQueryUnbiasedOracle xiLaw
    (fun u : S.Point => fun ξ => S.Gsample u.1 ξ)
    (fun u : S.Point => S.gradG u.1) ∧
  FixedQueryUnbiasedOracle zetaLaw
    (fun u : S.Point => fun ζ => S.Hsample u.1 ζ)
    (fun u : S.Point => S.Hmean u.1)

/-- Assumption 10 as a source-facing oracle predicate: same-call independent
oracle samples together with bounded fixed-query second moments for the SFO
laws of the actual sample coordinates.

The PDF statement does not assert measurable coordinate streams, iid stream
laws, or full `xi`/`zeta` stream independence.  Those belong to the separate
non-source `SAMPOracleStreamBoundary` realization when a downstream Lean proof
needs a concrete stochastic-process model.  The fixed-query moment laws below
are attached directly to the actual coordinate laws of `xi_i` and `zeta_i`,
not to detached marginal-law witnesses.

Book JSON: `book/FOML/StochasticAcceleratedMirrorProx.json#/assumptions/5`
(`SFO_variance_bound`) and `#/assumptions/6` (`Oracle_independence`). -/
noncomputable def Assumption10 [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) : Prop :=
  SourceIndependentOracleSamples sample μ ∧
    (∀ i : ℕ,
      FixedQueryDualSecondMomentOracle (xiCoordinateLaw sample μ i)
        (fun u : S.Point => fun ξ => S.Gsample u.1 ξ)
        (fun u : S.Point => S.gradG u.1) S.dualNorm S.sigmaG) ∧
    (∀ i : ℕ,
      FixedQueryDualSecondMomentOracle (zetaCoordinateLaw sample μ i)
        (fun u : S.Point => fun ζ => S.Hsample u.1 ζ)
        (fun u : S.Point => S.Hmean u.1) S.dualNorm S.sigmaH)

/-- Assumption 10 exposes only the source same-call independence clause, not a
stronger iid stream realization. -/
theorem Assumption10_sourceIndependent_samples [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω)
    (_h10 : S.Assumption10 sample μ) :
    SourceIndependentOracleSamples sample μ := by
  exact _h10.1

/-- The `G` sample coordinate in iteration `n` has its canonical coordinate law. -/
theorem Assumption10_G_call_law [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) (_h10 : S.Assumption10 sample μ)
    (n : ℕ) :
    Measure.map (fun ω => (sample ω).xi (paperTime n).1) μ =
      xiCoordinateLaw sample μ (paperTime n).1 := by
  rfl

/-- The odd `H` sample coordinate in iteration `n` has its canonical coordinate law. -/
theorem Assumption10_H_odd_call_law [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) (_h10 : S.Assumption10 sample μ)
    (n : ℕ) :
    Measure.map (fun ω => (sample ω).zeta (2 * (paperTime n).1 - 1)) μ =
      zetaCoordinateLaw sample μ (2 * (paperTime n).1 - 1) := by
  rfl

/-- The even `H` sample coordinate in iteration `n` has its canonical coordinate law. -/
theorem Assumption10_H_even_call_law [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) (_h10 : S.Assumption10 sample μ)
    (n : ℕ) :
    Measure.map (fun ω => (sample ω).zeta (2 * (paperTime n).1)) μ =
      zetaCoordinateLaw sample μ (2 * (paperTime n).1) := by
  rfl

/-- Assumption 10's fixed-query second-moment bound for the `G` oracle. -/
theorem Assumption10_G_second_moment [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω)
    (_h10 : S.Assumption10 sample μ) (i : ℕ) :
    FixedQueryDualSecondMomentOracle (xiCoordinateLaw sample μ i)
      (fun u : S.Point => fun ξ => S.Gsample u.1 ξ)
      (fun u : S.Point => S.gradG u.1) S.dualNorm S.sigmaG := by
  exact _h10.2.1 i

/-- Assumption 10's fixed-query second-moment bound for the `H` oracle. -/
theorem Assumption10_H_second_moment [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω)
    (_h10 : S.Assumption10 sample μ) (i : ℕ) :
    FixedQueryDualSecondMomentOracle (zetaCoordinateLaw sample μ i)
      (fun u : S.Point => fun ζ => S.Hsample u.1 ζ)
      (fun u : S.Point => S.Hmean u.1) S.dualNorm S.sigmaH := by
  exact _h10.2.2 i

/-- The standing oracle mean laws realize the paper identity
`F(u) = E[F(u; xi, zeta)] = grad G(u) + H(u) + J'(u)` at fixed feasible queries,
with the two stochastic expectations represented by their sample laws. -/
theorem meanOperator_eq_meanOperatorFromLaws_of_oracleUnbiasedLaw
    (S : Setup Ξ Ζ E) [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E]
    (xiLaw : Measure Ξ) (zetaLaw : Measure Ζ)
    (hMean : S.OracleUnbiasedLaw xiLaw zetaLaw) (u : S.Point) :
    S.meanOperator u.1 = S.meanOperatorFromLaws xiLaw zetaLaw u := by
  rw [meanOperatorFromLaws, meanOperator,
    S.GmeanFromLaw_eq_gradG xiLaw hMean.1 u,
    S.HmeanFromLaw_eq_Hmean zetaLaw hMean.2 u]

/-- Regularity needed later to use Assumption 10 inside Bochner expectation
proofs for residual second moments. -/
theorem Assumption10_regularity_obligation [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω)
    (_h10 : S.Assumption10 sample μ) :
    (∀ i : ℕ, ∀ u : S.Point,
      Integrable
        (fun ξ => S.dualNorm (S.Gsample u.1 ξ - S.gradG u.1) ^ (2 : ℕ))
        (xiCoordinateLaw sample μ i)) ∧
    (∀ i : ℕ, ∀ u : S.Point,
      Integrable
        (fun ζ => S.dualNorm (S.Hsample u.1 ζ - S.Hmean u.1) ^ (2 : ℕ))
        (zetaCoordinateLaw sample μ i)) := by
  exact
    ⟨fun i =>
      FixedQueryDualSecondMomentOracle_regularity_obligation (xiCoordinateLaw sample μ i)
        (fun u : S.Point => fun ξ => S.Gsample u.1 ξ)
        (fun u : S.Point => S.gradG u.1) S.dualNorm S.sigmaG (_h10.2.1 i),
      fun i =>
      FixedQueryDualSecondMomentOracle_regularity_obligation (zetaCoordinateLaw sample μ i)
        (fun u : S.Point => fun ζ => S.Hsample u.1 ζ)
        (fun u : S.Point => S.Hmean u.1) S.dualNorm S.sigmaH (_h10.2.2 i)⟩

private theorem barSeq_measurable [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E]
    (sample : Ω → SamplePath Ξ Ζ)
    (hHistory : S.SAMPInterleavedOracleHistoryBoundary sample) (n : ℕ) :
    Measurable (fun ω => S.barSeq (sample ω) n) := by
  rcases hHistory with ⟨_, _, hbar, _, _, _, _⟩
  exact hbar n

private def IsZeroSeparating {α β : Type*} [Zero α] [Zero β] (f : α → β) : Prop :=
  ∀ x, f x = 0 ↔ x = 0

open Filter

private theorem canonicalDualNorm_isSeparating (S : Setup Ξ Ζ E) :
    IsZeroSeparating (SOptLib.canonicalDualNorm S.primalSeminorm) := by
  intro x
  constructor
  · intro hx
    by_contra hx0
    have hcontrol :
        ∃ C : ℝ, ∀ y : E, S.primalSeminorm y ≤ 1 → ‖y‖ ≤ C := by
      rcases
          Seminorm.exists_norm_le_mul_self_of_finiteDimensional_separating
            (p := S.primalSeminorm) S.primalSeminorm_separating with
        ⟨C, hC_nonneg, hC⟩
      refine ⟨C, ?_⟩
      intro y hy
      have hnorm : ‖y‖ ≤ C * S.primalSeminorm y := hC y
      nlinarith
    have h_bdd :
        BddAbove {r : ℝ | ∃ u : E, S.primalSeminorm u ≤ 1 ∧ r = |inner ℝ x u|} :=
      SOptLib.canonicalDualNorm_supportSet_bddAbove (p := S.primalSeminorm) x hcontrol
    have hineq :
        |inner ℝ x x| ≤ SOptLib.canonicalDualNorm S.primalSeminorm x * S.primalSeminorm x := by
      simpa using
        (SOptLib.abs_inner_le_canonicalDualNorm_mul
          (p := S.primalSeminorm) S.primalSeminorm_separating (zeta := x) (d := x) h_bdd)
    have hzero : SOptLib.canonicalDualNorm S.primalSeminorm x = 0 := by
      exact hx
    have hsq : ‖x‖ ^ 2 ≤ 0 := by
      have hinner : |inner ℝ x x| = ‖x‖ ^ 2 := by
        have hinner_eq : inner ℝ x x = ‖x‖ ^ 2 := by
          simpa using (inner_self_eq_norm_sq (x := x))
        have hinner_nonneg : 0 ≤ inner ℝ x x := by
          simpa using (sq_nonneg (‖x‖))
        rw [abs_of_nonneg hinner_nonneg, hinner_eq]
      have hinner0 : |inner ℝ x x| ≤ 0 := by
        rw [hzero] at hineq
        simpa using hineq
      rw [hinner] at hinner0
      exact hinner0
    have hnorm : ‖x‖ = 0 := by
      have hsq0 : ‖x‖ ^ 2 = 0 := le_antisymm hsq (sq_nonneg _)
      exact sq_eq_zero_iff.mp hsq0
    exact hx0 (norm_eq_zero.mp hnorm)
  · intro hx
    subst hx
    have hcontrol :
        ∃ C : ℝ, ∀ y : E, S.primalSeminorm y ≤ 1 → ‖y‖ ≤ C := by
      rcases
          Seminorm.exists_norm_le_mul_self_of_finiteDimensional_separating
            (p := S.primalSeminorm) S.primalSeminorm_separating with
        ⟨C, hC_nonneg, hC⟩
      refine ⟨C, ?_⟩
      intro y hy
      have hnorm : ‖y‖ ≤ C * S.primalSeminorm y := hC y
      nlinarith
    have h_bdd :
        BddAbove {r : ℝ | ∃ d : E, S.primalSeminorm d ≤ 1 ∧ r = |inner ℝ (0 : E) d|} :=
      SOptLib.canonicalDualNorm_supportSet_bddAbove (p := S.primalSeminorm) (0 : E) hcontrol
    rw [SOptLib.canonicalDualNorm_eq_sSup]
    have hnonempty :
        Set.Nonempty {r : ℝ | ∃ d : E, S.primalSeminorm d ≤ 1 ∧ r = |inner ℝ (0 : E) d|} := by
      exact ⟨0, ⟨0, by simp⟩⟩
    have hupper :
        ∀ r : ℝ,
          r ∈ {r : ℝ | ∃ d : E, S.primalSeminorm d ≤ 1 ∧ r = |inner ℝ (0 : E) d|} → r ≤ 0 := by
      intro r hr
      rcases hr with ⟨d, hd, rfl⟩
      simp
    refine le_antisymm (csSup_le hnonempty hupper) ?_
    exact le_csSup h_bdd ⟨0, by simp⟩

private theorem canonicalDualNorm_smul (S : Setup Ξ Ζ E) (a : ℝ) (x : E) :
    SOptLib.canonicalDualNorm S.primalSeminorm (a • x) =
      ‖a‖ * SOptLib.canonicalDualNorm S.primalSeminorm x := by
  rw [SOptLib.canonicalDualNorm_eq_sSup, SOptLib.canonicalDualNorm_eq_sSup]
  have hset :
      {r : ℝ | ∃ d : E, S.primalSeminorm d ≤ 1 ∧ r = |inner ℝ (a • x) d|} =
        ‖a‖ • {r : ℝ | ∃ d : E, S.primalSeminorm d ≤ 1 ∧ r = |inner ℝ x d|} := by
    ext r
    constructor
    · rintro ⟨d, hd, rfl⟩
      refine ⟨|inner ℝ x d|, ?_, ?_⟩
      · exact ⟨d, hd, rfl⟩
      · simp [inner_smul_left, abs_mul, Real.norm_eq_abs, mul_comm, mul_left_comm,
          mul_assoc]
    · rintro ⟨s, hs, rfl⟩
      rcases hs with ⟨d, hd, rfl⟩
      exact ⟨d, hd, by
        simp [inner_smul_left, abs_mul, Real.norm_eq_abs, mul_comm, mul_left_comm,
          mul_assoc]⟩
  rw [hset, Real.sSup_smul_of_nonneg (norm_nonneg a)]
  simp [mul_comm, mul_left_comm, mul_assoc]

private theorem dualNorm_add_sq_le_two_mul_sq_add_two_mul_sq (S : Setup Ξ Ζ E)
    (x y : E) :
    S.dualNorm (x + y) ^ (2 : ℕ) ≤
      2 * S.dualNorm x ^ (2 : ℕ) + 2 * S.dualNorm y ^ (2 : ℕ) := by
  rcases
      Seminorm.exists_norm_le_mul_self_of_finiteDimensional_separating
        (p := S.primalSeminorm) S.primalSeminorm_separating with
    ⟨C, hC_nonneg, hC⟩
  have hcontrol : ∀ d : E, S.primalSeminorm d ≤ 1 → ‖d‖ ≤ C := by
    intro d hd
    have hnorm : ‖d‖ ≤ C * S.primalSeminorm d := hC d
    nlinarith
  have hx :
      BddAbove {r : ℝ | ∃ d : E, S.primalSeminorm d ≤ 1 ∧
        r = |inner ℝ x d|} :=
    SOptLib.canonicalDualNorm_supportSet_bddAbove
      (p := S.primalSeminorm) x ⟨C, hcontrol⟩
  have hy :
      BddAbove {r : ℝ | ∃ d : E, S.primalSeminorm d ≤ 1 ∧
        r = |inner ℝ (-(-y)) d|} := by
    simpa using
      (SOptLib.canonicalDualNorm_supportSet_bddAbove
        (p := S.primalSeminorm) y ⟨C, hcontrol⟩)
  have hsplit :=
    SOptLib.canonicalDualNorm_sub_sq_le_two_mul_sq_add_two_mul_sq
      (p := S.primalSeminorm) x (-y) hx hy
  simpa [dualNorm, sub_eq_add_neg] using hsplit

private noncomputable def canonicalDualNormSeminorm (S : Setup Ξ Ζ E) : Seminorm ℝ E :=
  Seminorm.of (SOptLib.canonicalDualNorm S.primalSeminorm)
    (by
      intro x y
      rcases Seminorm.exists_norm_le_mul_self_of_finiteDimensional_separating
          (p := S.primalSeminorm) S.primalSeminorm_separating with
        ⟨C, hC_nonneg, hC⟩
      have hcontrol : ∀ y : E, S.primalSeminorm y ≤ 1 → ‖y‖ ≤ C := by
        intro y hy
        have hnorm : ‖y‖ ≤ C * S.primalSeminorm y := hC y
        nlinarith
      exact SOptLib.canonicalDualNorm_add_le (p := S.primalSeminorm) x y
        (SOptLib.canonicalDualNorm_supportSet_bddAbove (p := S.primalSeminorm) x ⟨C, hcontrol⟩)
        (SOptLib.canonicalDualNorm_supportSet_bddAbove (p := S.primalSeminorm) y ⟨C, hcontrol⟩))
    (by
      intro a x
      exact canonicalDualNorm_smul S a x)

private theorem canonicalDualNormSeminorm_isSeparating (S : Setup Ξ Ζ E) :
    (canonicalDualNormSeminorm S).IsSeparating := by
  simpa [canonicalDualNormSeminorm, IsZeroSeparating] using
    canonicalDualNorm_isSeparating (S := S)

private theorem dualNorm_three_term_sq_le_three_mul_sum_sq (S : Setup Ξ Ζ E)
    (x y z : E) :
    S.dualNorm (x + y + z) ^ (2 : ℕ) ≤
      3 * (S.dualNorm x ^ (2 : ℕ) + S.dualNorm y ^ (2 : ℕ) +
        S.dualNorm z ^ (2 : ℕ)) := by
  let D := canonicalDualNormSeminorm S
  have htriD :
      D (x + y + z) ≤ D x + D y + D z := by
    calc
      D (x + y + z) ≤ D (x + y) + D z := by
        exact map_add_le_add D (x + y) z
      _ ≤ (D x + D y) + D z := by
        simpa [add_comm, add_left_comm, add_assoc] using
          add_le_add_right (map_add_le_add D x y) (D z)
      _ = D x + D y + D z := by ring
  have htri :
      S.dualNorm (x + y + z) ≤
        S.dualNorm x + S.dualNorm y + S.dualNorm z := by
    simpa [D, canonicalDualNormSeminorm, dualNorm] using htriD
  have hx_nonneg : 0 ≤ S.dualNorm x := by
    simpa [dualNorm] using SOptLib.canonicalDualNorm_nonneg S.primalSeminorm x
  have hy_nonneg : 0 ≤ S.dualNorm y := by
    simpa [dualNorm] using SOptLib.canonicalDualNorm_nonneg S.primalSeminorm y
  have hz_nonneg : 0 ≤ S.dualNorm z := by
    simpa [dualNorm] using SOptLib.canonicalDualNorm_nonneg S.primalSeminorm z
  have hxyz_nonneg : 0 ≤ S.dualNorm (x + y + z) := by
    simpa [dualNorm] using
      SOptLib.canonicalDualNorm_nonneg S.primalSeminorm (x + y + z)
  have hsum_nonneg :
      0 ≤ S.dualNorm x + S.dualNorm y + S.dualNorm z := by
    nlinarith
  have hsq_tri :
      S.dualNorm (x + y + z) ^ (2 : ℕ) ≤
        (S.dualNorm x + S.dualNorm y + S.dualNorm z) ^ (2 : ℕ) := by
    nlinarith
  have hthree :
      (S.dualNorm x + S.dualNorm y + S.dualNorm z) ^ (2 : ℕ) ≤
        3 * (S.dualNorm x ^ (2 : ℕ) + S.dualNorm y ^ (2 : ℕ) +
          S.dualNorm z ^ (2 : ℕ)) := by
    nlinarith [sq_nonneg (S.dualNorm x - S.dualNorm y),
      sq_nonneg (S.dualNorm x - S.dualNorm z),
      sq_nonneg (S.dualNorm y - S.dualNorm z)]
  exact hsq_tri.trans hthree

private theorem samp_H_oracle_difference_dualNorm_sq_bound
    (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ) :
    S.dualNorm
        (S.secondOracle path n (S.stateProcess path n)
            (S.firstProx path n (S.stateProcess path n)) -
          S.firstOracle path n (S.stateProcess path n)) ^ (2 : ℕ) ≤
      3 * S.M ^ (2 : ℕ) *
          S.primalNorm
            ((S.firstProx path n (S.stateProcess path n)).1 -
              (S.rSeq path n).1) ^ (2 : ℕ) +
        3 * (S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
          S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ)) := by
  let st := S.stateProcess path n
  let wNext := S.firstProx path n st
  let r := S.rSeq path n
  have hdecomp :
      S.secondOracle path n st wNext - S.firstOracle path n st =
        (S.Hmean wNext.1 - S.Hmean r.1) +
          S.deltaHEven path n + (-S.deltaHOdd path n) := by
    simp [st, wNext, r, firstOracle, secondOracle, deltaHEven, deltaHOdd, rSeq,
      sub_eq_add_neg, add_comm, add_left_comm, add_assoc]
  have hthree :
      S.dualNorm
          (S.secondOracle path n st wNext - S.firstOracle path n st) ^ (2 : ℕ) ≤
        3 *
          (S.dualNorm (S.Hmean wNext.1 - S.Hmean r.1) ^ (2 : ℕ) +
            S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
            S.dualNorm (-S.deltaHOdd path n) ^ (2 : ℕ)) := by
    simpa [hdecomp] using
      dualNorm_three_term_sq_le_three_mul_sum_sq S
        (S.Hmean wNext.1 - S.Hmean r.1)
        (S.deltaHEven path n) (-S.deltaHOdd path n)
  have hlip :
      S.dualNorm (S.Hmean wNext.1 - S.Hmean r.1) ≤
        S.M * S.primalNorm (wNext.1 - r.1) := by
    simpa [dualNorm, primalNorm] using S.H_lipschitz wNext.2 r.2
  have hdual_nonneg :
      0 ≤ S.dualNorm (S.Hmean wNext.1 - S.Hmean r.1) := by
    simpa [dualNorm] using
      SOptLib.canonicalDualNorm_nonneg S.primalSeminorm
        (S.Hmean wNext.1 - S.Hmean r.1)
  have hrhs_nonneg :
      0 ≤ S.M * S.primalNorm (wNext.1 - r.1) :=
    le_trans hdual_nonneg hlip
  have hlip_sq :
      S.dualNorm (S.Hmean wNext.1 - S.Hmean r.1) ^ (2 : ℕ) ≤
        S.M ^ (2 : ℕ) * S.primalNorm (wNext.1 - r.1) ^ (2 : ℕ) := by
    nlinarith
  calc
    S.dualNorm
        (S.secondOracle path n (S.stateProcess path n)
            (S.firstProx path n (S.stateProcess path n)) -
          S.firstOracle path n (S.stateProcess path n)) ^ (2 : ℕ)
        =
      S.dualNorm
          (S.secondOracle path n st wNext - S.firstOracle path n st) ^ (2 : ℕ) := by
        simp [st, wNext]
    _ ≤
        3 *
          (S.dualNorm (S.Hmean wNext.1 - S.Hmean r.1) ^ (2 : ℕ) +
            S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
            S.dualNorm (-S.deltaHOdd path n) ^ (2 : ℕ)) := hthree
    _ ≤
        3 *
          (S.M ^ (2 : ℕ) * S.primalNorm (wNext.1 - r.1) ^ (2 : ℕ) +
            S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
            S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ)) := by
        have hneg :
            S.dualNorm (-S.deltaHOdd path n) =
              S.dualNorm (S.deltaHOdd path n) :=
          S.dualNorm_neg (S.deltaHOdd path n)
        have hsum_le :
            S.dualNorm (S.Hmean wNext.1 - S.Hmean r.1) ^ (2 : ℕ) +
                S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
                S.dualNorm (-S.deltaHOdd path n) ^ (2 : ℕ) ≤
              S.M ^ (2 : ℕ) * S.primalNorm (wNext.1 - r.1) ^ (2 : ℕ) +
                S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
                S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ) := by
          rw [hneg]
          nlinarith
        exact mul_le_mul_of_nonneg_left hsum_le (by norm_num)
    _ =
        3 * S.M ^ (2 : ℕ) *
            S.primalNorm
              ((S.firstProx path n (S.stateProcess path n)).1 -
                (S.rSeq path n).1) ^ (2 : ℕ) +
          3 * (S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
            S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ)) := by
        simp [st, wNext, r]
        ring

private theorem samp_scaled_H_oracle_difference_dualNorm_sq_bound
    (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (n : ℕ) :
    S.dualNorm
        (S.gamma (paperTime n).1 •
          (S.secondOracle path n (S.stateProcess path n)
              (S.firstProx path n (S.stateProcess path n)) -
            S.firstOracle path n (S.stateProcess path n))) ^ (2 : ℕ) ≤
      S.gamma (paperTime n).1 ^ (2 : ℕ) *
        (3 * S.M ^ (2 : ℕ) *
            S.primalNorm
              ((S.firstProx path n (S.stateProcess path n)).1 -
                (S.rSeq path n).1) ^ (2 : ℕ) +
          3 * (S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
            S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ))) := by
  let diff :=
    S.secondOracle path n (S.stateProcess path n)
        (S.firstProx path n (S.stateProcess path n)) -
      S.firstOracle path n (S.stateProcess path n)
  let γ := S.gamma (paperTime n).1
  have hbase :=
    samp_H_oracle_difference_dualNorm_sq_bound S path n
  have hsmul :
      S.dualNorm (γ • diff) = ‖γ‖ * S.dualNorm diff := by
    simpa [dualNorm] using canonicalDualNorm_smul S γ diff
  calc
    S.dualNorm
        (S.gamma (paperTime n).1 •
          (S.secondOracle path n (S.stateProcess path n)
              (S.firstProx path n (S.stateProcess path n)) -
            S.firstOracle path n (S.stateProcess path n))) ^ (2 : ℕ)
        =
      γ ^ (2 : ℕ) * S.dualNorm diff ^ (2 : ℕ) := by
        rw [hsmul, Real.norm_eq_abs]
        rw [pow_two, pow_two]
        nlinarith [abs_mul_abs_self γ]
    _ ≤
      γ ^ (2 : ℕ) *
        (3 * S.M ^ (2 : ℕ) *
            S.primalNorm
              ((S.firstProx path n (S.stateProcess path n)).1 -
                (S.rSeq path n).1) ^ (2 : ℕ) +
          3 * (S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
            S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ))) := by
        exact mul_le_mul_of_nonneg_left hbase (sq_nonneg γ)
    _ =
      S.gamma (paperTime n).1 ^ (2 : ℕ) *
        (3 * S.M ^ (2 : ℕ) *
            S.primalNorm
              ((S.firstProx path n (S.stateProcess path n)).1 -
                (S.rSeq path n).1) ^ (2 : ℕ) +
          3 * (S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
            S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ))) := by
        simp [γ]

private theorem samp_inner_le_dualNorm_mul_primalNorm
    (S : Setup Ξ Ζ E) (g d : E) :
    ⟪g, d⟫_ℝ ≤ S.dualNorm g * S.primalNorm d := by
  rcases
      Seminorm.exists_norm_le_mul_self_of_finiteDimensional_separating
        (p := S.primalSeminorm) S.primalSeminorm_separating with
    ⟨C, _hC_nonneg, hC⟩
  have hcontrol : ∀ d : E, S.primalSeminorm d ≤ 1 → ‖d‖ ≤ C := by
    intro d hd
    have hnorm : ‖d‖ ≤ C * S.primalSeminorm d := hC d
    nlinarith
  have hbdd :
      BddAbove {r : ℝ | ∃ d : E, S.primalSeminorm d ≤ 1 ∧
        r = |inner ℝ g d|} :=
    SOptLib.canonicalDualNorm_supportSet_bddAbove
      (p := S.primalSeminorm) g ⟨C, hcontrol⟩
  have habs :
      |inner ℝ g d| ≤
        SOptLib.canonicalDualNorm S.primalSeminorm g * S.primalSeminorm d :=
    SOptLib.abs_inner_le_canonicalDualNorm_mul
      (p := S.primalSeminorm) S.primalSeminorm_separating
      (zeta := g) (d := d) hbdd
  exact le_trans (le_abs_self _) (by simpa [dualNorm, primalNorm] using habs)

private theorem samp_deltaG_young_absorption
    (S : Setup Ξ Ζ E) (τ : {n : ℕ // 1 ≤ n})
    (r w : S.Point) (deltaG : E) :
    -(S.alpha τ.1 * (1 - S.q) / (2 * S.Gamma τ.1 * S.gamma τ.1)) *
        S.primalNorm (r.1 - w.1) ^ (2 : ℕ) -
      (S.alpha τ.1 / S.Gamma τ.1) * ⟪deltaG, w.1 - r.1⟫_ℝ ≤
        (S.alpha τ.1 * S.gamma τ.1 /
            (2 * (1 - S.q) * S.Gamma τ.1)) *
          S.dualNorm deltaG ^ (2 : ℕ) := by
  let a := S.alpha τ.1
  let γ := S.gamma τ.1
  let Γ := S.Gamma τ.1
  let qbar := 1 - S.q
  let p := S.primalNorm (r.1 - w.1)
  let dstar := S.dualNorm deltaG
  have ha_nonneg : 0 ≤ a := by
    simpa [a] using (Set.mem_Icc.mp (S.alpha_range τ)).1
  have hγ_pos : 0 < γ := by
    simpa [γ] using S.gamma_pos τ
  have hΓ_pos : 0 < Γ := by
    simpa [Γ] using S.Gamma_pos τ
  have hqbar_pos : 0 < qbar := by
    have hq_lt : S.q < 1 := S.q_mem.2
    nlinarith [hq_lt]
  have hcoef_nonneg : 0 ≤ a / Γ := by
    exact div_nonneg ha_nonneg (le_of_lt hΓ_pos)
  have hsupport :
      -⟪deltaG, w.1 - r.1⟫_ℝ ≤ dstar * p := by
    have hraw :
        ⟪deltaG, w.1 - r.1⟫_ℝ ≤
          S.dualNorm deltaG * S.primalNorm (w.1 - r.1) :=
      samp_inner_le_dualNorm_mul_primalNorm S deltaG (w.1 - r.1)
    have hnorm :
        S.primalNorm (w.1 - r.1) = S.primalNorm (r.1 - w.1) := by
      change S.primalSeminorm (w.1 - r.1) = S.primalSeminorm (r.1 - w.1)
      calc
        S.primalSeminorm (w.1 - r.1) =
            S.primalSeminorm (-(r.1 - w.1)) := by
          congr 1
          abel
        _ = S.primalSeminorm (r.1 - w.1) := by
          rw [map_neg_eq_map]
    have hneg_raw :
        -⟪deltaG, w.1 - r.1⟫_ℝ =
          ⟪deltaG, r.1 - w.1⟫_ℝ := by
      simp [sub_eq_add_neg, inner_add_right, inner_neg_right,
        add_comm, add_left_comm, add_assoc]
    have hraw_rev :
        ⟪deltaG, r.1 - w.1⟫_ℝ ≤
          S.dualNorm deltaG * S.primalNorm (r.1 - w.1) :=
      samp_inner_le_dualNorm_mul_primalNorm S deltaG (r.1 - w.1)
    simpa [dstar, p, hneg_raw] using hraw_rev
  have hyoung :
      dstar * p - qbar / (2 * γ) * p ^ (2 : ℕ) ≤
        γ / (2 * qbar) * dstar ^ (2 : ℕ) := by
    have hsq : 0 ≤ (qbar * p - γ * dstar) ^ (2 : ℕ) := sq_nonneg _
    have hγ_ne : γ ≠ 0 := ne_of_gt hγ_pos
    have hqbar_ne : qbar ≠ 0 := ne_of_gt hqbar_pos
    field_simp [hγ_ne, hqbar_ne]
    nlinarith [hsq, hγ_pos, hqbar_pos]
  have hscaled :
      (a / Γ) * (-⟪deltaG, w.1 - r.1⟫_ℝ) -
          (a / Γ) * (qbar / (2 * γ) * p ^ (2 : ℕ)) ≤
        (a / Γ) * (γ / (2 * qbar) * dstar ^ (2 : ℕ)) := by
    have hbase :
        -⟪deltaG, w.1 - r.1⟫_ℝ -
            qbar / (2 * γ) * p ^ (2 : ℕ) ≤
          γ / (2 * qbar) * dstar ^ (2 : ℕ) := by
      nlinarith [hsupport, hyoung]
    have hmul := mul_le_mul_of_nonneg_left hbase hcoef_nonneg
    nlinarith [hmul]
  calc
    -(S.alpha τ.1 * (1 - S.q) / (2 * S.Gamma τ.1 * S.gamma τ.1)) *
        S.primalNorm (r.1 - w.1) ^ (2 : ℕ) -
      (S.alpha τ.1 / S.Gamma τ.1) * ⟪deltaG, w.1 - r.1⟫_ℝ
        =
      (a / Γ) * (-⟪deltaG, w.1 - r.1⟫_ℝ) -
        (a / Γ) * (qbar / (2 * γ) * p ^ (2 : ℕ)) := by
          field_simp [a, γ, Γ, qbar, p, ne_of_gt hγ_pos, ne_of_gt hΓ_pos]
          ring
    _ ≤ (a / Γ) * (γ / (2 * qbar) * dstar ^ (2 : ℕ)) := hscaled
    _ =
        (S.alpha τ.1 * S.gamma τ.1 /
            (2 * (1 - S.q) * S.Gamma τ.1)) *
          S.dualNorm deltaG ^ (2 : ℕ) := by
          field_simp [a, γ, Γ, qbar, dstar, ne_of_gt hqbar_pos, ne_of_gt hΓ_pos]
          ring

set_option maxHeartbeats 800000 in
private theorem samp_residual_one_index_le_auxiliary_plus_Ut_summand
    (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (u : S.Point) (i : ℕ) :
    (-(S.alpha (paperTime i).1) / (2 * S.gamma (paperTime i).1) *
          (1 - S.L * S.alpha (paperTime i).1 * S.gamma (paperTime i).1 -
            3 * S.M ^ (2 : ℕ) * S.gamma (paperTime i).1 ^ (2 : ℕ)) *
          S.primalNorm
            ((S.rSeq path i).1 -
              (S.firstProx path i (S.stateProcess path i)).1) ^ (2 : ℕ) +
        (3 * S.alpha (paperTime i).1 * S.gamma (paperTime i).1 / 2) *
          (S.dualNorm (S.deltaHEven path i) ^ (2 : ℕ) +
            S.dualNorm (S.deltaHOdd path i) ^ (2 : ℕ)) -
        S.alpha (paperTime i).1 *
          ⟪S.deltaHEven path i + S.deltaG path i,
            (S.firstProx path i (S.stateProcess path i)).1 - u.1⟫_ℝ) /
        S.Gamma (paperTime i).1 ≤
      (S.alpha (paperTime i).1 / S.Gamma (paperTime i).1) *
          ⟪-S.auxiliaryDelta path i,
            (S.auxiliarySeq path i).1 - u.1⟫_ℝ +
        (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
            (2 * (1 - S.q) * S.Gamma (paperTime i).1)) *
          S.dualNorm (S.deltaG path i) ^ (2 : ℕ) +
        (3 * S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
            (2 * S.Gamma (paperTime i).1)) *
          (S.dualNorm (S.deltaHEven path i) ^ (2 : ℕ) +
            S.dualNorm (S.deltaHOdd path i) ^ (2 : ℕ)) -
        (S.alpha (paperTime i).1 / S.Gamma (paperTime i).1) *
          ⟪S.deltaG path i,
            (S.rSeq path i).1 - (S.auxiliarySeq path i).1⟫_ℝ -
        (S.alpha (paperTime i).1 / S.Gamma (paperTime i).1) *
          ⟪S.deltaHEven path i,
            (S.firstProx path i (S.stateProcess path i)).1 -
              (S.auxiliarySeq path i).1⟫_ℝ := by
  let τ := paperTime i
  let a := S.alpha τ.1
  let γ := S.gamma τ.1
  let Γ := S.Gamma τ.1
  let qbar := 1 - S.q
  let r := S.rSeq path i
  let w := S.firstProx path i (S.stateProcess path i)
  let aux := S.auxiliarySeq path i
  let H := S.deltaHEven path i
  let G := S.deltaG path i
  let noiseSq := S.dualNorm H ^ (2 : ℕ) + S.dualNorm (S.deltaHOdd path i) ^ (2 : ℕ)
  let distSq := S.primalNorm (r.1 - w.1) ^ (2 : ℕ)
  have hγ_pos : 0 < γ := by
    simpa [τ, γ] using S.gamma_pos (paperTime i)
  have hΓ_pos : 0 < Γ := by
    simpa [τ, Γ] using S.Gamma_pos (paperTime i)
  have hqbar_pos : 0 < qbar := by
    have hq_lt : S.q < 1 := S.q_mem.2
    nlinarith [hq_lt]
  have ha_nonneg : 0 ≤ a := by
    simpa [τ, a] using (Set.mem_Icc.mp (S.alpha_range (paperTime i))).1
  have hscale_nonneg : 0 ≤ a / (2 * Γ * γ) * distSq := by
    have hden_nonneg : 0 ≤ 2 * Γ * γ := by positivity
    exact mul_nonneg (div_nonneg ha_nonneg hden_nonneg) (sq_nonneg _)
  have hparam :
      qbar ≤ 1 - S.L * a * γ - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ) := by
    have hpc := S.parameter_condition (paperTime i)
    dsimp [qbar, a, γ, τ] at hpc ⊢
    nlinarith
  have hweaken :
      -(a / (2 * Γ * γ)) *
          (1 - S.L * a * γ - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ)) *
          distSq ≤
        -(a * qbar / (2 * Γ * γ)) * distSq := by
    let C := a / (2 * Γ * γ) * distSq
    have hmul :=
      mul_le_mul_of_nonneg_left hparam hscale_nonneg
    calc
      -(a / (2 * Γ * γ)) *
          (1 - S.L * a * γ - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ)) *
          distSq =
        -(C * (1 - S.L * a * γ - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ))) := by
          simp [C]
          ring
      _ ≤ -(C * qbar) := by
          nlinarith [hmul]
      _ = -(a * qbar / (2 * Γ * γ)) * distSq := by
          simp [C]
          ring
  have hyoung :
      -(a * qbar / (2 * Γ * γ)) *
          S.primalNorm (r.1 - w.1) ^ (2 : ℕ) -
        (a / Γ) * ⟪G, w.1 - r.1⟫_ℝ ≤
          (a * γ / (2 * qbar * Γ)) *
            S.dualNorm G ^ (2 : ℕ) := by
    have hY := samp_deltaG_young_absorption S (paperTime i) r w G
    simpa [τ, a, γ, Γ, qbar, r, w, G, mul_assoc, mul_left_comm, mul_comm] using hY
  have hsplit :
      -(a / Γ) * ⟪H + G, w.1 - u.1⟫_ℝ =
        (a / Γ) * ⟪-(H + G), aux.1 - u.1⟫_ℝ -
          (a / Γ) * ⟪G, r.1 - aux.1⟫_ℝ -
          (a / Γ) * ⟪H, w.1 - aux.1⟫_ℝ -
          (a / Γ) * ⟪G, w.1 - r.1⟫_ℝ := by
    rw [show w.1 - u.1 = (aux.1 - u.1) + (w.1 - aux.1) by abel]
    rw [show w.1 - aux.1 = (w.1 - r.1) + (r.1 - aux.1) by abel]
    simp [inner_add_left, inner_add_right, inner_neg_left,
      sub_eq_add_neg, add_comm, add_left_comm, add_assoc]
    ring
  have hsplit' :
      -a / Γ * ⟪H + G, w.1 - u.1⟫_ℝ =
        (a / Γ) * ⟪-(H + G), aux.1 - u.1⟫_ℝ -
          (a / Γ) * ⟪G, r.1 - aux.1⟫_ℝ -
          (a / Γ) * ⟪H, w.1 - aux.1⟫_ℝ -
          (a / Γ) * ⟪G, w.1 - r.1⟫_ℝ := by
    calc
      -a / Γ * ⟪H + G, w.1 - u.1⟫_ℝ =
          -(a / Γ) * ⟪H + G, w.1 - u.1⟫_ℝ := by
            ring
      _ =
        (a / Γ) * ⟪-(H + G), aux.1 - u.1⟫_ℝ -
          (a / Γ) * ⟪G, r.1 - aux.1⟫_ℝ -
          (a / Γ) * ⟪H, w.1 - aux.1⟫_ℝ -
          (a / Γ) * ⟪G, w.1 - r.1⟫_ℝ := hsplit
  have hleft_rewrite :
      (-(S.alpha (paperTime i).1) / (2 * S.gamma (paperTime i).1) *
            (1 - S.L * S.alpha (paperTime i).1 * S.gamma (paperTime i).1 -
              3 * S.M ^ (2 : ℕ) * S.gamma (paperTime i).1 ^ (2 : ℕ)) *
            S.primalNorm
              ((S.rSeq path i).1 -
                (S.firstProx path i (S.stateProcess path i)).1) ^ (2 : ℕ) +
          (3 * S.alpha (paperTime i).1 * S.gamma (paperTime i).1 / 2) *
            (S.dualNorm (S.deltaHEven path i) ^ (2 : ℕ) +
              S.dualNorm (S.deltaHOdd path i) ^ (2 : ℕ)) -
          S.alpha (paperTime i).1 *
            ⟪S.deltaHEven path i + S.deltaG path i,
              (S.firstProx path i (S.stateProcess path i)).1 - u.1⟫_ℝ) /
          S.Gamma (paperTime i).1 =
        -(a / (2 * Γ * γ)) *
            (1 - S.L * a * γ - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ)) *
            distSq +
          (3 * a * γ / (2 * Γ)) * noiseSq -
          (a / Γ) * ⟪H + G, w.1 - u.1⟫_ℝ := by
    field_simp [τ, a, γ, Γ, r, w, H, G, noiseSq, distSq,
      ne_of_gt hγ_pos, ne_of_gt hΓ_pos]
    ring
  have hmain :
      -(a / (2 * Γ * γ)) *
          (1 - S.L * a * γ - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ)) *
          distSq -
        (a / Γ) * ⟪G, w.1 - r.1⟫_ℝ ≤
        (a * γ / (2 * qbar * Γ)) * S.dualNorm G ^ (2 : ℕ) := by
    nlinarith [hweaken, hyoung]
  have haux_delta :
      S.auxiliaryDelta path i = H + G := by
    simp [auxiliaryDelta, H, G]
  have hleft_split :
      -(a / (2 * Γ * γ)) *
          (1 - S.L * a * γ - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ)) *
          distSq +
        (3 * a * γ / (2 * Γ)) * noiseSq -
        (a / Γ) * ⟪H + G, w.1 - u.1⟫_ℝ =
      (-(a / (2 * Γ * γ)) *
          (1 - S.L * a * γ - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ)) *
          distSq -
        (a / Γ) * ⟪G, w.1 - r.1⟫_ℝ) +
        (3 * a * γ / (2 * Γ)) * noiseSq +
        ((a / Γ) * ⟪-(H + G), aux.1 - u.1⟫_ℝ -
          (a / Γ) * ⟪G, r.1 - aux.1⟫_ℝ -
          (a / Γ) * ⟪H, w.1 - aux.1⟫_ℝ) := by
    calc
      -(a / (2 * Γ * γ)) *
          (1 - S.L * a * γ - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ)) *
          distSq +
        (3 * a * γ / (2 * Γ)) * noiseSq -
        (a / Γ) * ⟪H + G, w.1 - u.1⟫_ℝ =
        -(a / (2 * Γ * γ)) *
          (1 - S.L * a * γ - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ)) *
          distSq +
        (3 * a * γ / (2 * Γ)) * noiseSq +
        (-(a / Γ) * ⟪H + G, w.1 - u.1⟫_ℝ) := by
          ring
      _ =
        -(a / (2 * Γ * γ)) *
          (1 - S.L * a * γ - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ)) *
          distSq +
        (3 * a * γ / (2 * Γ)) * noiseSq +
        ((a / Γ) * ⟪-(H + G), aux.1 - u.1⟫_ℝ -
          (a / Γ) * ⟪G, r.1 - aux.1⟫_ℝ -
          (a / Γ) * ⟪H, w.1 - aux.1⟫_ℝ -
          (a / Γ) * ⟪G, w.1 - r.1⟫_ℝ) := by
          rw [hsplit]
      _ =
      (-(a / (2 * Γ * γ)) *
          (1 - S.L * a * γ - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ)) *
          distSq -
        (a / Γ) * ⟪G, w.1 - r.1⟫_ℝ) +
        (3 * a * γ / (2 * Γ)) * noiseSq +
        ((a / Γ) * ⟪-(H + G), aux.1 - u.1⟫_ℝ -
          (a / Γ) * ⟪G, r.1 - aux.1⟫_ℝ -
          (a / Γ) * ⟪H, w.1 - aux.1⟫_ℝ) := by
          ring
  rw [hleft_rewrite, hleft_split, haux_delta]
  dsimp [τ, a, γ, Γ, qbar, r, w, aux, H, G, noiseSq] at hmain ⊢
  nlinarith [hmain]

private theorem samp_two_prox_first_inequality_from_three_point
    (S : Setup Ξ Ζ E) (r w y u : S.Point) (eta theta : E) (gamma : ℝ)
    (noiseSq : ℝ)
    (hFirstAtY :
      gamma * (⟪eta, w.1 - y.1⟫_ℝ + S.J w.1 - S.J y.1) +
          S.V r w ≤
        S.V r y - S.V w y)
    (hSecondAtU :
      gamma * (⟪theta, y.1 - u.1⟫_ℝ + S.J y.1 - S.J u.1) +
          S.V r y ≤
        S.V r u - S.V y u)
    (hScaledDiff :
      S.dualNorm (gamma • (theta - eta)) ^ (2 : ℕ) ≤
        gamma ^ (2 : ℕ) *
          (3 * S.M ^ (2 : ℕ) * S.primalNorm (w.1 - r.1) ^ (2 : ℕ) +
            3 * noiseSq)) :
    gamma * (⟪theta, w.1 - u.1⟫_ℝ + S.J w.1 - S.J u.1) ≤
      S.V r u - S.V y u -
          ((1 / 2 : ℝ) - 3 * S.M ^ (2 : ℕ) * gamma ^ (2 : ℕ) / 2) *
            S.primalNorm (r.1 - w.1) ^ (2 : ℕ) +
        (3 * gamma ^ (2 : ℕ) / 2) * noiseSq := by
  have hsupport :
      ⟪gamma • (theta - eta), w.1 - y.1⟫_ℝ ≤
        S.dualNorm (gamma • (theta - eta)) *
          S.primalNorm (w.1 - y.1) :=
    samp_inner_le_dualNorm_mul_primalNorm S (gamma • (theta - eta)) (w.1 - y.1)
  have hlower_wy :
      (1 / 2 : ℝ) * S.primalNorm (w.1 - y.1) ^ (2 : ℕ) ≤
        S.V w y :=
    S.half_primalNorm_sq_le_V w y
  have hcross :
      ⟪gamma • (theta - eta), w.1 - y.1⟫_ℝ - S.V w y ≤
        (1 / 2 : ℝ) * S.dualNorm (gamma • (theta - eta)) ^ (2 : ℕ) :=
    inner_sub_sub_bregman_le_half_dual_sq
      (eval := fun p : S.Point => p.1) (V := S.V)
      (primalNorm := S.primalNorm) (dualNorm := S.dualNorm)
      (ζ := gamma • (theta - eta)) (z := w) (y := y)
      hsupport hlower_wy
  have hadded :
      gamma * (⟪theta, y.1 - u.1⟫_ℝ + S.J y.1 - S.J u.1) +
          gamma * (⟪eta, w.1 - y.1⟫_ℝ + S.J w.1 - S.J y.1) ≤
        S.V r u - S.V y u - S.V r w - S.V w y := by
    nlinarith [hFirstAtY, hSecondAtU]
  have hsplit :
      gamma * (⟪theta, w.1 - u.1⟫_ℝ + S.J w.1 - S.J u.1) =
        gamma * (⟪theta, y.1 - u.1⟫_ℝ + S.J y.1 - S.J u.1) +
          gamma * (⟪eta, w.1 - y.1⟫_ℝ + S.J w.1 - S.J y.1) +
            ⟪gamma • (theta - eta), w.1 - y.1⟫_ℝ := by
    rw [real_inner_smul_left, inner_sub_left]
    have hvec : w.1 - u.1 = (y.1 - u.1) + (w.1 - y.1) := by abel
    rw [hvec, inner_add_right]
    ring
  have hpre :
      gamma * (⟪theta, w.1 - u.1⟫_ℝ + S.J w.1 - S.J u.1) ≤
        S.V r u - S.V y u - S.V r w +
          (1 / 2 : ℝ) * S.dualNorm (gamma • (theta - eta)) ^ (2 : ℕ) := by
    rw [hsplit]
    nlinarith [hadded, hcross]
  have hlower_rw :
      (1 / 2 : ℝ) * S.primalNorm (r.1 - w.1) ^ (2 : ℕ) ≤
        S.V r w :=
    S.half_primalNorm_sq_le_V r w
  have hnorm_rw :
      S.primalNorm (w.1 - r.1) = S.primalNorm (r.1 - w.1) := by
    calc
      S.primalNorm (w.1 - r.1) = S.primalSeminorm (w.1 - r.1) := rfl
      _ = S.primalSeminorm (-(r.1 - w.1)) := by
        congr 1
        abel
      _ = S.primalSeminorm (r.1 - w.1) := by
        rw [map_neg_eq_map]
      _ = S.primalNorm (r.1 - w.1) := rfl
  have hscaled :
      (1 / 2 : ℝ) * S.dualNorm (gamma • (theta - eta)) ^ (2 : ℕ) ≤
        (1 / 2 : ℝ) *
          (gamma ^ (2 : ℕ) *
            (3 * S.M ^ (2 : ℕ) * S.primalNorm (r.1 - w.1) ^ (2 : ℕ) +
              3 * noiseSq)) := by
    have h := mul_le_mul_of_nonneg_left hScaledDiff (by norm_num : (0 : ℝ) ≤ 1 / 2)
    simpa [hnorm_rw] using h
  nlinarith [hpre, hlower_rw, hscaled]

private theorem gvalue_continuousOn_on_Z (S : Setup Ξ Ζ E) : ContinuousOn S.Gvalue S.Z := by
  rw [continuousOn_iff_continuous_restrict]
  refine continuous_iff_continuousAt.2 ?_
  intro u
  have hlin : Continuous (fun w : S.Point => ⟪S.gradG u.1, w.1 - u.1⟫_ℝ) := by
    simpa using (continuous_const.inner (continuous_subtype_val.sub continuous_const))
  have hps : Continuous (fun w : S.Point => S.primalSeminorm (w.1 - u.1)) := by
    simpa using
      (S.primalSeminorm.continuous_of_finiteDimensional.comp
        (continuous_subtype_val.sub continuous_const))
  have hquad :
      Continuous (fun w : S.Point => (S.L / 2) * S.primalSeminorm (w.1 - u.1) ^ 2) := by
    simpa using (continuous_const.mul (hps.pow 2))
  have hres_nonneg :
      ∀ w : S.Point,
        0 ≤
          S.Gvalue w.1 - S.Gvalue u.1 - ⟪S.gradG u.1, w.1 - u.1⟫_ℝ := by
    intro w
    exact (S.G_convex_smooth (w := w.1) (v := u.1) w.2 u.2).1
  have hres_le :
      ∀ w : S.Point,
        S.Gvalue w.1 - S.Gvalue u.1 - ⟪S.gradG u.1, w.1 - u.1⟫_ℝ ≤
          (S.L / 2) * S.primalSeminorm (w.1 - u.1) ^ 2 := by
    intro w
    exact (S.G_convex_smooth (w := w.1) (v := u.1) w.2 u.2).2
  have hres_tendsto :
      Tendsto
        (fun w : S.Point =>
          S.Gvalue w.1 - S.Gvalue u.1 - ⟪S.gradG u.1, w.1 - u.1⟫_ℝ)
        (𝓝 u) (𝓝 0) := by
    have hquad_tendsto :
        Tendsto (fun w : S.Point => (S.L / 2) * S.primalSeminorm (w.1 - u.1) ^ 2) (𝓝 u) (𝓝 0) := by
      simpa using (hquad.tendsto u)
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hquad_tendsto ?_
      ?_
    · exact hres_nonneg
    · exact hres_le
  have hdiff_tendsto :
      Tendsto (fun w : S.Point => S.Gvalue w.1 - S.Gvalue u.1) (𝓝 u) (𝓝 0) := by
    have hlin_tendsto : Tendsto (fun w : S.Point => ⟪S.gradG u.1, w.1 - u.1⟫_ℝ) (𝓝 u) (𝓝 0) := by
      simpa using (hlin.tendsto u)
    have hsum := hres_tendsto.add hlin_tendsto
    simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using hsum
  have hG :
      Tendsto (fun w : S.Point => S.Gvalue w.1) (𝓝 u) (𝓝 (S.Gvalue u.1)) := by
    have hconst :
        Tendsto (fun _ : S.Point => S.Gvalue u.1) (𝓝 u) (𝓝 (S.Gvalue u.1)) :=
      tendsto_const_nhds
    have hsum := hdiff_tendsto.add hconst
    simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using hsum
  exact hG

private theorem hmean_continuousOn_on_Z (S : Setup Ξ Ζ E) : ContinuousOn S.Hmean S.Z := by
  rcases Seminorm.exists_bound_by_norm_of_finiteDimensional (p := S.primalSeminorm) with
    ⟨Cp, hCp_nonneg, hCp⟩
  rcases
      Seminorm.exists_norm_le_mul_self_of_finiteDimensional_separating
        (p := canonicalDualNormSeminorm S) (canonicalDualNormSeminorm_isSeparating S) with
    ⟨Cd, hCd_nonneg, hCd⟩
  have hLip :
      LipschitzOnWith ⟨Cd * max 0 S.M * Cp, by positivity⟩ S.Hmean S.Z := by
    refine LipschitzOnWith.of_dist_le_mul ?_
    intro x hx y hy
    have hdual_bound :
        SOptLib.canonicalDualNorm S.primalSeminorm (S.Hmean x - S.Hmean y) ≤
          (max 0 S.M) * S.primalSeminorm (x - y) := by
      have hM : S.M ≤ max 0 S.M := le_max_right _ _
      exact le_trans (S.H_lipschitz hx hy)
        (mul_le_mul_of_nonneg_right hM (by positivity))
    have hprimal_bound : S.primalSeminorm (x - y) ≤ Cp * ‖x - y‖ := hCp (x - y)
    have hdist_le :
        dist (S.Hmean x) (S.Hmean y) ≤ (Cd * max 0 S.M * Cp : ℝ) * ‖x - y‖ := by
      calc
        dist (S.Hmean x) (S.Hmean y) = ‖S.Hmean x - S.Hmean y‖ := by simp [dist_eq_norm]
        _ ≤ (Cd : ℝ) * SOptLib.canonicalDualNorm S.primalSeminorm (S.Hmean x - S.Hmean y) := by
          exact hCd (S.Hmean x - S.Hmean y)
        _ ≤ (Cd : ℝ) * ((max 0 S.M) * S.primalSeminorm (x - y)) := by
          exact mul_le_mul_of_nonneg_left hdual_bound hCd_nonneg
        _ ≤ (Cd : ℝ) * ((max 0 S.M) * (Cp * ‖x - y‖)) := by
          exact mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left hprimal_bound (le_max_left _ _)) hCd_nonneg
        _ = (Cd * max 0 S.M * Cp : ℝ) * ‖x - y‖ := by ring
    simpa [dist_eq_norm] using hdist_le
  exact hLip.continuousOn

private theorem gap_kernel_continuous (S : Setup Ξ Ζ E) :
    Continuous (fun p : S.Point × S.Point => S.Q p.1 p.2) := by
  have hG : Continuous (fun z : S.Point => S.Gvalue z.1) := by
    exact continuous_subtype_of_continuousOn_ambient
      (f := fun z : S.Point => S.Gvalue z.1) (F := S.Gvalue)
      (hF := gvalue_continuousOn_on_Z S) (by intro z; rfl)
  have hH : Continuous (fun z : S.Point => S.Hmean z.1) := by
    exact continuous_subtype_of_continuousOn_ambient
      (f := fun z : S.Point => S.Hmean z.1) (F := S.Hmean)
      (hF := hmean_continuousOn_on_Z S) (by intro z; rfl)
  have hJ : Continuous (fun z : S.Point => S.J z.1) := by
    exact continuous_subtype_of_continuousOn_ambient
      (f := fun z : S.Point => S.J z.1) (F := S.J)
      (hF := J_continuousOn S) (by intro z; rfl)
  have hG1 : Continuous (fun p : S.Point × S.Point => S.Gvalue p.1.1) := hG.comp continuous_fst
  have hG2 : Continuous (fun p : S.Point × S.Point => S.Gvalue p.2.1) := hG.comp continuous_snd
  have hJ1 : Continuous (fun p : S.Point × S.Point => S.J p.1.1) := hJ.comp continuous_fst
  have hJ2 : Continuous (fun p : S.Point × S.Point => S.J p.2.1) := hJ.comp continuous_snd
  have hinner :
      Continuous (fun p : S.Point × S.Point => ⟪S.Hmean p.2.1, p.1.1 - p.2.1⟫_ℝ) := by
    simpa [sub_eq_add_neg] using
      (hH.comp continuous_snd).inner
        ((continuous_subtype_val.comp continuous_fst).sub (continuous_subtype_val.comp continuous_snd))
  have hQ :
      Continuous
        (fun p : S.Point × S.Point =>
          (S.Gvalue p.1.1 - S.Gvalue p.2.1) +
            (⟪S.Hmean p.2.1, p.1.1 - p.2.1⟫_ℝ + S.J p.1.1) - S.J p.2.1) := by
    exact ((hG1.sub hG2).add (hinner.add hJ1)).sub hJ2
  simpa [Setup.Q, add_assoc, add_comm, add_left_comm] using hQ

private theorem gap_carrier_continuous (S : Setup Ξ Ζ E) :
    Continuous (fun z : S.Point => S.gap z.1) := by
  classical
  letI : CompactSpace S.Point := isCompact_iff_compactSpace.mp S.Z_isCompact
  have huc :
      UniformContinuous (fun p : S.Point × S.Point => S.Q p.1 p.2) :=
    CompactSpace.uniformContinuous_of_continuous (gap_kernel_continuous S)
  refine Metric.continuous_iff.2 ?_
  intro z0 ε hε
  have hε2 : 0 < ε / 2 := by positivity
  rcases Metric.uniformContinuous_iff.mp huc (ε / 2) hε2 with ⟨δ, hδpos, hδ⟩
  refine ⟨δ, hδpos, ?_⟩
  intro z hz
  have hQabs : ∀ u : S.Point, |S.Q z.1 u.1 - S.Q z0.1 u.1| < ε / 2 := by
    intro u
    have hdist : dist (z, u) (z0, u) < δ := by
      simpa [dist_prod_same_right] using hz
    have hdistQ := hδ hdist
    simpa [Real.dist_eq] using hdistQ
  have hle :
      S.gap z.1 ≤ S.gap z0.1 + ε / 2 := by
    rw [isLUB_le_iff (S.gap_isLUB z)]
    intro r hr
    rcases hr with ⟨u, hu, rfl⟩
    let uP : S.Point := ⟨u, hu⟩
    have hbase : S.Q z0.1 u ≤ S.gap z0.1 :=
      (S.gap_isLUB z0).1 ⟨u, hu, rfl⟩
    have hdiff : S.Q z.1 u - S.Q z0.1 u < ε / 2 := by
      have h := hQabs uP
      exact (abs_lt.mp h).2
    linarith
  have hge :
      S.gap z0.1 ≤ S.gap z.1 + ε / 2 := by
    rw [isLUB_le_iff (S.gap_isLUB z0)]
    intro r hr
    rcases hr with ⟨u, hu, rfl⟩
    let uP : S.Point := ⟨u, hu⟩
    have hbase : S.Q z.1 u ≤ S.gap z.1 :=
      (S.gap_isLUB z).1 ⟨u, hu, rfl⟩
    have hdiff : S.Q z0.1 u - S.Q z.1 u < ε / 2 := by
      have h := hQabs uP
      have hleft := (abs_lt.mp h).1
      linarith
    linarith
  rw [Real.dist_eq]
  exact abs_sub_lt_iff.2 ⟨by linarith, by linarith⟩

private theorem expectedGapIntegrand_measurable [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E] [BorelSpace E]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) (n : ℕ)
    (hbar : Measurable (fun ω => S.barSeq (sample ω) n)) :
    Measurable (S.expectedGapIntegrand sample μ n) := by
  have hgap : Measurable (fun z : S.Point => S.gap z.1) :=
    (gap_carrier_continuous S).measurable
  simpa [expectedGapIntegrand] using hgap.comp hbar

private theorem expectedGapIntegrand_uniformBound [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω)
    (xiLaw : Measure Ξ) (zetaLaw : Measure Ζ)
    (_hMean : S.OracleUnbiasedLaw xiLaw zetaLaw)
    (_h10 : S.Assumption10 sample μ) (n : ℕ) :
    ∃ C : ℝ, ∀ ω, ‖S.expectedGapIntegrand sample μ n ω‖ ≤ C := by
  classical
  letI : CompactSpace S.Point := isCompact_iff_compactSpace.mp S.Z_isCompact
  rcases exists_nonneg_norm_bound_of_isCompact_of_continuousOn
      (f := fun z : S.Point => S.gap z.1)
      (s := Set.univ)
      (hcompact := (isCompact_univ : IsCompact (Set.univ : Set S.Point)))
      (hcont := (gap_carrier_continuous S).continuousOn) with
    ⟨C, _hC_nonneg, hC⟩
  refine ⟨C, ?_⟩
  intro ω
  simpa [expectedGapIntegrand, barSeq] using
    hC (S.barSeq (sample ω) n) (by simp)

private theorem expectedGapIntegrand_integrable_of_Assumption10 [MeasurableSpace Ω]
    (S : Setup Ξ Ζ E) [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E]
    [BorelSpace E]
  (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) [IsProbabilityMeasure μ]
    (xiLaw : Measure Ξ) (zetaLaw : Measure Ζ)
    (_hMean : S.OracleUnbiasedLaw xiLaw zetaLaw)
    (_h10 : S.Assumption10 sample μ) (n : ℕ)
    (hbar : Measurable (fun ω => S.barSeq (sample ω) n)) :
    Integrable (S.expectedGapIntegrand sample μ n) μ := by
  have hmeas : Measurable (S.expectedGapIntegrand sample μ n) :=
    S.expectedGapIntegrand_measurable sample μ n hbar
  have hbound : ∃ C : ℝ, ∀ ω, ‖S.expectedGapIntegrand sample μ n ω‖ ≤ C :=
    S.expectedGapIntegrand_uniformBound sample μ xiLaw zetaLaw _hMean _h10 n
  rcases hbound with ⟨C, hC⟩
  exact integrable_of_measurable_bounded_real hmeas hC

/-- Assumption 11 as a source-boundary light-tail oracle-noise predicate.  Its
displayed quotients are partial source quotients, so this declaration does not
pretend that the PDF specified Lean's zero-denominator division convention.
The independently sampled stream realization is inherited through the same
actual-coordinate law boundary as Assumption 10.

Book JSON: `book/FOML/StochasticAcceleratedMirrorProx.json#/assumptions/24`
(`Light_tail_oracle_noise`). -/
noncomputable def Assumption11_sourceBoundary [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) : Prop :=
  SourceIndependentOracleSamples sample μ ∧
    (∀ i : ℕ,
      FixedQueryLightTailOracle (xiCoordinateLaw sample μ i)
        (fun u : S.Point => fun ξ => S.Gsample u.1 ξ)
        (fun u : S.Point => S.gradG u.1) S.dualNorm S.sigmaG) ∧
    (∀ i : ℕ,
      FixedQueryLightTailOracle (zetaCoordinateLaw sample μ i)
        (fun u : S.Point => fun ζ => S.Hsample u.1 ζ)
        (fun u : S.Point => S.Hmean u.1) S.dualNorm S.sigmaH)

/-- Source-derived bridge recorded immediately after Assumption 11: the paper
says Assumption 11 implies Assumption 10 by Jensen's inequality.  The proof
must recover the fixed-query unbiased/variance oracle law needed by the
martingale argument; it is not added as a primitive field of Assumption 11. -/
theorem fixed_query_light_tail_implies_second_moment
    {X Sample E : Type*} [MeasurableSpace Sample]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {ν : Measure Sample} {oracle : X → Sample → E} {target : X → E}
    {dualNorm : E → ℝ} {sigma : ℝ}
    (hneg : ∀ v : E, dualNorm (-v) = dualNorm v)
    (h : FixedQueryLightTailOracle ν oracle target dualNorm sigma) :
    FixedQueryDualSecondMomentOracle ν oracle target dualNorm sigma := by
  intro x
  rcases h with ⟨exponent, hquot, hmoment⟩
  let f : Sample → ℝ := fun s => exponent x s
  have hExpInt : Integrable (fun s => Real.exp (f s)) ν := (hmoment x).1
  have hExpAEM : AEMeasurable (fun s => Real.exp (f s)) ν := hExpInt.aemeasurable
  have hfAEM : AEMeasurable f ν := by
    have hlogAEM :
        AEMeasurable (fun s : Sample => Real.log (Real.exp (f s))) ν :=
      (Real.measurable_log.aemeasurable
        (μ := Measure.map (fun s : Sample => Real.exp (f s)) ν)).comp_aemeasurable hExpAEM
    simpa [f, Real.log_exp] using hlogAEM
  have hfAS : AEStronglyMeasurable f ν := hfAEM.aestronglyMeasurable
  have hnonneg : ∀ s : Sample, 0 ≤ f s := by
    intro s
    simpa [f] using LightTailExponentSpec.exponent_nonneg hquot x s
  have hbound_exp : ∀ᵐ s ∂ν, ‖f s‖ ≤ Real.exp (f s) := by
    filter_upwards with s
    have hs : 0 ≤ f s := hnonneg s
    have hle : f s ≤ Real.exp (f s) := by
      have h1 : f s + 1 ≤ Real.exp (f s) := Real.add_one_le_exp (f s)
      linarith
    simpa [abs_of_nonneg hs] using hle
  have hfInt : Integrable f ν := hExpInt.mono' hfAS hbound_exp
  have honeInt : Integrable (fun _ : Sample => (1 : ℝ)) ν := by
    have hconstAS : AEStronglyMeasurable (fun _ : Sample => (1 : ℝ)) ν :=
      aestronglyMeasurable_const
    have hbound_one : ∀ᵐ s ∂ν, ‖(1 : ℝ)‖ ≤ Real.exp (f s) := by
      filter_upwards with s
      have hs : 0 ≤ f s := hnonneg s
      have h1 : (1 : ℝ) ≤ Real.exp (f s) := Real.one_le_exp hs
      simpa using h1
    exact hExpInt.mono' hconstAS hbound_one
  have hfinite : IsFiniteMeasure ν :=
    (integrable_const_iff_isFiniteMeasure (μ := ν) (c := (1 : ℝ)) one_ne_zero).1 honeInt
  by_cases hν0 : ν = 0
  · subst hν0
    constructor
    · simpa [SOptLib.expectationWellDefined_iff_integrable]
    · simpa using (sq_nonneg sigma)
  · haveI : NeZero ν := ⟨hν0⟩
    have hm_pos : 0 < ν.real Set.univ := measureReal_univ_pos
    have hJ :
        Real.exp (⨍ s, f s ∂ν) ≤ ⨍ s, Real.exp (f s) ∂ν := by
      exact
        convexOn_exp.map_average_le (μ := ν) (s := Set.univ) (f := f) (g := Real.exp)
          Real.continuous_exp.continuousOn isClosed_univ (by simp) hfInt hExpInt
    have havg_eq_f : (⨍ s, f s ∂ν) = (ν.real Set.univ)⁻¹ * (∫ s, f s ∂ν) := by
      simpa [smul_eq_mul] using (MeasureTheory.average_eq ν f)
    have havg_eq_exp : (⨍ s, Real.exp (f s) ∂ν) =
        (ν.real Set.univ)⁻¹ * (∫ s, Real.exp (f s) ∂ν) := by
      simpa [smul_eq_mul] using (MeasureTheory.average_eq ν (fun s => Real.exp (f s)))
    have havg_le :
        Real.exp ((ν.real Set.univ)⁻¹ * (∫ s, f s ∂ν)) ≤
          Real.exp (1 - Real.log (ν.real Set.univ)) := by
      calc
        Real.exp ((ν.real Set.univ)⁻¹ * (∫ s, f s ∂ν))
            = Real.exp (⨍ s, f s ∂ν) := by rw [havg_eq_f]
        _ ≤ ⨍ s, Real.exp (f s) ∂ν := hJ
        _ = (ν.real Set.univ)⁻¹ * (∫ s, Real.exp (f s) ∂ν) := by rw [havg_eq_exp]
        _ ≤ Real.exp 1 / ν.real Set.univ := by
          have hm_inv_nonneg : 0 ≤ (ν.real Set.univ)⁻¹ := by positivity
          have hle := mul_le_mul_of_nonneg_left ((hmoment x).2) hm_inv_nonneg
          simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using hle
        _ = Real.exp (1 - Real.log (ν.real Set.univ)) := by
          symm
          rw [Real.exp_sub, Real.exp_log hm_pos]
    have havg_lin :
        (ν.real Set.univ)⁻¹ * (∫ s, f s ∂ν) ≤ 1 - Real.log (ν.real Set.univ) := by
      exact Real.exp_le_exp.mp havg_le
    have h_int_le : ∫ s, f s ∂ν ≤ ν.real Set.univ * (1 - Real.log (ν.real Set.univ)) := by
      have hm_nonneg : 0 ≤ ν.real Set.univ := le_of_lt hm_pos
      have hmul := mul_le_mul_of_nonneg_left havg_lin hm_nonneg
      simpa [mul_comm, mul_left_comm, mul_assoc, hm_pos.ne'] using hmul
    have h_int_le_one : ∫ s, f s ∂ν ≤ 1 := by
      have haux1 : ν.real Set.univ - 1 ≤ ν.real Set.univ * Real.log (ν.real Set.univ) := by
        have hlog := Real.one_sub_inv_le_log_of_pos hm_pos
        have hmul := mul_le_mul_of_nonneg_left hlog (le_of_lt hm_pos)
        have hm_ne : ν.real Set.univ ≠ 0 := hm_pos.ne'
        simpa [mul_sub, mul_comm, mul_left_comm, mul_assoc, hm_ne] using hmul
      have haux : ν.real Set.univ * (1 - Real.log (ν.real Set.univ)) ≤ 1 := by
        nlinarith [haux1]
      exact le_trans h_int_le haux
    have hres_eq : ∀ s : Sample,
        dualNorm (oracle x s - target x)^2 = sigma ^ (2 : ℕ) * f s := by
      intro s
      have hswap : dualNorm (oracle x s - target x) = dualNorm (target x - oracle x s) := by
        calc
          dualNorm (oracle x s - target x) = dualNorm (-(target x - oracle x s)) := by
            simp [sub_eq_add_neg, add_comm, add_left_comm, add_assoc]
          _ = dualNorm (target x - oracle x s) := hneg (target x - oracle x s)
      have hswap_sq :
          dualNorm (oracle x s - target x)^2 = dualNorm (target x - oracle x s)^2 := by
        simpa using congrArg (fun t : ℝ => t ^ (2 : ℕ)) hswap
      rw [hswap_sq]
      simpa [f] using LightTailExponentSpec.residual_square_eq_sigma_sq_mul_exponent hquot x s
    refine ⟨?_, ?_⟩
    · have hsqInt : Integrable (fun s : Sample => dualNorm (oracle x s - target x)^2) ν := by
        have hmulInt : Integrable (fun s : Sample => sigma ^ (2 : ℕ) * f s) ν :=
          hfInt.const_mul (sigma ^ (2 : ℕ))
        simpa [hres_eq] using hmulInt
      simpa [SOptLib.expectationWellDefined_iff_integrable, hres_eq] using hsqInt
    · have hmulInt : ∫ s, sigma ^ (2 : ℕ) * f s ∂ν ≤ sigma ^ (2 : ℕ) := by
        have hsq_nonneg : 0 ≤ sigma ^ (2 : ℕ) := sq_nonneg _
        rw [MeasureTheory.integral_const_mul]
        nlinarith [h_int_le_one, hsq_nonneg]
      simpa [hres_eq] using hmulInt

theorem Assumption11_sourceBoundary_implies_Assumption10 [MeasurableSpace Ω]
    (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω)
    (_h11 : S.Assumption11_sourceBoundary sample μ) :
    S.Assumption10 sample μ := by
  rcases _h11 with ⟨hIndep, hG, hH⟩
  refine ⟨hIndep, ?_, ?_⟩
  · intro i
    exact fixed_query_light_tail_implies_second_moment
      (dualNorm := S.dualNorm) (hneg := S.dualNorm_neg) (hG i)
  · intro i
    exact fixed_query_light_tail_implies_second_moment
      (dualNorm := S.dualNorm) (hneg := S.dualNorm_neg) (hH i)

/-- Exponential-noise integrability required to use Assumption 11 in
high-probability proofs; this is a proof obligation attached to the displayed
light-tail expectation, not an extra paper assumption. -/
theorem Assumption11_sourceBoundary_regularity_obligation [MeasurableSpace Ω]
    (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω)
    (_h11 : S.Assumption11_sourceBoundary sample μ) :
    (∀ i : ℕ, ∃ Gexponent : S.Point → Ξ → ℝ,
      LightTailExponentSpec
        (fun u : S.Point => fun ξ => S.Gsample u.1 ξ)
        (fun u : S.Point => S.gradG u.1) S.dualNorm S.sigmaG Gexponent ∧
      (∀ u : S.Point, Integrable (fun ξ => Real.exp (Gexponent u ξ))
        (xiCoordinateLaw sample μ i))) ∧
    (∀ i : ℕ, ∃ Hexponent : S.Point → Ζ → ℝ,
      LightTailExponentSpec
        (fun u : S.Point => fun ζ => S.Hsample u.1 ζ)
        (fun u : S.Point => S.Hmean u.1) S.dualNorm S.sigmaH Hexponent ∧
      (∀ u : S.Point, Integrable (fun ζ => Real.exp (Hexponent u ζ))
        (zetaCoordinateLaw sample μ i))) := by
  rcases _h11 with ⟨_, hG, hH⟩
  constructor
  · intro i
    rcases FixedQueryLightTailOracle.integrable_exp
        (ν := xiCoordinateLaw sample μ i)
        (oracle := fun u : S.Point => fun ξ => S.Gsample u.1 ξ)
        (target := fun u : S.Point => S.gradG u.1)
        (dualNorm := S.dualNorm) (sigma := S.sigmaG) (hG i) with
      ⟨Gexponent, hGspec, hGint⟩
    exact ⟨Gexponent, hGspec, hGint⟩
  · intro i
    rcases FixedQueryLightTailOracle.integrable_exp
        (ν := zetaCoordinateLaw sample μ i)
        (oracle := fun u : S.Point => fun ζ => S.Hsample u.1 ζ)
        (target := fun u : S.Point => S.Hmean u.1)
        (dualNorm := S.dualNorm) (sigma := S.sigmaH) (hH i) with
      ⟨Hexponent, hHspec, hHint⟩
    exact ⟨Hexponent, hHspec, hHint⟩

/-- Specification of a finite sum of source-displayed quotients.  Each summand
is carried by a checked quotient witness, so zero denominators are not silently
interpreted by Lean division. -/
def CheckedQuotientFinsetSumSpec (s : Finset ℕ) (numerator denominator : ℕ → ℝ)
    (value : ℝ) : Prop :=
  ∃ term : ℕ → ℝ,
    (∀ i ∈ s, SOptLib.checked_quotient_spec (numerator i) (denominator i) (term i)) ∧
      value = s.sum term

/-- Checked-source specification of the closed-form `Q_0(t)` from Theorem
4.10, including every displayed denominator in (4.5.38). -/
def Q0Spec (S : Setup Ξ Ζ E) (t : {n : ℕ // 1 ≤ n}) (value : ℝ) : Prop :=
  ∃ leading curvatureNoise weightedSum : ℝ,
    SOptLib.checked_quotient_spec (2 * S.alpha t.1) (S.gamma t.1) leading ∧
      SOptLib.checked_quotient_spec 1 (2 * (1 - S.q)) curvatureNoise ∧
      CheckedQuotientFinsetSumSpec (Finset.Icc 1 t.1)
        (fun i => S.alpha i * S.gamma i) S.Gamma weightedSum ∧
      value =
        leading * S.DZ ^ 2 +
          (4 * S.sigmaH ^ 2 + (1 + curvatureNoise) * S.sigmaG ^ 2) *
            S.Gamma t.1 * weightedSum

/-- Checked-source specification of the closed-form `Q_1(t)` from Theorem
4.10, including every displayed denominator in (4.5.40). -/
def Q1Spec (S : Setup Ξ Ζ E) (t : {n : ℕ // 1 ≤ n}) (value : ℝ) : Prop :=
  ∃ curvatureNoise weightedSum : ℝ, ∃ alphaOverGamma : ℕ → ℝ,
    SOptLib.checked_quotient_spec 1 (2 * (1 - S.q)) curvatureNoise ∧
      CheckedQuotientFinsetSumSpec (Finset.Icc 1 t.1)
        (fun i => S.alpha i * S.gamma i) S.Gamma weightedSum ∧
      (∀ i ∈ Finset.Icc 1 t.1,
        SOptLib.checked_quotient_spec (S.alpha i) (S.Gamma i) (alphaOverGamma i)) ∧
      value =
        S.Gamma t.1 * (S.sigmaG + S.sigmaH) * S.DZ *
            Real.sqrt
              (2 * (Finset.Icc 1 t.1).sum
                (fun i => (alphaOverGamma i) ^ (2 : ℕ))) +
            (4 * S.sigmaH ^ 2 + (1 + curvatureNoise) * S.sigmaG ^ 2) *
            S.Gamma t.1 * weightedSum

private theorem CheckedQuotientFinsetSumSpec.eq_sum_div
    {s : Finset ℕ} {numerator denominator : ℕ → ℝ} {value : ℝ}
    (h : CheckedQuotientFinsetSumSpec s numerator denominator value) :
    value = s.sum (fun i => numerator i / denominator i) := by
  rcases h with ⟨term, hterm, rfl⟩
  refine Finset.sum_congr rfl ?_
  intro i hi
  exact SOptLib.eq_div_of_checked_quotient_spec (hterm i hi)

private theorem CheckedQuotientFinsetSumSpec.eq_range_paperTime_sum
    (S : Setup Ξ Ζ E) {t : {n : ℕ // 1 ≤ n}} {weightedSum : ℝ}
    (h : CheckedQuotientFinsetSumSpec (Finset.Icc 1 t.1)
      (fun i => S.alpha i * S.gamma i) S.Gamma weightedSum) :
    weightedSum =
      (Finset.range t.1).sum
        (fun i => S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
          S.Gamma (paperTime i).1) := by
  calc
    weightedSum =
        (Finset.Icc 1 t.1).sum
          (fun i => S.alpha i * S.gamma i / S.Gamma i) :=
      h.eq_sum_div
    _ =
        (Finset.range t.1).sum
          (fun i => S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
            S.Gamma (paperTime i).1) := by
      simpa [paperTime] using
        (sum_Icc_one_eq_sum_range_succ (k := t.1)
          (F := fun i => S.alpha i * S.gamma i / S.Gamma i))

private theorem finite_weighted_scalar_integral_le
    [MeasurableSpace Ω] {μ : Measure Ω} {ι : Type*} (s : Finset ι)
    (coeff : ι → ℝ) (X : ι → Ω → ℝ) (bound : ι → ℝ)
    (hcoeff_nonneg : ∀ i ∈ s, 0 ≤ coeff i)
    (hX_int : ∀ i ∈ s, Integrable (X i) μ)
    (hX_bound : ∀ i ∈ s, (∫ ω, X i ω ∂μ) ≤ bound i) :
    (∫ ω, s.sum (fun i => coeff i * X i ω) ∂μ) ≤
      s.sum (fun i => coeff i * bound i) := by
  classical
  have hterm_int : ∀ i ∈ s, Integrable (fun ω => coeff i * X i ω) μ := by
    intro i hi
    exact (hX_int i hi).const_mul (coeff i)
  calc
    (∫ ω, s.sum (fun i => coeff i * X i ω) ∂μ)
        = s.sum (fun i => ∫ ω, coeff i * X i ω ∂μ) := by
          rw [integral_finset_sum s hterm_int]
    _ ≤ s.sum (fun i => coeff i * bound i) := by
          refine Finset.sum_le_sum ?_
          intro i hi
          rw [integral_const_mul]
          exact mul_le_mul_of_nonneg_left (hX_bound i hi) (hcoeff_nonneg i hi)

/-- Source-well-definedness obligation for `Q_0(t)`: the displayed fractions in
(4.5.38) must have checked quotient witnesses. -/
theorem Q0_exists (S : Setup Ξ Ζ E) (t : {n : ℕ // 1 ≤ n}) :
    ∃ value : ℝ, S.Q0Spec t value := by
  let leading : ℝ := (2 * S.alpha t.1) / S.gamma t.1
  let curvatureNoise : ℝ := 1 / (2 * (1 - S.q))
  let term : ℕ → ℝ := fun i => (S.alpha i * S.gamma i) / S.Gamma i
  let weightedSum : ℝ := (Finset.Icc 1 t.1).sum term
  let value : ℝ :=
    leading * S.DZ ^ 2 +
      (4 * S.sigmaH ^ 2 + (1 + curvatureNoise) * S.sigmaG ^ 2) *
        S.Gamma t.1 * weightedSum
  have hcurv_den_ne : 2 * (1 - S.q) ≠ 0 := by
    have hpos : 0 < 2 * (1 - S.q) := by
      nlinarith [S.q_mem.2]
    exact ne_of_gt hpos
  have hgamma_den_ne : S.gamma t.1 ≠ 0 := by
    obtain ⟨rho_t, rho_next, hratio_t, hratio_next, hle⟩ :=
      S.gamma_ratio_mono_with_Gamma t
    exact right_ne_zero_of_mul hratio_t.1
  have hGamma_den_ne : ∀ i ∈ Finset.Icc 1 t.1, S.Gamma i ≠ 0 := by
    intro i hi
    have hi_pos : 1 ≤ i := (Finset.mem_Icc.mp hi).1
    obtain ⟨rho_i, rho_next, hratio_i, hratio_next, hle⟩ :=
      S.gamma_ratio_mono_with_Gamma ⟨i, hi_pos⟩
    exact left_ne_zero_of_mul hratio_i.1
  have hlead :
      SOptLib.checked_quotient_spec (2 * S.alpha t.1) (S.gamma t.1) leading := by
    exact SOptLib.checked_quotient_spec_div_of_den_ne
      (2 * S.alpha t.1) hgamma_den_ne
  have hcurv :
      SOptLib.checked_quotient_spec 1 (2 * (1 - S.q)) curvatureNoise := by
    exact SOptLib.checked_quotient_spec_div_of_den_ne 1 hcurv_den_ne
  have hsum :
      CheckedQuotientFinsetSumSpec (Finset.Icc 1 t.1)
        (fun i => S.alpha i * S.gamma i) S.Gamma weightedSum := by
    refine ⟨term, ?_, rfl⟩
    intro i hi
    exact SOptLib.checked_quotient_spec_div_of_den_ne
      (S.alpha i * S.gamma i) (hGamma_den_ne i hi)
  refine ⟨value, leading, curvatureNoise, weightedSum, hlead, hcurv, hsum, ?_⟩
  rfl

/-- Closed-form real value `Q_0(t)` selected from the checked-source
specification of Theorem 4.10. -/
noncomputable def Q0 (S : Setup Ξ Ζ E) (t : {n : ℕ // 1 ≤ n}) : ℝ :=
