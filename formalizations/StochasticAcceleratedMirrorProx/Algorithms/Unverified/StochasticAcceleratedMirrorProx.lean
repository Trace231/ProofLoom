private theorem SAMPInterleavedConditionalOracleLawBoundary.dualNorm_add_square_integrable_and_integral_le
    [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) [IsProbabilityMeasure μ]
    (h : S.SAMPInterleavedConditionalOracleLawBoundary sample μ) (i : ℕ) :
    Integrable
        (fun ω =>
          S.dualNorm (S.deltaHEvenProcess sample i ω + S.deltaGProcess sample i ω) ^
            (2 : ℕ)) μ ∧
      (∫ ω,
          S.dualNorm (S.deltaHEvenProcess sample i ω + S.deltaGProcess sample i ω) ^
            (2 : ℕ) ∂μ) ≤
        2 * S.sigmaH ^ (2 : ℕ) + 2 * S.sigmaG ^ (2 : ℕ) := by
  rcases h with ⟨hG, _hOdd, hEven, hGzero, hEvenZero⟩
  have hG_sq :
      Integrable
          (fun ω => S.dualNorm (S.deltaGProcess sample i ω) ^ (2 : ℕ)) μ ∧
        (∫ ω, S.dualNorm (S.deltaGProcess sample i ω) ^ (2 : ℕ) ∂μ) ≤
          S.sigmaG ^ (2 : ℕ) := by
    simpa [SAMPInterleavedConditionalOracleLawBoundary] using
      (SAMPInterleavedConditionalOracleLawBoundary.G_secondMoment_integral_le
        S sample μ ⟨hG, _hOdd, hEven, hGzero, hEvenZero⟩ i)
  have hEven_sq :
      Integrable
          (fun ω => S.dualNorm (S.deltaHEvenProcess sample i ω) ^ (2 : ℕ)) μ ∧
        (∫ ω, S.dualNorm (S.deltaHEvenProcess sample i ω) ^ (2 : ℕ) ∂μ) ≤
          S.sigmaH ^ (2 : ℕ) := by
    simpa [SAMPInterleavedConditionalOracleLawBoundary] using
      (SAMPInterleavedConditionalOracleLawBoundary.H_even_secondMoment_integral_le
        S sample μ ⟨hG, _hOdd, hEven, hGzero, hEvenZero⟩ i)
  have hG_vec_int : Integrable (S.deltaGProcess sample i) μ :=
    SOptLib.ConditionalExpectation.conditionalExpectationWellDefined.integrable
      (SOptLib.ConditionalExpectation.conditionalExpectationEq.wellDefined (hG.1 i))
  have hEven_vec_int : Integrable (S.deltaHEvenProcess sample i) μ :=
    SOptLib.ConditionalExpectation.conditionalExpectationWellDefined.integrable
      (SOptLib.ConditionalExpectation.conditionalExpectationEq.wellDefined (hEven.1 i))
  have hsum_vec_int :
      Integrable
        (fun ω => S.deltaHEvenProcess sample i ω + S.deltaGProcess sample i ω) μ :=
    hEven_vec_int.add hG_vec_int
  rcases
      Seminorm.exists_norm_le_mul_self_of_finiteDimensional_separating
        (p := S.primalSeminorm) S.primalSeminorm_separating with
    ⟨C, hC_nonneg, hC⟩
  have hcontrol : ∀ d : E, S.primalSeminorm d ≤ 1 → ‖d‖ ≤ C := by
    intro d hd
    have hnorm : ‖d‖ ≤ C * S.primalSeminorm d := hC d
    nlinarith
  have hdual_cont : Continuous (fun x : E => S.dualNorm x) := by
    simpa [dualNorm] using
      (SOptLib.canonicalDualNorm_continuous
        (p := S.primalSeminorm) (C := C) hcontrol)
  have hadd_aesm :
      AEStronglyMeasurable
        (fun ω =>
          S.dualNorm (S.deltaHEvenProcess sample i ω + S.deltaGProcess sample i ω) ^
            (2 : ℕ)) μ := by
    exact (hdual_cont.comp_aestronglyMeasurable hsum_vec_int.aestronglyMeasurable).pow 2
  let upper : Ω → ℝ := fun ω =>
    2 * S.dualNorm (S.deltaHEvenProcess sample i ω) ^ (2 : ℕ) +
      2 * S.dualNorm (S.deltaGProcess sample i ω) ^ (2 : ℕ)
  have hupper_int : Integrable upper μ :=
    (hEven_sq.1.const_mul 2).add (hG_sq.1.const_mul 2)
  have hadd_int :
      Integrable
        (fun ω =>
          S.dualNorm (S.deltaHEvenProcess sample i ω + S.deltaGProcess sample i ω) ^
            (2 : ℕ)) μ := by
    refine hupper_int.mono' hadd_aesm ?_
    filter_upwards with ω
    dsimp [upper]
    rw [abs_of_nonneg (sq_nonneg
      (S.dualNorm (S.deltaHEvenProcess sample i ω + S.deltaGProcess sample i ω)))]
    exact
      dualNorm_add_sq_le_two_mul_sq_add_two_mul_sq S
        (S.deltaHEvenProcess sample i ω) (S.deltaGProcess sample i ω)
  constructor
  · exact hadd_int
  · have hmono :
        (∫ ω,
          S.dualNorm (S.deltaHEvenProcess sample i ω + S.deltaGProcess sample i ω) ^
            (2 : ℕ) ∂μ) ≤ ∫ ω, upper ω ∂μ :=
      integral_mono hadd_int hupper_int
        (fun ω =>
          dualNorm_add_sq_le_two_mul_sq_add_two_mul_sq S
            (S.deltaHEvenProcess sample i ω) (S.deltaGProcess sample i ω))
    have hupper_eval :
        (∫ ω, upper ω ∂μ) =
          2 * (∫ ω, S.dualNorm (S.deltaHEvenProcess sample i ω) ^ (2 : ℕ) ∂μ) +
            2 * (∫ ω, S.dualNorm (S.deltaGProcess sample i ω) ^ (2 : ℕ) ∂μ) := by
      simp [upper, integral_add (hEven_sq.1.const_mul 2) (hG_sq.1.const_mul 2),
        integral_const_mul]
    calc
      (∫ ω,
          S.dualNorm (S.deltaHEvenProcess sample i ω + S.deltaGProcess sample i ω) ^
            (2 : ℕ) ∂μ) ≤ ∫ ω, upper ω ∂μ := hmono
      _ =
          2 * (∫ ω, S.dualNorm (S.deltaHEvenProcess sample i ω) ^ (2 : ℕ) ∂μ) +
            2 * (∫ ω, S.dualNorm (S.deltaGProcess sample i ω) ^ (2 : ℕ) ∂μ) :=
          hupper_eval
      _ ≤ 2 * S.sigmaH ^ (2 : ℕ) + 2 * S.sigmaG ^ (2 : ℕ) := by
          nlinarith [hEven_sq.2, hG_sq.2]

private theorem samp_auxiliary_one_step_bound_of_three_point
    (S : Setup Ξ Ζ E) (center next u : S.Point) (g : E) (gamma : ℝ)
    (hgamma_nonneg : 0 ≤ gamma)
    (hthree :
      gamma * ⟪g, next.1 - u.1⟫_ℝ + S.V center next ≤
        S.V center u - S.V next u) :
    gamma * ⟪g, center.1 - u.1⟫_ℝ ≤
      S.V center u - S.V next u +
        (1 / 2 : ℝ) * gamma ^ (2 : ℕ) * S.dualNorm g ^ (2 : ℕ) := by
  have hsupport :
      ⟪g, center.1 - next.1⟫_ℝ ≤
        S.dualNorm g * S.primalNorm (center.1 - next.1) := by
    rcases
        Seminorm.exists_norm_le_mul_self_of_finiteDimensional_separating
          (p := S.primalSeminorm) S.primalSeminorm_separating with
      ⟨C, _hC_nonneg, hC⟩
    have hcontrol : ∀ d : E, S.primalSeminorm d ≤ 1 → ‖d‖ ≤ C := by
      intro d hd
      have hnorm : ‖d‖ ≤ C * S.primalSeminorm d := hC d
      nlinarith
    have hbdd :
        BddAbove {r : ℝ | ∃ d : E, S.primalSeminorm d ≤ 1 ∧
          r = |inner ℝ g d|} :=
      SOptLib.canonicalDualNorm_supportSet_bddAbove
        (p := S.primalSeminorm) g ⟨C, hcontrol⟩
    have habs :
        |inner ℝ g (center.1 - next.1)| ≤
          SOptLib.canonicalDualNorm S.primalSeminorm g *
            S.primalSeminorm (center.1 - next.1) :=
      SOptLib.abs_inner_le_canonicalDualNorm_mul
        (p := S.primalSeminorm) S.primalSeminorm_separating
        (zeta := g) (d := center.1 - next.1) hbdd
    exact le_trans (le_abs_self _) (by simpa [dualNorm, primalNorm] using habs)
  have hlower :
      (1 / 2 : ℝ) * S.primalNorm (center.1 - next.1) ^ (2 : ℕ) ≤
        S.V center next :=
    S.half_primalNorm_sq_le_V center next
  exact
    prox_gamma_step_bound_of_three_point_and_dual_support
      (V := S.V) (eval := fun p : S.Point => p.1)
      (primalNorm := S.primalNorm) (dualNorm := S.dualNorm)
      (z := center) (y := next) (x := u) (g := g) (γ := gamma)
      hgamma_nonneg hthree hsupport hlower

private theorem samp_auxiliary_three_point_of_isAuxiliaryProxStep
    (S : Setup Ξ Ζ E) (center next u : S.Point) (delta : E) (gamma : ℝ)
    (hstep : S.IsAuxiliaryProxStep center delta gamma next) :
    gamma * ⟪-delta, next.1 - u.1⟫_ℝ + S.V center next ≤
      S.V center u - S.V next u := by
  let nu : S.Point → ℝ := fun x => S.omega x.1
  let grad : S.Point → E := fun x => gradientWithin S.omega S.Z x.1
  have hmin :
      IsMinOn
        (fun x : S.Point =>
          ⟪-(gamma • delta), x.1⟫_ℝ +
            carrierBregmanDivergence nu grad center x)
        Set.univ next := by
    rw [isMinOn_univ_iff]
    intro x
    have hstep_univ := isMinOn_univ_iff.mp hstep x
    simpa [IsAuxiliaryProxStep, auxiliaryProxObjective, V, carrierBregman,
      paperSAMPCarrierBregmanOn, nu, grad, inner_smul_left, mul_comm, mul_left_comm,
      mul_assoc] using hstep_univ
  have hnu_eq_segment :
      ∀ r (hr : r ∈ Set.Icc (0 : ℝ) 1),
        nu
          ⟨AffineMap.lineMap next.1 u.1 r,
            S.Z_convex.lineMap_mem next.2 u.2 hr⟩ =
          S.omega (AffineMap.lineMap next.1 u.1 r) := by
    intro r hr
    rfl
  have hnu_diff : DifferentiableWithinAt ℝ S.omega S.Z next.1 :=
    S.gradOmega_source_defined next
  have hgrad_apply :
      (fderivWithin ℝ S.omega S.Z next.1) (u.1 - next.1) =
        ⟪grad next, u.1 - next.1⟫_ℝ := by
    simp [grad, gradientWithin, InnerProductSpace.toDual_symm_apply]
  have hthree :=
    prox_three_point_of_isMinOn_linear_bregman
      (hX_convex := S.Z_convex)
      (nu := nu) (nuAmbient := S.omega) (grad := grad)
      (z := center) (y := next) (x := u) (ζ := -(gamma • delta))
      hnu_eq_segment hnu_diff hgrad_apply hmin
  simpa [V, carrierBregman, paperSAMPCarrierBregmanOn, nu, grad,
    inner_smul_left, mul_comm, mul_left_comm, mul_assoc] using hthree

private theorem samp_composite_scaled_variational_of_IsProxStep
    (S : Setup Ξ Ζ E) (center next u : S.Point) (eta : E)
    (gamma : ℝ) (hgamma : 0 < gamma)
    (hstep : S.IsProxStep center eta gamma next) :
    0 ≤
      gamma * ⟪eta, u.1 - next.1⟫_ℝ +
        ⟪S.gradOmega next - S.gradOmega center, u.1 - next.1⟫_ℝ +
        gamma * (S.J u.1 - S.J next.1) := by
  classical
  let nu : S.Point → ℝ := fun x => S.omega x.1
  let grad : S.Point → E := fun x => gradientWithin S.omega S.Z x.1
  let dvec : E := u.1 - next.1
  let segment : ∀ t : ℝ, t ∈ Set.Icc (0 : ℝ) 1 → S.Point :=
    fun t ht =>
      ⟨AffineMap.lineMap next.1 u.1 t, S.Z_convex.lineMap_mem next.2 u.2 ht⟩
  let β : ℝ → ℝ := fun t =>
    if ht : t ∈ Set.Icc (0 : ℝ) 1 then
      carrierBregmanDivergence nu grad center (segment t ht) -
        carrierBregmanDivergence nu grad center next
    else 0
  let φ : ℝ → ℝ := fun t =>
    gamma * t * ⟪eta, dvec⟫_ℝ + β t +
      gamma * t * (S.J u.1 - S.J next.1)
  have hnu_eq_segment :
      ∀ r (hr : r ∈ Set.Icc (0 : ℝ) 1),
        nu
          ⟨AffineMap.lineMap next.1 u.1 r,
            S.Z_convex.lineMap_mem next.2 u.2 hr⟩ =
          S.omega (AffineMap.lineMap next.1 u.1 r) := by
    intro r hr
    rfl
  have hnu_diff : DifferentiableWithinAt ℝ S.omega S.Z next.1 :=
    S.gradOmega_source_defined next
  have hgrad_apply :
      (fderivWithin ℝ S.omega S.Z next.1) (u.1 - next.1) =
        ⟪grad next, u.1 - next.1⟫_ℝ := by
    simp [grad, gradientWithin, InnerProductSpace.toDual_symm_apply]
  have hβ :
      HasDerivWithinAt β
        ⟪grad next - grad center, dvec⟫_ℝ
        (Set.Icc (0 : ℝ) 1) 0 := by
    have hnu_eq : ∀ y : S.Point, nu y = S.omega y.1 := by
      intro y
      rfl
    have hgrad_all :
        ∀ (y : S.Point) (d : E),
          (fderivWithin ℝ S.omega S.Z y.1) d = ⟪grad y, d⟫_ℝ := by
      intro y d
      simp [grad, gradientWithin, InnerProductSpace.toDual_symm_apply]
    have hV :
        ∀ x z : S.Point,
          carrierBregmanDivergence nu grad x z =
            nu z - nu x - ⟪grad x, z.1 - x.1⟫_ℝ := by
      intro x z
      rfl
    simpa [β, segment, dvec] using
      (carrierBregman_segment_difference_hasDerivWithinAt_zero
        (hX_convex := S.Z_convex) (nu := nu) (nuAmbient := S.omega)
        (grad := grad)
        (V := fun x z : S.Point => carrierBregmanDivergence nu grad x z)
        hnu_eq S.omega_differentiableOn_carrier hgrad_all hV
        center next u)
  have hφderiv :
      HasDerivWithinAt φ
        (gamma * ⟪eta, dvec⟫_ℝ +
          ⟪grad next - grad center, dvec⟫_ℝ +
          gamma * (S.J u.1 - S.J next.1))
        (Set.Icc (0 : ℝ) 1) 0 := by
    simpa [φ] using
      (prox_majorant_hasDerivWithinAt_zero β eta dvec
        (grad next - grad center) gamma (S.J u.1 - S.J next.1) hβ)
  have hφ0 : φ 0 = 0 := by
    have h0 : (0 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := by norm_num
    have hseg0 : segment 0 h0 = next := by
      apply Subtype.ext
      simp [segment, AffineMap.lineMap_apply_module']
    have hβ0 : β 0 = 0 := by
      dsimp [β]
      rw [dif_pos h0, hseg0]
      ring
    simp [φ, hβ0]
  have hmin_all : ∀ y : S.Point,
      S.proxObjective center eta gamma next ≤
        S.proxObjective center eta gamma y := by
    intro y
    exact Setup.IsProxStep.le S hstep y
  have hφ_nonneg : ∀ t ∈ Set.Icc (0 : ℝ) 1, 0 ≤ φ t := by
    intro t ht
    have hseg_sub : (segment t ht).1 - next.1 = t • dvec := by
      simp [segment, dvec, AffineMap.lineMap_apply_module']
    have hinner_line :
        ⟪eta, (segment t ht).1 - center.1⟫_ℝ -
            ⟪eta, next.1 - center.1⟫_ℝ =
          t * ⟪eta, dvec⟫_ℝ := by
      calc
        ⟪eta, (segment t ht).1 - center.1⟫_ℝ -
            ⟪eta, next.1 - center.1⟫_ℝ =
            ⟪eta, ((segment t ht).1 - center.1) -
              (next.1 - center.1)⟫_ℝ := by
          rw [← inner_sub_right]
        _ = ⟪eta, (segment t ht).1 - next.1⟫_ℝ := by
          congr 1
          abel
        _ = t * ⟪eta, dvec⟫_ℝ := by
          rw [hseg_sub, inner_smul_right]
    have hJconv_raw :=
      S.J_convexOn.2 next.2 u.2 (sub_nonneg.mpr ht.2) ht.1 (by ring)
    have hJconv_line :
        S.J (segment t ht).1 ≤ (1 - t) * S.J next.1 + t * S.J u.1 := by
      simpa [segment, AffineMap.lineMap_apply_module, smul_eq_mul,
        mul_comm, mul_left_comm, mul_assoc] using hJconv_raw
    have hJconv_sub :
        S.J (segment t ht).1 - S.J next.1 ≤
          t * (S.J u.1 - S.J next.1) := by
      nlinarith
    have hobj_nonneg :
        0 ≤
          S.proxObjective center eta gamma (segment t ht) -
            S.proxObjective center eta gamma next := by
      exact sub_nonneg.mpr (hmin_all (segment t ht))
    have hobj_scaled :
        S.proxObjective center eta gamma (segment t ht) -
            S.proxObjective center eta gamma next =
          gamma * t * ⟪eta, dvec⟫_ℝ +
            (carrierBregmanDivergence nu grad center (segment t ht) -
              carrierBregmanDivergence nu grad center next) +
            gamma * (S.J (segment t ht).1 - S.J next.1) := by
      simp only [Setup.proxObjective, paperSAMPProxObjectiveOn]
      simp only [V, carrierBregman, paperSAMPCarrierBregmanOn] at *
      change
        (gamma * (⟪eta, (segment t ht).1 - center.1⟫_ℝ +
              S.J (segment t ht).1) +
            carrierBregmanDivergence nu grad center (segment t ht)) -
          (gamma * (⟪eta, next.1 - center.1⟫_ℝ + S.J next.1) +
            carrierBregmanDivergence nu grad center next) =
          gamma * t * ⟪eta, dvec⟫_ℝ +
            (carrierBregmanDivergence nu grad center (segment t ht) -
              carrierBregmanDivergence nu grad center next) +
            gamma * (S.J (segment t ht).1 - S.J next.1)
      nlinarith [hinner_line]
    have hφ_eval :
        φ t =
          gamma * t * ⟪eta, dvec⟫_ℝ +
            (carrierBregmanDivergence nu grad center (segment t ht) -
              carrierBregmanDivergence nu grad center next) +
            gamma * (t * (S.J u.1 - S.J next.1)) := by
      have hβ_eval :
          β t =
            carrierBregmanDivergence nu grad center (segment t ht) -
              carrierBregmanDivergence nu grad center next := by
        dsimp [β]
        rw [dif_pos ht]
      dsimp [φ]
      rw [hβ_eval]
      ring
    have hmajorant :
        S.proxObjective center eta gamma (segment t ht) -
            S.proxObjective center eta gamma next ≤ φ t := by
      rw [hobj_scaled, hφ_eval]
      have hscaled :=
        mul_le_mul_of_nonneg_left hJconv_sub (le_of_lt hgamma)
      nlinarith
    exact le_trans hobj_nonneg hmajorant
  have hscaled :=
    prox_scaled_variational_inequality_of_argmin
      (fun y : S.Point => y.1) grad (fun y : S.Point => S.J y.1)
      center next u eta gamma φ hφ0 hφ_nonneg hφderiv
  simpa [dvec, grad, Setup.gradOmega] using hscaled

private theorem samp_composite_three_point_of_IsProxStep
    (S : Setup Ξ Ζ E) (center next u : S.Point) (eta : E)
    (gamma : ℝ) (hgamma : 0 < gamma)
    (hstep : S.IsProxStep center eta gamma next) :
    gamma * (⟪eta, next.1 - u.1⟫_ℝ + S.J next.1 - S.J u.1) +
        S.V center next ≤
      S.V center u - S.V next u := by
  let grad : S.Point → E := fun x => gradientWithin S.omega S.Z x.1
  have hvar :=
    samp_composite_scaled_variational_of_IsProxStep
      S center next u eta gamma hgamma hstep
  have hvar' :
      0 ≤ ⟪gamma • eta + grad next - grad center, u.1 - next.1⟫_ℝ +
          gamma * (S.J u.1 - S.J next.1) := by
    have hrewrite :
        ⟪gamma • eta + grad next - grad center, u.1 - next.1⟫_ℝ =
          gamma * ⟪eta, u.1 - next.1⟫_ℝ +
            ⟪grad next - grad center, u.1 - next.1⟫_ℝ := by
      rw [inner_sub_left, inner_add_left, real_inner_smul_left]
      rw [inner_sub_left]
      ring
    rw [hrewrite]
    simpa [grad, Setup.gradOmega, inner_sub_left, add_assoc] using hvar
  have hvar_split :
      0 ≤ gamma * ⟪eta, u.1 - next.1⟫_ℝ +
          ⟪grad next - grad center, u.1 - next.1⟫_ℝ +
          gamma * (S.J u.1 - S.J next.1) := by
    simpa [grad, Setup.gradOmega] using hvar
  have hthree :
      S.V center u =
        S.V center next +
          ⟪grad next - grad center, u.1 - next.1⟫_ℝ +
            S.V next u := by
    simpa [V, carrierBregman, paperSAMPCarrierBregmanOn, grad] using
      carrierBregmanDivergence_three_point_identity
        (v := fun x : S.Point => S.omega x.1)
        (eval := fun x : S.Point => x.1) (grad := grad) (V := S.V)
        (by
          intro x z
          rfl)
        center next u
  have hinner :
      gamma * ⟪eta, next.1 - u.1⟫_ℝ +
          gamma * (S.J next.1 - S.J u.1) ≤
        ⟪grad next - grad center, u.1 - next.1⟫_ℝ := by
    have hneg_inner :
        ⟪eta, next.1 - u.1⟫_ℝ = -⟪eta, u.1 - next.1⟫_ℝ := by
      have hsub : next.1 - u.1 = -(u.1 - next.1) := by abel
      rw [hsub, inner_neg_right]
    rw [hneg_inner]
    nlinarith [hvar_split]
  nlinarith [hinner, hthree]

private theorem samp_auxiliary_scaled_one_step_bound
    (S : Setup Ξ Ζ E) (center next u : S.Point) (delta : E)
    (τ : {n : ℕ // 1 ≤ n})
    (hstep : S.IsAuxiliaryProxStep center delta (S.gamma τ.1) next) :
    (S.alpha τ.1 / S.Gamma τ.1) * ⟪-delta, center.1 - u.1⟫_ℝ ≤
      (S.alpha τ.1 / (S.Gamma τ.1 * S.gamma τ.1)) *
          (S.V center u - S.V next u) +
        (S.alpha τ.1 * S.gamma τ.1 / (2 * S.Gamma τ.1)) *
          S.dualNorm delta ^ (2 : ℕ) := by
  have hgamma_pos : 0 < S.gamma τ.1 := S.gamma_pos τ
  have hGamma_pos : 0 < S.Gamma τ.1 := S.Gamma_pos τ
  have halpha_nonneg : 0 ≤ S.alpha τ.1 :=
    (Set.mem_Icc.mp (S.alpha_range τ)).1
  have hcoeff_nonneg :
      0 ≤ S.alpha τ.1 / (S.Gamma τ.1 * S.gamma τ.1) := by
    exact div_nonneg halpha_nonneg
      (mul_nonneg (le_of_lt hGamma_pos) (le_of_lt hgamma_pos))
  have hthree :
      S.gamma τ.1 * ⟪-delta, next.1 - u.1⟫_ℝ + S.V center next ≤
        S.V center u - S.V next u :=
    samp_auxiliary_three_point_of_isAuxiliaryProxStep
      S center next u delta (S.gamma τ.1) hstep
  have hraw :
      S.gamma τ.1 * ⟪-delta, center.1 - u.1⟫_ℝ ≤
        S.V center u - S.V next u +
          (1 / 2 : ℝ) * S.gamma τ.1 ^ (2 : ℕ) *
            S.dualNorm delta ^ (2 : ℕ) := by
    have h :=
      samp_auxiliary_one_step_bound_of_three_point
        S center next u (-delta) (S.gamma τ.1)
        (le_of_lt hgamma_pos) hthree
    simpa [S.dualNorm_neg] using h
  have hmul :=
    mul_le_mul_of_nonneg_left hraw hcoeff_nonneg
  calc
    (S.alpha τ.1 / S.Gamma τ.1) * ⟪-delta, center.1 - u.1⟫_ℝ =
        (S.alpha τ.1 / (S.Gamma τ.1 * S.gamma τ.1)) *
          (S.gamma τ.1 * ⟪-delta, center.1 - u.1⟫_ℝ) := by
          field_simp [ne_of_gt hGamma_pos, ne_of_gt hgamma_pos]
    _ ≤
        (S.alpha τ.1 / (S.Gamma τ.1 * S.gamma τ.1)) *
          (S.V center u - S.V next u +
            (1 / 2 : ℝ) * S.gamma τ.1 ^ (2 : ℕ) *
              S.dualNorm delta ^ (2 : ℕ)) := hmul
    _ =
        (S.alpha τ.1 / (S.Gamma τ.1 * S.gamma τ.1)) *
            (S.V center u - S.V next u) +
          (S.alpha τ.1 * S.gamma τ.1 / (2 * S.Gamma τ.1)) *
            S.dualNorm delta ^ (2 : ℕ) := by
          field_simp [ne_of_gt hGamma_pos, ne_of_gt hgamma_pos]

private theorem samp_weighted_bregman_telescope_diameter_bound
    (S : Setup Ξ Ζ E) (z : ℕ → S.Point) (u : S.Point)
    (t : {n : ℕ // 1 ≤ n}) :
    (Finset.range t.1).sum
        (fun i =>
          (S.alpha (paperTime i).1 /
              (S.Gamma (paperTime i).1 * S.gamma (paperTime i).1)) *
            (S.V (z i) u - S.V (z (i + 1)) u)) ≤
      (S.alpha t.1 / (S.Gamma t.1 * S.gamma t.1)) *
        S.DZ ^ (2 : ℕ) := by
  classical
  let coeff : ℕ → ℝ := fun n => S.alpha n / (S.Gamma n * S.gamma n)
  let potential : ℕ → ℝ := fun n => S.V (z n) u
  have hcoeff_mono :
      ∀ n, 1 ≤ n → n < t.1 → coeff n ≤ coeff (n + 1) := by
    intro n hn _hnt
    rcases S.gamma_ratio_mono_with_Gamma ⟨n, hn⟩ with
      ⟨rho_n, rho_next, hquot_n, hquot_next, hle⟩
    have hn_eq : rho_n = coeff n := by
      simpa [coeff] using SOptLib.eq_div_of_checked_quotient_spec hquot_n
    have hnext_eq : rho_next = coeff (n + 1) := by
      simpa [coeff] using SOptLib.eq_div_of_checked_quotient_spec hquot_next
    simpa [hn_eq, hnext_eq] using hle
  have hcoeff_nonneg :
      ∀ n, 1 ≤ n → n ≤ t.1 → 0 ≤ coeff n := by
    intro n hn _hnt
    have halpha : 0 ≤ S.alpha n := (Set.mem_Icc.mp (S.alpha_range ⟨n, hn⟩)).1
    have hGamma_nonneg : 0 ≤ S.Gamma n := le_of_lt (S.Gamma_pos ⟨n, hn⟩)
    have hgamma_nonneg : 0 ≤ S.gamma n := le_of_lt (S.gamma_pos ⟨n, hn⟩)
    exact div_nonneg halpha (mul_nonneg hGamma_nonneg hgamma_nonneg)
  have hpotential_tail_nonneg : 0 ≤ potential t.1 := by
    have hlower := S.half_primalNorm_sq_le_V (z t.1) u
    have hsq_nonneg :
        0 ≤ (1 / 2 : ℝ) * S.primalNorm ((z t.1).1 - u.1) ^ (2 : ℕ) := by
      have hhalf : 0 ≤ (1 / 2 : ℝ) := by norm_num
      exact mul_nonneg hhalf (sq_nonneg _)
    exact le_trans hsq_nonneg hlower
  have hpotential_le :
      ∀ n, n ≤ t.1 → potential n ≤ S.DZ ^ (2 : ℕ) := by
    intro n _hn
    exact S.V_le_diameter (z n) u
  have htelescope :
      Finset.sum (Finset.Icc 1 t.1)
          (fun n => coeff n * (potential (n - 1) - potential n)) ≤
        coeff t.1 * S.DZ ^ (2 : ℕ) :=
    sum_Icc_mono_coeff_mul_sub_le_terminal
      coeff potential (S.DZ ^ (2 : ℕ)) t.1 t.2
      hcoeff_mono hcoeff_nonneg hpotential_tail_nonneg hpotential_le
  have hreindex :
      (Finset.range t.1).sum
          (fun i =>
            coeff (paperTime i).1 *
              (potential i - potential (i + 1))) =
        Finset.sum (Finset.Icc 1 t.1)
          (fun n => coeff n * (potential (n - 1) - potential n)) := by
    calc
      (Finset.range t.1).sum
          (fun i =>
            coeff (paperTime i).1 *
              (potential i - potential (i + 1))) =
          (Finset.range t.1).sum
            (fun i =>
              (fun n => coeff n * (potential (n - 1) - potential n)) (i + 1)) := by
            refine Finset.sum_congr rfl ?_
            intro i _hi
            simp [paperTime]
      _ =
          Finset.sum (Finset.Icc 1 t.1)
            (fun n => coeff n * (potential (n - 1) - potential n)) := by
            exact (sum_Icc_one_eq_sum_range_succ (k := t.1)
              (F := fun n => coeff n * (potential (n - 1) - potential n))).symm
  simpa [coeff, potential, hreindex] using htelescope

private theorem samp_expectedGapIntegrand_le_of_pointwise_Q_bound
    [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω)
    (t : {n : ℕ // 1 ≤ n}) (ω : Ω) (B : ℝ)
    (hgap_lub : IsLUB
      ((fun u : E => S.Q (S.barSeq (sample ω) t.1).1 u) '' S.Z)
      (S.gap (S.barSeq (sample ω) t.1).1))
    (hQ : ∀ u : S.Point, S.Q (S.barSeq (sample ω) t.1).1 u.1 ≤ B) :
    S.expectedGapIntegrand sample μ t.1 ω ≤ B := by
  unfold Setup.expectedGapIntegrand
  rw [isLUB_le_iff hgap_lub]
  intro r hr
  rcases hr with ⟨u, hu, rfl⟩
  exact hQ ⟨u, hu⟩

private theorem samp_cumulative_recursion_from_one_step
    (S : Setup Ξ Ζ E) (A B D : ℕ → ℝ)
    (t : {n : ℕ // 1 ≤ n})
    (hstep : ∀ n : ℕ, 1 ≤ n →
      A n ≤ (1 - S.alpha n) * A (n - 1) +
        S.alpha n / S.gamma n * B n + D n) :
    A t.1 ≤
      S.Gamma t.1 *
        (Finset.range t.1).sum
          (fun i =>
            S.alpha (paperTime i).1 /
                (S.gamma (paperTime i).1 * S.Gamma (paperTime i).1) *
              B (paperTime i).1) +
      S.Gamma t.1 *
        (Finset.range t.1).sum
          (fun i => D (paperTime i).1 / S.Gamma (paperTime i).1) := by
  classical
  have hgamma_ne : ∀ n, 1 ≤ n → S.gamma n ≠ 0 := by
    intro n hn
    exact ne_of_gt (S.gamma_pos ⟨n, hn⟩)
  have hGamma_ne : ∀ n, 1 ≤ n → S.Gamma n ≠ 0 := by
    intro n hn
    exact ne_of_gt (S.Gamma_pos ⟨n, hn⟩)
  have halpha_le_one : ∀ n, 1 ≤ n → S.alpha n ≤ 1 := by
    intro n hn
    exact (Set.mem_Icc.mp (S.alpha_range ⟨n, hn⟩)).2
  have hGamma_succ :
      ∀ n, 1 ≤ n →
        S.Gamma (n + 1) = (1 - S.alpha (n + 1)) * S.Gamma n := by
    intro n hn
    exact S.Gamma_succ (t := n + 1) (Nat.lt_add_one_of_le hn)
  have hstep' : ∀ n : ℕ, 1 ≤ n →
      A n ≤ (1 - S.alpha n) * A (n - 1) + S.alpha n * 0 +
        S.alpha n / S.gamma n * B n + D n := by
    intro n hn
    have h := hstep n hn
    linarith
  have hraw :=
    finite_window_weighted_recurrence_telescope_with_tail_sums
      (alpha := S.alpha) (gamma := S.gamma) (Gamma := S.Gamma)
      (A := A) (L := fun _ => 0) (B := B) (D := D)
      (k := t.1) (hk := t.2) hgamma_ne hGamma_ne S.Gamma_one
      S.alpha_one halpha_le_one hGamma_succ hstep'
  have hB_reindex :
      Finset.sum (Finset.Icc 1 t.1)
          (fun n => S.alpha n / (S.gamma n * S.Gamma n) * B n) =
        (Finset.range t.1).sum
          (fun i =>
            S.alpha (paperTime i).1 /
                (S.gamma (paperTime i).1 * S.Gamma (paperTime i).1) *
              B (paperTime i).1) := by
    simpa [paperTime] using
      (sum_Icc_one_eq_sum_range_succ (k := t.1)
        (F := fun n => S.alpha n / (S.gamma n * S.Gamma n) * B n))
  have hD_reindex :
      Finset.sum (Finset.Icc 1 t.1) (fun n => D n / S.Gamma n) =
        (Finset.range t.1).sum
          (fun i => D (paperTime i).1 / S.Gamma (paperTime i).1) := by
    simpa [paperTime] using
      (sum_Icc_one_eq_sum_range_succ (k := t.1)
        (F := fun n => D n / S.Gamma n))
  have hraw_simplified :
      A t.1 ≤
        S.Gamma t.1 *
          Finset.sum (Finset.Icc 1 t.1)
            (fun n => S.alpha n / (S.gamma n * S.Gamma n) * B n) +
        S.Gamma t.1 *
          Finset.sum (Finset.Icc 1 t.1) (fun n => D n / S.Gamma n) := by
    simpa [S.alpha_one] using hraw
  simpa [hB_reindex, hD_reindex] using hraw_simplified

private theorem samp_one_step_stochastic_Q_recursion_of_deterministic
    (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (u : S.Point) (n : ℕ)
    (hDet :
      S.Q (S.barSeq path (n + 1)).1 u.1 ≤
        (1 - S.alpha (paperTime n).1) * S.Q (S.barSeq path n).1 u.1 +
          S.alpha (paperTime n).1 *
            (⟪S.gradG (S.wSeq path n).1 +
                  S.Hmean (S.firstProx path n (S.stateProcess path n)).1,
                (S.firstProx path n (S.stateProcess path n)).1 - u.1⟫_ℝ +
              S.J (S.firstProx path n (S.stateProcess path n)).1 - S.J u.1) +
          (S.L * S.alpha (paperTime n).1 ^ (2 : ℕ) / 2) *
            S.primalNorm
              ((S.firstProx path n (S.stateProcess path n)).1 -
                (S.rSeq path n).1) ^ (2 : ℕ))
    (hTwoProx :
      S.gamma (paperTime n).1 *
          (⟪S.secondOracle path n (S.stateProcess path n)
                (S.firstProx path n (S.stateProcess path n)),
              (S.firstProx path n (S.stateProcess path n)).1 - u.1⟫_ℝ +
            S.J (S.firstProx path n (S.stateProcess path n)).1 - S.J u.1) ≤
        S.V (S.rSeq path n) u -
            S.V (S.rSeq path (n + 1)) u -
            ((1 / 2 : ℝ) -
                3 * S.M ^ (2 : ℕ) *
                  S.gamma (paperTime n).1 ^ (2 : ℕ) / 2) *
              S.primalNorm
                ((S.rSeq path n).1 -
                  (S.firstProx path n (S.stateProcess path n)).1) ^ (2 : ℕ) +
          (3 * S.gamma (paperTime n).1 ^ (2 : ℕ) / 2) *
            (S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
              S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ)))
    (hSecondOracleSplit :
      S.secondOracle path n (S.stateProcess path n)
          (S.firstProx path n (S.stateProcess path n)) =
        S.Hmean (S.firstProx path n (S.stateProcess path n)).1 +
          S.gradG (S.wSeq path n).1 +
          (S.deltaHEven path n + S.deltaG path n)) :
    S.Q (S.barSeq path (n + 1)).1 u.1 ≤
      (1 - S.alpha (paperTime n).1) * S.Q (S.barSeq path n).1 u.1 +
        S.alpha (paperTime n).1 / S.gamma (paperTime n).1 *
          (S.V (S.rSeq path n) u - S.V (S.rSeq path (n + 1)) u) -
        S.alpha (paperTime n).1 /
            (2 * S.gamma (paperTime n).1) *
          (1 - S.L * S.alpha (paperTime n).1 * S.gamma (paperTime n).1 -
            3 * S.M ^ (2 : ℕ) * S.gamma (paperTime n).1 ^ (2 : ℕ)) *
          S.primalNorm
            ((S.rSeq path n).1 -
              (S.firstProx path n (S.stateProcess path n)).1) ^ (2 : ℕ) +
        (3 * S.alpha (paperTime n).1 * S.gamma (paperTime n).1 / 2) *
          (S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
            S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ)) -
        S.alpha (paperTime n).1 *
          ⟪S.deltaHEven path n + S.deltaG path n,
            (S.firstProx path n (S.stateProcess path n)).1 - u.1⟫_ℝ := by
  let a := S.alpha (paperTime n).1
  let γ := S.gamma (paperTime n).1
  let qn :=
    S.Q (S.barSeq path n).1 u.1
  let qnext :=
    S.Q (S.barSeq path (n + 1)).1 u.1
  let w := S.firstProx path n (S.stateProcess path n)
  let r := S.rSeq path n
  let Vdrop := S.V r u - S.V (S.rSeq path (n + 1)) u
  let noiseSq :=
    S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
      S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ)
  let d := S.primalNorm (r.1 - w.1) ^ (2 : ℕ)
  let residual := S.deltaHEven path n + S.deltaG path n
  have hγpos : 0 < γ := by
    simpa [γ] using S.gamma_pos (paperTime n)
  have hγne : γ ≠ 0 := ne_of_gt hγpos
  have ha_nonneg : 0 ≤ a := by
    simpa [a] using (Set.mem_Icc.mp (S.alpha_range (paperTime n))).1
  have hnorm_rev :
      S.primalNorm (w.1 - r.1) ^ (2 : ℕ) = d := by
    have hnorm :
        S.primalNorm (w.1 - r.1) = S.primalNorm (r.1 - w.1) := by
      change S.primalSeminorm (w.1 - r.1) = S.primalSeminorm (r.1 - w.1)
      calc
        S.primalSeminorm (w.1 - r.1) =
            S.primalSeminorm (-(r.1 - w.1)) := by
          congr 1
          abel
        _ = S.primalSeminorm (r.1 - w.1) := by
          rw [map_neg_eq_map]
    simp [d, hnorm]
  have horacle_inner :
      ⟪S.gradG (S.wSeq path n).1 + S.Hmean w.1, w.1 - u.1⟫_ℝ +
          S.J w.1 - S.J u.1 =
        (⟪S.secondOracle path n (S.stateProcess path n) w,
            w.1 - u.1⟫_ℝ + S.J w.1 - S.J u.1) -
          ⟪residual, w.1 - u.1⟫_ℝ := by
    rw [hSecondOracleSplit]
    simp only [w, residual, inner_add_left]
    ring
  have hprox_div :
      ⟪S.secondOracle path n (S.stateProcess path n) w, w.1 - u.1⟫_ℝ +
          S.J w.1 - S.J u.1 ≤
        Vdrop / γ -
          (((1 / 2 : ℝ) - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ) / 2) * d) / γ +
          ((3 * γ ^ (2 : ℕ) / 2) * noiseSq) / γ := by
    have hmul :
        γ *
            (⟪S.secondOracle path n (S.stateProcess path n) w, w.1 - u.1⟫_ℝ +
              S.J w.1 - S.J u.1) ≤
          Vdrop -
              ((1 / 2 : ℝ) - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ) / 2) * d +
            (3 * γ ^ (2 : ℕ) / 2) * noiseSq := by
      simpa [w, r, Vdrop, noiseSq, d, γ] using hTwoProx
    calc
      ⟪S.secondOracle path n (S.stateProcess path n) w, w.1 - u.1⟫_ℝ +
          S.J w.1 - S.J u.1 =
        (γ *
            (⟪S.secondOracle path n (S.stateProcess path n) w, w.1 - u.1⟫_ℝ +
              S.J w.1 - S.J u.1)) / γ := by
          field_simp [hγne]
      _ ≤
        (Vdrop -
              ((1 / 2 : ℝ) - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ) / 2) * d +
            (3 * γ ^ (2 : ℕ) / 2) * noiseSq) / γ :=
          div_le_div_of_nonneg_right hmul (le_of_lt hγpos)
      _ =
        Vdrop / γ -
          (((1 / 2 : ℝ) - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ) / 2) * d) / γ +
          ((3 * γ ^ (2 : ℕ) / 2) * noiseSq) / γ := by
          ring
  have hdet' :
      qnext ≤
        (1 - a) * qn +
          a *
            ((⟪S.secondOracle path n (S.stateProcess path n) w,
                w.1 - u.1⟫_ℝ + S.J w.1 - S.J u.1) -
              ⟪residual, w.1 - u.1⟫_ℝ) +
          (S.L * a ^ (2 : ℕ) / 2) * d := by
    simpa [qnext, qn, a, γ, w, r, residual, hnorm_rev, horacle_inner] using hDet
  have hprox_scaled :
      a *
          ((⟪S.secondOracle path n (S.stateProcess path n) w,
              w.1 - u.1⟫_ℝ + S.J w.1 - S.J u.1) -
            ⟪residual, w.1 - u.1⟫_ℝ) ≤
        a *
          (Vdrop / γ -
            (((1 / 2 : ℝ) - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ) / 2) * d) / γ +
            ((3 * γ ^ (2 : ℕ) / 2) * noiseSq) / γ -
            ⟪residual, w.1 - u.1⟫_ℝ) := by
    exact mul_le_mul_of_nonneg_left (sub_le_sub_right hprox_div _) ha_nonneg
  have hcombined :
      qnext ≤
        (1 - a) * qn +
          a *
            (Vdrop / γ -
              (((1 / 2 : ℝ) - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ) / 2) * d) / γ +
              ((3 * γ ^ (2 : ℕ) / 2) * noiseSq) / γ -
              ⟪residual, w.1 - u.1⟫_ℝ) +
          (S.L * a ^ (2 : ℕ) / 2) * d := by
    nlinarith
  have halg :
      (1 - a) * qn +
          a *
            (Vdrop / γ -
              (((1 / 2 : ℝ) - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ) / 2) * d) / γ +
              ((3 * γ ^ (2 : ℕ) / 2) * noiseSq) / γ -
              ⟪residual, w.1 - u.1⟫_ℝ) +
          (S.L * a ^ (2 : ℕ) / 2) * d =
        (1 - a) * qn + a / γ * Vdrop -
          a / (2 * γ) *
            (1 - S.L * a * γ - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ)) * d +
          (3 * a * γ / 2) * noiseSq -
          a * ⟪residual, w.1 - u.1⟫_ℝ := by
    field_simp [hγne]
    ring
  calc
    qnext ≤
        (1 - a) * qn +
          a *
            (Vdrop / γ -
              (((1 / 2 : ℝ) - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ) / 2) * d) / γ +
              ((3 * γ ^ (2 : ℕ) / 2) * noiseSq) / γ -
              ⟪residual, w.1 - u.1⟫_ℝ) +
          (S.L * a ^ (2 : ℕ) / 2) * d := hcombined
    _ =
        (1 - a) * qn + a / γ * Vdrop -
          a / (2 * γ) *
            (1 - S.L * a * γ - 3 * S.M ^ (2 : ℕ) * γ ^ (2 : ℕ)) * d +
          (3 * a * γ / 2) * noiseSq -
          a * ⟪residual, w.1 - u.1⟫_ℝ := halg
    _ =
      (1 - S.alpha (paperTime n).1) * S.Q (S.barSeq path n).1 u.1 +
        S.alpha (paperTime n).1 / S.gamma (paperTime n).1 *
          (S.V (S.rSeq path n) u - S.V (S.rSeq path (n + 1)) u) -
        S.alpha (paperTime n).1 /
            (2 * S.gamma (paperTime n).1) *
          (1 - S.L * S.alpha (paperTime n).1 * S.gamma (paperTime n).1 -
            3 * S.M ^ (2 : ℕ) * S.gamma (paperTime n).1 ^ (2 : ℕ)) *
          S.primalNorm
            ((S.rSeq path n).1 -
              (S.firstProx path n (S.stateProcess path n)).1) ^ (2 : ℕ) +
        (3 * S.alpha (paperTime n).1 * S.gamma (paperTime n).1 / 2) *
          (S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
            S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ)) -
        S.alpha (paperTime n).1 *
          ⟪S.deltaHEven path n + S.deltaG path n,
            (S.firstProx path n (S.stateProcess path n)).1 - u.1⟫_ℝ := by
      simp [a, γ, qn, qnext, w, r, Vdrop, noiseSq, d, residual]

private theorem samp_HJ_aggregate_recursion
    (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (u : S.Point) (n : ℕ) :
    ⟪S.Hmean u.1, (S.barSeq path (n + 1)).1 - u.1⟫_ℝ +
        S.J (S.barSeq path (n + 1)).1 -
        (1 - S.alpha (paperTime n).1) *
          (⟪S.Hmean u.1, (S.barSeq path n).1 - u.1⟫_ℝ +
            S.J (S.barSeq path n).1) ≤
      S.alpha (paperTime n).1 *
        (⟪S.Hmean (S.firstProx path n (S.stateProcess path n)).1,
            (S.firstProx path n (S.stateProcess path n)).1 - u.1⟫_ℝ +
          S.J (S.firstProx path n (S.stateProcess path n)).1) := by
  let a := S.alpha (paperTime n).1
  let bar := S.barSeq path n
  let w := S.firstProx path n (S.stateProcess path n)
  have ha : a ∈ Set.Icc (0 : ℝ) 1 := by
    simpa [a] using S.alpha_range (paperTime n)
  have ha0 : 0 ≤ a := (Set.mem_Icc.mp ha).1
  have ha1 : a ≤ 1 := (Set.mem_Icc.mp ha).2
  have h1ma : 0 ≤ 1 - a := sub_nonneg.mpr ha1
  have hsum : (1 - a) + a = 1 := by ring
  have hbarNext :
      (S.barSeq path (n + 1)).1 = (1 - a) • bar.1 + a • w.1 := by
    simp [barSeq, stateProcess_succ, transition, aggregatePoint,
      SOptLib.acceleratedAveragePoint, a, bar, w]
  have hH_affine :
      ⟪S.Hmean u.1, (S.barSeq path (n + 1)).1 - u.1⟫_ℝ =
        (1 - a) * ⟪S.Hmean u.1, bar.1 - u.1⟫_ℝ +
          a * ⟪S.Hmean u.1, w.1 - u.1⟫_ℝ := by
    rw [hbarNext]
    have hvec :
        (1 - a) • bar.1 + a • w.1 - u.1 =
          (1 - a) • (bar.1 - u.1) + a • (w.1 - u.1) := by
      calc
        (1 - a) • bar.1 + a • w.1 - u.1 =
            (1 - a) • bar.1 + a • w.1 - ((1 - a + a) • u.1) := by
              rw [show 1 - a + a = 1 by ring, one_smul]
        _ = (1 - a) • (bar.1 - u.1) + a • (w.1 - u.1) := by
              module
    rw [hvec, inner_add_right, inner_smul_right, inner_smul_right]
  have hJ_conv_raw :=
    S.J_convexOn.2 bar.2 w.2 h1ma ha0 hsum
  have hJ_conv :
      S.J (S.barSeq path (n + 1)).1 ≤
        (1 - a) * S.J bar.1 + a * S.J w.1 := by
    simpa [hbarNext, smul_eq_mul] using hJ_conv_raw
  have hH_mono :
      ⟪S.Hmean u.1, w.1 - u.1⟫_ℝ ≤
        ⟪S.Hmean w.1, w.1 - u.1⟫_ℝ := by
    have h0 := S.H_monotone w.2 u.2
    have h0' :
        0 ≤
          ⟪S.Hmean w.1, w.1 - u.1⟫_ℝ -
            ⟪S.Hmean u.1, w.1 - u.1⟫_ℝ := by
      simpa [sub_eq_add_neg, inner_add_left, inner_add_right,
        add_comm, add_left_comm, add_assoc] using h0
    linarith
  have hH_scaled :
      a * ⟪S.Hmean u.1, w.1 - u.1⟫_ℝ ≤
        a * ⟪S.Hmean w.1, w.1 - u.1⟫_ℝ :=
    mul_le_mul_of_nonneg_left hH_mono ha0
  nlinarith

private theorem samp_G_aggregate_recursion
    (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (u : S.Point) (n : ℕ) :
    S.Gvalue (S.barSeq path (n + 1)).1 ≤
      (1 - S.alpha (paperTime n).1) * S.Gvalue (S.barSeq path n).1 +
        S.alpha (paperTime n).1 * S.Gvalue u.1 +
        S.alpha (paperTime n).1 *
          ⟪S.gradG (S.wSeq path n).1,
            (S.firstProx path n (S.stateProcess path n)).1 - u.1⟫_ℝ +
        (S.L * S.alpha (paperTime n).1 ^ (2 : ℕ) / 2) *
          S.primalNorm
            ((S.firstProx path n (S.stateProcess path n)).1 -
              (S.rSeq path n).1) ^ (2 : ℕ) := by
  let a := S.alpha (paperTime n).1
  let bar := S.barSeq path n
  let r := S.rSeq path n
  let w := S.firstProx path n (S.stateProcess path n)
  let search := S.wSeq path n
  let g := S.gradG search.1
  have ha : a ∈ Set.Icc (0 : ℝ) 1 := by
    simpa [a] using S.alpha_range (paperTime n)
  have ha0 : 0 ≤ a := (Set.mem_Icc.mp ha).1
  have ha1 : a ≤ 1 := (Set.mem_Icc.mp ha).2
  have h1ma : 0 ≤ 1 - a := sub_nonneg.mpr ha1
  have hbarNext :
      (S.barSeq path (n + 1)).1 = (1 - a) • bar.1 + a • w.1 := by
    simp [barSeq, stateProcess_succ, transition, aggregatePoint,
      SOptLib.acceleratedAveragePoint, a, bar, w]
  have hsearch :
      search.1 = (1 - a) • bar.1 + a • r.1 := by
    simp [search, wSeq, searchPointPoint, searchPoint, barSeq, rSeq,
      SOptLib.acceleratedSearchPoint, a, bar, r]
  have hdiff_step :
      (S.barSeq path (n + 1)).1 - search.1 = a • (w.1 - r.1) := by
    rw [hbarNext, hsearch]
    module
  have hnorm_step :
      S.primalNorm ((S.barSeq path (n + 1)).1 - search.1) =
        a * S.primalNorm (w.1 - r.1) := by
    rw [hdiff_step]
    change S.primalSeminorm (a • (w.1 - r.1)) =
      a * S.primalSeminorm (w.1 - r.1)
    rw [map_smul_eq_mul]
    rw [Real.norm_eq_abs, abs_of_nonneg ha0]
  have hSmooth_base :=
    (S.G_convex_smooth
      (w := (S.barSeq path (n + 1)).1) (v := search.1)
      (S.barSeq path (n + 1)).2 search.2).2
  have hSmooth :
      S.Gvalue (S.barSeq path (n + 1)).1 ≤
        S.Gvalue search.1 +
          ⟪g, (S.barSeq path (n + 1)).1 - search.1⟫_ℝ +
          (S.L * a ^ (2 : ℕ) / 2) *
            S.primalNorm (w.1 - r.1) ^ (2 : ℕ) := by
    have hquad :
        (S.L / 2) *
            S.primalNorm ((S.barSeq path (n + 1)).1 - search.1) ^ (2 : ℕ) =
          (S.L * a ^ (2 : ℕ) / 2) *
            S.primalNorm (w.1 - r.1) ^ (2 : ℕ) := by
      rw [hnorm_step]
      ring
    calc
      S.Gvalue (S.barSeq path (n + 1)).1 ≤
          S.L / 2 *
              S.primalNorm ((S.barSeq path (n + 1)).1 - search.1) ^ (2 : ℕ) +
            ⟪g, (S.barSeq path (n + 1)).1 - search.1⟫_ℝ +
            S.Gvalue search.1 := by
        simpa [g, primalNorm] using hSmooth_base
      _ =
        S.Gvalue search.1 +
          ⟪g, (S.barSeq path (n + 1)).1 - search.1⟫_ℝ +
          (S.L * a ^ (2 : ℕ) / 2) *
            S.primalNorm (w.1 - r.1) ^ (2 : ℕ) := by
        rw [hquad]
        ring
  have hsupport_bar :
      S.Gvalue search.1 + ⟪g, bar.1 - search.1⟫_ℝ ≤
        S.Gvalue bar.1 := by
    have h0 :=
      (S.G_convex_smooth (w := bar.1) (v := search.1) bar.2 search.2).1
    have h := sub_nonneg.mp h0
    nlinarith
  have hsupport_u :
      S.Gvalue search.1 + ⟪g, u.1 - search.1⟫_ℝ ≤
        S.Gvalue u.1 := by
    have h0 :=
      (S.G_convex_smooth (w := u.1) (v := search.1) u.2 search.2).1
    have h := sub_nonneg.mp h0
    nlinarith
  have hinner_decomp :
      S.Gvalue search.1 +
          ⟪g, (S.barSeq path (n + 1)).1 - search.1⟫_ℝ =
        (1 - a) * (S.Gvalue search.1 + ⟪g, bar.1 - search.1⟫_ℝ) +
          a * (S.Gvalue search.1 + ⟪g, u.1 - search.1⟫_ℝ) +
          a * ⟪g, w.1 - u.1⟫_ℝ := by
    have hvec :
        (S.barSeq path (n + 1)).1 - search.1 =
          (1 - a) • (bar.1 - search.1) +
            a • (u.1 - search.1) + a • (w.1 - u.1) := by
      rw [hbarNext, hsearch]
      module
    rw [hvec]
    simp [inner_add_right, inner_smul_right]
    ring
  have hmodel :
      S.Gvalue search.1 +
          ⟪g, (S.barSeq path (n + 1)).1 - search.1⟫_ℝ ≤
        (1 - a) * S.Gvalue bar.1 + a * S.Gvalue u.1 +
          a * ⟪g, w.1 - u.1⟫_ℝ := by
    rw [hinner_decomp]
    have hbar_scaled :=
      mul_le_mul_of_nonneg_left hsupport_bar h1ma
    have hu_scaled :=
      mul_le_mul_of_nonneg_left hsupport_u ha0
    nlinarith
  calc
    S.Gvalue (S.barSeq path (n + 1)).1 ≤
        S.Gvalue search.1 +
          ⟪g, (S.barSeq path (n + 1)).1 - search.1⟫_ℝ +
          (S.L * a ^ (2 : ℕ) / 2) *
            S.primalNorm (w.1 - r.1) ^ (2 : ℕ) := hSmooth
    _ ≤
        (1 - a) * S.Gvalue bar.1 + a * S.Gvalue u.1 +
          a * ⟪g, w.1 - u.1⟫_ℝ +
          (S.L * a ^ (2 : ℕ) / 2) *
            S.primalNorm (w.1 - r.1) ^ (2 : ℕ) := by
      nlinarith
    _ =
      (1 - S.alpha (paperTime n).1) * S.Gvalue (S.barSeq path n).1 +
        S.alpha (paperTime n).1 * S.Gvalue u.1 +
        S.alpha (paperTime n).1 *
          ⟪S.gradG (S.wSeq path n).1,
            (S.firstProx path n (S.stateProcess path n)).1 - u.1⟫_ℝ +
        (S.L * S.alpha (paperTime n).1 ^ (2 : ℕ) / 2) *
          S.primalNorm
            ((S.firstProx path n (S.stateProcess path n)).1 -
              (S.rSeq path n).1) ^ (2 : ℕ) := by
      simp [a, bar, r, w, search, g]

private theorem samp_deterministic_Q_recursion_one_step
    (S : Setup Ξ Ζ E) (path : SamplePath Ξ Ζ) (u : S.Point) (n : ℕ) :
    S.Q (S.barSeq path (n + 1)).1 u.1 ≤
      (1 - S.alpha (paperTime n).1) * S.Q (S.barSeq path n).1 u.1 +
        S.alpha (paperTime n).1 *
          (⟪S.gradG (S.wSeq path n).1 +
                S.Hmean (S.firstProx path n (S.stateProcess path n)).1,
              (S.firstProx path n (S.stateProcess path n)).1 - u.1⟫_ℝ +
            S.J (S.firstProx path n (S.stateProcess path n)).1 - S.J u.1) +
        (S.L * S.alpha (paperTime n).1 ^ (2 : ℕ) / 2) *
          S.primalNorm
            ((S.firstProx path n (S.stateProcess path n)).1 -
              (S.rSeq path n).1) ^ (2 : ℕ) := by
  let a := S.alpha (paperTime n).1
  let bar := S.barSeq path n
  let barNext := S.barSeq path (n + 1)
  let w := S.firstProx path n (S.stateProcess path n)
  let smoothTail :=
    (S.L * a ^ (2 : ℕ) / 2) *
      S.primalNorm (w.1 - (S.rSeq path n).1) ^ (2 : ℕ)
  have hG :
      S.Gvalue barNext.1 ≤
        (1 - a) * S.Gvalue bar.1 + a * S.Gvalue u.1 +
          a * ⟪S.gradG (S.wSeq path n).1, w.1 - u.1⟫_ℝ +
          smoothTail := by
    simpa [a, bar, barNext, w, smoothTail] using
      samp_G_aggregate_recursion S path u n
  have hHJ :
      ⟪S.Hmean u.1, barNext.1 - u.1⟫_ℝ + S.J barNext.1 -
          (1 - a) *
            (⟪S.Hmean u.1, bar.1 - u.1⟫_ℝ + S.J bar.1) ≤
        a * (⟪S.Hmean w.1, w.1 - u.1⟫_ℝ + S.J w.1) := by
    simpa [a, bar, barNext, w] using
      samp_HJ_aggregate_recursion S path u n
  have hinner :
      ⟪S.gradG (S.wSeq path n).1 + S.Hmean w.1, w.1 - u.1⟫_ℝ =
        ⟪S.gradG (S.wSeq path n).1, w.1 - u.1⟫_ℝ +
          ⟪S.Hmean w.1, w.1 - u.1⟫_ℝ := by
    rw [inner_add_left]
  change
    S.Gvalue barNext.1 - S.Gvalue u.1 +
        ⟪S.Hmean u.1, barNext.1 - u.1⟫_ℝ +
        S.J barNext.1 - S.J u.1 ≤
      (1 - a) *
          (S.Gvalue bar.1 - S.Gvalue u.1 +
            ⟪S.Hmean u.1, bar.1 - u.1⟫_ℝ +
            S.J bar.1 - S.J u.1) +
        a *
          (⟪S.gradG (S.wSeq path n).1 + S.Hmean w.1, w.1 - u.1⟫_ℝ +
            S.J w.1 - S.J u.1) +
        smoothTail
  rw [hinner]
  nlinarith

set_option maxHeartbeats 1200000 in
private theorem samp_pathwise_gap_bound_by_Ut
    [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω)
    (t : {n : ℕ // 1 ≤ n}) :
    ∀ ω,
      S.expectedGapIntegrand sample μ t.1 ω ≤
        (2 * S.alpha t.1 / S.gamma t.1) * S.DZ ^ (2 : ℕ) +
          S.Gamma t.1 * theorem410_Ut S sample t ω := by
  intro ω
  have hgap_lub : IsLUB
      ((fun u : E => S.Q (S.barSeq (sample ω) t.1).1 u) '' S.Z)
      (S.gap (S.barSeq (sample ω) t.1).1) :=
    S.gap_isLUB (S.barSeq (sample ω) t.1)
  have hAuxStep : ∀ i : ℕ,
      S.IsAuxiliaryProxStep (S.auxiliarySeq (sample ω) i)
        (S.auxiliaryDelta (sample ω) i) (S.gamma (paperTime i).1)
        (S.auxiliarySeq (sample ω) (i + 1)) := by
    intro i
    exact S.auxiliarySeq_succ_spec (sample ω) i
  have hRTelescope :
      (Finset.range t.1).sum
          (fun i =>
            (S.alpha (paperTime i).1 /
                (S.Gamma (paperTime i).1 * S.gamma (paperTime i).1)) *
              (S.V (S.rSeq (sample ω) i) (S.weakSolution) -
                S.V (S.rSeq (sample ω) (i + 1)) (S.weakSolution))) ≤
        (S.alpha t.1 / (S.Gamma t.1 * S.gamma t.1)) *
          S.DZ ^ (2 : ℕ) :=
    samp_weighted_bregman_telescope_diameter_bound
      S (S.rSeq (sample ω)) S.weakSolution t
  have hAuxTelescope :
      ∀ u : S.Point,
        (Finset.range t.1).sum
            (fun i =>
              (S.alpha (paperTime i).1 /
                  (S.Gamma (paperTime i).1 * S.gamma (paperTime i).1)) *
                (S.V (S.auxiliarySeq (sample ω) i) u -
                  S.V (S.auxiliarySeq (sample ω) (i + 1)) u)) ≤
          (S.alpha t.1 / (S.Gamma t.1 * S.gamma t.1)) *
            S.DZ ^ (2 : ℕ) := by
    intro u
    exact samp_weighted_bregman_telescope_diameter_bound
      S (S.auxiliarySeq (sample ω)) u t
  have hAuxPerturbation :
      ∀ u : S.Point,
        (Finset.range t.1).sum
            (fun i =>
              (S.alpha (paperTime i).1 / S.Gamma (paperTime i).1) *
                ⟪-S.auxiliaryDelta (sample ω) i,
                  (S.auxiliarySeq (sample ω) i).1 - u.1⟫_ℝ) ≤
          (Finset.range t.1).sum
              (fun i =>
                (S.alpha (paperTime i).1 /
                    (S.Gamma (paperTime i).1 * S.gamma (paperTime i).1)) *
                  (S.V (S.auxiliarySeq (sample ω) i) u -
                    S.V (S.auxiliarySeq (sample ω) (i + 1)) u)) +
            (Finset.range t.1).sum
              (fun i =>
                (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
                    (2 * S.Gamma (paperTime i).1)) *
                  S.dualNorm (S.auxiliaryDelta (sample ω) i) ^ (2 : ℕ)) := by
    intro u
    calc
      (Finset.range t.1).sum
          (fun i =>
            (S.alpha (paperTime i).1 / S.Gamma (paperTime i).1) *
              ⟪-S.auxiliaryDelta (sample ω) i,
                (S.auxiliarySeq (sample ω) i).1 - u.1⟫_ℝ)
          ≤
        (Finset.range t.1).sum
          (fun i =>
            (S.alpha (paperTime i).1 /
                (S.Gamma (paperTime i).1 * S.gamma (paperTime i).1)) *
                (S.V (S.auxiliarySeq (sample ω) i) u -
                  S.V (S.auxiliarySeq (sample ω) (i + 1)) u) +
              (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
                  (2 * S.Gamma (paperTime i).1)) *
                S.dualNorm (S.auxiliaryDelta (sample ω) i) ^ (2 : ℕ)) := by
          refine Finset.sum_le_sum ?_
          intro i _hi
          exact
            samp_auxiliary_scaled_one_step_bound
              S (S.auxiliarySeq (sample ω) i)
              (S.auxiliarySeq (sample ω) (i + 1)) u
              (S.auxiliaryDelta (sample ω) i) (paperTime i) (hAuxStep i)
      _ =
        (Finset.range t.1).sum
            (fun i =>
              (S.alpha (paperTime i).1 /
                  (S.Gamma (paperTime i).1 * S.gamma (paperTime i).1)) *
                (S.V (S.auxiliarySeq (sample ω) i) u -
                  S.V (S.auxiliarySeq (sample ω) (i + 1)) u)) +
          (Finset.range t.1).sum
            (fun i =>
              (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
                  (2 * S.Gamma (paperTime i).1)) *
                S.dualNorm (S.auxiliaryDelta (sample ω) i) ^ (2 : ℕ)) := by
          rw [Finset.sum_add_distrib]
  -- The remaining deterministic obligation is the source telescope
  -- (4.5.41)-(4.5.46): Lemma 4.14, Lemma 4.15, the Bregman-diameter
  -- bound, parameter nonnegativity, and the final `gap_isLUB` step.
  have hPointwiseQ :
      ∀ u : S.Point,
        S.Q (S.barSeq (sample ω) t.1).1 u.1 ≤
          (2 * S.alpha t.1 / S.gamma t.1) * S.DZ ^ (2 : ℕ) +
            S.Gamma t.1 * theorem410_Ut S sample t ω := by
    intro u
    let path := sample ω
    have hFirstProxThreePoint :
        ∀ n : ℕ,
          S.gamma (paperTime n).1 *
              (⟪S.firstOracle path n (S.stateProcess path n),
                  (S.firstProx path n (S.stateProcess path n)).1 - u.1⟫_ℝ +
                S.J (S.firstProx path n (S.stateProcess path n)).1 - S.J u.1) +
              S.V (S.rSeq path n) (S.firstProx path n (S.stateProcess path n)) ≤
            S.V (S.rSeq path n) u -
              S.V (S.firstProx path n (S.stateProcess path n)) u := by
      intro n
      have hstep :
          S.IsProxStep (S.rSeq path n)
            (S.firstOracle path n (S.stateProcess path n))
            (S.gamma (paperTime n).1)
            (S.firstProx path n (S.stateProcess path n)) := by
        simpa [Setup.rSeq] using
          S.firstProx_spec path n (S.stateProcess path n)
      exact
        samp_composite_three_point_of_IsProxStep
          S (S.rSeq path n) (S.firstProx path n (S.stateProcess path n)) u
          (S.firstOracle path n (S.stateProcess path n))
          (S.gamma (paperTime n).1) (S.gamma_pos (paperTime n)) hstep
    have hSecondProxThreePoint :
        ∀ n : ℕ,
          S.gamma (paperTime n).1 *
              (⟪S.secondOracle path n (S.stateProcess path n)
                    (S.firstProx path n (S.stateProcess path n)),
                  (S.secondProx path n (S.stateProcess path n)).1 - u.1⟫_ℝ +
                S.J (S.secondProx path n (S.stateProcess path n)).1 - S.J u.1) +
              S.V (S.rSeq path n) (S.secondProx path n (S.stateProcess path n)) ≤
            S.V (S.rSeq path n) u -
              S.V (S.secondProx path n (S.stateProcess path n)) u := by
      intro n
      have hstep :
          S.IsProxStep (S.rSeq path n)
            (S.secondOracle path n (S.stateProcess path n)
              (S.firstProx path n (S.stateProcess path n)))
            (S.gamma (paperTime n).1)
            (S.secondProx path n (S.stateProcess path n)) := by
        simpa [Setup.rSeq] using
          S.secondProx_spec path n (S.stateProcess path n)
      exact
        samp_composite_three_point_of_IsProxStep
          S (S.rSeq path n) (S.secondProx path n (S.stateProcess path n)) u
          (S.secondOracle path n (S.stateProcess path n)
            (S.firstProx path n (S.stateProcess path n)))
          (S.gamma (paperTime n).1) (S.gamma_pos (paperTime n)) hstep
    have hHdiffSq :
        ∀ n : ℕ,
          S.dualNorm
              (S.secondOracle path n (S.stateProcess path n)
                  (S.firstProx path n (S.stateProcess path n)) -
                S.firstOracle path n (S.stateProcess path n)) ^ (2 : ℕ) ≤
            3 * S.M ^ (2 : ℕ) *
                S.primalNorm
                  ((S.firstProx path n (S.stateProcess path n)).1 -
                    (S.rSeq path n).1) ^ (2 : ℕ) +
              3 * (S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
                S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ)) := by
      intro n
      exact samp_H_oracle_difference_dualNorm_sq_bound S path n
    have hScaledHdiffSq :
        ∀ n : ℕ,
          S.dualNorm
              (S.gamma (paperTime n).1 •
                (S.secondOracle path n (S.stateProcess path n)
                    (S.firstProx path n (S.stateProcess path n)) -
                  S.firstOracle path n (S.stateProcess path n))) ^ (2 : ℕ) ≤
            S.gamma (paperTime n).1 ^ (2 : ℕ) *
              (3 * S.M ^ (2 : ℕ) *
                  S.primalNorm
                    ((S.firstProx path n (S.stateProcess path n)).1 -
                      (S.rSeq path n).1) ^ (2 : ℕ) +
                3 * (S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
                  S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ))) := by
      intro n
      exact samp_scaled_H_oracle_difference_dualNorm_sq_bound S path n
    have hTwoProxFirst :
        ∀ n : ℕ,
          S.gamma (paperTime n).1 *
              (⟪S.secondOracle path n (S.stateProcess path n)
                    (S.firstProx path n (S.stateProcess path n)),
                  (S.firstProx path n (S.stateProcess path n)).1 - u.1⟫_ℝ +
                S.J (S.firstProx path n (S.stateProcess path n)).1 - S.J u.1) ≤
            S.V (S.rSeq path n) u -
                S.V (S.secondProx path n (S.stateProcess path n)) u -
                ((1 / 2 : ℝ) -
                    3 * S.M ^ (2 : ℕ) *
                      S.gamma (paperTime n).1 ^ (2 : ℕ) / 2) *
                  S.primalNorm
                    ((S.rSeq path n).1 -
                      (S.firstProx path n (S.stateProcess path n)).1) ^ (2 : ℕ) +
              (3 * S.gamma (paperTime n).1 ^ (2 : ℕ) / 2) *
                (S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
                  S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ)) := by
      intro n
      let st := S.stateProcess path n
      let r := S.rSeq path n
      let w := S.firstProx path n st
      let y := S.secondProx path n st
      let eta := S.firstOracle path n st
      let theta := S.secondOracle path n st w
      let gamma := S.gamma (paperTime n).1
      let noiseSq :=
        S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
          S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ)
      have hFirstAtY :
          gamma * (⟪eta, w.1 - y.1⟫_ℝ + S.J w.1 - S.J y.1) +
              S.V r w ≤
            S.V r y - S.V w y := by
        have hstep :
            S.IsProxStep r eta gamma w := by
          simpa [r, eta, gamma, st, Setup.rSeq] using
            S.firstProx_spec path n (S.stateProcess path n)
        exact
          samp_composite_three_point_of_IsProxStep
            S r w y eta gamma (S.gamma_pos (paperTime n)) hstep
      have hSecondAtU :
          gamma * (⟪theta, y.1 - u.1⟫_ℝ + S.J y.1 - S.J u.1) +
              S.V r y ≤
            S.V r u - S.V y u := by
        simpa [st, r, y, theta, gamma] using hSecondProxThreePoint n
      have hScaledDiff :
          S.dualNorm (gamma • (theta - eta)) ^ (2 : ℕ) ≤
            gamma ^ (2 : ℕ) *
              (3 * S.M ^ (2 : ℕ) * S.primalNorm (w.1 - r.1) ^ (2 : ℕ) +
                3 * noiseSq) := by
        simpa [st, r, w, eta, theta, gamma, noiseSq] using hScaledHdiffSq n
      have hbridge :=
        samp_two_prox_first_inequality_from_three_point
          S r w y u eta theta gamma noiseSq
          hFirstAtY hSecondAtU hScaledDiff
      simpa [st, r, w, y, theta, gamma, noiseSq] using hbridge
    have hSecondOracleSplit :
        ∀ n : ℕ,
          S.secondOracle path n (S.stateProcess path n)
              (S.firstProx path n (S.stateProcess path n)) =
            S.Hmean (S.firstProx path n (S.stateProcess path n)).1 +
              S.gradG (S.wSeq path n).1 +
              (S.deltaHEven path n + S.deltaG path n) := by
      intro n
      exact samp_secondOracle_residual_decomposition S path n
    have hOneStepStochastic :
        ∀ n : ℕ,
          S.Q (S.barSeq path (n + 1)).1 u.1 ≤
            (1 - S.alpha (paperTime n).1) * S.Q (S.barSeq path n).1 u.1 +
              S.alpha (paperTime n).1 / S.gamma (paperTime n).1 *
                (S.V (S.rSeq path n) u - S.V (S.rSeq path (n + 1)) u) -
              S.alpha (paperTime n).1 /
                  (2 * S.gamma (paperTime n).1) *
                (1 - S.L * S.alpha (paperTime n).1 * S.gamma (paperTime n).1 -
                  3 * S.M ^ (2 : ℕ) *
                    S.gamma (paperTime n).1 ^ (2 : ℕ)) *
                S.primalNorm
                  ((S.rSeq path n).1 -
                    (S.firstProx path n (S.stateProcess path n)).1) ^
                    (2 : ℕ) +
              (3 * S.alpha (paperTime n).1 *
                    S.gamma (paperTime n).1 / 2) *
                (S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
                  S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ)) -
              S.alpha (paperTime n).1 *
                ⟪S.deltaHEven path n + S.deltaG path n,
                  (S.firstProx path n (S.stateProcess path n)).1 - u.1⟫_ℝ := by
      intro n
      have hDet := samp_deterministic_Q_recursion_one_step S path u n
      have hProx :
          S.gamma (paperTime n).1 *
              (⟪S.secondOracle path n (S.stateProcess path n)
                    (S.firstProx path n (S.stateProcess path n)),
                  (S.firstProx path n (S.stateProcess path n)).1 - u.1⟫_ℝ +
                S.J (S.firstProx path n (S.stateProcess path n)).1 - S.J u.1) ≤
            S.V (S.rSeq path n) u -
                S.V (S.rSeq path (n + 1)) u -
                ((1 / 2 : ℝ) -
                    3 * S.M ^ (2 : ℕ) *
                      S.gamma (paperTime n).1 ^ (2 : ℕ) / 2) *
                  S.primalNorm
                    ((S.rSeq path n).1 -
                      (S.firstProx path n (S.stateProcess path n)).1) ^
                    (2 : ℕ) +
              (3 * S.gamma (paperTime n).1 ^ (2 : ℕ) / 2) *
                (S.dualNorm (S.deltaHEven path n) ^ (2 : ℕ) +
                  S.dualNorm (S.deltaHOdd path n) ^ (2 : ℕ)) := by
        simpa [rSeq, stateProcess_succ, transition] using hTwoProxFirst n
      exact
        samp_one_step_stochastic_Q_recursion_of_deterministic
          S path u n hDet hProx (hSecondOracleSplit n)
    let A : ℕ → ℝ := fun n => S.Q (S.barSeq path n).1 u.1
    let B : ℕ → ℝ := fun n =>
      S.V (S.rSeq path (n - 1)) u - S.V (S.rSeq path n) u
    let D : ℕ → ℝ := fun n =>
      -S.alpha n / (2 * S.gamma n) *
          (1 - S.L * S.alpha n * S.gamma n -
            3 * S.M ^ (2 : ℕ) * S.gamma n ^ (2 : ℕ)) *
          S.primalNorm
            ((S.rSeq path (n - 1)).1 -
              (S.firstProx path (n - 1) (S.stateProcess path (n - 1))).1) ^
            (2 : ℕ) +
        (3 * S.alpha n * S.gamma n / 2) *
          (S.dualNorm (S.deltaHEven path (n - 1)) ^ (2 : ℕ) +
            S.dualNorm (S.deltaHOdd path (n - 1)) ^ (2 : ℕ)) -
        S.alpha n *
          ⟪S.deltaHEven path (n - 1) + S.deltaG path (n - 1),
            (S.firstProx path (n - 1) (S.stateProcess path (n - 1))).1 -
              u.1⟫_ℝ
    have hStepForCumulative :
        ∀ n : ℕ, 1 ≤ n →
          A n ≤ (1 - S.alpha n) * A (n - 1) +
            S.alpha n / S.gamma n * B n + D n := by
      intro n hn
      have hpaper : (paperTime (n - 1)).1 = n := by
        simp [paperTime, Nat.sub_add_cancel hn]
      have hstep := hOneStepStochastic (n - 1)
      dsimp [A, B, D]
      simp [hpaper, Nat.sub_add_cancel hn, sub_eq_add_neg,
        add_comm, add_left_comm, add_assoc] at hstep
      have hresidual_inner :
          ⟪S.deltaHEven path (n - 1) + S.deltaG path (n - 1),
              (S.firstProx path (n - 1) (S.stateProcess path (n - 1))).1 -
                u.1⟫_ℝ =
            ⟪S.deltaG path (n - 1) + S.deltaHEven path (n - 1),
              -u.1 +
                (S.firstProx path (n - 1) (S.stateProcess path (n - 1))).1⟫_ℝ := by
        simp [sub_eq_add_neg, add_comm, add_left_comm, add_assoc]
      rw [← hresidual_inner] at hstep
      have hnorm_sub :
          S.primalNorm
              ((S.rSeq path (n - 1)).1 +
                -(S.firstProx path (n - 1) (S.stateProcess path (n - 1))).1) ^
                (2 : ℕ) =
            S.primalNorm
              ((S.rSeq path (n - 1)).1 -
                (S.firstProx path (n - 1) (S.stateProcess path (n - 1))).1) ^
                (2 : ℕ) := by
        simp [sub_eq_add_neg]
      rw [hnorm_sub] at hstep
      ring_nf at hstep ⊢
      exact hstep
    have hCumulativeQ :
        S.Q (S.barSeq path t.1).1 u.1 ≤
          S.Gamma t.1 *
            (Finset.range t.1).sum
              (fun i =>
                S.alpha (paperTime i).1 /
                    (S.gamma (paperTime i).1 * S.Gamma (paperTime i).1) *
                  (S.V (S.rSeq path i) u -
                    S.V (S.rSeq path (i + 1)) u)) +
          S.Gamma t.1 *
            (Finset.range t.1).sum
              (fun i => D (paperTime i).1 / S.Gamma (paperTime i).1) := by
      simpa [A, B, paperTime] using
        samp_cumulative_recursion_from_one_step S A B D t hStepForCumulative
    have hRTelescopeCurrent :
        (Finset.range t.1).sum
            (fun i =>
              (S.alpha (paperTime i).1 /
                  (S.Gamma (paperTime i).1 * S.gamma (paperTime i).1)) *
                (S.V (S.rSeq path i) u -
                  S.V (S.rSeq path (i + 1)) u)) ≤
