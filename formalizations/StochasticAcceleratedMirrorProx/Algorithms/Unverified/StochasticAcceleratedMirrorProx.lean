      have h1_int : Integrable (fun ω => A * addSq ω) μ :=
        (hAddSq i hi).1.const_mul A
      have h2_int : Integrable (fun ω => B * gSq ω) μ :=
        (hG_moment i hi).1.const_mul B
      have h3_base_int : Integrable hSq μ :=
        (hHEven_moment i hi).1.add (hHOdd_moment i hi).1
      have h3_int : Integrable (fun ω => K * hSq ω) μ :=
        h3_base_int.const_mul K
      have h4_int : Integrable (fun ω => D * gPair ω) μ :=
        (hG_zero_int i hi).1.const_mul D
      have h5_int : Integrable (fun ω => D * hPair ω) μ :=
        (hHEven_zero_int i hi).1.const_mul D
      have hA_eq : A = (1 / 2 : ℝ) * W := by
        have hGamma_ne : S.Gamma (paperTime i).1 ≠ 0 :=
          ne_of_gt (S.Gamma_pos (paperTime i))
        field_simp [A, W, hGamma_ne]
        ring
      have hK_eq : K = (3 / 2 : ℝ) * W := by
        have hGamma_ne : S.Gamma (paperTime i).1 ≠ 0 :=
          ne_of_gt (S.Gamma_pos (paperTime i))
        field_simp [K, W, hGamma_ne]
        ring
      have hB_eq : B = W / (2 * (1 - S.q)) := by
        have hGamma_ne : S.Gamma (paperTime i).1 ≠ 0 :=
          ne_of_gt (S.Gamma_pos (paperTime i))
        have hq_ne : 2 * (1 - S.q) ≠ 0 := by
          have hpos : 0 < 2 * (1 - S.q) := by
            nlinarith [S.q_mem.2]
          exact ne_of_gt hpos
        dsimp [B, W]
        field_simp [hGamma_ne, hq_ne]
      have hW_nonneg : 0 ≤ W := by
        simpa [W] using S.weightedSquareWeight_nonneg i
      have hA_nonneg : 0 ≤ A := by
        rw [hA_eq]
        exact mul_nonneg (by norm_num) hW_nonneg
      have hB_nonneg : 0 ≤ B := by
        rw [hB_eq]
        have hqpos : 0 < 2 * (1 - S.q) := by
          nlinarith [S.q_mem.2]
        exact div_nonneg hW_nonneg (le_of_lt hqpos)
      have hK_nonneg : 0 ≤ K := by
        rw [hK_eq]
        exact mul_nonneg (by norm_num) hW_nonneg
      have hterm_eval :
          (∫ ω, (((A * addSq ω + B * gSq ω) + K * hSq ω) -
              D * gPair ω) - D * hPair ω ∂μ) =
            ((A * (∫ ω, addSq ω ∂μ) +
                B * (∫ ω, gSq ω ∂μ)) +
              K * (∫ ω, hSq ω ∂μ)) -
                D * (∫ ω, gPair ω ∂μ) -
              D * (∫ ω, hPair ω ∂μ) := by
        have houter :
            (∫ ω, (((A * addSq ω + B * gSq ω) + K * hSq ω) -
                D * gPair ω) - D * hPair ω ∂μ) =
              (∫ ω, ((A * addSq ω + B * gSq ω) + K * hSq ω) -
                D * gPair ω ∂μ) -
                ∫ ω, D * hPair ω ∂μ := by
          simpa [Pi.add_apply, Pi.sub_apply, sub_eq_add_neg, add_assoc] using
            (integral_sub (((h1_int.add h2_int).add h3_int).sub h4_int) h5_int)
        have hmid :
            (∫ ω, ((A * addSq ω + B * gSq ω) + K * hSq ω) -
                D * gPair ω ∂μ) =
              (∫ ω, (A * addSq ω + B * gSq ω) + K * hSq ω ∂μ) -
                ∫ ω, D * gPair ω ∂μ := by
          simpa [Pi.add_apply, Pi.sub_apply, sub_eq_add_neg, add_assoc] using
            (integral_sub ((h1_int.add h2_int).add h3_int) h4_int)
        have hadd3 :
            (∫ ω, (A * addSq ω + B * gSq ω) + K * hSq ω ∂μ) =
              (∫ ω, A * addSq ω + B * gSq ω ∂μ) +
                ∫ ω, K * hSq ω ∂μ := by
          simpa [Pi.add_apply, Pi.sub_apply, sub_eq_add_neg, add_assoc] using
            (integral_add (h1_int.add h2_int) h3_int)
        have hadd12 :
            (∫ ω, A * addSq ω + B * gSq ω ∂μ) =
              (∫ ω, A * addSq ω ∂μ) + ∫ ω, B * gSq ω ∂μ := by
          simpa [Pi.add_apply, Pi.sub_apply, sub_eq_add_neg, add_assoc] using
            (integral_add h1_int h2_int)
        calc
          (∫ ω, (((A * addSq ω + B * gSq ω) + K * hSq ω) -
              D * gPair ω) - D * hPair ω ∂μ)
              =
            (∫ ω, ((A * addSq ω + B * gSq ω) + K * hSq ω) -
              D * gPair ω ∂μ) -
              ∫ ω, D * hPair ω ∂μ := houter
          _ =
            ((∫ ω, (A * addSq ω + B * gSq ω) + K * hSq ω ∂μ) -
              ∫ ω, D * gPair ω ∂μ) -
              ∫ ω, D * hPair ω ∂μ := by rw [hmid]
          _ =
            (((∫ ω, A * addSq ω + B * gSq ω ∂μ) +
                ∫ ω, K * hSq ω ∂μ) -
              ∫ ω, D * gPair ω ∂μ) -
              ∫ ω, D * hPair ω ∂μ := by rw [hadd3]
          _ =
            ((((∫ ω, A * addSq ω ∂μ) + ∫ ω, B * gSq ω ∂μ) +
                ∫ ω, K * hSq ω ∂μ) -
              ∫ ω, D * gPair ω ∂μ) -
              ∫ ω, D * hPair ω ∂μ := by rw [hadd12]
          _ =
            ((A * (∫ ω, addSq ω ∂μ) +
                B * (∫ ω, gSq ω ∂μ)) +
              K * (∫ ω, hSq ω ∂μ)) -
                D * (∫ ω, gPair ω ∂μ) -
              D * (∫ ω, hPair ω ∂μ) := by
              simp [integral_const_mul]
      have hhsq_eval :
          (∫ ω, hSq ω ∂μ) =
            (∫ ω, S.dualNorm (S.deltaHEvenProcess sample i ω) ^ (2 : ℕ) ∂μ) +
              (∫ ω, S.dualNorm (S.deltaHOddProcess sample i ω) ^ (2 : ℕ) ∂μ) := by
        simp [hSq, integral_add (hHEven_moment i hi).1 (hHOdd_moment i hi).1]
      have hpart1 :
          A * (∫ ω, addSq ω ∂μ) ≤
            A * (2 * S.sigmaH ^ (2 : ℕ) + 2 * S.sigmaG ^ (2 : ℕ)) :=
        mul_le_mul_of_nonneg_left (by simpa [addSq] using (hAddSq i hi).2) hA_nonneg
      have hpart2 :
          B * (∫ ω, gSq ω ∂μ) ≤ B * S.sigmaG ^ (2 : ℕ) :=
        mul_le_mul_of_nonneg_left (by simpa [gSq] using (hG_moment i hi).2) hB_nonneg
      have hpart3 :
          K * (∫ ω, hSq ω ∂μ) ≤
            K * (S.sigmaH ^ (2 : ℕ) + S.sigmaH ^ (2 : ℕ)) := by
        refine mul_le_mul_of_nonneg_left ?_ hK_nonneg
        rw [hhsq_eval]
        exact add_le_add (hHEven_moment i hi).2 (hHOdd_moment i hi).2
      have hzeroG : (∫ ω, gPair ω ∂μ) = 0 := by
        simpa [gPair] using (hG_zero_int i hi).2
      have hzeroH : (∫ ω, hPair ω ∂μ) = 0 := by
        simpa [hPair] using (hHEven_zero_int i hi).2
      have hcoeff_eq :
          A * (2 * S.sigmaH ^ (2 : ℕ) + 2 * S.sigmaG ^ (2 : ℕ)) +
              B * S.sigmaG ^ (2 : ℕ) +
              K * (S.sigmaH ^ (2 : ℕ) + S.sigmaH ^ (2 : ℕ)) =
            W *
              (4 * S.sigmaH ^ (2 : ℕ) +
                (1 + curvatureNoise) * S.sigmaG ^ (2 : ℕ)) := by
        rw [hcurv_eq, hA_eq, hB_eq, hK_eq]
        ring
      change
        (∫ ω, (((A * addSq ω + B * gSq ω) + K * hSq ω) -
            D * gPair ω) - D * hPair ω ∂μ) ≤
          W *
            (4 * S.sigmaH ^ (2 : ℕ) +
              (1 + curvatureNoise) * S.sigmaG ^ (2 : ℕ))
      calc
        (∫ ω, (((A * addSq ω + B * gSq ω) + K * hSq ω) -
            D * gPair ω) - D * hPair ω ∂μ)
            =
          ((A * (∫ ω, addSq ω ∂μ) +
              B * (∫ ω, gSq ω ∂μ)) +
            K * (∫ ω, hSq ω ∂μ)) -
              D * (∫ ω, gPair ω ∂μ) -
            D * (∫ ω, hPair ω ∂μ) := hterm_eval
        _ ≤
          A * (2 * S.sigmaH ^ (2 : ℕ) + 2 * S.sigmaG ^ (2 : ℕ)) +
              B * S.sigmaG ^ (2 : ℕ) +
              K * (S.sigmaH ^ (2 : ℕ) + S.sigmaH ^ (2 : ℕ)) := by
            rw [hzeroG, hzeroH]
            nlinarith [hpart1, hpart2, hpart3]
        _ =
          W *
            (4 * S.sigmaH ^ (2 : ℕ) +
              (1 + curvatureNoise) * S.sigmaG ^ (2 : ℕ)) := hcoeff_eq
    calc
      (∫ ω,
          (Finset.range t.1).sum
            (fun i =>
              (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
                  (2 * S.Gamma (paperTime i).1)) *
                  S.dualNorm (S.deltaHEven (sample ω) i + S.deltaG (sample ω) i) ^
                    (2 : ℕ) +
                (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
                  (2 * (1 - S.q) * S.Gamma (paperTime i).1)) *
                  S.dualNorm (S.deltaG (sample ω) i) ^ (2 : ℕ) +
                (3 * S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
                  (2 * S.Gamma (paperTime i).1)) *
                  (S.dualNorm (S.deltaHEven (sample ω) i) ^ (2 : ℕ) +
                    S.dualNorm (S.deltaHOdd (sample ω) i) ^ (2 : ℕ)) -
                (S.alpha (paperTime i).1 / S.Gamma (paperTime i).1) *
                  ⟪S.deltaG (sample ω) i,
                    (S.rSeq (sample ω) i).1 - (S.auxiliarySeq (sample ω) i).1⟫_ℝ -
                (S.alpha (paperTime i).1 / S.Gamma (paperTime i).1) *
                  ⟪S.deltaHEven (sample ω) i,
                    (S.firstProx (sample ω) i (S.stateProcess (sample ω) i)).1 -
                      (S.auxiliarySeq (sample ω) i).1⟫_ℝ) ∂μ)
          =
        (Finset.range t.1).sum
          (fun i =>
            ∫ ω,
              (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
                  (2 * S.Gamma (paperTime i).1)) *
                S.dualNorm
                  (S.deltaHEvenProcess sample i ω + S.deltaGProcess sample i ω) ^
                    (2 : ℕ) +
                (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
                    (2 * (1 - S.q) * S.Gamma (paperTime i).1)) *
                  S.dualNorm (S.deltaGProcess sample i ω) ^ (2 : ℕ) +
                (3 * S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
                    (2 * S.Gamma (paperTime i).1)) *
                  (S.dualNorm (S.deltaHEvenProcess sample i ω) ^ (2 : ℕ) +
                    S.dualNorm (S.deltaHOddProcess sample i ω) ^ (2 : ℕ)) -
                (S.alpha (paperTime i).1 / S.Gamma (paperTime i).1) *
                  ⟪S.deltaGProcess sample i ω,
                    (S.rSeq (sample ω) i).1 - (S.auxiliarySeq (sample ω) i).1⟫_ℝ -
                (S.alpha (paperTime i).1 / S.Gamma (paperTime i).1) *
                  ⟪S.deltaHEvenProcess sample i ω,
                    (S.firstProx (sample ω) i (S.stateProcess (sample ω) i)).1 -
                      (S.auxiliarySeq (sample ω) i).1⟫_ℝ ∂μ) := by
            rw [integral_finset_sum (Finset.range t.1) (by
              intro i hi
              simpa [sub_eq_add_neg, add_assoc] using hterm_int i hi)]
            refine Finset.sum_congr rfl ?_
            intro i hi
            rfl
      _ ≤
        (Finset.range t.1).sum
          (fun i =>
            (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
                S.Gamma (paperTime i).1) *
              (4 * S.sigmaH ^ (2 : ℕ) +
                (1 + curvatureNoise) * S.sigmaG ^ (2 : ℕ))) := by
          refine Finset.sum_le_sum ?_
          intro i hi
          exact hterm_le i hi
      _ =
        (4 * S.sigmaH ^ (2 : ℕ) +
          (1 + curvatureNoise) * S.sigmaG ^ (2 : ℕ)) * weightedSum := by
          rw [hweight_range, Finset.mul_sum]
          refine Finset.sum_congr rfl ?_
          intro i hi
          ring

private theorem theorem_4_10_expected_gap_assembly_from_Ut
    [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E] [BorelSpace E]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω) [IsProbabilityMeasure μ]
    (xiLaw : Measure Ξ) (zetaLaw : Measure Ζ)
    (_hMean : S.OracleUnbiasedLaw xiLaw zetaLaw)
    (h10 : S.Assumption10 sample μ)
    (hHistory : S.SAMPInterleavedOracleHistoryBoundary sample)
    (t : {n : ℕ // 1 ≤ n}) {curvatureNoise weightedSum : ℝ}
    {leading : ℝ}
    (hlead : SOptLib.checked_quotient_spec (2 * S.alpha t.1) (S.gamma t.1) leading)
    (hUt : Integrable (theorem410_Ut S sample t) μ ∧
      (∫ ω, theorem410_Ut S sample t ω ∂μ) ≤
        (4 * S.sigmaH ^ (2 : ℕ) +
          (1 + curvatureNoise) * S.sigmaG ^ (2 : ℕ)) * weightedSum)
    (hpath :
      ∀ ω,
        S.expectedGapIntegrand sample μ t.1 ω ≤
          (2 * S.alpha t.1 / S.gamma t.1) * S.DZ ^ (2 : ℕ) +
            S.Gamma t.1 * theorem410_Ut S sample t ω)
    (hQ0 :
      S.Q0 t =
        leading * S.DZ ^ (2 : ℕ) +
          (4 * S.sigmaH ^ (2 : ℕ) +
            (1 + curvatureNoise) * S.sigmaG ^ (2 : ℕ)) *
            S.Gamma t.1 * weightedSum) :
    (∫ ω, S.expectedGapIntegrand sample μ t.1 ω ∂μ) ≤ S.Q0 t := by
  classical
  have hbar : Measurable (fun ω => S.barSeq (sample ω) t.1) :=
    S.barSeq_measurable sample hHistory t.1
  have hgap_int : Integrable (S.expectedGapIntegrand sample μ t.1) μ :=
    S.expectedGapIntegrand_integrable_of_Assumption10 sample μ xiLaw zetaLaw
      _hMean h10 t.1 hbar
  have hupper_int :
      Integrable
        (fun ω =>
          (2 * S.alpha t.1 / S.gamma t.1) * S.DZ ^ (2 : ℕ) +
            S.Gamma t.1 * theorem410_Ut S sample t ω) μ :=
    (integrable_const
      (c := (2 * S.alpha t.1 / S.gamma t.1) * S.DZ ^ (2 : ℕ))).add
        (hUt.1.const_mul (S.Gamma t.1))
  have hmono :
      (∫ ω, S.expectedGapIntegrand sample μ t.1 ω ∂μ) ≤
        ∫ ω,
          (2 * S.alpha t.1 / S.gamma t.1) * S.DZ ^ (2 : ℕ) +
            S.Gamma t.1 * theorem410_Ut S sample t ω ∂μ :=
    integral_mono hgap_int hupper_int hpath
  have hupper_eval :
      (∫ ω,
          (2 * S.alpha t.1 / S.gamma t.1) * S.DZ ^ (2 : ℕ) +
            S.Gamma t.1 * theorem410_Ut S sample t ω ∂μ) =
        (2 * S.alpha t.1 / S.gamma t.1) * S.DZ ^ (2 : ℕ) +
          S.Gamma t.1 * (∫ ω, theorem410_Ut S sample t ω ∂μ) := by
    have hscale :
        (∫ ω, S.Gamma t.1 * theorem410_Ut S sample t ω ∂μ) =
          S.Gamma t.1 * (∫ ω, theorem410_Ut S sample t ω ∂μ) := by
      simpa using
        (MeasureTheory.integral_const_mul (μ := μ) (S.Gamma t.1)
          (theorem410_Ut S sample t))
    rw [integral_add (integrable_const
      (c := (2 * S.alpha t.1 / S.gamma t.1) * S.DZ ^ (2 : ℕ)))
      (hUt.1.const_mul (S.Gamma t.1))]
    rw [hscale]
    simp
  have hGamma_nonneg : 0 ≤ S.Gamma t.1 := le_of_lt (S.Gamma_pos t)
  have hlead_eq : leading = (2 * S.alpha t.1) / S.gamma t.1 :=
    SOptLib.eq_div_of_checked_quotient_spec hlead
  have hbase :
      (2 * S.alpha t.1 / S.gamma t.1) * S.DZ ^ (2 : ℕ) =
        leading * S.DZ ^ (2 : ℕ) := by
    rw [hlead_eq]
  calc
    (∫ ω, S.expectedGapIntegrand sample μ t.1 ω ∂μ)
        ≤ ∫ ω,
          (2 * S.alpha t.1 / S.gamma t.1) * S.DZ ^ (2 : ℕ) +
            S.Gamma t.1 * theorem410_Ut S sample t ω ∂μ := hmono
    _ =
        (2 * S.alpha t.1 / S.gamma t.1) * S.DZ ^ (2 : ℕ) +
          S.Gamma t.1 * (∫ ω, theorem410_Ut S sample t ω ∂μ) := hupper_eval
    _ ≤
        leading * S.DZ ^ (2 : ℕ) +
          S.Gamma t.1 *
            ((4 * S.sigmaH ^ (2 : ℕ) +
              (1 + curvatureNoise) * S.sigmaG ^ (2 : ℕ)) * weightedSum) := by
          rw [hbase]
          have hmul := mul_le_mul_of_nonneg_left hUt.2 hGamma_nonneg
          nlinarith
    _ = S.Q0 t := by
          rw [hQ0]
          ring

/-- The strict tail event in Theorem 4.10(b). -/
noncomputable def highProbabilityEvent [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    (sample : Ω → SamplePath Ξ Ζ) (t : {n : ℕ // 1 ≤ n}) (lambda : ℝ) : Set Ω :=
  S.strictGapTailEvent sample t.1 (S.Q0 t + lambda * S.Q1 t)

/-- Measurability of the Theorem 4.10(b) strict tail event is a derived
regularity obligation under Assumption 11, not a theorem-head assumption. -/
theorem highProbabilityEvent_measurable [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    [MeasurableSpace Ξ] [MeasurableSpace Ζ] [MeasurableSpace E] [BorelSpace E]
    (sample : Ω → SamplePath Ξ Ζ) (μ : Measure Ω)
    (_h11 : S.Assumption11_sourceBoundary sample μ)
    (hHistory : S.SAMPInterleavedOracleHistoryBoundary sample)
    (t : {n : ℕ // 1 ≤ n}) (lambda : ℝ) :
    MeasurableSet (S.highProbabilityEvent sample t lambda) := by
  have hbar : Measurable (fun ω => S.barSeq (sample ω) t.1) :=
    S.barSeq_measurable sample hHistory t.1
  have hgap : Measurable (S.expectedGapIntegrand sample μ t.1) :=
    S.expectedGapIntegrand_measurable sample μ t.1 hbar
  have hset :
      MeasurableSet {ω | S.Q0 t + lambda * S.Q1 t <
        S.expectedGapIntegrand sample μ t.1 ω} := by
    exact measurableSet_lt measurable_const hgap
  simpa [highProbabilityEvent, strictGapTailEvent, expectedGapIntegrand] using hset

private theorem theorem410_Ut_good_event_bound
    [MeasurableSpace Ω] (S : Setup Ξ Ζ E)
    (sample : Ω → SamplePath Ξ Ζ) (t : {n : ℕ // 1 ≤ n}) {lambda : ℝ}
    {curvatureNoise weightedSum : ℝ} {alphaOverGamma : ℕ → ℝ}
    (hcurv : SOptLib.checked_quotient_spec 1 (2 * (1 - S.q)) curvatureNoise)
    (hsum : CheckedQuotientFinsetSumSpec (Finset.Icc 1 t.1)
      (fun i => S.alpha i * S.gamma i) S.Gamma weightedSum)
    (halpha : ∀ i ∈ Finset.Icc 1 t.1,
      SOptLib.checked_quotient_spec (S.alpha i) (S.Gamma i) (alphaOverGamma i))
    (ω : Ω) (hlambda : 0 < lambda)
    (hgood_BG :
      (∑ n ∈ Finset.range t.1,
        -((S.alpha (paperTime n).1 / S.Gamma (paperTime n).1) *
          ⟪S.deltaGProcess sample n ω,
            (S.rSeq (sample ω) n).1 -
              (S.auxiliarySeq (sample ω) n).1⟫_ℝ)) ≤
        lambda * Real.sqrt
          (2 * (Finset.range t.1).sum
            (fun n =>
              (S.sigmaG * (S.alpha (paperTime n).1 / S.Gamma (paperTime n).1) *
                S.DZ) ^ (2 : ℕ))))
    (hgood_BH :
      (∑ n ∈ Finset.range t.1,
        -((S.alpha (paperTime n).1 / S.Gamma (paperTime n).1) *
          ⟪S.deltaHEvenProcess sample n ω,
            (S.firstProx (sample ω) n (S.stateProcess (sample ω) n)).1 -
              (S.auxiliarySeq (sample ω) n).1⟫_ℝ)) ≤
        lambda * Real.sqrt
          (2 * (Finset.range t.1).sum
            (fun n =>
              (S.sigmaH * (S.alpha (paperTime n).1 / S.Gamma (paperTime n).1) *
                S.DZ) ^ (2 : ℕ))))
    (hgood_SG :
      (Finset.range t.1).sum
          (fun i =>
            (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
              S.Gamma (paperTime i).1) *
              S.dualNorm (S.deltaGProcess sample i ω) ^ (2 : ℕ)) ≤
        (1 + lambda) *
          (((Finset.range t.1).sum
              (fun i =>
                S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
                  S.Gamma (paperTime i).1)) *
            S.sigmaG ^ (2 : ℕ)))
    (hgood_SHO :
      (Finset.range t.1).sum
          (fun i =>
            (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
              S.Gamma (paperTime i).1) *
              S.dualNorm (S.deltaHOddProcess sample i ω) ^ (2 : ℕ)) ≤
        (1 + lambda) *
          (((Finset.range t.1).sum
              (fun i =>
                S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
                  S.Gamma (paperTime i).1)) *
            S.sigmaH ^ (2 : ℕ)))
    (hgood_SHE :
      (Finset.range t.1).sum
          (fun i =>
            (S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
              S.Gamma (paperTime i).1) *
              S.dualNorm (S.deltaHEvenProcess sample i ω) ^ (2 : ℕ)) ≤
        (1 + lambda) *
          (((Finset.range t.1).sum
              (fun i =>
                S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
                  S.Gamma (paperTime i).1)) *
            S.sigmaH ^ (2 : ℕ))) :
    theorem410_Ut S sample t ω ≤
      lambda * (S.sigmaG + S.sigmaH) * S.DZ *
        Real.sqrt
          (2 * (Finset.Icc 1 t.1).sum
            (fun i => alphaOverGamma i ^ (2 : ℕ))) +
      (1 + lambda) *
        ((4 * S.sigmaH ^ (2 : ℕ) +
            (1 + curvatureNoise) * S.sigmaG ^ (2 : ℕ)) *
          weightedSum) := by
  -- Source steps 29-32: expand `theorem410_Ut`, use the two martingale
  -- good-event inequalities, split the add-square by
  -- `dualNorm_add_sq_le_two_mul_sq_add_two_mul_sq`, apply the three
  -- weighted-square good-event inequalities, and normalize the range sums
  -- through `hsum` and `halpha`.
  let W : ℕ → ℝ := fun i =>
    S.alpha (paperTime i).1 * S.gamma (paperTime i).1 /
