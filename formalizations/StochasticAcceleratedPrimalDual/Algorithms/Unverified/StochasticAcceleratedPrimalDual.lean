because Eq. (4.4.28) is already represented as this exact finite sum. -/
private theorem generated_bregman_raw_sum_eq_generatedBTerm
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (t : ℕ) (ω : Ω)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    Finset.sum (Finset.Icc 1 t) (fun i =>
