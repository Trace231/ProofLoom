/-- Telescope of the non-cross generated coupling terms in summed Eq. (4.4.61).

Chosen alignment with Lan Lemma 4.9 step 2: this is the finite-window identity
for `C_i - C_{i-1}`, where
`C_i = γ_i ⟪A(x_i - x_{i-1}), y - y_i⟫`.  Generic closed-interval telescope
lemmas were considered, but the `i = 1` false branch and generated-process
indexing make the direct induction clearer and source-faithful. -/
private theorem generated_coupling_raw_sum_telescope
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (t : ℕ) (ht : 1 ≤ t) (ω : Ω)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    Finset.sum (Finset.Icc 1 t) (fun i =>
        if _hi : 1 ≤ i then
          let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
          let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
          setup.gamma i *
              ⟪setup.A (stNext.x.1 - stPrev.x.1), z.1.2 - stNext.y.1⟫_ℝ -
            (if h2 : 2 ≤ i then
              setup.gamma (i - 1) *
                ⟪setup.A
                    (stPrev.x.1 -
                      (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1),
                  z.1.2 - stPrev.y.1⟫_ℝ
            else 0)
        else 0) =
      setup.gamma t *
        ⟪setup.A ((setup.generatedAxExtensionProcess generatedAxSample t ω).x.1 -
            (setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω).x.1),
          z.1.2 - (setup.generatedAxExtensionProcess generatedAxSample t ω).y.1⟫_ℝ := by
  classical
  let C : ℕ → ℝ := fun i =>
    setup.gamma i *
      ⟪setup.A ((setup.generatedAxExtensionProcess generatedAxSample i ω).x.1 -
          (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).x.1),
        z.1.2 - (setup.generatedAxExtensionProcess generatedAxSample i ω).y.1⟫_ℝ
  have htel := sum_Icc_one_sub_predecessor_eq_last C t ht
  change Finset.sum (Finset.Icc 1 t) (fun i =>
        if _hi : 1 ≤ i then
          let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
          let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
          setup.gamma i *
              ⟪setup.A (stNext.x.1 - stPrev.x.1), z.1.2 - stNext.y.1⟫_ℝ -
            (if h2 : 2 ≤ i then
              setup.gamma (i - 1) *
                ⟪setup.A
                    (stPrev.x.1 -
                      (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1),
                  z.1.2 - stPrev.y.1⟫_ℝ
            else 0)
        else 0) = C t
  rw [← htel]
  refine Finset.sum_congr rfl ?_
  intro i hiIcc
  have hi1 : 1 ≤ i := (Finset.mem_Icc.mp hiIcc).1
  by_cases h2 : 2 ≤ i
  · have hidx : i - 2 = i - 1 - 1 := by omega
    simp [C, hi1, h2, hidx, ContinuousLinearMap.map_sub]
  · simp [C, hi1, h2]

/-- Raw summed Eq. (4.4.61) telescope for Lan Lemma 4.9.

This is the Planner T1 helper: it consumes `generated_eq_4461_one_step_bound`,
`beta_gamma_shift_identity`, `generatedBTerm`, and generated averaged-output
transport, leaving only the Young/parameter absorption of the raw lag-cross,
square, and noise sums.  It is strictly weaker than the final Lemma 4.9 bound:
the right-hand side still contains the unabsorbed Eq. (4.4.61) remainder. -/
private theorem generated_eq_4461_sum_raw_telescope
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (t : ℕ) (ht : 1 ≤ t) (ω : Ω)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    setup.beta t * setup.gamma t *
        setup.Q (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω) z ≤
      setup.generatedBTerm generatedAxSample t z ω +
        setup.gamma t *
          ⟪setup.A ((setup.generatedAxExtensionProcess generatedAxSample t ω).x.1 -
              (setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω).x.1),
            z.1.2 - (setup.generatedAxExtensionProcess generatedAxSample t ω).y.1⟫_ℝ -
        Finset.sum (Finset.Icc 1 t) (fun i =>
          if _hi : 1 ≤ i then
            let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
            let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
            if h2 : 2 ≤ i then
              setup.gamma (i - 1) *
                ⟪setup.A
                    (stPrev.x.1 -
                      (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1),
                  stPrev.y.1 - stNext.y.1⟫_ℝ
            else 0
          else 0) -
        Finset.sum (Finset.Icc 1 t) (fun i =>
          if _hi : 1 ≤ i then
            let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
            let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
            setup.gamma i *
              (1 / (2 * setup.eta i) - setup.Lhatf / (2 * setup.beta i)) *
                ‖stNext.x.1 - stPrev.x.1‖ ^ 2
          else 0) -
        Finset.sum (Finset.Icc 1 t) (fun i =>
          if _hi : 1 ≤ i then
            let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
            let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
            setup.gamma i / (2 * setup.tau i) *
              ‖stNext.y.1 - stPrev.y.1‖ ^ 2
          else 0) -
        Finset.sum (Finset.Icc 1 t) (fun i =>
          if hi : 1 ≤ i then
            let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
            setup.gamma i *
              (⟪(setup.delta generatedAxSample i hi ω).1, stNext.x.1 - z.1.1⟫_ℝ +
                ⟪(setup.delta generatedAxSample i hi ω).2, stNext.y.1 - z.1.2⟫_ℝ)
          else 0) := by
  classical
  let breg : ℕ → ℝ := fun i =>
    if _hi : 1 ≤ i then
      let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      setup.gamma i / setup.eta i *
          (setup.VX z.1.1 stPrev.x.1 - setup.VX z.1.1 stNext.x.1) +
        setup.gamma i / setup.tau i *
          (setup.VY z.1.2 stPrev.y.1 - setup.VY z.1.2 stNext.y.1)
    else 0
  let couplingDiff : ℕ → ℝ := fun i =>
    if _hi : 1 ≤ i then
      let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      setup.gamma i *
          ⟪setup.A (stNext.x.1 - stPrev.x.1), z.1.2 - stNext.y.1⟫_ℝ -
        (if h2 : 2 ≤ i then
          setup.gamma (i - 1) *
            ⟪setup.A
                (stPrev.x.1 -
                  (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1),
              z.1.2 - stPrev.y.1⟫_ℝ
        else 0)
    else 0
  let lagCross : ℕ → ℝ := fun i =>
    if _hi : 1 ≤ i then
      let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      if h2 : 2 ≤ i then
        setup.gamma (i - 1) *
          ⟪setup.A
              (stPrev.x.1 -
                (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1),
            stPrev.y.1 - stNext.y.1⟫_ℝ
      else 0
    else 0
  let xSq : ℕ → ℝ := fun i =>
    if _hi : 1 ≤ i then
      let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      setup.gamma i *
        (1 / (2 * setup.eta i) - setup.Lhatf / (2 * setup.beta i)) *
          ‖stNext.x.1 - stPrev.x.1‖ ^ 2
    else 0
  let ySq : ℕ → ℝ := fun i =>
    if _hi : 1 ≤ i then
      let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      setup.gamma i / (2 * setup.tau i) * ‖stNext.y.1 - stPrev.y.1‖ ^ 2
    else 0
  let noise : ℕ → ℝ := fun i =>
    if hi : 1 ≤ i then
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      setup.gamma i *
        (⟪(setup.delta generatedAxSample i hi ω).1, stNext.x.1 - z.1.1⟫_ℝ +
          ⟪(setup.delta generatedAxSample i hi ω).2, stNext.y.1 - z.1.2⟫_ℝ)
    else 0
  let raw : ℕ → ℝ := fun i =>
    if hi : 1 ≤ i then
      let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      setup.gamma i / setup.eta i *
          (setup.VX z.1.1 stPrev.x.1 - setup.VX z.1.1 stNext.x.1) +
        setup.gamma i / setup.tau i *
          (setup.VY z.1.2 stPrev.y.1 - setup.VY z.1.2 stNext.y.1) +
        setup.gamma i *
          ⟪setup.A (stNext.x.1 - stPrev.x.1), z.1.2 - stNext.y.1⟫_ℝ -
        (if h2 : 2 ≤ i then
          setup.gamma (i - 1) *
            ⟪setup.A
                (stPrev.x.1 -
                  (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1),
              z.1.2 - stPrev.y.1⟫_ℝ
        else 0) -
        (if h2 : 2 ≤ i then
          setup.gamma (i - 1) *
            ⟪setup.A
                (stPrev.x.1 -
                  (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1),
              stPrev.y.1 - stNext.y.1⟫_ℝ
        else 0) -
        setup.gamma i *
          (1 / (2 * setup.eta i) - setup.Lhatf / (2 * setup.beta i)) *
            ‖stNext.x.1 - stPrev.x.1‖ ^ 2 -
        setup.gamma i / (2 * setup.tau i) *
          ‖stNext.y.1 - stPrev.y.1‖ ^ 2 -
        setup.gamma i *
          (⟪(setup.delta generatedAxSample i hi ω).1, stNext.x.1 - z.1.1⟫_ℝ +
            ⟪(setup.delta generatedAxSample i hi ω).2, stNext.y.1 - z.1.2⟫_ℝ)
    else 0
  have hraw := generated_eq_4461_terminal_le_sum_raw setup generatedAxSample t ht ω z
  have hbreg := generated_bregman_raw_sum_eq_generatedBTerm setup generatedAxSample t ω z
  have hcoupling := generated_coupling_raw_sum_telescope setup generatedAxSample t ht ω z
  have hraw' :
      setup.beta t * setup.gamma t *
          setup.Q (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω) z ≤
        Finset.sum (Finset.Icc 1 t) raw := by
    simpa [raw] using hraw
  have hbreg' :
