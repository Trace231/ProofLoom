    setup.beta t *
          (setup.hatg (run.state (t + 1)).yBar.1 - setup.hatg z.1.2) -
        (setup.beta t - 1) *
          (setup.hatg (run.state t).yBar.1 - setup.hatg z.1.2) ≤
      setup.hatg (run.state (t + 1)).y.1 - setup.hatg z.1.2 := by
  exact SOptLib.accelerated_convex_aggregate_gap_bound_of_run
    (run := run.toDeterministicAcceleratedPrimalDualProxRun.toDeterministicAcceleratedAggregateRun)
    (yBar := fun st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y => st.yBar.1)
    (y := fun st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y => st.y.1)
    (β := setup.beta)
    (fun t ht prev next hstep => by
      have hstep' := congrArg Subtype.val hstep
      simpa [SOptLib.acceleratedAveragePoint, averageYValue] using hstep')
    setup.hhatg_convex t ht hβge (run.state t).yBar.2 (run.state (t + 1)).y.2 z.1.2

/-- Primal `\hat f` aggregate contribution for any deterministic APD aggregate run.

Chosen alignment with Lan Proposition 4.12 step 1: the SOptLib pre-digest
certificate/telescope/block/independence candidates are unrelated to this
two-point APD recurrence, and the existing `Algorithm42Run` helper carries
prox-minimality fields not used in the proof. This specialization consumes only
`run.xbar_step`, `setup.hatf_smooth`, `setup.hatf_hasGradientAt_on_X`, and
convexity, matching Eq. (4.4.14)/(4.4.18). -/
private theorem deterministic_apd_hatf_aggregate_bound_of_aggregate_run
    (run : setup.DeterministicApdRun)
    (t : ℕ) (ht : 1 ≤ t) (hβge : 1 ≤ setup.beta t)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    setup.beta t * setup.hatf (run.state (t + 1)).xBar.1 -
        (setup.beta t - 1) * setup.hatf (run.state t).xBar.1 -
        setup.hatf z.1.1 ≤
      ⟪setup.hatfGradient (setup.midpoint t ht (run.state t)).1,
          (run.state (t + 1)).x.1 - z.1.1⟫_ℝ +
        (setup.Lhatf / (2 * setup.beta t)) *
          ‖(run.state (t + 1)).x.1 - (run.state t).x.1‖ ^ 2 := by
  let β := setup.beta t
  let xBarPrev := (run.state t).xBar.1
  let xPrev := (run.state t).x.1
  let xNext := (run.state (t + 1)).x.1
  let xBarNext := (run.state (t + 1)).xBar.1
  let xMid := (setup.midpoint t ht (run.state t)).1
  let xTarget := z.1.1
  have hβpos : 0 < β := lt_of_lt_of_le zero_lt_one (by simpa [β] using hβge)
  have hβne : β ≠ 0 := ne_of_gt hβpos
  have hxbar_eq :
      xBarNext =
        (1 - β⁻¹) • xBarPrev + β⁻¹ • xNext := by
    have hstep := congrArg Subtype.val (run.xbar_step t ht)
    simpa [xBarNext, xBarPrev, xNext, β, averageX, averageXValue] using hstep
  have hxmid_eq :
      xMid =
        (1 - β⁻¹) • xBarPrev + β⁻¹ • xPrev := by
    rfl
  have hbar_disp : xBarNext - xMid = β⁻¹ • (xNext - xPrev) := by
    rw [hxbar_eq, hxmid_eq]
    module
  have hcoef_left : β * (1 - β⁻¹) = β - 1 := by
    field_simp [hβne]
  have hcoef_right : β * β⁻¹ = 1 := by
    field_simp [hβne]
  have hxmid_scaled : β • xMid = (β - 1) • xBarPrev + xPrev := by
    rw [hxmid_eq, smul_add, smul_smul, smul_smul, hcoef_left, hcoef_right, one_smul]
  have hmid_comb :
      (β - 1) • (xBarPrev - xMid) + (xTarget - xMid) = xTarget - xPrev := by
    calc
      (β - 1) • (xBarPrev - xMid) + (xTarget - xMid)
          = (β - 1) • xBarPrev + xTarget - β • xMid := by
              module
      _ = xTarget - xPrev := by
              rw [hxmid_scaled]
              module
  have hcore :=
    deterministic_apd_hatf_aggregate_bound_core
      (X := setup.X) (f := setup.hatf)
      (grad := setup.hatfGradient xMid)
      (xBarPrev := xBarPrev) (xPrev := xPrev) (xNext := xNext)
      (xBarNext := xBarNext) (xMid := xMid) (xTarget := xTarget)
      (β := β) (L := setup.Lhatf)
      (by simpa [β] using hβge)
      setup.hatf.convexOn
      (by simpa [xMid] using (setup.midpoint t ht (run.state t)).2)
      (by simpa [xBarPrev] using (run.state t).xBar.2)
      (by simpa [xBarNext] using (run.state (t + 1)).xBar.2)
      (by
        exact z.2.1)
      (by
        simpa [xMid] using setup.hatf_hasGradientAt_on_X xMid
          (by simpa [xMid] using (setup.midpoint t ht (run.state t)).2))
      (by
        simpa [xMid, xBarNext] using
          setup.hatf_smooth xMid
            (by simpa [xMid] using (setup.midpoint t ht (run.state t)).2)
            xBarNext (by simpa [xBarNext] using (run.state (t + 1)).xBar.2))
      hbar_disp hmid_comb
  simpa [β, xBarPrev, xPrev, xNext, xBarNext, xMid, xTarget] using hcore

/-- Dual `\hat g` aggregate contribution for any deterministic APD aggregate run.

Chosen alignment with Lan Proposition 4.12 step 2: the finite-output and
telescope candidates in SOptLib do not encode the literal two-point
`run.ybar_step` recurrence from Eq. (4.4.19), while the existing
`Algorithm42Run` helper has unused prox fields. -/
private theorem deterministic_apd_hatg_aggregate_bound_of_aggregate_run
    (run : setup.DeterministicApdRun)
    (t : ℕ) (ht : 1 ≤ t) (hβge : 1 ≤ setup.beta t)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    setup.beta t *
          (setup.hatg (run.state (t + 1)).yBar.1 - setup.hatg z.1.2) -
        (setup.beta t - 1) *
          (setup.hatg (run.state t).yBar.1 - setup.hatg z.1.2) ≤
      setup.hatg (run.state (t + 1)).y.1 - setup.hatg z.1.2 := by
  let β := setup.beta t
  let yBarPrev := (run.state t).yBar.1
  let yNext := (run.state (t + 1)).y.1
  let yBarNext := (run.state (t + 1)).yBar.1
  let yTarget := z.1.2
  have hβpos : 0 < β := lt_of_lt_of_le zero_lt_one (by simpa [β] using hβge)
  have hβnonneg : 0 ≤ β := le_of_lt hβpos
  have hβne : β ≠ 0 := ne_of_gt hβpos
  rcases inv_beta_convex_weights setup t ht with ⟨hleft, hright, hsum⟩
  have hybar_eq :
      yBarNext =
        (1 - β⁻¹) • yBarPrev + β⁻¹ • yNext := by
    have hstep := congrArg Subtype.val (run.ybar_step t ht)
    simpa [yBarNext, yBarPrev, yNext, β, SOptLib.acceleratedAveragePoint,
      averageYValue] using hstep
  have hconv :
      setup.hatg yBarNext ≤
        (1 - β⁻¹) * setup.hatg yBarPrev + β⁻¹ * setup.hatg yNext := by
    have hconv_raw :=
      setup.hhatg_convex.2 (run.state t).yBar.2 (run.state (t + 1)).y.2
        (by simpa only [β] using hleft) (by simpa only [β] using hright)
        (by simpa only [β] using hsum)
    simpa [hybar_eq, yBarPrev, yNext, β] using hconv_raw
  have hmul := mul_le_mul_of_nonneg_left hconv hβnonneg
  have hcoef_left : β * (1 - β⁻¹) = β - 1 := by
    field_simp [hβne]
  have hcoef_right : β * β⁻¹ = 1 := by
    field_simp [hβne]
  have hweighted :
      β * setup.hatg yBarNext ≤
        (β - 1) * setup.hatg yBarPrev + setup.hatg yNext := by
    have hrhs :
        β * ((1 - β⁻¹) * setup.hatg yBarPrev + β⁻¹ * setup.hatg yNext) =
          (β - 1) * setup.hatg yBarPrev + setup.hatg yNext := by
      calc
        β * ((1 - β⁻¹) * setup.hatg yBarPrev + β⁻¹ * setup.hatg yNext)
            = (β * (1 - β⁻¹)) * setup.hatg yBarPrev +
                (β * β⁻¹) * setup.hatg yNext := by
                ring
        _ = (β - 1) * setup.hatg yBarPrev + setup.hatg yNext := by
                rw [hcoef_left, hcoef_right, one_mul]
    nlinarith [hmul, hrhs]
  nlinarith [hweighted]

/-- Paper Proposition 4.12, deterministic APD one-step saddle-gap recursion.

The head is tied to a deterministic APD aggregate run rather than arbitrary
local variables or the generated-`A_hat_x(\tilde x_t)` extension. The stochastic
extension versions below remain separate helper obligations. -/
theorem proposition_4_12_deterministic_apd
    (run : setup.Algorithm42Run)
    (t : ℕ) (ht : 1 ≤ t) (_hbeta_ge_one : 1 ≤ setup.beta t)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    let zNext : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
      ⟨(((run.state (t + 1)).xBar.1, (run.state (t + 1)).yBar.1)),
        ⟨(run.state (t + 1)).xBar.2, (run.state (t + 1)).yBar.2⟩⟩
    let zPrev : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
      ⟨(((run.state t).xBar.1, (run.state t).yBar.1)),
        ⟨(run.state t).xBar.2, (run.state t).yBar.2⟩⟩
    setup.beta t * setup.Q zNext z - (setup.beta t - 1) * setup.Q zPrev z ≤
      ⟪setup.hatfGradient (setup.midpoint t ht (run.state t)).1,
          (run.state (t + 1)).x.1 - z.1.1⟫_ℝ +
        (setup.Lhatf / (2 * setup.beta t)) *
          ‖(run.state (t + 1)).x.1 - (run.state t).x.1‖ ^ 2 +
        (setup.hatg (run.state (t + 1)).y.1 - setup.hatg z.1.2) +
        ⟪setup.A (run.state (t + 1)).x.1, z.1.2⟫_ℝ -
          ⟪setup.A z.1.1, (run.state (t + 1)).y.1⟫_ℝ := by
  let β := setup.beta t
  let xBarPrev := (run.state t).xBar.1
  let xNext := (run.state (t + 1)).x.1
  let xBarNext := (run.state (t + 1)).xBar.1
  let yBarPrev := (run.state t).yBar.1
  let yNext := (run.state (t + 1)).y.1
  let yBarNext := (run.state (t + 1)).yBar.1
  let xTarget := z.1.1
  let yTarget := z.1.2
  have hβpos : 0 < β := lt_of_lt_of_le zero_lt_one (by simpa [β] using _hbeta_ge_one)
  have hβne : β ≠ 0 := ne_of_gt hβpos
  have hxbar_eq :
      xBarNext =
        (1 - β⁻¹) • xBarPrev + β⁻¹ • xNext := by
    have hstep := congrArg Subtype.val (run.xbar_step t ht)
    simpa [xBarNext, xBarPrev, xNext, β, averageX, averageXValue] using hstep
  have hybar_eq :
      yBarNext =
        (1 - β⁻¹) • yBarPrev + β⁻¹ • yNext := by
    have hstep := congrArg Subtype.val (run.ybar_step t ht)
    simpa [yBarNext, yBarPrev, yNext, β, SOptLib.acceleratedAveragePoint,
      averageYValue] using hstep
  have hcoef_left : β * (1 - β⁻¹) = β - 1 := by
    field_simp [hβne]
  have hcoef_right : β * β⁻¹ = 1 := by
    field_simp [hβne]
  have hxagg : β • xBarNext - (β - 1) • xBarPrev = xNext := by
    rw [hxbar_eq, smul_add, smul_smul, smul_smul, hcoef_left, hcoef_right, one_smul]
    module
  have hyagg : β • yBarNext - (β - 1) • yBarPrev = yNext := by
    rw [hybar_eq, smul_add, smul_smul, smul_smul, hcoef_left, hcoef_right, one_smul]
    module
  have hAx :
      β * ⟪setup.A xBarNext, yTarget⟫_ℝ -
          (β - 1) * ⟪setup.A xBarPrev, yTarget⟫_ℝ =
        ⟪setup.A xNext, yTarget⟫_ℝ := by
    calc
      β * ⟪setup.A xBarNext, yTarget⟫_ℝ -
          (β - 1) * ⟪setup.A xBarPrev, yTarget⟫_ℝ
          = ⟪setup.A (β • xBarNext - (β - 1) • xBarPrev), yTarget⟫_ℝ := by
              rw [map_sub, map_smul, map_smul, inner_sub_left,
                real_inner_smul_left, real_inner_smul_left]
      _ = ⟪setup.A xNext, yTarget⟫_ℝ := by rw [hxagg]
  have hAy :
      β * ⟪setup.A xTarget, yBarNext⟫_ℝ -
          (β - 1) * ⟪setup.A xTarget, yBarPrev⟫_ℝ =
        ⟪setup.A xTarget, yNext⟫_ℝ := by
    calc
      β * ⟪setup.A xTarget, yBarNext⟫_ℝ -
          (β - 1) * ⟪setup.A xTarget, yBarPrev⟫_ℝ
          = ⟪setup.A xTarget, β • yBarNext - (β - 1) • yBarPrev⟫_ℝ := by
              rw [inner_sub_right, real_inner_smul_right, real_inner_smul_right]
      _ = ⟪setup.A xTarget, yNext⟫_ℝ := by rw [hyagg]
  have hF := deterministic_apd_hatf_aggregate_bound setup run t ht _hbeta_ge_one z
  have hG := deterministic_apd_hatg_aggregate_bound setup run t ht _hbeta_ge_one z
  dsimp only
  unfold StochasticAcceleratedPrimalDualSetup.Q
  simp [SOptLib.saddleGapComparison_def]
  nlinarith [hF, hG, hAx, hAy]

/-- Extension/internal Proposition 4.12-shaped deterministic APD one-step gap
recursion for the explicit generated-`A_hat_x(\tilde x_t)` APD spine.

This is not exported as the paper-facing Proposition 4.12 because it still
contains the extension-side generated sample stream required by the current
source-boundary gap around Eq. (4.4.56). -/
private theorem proposition_4_12_generated_spine_extension_obligation
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (t : ℕ) (ht : 1 ≤ t) (_hbeta_ge_one : 1 ≤ setup.beta t) (ω : Ω)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    let zNext := setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω
    let zPrev : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
      ⟨((setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω).xBar.1,
          (setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω).yBar.1),
        ⟨(setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω).xBar.2,
          (setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω).yBar.2⟩⟩
    let stPrev := setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω
    let stNext := setup.generatedAxExtensionProcess generatedAxSample t ω
    setup.beta t * setup.Q zNext z - (setup.beta t - 1) * setup.Q zPrev z ≤
      ⟪setup.hatfGradient (setup.midpoint t ht stPrev).1, stNext.x.1 - z.1.1⟫_ℝ +
        (setup.Lhatf / (2 * setup.beta t)) * ‖stNext.x.1 - stPrev.x.1‖ ^ 2 +
        (setup.hatg stNext.y.1 - setup.hatg z.1.2) +
        ⟪setup.A stNext.x.1, z.1.2⟫_ℝ - ⟪setup.A z.1.1, stNext.y.1⟫_ℝ := by
  let run : setup.DeterministicApdRun :=
    { state := fun i => setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      init := by
        simp [generatedAxExtensionProcess_zero, initialState]
      xbar_step := by
        intro i hi
        apply Subtype.ext
        have hstate :
            setup.generatedAxExtensionProcess generatedAxSample i ω =
              setup.stepFromGeneratedAx i hi (generatedAxSample i ω)
                (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω) ω := by
          have hsucc := setup.generatedAxExtensionProcess_succ generatedAxSample (i - 1) ω
          simpa [Nat.sub_add_cancel hi] using hsucc
        rw [show i + 1 - 1 = i by omega, hstate]
        simp [stepFromGeneratedAx, averageX, averageXValue]
      ybar_step := by
        intro i hi
        apply Subtype.ext
        have hstate :
            setup.generatedAxExtensionProcess generatedAxSample i ω =
              setup.stepFromGeneratedAx i hi (generatedAxSample i ω)
                (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω) ω := by
          have hsucc := setup.generatedAxExtensionProcess_succ generatedAxSample (i - 1) ω
          simpa [Nat.sub_add_cancel hi] using hsucc
        rw [show i + 1 - 1 = i by omega, hstate]
        simp [stepFromGeneratedAx, SOptLib.acceleratedAveragePoint] }
  let β := setup.beta t
  let xBarPrev := (run.state t).xBar.1
  let xNext := (run.state (t + 1)).x.1
  let xBarNext := (run.state (t + 1)).xBar.1
  let yBarPrev := (run.state t).yBar.1
  let yNext := (run.state (t + 1)).y.1
  let yBarNext := (run.state (t + 1)).yBar.1
  let xTarget := z.1.1
  let yTarget := z.1.2
  have hβpos : 0 < β := lt_of_lt_of_le zero_lt_one (by simpa [β] using _hbeta_ge_one)
  have hβne : β ≠ 0 := ne_of_gt hβpos
  have hxbar_eq :
      xBarNext =
        (1 - β⁻¹) • xBarPrev + β⁻¹ • xNext := by
    have hstep := congrArg Subtype.val (run.xbar_step t ht)
    simpa [xBarNext, xBarPrev, xNext, β, averageX, averageXValue] using hstep
  have hybar_eq :
      yBarNext =
        (1 - β⁻¹) • yBarPrev + β⁻¹ • yNext := by
    have hstep := congrArg Subtype.val (run.ybar_step t ht)
    simpa [yBarNext, yBarPrev, yNext, β, SOptLib.acceleratedAveragePoint,
      averageYValue] using hstep
  have hcoef_left : β * (1 - β⁻¹) = β - 1 := by
    field_simp [hβne]
  have hcoef_right : β * β⁻¹ = 1 := by
    field_simp [hβne]
  have hxagg : β • xBarNext - (β - 1) • xBarPrev = xNext := by
    rw [hxbar_eq, smul_add, smul_smul, smul_smul, hcoef_left, hcoef_right, one_smul]
    module
  have hyagg : β • yBarNext - (β - 1) • yBarPrev = yNext := by
    rw [hybar_eq, smul_add, smul_smul, smul_smul, hcoef_left, hcoef_right, one_smul]
    module
  have hAx :
      β * ⟪setup.A xBarNext, yTarget⟫_ℝ -
          (β - 1) * ⟪setup.A xBarPrev, yTarget⟫_ℝ =
        ⟪setup.A xNext, yTarget⟫_ℝ := by
    calc
      β * ⟪setup.A xBarNext, yTarget⟫_ℝ -
          (β - 1) * ⟪setup.A xBarPrev, yTarget⟫_ℝ
          = ⟪setup.A (β • xBarNext - (β - 1) • xBarPrev), yTarget⟫_ℝ := by
              rw [map_sub, map_smul, map_smul, inner_sub_left,
                real_inner_smul_left, real_inner_smul_left]
      _ = ⟪setup.A xNext, yTarget⟫_ℝ := by rw [hxagg]
  have hAy :
      β * ⟪setup.A xTarget, yBarNext⟫_ℝ -
          (β - 1) * ⟪setup.A xTarget, yBarPrev⟫_ℝ =
        ⟪setup.A xTarget, yNext⟫_ℝ := by
    calc
      β * ⟪setup.A xTarget, yBarNext⟫_ℝ -
          (β - 1) * ⟪setup.A xTarget, yBarPrev⟫_ℝ
          = ⟪setup.A xTarget, β • yBarNext - (β - 1) • yBarPrev⟫_ℝ := by
              rw [inner_sub_right, real_inner_smul_right, real_inner_smul_right]
      _ = ⟪setup.A xTarget, yNext⟫_ℝ := by rw [hyagg]
  have hF := deterministic_apd_hatf_aggregate_bound_of_aggregate_run setup run t ht _hbeta_ge_one z
  have hG := deterministic_apd_hatg_aggregate_bound_of_aggregate_run setup run t ht _hbeta_ge_one z
  dsimp only at hF hG ⊢
  unfold StochasticAcceleratedPrimalDualSetup.Q
  simp [SOptLib.saddleGapComparison_def, generatedExtensionFeasibleOutput,
    generatedExtensionOutput, run] at hF hG ⊢
  dsimp [β, xBarPrev, xNext, xBarNext, yBarPrev, yNext, yBarNext, xTarget, yTarget, run] at hAx hAy
  nlinarith [hF, hG, hAx, hAy]

/-- Gamma-scaled generated Proposition 4.12 one-step recurrence.

Chosen alignment with Lan Lemma 4.9 step 1: this specializes the already-proved
generated Proposition 4.12 spine and multiplies it by the positive
`gamma_i`. The considered SOptLib telescope/output candidates aggregate
one-step bounds but do not provide this SAPD Proposition 4.12 specialization. -/
private theorem proposition_4_12_generated_extension_gamma_step
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i) (ω : Ω)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    let zPrev : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
      ⟨((setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).xBar.1,
          (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).yBar.1),
        ⟨(setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).xBar.2,
          (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).yBar.2⟩⟩
    let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
    let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
    setup.gamma i *
        (setup.beta i *
            setup.Q (setup.generatedExtensionFeasibleOutput generatedAxSample i hi ω) z -
          (setup.beta i - 1) * setup.Q zPrev z) ≤
      setup.gamma i *
        (⟪setup.hatfGradient (setup.midpoint i hi stPrev).1,
            stNext.x.1 - z.1.1⟫_ℝ +
          (setup.Lhatf / (2 * setup.beta i)) *
            ‖stNext.x.1 - stPrev.x.1‖ ^ 2 +
          (setup.hatg stNext.y.1 - setup.hatg z.1.2) +
          ⟪setup.A stNext.x.1, z.1.2⟫_ℝ - ⟪setup.A z.1.1, stNext.y.1⟫_ℝ) := by
  dsimp only
  exact mul_le_mul_of_nonneg_left
    (proposition_4_12_generated_spine_extension_obligation setup generatedAxSample i hi
      (beta_ge_one setup i hi) ω z)
    (le_of_lt (gamma_pos setup i hi))

/-- Generated-process dual prox variational inequality from Eq. (4.4.56).

Chosen alignment with Lan Lemma 4.9 step 1: this specializes the local
`dual_prox_minimizer_variational` bridge to the generated APD step and consumes
the actual `dualProx_min` certificate after unfolding `generatedAxExtensionProcess_succ`. -/
private theorem generated_dual_prox_variational
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i) (ω : Ω)
    (u : {y : SapdDualSpace m // y ∈ setup.Y}) :
    0 ≤
      ⟪-generatedAxSample i ω,
        u.1 - (setup.generatedAxExtensionProcess generatedAxSample i ω).y.1⟫_ℝ +
        (setup.tau i)⁻¹ *
          ⟪gradient setup.nuY
              (setup.generatedAxExtensionProcess generatedAxSample i ω).y.1 -
              gradient setup.nuY
                (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).y.1,
            u.1 - (setup.generatedAxExtensionProcess generatedAxSample i ω).y.1⟫_ℝ +
        (setup.hatg u.1 -
          setup.hatg (setup.generatedAxExtensionProcess generatedAxSample i ω).y.1) := by
  refine
    generated_dual_prox_variational_inequality
      (process := fun sample t ω => setup.generatedAxExtensionProcess sample t ω)
      (step := fun t ht sample st ω => setup.stepFromGeneratedAx t ht sample st ω)
      (yOf := fun st => st.y.1)
      (proxY := fun t ht sample st ω => (setup.dualProx t ht sample st.y ω).1)
      (τ := setup.tau) (grad := gradient setup.nuY) (h := setup.hatg)
      (sample := generatedAxSample) (i := i) (hi := hi) (ω := ω) (u := u.1)
      ?_ ?_ ?_
  · have hsucc := setup.generatedAxExtensionProcess_succ generatedAxSample (i - 1) ω
    simpa [Nat.sub_add_cancel hi] using hsucc
  · simp [stepFromGeneratedAx, acceleratedPrimalDualStep]
  · let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
    let yNext := setup.dualProx i hi (generatedAxSample i ω) stPrev.y ω
    have hmin_param :
        ∀ y : {y : SapdDualSpace m // y ∈ setup.Y},
          setup.dualProxParamObjective i (generatedAxSample i ω) stPrev.y yNext ≤
            setup.dualProxParamObjective i (generatedAxSample i ω) stPrev.y y := by
      intro y
      simpa [dualProxObjective, yNext, stPrev] using
        setup.dualProx_min i hi (generatedAxSample i ω) stPrev.y ω y
    simpa [stPrev, yNext] using
      setup.dual_prox_minimizer_variational i hi stPrev.y yNext u
        (generatedAxSample i ω) hmin_param

/-- Generated-process primal prox variational inequality from Eq. (4.4.57).

Chosen alignment with Lan Lemma 4.9 step 1: this specializes
`primal_prox_minimizer_scaled_variational` to the generated APD step and consumes
the actual `primalProx_min` certificate after unfolding the generated transition. -/
private theorem generated_primal_prox_scaled_variational
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i) (ω : Ω)
    (u : {x : SapdPrimalSpace n // x ∈ setup.X}) :
    0 ≤
      ⟪(setup.eta i) •
            (setup.generatedGQuery generatedAxSample i hi ω +
              setup.generatedAyQuery generatedAxSample i hi ω) +
          gradient setup.nuX
              (setup.generatedAxExtensionProcess generatedAxSample i ω).x.1 -
            gradient setup.nuX
              (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).x.1,
        u.1 - (setup.generatedAxExtensionProcess generatedAxSample i ω).x.1⟫_ℝ := by
  let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
  let yNext := setup.dualProx i hi (generatedAxSample i ω) stPrev.y ω
  let xNext := setup.primalProx i hi stPrev.x stPrev.x yNext ω
  have hmin_param :
      ∀ x : {x : SapdPrimalSpace n // x ∈ setup.X},
        setup.primalProxParamObjective i
            (setup.sampledG i stPrev.x ω) (setup.sampledAy i yNext ω) stPrev.x xNext ≤
          setup.primalProxParamObjective i
            (setup.sampledG i stPrev.x ω) (setup.sampledAy i yNext ω) stPrev.x x := by
    intro x
    simpa [primalProxObjective, xNext, yNext, stPrev] using
      setup.primalProx_min i hi stPrev.x stPrev.x yNext ω x
  have hvar :=
    setup.primal_prox_minimizer_scaled_variational i hi stPrev.x xNext u
      (setup.sampledG i stPrev.x ω) (setup.sampledAy i yNext ω) hmin_param
  have hstate :
      setup.generatedAxExtensionProcess generatedAxSample i ω =
        setup.stepFromGeneratedAx i hi (generatedAxSample i ω) stPrev ω := by
    have hsucc := setup.generatedAxExtensionProcess_succ generatedAxSample (i - 1) ω
    simpa [stPrev, Nat.sub_add_cancel hi] using hsucc
  simpa [hstate, stepFromGeneratedAx, acceleratedPrimalDualStep, generatedGQuery, generatedGQueryPoint,
    generatedAyQuery, stPrev, yNext, xNext] using hvar

/-- Generated extrapolated `A \tilde x_i` decomposition used in Lan Eq. (4.4.61).

Chosen alignment with Lemma 4.9 proof step 1: the search candidates
`generatedAxTarget`, `proposition_4_12_generated_extension_gamma_step`, and the
SOptLib telescope/output lemmas do not expose Eq. (4.4.17)'s extrapolated
target after applying Eq. (4.4.25)'s gamma recurrence. This helper isolates
that APD-specific algebra before the prox inequalities are combined. -/
private theorem generated_xtilde_target_gamma_decomposition
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i) (ω : Ω) (v : SapdDualSpace m) :
    setup.gamma i *
        ⟪setup.generatedAxTarget generatedAxSample i hi ω, v⟫_ℝ =
      setup.gamma i *
          ⟪setup.A
              (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).x.1, v⟫_ℝ +
        (if _h2 : 2 ≤ i then
          setup.gamma (i - 1) *
            ⟪setup.A
                ((setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).x.1 -
                  (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1), v⟫_ℝ
      else 0) := by
  simpa [generatedAxTarget, generatedAxQueryPoint] using
    (SOptLib.accelerated_extrapolated_target_gamma_decomposition
      (process := setup.generatedAxExtensionProcess generatedAxSample)
      (stateX := fun st => st.x.1)
      (stateXTilde := fun st => st.xTilde)
      (theta := setup.theta) (gamma := setup.gamma)
      (A := setup.A.toLinearMap)
      (hbase := by
        intro ω
        simp [generatedAxExtensionProcess_zero])
      (hstep := by
        intro j hj ω
        have hstate :
            setup.generatedAxExtensionProcess generatedAxSample (j - 1) ω =
              setup.stepFromGeneratedAx (j - 1) (by omega)
                (generatedAxSample (j - 1) ω)
                (setup.generatedAxExtensionProcess generatedAxSample (j - 2) ω) ω := by
          have hsucc := setup.generatedAxExtensionProcess_succ generatedAxSample (j - 2) ω
          have hidx : j - 2 + 1 = j - 1 := by omega
          simpa [hidx] using hsucc
        rw [hstate]
        simp [stepFromGeneratedAx, acceleratedPrimalDualStep, extrapolateXValue])
      (hgamma := by
        intro j hj
        have hrec := setup.hgamma_rec j hj
        have htheta_pos : 0 < setup.theta j := (setup.htheta_range j hj).1
        rw [hrec]
        field_simp [ne_of_gt htheta_pos])
      i hi ω v)

/-- Generated primal prox three-point bound used in Lan Eq. (4.4.61).

Chosen alignment with Lemma 4.9 proof step 1: this specializes the already
proved generated Eq. (4.4.57) variational inequality, the local Lemma 3.5
Bregman identity, and the `V_X` modulus-one lower bound. Generic SOptLib prox
three-point candidates were considered, but the generated helper already
exposes the exact stochastic `G_hat + A_hat_y` sample in this file's notation. -/
private theorem generated_primal_prox_bregman_bound
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i) (ω : Ω)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
    let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
    ⟪setup.generatedGQuery generatedAxSample i hi ω +
        setup.generatedAyQuery generatedAxSample i hi ω,
      stNext.x.1 - z.1.1⟫_ℝ ≤
      (setup.eta i)⁻¹ * (setup.VX z.1.1 stPrev.x.1 - setup.VX z.1.1 stNext.x.1) -
        (1 / (2 * setup.eta i)) * ‖stNext.x.1 - stPrev.x.1‖ ^ 2 := by
  let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
  let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
  let c := setup.generatedGQuery generatedAxSample i hi ω +
    setup.generatedAyQuery generatedAxSample i hi ω
  let xPrev := stPrev.x.1
  let xNext := stNext.x.1
  have hη_pos : 0 < setup.eta i := setup.heta_pos i hi
  have hvar := generated_primal_prox_scaled_variational setup generatedAxSample i hi ω
    ⟨z.1.1, z.2.1⟩
  have hvar_vec :
      0 ≤ ⟪setup.eta i • c +
          gradient setup.nuX xNext - gradient setup.nuX xPrev,
        z.1.1 - xNext⟫_ℝ := by
    simpa [c, xPrev, xNext, stPrev, stNext, smul_add, add_assoc]
      using hvar
  have hthree :
      setup.VX z.1.1 xPrev =
        setup.VX xNext xPrev +
          ⟪gradient setup.nuX xNext - gradient setup.nuX xPrev, z.1.1 - xNext⟫_ℝ +
            setup.VX z.1.1 xNext := by
    have h := lemma_3_5_center_residual_eq_inner setup.dgfX xPrev xNext z.1.1
    have hinner :
        ⟪gradient setup.nuX xNext - gradient setup.nuX xPrev, z.1.1 - xNext⟫_ℝ =
          setup.VX z.1.1 xPrev - setup.VX xNext xPrev - setup.VX z.1.1 xNext := by
      simpa [VX, nuX, xPrev, xNext, sub_eq_add_neg, add_assoc] using h.symm
    nlinarith
  have hlb : (1 / 2 : ℝ) * ‖xNext - xPrev‖ ^ 2 ≤ setup.VX xNext xPrev := by
    exact setup.VX_modulus_one xNext xPrev (by simpa [xNext, stNext] using stNext.x.2)
      (by simpa [xPrev, stPrev] using stPrev.x.2)
  simpa [c, xPrev, xNext, stPrev, stNext] using
    (prox_inner_le_bregman_drop_of_scaled_variational
      (V := setup.VX) (grad := gradient setup.nuX)
      (c := c) (xPrev := xPrev) (xNext := xNext) (target := z.1.1)
      (η := setup.eta i) hη_pos hvar_vec hthree hlb)

/-- Generated dual prox three-point bound used in Lan Eq. (4.4.61).

Chosen alignment with Lemma 4.9 proof step 1: this specializes the generated
Eq. (4.4.56) variational inequality, the local Lemma 3.5 Bregman identity, and
the `V_Y` modulus-one lower bound. This is the dual counterpart of
`generated_primal_prox_bregman_bound`, with the source `\hat g` term retained. -/
private theorem generated_dual_prox_bregman_bound
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i) (ω : Ω)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
    let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
    ⟪-generatedAxSample i ω, stNext.y.1 - z.1.2⟫_ℝ +
        (setup.hatg stNext.y.1 - setup.hatg z.1.2) ≤
      (setup.tau i)⁻¹ * (setup.VY z.1.2 stPrev.y.1 - setup.VY z.1.2 stNext.y.1) -
        (1 / (2 * setup.tau i)) * ‖stNext.y.1 - stPrev.y.1‖ ^ 2 := by
  exact
    dual_prox_g_inner_le_bregman_drop_of_variational
      (V := setup.VY) (grad := gradient setup.nuY) (g := setup.hatg)
      (sample := generatedAxSample i ω)
      (yPrev := (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).y.1)
      (yNext := (setup.generatedAxExtensionProcess generatedAxSample i ω).y.1)
      (yTarget := z.1.2) (τ := setup.tau i)
      (setup.htau_pos i hi)
      (by
        simpa [add_assoc] using
          (generated_dual_prox_variational setup generatedAxSample i hi ω ⟨z.1.2, z.2.2⟩))
      (by
        have h :=
          lemma_3_5_center_residual_eq_inner setup.dgfY
            (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).y.1
            (setup.generatedAxExtensionProcess generatedAxSample i ω).y.1
            z.1.2
        simpa [VY, nuY, sub_eq_add_neg, add_assoc] using h.symm)
      (by
        exact
