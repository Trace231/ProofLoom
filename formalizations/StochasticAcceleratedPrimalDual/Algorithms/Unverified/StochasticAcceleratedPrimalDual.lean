noncomputable def deltaXHatf
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t) (ω : Ω) :
    SapdPrimalSpace n :=
  setup.generatedGQuery generatedAxSample t ht ω -
    setup.hatfGradient
      (setup.midpoint t ht (setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω)).1

/-- Exact split of SAPD's `Δ_{x,t}^{hat f}` into a centered oracle residual
and the deterministic gradient mismatch created by Algorithm 4.3's two primal
points.

This is the source-faithful replacement for treating
`G_hat(x_t)-∇hat_f(x_t^{md})` as a fixed-query oracle residual. Assumption 8
controls only the first summand; the second must be handled by the APD
smoothness/parameter algebra in the descent-envelope route. -/
theorem generatedDeltaXHatf_decomposition
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t) (ω : Ω) :
    setup.deltaXHatf generatedAxSample t ht ω =
      (setup.sampledG t (setup.generatedGQueryPoint generatedAxSample t ht ω) ω -
        setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample t ht ω).1) +
      (setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample t ht ω).1 -
        setup.hatfGradient
          (setup.midpoint t ht
            (setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω)).1) := by
  simp [deltaXHatf, generatedGQuery, generatedGQueryPoint]

/-- Corrected non-original mixed-center moment condition for the source-named
SAPD noise `Δ_{x,t}^{hat f}`.

Lan's displayed noise compares `G_hat(x_t)` with
`∇hat_f(x_t^{md})`, while Assumption 8 controls same-query residuals
`G_hat(x)-∇hat_f(x)`. The formal counterexample below shows that the latter
does not imply this finite-horizon mixed-center bound. This object is therefore
an explicit guarded condition for corrected/internal Theorem 4.8 routes, not a
new setup assumption and not a claim that the unqualified source theorem has
been proved. -/
def GeneratedDeltaXHatfMixedCenterMomentBound
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (T : ℕ) : Prop :=
  Integrable
      (fun ω =>
        Finset.sum (Finset.Icc 1 T) (fun i =>
          if hi : i ∈ Finset.Icc 1 T then
            ‖setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2
          else 0))
      setup.P ∧
    ∫ ω,
        Finset.sum (Finset.Icc 1 T) (fun i =>
          if hi : i ∈ Finset.Icc 1 T then
            ‖setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2
          else 0)
        ∂setup.P ≤
      Finset.sum (Finset.Icc 1 T) (fun _i => setup.sigmaXHatf ^ 2)

/-- Projection from the guarded mixed-center moment condition to the exact
finite-sum `Δ_{x,hat f}` integrability/bound needed by the generated descent
route. -/
theorem generatedDeltaXHatf_finset_sqDeviation_integrable_and_bound_of_mixed_center_moment
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (T : ℕ)
    (hmixed : setup.GeneratedDeltaXHatfMixedCenterMomentBound generatedAxSample T) :
    Integrable
        (fun ω =>
          Finset.sum (Finset.Icc 1 T) (fun i =>
            if hi : i ∈ Finset.Icc 1 T then
              ‖setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2
            else 0))
        setup.P ∧
      ∫ ω,
          Finset.sum (Finset.Icc 1 T) (fun i =>
            if hi : i ∈ Finset.Icc 1 T then
              ‖setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2
            else 0)
          ∂setup.P ≤
        Finset.sum (Finset.Icc 1 T) (fun _i => setup.sigmaXHatf ^ 2) := by
  exact hmixed

/-- Audit shape for the source proof's moment step for
`Δ_{x,t}^{hat f}`.

The PDF defines `Δ_{x,t}^{hat f} = G_hat(x_t) - ∇hat_f(x_t^{md})`, while
Assumption 8 bounds same-query residuals `G_hat(x) - ∇hat_f(x)`.  This private
predicate records the source-faithful split consequence: the same-query oracle
residual contributes `2 sigmaXHatf^2`, and the deterministic APD gradient
mismatch remains as an explicit finite-horizon budget.  It is not installed as a
setup field and deliberately does not collapse the mixed-center term into the
same-query variance bound. -/
private def GeneratedHatfGradientMismatchBudget
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (T : ℕ) (M : ℕ → ℝ) : Prop :=
  SOptLib.gradientMismatchFiniteMomentBudget setup.P (Finset.Icc 1 T)
    (fun i hi ω =>
      setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i
          (Finset.mem_Icc.mp hi).1 ω).1 -
        setup.hatfGradient
          (setup.midpoint i (Finset.mem_Icc.mp hi).1
            (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1)
    M

/-- Pointwise smooth-domain bound for the deterministic APD gradient mismatch.

The endpoints are exactly the two source-feasible primal points
`x_i` and `x_i^{md}`.  The estimate uses the explicitly supplied corrected
ambient gradient-Lipschitz predicate and the bounded Bregman-domain
squared-diameter consequence, not an oracle variance assumption. -/
private theorem generatedHatfGradientMismatch_sq_le_bounded_domain
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (hgrad_lip : setup.HatfGradientLipschitzOnX)
    (i : ℕ) (hi : 1 ≤ i) (ω : Ω) :
    ‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i hi ω).1 -
        setup.hatfGradient
          (setup.midpoint i hi
            (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1‖ ^ 2 ≤
      setup.Lhatf ^ 2 * (2 * setup.D_X ^ 2) := by
  let xq := setup.generatedGQueryPoint generatedAxSample i hi ω
  let xm := setup.midpoint i hi (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)
  have hLip :
      ‖setup.hatfGradient xq.1 - setup.hatfGradient xm.1‖ ≤
        setup.Lhatf * ‖xq.1 - xm.1‖ :=
    hgrad_lip xq.1 xq.2 xm.1 xm.2
  have hdist :
      ‖xq.1 - xm.1‖ ^ 2 ≤ 2 * setup.D_X ^ 2 :=
    setup.primal_sqdist_le_two_DX_sq xq.1 xm.1 xq.2 xm.2
  simpa [xq, xm] using
    sq_norm_sub_le_sq_mul_of_lipschitz_sqdist_le
      (grad := setup.hatfGradient) (x := xq.1) (y := xm.1)
      (L := setup.Lhatf) (R := 2 * setup.D_X ^ 2) hLip hdist

/-- The bounded-domain smooth-gradient bridge supplies the private mismatch
budget used by the generated Eq. (4.4.72) route.

This is a conditional supplier for corrected/internal routes that additionally
provide ambient gradient-Lipschitz regularity.  The unqualified source route
should instead use `GeneratedDeltaXHatfSourceMomentStep` with direct mismatch
integrability and bounds, because Eq. (4.4.2) alone is the source-facing
smoothness datum in this file. -/
private theorem GeneratedHatfGradientMismatchBudget_of_smooth_bounded_domain
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (T : ℕ)
    (hgrad_lip : setup.HatfGradientLipschitzOnX)
    (hgrad_mismatch_sq_aesm :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
        AEStronglyMeasurable
          (fun ω =>
            ‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i
                (Finset.mem_Icc.mp hi).1 ω).1 -
              setup.hatfGradient
                (setup.midpoint i (Finset.mem_Icc.mp hi).1
                  (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1‖ ^ 2)
          setup.P) :
    setup.GeneratedHatfGradientMismatchBudget generatedAxSample T
      (fun _ => setup.Lhatf ^ 2 * (2 * setup.D_X ^ 2)) := by
  haveI : IsProbabilityMeasure setup.P := setup.hP
  constructor
  · intro i hi
    let M : ℝ := setup.Lhatf ^ 2 * (2 * setup.D_X ^ 2)
    have hM_nonneg : 0 ≤ M := by
      dsimp [M]
      positivity
    have hbound :
        ∀ᵐ ω ∂setup.P,
          ‖(‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i
                (Finset.mem_Icc.mp hi).1 ω).1 -
              setup.hatfGradient
                (setup.midpoint i (Finset.mem_Icc.mp hi).1
                  (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1‖ ^ 2 : ℝ)‖
            ≤ ‖M‖ := by
      refine Filter.Eventually.of_forall fun ω => ?_
      have hle :=
        setup.generatedHatfGradientMismatch_sq_le_bounded_domain generatedAxSample
          hgrad_lip i (Finset.mem_Icc.mp hi).1 ω
      have hnonneg :
          0 ≤ ‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i
              (Finset.mem_Icc.mp hi).1 ω).1 -
            setup.hatfGradient
              (setup.midpoint i (Finset.mem_Icc.mp hi).1
                (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1‖ ^ 2 :=
        sq_nonneg _
      simpa [M, Real.norm_eq_abs, abs_of_nonneg hnonneg, abs_of_nonneg hM_nonneg] using hle
    exact Integrable.mono (integrable_const M) (hgrad_mismatch_sq_aesm i hi) hbound
  · intro i hi
    let M : ℝ := setup.Lhatf ^ 2 * (2 * setup.D_X ^ 2)
    have hM_nonneg : 0 ≤ M := by
      dsimp [M]
      positivity
    have hint :
        Integrable
          (fun ω =>
            ‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i
                (Finset.mem_Icc.mp hi).1 ω).1 -
              setup.hatfGradient
                (setup.midpoint i (Finset.mem_Icc.mp hi).1
                  (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1‖ ^ 2)
          setup.P := by
      have hbound :
          ∀ᵐ ω ∂setup.P,
            ‖(‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i
                  (Finset.mem_Icc.mp hi).1 ω).1 -
                setup.hatfGradient
                  (setup.midpoint i (Finset.mem_Icc.mp hi).1
                    (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1‖ ^ 2 : ℝ)‖
              ≤ ‖M‖ := by
        refine Filter.Eventually.of_forall fun ω => ?_
        have hle :=
          setup.generatedHatfGradientMismatch_sq_le_bounded_domain generatedAxSample
            hgrad_lip i (Finset.mem_Icc.mp hi).1 ω
        have hnonneg :
            0 ≤ ‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i
                (Finset.mem_Icc.mp hi).1 ω).1 -
              setup.hatfGradient
                (setup.midpoint i (Finset.mem_Icc.mp hi).1
                  (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1‖ ^ 2 :=
          sq_nonneg _
        simpa [M, Real.norm_eq_abs, abs_of_nonneg hnonneg, abs_of_nonneg hM_nonneg] using hle
      exact Integrable.mono (integrable_const M) (hgrad_mismatch_sq_aesm i hi) hbound
    have hconst : Integrable (fun _ : Ω => M) setup.P := integrable_const M
    have hle_ae :
        ∀ᵐ ω ∂setup.P,
          ‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i
              (Finset.mem_Icc.mp hi).1 ω).1 -
            setup.hatfGradient
              (setup.midpoint i (Finset.mem_Icc.mp hi).1
                (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1‖ ^ 2 ≤
            M := by
      refine Filter.Eventually.of_forall fun ω => ?_
      simpa [M] using
        setup.generatedHatfGradientMismatch_sq_le_bounded_domain generatedAxSample
          hgrad_lip i (Finset.mem_Icc.mp hi).1 ω
    have hle_int :
        ∫ ω,
            ‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i
                (Finset.mem_Icc.mp hi).1 ω).1 -
              setup.hatfGradient
                (setup.midpoint i (Finset.mem_Icc.mp hi).1
                  (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1‖ ^ 2
            ∂setup.P ≤
          ∫ _ω : Ω, M ∂setup.P :=
      integral_mono_ae hint hconst hle_ae
    haveI : IsProbabilityMeasure setup.P := setup.hP
    simpa [M, measure_univ] using hle_int

/-- Source-faithful finite-horizon moment step for `Δ_{x,t}^{hat f}`.

The same-query oracle part is discharged by Assumption 8 and prefix
measurability.  The deterministic APD estimate is factored as
`GeneratedHatfGradientMismatchBudget`, a private theorem obligation rather than
a setup assumption or a silent use of the rejected mixed-center variance bound. -/
private def GeneratedDeltaXHatfSourceMomentStep
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (T : ℕ) : Prop :=
  SOptLib.finiteResidualMomentBudget setup.P (Finset.Icc 1 T)
    (fun i hi ω =>
      setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω)
    (setup.GeneratedHatfGradientMismatchBudget generatedAxSample T)
    (setup.sigmaXHatf ^ 2)

/-- Per-index facts carried by the source-faithful `Delta_{x,hat f}` moment
step.

This projection is the FILL-facing supplier for Eq. (4.4.73)'s square-noise
adapter: the old predicate exposed only a finite-sum bound, while the compiled
canonical-`U_t` mean route needs per-index integrability and bounds before
combining `Delta_{x,hat f}` with the `Delta_{x,A}` component. -/
private theorem GeneratedDeltaXHatfSourceMomentStep.per_index_integrable_and_bound
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (T : ℕ)
    (hsource : GeneratedDeltaXHatfSourceMomentStep (setup := setup) generatedAxSample T) :
    ∃ M : ℕ → ℝ,
      GeneratedHatfGradientMismatchBudget (setup := setup) generatedAxSample T M ∧
      (∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
        Integrable
          (fun ω =>
            ‖setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2)
          setup.P) ∧
      (∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
        ∫ ω,
            ‖setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2
            ∂setup.P ≤
          2 * setup.sigmaXHatf ^ 2 + 2 * M i) := by
  rcases hsource with ⟨M, hM, _hvec, _hsq_aesm, hint, hbound, _hsum_int, _hsum_bound⟩
  exact ⟨M, hM, hint, hbound⟩

/-- Vector measurability carried by the source-faithful
`Delta_{x,hat f}` moment step.

Eq. (4.4.73)'s cross term is an inner product of vector noises, so the
canonical mean-bound route needs the vector process itself, not only its
squared norm. -/
private theorem GeneratedDeltaXHatfSourceMomentStep.per_index_aestronglyMeasurable
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (T : ℕ)
    (hsource : GeneratedDeltaXHatfSourceMomentStep (setup := setup) generatedAxSample T) :
    ∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
      AEStronglyMeasurable
        (fun ω =>
          setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω)
        setup.P := by
  rcases hsource with ⟨_M, _hM, hvec, _hsq_aesm, _hint, _hbound, _hsum_int, _hsum_bound⟩
  exact hvec

/-- Same-query Assumption 8 control does not imply the mixed-center
`Delta_{x,t}^{hat f}` moment bound used by the displayed SAPD proof.

The deterministic zero-noise model `oracle = grad = id` has zero residual
`oracle z - grad z` at every queried point, but the mixed-center residual
`oracle x - grad xmd` is nonzero when `x ≠ xmd`.  This is the formal audit
witness for keeping `GeneratedDeltaXHatfSourceMomentStep` as an explicit
source-boundary gap instead of deriving it from same-query variance. -/
private theorem same_query_variance_bound_does_not_imply_mixed_center_bound :
    ¬ (∀ (oracle grad : ℝ → ℝ) (σ x xmd : ℝ),
        0 ≤ σ →
        (∀ z : ℝ, (oracle z - grad z)^2 ≤ σ^2) →
        (oracle x - grad xmd)^2 ≤ σ^2) := by
  exact not_same_query_variance_bound_implies_mixed_center_bound

/-- Pointwise Young bound for the SAPD `Δ_{x,t}^{hat f}` split.

The right-hand side deliberately keeps the gradient-mismatch square visible:
collapsing it into `sigmaXHatf` would be the wrong oracle model for Lan's
generated APD recursion. -/
theorem generatedDeltaXHatf_sqDeviation_le_residual_add_gradient_mismatch
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t) (ω : Ω) :
    ‖setup.deltaXHatf generatedAxSample t ht ω‖ ^ 2 ≤
      2 *
          ‖setup.sampledG t (setup.generatedGQueryPoint generatedAxSample t ht ω) ω -
            setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample t ht ω).1‖ ^ 2 +
        2 *
          ‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample t ht ω).1 -
            setup.hatfGradient
              (setup.midpoint t ht
                (setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω)).1‖ ^ 2 := by
  exact
    mixedCenterResidual_sq_norm_le_residual_add_mismatch
      (hdelta := setup.generatedDeltaXHatf_decomposition generatedAxSample t ht ω)

/-- One-step square-integrability and moment bridge for SAPD
`Δ_{x,t}^{hat f}`.

This reduces the source-hard term to three smaller obligations: measurability
of the paper gradient on feasible queries, fresh-sample independence of the
generated `G_hat(x_t)` query, and a deterministic/integrable bound for the APD
gradient mismatch `∇hat_f(x_t)-∇hat_f(x_t^{md})`. -/
theorem generatedDeltaXHatf_sqDeviation_integrable_and_bound_of_query_independence
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i) (M : ℝ)
    (hgrad_meas :
      Measurable (fun x : {x : SapdPrimalSpace n // x ∈ setup.X} =>
        setup.hatfGradient x.1))
    (hquery : Measurable (fun ω => setup.generatedGQueryPoint generatedAxSample i hi ω))
    (hindep :
      IndepFun (fun ω => setup.generatedGQueryPoint generatedAxSample i hi ω)
        (setup.ξ i) setup.P)
    (hdelta_aesm :
      AEStronglyMeasurable
        (fun ω => ‖setup.deltaXHatf generatedAxSample i hi ω‖ ^ 2) setup.P)
    (hgrad_mismatch_int :
      Integrable
        (fun ω =>
          ‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i hi ω).1 -
            setup.hatfGradient
              (setup.midpoint i hi
                (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1‖ ^ 2)
        setup.P)
    (hgrad_mismatch_bound :
      ∫ ω,
          ‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i hi ω).1 -
            setup.hatfGradient
              (setup.midpoint i hi
                (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1‖ ^ 2
          ∂setup.P ≤ M) :
    Integrable
        (fun ω => ‖setup.deltaXHatf generatedAxSample i hi ω‖ ^ 2)
        setup.P ∧
      ∫ ω, ‖setup.deltaXHatf generatedAxSample i hi ω‖ ^ 2 ∂setup.P ≤
        2 * setup.sigmaXHatf ^ 2 + 2 * M := by
  exact
    mixed_center_residual_sq_deviation_integrable_and_bound
      (P := setup.P)
      (delta := fun ω => setup.deltaXHatf generatedAxSample i hi ω)
      (residual := fun ω =>
        setup.sampledG i (setup.generatedGQueryPoint generatedAxSample i hi ω) ω -
          setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i hi ω).1)
      (mismatch := fun ω =>
        setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i hi ω).1 -
          setup.hatfGradient
            (setup.midpoint i hi
              (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1)
      (sigma2 := setup.sigmaXHatf ^ 2) (M := M)
      hdelta_aesm
      (by
        filter_upwards with ω
        exact
          setup.generatedDeltaXHatf_sqDeviation_le_residual_add_gradient_mismatch
            generatedAxSample i hi ω)
      (setup.sampledG_randomQuery_sqDeviation_integrable_and_bound
        (query := fun ω => setup.generatedGQueryPoint generatedAxSample i hi ω)
        i hi hgrad_meas hquery hindep)
      ⟨hgrad_mismatch_int, hgrad_mismatch_bound⟩

/-- One-step `Delta_{x,i}^{hat f}` bridge with fresh-sample independence
derived from sample-prefix measurability of the generated primal query.

This is the FILL-facing form for the source descent route: downstream work
should prove prefix measurability of `generatedGQueryPoint`, not assume
independence from `xi_i` directly. The gradient-mismatch term remains explicit
because Lan's source noise compares `G_hat(x_i)` with
`grad hat_f(x_i^{md})`, not with `grad hat_f(x_i)`. -/
theorem generatedDeltaXHatf_sqDeviation_integrable_and_bound_of_prefix_query
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i) (M : ℝ)
    (hgrad_meas :
      Measurable (fun x : {x : SapdPrimalSpace n // x ∈ setup.X} =>
        setup.hatfGradient x.1))
    (hquery_prefix :
      Measurable[(setup.filtration).seq i]
        (fun ω => setup.generatedGQueryPoint generatedAxSample i hi ω))
    (hdelta_aesm :
