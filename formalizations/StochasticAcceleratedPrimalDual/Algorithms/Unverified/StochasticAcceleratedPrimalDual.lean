private theorem real_inner_add_add_left
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (u v w d : E) :
    ⟪u + v + w, d⟫_ℝ = ⟪u, d⟫_ℝ + ⟪v, d⟫_ℝ + ⟪w, d⟫_ℝ := by
  rw [inner_add_left, inner_add_left]

