/-- Paper output `\bar z_{t+1} = (\bar x_{t+1}, \bar y_{t+1})` from
Algorithm 4.3.

Chosen alignment: considered `SOptLib.weightedOutputAverage`; Algorithm 4.3
uses the running aggregate recurrences Eq. (4.4.18)--(4.4.19), so the output is
projected from the canonical displayed-extension state rather than rebuilt as
an unrelated finite-window average or carried in a run witness. -/
noncomputable def displayedRunExtensionOutput
    (axTildeCall : ℕ → Ω → SapdDualSpace m) (t : ℕ) (_ht : 1 ≤ t) (ω : Ω) :
    {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
  ⟨(((setup.displayedAxExtensionState axTildeCall (t + 1) ω).xBar.1,
      (setup.displayedAxExtensionState axTildeCall (t + 1) ω).yBar.1)),
    ⟨(setup.displayedAxExtensionState axTildeCall (t + 1) ω).xBar.2,
      (setup.displayedAxExtensionState axTildeCall (t + 1) ω).yBar.2⟩⟩

/-- Paper iterate pair `z_i = (x_i,y_i)` extracted from an Algorithm 4.3 run. -/
noncomputable def displayedRunExtensionZ
    (axTildeCall : ℕ → Ω → SapdDualSpace m) (i : ℕ) (ω : Ω) :
    {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
  ⟨(((setup.displayedAxExtensionState axTildeCall i ω).x.1,
      (setup.displayedAxExtensionState axTildeCall i ω).y.1)),
    ⟨(setup.displayedAxExtensionState axTildeCall i ω).x.2,
      (setup.displayedAxExtensionState axTildeCall i ω).y.2⟩⟩

/-- Source `B_t(z,z_[t])` term along an Algorithm 4.3 run. -/
noncomputable def displayedRunExtensionBTerm
    (axTildeCall : ℕ → Ω → SapdDualSpace m)
    (t : ℕ) (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) (ω : Ω) : ℝ :=
  Finset.sum (Finset.Icc 1 t) (fun i =>
    setup.gamma i / setup.eta i *
        (setup.VX z.1.1 (setup.displayedAxExtensionState axTildeCall i ω).x.1 -
          setup.VX z.1.1 (setup.displayedAxExtensionState axTildeCall (i + 1) ω).x.1) +
      setup.gamma i / setup.tau i *
        (setup.VY z.1.2 (setup.displayedAxExtensionState axTildeCall i ω).y.1 -
          setup.VY z.1.2 (setup.displayedAxExtensionState axTildeCall (i + 1) ω).y.1))

/-- Source stochastic gradient call `\hat G(x_i)` along Algorithm 4.3. -/
noncomputable def displayedRunExtensionGQuery
    (axTildeCall : ℕ → Ω → SapdDualSpace m) (i : ℕ) (_hi : 1 ≤ i) (ω : Ω) :
    SapdPrimalSpace n :=
  setup.sampledG i (setup.displayedAxExtensionState axTildeCall i ω).x ω

/-- Source stochastic adjoint call `\hat A_y(y_{i+1})` along Algorithm 4.3. -/
noncomputable def displayedRunExtensionAyQuery
    (axTildeCall : ℕ → Ω → SapdDualSpace m) (i : ℕ) (_hi : 1 ≤ i) (ω : Ω) :
    SapdPrimalSpace n :=
  setup.sampledAy i (setup.displayedAxExtensionState axTildeCall (i + 1) ω).y ω

/-- Source noise `Δ_{x,i}^{\hat f}` along Algorithm 4.3. -/
noncomputable def displayedRunExtensionDeltaXHatf
    (axTildeCall : ℕ → Ω → SapdDualSpace m) (i : ℕ) (hi : 1 ≤ i) (ω : Ω) :
    SapdPrimalSpace n :=
  setup.displayedRunExtensionGQuery axTildeCall i hi ω -
    setup.hatfGradient
      (setup.midpoint i hi (setup.displayedAxExtensionState axTildeCall i ω)).1

/-- Source noise `Δ_{x,A}^i` along Algorithm 4.3. -/
noncomputable def displayedRunExtensionDeltaXA
    (axTildeCall : ℕ → Ω → SapdDualSpace m) (i : ℕ) (hi : 1 ≤ i) (ω : Ω) :
    SapdPrimalSpace n :=
  setup.displayedRunExtensionAyQuery axTildeCall i hi ω -
    setup.ATranspose (setup.displayedAxExtensionState axTildeCall (i + 1) ω).y.1

/-- Source noise `Δ_i^y = -\hat A_x(\tilde x_i) + A\tilde x_i` along
Algorithm 4.3.

The `A\tilde x_i` target is an ambient expression. Any attempt to identify
`\hat A_x(\tilde x_i)` with the fixed-domain oracle kernel remains
extension-only because the source does not state `\tilde x_i ∈ X`. -/
noncomputable def displayedRunExtensionDeltaY
    (axTildeCall : ℕ → Ω → SapdDualSpace m) (i : ℕ) (_hi : 1 ≤ i) (ω : Ω) :
    SapdDualSpace m :=
  -axTildeCall i ω + setup.A (setup.displayedAxExtensionState axTildeCall i ω).xTilde

/-- Combined source primal noise `Δ_i^x` along Algorithm 4.3. -/
noncomputable def displayedRunExtensionDeltaX
    (axTildeCall : ℕ → Ω → SapdDualSpace m) (i : ℕ) (hi : 1 ≤ i) (ω : Ω) :
    SapdPrimalSpace n :=
  setup.displayedRunExtensionDeltaXHatf axTildeCall i hi ω +
    setup.displayedRunExtensionDeltaXA axTildeCall i hi ω

/-- Source noise pair `Δ_i = (Δ_i^x, Δ_i^y)` along Algorithm 4.3. -/
noncomputable def displayedRunExtensionDelta
    (axTildeCall : ℕ → Ω → SapdDualSpace m) (i : ℕ) (hi : 1 ≤ i) (ω : Ω) :
    SapdPrimalSpace n × SapdDualSpace m :=
  SOptLib.twoBlockOracleResidualPair
    (setup.displayedAxExtensionState axTildeCall)
    (fun state => state.x)
    (fun state => state.y)
    (fun state => state.xTilde)
    setup.sampledG
    (fun _ _ =>
      setup.hatfGradient
        (setup.midpoint i hi (setup.displayedAxExtensionState axTildeCall i ω)).1)
    setup.sampledAy
    (fun y => setup.ATranspose y.1)
    axTildeCall
    setup.A
    i ω

/-- Source `Λ_i(z)` from Eq. (4.4.60), extracted from an Algorithm 4.3 run.

No SOptLib match: searched stochastic-recursion residuals and oracle residual
kernels; available declarations do not encode Lan's SAPD coefficients, signs,
and generated APD source-noise decomposition. -/
noncomputable def displayedRunExtensionLambdaTerm
    (axTildeCall : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i) (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (ω : Ω) : ℝ :=
  -((1 - setup.q) * setup.gamma i / (2 * setup.eta i)) *
      ‖(setup.displayedAxExtensionState axTildeCall (i + 1) ω).x.1 -
        (setup.displayedAxExtensionState axTildeCall i ω).x.1‖ ^ 2 -
    ((1 - setup.p) * setup.gamma i / (2 * setup.tau i)) *
      ‖(setup.displayedAxExtensionState axTildeCall (i + 1) ω).y.1 -
        (setup.displayedAxExtensionState axTildeCall i ω).y.1‖ ^ 2 -
    setup.gamma i *
      (⟪(setup.displayedRunExtensionDelta axTildeCall i hi ω).1,
          (setup.displayedAxExtensionState axTildeCall (i + 1) ω).x.1 - z.1.1⟫_ℝ +
        ⟪(setup.displayedRunExtensionDelta axTildeCall i hi ω).2,
          (setup.displayedAxExtensionState axTildeCall (i + 1) ω).y.1 - z.1.2⟫_ℝ)

