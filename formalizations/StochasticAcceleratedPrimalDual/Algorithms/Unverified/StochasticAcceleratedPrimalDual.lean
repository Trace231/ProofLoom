private theorem generated_q_bar_telescope
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (t : ℕ) (ht : 1 ≤ t) (ω : Ω)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    let bar : ℕ → {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
      fun k =>
        ⟨((setup.generatedAxExtensionProcess generatedAxSample k ω).xBar.1,
            (setup.generatedAxExtensionProcess generatedAxSample k ω).yBar.1),
          ⟨(setup.generatedAxExtensionProcess generatedAxSample k ω).xBar.2,
            (setup.generatedAxExtensionProcess generatedAxSample k ω).yBar.2⟩⟩
    Finset.sum (Finset.Icc 1 t) (fun i =>
        setup.beta i * setup.gamma i * setup.Q (bar i) z -
          (setup.beta i - 1) * setup.gamma i * setup.Q (bar (i - 1)) z) =
      setup.beta t * setup.gamma t * setup.Q (bar t) z := by
  classical
  let bar : ℕ → {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
    fun k =>
      ⟨((setup.generatedAxExtensionProcess generatedAxSample k ω).xBar.1,
          (setup.generatedAxExtensionProcess generatedAxSample k ω).yBar.1),
        ⟨(setup.generatedAxExtensionProcess generatedAxSample k ω).xBar.2,
          (setup.generatedAxExtensionProcess generatedAxSample k ω).yBar.2⟩⟩
  let W : ℕ → ℝ := fun i =>
    setup.beta i * setup.gamma i * setup.Q (bar i) z
  let stepTerm : ℕ → ℝ := fun i =>
    setup.beta i * setup.gamma i * setup.Q (bar i) z -
      (setup.beta i - 1) * setup.gamma i * setup.Q (bar (i - 1)) z
  have hbase_step : stepTerm 1 = W 1 := by
    dsimp [stepTerm, W]
    simp [setup.hbeta_one]
  have hstep_succ : ∀ i, 2 ≤ i → stepTerm i = W i - W (i - 1) := by
    intro i hi
    have hshift := beta_gamma_shift_identity setup i hi
    dsimp [stepTerm, W]
    rw [hshift]
  change Finset.sum (Finset.Icc 1 t) stepTerm = W t
  exact sum_Icc_shifted_sub_telescope_from_one W stepTerm t ht hbase_step hstep_succ

