    setup generatedAxSample i hi ω
  have hynoise := generated_dual_noise_decomposition
    setup generatedAxSample i hi ω
  have hxt := generated_xtilde_target_gamma_decomposition
    setup generatedAxSample i hi ω (stNext.y.1 - z.1.2)
  have hgap :
      setup.gamma i *
