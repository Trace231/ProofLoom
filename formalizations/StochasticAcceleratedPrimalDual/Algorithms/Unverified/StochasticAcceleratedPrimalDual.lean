/-! ### Lemma 3.5 reconstruction audit

The declarations in this subsection are private protocol artifacts for the
Phase 2B reconstruction of Lemma 3.5. They are not paper-facing assumptions.
-/

/-- The retired pre-reconstruction Lemma 3.5 head, recorded only to formalize
why that theorem head could not remain as the paper-facing statement. This is
the real-line `Set.univ` instance used by the counterexample below. -/
private def lemma_3_5_retired_old_head_contract
    (ν : SapdDistanceGeneratingFunction ℝ Set.univ) : Prop :=
  ∀ {pFun : ℝ → ℝ}
    {xHat xTilde yTilde : ℝ} {mu1 mu2 : ℝ}
    (_hArgmin :
      xHat ∈ Set.univ ∧
        IsMinOn
          (fun u => pFun u + mu1 * ν.bregman u xTilde + mu2 * ν.bregman u yTilde)
          Set.univ xHat)
    (u : ℝ) (_hu : u ∈ Set.univ),
    pFun xHat + mu1 * ν.bregman xHat xTilde + mu2 * ν.bregman xHat yTilde ≤
      pFun u + mu1 * ν.bregman u xTilde + mu2 * ν.bregman u yTilde -
        (mu1 + mu2) * ν.bregman u xHat

/-- Formal counterexample protocol for the retired head.

For any modulus-one DGF on `Set.univ : Set ℝ`, the nonconvex
`p(u) = -u^2 / 4` makes `0` minimize the retired objective with
`xHat = xTilde = yTilde = 0`, `mu1 = 1`, `mu2 = 0`; the retired conclusion at
`u = 1` reduces to `0 ≤ -1/4`. -/
private theorem lemma_3_5_retired_old_head_counterexample
    (ν : SapdDistanceGeneratingFunction ℝ Set.univ) :
    ¬ lemma_3_5_retired_old_head_contract ν := by
  simpa [lemma_3_5_retired_old_head_contract] using
    (SOptLib.two_center_bregman_three_point_requires_convex_counterexample
      (V := fun z c : ℝ => ν.bregman z c)
      (by simp [SapdDistanceGeneratingFunction.bregman_def])
      (by
        intro z
        have hb := ν.bregman_lower_bound z (0 : ℝ) (Set.mem_univ _) (Set.mem_univ _)
        have hnorm : ‖z - (0 : ℝ)‖ ^ 2 = z ^ 2 := by
          simp [Real.norm_eq_abs, sq_abs]
        simpa [hnorm] using hb))

/-- Final scalar/Bregman rearrangement for the corrected Lemma 3.5.

This isolates the last algebraic leaf: once FILL derives the residual
three-point inequality from convex optimality, no further source-facing
hypotheses or theorem-head changes are needed. -/
private theorem lemma_3_5_of_bregman_residual
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {X : Set E} {pFun : E → ℝ}
    (ν : SapdDistanceGeneratingFunction E X)
    {xHat xTilde yTilde u : E} {mu1 mu2 : ℝ}
    (hres :
      0 ≤ pFun u - pFun xHat +
        mu1 * (ν.bregman u xTilde - ν.bregman xHat xTilde - ν.bregman u xHat) +
        mu2 * (ν.bregman u yTilde - ν.bregman xHat yTilde - ν.bregman u xHat)) :
    pFun xHat + mu1 * ν.bregman xHat xTilde + mu2 * ν.bregman xHat yTilde ≤
      pFun u + mu1 * ν.bregman u xTilde + mu2 * ν.bregman u yTilde -
        (mu1 + mu2) * ν.bregman u xHat := by
  exact two_center_residual_nonneg_to_three_point_ineq
    (pFun u) (pFun xHat) (ν.bregman u xTilde) (ν.bregman xHat xTilde)
    (ν.bregman u yTilde) (ν.bregman xHat yTilde) (ν.bregman u xHat)
    mu1 mu2 hres

/-- DGF three-point identity in this file's target-first Bregman convention.

Because `ν.bregman x u` unfolds to the paper value `V(u, x)`, the source
identity `V(x, y) = V(x, z) + <∇ν(z)-∇ν(x), y-z> + V(z, y)` is encoded as
`ν.bregman y x = ...`. This is the executable orientation FILL should use for
Lemma 3.5. -/
private theorem lemma_3_5_bregman_three_point_identity
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {X : Set E}
    (ν : SapdDistanceGeneratingFunction E X) (x z y : E) :
    ν.bregman y x =
      ν.bregman z x + ⟪gradient ν.potential z - gradient ν.potential x, y - z⟫_ℝ +
        ν.bregman y z := by
  exact SOptLib.DistanceGeneratingFunctionOn.bregman_three_point_identity ν x z y

/-- The single-center residual extracted from the target-first three-point
