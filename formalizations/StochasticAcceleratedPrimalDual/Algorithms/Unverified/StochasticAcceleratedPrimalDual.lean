private theorem deterministic_apd_hatf_aggregate_bound
    (run : setup.Algorithm42Run)
    (t : ℕ) (ht : 1 ≤ t) (hβge : 1 ≤ setup.beta t)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    setup.beta t * setup.hatf (run.state (t + 1)).xBar.1 -
        (setup.beta t - 1) * setup.hatf (run.state t).xBar.1 -
        setup.hatf z.1.1 ≤
      ⟪setup.hatfGradient (setup.midpoint t ht (run.state t)).1,
          (run.state (t + 1)).x.1 - z.1.1⟫_ℝ +
        (setup.Lhatf / (2 * setup.beta t)) *
          ‖(run.state (t + 1)).x.1 - (run.state t).x.1‖ ^ 2 := by
  exact SOptLib.accelerated_primal_dual_smooth_aggregate_bound_of_run
    (grad := setup.hatfGradient)
    (run := run.toDeterministicAcceleratedPrimalDualProxRun.toDeterministicAcceleratedAggregateRun)
    (xBar := fun st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y => st.xBar.1)
    (x := fun st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y => st.x.1)
    (midpoint := fun t ht st => (setup.midpoint t ht st).1)
    (β := setup.beta) (L := setup.Lhatf)
    (fun t ht prev next hstep => by
      have hstep' := congrArg Subtype.val hstep
      simpa [averageX, averageXValue] using hstep')
    setup.hatf.convexOn
    t ht (by rfl) hβge z.1.1
    (setup.midpoint t ht (run.state t)).2
    (run.state t).xBar.2
    z.2.1
    (by
      simpa [InnerProductSpace.toDual_apply_eq_toDualMap_apply,
        InnerProductSpace.toContinuousLinearMap_toDualMap] using
        (setup.hatf_hasGradientAt_on_X
          (setup.midpoint t ht (run.state t)).1
          (setup.midpoint t ht (run.state t)).2).hasFDerivAt)
