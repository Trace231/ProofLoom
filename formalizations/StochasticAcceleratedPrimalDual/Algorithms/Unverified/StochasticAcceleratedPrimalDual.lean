        (fun ω => ‖setup.deltaXHatf generatedAxSample i hi ω‖ ^ 2) setup.P)
    (hgrad_mismatch_int :
      Integrable
        (fun ω =>
          ‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i hi ω).1 -
            setup.hatfGradient
              (setup.midpoint i hi
                (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1‖ ^ 2)
        setup.P)
    (hgrad_mismatch_bound :
      ∫ ω,
          ‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i hi ω).1 -
            setup.hatfGradient
              (setup.midpoint i hi
                (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1‖ ^ 2
          ∂setup.P ≤ M) :
    Integrable
        (fun ω => ‖setup.deltaXHatf generatedAxSample i hi ω‖ ^ 2)
        setup.P ∧
      ∫ ω, ‖setup.deltaXHatf generatedAxSample i hi ω‖ ^ 2 ∂setup.P ≤
        2 * setup.sigmaXHatf ^ 2 + 2 * M := by
  exact
    mixedCenterResidual_sqDeviation_integrable_and_bound_of_prefix_query
      (P := setup.P)
      (ξ := setup.ξ)
      (hξ_measurable := setup.hξ_measurable)
      (hξ_iIndep := setup.hξ_indep)
      (i := i)
      (query := fun ω => setup.generatedGQueryPoint generatedAxSample i hi ω)
      (delta := fun ω => setup.deltaXHatf generatedAxSample i hi ω)
      (residual := fun ω =>
        setup.sampledG i (setup.generatedGQueryPoint generatedAxSample i hi ω) ω -
          setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i hi ω).1)
      (mismatch := fun ω =>
        setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i hi ω).1 -
          setup.hatfGradient
            (setup.midpoint i hi
              (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1)
      (sigma2 := setup.sigmaXHatf ^ 2)
      (M := M)
      hquery_prefix
      hdelta_aesm
      (Filter.Eventually.of_forall fun ω =>
        setup.generatedDeltaXHatf_sqDeviation_le_residual_add_gradient_mismatch
          generatedAxSample i hi ω)
      (fun hquery hindep =>
        setup.sampledG_randomQuery_sqDeviation_integrable_and_bound
          (query := fun ω => setup.generatedGQueryPoint generatedAxSample i hi ω)
          i hi hgrad_meas hquery hindep)
      ⟨hgrad_mismatch_int, hgrad_mismatch_bound⟩

/-- Finite-sum form of the SAPD `Δ_{x,i}^{hat f}` bridge.

This is the generated-extension ingredient needed by the Lemma 4.10 /
Theorem 4.8 descent-envelope route. It does not hide the non-oracle part of
`Δ_{x,i}^{hat f}`: downstream proofs must provide the finite family of
gradient-mismatch integrability and bounds. -/
theorem generatedDeltaXHatf_finset_sqDeviation_integrable_and_bound_of_query_independence
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (T : ℕ) (M : ℕ → ℝ)
    (hgrad_meas :
      Measurable (fun x : {x : SapdPrimalSpace n // x ∈ setup.X} =>
        setup.hatfGradient x.1))
    (hquery :
