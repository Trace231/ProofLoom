    setup.sampledAx
    setup.A

/-- Corrected fixed-domain `B_t(z,z_[t])` term for Lemma 4.9.

This specializes the source `BTerm` to the completed fixed-domain partial
Algorithm 4.3 sequence and therefore carries the same corrected, non-original
boundary as `Algorithm43FixedDomainComplete`. -/
noncomputable def algorithm43FixedDomainBTermOfComplete
    (t : ℕ) (hcomplete : setup.Algorithm43FixedDomainComplete (t + 1))
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) (ω : Ω) : ℝ :=
  Finset.sum (Finset.Icc 1 t) (fun i =>
    let zSeq := setup.algorithm43FixedDomainZSeqOfComplete (t + 1) hcomplete
    setup.gamma i / setup.eta i *
        (setup.VX z.1.1 (zSeq i ω).1.1 - setup.VX z.1.1 (zSeq (i + 1) ω).1.1) +
      setup.gamma i / setup.tau i *
        (setup.VY z.1.2 (zSeq i ω).1.2 - setup.VY z.1.2 (zSeq (i + 1) ω).1.2))

/-- Corrected fixed-domain `Λ_i(z)` term for Lemma 4.9.

The noise sequence is generated from the completed fixed-domain partial process;
no arbitrary generated `A_hat_x(\tilde x_t)` stream is exposed. -/
noncomputable def algorithm43FixedDomainLambdaTermOfComplete
    (t : ℕ) (hcomplete : setup.Algorithm43FixedDomainComplete (t + 1))
    (i : ℕ) (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (ω : Ω) : ℝ :=
  let zSeq := fun j => setup.algorithm43FixedDomainZSeqOfComplete (t + 1) hcomplete j ω;
  let delta := fun j => setup.algorithm43FixedDomainDeltaOfComplete (t + 1) hcomplete j ω;
  -((1 - setup.q) * setup.gamma i / (2 * setup.eta i)) *
      ‖(zSeq (i + 1)).1.1 - (zSeq i).1.1‖ ^ 2 -
    ((1 - setup.p) * setup.gamma i / (2 * setup.tau i)) *
      ‖(zSeq (i + 1)).1.2 - (zSeq i).1.2‖ ^ 2 -
    setup.gamma i *
      (⟪(delta i).1, (zSeq (i + 1)).1.1 - z.1.1⟫_ℝ +
        ⟪(delta i).2, (zSeq (i + 1)).1.2 - z.1.2⟫_ℝ)

/-- Deterministic dual prox objective from Algorithm 4.2 Eq. (4.4.15).

No SOptLib match: checked the prox-step candidates named in the pre-search
