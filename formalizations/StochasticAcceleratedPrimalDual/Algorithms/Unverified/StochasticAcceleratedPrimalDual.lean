    ∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
      AEStronglyMeasurable
        (fun ω =>
          ‖setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2)
        setup.P := by
  intro i hi
