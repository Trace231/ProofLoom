/-- Lower-semicontinuity of one feasible comparison section of Lan's
`Q(\tilde z,z)`.

This is the source-local analytic leaf behind gap measurability after
`gap` was changed to the indexed supremum form.  For fixed feasible `z`,
the section in `\tilde z` is a sum of continuous affine/`\hat f` terms and the
lower-semicontinuous `\hat g(\tilde y)` term on `Y`. -/
theorem Q_left_lowerSemicontinuous
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    LowerSemicontinuous
      (fun zTilde : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} =>
        setup.Q zTilde z) := by
  let qAmb : SapdPrimalSpace n × SapdDualSpace m → ℝ :=
    fun zTilde => SOptLib.saddleGapComparison setup.hatf setup.A setup.hatg zTilde z.1
  have hhatf_cont : ContinuousOn setup.hatf setup.X := by
    intro x hx
    exact (setup.hatf_differentiableAt_on_X x hx).continuousAt.continuousWithinAt
  have hhatf_lsc : LowerSemicontinuousOn setup.hatf setup.X :=
    hhatf_cont.lowerSemicontinuousOn
  have hhatf_lsc_fst :
      LowerSemicontinuousOn
        (fun z : SapdPrimalSpace n × SapdDualSpace m => setup.hatf z.1) setup.Z := by
    have hmaps : Set.MapsTo (fun z : SapdPrimalSpace n × SapdDualSpace m => z.1)
        setup.Z setup.X := by
      intro z hz
      exact hz.1
    simpa [Function.comp_def] using hhatf_lsc.comp continuous_fst.continuousOn hmaps
  have hhatg_lsc_snd :
      LowerSemicontinuousOn
        (fun z : SapdPrimalSpace n × SapdDualSpace m => setup.hatg z.2) setup.Z := by
    have hmaps : Set.MapsTo (fun z : SapdPrimalSpace n × SapdDualSpace m => z.2)
        setup.Z setup.Y := by
      intro z hz
      exact hz.2
    simpa [Function.comp_def] using setup.hhatg_lsc.comp continuous_snd.continuousOn hmaps
  have haff_cont : ContinuousOn
      (fun w : SapdPrimalSpace n × SapdDualSpace m =>
        ⟪setup.A w.1, z.1.2⟫_ℝ - setup.hatg z.1.2 - setup.hatf z.1.1 -
          ⟪setup.A z.1.1, w.2⟫_ℝ) setup.Z := by
    exact ((((setup.A.continuous.comp continuous_fst).inner continuous_const).sub
      continuous_const).sub continuous_const).sub
        (continuous_const.inner continuous_snd) |>.continuousOn
  have hq_lsc : LowerSemicontinuousOn qAmb setup.Z := by
    have hsum := LowerSemicontinuousOn.add_continuousOn_add
      hhatf_lsc_fst haff_cont hhatg_lsc_snd
    simpa [qAmb, SOptLib.saddleGapComparison, sub_eq_add_neg, add_assoc, add_left_comm,
      add_comm] using hsum
  have hrestrict : LowerSemicontinuous (setup.Z.restrict qAmb) :=
    (lowerSemicontinuous_restrict_iff (s := setup.Z) (f := qAmb)).2 hq_lsc
  simpa only [Set.restrict, qAmb, Q] using hrestrict

/-- Lower-semicontinuity of the value-level saddle gap.

The indexed-supremum realization of `gap` reduces this to Mathlib's
`lowerSemicontinuous_iSup` applied to the section theorem above. -/
theorem gap_lowerSemicontinuous :
    LowerSemicontinuous setup.gap := by
  simpa [gap, SOptLib.saddleGap] using
    lowerSemicontinuous_ciSup
      (fun zTilde => by simpa [gapValueSet] using setup.gapValueSet_bddAbove zTilde)
      (fun z => setup.Q_left_lowerSemicontinuous z)

/-- Value-level measurability of the saddle gap `g(\tilde z)` from Eq. (4.4.21).

This is the source-derived supplier that replaces downstream `hgap :
Measurable setup.gap` premises.  The intended route is the compact value
function theorem for a lower-semicontinuous/upper-semicontinuous saddle
comparison over the compact feasible product `Z`: for each feasible comparison
point, `Q · z` is lower semicontinuous in `\tilde z`, and `gap` is the
finite supremum/maximum value over `Z`.  This is not a setup assumption and not
an event-theorem premise.

Phase-2B audit: downstream helpers such as
`gap_algorithm43SourceBoundaryOutput_measurable_of_dual_lsc_selector` are only
composition consumers.  They must not be counted as terminal regularity
evidence while this compact value-function measurability theorem remains open. -/
theorem gap_measurable_of_compact_value_function :
    Measurable setup.gap := by
  exact setup.gap_lowerSemicontinuous.measurable

/-- Convex functions are uniformly bounded above on compact subsets of the
ordinary interior of their convex carrier.

This is the true replacement for the rejected boundary-USC scaffold.  It uses
only Mathlib's `ConvexOn.continuousOn_interior` plus the compact continuous norm
bound from SOptLib; it deliberately does not claim any upper control at boundary
points or on the whole ordinary/intrinsic interior.  In particular, it is not a
renaming of
`convexOn_lsc_upperSemicontinuousOn_of_isCompact_convex_nonempty_interior`:
that all-carrier statement is false for convex lsc functions with boundary
blow-up.  This matches Lan's source assumptions for SAPD, where `hat_g` is only
proper convex lower-semicontinuous and Eq. (4.4.34) bounds Bregman diameters
rather than arbitrary boundary values of convex lsc functions. -/
private theorem bounded_on_compact_subset_of_interior_for_convexOn
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    {C K : Set E} {f : E → ℝ}
    (hfconv : ConvexOn ℝ K f) (hCcompact : IsCompact C) (hCsub : C ⊆ interior K) :
    ∃ B : ℝ, ∀ x, x ∈ C → f x ≤ B := by
  exact ConvexOn.exists_upper_bound_on_compact_subset_interior hfconv hCcompact hCsub

/-- Absolute-value version of the interior compact bound above.

This is the local shape that consumers of the rejected global compact-lsc route
usually need: a uniform norm bound, but only on compact subsets already known to
lie inside `interior K`.  It still makes no assertion about boundary values of
an arbitrary convex lower-semicontinuous function. -/
private theorem norm_bounded_on_compact_subset_of_interior_for_convexOn
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    {C K : Set E} {f : E → ℝ}
    (hfconv : ConvexOn ℝ K f) (hCcompact : IsCompact C) (hCsub : C ⊆ interior K) :
    ∃ B : ℝ, ∀ x, x ∈ C → ‖f x‖ ≤ B := by
  exact ConvexOn.exists_norm_bound_on_compact_subset_interior hfconv hCcompact hCsub

/-- APD parameter lower bound derived from the paper recurrence.

No SOptLib match: considered `Convex.normalized_weighted_sum_mem` for the
downstream convex-combination use and searched `beta recurrence one_le positive
theta induction`; SOptLib has no recurrence helper for Lan Eq. (4.4.24)--(4.4.25),
so this local bridge derives the paper-specific bound from `hbeta_one`,
`hbeta_rec`, and `htheta_range`. -/
private theorem beta_ge_one (t : ℕ) (ht : 1 ≤ t) :
    1 ≤ setup.beta t := by
  exact one_le_beta_of_recurrence setup.beta setup.theta
    setup.hbeta_one setup.hbeta_rec
    (fun t ht => le_of_lt (setup.htheta_range t ht).1) t ht

/-- Beta-gamma product shift used by Lan's Lemma 4.9 telescope.

No SOptLib match: searched `beta gamma recurrence shift` and `theta gamma
recurrence inverse multiplication cancel`; candidates such as `beta_ge_one`,
SOptLib prox bounds, and generic telescope lemmas do not encode Lan
Eq. (4.4.24)--(4.4.25)'s paper-specific scalar recurrence. -/
private theorem beta_gamma_shift_identity (i : ℕ) (hi : 2 ≤ i) :
    (setup.beta i - 1) * setup.gamma i =
      setup.beta (i - 1) * setup.gamma (i - 1) := by
  have hi_prev : 1 ≤ i - 1 := by omega
  have hidx : i - 1 + 1 = i := by omega
  have hbeta_i :
      setup.beta i - 1 = setup.beta (i - 1) * setup.theta i := by
    simpa [hidx] using setup.hbeta_rec (i - 1) hi_prev
  have hgamma_i :
      setup.gamma i = (setup.theta i)⁻¹ * setup.gamma (i - 1) := by
    simpa using setup.hgamma_rec i hi
  calc
    (setup.beta i - 1) * setup.gamma i =
        (setup.beta (i - 1) * setup.theta i) *
          ((setup.theta i)⁻¹ * setup.gamma (i - 1)) := by
      rw [hbeta_i, hgamma_i]
    _ = setup.beta (i - 1) * setup.gamma (i - 1) := by
      field_simp [ne_of_gt (setup.htheta_range i hi).1]

/-- Positivity of the `gamma` weights generated by Lan Eq. (4.4.24)--(4.4.25).

No SOptLib match: searched `gamma positive recurrence theta`; positive-time
weight helpers in `SOptLib.Model.Iterates` transport an already-nonnegative
schedule, while this paper-specific fact derives positivity from `hgamma_one`,
`hgamma_rec`, and `htheta_range`. -/
private theorem gamma_pos (i : ℕ) (hi : 1 ≤ i) :
    0 < setup.gamma i := by
  exact gamma_pos_of_inverse_theta_recurrence setup.gamma setup.theta
    (by simp [setup.hgamma_one]) setup.hgamma_rec
    (fun t ht => (setup.htheta_range t ht).1) i hi

/-- Gamma-over-tau monotonicity used in Lan Eq. (4.4.62)'s Young coupling step.

No SOptLib match: searched `gamma tau monotone theta recurrence` and
`gamma eta monotone theta recurrence`; existing hits were the paper-specific
`beta_gamma_shift_identity`, `gamma_pos`, and generic prox/telescope tools, none
of which specialize Lan Eq. (4.4.25)'s `theta_i ≤ tau_{i-1}/tau_i` schedule
comparison. -/
private theorem gamma_div_tau_mono (i : ℕ) (hi : 2 ≤ i) :
    setup.gamma (i - 1) / setup.tau (i - 1) ≤ setup.gamma i / setup.tau i := by
  have hθ_pos : 0 < setup.theta i := (setup.htheta_range i hi).1
  have hθ_tau : setup.theta i ≤ setup.tau (i - 1) / setup.tau i := by
    exact le_trans (setup.htheta_range i hi).2 (min_le_right _ _)
  have hτprev : 0 < setup.tau (i - 1) := setup.htau_pos (i - 1) (by omega)
  have hτ : 0 < setup.tau i := setup.htau_pos i (by omega)
  have hγprev : 0 < setup.gamma (i - 1) := gamma_pos setup (i - 1) (by omega)
  have hγ_rec : setup.gamma i = (setup.theta i)⁻¹ * setup.gamma (i - 1) := by
    simpa using setup.hgamma_rec i hi
  exact gamma_div_schedule_mono_of_theta_le_ratio setup.gamma setup.theta setup.tau i
    hθ_pos hτprev hτ (le_of_lt hγprev) hθ_tau hγ_rec

/-- Gamma-over-eta monotonicity from Lan Eq. (4.4.25).

This is the primal analogue of `gamma_div_tau_mono`; it uses the same
`theta_i <= eta_{i-1}/eta_i` schedule comparison and the source gamma
recurrence. -/
private theorem gamma_div_eta_mono (i : ℕ) (hi : 2 ≤ i) :
    setup.gamma (i - 1) / setup.eta (i - 1) ≤ setup.gamma i / setup.eta i := by
  have hθ_pos : 0 < setup.theta i := (setup.htheta_range i hi).1
  have hθ_eta : setup.theta i ≤ setup.eta (i - 1) / setup.eta i := by
    exact le_trans (setup.htheta_range i hi).2 (min_le_left _ _)
  have hηprev : 0 < setup.eta (i - 1) := setup.heta_pos (i - 1) (by omega)
  have hη : 0 < setup.eta i := setup.heta_pos i (by omega)
  have hγprev : 0 < setup.gamma (i - 1) := gamma_pos setup (i - 1) (by omega)
  have hden_le : setup.theta i * setup.eta i ≤ setup.eta (i - 1) := by
    have hmul := mul_le_mul_of_nonneg_right hθ_eta (le_of_lt hη)
    have hdiv : (setup.eta (i - 1) / setup.eta i) * setup.eta i =
        setup.eta (i - 1) := by
      field_simp [ne_of_gt hη]
    nlinarith [hmul, hdiv]
  have hinv_le :
      (setup.eta (i - 1))⁻¹ ≤ (setup.theta i * setup.eta i)⁻¹ := by
    exact (inv_le_inv₀ hηprev (mul_pos hθ_pos hη)).mpr hden_le
  have hscale := mul_le_mul_of_nonneg_left hinv_le (le_of_lt hγprev)
  have hγ_rec : setup.gamma i = (setup.theta i)⁻¹ * setup.gamma (i - 1) := by
    simpa using setup.hgamma_rec i hi
  calc
    setup.gamma (i - 1) / setup.eta (i - 1)
        = setup.gamma (i - 1) * (setup.eta (i - 1))⁻¹ := by ring
    _ ≤ setup.gamma (i - 1) * (setup.theta i * setup.eta i)⁻¹ := hscale
    _ = setup.gamma i / setup.eta i := by
        rw [hγ_rec]
        field_simp [ne_of_gt hθ_pos, ne_of_gt hη]

/-- Increasing-weight forward differences of a bounded nonnegative scalar
potential are bounded by the last weight times the diameter.

This is the scalar Abel-telescope used for Lan's Bregman boundary term in
Eq. (4.4.72): `a_i` is either `gamma_i/eta_i` or `gamma_i/tau_i`, and `v_i`
is a Bregman divergence to the selected comparison point. -/
private theorem weighted_forward_diff_sum_le_last_mul_bound
    (a v : ℕ → ℝ) (D : ℝ) (t : ℕ) (ht : 1 ≤ t)
    (ha_mono : ∀ i, 2 ≤ i → i ≤ t → a (i - 1) ≤ a i)
    (ha_nonneg : ∀ i, 1 ≤ i → i ≤ t → 0 ≤ a i)
    (hv_nonneg : ∀ i, 1 ≤ i → i ≤ t + 1 → 0 ≤ v i)
    (hv_bound : ∀ i, 1 ≤ i → i ≤ t → v i ≤ D) :
    Finset.sum (Finset.Icc 1 t) (fun i => a i * (v i - v (i + 1))) ≤
      a t * D := by
  exact sum_Icc_weighted_forward_diff_le_last_mul_bound
    a v D t ht ha_mono ha_nonneg
    (ha_nonneg t ht le_rfl)
    hv_nonneg
    (hv_nonneg (t + 1) (by omega) (by omega))
    hv_bound

/-- Tail-preserving Abel telescope for Lan's terminal Eq. (4.4.69) absorption.

This is the same scalar telescope as
`weighted_forward_diff_sum_le_last_mul_bound`, but it keeps the negative final
potential.  The endpoint coupling in Eq. (4.4.69) is absorbed by this retained
`V_Y(y, y_{t+1})` term. -/
private theorem weighted_forward_diff_sum_le_last_mul_bound_sub_tail
    (a v : ℕ → ℝ) (D : ℝ) (t : ℕ) (ht : 1 ≤ t)
    (ha_mono : ∀ i, 2 ≤ i → i ≤ t → a (i - 1) ≤ a i)
    (ha_nonneg : ∀ i, 1 ≤ i → i ≤ t → 0 ≤ a i)
    (hv_nonneg : ∀ i, 1 ≤ i → i ≤ t + 1 → 0 ≤ v i)
    (hv_bound : ∀ i, 1 ≤ i → i ≤ t → v i ≤ D) :
    Finset.sum (Finset.Icc 1 t) (fun i => a i * (v i - v (i + 1))) ≤
      a t * D - a t * v (t + 1) := by
  exact sum_Icc_weighted_forward_diff_le_last_mul_bound_sub_tail
    a v D t ht ha_mono ha_nonneg hv_nonneg hv_bound

/-- Operator-norm Young bound for Lan Eq. (4.4.62)'s generated coupling term.

Chosen alignment with Lan Lemma 4.9 step 2: this specializes the Mathlib
operator-norm/Cauchy bound and the SOptLib scalar Young inequality to the
paper's `p`, `tau`, and `gamma` schedules, using `gamma_div_tau_mono` for the
Eq. (4.4.25) schedule comparison. -/
private theorem generated_young_coupling_bound
    (i : ℕ) (hi : 2 ≤ i)
    (dx : SapdPrimalSpace n) (dy : SapdDualSpace m) :
    -setup.gamma (i - 1) * ⟪setup.A dx, dy⟫_ℝ ≤
      setup.gamma (i - 1) * setup.tau (i - 1) / (2 * setup.p) *
          (‖setup.A‖ ^ 2 * ‖dx‖ ^ 2) +
        setup.p * setup.gamma i / (2 * setup.tau i) * ‖dy‖ ^ 2 := by
  exact neg_gamma_inner_linear_le_young_with_ratio setup.A dx dy
    (setup.gamma (i - 1)) (setup.gamma i) (setup.tau (i - 1)) (setup.tau i) setup.p
    (gamma_pos setup (i - 1) (by omega))
    (setup.htau_pos (i - 1) (by omega))
    (setup.htau_pos i (by omega))
    setup.hp_mem.1
    (gamma_div_tau_mono setup i hi)

/-- Half-coefficient form of Lan Eq. (4.4.58)'s parameter coupling condition.

No SOptLib match: searched `parameter coupling half coefficient nonnegative q eta beta norm tau p`
and `nonnegative scalar half coefficient drop square hparam_coupling`; hits were
generic square-budget tools and the local Young helper, not this SAPD scalar
normalization of the setup field `hparam_coupling`. -/
private theorem param_coupling_half_nonneg (i : ℕ) (hi : 1 ≤ i) :
    0 ≤ setup.q / (2 * setup.eta i) - setup.Lhatf / (2 * setup.beta i) -
      ‖setup.A‖ ^ 2 * setup.tau i / (2 * setup.p) := by
  have h := setup.hparam_coupling i hi
  have hη : setup.eta i ≠ 0 := ne_of_gt (setup.heta_pos i hi)
  have hb : setup.beta i ≠ 0 :=
    ne_of_gt (lt_of_lt_of_le zero_lt_one (beta_ge_one setup i hi))
  have hp : setup.p ≠ 0 := ne_of_gt setup.hp_mem.1
  field_simp [hη, hb, hp] at h ⊢
  nlinarith

/-- Inverse-beta coefficients form the convex weights used in Lan
Eq. (4.4.14), Eq. (4.4.18), and Eq. (4.4.19).

Chosen alignment: uses the local `beta_ge_one` bridge rather than
`Convex.normalized_weighted_sum_mem`; the latter is a finite-output averaging
lemma, while these equations are literal two-point APD convex combinations. -/
private theorem inv_beta_convex_weights (t : ℕ) (ht : 1 ≤ t) :
    0 ≤ 1 - (setup.beta t)⁻¹ ∧
      0 ≤ (setup.beta t)⁻¹ ∧
      1 - (setup.beta t)⁻¹ + (setup.beta t)⁻¹ = 1 := by
  exact inv_convex_weights_of_one_le (setup.beta t) (beta_ge_one setup t ht)

/-- The inverse acceleration scale is a valid accelerated-average coefficient. -/
private theorem inv_beta_mem_Icc (t : ℕ) (ht : 1 ≤ t) :
    (setup.beta t)⁻¹ ∈ Set.Icc (0 : ℝ) 1 := by
  have hβ : 1 ≤ setup.beta t := beta_ge_one setup t ht
  exact Set.mem_Icc.mpr
    ⟨inv_nonneg.mpr (le_trans zero_le_one hβ), inv_le_one_of_one_le₀ hβ⟩

/-- Ambient value of the midpoint `x_t^{md}` from Eq. (4.4.14).

No SOptLib match: the pre-candidate digest for midpoint was empty, and direct
inspection of `Model.Iterates` found weighted output/process helpers but no APD
midpoint recurrence matching Eq. (4.4.14). -/
noncomputable def midpointValue (t : ℕ)
    (st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y) : SapdPrimalSpace n :=
  (1 - (setup.beta t)⁻¹) • st.xBar.1 + (setup.beta t)⁻¹ • st.x.1

/-- Feasibility of the midpoint generated by Eq. (4.4.14).

This is a proof obligation from the Algorithm 4.3 parameter recurrence and
convexity of `X`, not a setup field or theorem-head hypothesis. -/
theorem midpointValue_mem (t : ℕ) (ht : 1 ≤ t)
    (st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y) :
    setup.midpointValue t st ∈ setup.X := by
  rcases inv_beta_convex_weights setup t ht with ⟨hleft, hright, hsum⟩
  simpa [midpointValue] using setup.hX_convex st.xBar.2 st.x.2 hleft hright hsum

/-- Feasible midpoint `x_t^{md}` from Eq. (4.4.14), used as the paper-domain
SFO query in Eq. (4.4.57). -/
noncomputable def midpoint (t : ℕ) (ht : 1 ≤ t)
    (st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y) :
