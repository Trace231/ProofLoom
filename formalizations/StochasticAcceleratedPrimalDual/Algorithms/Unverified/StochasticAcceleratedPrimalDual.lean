    simpa [hterm_eq] using hone.1
  have hterm_bound :
      ∀ i ∈ Finset.Icc 1 T, ∫ ω, term i ω ∂setup.P ≤ setup.sigmaXA ^ 2 := by
    intro i hi
    have hone :=
      setup.generatedDeltaXAStageSeparated_sqDeviation_integrable_and_bound_of_prefix_query
        generatedAxSample T i hi (hquery_prefix i hi)
    have hterm_eq :
        term i =
          (fun ω =>
            ‖setup.deltaXAStageSeparated generatedAxSample T i hi ω‖ ^ 2) := by
      have hi_pair : 1 ≤ i ∧ i ≤ T := Finset.mem_Icc.mp hi
      funext ω
      simp [term, hi_pair]
    simpa [hterm_eq] using hone.2
  constructor
  · simpa [term] using
      (integrable_finset_sum (s := Finset.Icc 1 T) (f := term) hterm_int)
  · calc
      ∫ ω, Finset.sum (Finset.Icc 1 T) (fun i => term i ω) ∂setup.P
          = Finset.sum (Finset.Icc 1 T) (fun i => ∫ ω, term i ω ∂setup.P) := by
            rw [integral_finset_sum (Finset.Icc 1 T) hterm_int]
      _ ≤ Finset.sum (Finset.Icc 1 T) (fun _i => setup.sigmaXA ^ 2) := by
            exact Finset.sum_le_sum hterm_bound

/-- One-step square-integrability bridge for the combined source primal noise
`Δ_i^x = Δ_{x,i}^{hat f} + Δ_{x,A}^i`.

This is pure algebra over the two source-named components.  It does not replace
Lan's split Assumption 8 route by a new oracle model: downstream proofs still
have to supply the `Δ_{x,hat f}` residual/mismatch bound and the `Δ_{x,A}`
random-query bound separately. -/
theorem generatedDeltaX_sqDeviation_integrable_and_bound_of_component_bounds
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i) (Bhatf BA : ℝ)
    (hhatf_int :
      Integrable
        (fun ω => ‖setup.deltaXHatf generatedAxSample i hi ω‖ ^ 2)
        setup.P)
    (hhatf_bound :
      ∫ ω, ‖setup.deltaXHatf generatedAxSample i hi ω‖ ^ 2 ∂setup.P ≤ Bhatf)
    (hA_int :
      Integrable
        (fun ω => ‖setup.deltaXA generatedAxSample i hi ω‖ ^ 2)
        setup.P)
    (hA_bound :
      ∫ ω, ‖setup.deltaXA generatedAxSample i hi ω‖ ^ 2 ∂setup.P ≤ BA)
    (hdelta_aesm :
      AEStronglyMeasurable
        (fun ω => ‖setup.deltaX generatedAxSample i hi ω‖ ^ 2)
        setup.P) :
    Integrable
        (fun ω => ‖setup.deltaX generatedAxSample i hi ω‖ ^ 2)
        setup.P ∧
      ∫ ω, ‖setup.deltaX generatedAxSample i hi ω‖ ^ 2 ∂setup.P ≤
        2 * Bhatf + 2 * BA := by
  let hatfSq : Ω → ℝ := fun ω =>
    ‖setup.deltaXHatf generatedAxSample i hi ω‖ ^ 2
  let aSq : Ω → ℝ := fun ω =>
    ‖setup.deltaXA generatedAxSample i hi ω‖ ^ 2
  have hhatf_int' : Integrable hatfSq setup.P := by
    simpa [hatfSq] using hhatf_int
  have hA_int' : Integrable aSq setup.P := by
    simpa [aSq] using hA_int
  have hmajor_int : Integrable (fun ω => 2 * hatfSq ω + 2 * aSq ω) setup.P := by
    exact (hhatf_int'.const_mul 2).add (hA_int'.const_mul 2)
  have hpoint :
      ∀ᵐ ω ∂setup.P,
        ‖(‖setup.deltaX generatedAxSample i hi ω‖ ^ 2 : ℝ)‖ ≤
          ‖2 * hatfSq ω + 2 * aSq ω‖ := by
    refine Filter.Eventually.of_forall fun ω => ?_
    have hle :
        ‖setup.deltaX generatedAxSample i hi ω‖ ^ 2 ≤
          2 * hatfSq ω + 2 * aSq ω := by
      simpa [deltaX, hatfSq, aSq] using
        SOptLib.norm_add_sq_le_two_mul_norm_sq_add_two_mul_norm_sq
          (setup.deltaXHatf generatedAxSample i hi ω)
          (setup.deltaXA generatedAxSample i hi ω)
    have hmajor_nonneg : 0 ≤ 2 * hatfSq ω + 2 * aSq ω := by
      positivity
    have hdelta_nonneg :
        0 ≤ ‖setup.deltaX generatedAxSample i hi ω‖ ^ 2 := sq_nonneg _
    simpa [Real.norm_eq_abs, abs_of_nonneg hdelta_nonneg,
      abs_of_nonneg hmajor_nonneg] using hle
  have hdelta_int :
      Integrable (fun ω => ‖setup.deltaX generatedAxSample i hi ω‖ ^ 2) setup.P := by
    exact Integrable.mono hmajor_int hdelta_aesm hpoint
  have hpoint_le :
      ∀ᵐ ω ∂setup.P,
        ‖setup.deltaX generatedAxSample i hi ω‖ ^ 2 ≤
          2 * hatfSq ω + 2 * aSq ω := by
    refine Filter.Eventually.of_forall fun ω => ?_
    simpa [deltaX, hatfSq, aSq] using
      SOptLib.norm_add_sq_le_two_mul_norm_sq_add_two_mul_norm_sq
        (setup.deltaXHatf generatedAxSample i hi ω)
        (setup.deltaXA generatedAxSample i hi ω)
  have hintegral_le :
      ∫ ω, ‖setup.deltaX generatedAxSample i hi ω‖ ^ 2 ∂setup.P ≤
        ∫ ω, (2 * hatfSq ω + 2 * aSq ω) ∂setup.P :=
    integral_mono_ae hdelta_int hmajor_int hpoint_le
  constructor
  · exact hdelta_int
  · calc
      ∫ ω, ‖setup.deltaX generatedAxSample i hi ω‖ ^ 2 ∂setup.P
          ≤ ∫ ω, (2 * hatfSq ω + 2 * aSq ω) ∂setup.P := hintegral_le
      _ = 2 * ∫ ω, hatfSq ω ∂setup.P + 2 * ∫ ω, aSq ω ∂setup.P := by
            rw [integral_add (hhatf_int'.const_mul 2) (hA_int'.const_mul 2)]
            rw [integral_const_mul, integral_const_mul]
      _ ≤ 2 * Bhatf + 2 * BA := by
            nlinarith [hhatf_bound, hA_bound]

/-- Combined primal-noise moment bound using the source cross-term cancellation.

The generic inequality for `‖Δ_{x,i}^{hat f} + Δ_{x,A}^i‖^2` loses a factor
two.  Lan's proof of Eq. (4.4.73) instead uses independence of the two
components at iteration `i`, so the expected cross term vanishes and the
source-scale budget is `σ_{x,hat f}^2 + σ_{x,A}^2 = σ_x^2`.  This theorem keeps
that independence/cross-moment fact as a local proof obligation rather than
silently replacing it by the false scalar budget required by the generic
`2+2` bound. -/
theorem generatedDeltaX_sqDeviation_integrable_and_bound_of_independent_component_bounds
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i) (Bhatf BA : ℝ)
    (hhatf_aesm :
      AEStronglyMeasurable
        (fun ω => setup.deltaXHatf generatedAxSample i hi ω) setup.P)
    (hhatf_int :
      Integrable
        (fun ω => ‖setup.deltaXHatf generatedAxSample i hi ω‖ ^ 2)
        setup.P)
    (hhatf_bound :
      ∫ ω, ‖setup.deltaXHatf generatedAxSample i hi ω‖ ^ 2 ∂setup.P ≤ Bhatf)
    (hA_aesm :
      AEStronglyMeasurable
        (fun ω => setup.deltaXA generatedAxSample i hi ω) setup.P)
    (hA_int :
      Integrable
        (fun ω => ‖setup.deltaXA generatedAxSample i hi ω‖ ^ 2)
        setup.P)
    (hA_bound :
      ∫ ω, ‖setup.deltaXA generatedAxSample i hi ω‖ ^ 2 ∂setup.P ≤ BA)
    (hcross_nonpos :
      ∫ ω,
          2 *
            ⟪setup.deltaXHatf generatedAxSample i hi ω,
              setup.deltaXA generatedAxSample i hi ω⟫_ℝ ∂setup.P ≤ 0) :
    Integrable
        (fun ω => ‖setup.deltaX generatedAxSample i hi ω‖ ^ 2)
        setup.P ∧
      ∫ ω, ‖setup.deltaX generatedAxSample i hi ω‖ ^ 2 ∂setup.P ≤
        Bhatf + BA := by
  exact integrable_sq_norm_add_and_integral_le_of_cross_nonpos
    (μ := setup.P)
    (u := fun ω => setup.deltaXHatf generatedAxSample i hi ω)
    (v := fun ω => setup.deltaXA generatedAxSample i hi ω)
    (w := fun ω => setup.deltaX generatedAxSample i hi ω)
    (Bu := Bhatf) (Bv := BA)
    hhatf_aesm hA_aesm
    (fun ω => by simp [deltaX, SOptLib.combinedPrimalNoiseProcess])
    hhatf_int hhatf_bound hA_int hA_bound hcross_nonpos

/-- Finite-sum square-integrability bridge for the combined source primal noise.

This is the generated-extension ingredient missing after the separate
`Δ_{x,hat f}` and `Δ_{x,A}` bridges: it packages their per-index bounds into the
actual `Δ_i^x` term used by Lemma 4.10 and Theorem 4.8. -/
theorem generatedDeltaX_finset_sqDeviation_integrable_and_bound_of_component_bounds
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (T : ℕ) (Bhatf BA : ℕ → ℝ)
    (hhatf_int :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
        Integrable
          (fun ω =>
            ‖setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2)
          setup.P)
    (hhatf_bound :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
        ∫ ω,
            ‖setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2
            ∂setup.P ≤ Bhatf i)
    (hA_int :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
        Integrable
          (fun ω =>
            ‖setup.deltaXA generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2)
          setup.P)
    (hA_bound :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
        ∫ ω,
            ‖setup.deltaXA generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2
            ∂setup.P ≤ BA i)
    (hdelta_aesm :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
        AEStronglyMeasurable
          (fun ω =>
            ‖setup.deltaX generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2)
          setup.P) :
    Integrable
        (fun ω =>
          Finset.sum (Finset.Icc 1 T) (fun i =>
            if hi : i ∈ Finset.Icc 1 T then
              ‖setup.deltaX generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2
            else 0))
        setup.P ∧
      ∫ ω,
          Finset.sum (Finset.Icc 1 T) (fun i =>
            if hi : i ∈ Finset.Icc 1 T then
              ‖setup.deltaX generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2
            else 0)
          ∂setup.P ≤
        Finset.sum (Finset.Icc 1 T) (fun i => 2 * Bhatf i + 2 * BA i) := by
  classical
  let term : ℕ → Ω → ℝ := fun i ω =>
    if hi : i ∈ Finset.Icc 1 T then
      ‖setup.deltaX generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2
    else 0
  have hterm_int : ∀ i ∈ Finset.Icc 1 T, Integrable (term i) setup.P := by
    intro i hi
    have hone :=
      setup.generatedDeltaX_sqDeviation_integrable_and_bound_of_component_bounds
        generatedAxSample i (Finset.mem_Icc.mp hi).1 (Bhatf i) (BA i)
        (hhatf_int i hi) (hhatf_bound i hi) (hA_int i hi) (hA_bound i hi)
        (hdelta_aesm i hi)
    have hterm_eq :
        term i =
          (fun ω =>
            ‖setup.deltaX generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2) := by
      have hi_pair : 1 ≤ i ∧ i ≤ T := Finset.mem_Icc.mp hi
      funext ω
      simp [term, hi_pair]
    simpa [hterm_eq] using hone.1
  have hterm_bound :
      ∀ i ∈ Finset.Icc 1 T,
        ∫ ω, term i ω ∂setup.P ≤ 2 * Bhatf i + 2 * BA i := by
    intro i hi
    have hone :=
      setup.generatedDeltaX_sqDeviation_integrable_and_bound_of_component_bounds
        generatedAxSample i (Finset.mem_Icc.mp hi).1 (Bhatf i) (BA i)
        (hhatf_int i hi) (hhatf_bound i hi) (hA_int i hi) (hA_bound i hi)
        (hdelta_aesm i hi)
    have hterm_eq :
        term i =
          (fun ω =>
            ‖setup.deltaX generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2) := by
      have hi_pair : 1 ≤ i ∧ i ≤ T := Finset.mem_Icc.mp hi
      funext ω
      simp [term, hi_pair]
    simpa [hterm_eq] using hone.2
  constructor
  · simpa [term] using
      (integrable_finset_sum (s := Finset.Icc 1 T) (f := term) hterm_int)
  · calc
      ∫ ω, Finset.sum (Finset.Icc 1 T) (fun i => term i ω) ∂setup.P
          = Finset.sum (Finset.Icc 1 T) (fun i => ∫ ω, term i ω ∂setup.P) := by
            rw [integral_finset_sum (Finset.Icc 1 T) hterm_int]
      _ ≤ Finset.sum (Finset.Icc 1 T) (fun i => 2 * Bhatf i + 2 * BA i) := by
            exact Finset.sum_le_sum hterm_bound

/-- Source noise pair `Δ_t = (Δ_t^x, Δ_t^y)` from the paragraph after
Assumption 9.

Candidate audit: SOptLib has product residual lemmas but no paper-specific SAPD
noise pair with Lan's signs and generated APD query points. -/
noncomputable def delta
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t) (ω : Ω) :
    SapdPrimalSpace n × SapdDualSpace m :=
  (setup.deltaX generatedAxSample t ht ω, setup.sapdDeltaY generatedAxSample t ht ω)

/-- Canonical `Λ_i(z)` term from Eq. (4.4.60), derived from generated noises and
iterates instead of supplied as a theorem-local surrogate.

Candidate audit: searched SOptLib for `Lambda`, stochastic-recursion residual
terms, and random-query residuals; existing lemmas bound generic residuals but
none define Lan Eq. (4.4.60)'s SAPD `Λ_i(z)` expression. -/
noncomputable def LambdaTerm
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i) (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (ω : Ω) : ℝ :=
  -((1 - setup.q) * setup.gamma i / (2 * setup.eta i)) *
      ‖(setup.generatedAxExtensionProcess generatedAxSample i ω).x.1 -
        (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).x.1‖ ^ 2 -
    ((1 - setup.p) * setup.gamma i / (2 * setup.tau i)) *
      ‖(setup.generatedAxExtensionProcess generatedAxSample i ω).y.1 -
        (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).y.1‖ ^ 2 -
    setup.gamma i *
      (⟪(setup.delta generatedAxSample i hi ω).1,
          (setup.generatedAxExtensionProcess generatedAxSample i ω).x.1 - z.1.1⟫_ℝ +
        ⟪(setup.delta generatedAxSample i hi ω).2,
          (setup.generatedAxExtensionProcess generatedAxSample i ω).y.1 - z.1.2⟫_ℝ)

/-- Product Bregman divergence `V(z,z') = V_X(x,x') + V_Y(y,y')` used in
Lemma 4.10's auxiliary prox process.

No SOptLib match: searched `argmin prox mirror step product bregman`, checked
the `SOptLib/Model/Prox.lean` signatures for `proxStepArgmin` and `proxStep`
and the `SOptLib/Model/Iterates.lean` signature for `proxOracleStep`; they model
a single evaluated mirror step or an already-supplied prox map, while Lan
Eq. (4.4.63) uses the paper-specific product Bregman geometry over `Z = X × Y`. -/
noncomputable def productBregman
    (z zPrev : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) : ℝ :=
  productBregmanDivergence setup.VX setup.VY z.1 zPrev.1

/-- Source `B_t(z,z_[t])` term from Eq. (4.4.28), parameterized by the
paper-indexed feasible sequence `z_i`.

No SOptLib match: searched telescope/weighted-output candidates and inspected
`SOptLib.Layer1.Telescope`; those lemmas telescope generic inequalities but do
not define Lan Eq. (4.4.28)'s weighted APD Bregman boundary term. -/
noncomputable def BTerm
    (t : ℕ)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (zSeq : ℕ → Ω → {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (ω : Ω) : ℝ :=
  SOptLib.twoBlockWeightedBregmanBoundary setup.gamma setup.eta setup.tau setup.VX setup.VY
    (fun i ω => (zSeq i ω).1) t z.1 ω

/-- Source `B_t(z,z_[t])` from Eq. (4.4.28), for deterministic paper-indexed
feasible sequences.

No SOptLib match: searched telescope and weighted-output candidates and
inspected `SOptLib.Layer1.Telescope`; those lemmas aggregate generic bounds but
do not define Lan Eq. (4.4.28)'s APD Bregman boundary term with separate
`η_i` and `τ_i` weights. -/
noncomputable def BTermFor
    (t : ℕ)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (zSeq : ℕ → {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) : ℝ :=
  Finset.sum (Finset.Icc 1 t) (fun i =>
    setup.gamma i / setup.eta i *
        (setup.VX z.1.1 (zSeq i).1.1 - setup.VX z.1.1 (zSeq (i + 1)).1.1) +
      setup.gamma i / setup.tau i *
        (setup.VY z.1.2 (zSeq i).1.2 - setup.VY z.1.2 (zSeq (i + 1)).1.2))

/-- Source `Λ_i(z)` from Eq. (4.4.60), parameterized by the paper sequence
`z_i` and source noise pair `Δ_i`.

No SOptLib match: searched stochastic-recursion residual terms and oracle
residual kernels; SOptLib has generic residual and telescope tools, but no
paper-specific SAPD term with Lan's signs, `(1-q)/(2η_i)`, and
`(1-p)/(2τ_i)` coefficients. -/
noncomputable def LambdaTermFor
    (zSeq : ℕ → {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (delta : ℕ → SapdPrimalSpace n × SapdDualSpace m)
    (i : ℕ) (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) : ℝ :=
  SOptLib.twoBlockStochasticLambdaTerm setup.gamma setup.eta setup.tau setup.p setup.q
    (fun j => (zSeq j).1) delta i z.1

/-- Source `B_t(z,z_[t])` term from Eq. (4.4.28), evaluated along the
source-boundary Algorithm 4.3 state. -/
private noncomputable def algorithm43SourceBoundaryBTerm
    (t : ℕ) (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (ω : Ω) : ℝ :=
  setup.BTerm t z setup.algorithm43SourceBoundaryZ ω

/-- Source `Λ_i(z)` from Eq. (4.4.60), evaluated along the source-boundary
Algorithm 4.3 state and source noise pair. -/
private noncomputable def algorithm43SourceBoundaryLambdaTerm
    (i : ℕ) (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (ω : Ω) : ℝ :=
  setup.LambdaTermFor (fun j => setup.algorithm43SourceBoundaryZ j ω)
    (fun j => setup.algorithm43SourceBoundaryDelta j ω) i z

/-- Generated feasible pair `z_i = (x_i,y_i)` from Algorithm 4.3, with paper
indexing.  Since `generatedAxExtensionProcess 0` stores the paper initialization `z_1`, this maps
paper index `i ≥ 1` to `generatedAxExtensionProcess (i-1)`. -/
noncomputable def generatedZ
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (i : ℕ) (ω : Ω) :
    {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
  ⟨((setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).x.1,
      (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).y.1),
    ⟨(setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).x.2,
      (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).y.2⟩⟩

/-- Source `B_t(z,z_[t])` for the explicit generated-`A_hat_x` extension
process. -/
noncomputable def generatedBTerm
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (t : ℕ) (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) (ω : Ω) : ℝ :=
  setup.BTerm t z (setup.generatedZ generatedAxSample) ω

/-- Auxiliary prox objective from Eq. (4.4.63), with generated SAPD noise. -/
noncomputable def auxiliaryProxObjective
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i)
    (zPrev z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (ω : Ω) : ℝ :=
  SOptLib.twoBlockAuxiliaryProxObjective
    (fun j : {j : ℕ // 1 ≤ j} => setup.eta j.1)
    (fun j : {j : ℕ // 1 ≤ j} => setup.tau j.1)
    (fun j ω => setup.deltaX generatedAxSample j.1 j.2 ω)
    (fun j ω => setup.sapdDeltaY generatedAxSample j.1 j.2 ω)
    setup.productBregman
    (fun z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} => z.1.1)
    (fun z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} => z.1.2)
    ⟨i, hi⟩ zPrev z ω

/-- Existence of the auxiliary prox argmin in Eq. (4.4.63).

This is a theorem obligation from the product prox geometry, not a setup field
or a theorem-local supplied sequence. -/
theorem auxiliaryProx_exists
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i)
    (zPrev : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (ω : Ω) :
    ∃ z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z},
      ∀ v : {v : SapdPrimalSpace n × SapdDualSpace m // v ∈ setup.Z},
        setup.auxiliaryProxObjective generatedAxSample i hi zPrev z ω ≤
          setup.auxiliaryProxObjective generatedAxSample i hi zPrev v ω := by
  have hVX_cont_Z : ContinuousOn
      (fun z : SapdPrimalSpace n × SapdDualSpace m => setup.VX z.1 zPrev.1.1)
      setup.Z := by
    have hmaps : Set.MapsTo
        (fun z : SapdPrimalSpace n × SapdDualSpace m => (z.1, zPrev.1.1))
        setup.Z (setup.X ×ˢ setup.X) := by
      intro z hz
      exact ⟨hz.1, zPrev.2.1⟩
    simpa [Z] using
      setup.VX_continuousOn.comp
        (continuous_fst.prodMk continuous_const).continuousOn hmaps
  have hVY_cont_Z : ContinuousOn
      (fun z : SapdPrimalSpace n × SapdDualSpace m => setup.VY z.2 zPrev.1.2)
      setup.Z := by
    have hmaps : Set.MapsTo
        (fun z : SapdPrimalSpace n × SapdDualSpace m => (z.2, zPrev.1.2))
        setup.Z (setup.Y ×ˢ setup.Y) := by
      intro z hz
      exact ⟨hz.2, zPrev.2.2⟩
    simpa [Z] using
      setup.VY_continuousOn.comp
        (continuous_snd.prodMk continuous_const).continuousOn hmaps
  simpa [auxiliaryProxObjective, productBregman, VX, VY,
    SapdDistanceGeneratingFunction.bregman,
    SOptLib.DistanceGeneratingFunctionOn.bregman,
    SOptLib.twoBlockAuxiliaryProxObjective, productBregmanDivergence]
    using
      (SOptLib.exists_minOn_twoBlock_linear_bregman_objective_compact
        (Z := setup.Z)
        (hZ_nonempty := ⟨zPrev.1, zPrev.2⟩)
        (hZ_compact := setup.Z_isCompact)
        (VxSection := fun x : SapdPrimalSpace n => setup.VX x zPrev.1.1)
        (VySection := fun y : SapdDualSpace m => setup.VY y zPrev.1.2)
        (dx := setup.deltaX generatedAxSample i hi ω)
        (dy := setup.sapdDeltaY generatedAxSample i hi ω)
        (eta := setup.eta i) (tau := setup.tau i)
        hVX_cont_Z hVY_cont_Z)

/-- Auxiliary prox selector `z_{i+1}^v` from Eq. (4.4.63), selected as the
canonical argmin rather than passed as an arbitrary theorem parameter.

No SOptLib match: checked the `SOptLib/Model/Prox.lean` `proxStepArgmin` and
`proxStep` signatures plus the FOC bridges; the available primitives are
single-space mirror selectors, while Eq. (4.4.63) is a product-state SAPD
selector with two different weights `η_i` and `τ_i` and the source noise pair
`Δ_i`. -/
noncomputable def auxiliaryProx
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i)
    (zPrev : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (ω : Ω) :
    {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
  SOptLib.twoBlockAuxiliaryProx
    (fun j : {j : ℕ // 1 ≤ j} => setup.eta j.1)
    (fun j : {j : ℕ // 1 ≤ j} => setup.tau j.1)
    (fun j ω => setup.deltaX generatedAxSample j.1 j.2 ω)
    (fun j ω => setup.sapdDeltaY generatedAxSample j.1 j.2 ω)
    setup.productBregman
    (fun z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} => z.1.1)
    (fun z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} => z.1.2)
    (fun j zPrev ω => by
      simpa [StochasticAcceleratedPrimalDualSetup.auxiliaryProxObjective]
        using setup.auxiliaryProx_exists generatedAxSample j.1 j.2 zPrev ω)
    ⟨i, hi⟩ zPrev ω

theorem auxiliaryProx_min
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i)
    (zPrev : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (ω : Ω) :
    ∀ v : {v : SapdPrimalSpace n × SapdDualSpace m // v ∈ setup.Z},
      setup.auxiliaryProxObjective generatedAxSample i hi zPrev
          (setup.auxiliaryProx generatedAxSample i hi zPrev ω) ω ≤
        setup.auxiliaryProxObjective generatedAxSample i hi zPrev v ω :=
  Classical.choose_spec (setup.auxiliaryProx_exists generatedAxSample i hi zPrev ω)

/-- Auxiliary process `z_i^v` from Lemma 4.10.

Lean index `1` is the source initialization `z_1^v = z_1`; index `0` is a
harmless duplicate for total recursive indexing and is not used by the
paper-facing sums. -/
noncomputable def auxiliaryProcess
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (z₁ : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    ℕ → Ω → {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
  SOptLib.auxiliaryProxProcess
    (fun i zPrev ω =>
      if hi : 1 ≤ i then
        setup.auxiliaryProx generatedAxSample i hi zPrev ω
      else
        zPrev)
    z₁

theorem auxiliaryProcess_one
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (z₁ : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) (ω : Ω) :
    setup.auxiliaryProcess generatedAxSample z₁ 1 ω = z₁ := by
  rfl

/-- Source `B_t(z,z^v_[t])` from Eq. (4.4.64), using the canonical auxiliary
process defined by Eq. (4.4.63). -/
noncomputable def auxiliaryBTerm
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (z₁ : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (t : ℕ) (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) (ω : Ω) : ℝ :=
  setup.BTerm t z (setup.auxiliaryProcess generatedAxSample z₁) ω

/-- Extension-only variance bridge for a generated `A_hat_x(\tilde x_t)` call
when a separate source-cited regime proves generated-query coverage and
identifies the explicit generated sample with the fixed-domain oracle kernel.

This is deliberately not used as a paper-facing Theorem 4.8 hypothesis. -/
theorem generatedAxQuery_variance_bound_extension
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (t : ℕ) (ht : 1 ≤ t) (ω : Ω)
    (hmem : setup.generatedAxQueryPoint generatedAxSample t ht ω ∈ setup.X)
    (hrealize :
      ∀ ω' : Ω,
        generatedAxSample t ω' =
          setup.sampledAx t ⟨setup.generatedAxQueryPoint generatedAxSample t ht ω, hmem⟩ ω') :
    ∫ ω', ‖generatedAxSample t ω' -
        setup.generatedAxTarget generatedAxSample t ht ω‖ ^ 2 ∂setup.P ≤ setup.sigmaY ^ 2 := by
  have hbound :=
    setup.sampledAx_variance_bound
      (setup.generatedAxQueryPoint generatedAxSample t ht ω) hmem t ht
  simpa [generatedAxTarget, hrealize] using hbound

/-- Extension output with the paper formula
`\bar z_{t+1} = (\bar x_{t+1}, \bar y_{t+1})`. -/
noncomputable def generatedExtensionOutput
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ω : Ω) :
    SapdPrimalSpace n × SapdDualSpace m :=
  ((setup.generatedAxExtensionProcess generatedAxSample t ω).xBar.1,
    (setup.generatedAxExtensionProcess generatedAxSample t ω).yBar.1)

/-- Feasibility of the output generated by the explicit generated-`A_hat_x`
extension process.

The PDF defines `g(\tilde z)` for feasible `\tilde z ∈ Z`; this is a derived
algorithmic invariant from initialization, convexity, and prox-step membership,
not a theorem-head assumption. -/
theorem generatedExtensionOutput_mem_Z
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (_ht : 1 ≤ t) (ω : Ω) :
    setup.generatedExtensionOutput generatedAxSample t ω ∈ setup.Z := by
  exact ⟨(setup.generatedAxExtensionProcess generatedAxSample t ω).xBar.2,
    (setup.generatedAxExtensionProcess generatedAxSample t ω).yBar.2⟩

/-- Extension output as a feasible point of `Z`, used to evaluate Eq.
(4.4.21)'s well-defined saddle gap without totalizing outside the source
domain. -/
noncomputable def generatedExtensionFeasibleOutput
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t) (ω : Ω) :
    {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
  ⟨setup.generatedExtensionOutput generatedAxSample t ω,
    setup.generatedExtensionOutput_mem_Z generatedAxSample t ht ω⟩

/-- Route-local regularity of a generated `A_hat_x(\tilde x_t)` stream.

The generated extension ranges over an arbitrary stream
`generatedAxSample : ℕ → Ω → SapdDualSpace m`; unlike the source SFO kernels,
such a stream has no measurability unless it is supplied by a concrete
measurable realization or assumed in an extension helper. -/
def GeneratedAxStreamMeasurableUpTo
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (T : ℕ) : Prop :=
  ∀ i, 1 ≤ i → i ≤ T → Measurable (generatedAxSample i)

/-- A concrete oracle realization supplies the positive-index generated stream
measurability interface from measurable generated states. -/
theorem GeneratedAxStreamMeasurableUpTo_of_realization
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (T : ℕ)
    (hrealize : setup.GeneratedAxOracleRealization generatedAxSample T)
    (hstate :
      ∀ j, j < T →
        StochasticAcceleratedPrimalDualStateMapMeasurable
          (fun ω => setup.generatedAxExtensionProcess generatedAxSample j ω)) :
    GeneratedAxStreamMeasurableUpTo generatedAxSample T := by
  simpa [GeneratedAxStreamMeasurableUpTo, GeneratedAxOracleRealization, sampledAx,
    SOptLib.oracleKernel] using
    (SOptLib.GeneratedOracleStreamMeasurableUpTo.of_realization
      (C := setup.X)
      (sample := generatedAxSample)
      (query := fun i hi ω => setup.generatedAxQueryPoint generatedAxSample i hi ω)
      (oracle := setup.oracleAx)
      (ξ := setup.ξ)
      (T := T)
      setup.horacleAx_measurable
      (fun i => setup.hξ_measurable i)
      hrealize
      (fun i hi1 hiT => by
        simpa [generatedAxQueryPoint] using (hstate (i - 1) (by omega)).2.2.2.2))

/-- One-step measurability bridge for the generated-`A_hat_x` extension
process.

This isolates the selected prox-step regularity needed to propagate
measurability of `generatedAxExtensionProcess`; it is not a paper theorem-head
assumption. -/
def GeneratedAxExtensionOneStepMeasurableUpTo
    (setup : StochasticAcceleratedPrimalDualSetup n m S Ω)
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (T : ℕ) : Prop :=
  SOptLib.recursiveProcessOneStepMeasurableUpTo
    StochasticAcceleratedPrimalDualStateMapMeasurable
    Measurable
    (fun i ω => setup.generatedAxExtensionProcess generatedAxSample i ω)
    generatedAxSample
    T

/-- Finite-process measurability for the generated extension, from explicit
stream and one-step regularity.

The previous output theorem quantified over an arbitrary generated stream and
was therefore false. This bridge is the intended induction target for FILL:
the base state is constant, and each step consumes the stream measurability and
prox-selector measurability interface. -/
theorem generatedAxExtensionProcess_measurable_of_regular_stream
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (T : ℕ)
    (hstream : GeneratedAxStreamMeasurableUpTo generatedAxSample T)
    (hstep : GeneratedAxExtensionOneStepMeasurableUpTo setup generatedAxSample T) :
    ∀ i, i ≤ T →
      StochasticAcceleratedPrimalDualStateMapMeasurable
        (fun ω => setup.generatedAxExtensionProcess generatedAxSample i ω) := by
  exact SOptLib.recursive_process_measurable_of_stream_and_one_step
    StochasticAcceleratedPrimalDualStateMapMeasurable
    Measurable
    (fun i ω => setup.generatedAxExtensionProcess generatedAxSample i ω)
    generatedAxSample
    T
    ⟨measurable_const, measurable_const, measurable_const,
      measurable_const, measurable_const⟩
    hstream
    hstep

/-- Projection of a measurable generated extension state to the feasible
output random variable. -/
theorem generatedExtensionFeasibleOutput_measurable_of_state
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t)
    (hstate :
      StochasticAcceleratedPrimalDualStateMapMeasurable
        (fun ω => setup.generatedAxExtensionProcess generatedAxSample t ω)) :
    Measurable (fun ω => setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω) := by
  have hxbar :
      Measurable
        (fun ω => (setup.generatedAxExtensionProcess generatedAxSample t ω).xBar.1) :=
    hstate.2.2.1.subtype_coe
  have hybar :
      Measurable
        (fun ω => (setup.generatedAxExtensionProcess generatedAxSample t ω).yBar.1) :=
    hstate.2.2.2.1.subtype_coe
  have hpair :
      Measurable (fun ω =>
        ((setup.generatedAxExtensionProcess generatedAxSample t ω).xBar.1,
          (setup.generatedAxExtensionProcess generatedAxSample t ω).yBar.1)) :=
    hxbar.prod hybar
  exact hpair.subtype_mk

/-- Measurability of the feasible output process generated by the explicit
generated-`A_hat_x` extension, under explicit stream/process regularity.

Theorem 4.8 writes `E[g(\bar z_{t+1})]`; this bridge records the Lean random
variable obligation for a regular generated extension without pretending that
every arbitrary `Ω`-indexed stream is measurable. -/
theorem generatedExtensionFeasibleOutput_measurable
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t)
    (hstream : GeneratedAxStreamMeasurableUpTo generatedAxSample t)
    (hstep : GeneratedAxExtensionOneStepMeasurableUpTo setup generatedAxSample t) :
    Measurable (fun ω => setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω) := by
  exact SOptLib.generatedProcessFeasibleOutput_measurable
    StochasticAcceleratedPrimalDualStateMapMeasurable
    Measurable
    (fun i ω => setup.generatedAxExtensionProcess generatedAxSample i ω)
    generatedAxSample
    (fun ω => setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω)
    t
    ⟨measurable_const, measurable_const, measurable_const,
      measurable_const, measurable_const⟩
    hstream
    hstep
    (setup.generatedExtensionFeasibleOutput_measurable_of_state generatedAxSample t ht)

/-- Measurability of the selected saddle-gap random variable in Theorem 4.8(a).

This is a derived object-layer obligation from the extension output process and
selected gap maximizer, not an extra hypothesis in Theorem 4.8. -/
theorem gap_generatedExtensionFeasibleOutput_measurable
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t)
    (hstream : GeneratedAxStreamMeasurableUpTo generatedAxSample t)
    (hstep : GeneratedAxExtensionOneStepMeasurableUpTo setup generatedAxSample t) :
    Measurable
      (fun ω => setup.gap (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω)) := by
  exact setup.gap_measurable_of_compact_value_function.comp
    (setup.generatedExtensionFeasibleOutput_measurable generatedAxSample t ht hstream hstep)

/-- Expected-bound rate term `Q_0(t)` from Theorem 4.8(a). -/
noncomputable def Q0 (t : ℕ) : ℝ :=
  primalDualExpectedGapBudget setup.beta setup.gamma setup.eta setup.tau
    setup.D_X setup.D_Y setup.sigmaX setup.sigmaY setup.p setup.q t

/-- Corrected expected-bound rate with an explicit per-index primal square-noise
budget.

This is the `Q_0` algebra from Theorem 4.8(a) with the primal variance
placeholder exposed as `SX i`.  For the source-faithful mixed-center
realization, `SX i` is `(2*sigmaXHatf^2 + 2*M i) + sigmaXA^2`, not the paper
shorthand `sigmaX^2`. -/
noncomputable def Q0WithPrimalBudget (t : ℕ) (SX : ℕ → ℝ) : ℝ :=
  primalDualExpectedGapBudgetWithPrimalNoiseBudget setup.beta setup.gamma
    setup.eta setup.tau setup.D_X setup.D_Y SX setup.sigmaY setup.p setup.q t

/-- Source-style descent envelope for an explicit generated `A_hat_x` stream.

An arbitrary generated stream is not a stochastic oracle realization and its
measurability alone gives no moment control.  This predicate records the
derived domination statement that must be proved from source-realization data
before using the generated extension in expectation arguments. -/
def GeneratedGapDescentEnvelope
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t) : Prop :=
  SOptLib.GapDescentEnvelope setup.P
    (fun ω =>
      setup.gap (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω))

/-- Build the generated absolute-value descent envelope from the source proof's
one-sided bound.

Lan's Theorem 4.8 proof first obtains a pathwise upper bound for the
nonnegative saddle gap, see Eq. (4.4.72).  The integrability consumer above is
phrased with norms, so this bridge converts any integrable one-sided upper
envelope into the existing absolute-value envelope using `gap_nonneg`, without
reintroducing a compact-convex-lsc global boundedness argument. -/
theorem GeneratedGapDescentEnvelope.of_nonnegative_upper_bound
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t)
    (B : Ω → ℝ) (hBint : Integrable B setup.P)
    (hupper :
      ∀ᵐ ω ∂setup.P,
        setup.gap (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω) ≤
          B ω) :
    setup.GeneratedGapDescentEnvelope generatedAxSample t ht := by
  exact SOptLib.GapDescentEnvelope.of_nonnegative_upper_bound hBint
    (by
      filter_upwards with ω
      exact setup.gap_nonneg
        (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω))
    hupper

/-- Source Eq. (4.4.72) envelope for the generated SAPD output.

The PDF does not prove an almost-sure deterministic bound `g(\bar z) <= Q0(t)`.
Eq. (4.4.72) is the pathwise inequality
`beta_t gamma_t g(\bar z_{t+1}) <= 2 gamma_t D_X^2 / eta_t
  + 2 gamma_t D_Y^2 / tau_t + U_t`, and Theorem 4.8(a) obtains `Q0(t)` only
after taking expectations and bounding `E[U_t]`.  This private leaf records
both parts of that source step: the pathwise envelope and the expected
upper bound for `U_t`.  It is not a setup field and does not reintroduce the
rejected compact-lsc global boundedness route. -/
private def GeneratedGapEq4472Envelope
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t) : Prop :=
  ∃ U : Ω → ℝ, Integrable U setup.P ∧
    (∫ ω, U ω ∂setup.P ≤
      (1 / 2) *
        Finset.sum (Finset.Icc 1 t) (fun i =>
          ((2 - setup.q) * setup.eta i * setup.gamma i / (1 - setup.q)) *
              setup.sigmaX ^ 2 +
            ((2 - setup.p) * setup.tau i * setup.gamma i / (1 - setup.p)) *
              setup.sigmaY ^ 2)) ∧
    (∀ᵐ ω ∂setup.P,
      setup.beta t * setup.gamma t *
          setup.gap (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω) ≤
        2 * setup.gamma t / setup.eta t * setup.D_X ^ 2 +
          2 * setup.gamma t / setup.tau t * setup.D_Y ^ 2 +
            U ω)

/-- Canonical source residual `U_t` from Eq. (4.4.71).

This is the random variable under the underbrace labelled `U_t` in the proof of
Theorem 4.8: the weighted square-noise terms plus the martingale inner-product
correction involving the auxiliary prox process `z_i^v` from Lemma 4.10.  The
definition is intentionally explicit so the Eq. (4.4.72)--(4.4.73) supplier no
longer hides the source construction behind an existential envelope. -/
noncomputable def generatedEq4471U
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ω : Ω) : ℝ :=
  SOptLib.twoStreamSquareNoiseAddWeightedMartingaleResidual (Ω := Ω) (ι := ℕ)
    (E := SapdPrimalSpace n) (F := SapdDualSpace m)
    (Finset.Icc 1 t) (fun i : ℕ => 1 ≤ i)
    (fun i hi ω => setup.deltaX generatedAxSample i hi ω)
    (fun i hi ω => setup.sapdDeltaY generatedAxSample i hi ω)
    (fun i ω =>
      let z₁ := setup.generatedZ generatedAxSample 1 ω
      ((setup.auxiliaryProcess generatedAxSample z₁ i ω).1.1,
        (setup.auxiliaryProcess generatedAxSample z₁ i ω).1.2))
    (fun i ω =>
      ((setup.generatedZ generatedAxSample i ω).1.1,
        (setup.generatedZ generatedAxSample i ω).1.2))
    setup.gamma setup.eta setup.tau setup.p setup.q ω

/-- Square-noise part of the canonical `U_t` from Eq. (4.4.71).

No SOptLib match: searched finite-sum square-noise and martingale residual
helpers.  SOptLib has generic variance and martingale tools, but Eq. (4.4.71)
has a paper-specific SAPD residual with the exact `(2-q)` and `(2-p)` weights,
so this local component is the literal source summand, not a replacement oracle
model. -/
noncomputable def generatedEq4471SquareNoiseU
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ω : Ω) : ℝ :=
  SOptLib.twoStreamSquareNoiseResidual (Finset.Icc 1 t) (fun i : ℕ => 1 ≤ i)
    (fun i hi ω => setup.deltaX generatedAxSample i hi ω)
    (fun i hi ω => setup.sapdDeltaY generatedAxSample i hi ω)
    (fun i => (2 - setup.q) * setup.eta i * setup.gamma i / (1 - setup.q))
    (fun i => (2 - setup.p) * setup.tau i * setup.gamma i / (1 - setup.p)) ω

/-- Corrected stage-separated square-noise part of the generated residual.

This is not the literal `U_t` from Eq. (4.4.71).  It is the source-order
corrected square-noise object in which the problematic same-sample
`A_hat_y(y_{i+1}; xi_i)` residual is replaced by the fresh-coordinate
`deltaXAStageSeparated`.  The pathwise source envelope still uses
`generatedEq4471U`; this object is only the variance component whose
Assumption 8 supplier is actually derivable from the generated realization. -/
noncomputable def generatedEq4471StageSeparatedSquareNoiseU
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ω : Ω) : ℝ :=
  Finset.sum (Finset.Icc 1 t) (fun i =>
    if hi : i ∈ Finset.Icc 1 t then
      (1 / 2 : ℝ) *
          (((2 - setup.q) * setup.eta i * setup.gamma i / (1 - setup.q)) *
              ‖setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω +
                setup.deltaXAStageSeparated generatedAxSample t i hi ω‖ ^ 2 +
            ((2 - setup.p) * setup.tau i * setup.gamma i / (1 - setup.p)) *
              ‖setup.sapdDeltaY generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2)
    else 0)

/-- Martingale inner-product part of the canonical `U_t` from Eq. (4.4.71).

No SOptLib match: searched conditional-expectation inner-product martingale
cancellation.  The reusable SOptLib lemmas prove cancellation for generic
residuals; this definition is the paper-local scalar random variable whose
cancellation must be supplied using those lemmas. -/
noncomputable def generatedEq4471MartingaleU
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ω : Ω) : ℝ :=
  SOptLib.weightedTwoBlockMartingaleResidual
    (I := Finset.Icc 1 t)
    (active := fun i => 1 ≤ i)
    (gamma := setup.gamma)
    (dx := fun i hi ω => setup.deltaX generatedAxSample i hi ω)
    (dy := fun i hi ω => setup.sapdDeltaY generatedAxSample i hi ω)
    (zv := fun i ω =>
      let z₁ := setup.generatedZ generatedAxSample 1 ω
      ((setup.auxiliaryProcess generatedAxSample z₁ i ω).1.1,
        (setup.auxiliaryProcess generatedAxSample z₁ i ω).1.2))
    (z := fun i ω =>
      ((setup.generatedZ generatedAxSample i ω).1.1,
        (setup.generatedZ generatedAxSample i ω).1.2))
    ω

/-- Eq. (4.4.71)'s canonical `U_t` is the sum of its square-noise and
martingale components. -/
theorem generatedEq4471U_eq_squareNoise_add_martingale
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) :
    (fun ω => setup.generatedEq4471U generatedAxSample t ω) =
      fun ω =>
        setup.generatedEq4471SquareNoiseU generatedAxSample t ω +
          setup.generatedEq4471MartingaleU generatedAxSample t ω := by
  funext ω
  simp [generatedEq4471U, generatedEq4471SquareNoiseU, generatedEq4471MartingaleU,
    SOptLib.twoStreamSquareNoiseAddWeightedMartingaleResidual_def]

/-- Pathwise Eq. (4.4.72), with the canonical `U_t` from Eq. (4.4.71).

This is a strictly smaller source leaf than `GeneratedGapEq4472Envelope`: it
contains only the almost-sure descent/envelope construction from Lemma 4.9,
Eq. (4.4.69), Eq. (4.4.71), Lemma 4.10, and the bounded Bregman-domain
condition (4.4.34). -/
private def GeneratedGapEq4472PathwiseCanonicalU
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t) : Prop :=
  SOptLib.pathwiseGapBoundWithResidual setup.P setup.gap
    (setup.generatedExtensionFeasibleOutput generatedAxSample t ht)
    (setup.beta t * setup.gamma t)
    (2 * setup.gamma t / setup.eta t * setup.D_X ^ 2)
    (2 * setup.gamma t / setup.tau t * setup.D_Y ^ 2)
    (setup.generatedEq4471U generatedAxSample t)

/-- Mean and integrability part of Eq. (4.4.73), for the canonical `U_t`.

This keeps the martingale cancellation and finite-sum moment algebra separate
from the pathwise descent inequality.  It is the exact expectation component
needed by Theorem 4.8(a), rather than a global compact-lsc boundedness
surrogate. -/
private def GeneratedEq4473CanonicalUMeanBound
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) : Prop :=
  Integrable (fun ω => setup.generatedEq4471U generatedAxSample t ω) setup.P ∧
    ∫ ω, setup.generatedEq4471U generatedAxSample t ω ∂setup.P ≤
      (1 / 2) *
        Finset.sum (Finset.Icc 1 t) (fun i =>
          ((2 - setup.q) * setup.eta i * setup.gamma i / (1 - setup.q)) *
              setup.sigmaX ^ 2 +
            ((2 - setup.p) * setup.tau i * setup.gamma i / (1 - setup.p)) *
              setup.sigmaY ^ 2)

/-- Square-noise expectation component of Eq. (4.4.73).

This is the finite-sum moment-algebra leaf: it should be proved from the
component Assumption 8 bridges for `Delta_x` and `Delta_y`, not from the
martingale cancellation argument. -/
private def GeneratedEq4473SquareNoiseMeanBound
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) : Prop :=
  Integrable (fun ω => setup.generatedEq4471SquareNoiseU generatedAxSample t ω) setup.P ∧
    ∫ ω, setup.generatedEq4471SquareNoiseU generatedAxSample t ω ∂setup.P ≤
      (1 / 2) *
        Finset.sum (Finset.Icc 1 t) (fun i =>
          ((2 - setup.q) * setup.eta i * setup.gamma i / (1 - setup.q)) *
              setup.sigmaX ^ 2 +
