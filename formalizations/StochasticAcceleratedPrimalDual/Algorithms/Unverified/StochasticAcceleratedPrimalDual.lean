/-- Finite-sum form of the source-realized `Δ_{x,A}^i` Assumption 8 bridge.

This is one of the generated Delta-x ingredients needed by the Lemma 4.10 /
Theorem 4.8 descent-envelope route.  It reduces the finite-sum obligation to
per-iteration measurability and fresh-sample independence of the actual
generated `y_{i+1}` query. -/
theorem generatedDeltaXA_finset_sqDeviation_integrable_and_bound_of_query_independence
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (T : ℕ)
    (hquery :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
        Measurable
          (fun ω => (setup.generatedAxExtensionProcess generatedAxSample i ω).y))
    (hindep :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
        IndepFun
          (fun ω => (setup.generatedAxExtensionProcess generatedAxSample i ω).y)
          (setup.ξ i) setup.P) :
    Integrable
        (fun ω =>
          Finset.sum (Finset.Icc 1 T) (fun i =>
            if hi : i ∈ Finset.Icc 1 T then
              ‖setup.deltaXA generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2
            else 0))
        setup.P ∧
      ∫ ω,
          Finset.sum (Finset.Icc 1 T) (fun i =>
            if hi : i ∈ Finset.Icc 1 T then
              ‖setup.deltaXA generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2
            else 0)
          ∂setup.P ≤
        Finset.sum (Finset.Icc 1 T) (fun _i => setup.sigmaXA ^ 2) := by
  classical
  let term : ℕ → Ω → ℝ := fun i ω =>
    if hi : i ∈ Finset.Icc 1 T then
      ‖setup.deltaXA generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2
    else 0
  have hterm_int : ∀ i ∈ Finset.Icc 1 T, Integrable (term i) setup.P := by
    intro i hi
    have hone :=
      setup.generatedDeltaXA_sqDeviation_integrable_and_bound_of_query_independence
        generatedAxSample i (Finset.mem_Icc.mp hi).1 (hquery i hi) (hindep i hi)
    have hterm_eq :
        term i =
          (fun ω =>
            ‖setup.deltaXA generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2) := by
      have hi_pair : 1 ≤ i ∧ i ≤ T := Finset.mem_Icc.mp hi
      funext ω
      simp [term, hi_pair]
    simpa [hterm_eq] using hone.1
  have hterm_bound :
      ∀ i ∈ Finset.Icc 1 T, ∫ ω, term i ω ∂setup.P ≤ setup.sigmaXA ^ 2 := by
    intro i hi
    have hone :=
      setup.generatedDeltaXA_sqDeviation_integrable_and_bound_of_query_independence
        generatedAxSample i (Finset.mem_Icc.mp hi).1 (hquery i hi) (hindep i hi)
    have hterm_eq :
        term i =
          (fun ω =>
            ‖setup.deltaXA generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2) := by
      have hi_pair : 1 ≤ i ∧ i ≤ T := Finset.mem_Icc.mp hi
      funext ω
      simp [term, hi_pair]
    simpa [hterm_eq] using hone.2
  constructor
  · simpa [term] using
      (integrable_finset_sum (s := Finset.Icc 1 T) (f := term) hterm_int)
  · calc
      ∫ ω, Finset.sum (Finset.Icc 1 T) (fun i => term i ω) ∂setup.P
          = Finset.sum (Finset.Icc 1 T) (fun i => ∫ ω, term i ω ∂setup.P) := by
            rw [integral_finset_sum (Finset.Icc 1 T) hterm_int]
      _ ≤ Finset.sum (Finset.Icc 1 T) (fun _i => setup.sigmaXA ^ 2) := by
            exact Finset.sum_le_sum hterm_bound

/-- Corrected non-original same-sample moment condition for
`Δ_{x,A}^i = A_hat_y(y_{i+1}; ξ_i) - Aᵀ y_{i+1}`.

The generated realization proves feasibility of the `A_hat_x(\tilde x_i)` calls,
but it does not make the post-dual-prox query `y_{i+1}` independent of the same
sample `ξ_i` that was used to construct it. The source proof of Theorem 4.8
uses Assumption 8 as if this finite-horizon same-sample moment bound were
