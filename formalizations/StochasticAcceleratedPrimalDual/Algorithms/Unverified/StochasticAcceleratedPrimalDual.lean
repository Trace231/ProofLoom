/-- Attainment obligation for the primal maximum in Eq. (4.4.1).

This is a source-facing theorem obligation, not a setup field. The paper writes
`max_{y ∈ Y}`; later proofs must discharge existence from the stated domain and
regularity hypotheses rather than relying on Lean's totalized supremum. -/
theorem primalMaximizer_exists (x : {x : SapdPrimalSpace n // x ∈ setup.X}) :
    ∃ y, y ∈ setup.Y ∧
      ∀ v, v ∈ setup.Y → setup.saddleObjective x.1 v ≤ setup.saddleObjective x.1 y := by
  have husc : UpperSemicontinuousOn (fun y : SapdDualSpace m => setup.saddleObjective x.1 y)
      setup.Y := by
    simpa [saddleObjective] using
      upperSemicontinuousOn_const_add_inner_sub_lsc
        (s := setup.Y) (c := setup.hatf x.1) (a := setup.A x.1)
        (g := setup.hatg) setup.hhatg_lsc
  exact
    SOptLib.exists_isMaxOn_of_bregman_bounded_upperSemicontinuousOn
      (Y := setup.Y) (F := fun y : SapdDualSpace m => setup.saddleObjective x.1 y)
      (y0 := setup.y₁) (D := setup.D_Y) (V := setup.VY)
      setup.hY_closed ⟨setup.y₁, setup.hy₁_mem⟩
      (by
        intro y hy
        simpa [dist_eq_norm] using setup.VY_modulus_one y setup.y₁ hy setup.hy₁_mem)
      (by
        intro y hy
        exact setup.VY_bounded setup.y₁ setup.hy₁_mem y hy)
      husc

