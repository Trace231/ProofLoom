/-- Finite-process measurability for the source-boundary Algorithm 4.3 state
under the totalized displayed-call realization.

Compared with `algorithm43SourceBoundaryState_measurable_of_realization`, this
theorem does not need the source-domain coverage predicate merely to prove Lean
measurability: the displayed `A_x(\tilde x_i)` call now unfolds to
`SOptLib.totalizeOn` of the fixed-domain oracle.  The remaining one-step input is
the selected-prox measurability interface. -/
private theorem algorithm43SourceBoundaryState_measurable_of_totalized_boundary
    (T : ℕ) (hstep : setup.Algorithm43SourceBoundaryOneStepMeasurableUpTo T) :
    ∀ i, 1 ≤ i → i ≤ T + 1 →
      StochasticAcceleratedPrimalDualStateMapMeasurable
        (fun ω => setup.algorithm43SourceBoundaryState i ω) := by
  intro i hi hT
  induction i using Nat.strong_induction_on with
  | h i ih =>
      cases i with
      | zero => cases hi
      | succ k =>
          cases k with
          | zero =>
              simpa [algorithm43SourceBoundaryState_init] using
                (show StochasticAcceleratedPrimalDualStateMapMeasurable
                    (fun _ω : Ω => setup.initialState) by
                  exact ⟨measurable_const, measurable_const, measurable_const,
                    measurable_const, measurable_const⟩)
          | succ k =>
              have hprev :
                  StochasticAcceleratedPrimalDualStateMapMeasurable
                    (fun ω => setup.algorithm43SourceBoundaryState (k + 1) ω) := by
                exact ih (k + 1) (by omega) (by omega) (by omega)
              have hkpos : 1 ≤ k + 1 := by omega
              have hkT : k + 1 ≤ T := by omega
              have hax :
                  Measurable (fun ω => setup.algorithm43SourceBoundaryAxTildeCall (k + 1) ω) :=
                setup.algorithm43SourceBoundaryAxTildeCall_measurable_of_state (k + 1) hprev
              exact hstep (k + 1) hkpos hkT hprev hax

