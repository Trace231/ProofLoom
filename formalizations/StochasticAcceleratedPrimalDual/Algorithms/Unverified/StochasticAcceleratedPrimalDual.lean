    (setup.DualProxSelectorContinuousAt_of_variational_stability t ht)

/-- Once the dual compact/lsc strongly-convex measurable-selection theorem is
available, the selected-prox package no longer needs a separate primal
regularity input: the primal side follows from the compact continuous unique
argmin route above. -/
theorem selectedProxSelectorsMeasurableAt_of_dual_lsc_and_primal_unique
    (t : ℕ) (ht : 1 ≤ t)
    (hdual : setup.DualProxSelectorMeasurableAt t ht) :
    setup.SelectedProxSelectorsMeasurableAt t ht :=
  ⟨hdual, setup.PrimalProxSelectorMeasurableAt_of_compact_continuous_unique t ht⟩

/-- Selected-prox regularity for Algorithm 4.3 from the source compact/lsc
dual selector route and the compiled primal compact-continuous route. -/
theorem SelectedProxSelectorsMeasurableAt_of_compact_lsc_stronglyConvex_selection
    (t : ℕ) (ht : 1 ≤ t)
    (hdual : setup.DualProxSelectorMeasurableAt t ht) :
    setup.SelectedProxSelectorsMeasurableAt t ht :=
  setup.selectedProxSelectorsMeasurableAt_of_dual_lsc_and_primal_unique t ht
    hdual

/-- Selected-prox regularity from continuity of the dual Eq. (4.4.56) selector
and the compact-continuous primal route. -/
theorem SelectedProxSelectorsMeasurableAt_of_dual_selector_continuity
    (t : ℕ) (ht : 1 ≤ t)
    (hcont : setup.DualProxSelectorContinuousAt t ht) :
    setup.SelectedProxSelectorsMeasurableAt t ht :=
  setup.selectedProxSelectorsMeasurableAt_of_dual_lsc_and_primal_unique t ht
    (setup.DualProxSelectorMeasurableAt_of_dual_selector_continuity t ht hcont)

/-- Direct selected-prox regularity supplier for Algorithm 4.3.

The dual side is supplied by variational stability of the actual lsc Bregman
prox selector; the primal side is supplied by the compact continuous unique
argmin route. -/
theorem SelectedProxSelectorsMeasurableAt_of_variational_stability
    (t : ℕ) (ht : 1 ≤ t) :
    setup.SelectedProxSelectorsMeasurableAt t ht :=
  setup.selectedProxSelectorsMeasurableAt_of_dual_lsc_and_primal_unique t ht
    (setup.DualProxSelectorMeasurableAt_of_variational_stability t ht)

/-- The actual selected-prox maps used by Algorithm 4.3 are measurable at a
fixed positive time once both parameterized argmin selectors are measurable.

The previous reconstruction tried to close this through no-premise
`...from_compact_lsc_measurable_selection` theorems. That was too strong:
`LowerSemicontinuousOn.exists_isMinOn` gives pointwise minimizers only, and the
only compiled SOptLib selector-measurability terminal currently available is
`proxStep_measurable_of_joint_continuous_unique`, which assumes joint
continuity. The dual paper objective includes the merely lsc term `hatg`, so
the compact/lsc measurable-selection theorem remains a genuine internal
regularity boundary rather than a theorem proved from the present setup. -/
theorem selectedProxSelectorsMeasurableAt_of_components
    (t : ℕ) (ht : 1 ≤ t)
    (hdual : setup.DualProxSelectorMeasurableAt t ht)
    (hprimal : setup.PrimalProxSelectorMeasurableAt t ht) :
    setup.SelectedProxSelectorsMeasurableAt t ht :=
  ⟨hdual, hprimal⟩

theorem selectedProxSelectorsMeasurableAt.dual
    (t : ℕ) (ht : 1 ≤ t)
    (hsel : setup.SelectedProxSelectorsMeasurableAt t ht) :
    setup.DualProxSelectorMeasurableAt t ht :=
  hsel.1

theorem selectedProxSelectorsMeasurableAt.primal
    (t : ℕ) (ht : 1 ≤ t)
    (hsel : setup.SelectedProxSelectorsMeasurableAt t ht) :
    setup.PrimalProxSelectorMeasurableAt t ht :=
  hsel.2

/-- Ambient value of the extrapolated point `\tilde x_{t+1}` from Eq. (4.4.17).

No SOptLib match: the candidate digest for extrapolation was empty, and
`Model.Iterates` process helpers do not encode this APD extrapolation formula. -/
noncomputable def extrapolateXValue (t : ℕ)
    (xPrev xNext : {x : SapdPrimalSpace n // x ∈ setup.X}) : SapdPrimalSpace n :=
  SOptLib.acceleratedExtrapolateValue setup.theta t xPrev.1 xNext.1

/-- Convexity alone cannot justify the source-boundary coverage
`\tilde x_t ∈ X` for Eq. (4.4.56).

The APD extrapolate is `(1 + θ) x_{t+1} - θ x_t`, not a convex combination.
This one-dimensional counterexample prevents later source-boundary work from
trying to derive the fixed-domain `A_hat_x(\tilde x_t)` semantics from the
same convexity argument used for the averaged outputs. -/
private theorem extrapolateXValue_convexity_coverage_counterexample :
    ∃ (X : Set ℝ) (xPrev xNext θ : ℝ),
      IsClosed X ∧ Convex ℝ X ∧ xPrev ∈ X ∧ xNext ∈ X ∧ 0 < θ ∧
        θ • (xNext - xPrev) + xNext ∉ X := by
  refine ⟨Set.Icc (0 : ℝ) 1, 0, 1, 1, isClosed_Icc, convex_Icc 0 1, ?_, ?_, ?_, ?_⟩
  · norm_num
  · norm_num
  · norm_num
  · norm_num

/-- Ambient value of the primal aggregate update `\bar x_{t+1}` from
Eq. (4.4.18).

Considered `SOptLib.Model.Iterates.weightedOutputAverage`; it is a finite-window
output average, not this one-step APD running aggregate recurrence. -/
noncomputable def averageXValue (t : ℕ)
    (xBarPrev xNext : {x : SapdPrimalSpace n // x ∈ setup.X}) : SapdPrimalSpace n :=
  (1 - (setup.beta t)⁻¹) • xBarPrev.1 + (setup.beta t)⁻¹ • xNext.1

/-- Feasibility of the primal aggregate generated by Eq. (4.4.18). -/
theorem averageXValue_mem (t : ℕ) (ht : 1 ≤ t)
    (xBarPrev xNext : {x : SapdPrimalSpace n // x ∈ setup.X}) :
    setup.averageXValue t xBarPrev xNext ∈ setup.X := by
  rcases inv_beta_convex_weights setup t ht with ⟨hleft, hright, hsum⟩
  simpa [averageXValue] using setup.hX_convex xBarPrev.2 xNext.2 hleft hright hsum

/-- Feasible primal aggregate update `\bar x_{t+1}` from Eq. (4.4.18). -/
noncomputable def averageX (t : ℕ) (ht : 1 ≤ t)
    (xBarPrev xNext : {x : SapdPrimalSpace n // x ∈ setup.X}) :
    {x : SapdPrimalSpace n // x ∈ setup.X} :=
  ⟨setup.averageXValue t xBarPrev xNext, setup.averageXValue_mem t ht xBarPrev xNext⟩

/-- Ambient value of the dual aggregate update `\bar y_{t+1}` from Eq. (4.4.19).

Considered `SOptLib.Model.Iterates.weightedOutputAverage`; it is a finite-window
output average, not this one-step APD running aggregate recurrence. -/
noncomputable def averageYValue (t : ℕ)
    (yBarPrev yNext : {y : SapdDualSpace m // y ∈ setup.Y}) : SapdDualSpace m :=
  (1 - (setup.beta t)⁻¹) • yBarPrev.1 + (setup.beta t)⁻¹ • yNext.1

/-- Feasibility of the dual aggregate generated by Eq. (4.4.19). -/
theorem averageYValue_mem (t : ℕ) (ht : 1 ≤ t)
    (yBarPrev yNext : {y : SapdDualSpace m // y ∈ setup.Y}) :
    setup.averageYValue t yBarPrev yNext ∈ setup.Y := by
  rcases inv_beta_convex_weights setup t ht with ⟨hleft, hright, hsum⟩
  simpa [averageYValue] using setup.hY_convex yBarPrev.2 yNext.2 hleft hright hsum

/-- Algorithm 4.3 initial state:
`x_1 = \bar x_1 = \tilde x_1` and `y_1 = \bar y_1`.

Chosen alignment: considered `SOptLib.iterateProcessView`; it exposes a time
slice of an already-built process, while Algorithm 4.3 gives this paper-specific
initial APD state explicitly. -/
noncomputable def initialState :
    StochasticAcceleratedPrimalDualState n m setup.X setup.Y :=
  SOptLib.acceleratedPrimalDualInitialState setup.x₁ setup.y₁ setup.hx₁_mem setup.hy₁_mem

/-- One APD transition, bundling Eq. (4.4.14) and Eq. (4.4.56)--(4.4.19).

This is the canonical single-step algorithmic spine: sampled oracle values and
prox points are derived from the setup kernels and argmin definitions instead
of being stored as theorem-local hypotheses. Because the source does not
justify the generated `\hat A_x(\tilde x_t)` query from the fixed-domain SFO,
the value of that generated sample is supplied explicitly by the extension
realization argument. -/
noncomputable def stepFromGeneratedAx
    (t : ℕ) (ht : 1 ≤ t)
    (axTildeSample : SapdDualSpace m)
    (st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y) (ω : Ω) :
    StochasticAcceleratedPrimalDualState n m setup.X setup.Y :=
  acceleratedPrimalDualStep
    (fun _ st ax ω => setup.dualProx t ht ax st.y ω)
    (fun _ st yNext ω => setup.primalProx t ht st.x st.x yNext ω)
    (fun _ xPrev xNext => setup.extrapolateXValue t xPrev xNext)
    (fun _ xBarPrev xNext => setup.averageX t ht xBarPrev xNext)
    (fun _ yBarPrev yNext =>
      ⟨SOptLib.acceleratedAveragePoint (fun k => (setup.beta k)⁻¹) ⟨t, ht⟩
          yBarPrev.1 yNext.1,
        SOptLib.acceleratedAveragePoint_mem setup.hY_convex
          (fun k => (setup.beta k)⁻¹) ⟨t, ht⟩
          (inv_beta_mem_Icc setup t ht) yBarPrev.2 yNext.2⟩)
    t axTildeSample st ω

/-- Concrete one-step measurability of `stepFromGeneratedAx` from the
parameterized selected-prox maps.

This is the compiled consumer requested by the reconstruction audit: it uses
the actual `dualProx`/`primalProx` definitions, random-query oracle
measurability, and measurable arithmetic for the APD extrapolation/averages.
The only remaining selector leaf is measurability of the deterministic
compact-argmin maps `dualProxSelector` and `primalProxSelector`. -/
theorem stepFromGeneratedAx_measurable_of_selector_measurable
    (t : ℕ) (ht : 1 ≤ t)
    (hdualSelector :
      Measurable (fun p : {y : SapdDualSpace m // y ∈ setup.Y} × SapdDualSpace m × ℝ =>
        setup.dualProxSelector t ht p.2.1 p.1))
    (hprimalSelector :
      Measurable
        (fun p :
          {x : SapdPrimalSpace n // x ∈ setup.X} ×
            (SapdPrimalSpace n × SapdPrimalSpace n) × ℝ =>
          setup.primalProxSelector t ht p.2.1.1 p.2.1.2 p.1))
    {axTildeSample : Ω → SapdDualSpace m}
    {state : Ω → StochasticAcceleratedPrimalDualState n m setup.X setup.Y}
    (hax : Measurable axTildeSample)
    (hstate : StochasticAcceleratedPrimalDualStateMapMeasurable state) :
    StochasticAcceleratedPrimalDualStateMapMeasurable
      (fun ω => setup.stepFromGeneratedAx t ht (axTildeSample ω) (state ω) ω) := by
  simpa [StochasticAcceleratedPrimalDualStateMapMeasurable, stepFromGeneratedAx,
    primalProx, dualProx] using
    (generatedDriverAcceleratedPrimalDualStep_measurable_of_components
      (dualStep := fun _ ax yPrev ω => setup.dualProx t ht ax yPrev ω)
      (primalStep := fun _ xPrev gSample aySample _ω =>
        setup.primalProxSelector t ht gSample aySample xPrev)
      (gradientSample := fun _ xQuery ω => setup.sampledG t xQuery ω)
      (adjointSample := fun _ yQuery ω => setup.sampledAy t yQuery ω)
      (extrapolate := fun _ xPrev xNext => setup.extrapolateXValue t xPrev xNext)
      (avgX := fun _ xBarPrev xNext => setup.averageX t ht xBarPrev xNext)
      (avgY := fun _ yBarPrev yNext =>
        (⟨SOptLib.acceleratedAveragePoint (fun k => (setup.beta k)⁻¹) ⟨t, ht⟩
            yBarPrev.1 yNext.1,
          SOptLib.acceleratedAveragePoint_mem setup.hY_convex
            (fun k => (setup.beta k)⁻¹) ⟨t, ht⟩
            (inv_beta_mem_Icc setup t ht) yBarPrev.2 yNext.2⟩ :
          {y : SapdDualSpace m // y ∈ setup.Y}))
      (t := t)
      (driver := axTildeSample)
      (state := state)
      hax hstate
      (by
        intro driver' yPrev hdriver' hyPrev
        exact setup.dualProx_measurable_of_selector_measurable t ht
          hdualSelector hdriver' hyPrev)
      (by
        intro xQuery hxQuery
        exact setup.sampledG_measurable_of_query hxQuery t ht)
      (by
        intro yQuery hyQuery
        exact setup.sampledAy_measurable_of_query hyQuery t ht)
      (by
        intro xPrev gSample aySample hxPrev hgSample haySample
        exact setup.primalProx_measurable_of_selector_measurable t ht
          hprimalSelector hxPrev hgSample haySample)
      (by
        intro xPrev xNext hxPrev hxNext
        have hxPrev_coe : Measurable (fun ω => (xPrev ω).1) :=
          hxPrev.subtype_coe
        have hxNext_coe : Measurable (fun ω => (xNext ω).1) :=
          hxNext.subtype_coe
        simpa [extrapolateXValue] using
          ((hxNext_coe.sub hxPrev_coe).const_smul (setup.theta (t + 1))).add
            hxNext_coe)
      (by
        intro xBarPrev xNext hxBarPrev hxNext
        have hxBarPrev_coe : Measurable (fun ω => (xBarPrev ω).1) :=
          hxBarPrev.subtype_coe
        have hxNext_coe : Measurable (fun ω => (xNext ω).1) :=
          hxNext.subtype_coe
        have hamb :
            Measurable
              (fun ω =>
                setup.averageXValue t (xBarPrev ω) (xNext ω)) := by
          simpa [averageXValue] using
            (hxBarPrev_coe.const_smul (1 - (setup.beta t)⁻¹)).add
              (hxNext_coe.const_smul ((setup.beta t)⁻¹))
        simpa [averageX] using hamb.subtype_mk)
      (by
        intro yBarPrev yNext hyBarPrev hyNext
        have hyBarPrev_coe : Measurable (fun ω => (yBarPrev ω).1) :=
          hyBarPrev.subtype_coe
        have hyNext_coe : Measurable (fun ω => (yNext ω).1) :=
          hyNext.subtype_coe
        have hamb :
            Measurable
              (fun ω =>
                setup.averageYValue t (yBarPrev ω) (yNext ω)) := by
          simpa [averageYValue] using
            (hyBarPrev_coe.const_smul (1 - (setup.beta t)⁻¹)).add
              (hyNext_coe.const_smul ((setup.beta t)⁻¹))
        refine Measurable.subtype_mk ?_
        simpa [SOptLib.acceleratedAveragePoint, averageYValue] using hamb))

/-- Filtration-relative one-step measurability of `stepFromGeneratedAx`.

This is the adapted version of
`stepFromGeneratedAx_measurable_of_selector_measurable`: if the previous APD
state, the explicit generated `A_x` sample, and the fresh oracle coordinate are
measurable with respect to the same sigma algebra, then the next generated
state is measurable with respect to that sigma algebra. -/
theorem stepFromGeneratedAx_measurableAt_of_selector_measurable
    (t : ℕ) (ht : 1 ≤ t) (r : ℕ)
    (hdualSelector :
      Measurable (fun p : {y : SapdDualSpace m // y ∈ setup.Y} × SapdDualSpace m × ℝ =>
        setup.dualProxSelector t ht p.2.1 p.1))
    (hprimalSelector :
      Measurable
        (fun p :
          {x : SapdPrimalSpace n // x ∈ setup.X} ×
            (SapdPrimalSpace n × SapdPrimalSpace n) × ℝ =>
          setup.primalProxSelector t ht p.2.1.1 p.2.1.2 p.1))
    {axTildeSample : Ω → SapdDualSpace m}
    {state : Ω → StochasticAcceleratedPrimalDualState n m setup.X setup.Y}
    (hξ : Measurable[(setup.filtration).seq r] (setup.ξ t))
    (hax : Measurable[(setup.filtration).seq r] axTildeSample)
    (hstate : StochasticAcceleratedPrimalDualStateMapMeasurableAt (n := n) (m := m)
      ((setup.filtration).seq r) state) :
    StochasticAcceleratedPrimalDualStateMapMeasurableAt (n := n) (m := m)
      ((setup.filtration).seq r)
      (fun ω => setup.stepFromGeneratedAx t ht (axTildeSample ω) (state ω) ω) := by
  let yNext : Ω → {y : SapdDualSpace m // y ∈ setup.Y} :=
    fun ω => setup.dualProx t ht (axTildeSample ω) (state ω).y ω
  have hyNext : Measurable[(setup.filtration).seq r] yNext := by
    have hparam :
        Measurable[(setup.filtration).seq r] (fun ω : Ω =>
          ((state ω).y, axTildeSample ω, setup.tau t)) :=
      hstate.2.1.prod (hax.prod measurable_const)
    simpa [dualProx, yNext] using hdualSelector.comp hparam
  let gSample : Ω → SapdPrimalSpace n :=
    fun ω => setup.sampledG t (state ω).x ω
  have hgSample : Measurable[(setup.filtration).seq r] gSample := by
    simpa [sampledG, SOptLib.oracleKernel, gSample] using
      (@SOptLib.sampledOracle_measurable
        Ω {x : SapdPrimalSpace n // x ∈ setup.X} S (SapdPrimalSpace n)
        ((setup.filtration).seq r) (by infer_instance) (by infer_instance) (by infer_instance)
        (oracle := setup.oracleG)
        (x := fun ω => (state ω).x)
        (ξ := setup.ξ t)
        setup.horacleG_measurable
        hstate.1
        hξ)
  let aySample : Ω → SapdPrimalSpace n :=
    fun ω => setup.sampledAy t (yNext ω) ω
  have haySample : Measurable[(setup.filtration).seq r] aySample := by
    simpa [sampledAy, SOptLib.oracleKernel, aySample] using
      (@SOptLib.sampledOracle_measurable
        Ω {y : SapdDualSpace m // y ∈ setup.Y} S (SapdPrimalSpace n)
        ((setup.filtration).seq r) (by infer_instance) (by infer_instance) (by infer_instance)
        (oracle := setup.oracleAy)
        (x := yNext)
        (ξ := setup.ξ t)
        setup.horacleAy_measurable
        hyNext
        hξ)
  let xNext : Ω → {x : SapdPrimalSpace n // x ∈ setup.X} :=
    fun ω => setup.primalProxSelector t ht (gSample ω) (aySample ω) (state ω).x
  have hxNext : Measurable[(setup.filtration).seq r] xNext := by
    have hparam :
        Measurable[(setup.filtration).seq r] (fun ω : Ω =>
          ((state ω).x, (gSample ω, aySample ω), setup.eta t)) :=
      hstate.1.prod ((hgSample.prod haySample).prod measurable_const)
    simpa [xNext] using hprimalSelector.comp hparam
  have hxTildeNext :
      Measurable[(setup.filtration).seq r]
        (fun ω =>
          setup.extrapolateXValue t (state ω).x (xNext ω)) := by
    have hxPrev_coe : Measurable[(setup.filtration).seq r] (fun ω => ((state ω).x).1) :=
      hstate.1.subtype_coe
    have hxNext_coe : Measurable[(setup.filtration).seq r] (fun ω => (xNext ω).1) :=
      hxNext.subtype_coe
    simpa [extrapolateXValue] using
      ((hxNext_coe.sub hxPrev_coe).const_smul (setup.theta (t + 1))).add hxNext_coe
  have hxBarNext :
      Measurable[(setup.filtration).seq r]
        (fun ω =>
          setup.averageX t ht (state ω).xBar (xNext ω)) := by
    have hxBarPrev_coe :
        Measurable[(setup.filtration).seq r] (fun ω => ((state ω).xBar).1) :=
      hstate.2.2.1.subtype_coe
    have hxNext_coe : Measurable[(setup.filtration).seq r] (fun ω => (xNext ω).1) :=
      hxNext.subtype_coe
    have hamb :
        Measurable[(setup.filtration).seq r]
          (fun ω =>
            setup.averageXValue t (state ω).xBar (xNext ω)) := by
      simpa [averageXValue] using
        (hxBarPrev_coe.const_smul (1 - (setup.beta t)⁻¹)).add
          (hxNext_coe.const_smul ((setup.beta t)⁻¹))
    simpa [averageX] using hamb.subtype_mk
  have hyBarNext :
      Measurable[(setup.filtration).seq r]
        (fun ω =>
          (⟨SOptLib.acceleratedAveragePoint (fun k => (setup.beta k)⁻¹) ⟨t, ht⟩
              ((state ω).yBar).1 (yNext ω).1,
            SOptLib.acceleratedAveragePoint_mem setup.hY_convex
              (fun k => (setup.beta k)⁻¹) ⟨t, ht⟩
              (inv_beta_mem_Icc setup t ht) ((state ω).yBar).2 (yNext ω).2⟩ :
            {y : SapdDualSpace m // y ∈ setup.Y})) := by
    have hyBarPrev_coe :
        Measurable[(setup.filtration).seq r] (fun ω => ((state ω).yBar).1) :=
      hstate.2.2.2.1.subtype_coe
    have hyNext_coe : Measurable[(setup.filtration).seq r] (fun ω => (yNext ω).1) :=
      hyNext.subtype_coe
    have hamb :
        Measurable[(setup.filtration).seq r]
          (fun ω =>
            setup.averageYValue t (state ω).yBar (yNext ω)) := by
      simpa [averageYValue] using
        (hyBarPrev_coe.const_smul (1 - (setup.beta t)⁻¹)).add
          (hyNext_coe.const_smul ((setup.beta t)⁻¹))
    refine Measurable.subtype_mk ?_
    simpa [SOptLib.acceleratedAveragePoint, averageYValue] using hamb
  simpa [StochasticAcceleratedPrimalDualStateMapMeasurableAt, stepFromGeneratedAx,
    acceleratedPrimalDualStep,
    yNext, xNext, gSample, aySample] using
    (show
      Measurable[(setup.filtration).seq r] xNext ∧
        Measurable[(setup.filtration).seq r] yNext ∧
        Measurable[(setup.filtration).seq r]
        (fun ω => setup.averageX t ht (state ω).xBar (xNext ω)) ∧
        Measurable[(setup.filtration).seq r]
          (fun ω =>
            (⟨SOptLib.acceleratedAveragePoint (fun k => (setup.beta k)⁻¹) ⟨t, ht⟩
                ((state ω).yBar).1 (yNext ω).1,
              SOptLib.acceleratedAveragePoint_mem setup.hY_convex
                (fun k => (setup.beta k)⁻¹) ⟨t, ht⟩
                (inv_beta_mem_Icc setup t ht) ((state ω).yBar).2 (yNext ω).2⟩ :
              {y : SapdDualSpace m // y ∈ setup.Y})) ∧
      Measurable[(setup.filtration).seq r]
        (fun ω => setup.extrapolateXValue t (state ω).x (xNext ω)) from
      ⟨hxNext, hyNext, hxBarNext, hyBarNext, hxTildeNext⟩)

/-- Fixed-domain realization of Algorithm 4.3's displayed
`\hat A_x(\tilde x_t)` call, as a partial object.

This is the source-domain faithful alternative to the opaque displayed-call
placeholder: Eq. (4.4.6) only defines the SFO at feasible `x ∈ X`, while
Algorithm 4.3 Eq. (4.4.56) queries the ambient extrapolate `\tilde x_t`.
No SOptLib match: searched `recursive iterate process` and `staged oracle value
random query`, checked `SOptLib.iterateProcessView`, `SOptLib.oracleKernel`,
and `SOptLib.stagedOracleValue`, and scanned `Model/Iterates.lean` and
`Model/StochasticOracle.lean`; they provide generic iterate views and
fixed-domain oracle kernels, but no partial APD transition exposing the
generated-query domain boundary from Lan Eq. (4.4.6)/(4.4.56). -/
noncomputable def fixedDomainAxTildeSample?
    (t : ℕ)
    (st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y) (ω : Ω) :
    Option (SapdDualSpace m) :=
  SOptLib.fixedDomainOracleSample? setup.X (setup.sampledAx t)
    (fun st => st.xTilde) st ω

/-- Partial fixed-domain APD transition for Algorithm 4.3.

The transition is computed from the actual fixed-domain oracle `oracleAx` when
the generated extrapolate is feasible and is undefined otherwise. This keeps the
missing `\tilde x_t ∈ X` bridge at the object layer instead of totalizing the
oracle call or adding it as a theorem-head assumption. -/
noncomputable def stepFromFixedDomainAx?
    (t : ℕ) (ht : 1 ≤ t)
    (st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y) (ω : Ω) :
    Option (StochasticAcceleratedPrimalDualState n m setup.X setup.Y) :=
  match setup.fixedDomainAxTildeSample? t st ω with
  | some axTildeSample => some (setup.stepFromGeneratedAx t ht axTildeSample st ω)
  | none => none

theorem stepFromFixedDomainAx?_eq_none_of_not_mem
    (t : ℕ) (ht : 1 ≤ t)
    (st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y) (ω : Ω)
    (hnot : ¬ st.xTilde ∈ setup.X) :
    setup.stepFromFixedDomainAx? t ht st ω = none := by
  simp [stepFromFixedDomainAx?, fixedDomainAxTildeSample?, hnot]

theorem stepFromFixedDomainAx?_eq_some_of_mem
    (t : ℕ) (ht : 1 ≤ t)
    (st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y) (ω : Ω)
    (hmem : st.xTilde ∈ setup.X) :
    setup.stepFromFixedDomainAx? t ht st ω =
      some (setup.stepFromGeneratedAx t ht
        (setup.sampledAx t ⟨st.xTilde, hmem⟩ ω) st ω) := by
  simp [stepFromFixedDomainAx?, fixedDomainAxTildeSample?, hmem]

/-- Fixed-domain partial Algorithm 4.3 state process.

This recursive state is generated only from the source-stated SFO domain in
Eq. (4.4.6). It returns `none` exactly when the next displayed
`\hat A_x(\tilde x_t)` call would require an unstated feasibility bridge for
the ambient extrapolate. It is therefore a canonical source-boundary object, not
an extension theorem and not a completion of Theorem 4.8. -/
noncomputable def algorithm43FixedDomainState? :
    ℕ → Ω → Option (StochasticAcceleratedPrimalDualState n m setup.X setup.Y) :=
  SOptLib.partialRecursivePositiveTimeProcess setup.initialState
    (fun t prev ω =>
      if ht : 1 ≤ t then
        setup.stepFromFixedDomainAx? t ht prev ω
      else
        none)

theorem algorithm43FixedDomainState?_init (ω : Ω) :
    setup.algorithm43FixedDomainState? 1 ω = some setup.initialState := by
  rfl

theorem algorithm43FixedDomainState?_step
    (t : ℕ) (ht : 1 ≤ t) (ω : Ω) :
    setup.algorithm43FixedDomainState? (t + 1) ω =
      (setup.algorithm43FixedDomainState? t ω).bind
        (fun st => setup.stepFromFixedDomainAx? t ht st ω) := by
  rw [algorithm43FixedDomainState?]
  rw [SOptLib.partialRecursivePositiveTimeProcess_succ setup.initialState
    (fun t prev ω =>
      if ht : 1 ≤ t then
        setup.stepFromFixedDomainAx? t ht prev ω
      else
        none) t ht ω]
  simp [algorithm43FixedDomainState?, ht]

/-- Optional paper output `\bar z_{t+1}` from the fixed-domain partial
Algorithm 4.3 process. -/
noncomputable def algorithm43FixedDomainOutput? (t : ℕ) (_ht : 1 ≤ t) (ω : Ω) :
    Option {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
  match setup.algorithm43FixedDomainState? (t + 1) ω with
  | some st => some ⟨(st.xBar.1, st.yBar.1), ⟨st.xBar.2, st.yBar.2⟩⟩
  | none => none

/-- Completion predicate for the fixed-domain partial Algorithm 4.3 process up
to output time `t`.

This predicate is not a paper theorem hypothesis. It names exactly the missing
source-boundary proof obligation: every displayed generated `\hat A_x(\tilde
x_i)` query must be feasible before the fixed-domain SFO can generate the
paper's displayed stochastic APD state. -/
def Algorithm43FixedDomainComplete (t : ℕ) : Prop :=
  ∀ i, i ∈ Finset.Icc 1 t → ∀ ω : Ω,
    ∃ st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y,
      setup.algorithm43FixedDomainState? i ω = some st ∧ st.xTilde ∈ setup.X

/-- Selected fixed-domain state under an explicit completion proof.

This is corrected/extension-only machinery: it does not add the missing
`\tilde x_i ∈ X` bridge to the paper theorem head, but it gives later proof
phases a non-opaque state object whenever the fixed-domain partial Algorithm 4.3
process is known to complete. The paper-facing name is retained for callers;
the body delegates to the generic completed partial-process selector. -/
noncomputable def algorithm43FixedDomainStateOfComplete
    (T i : ℕ) (hcomplete : setup.Algorithm43FixedDomainComplete T)
    (hi : i ∈ Finset.Icc 1 T) (ω : Ω) :
    StochasticAcceleratedPrimalDualState n m setup.X setup.Y :=
  SOptLib.partialProcessStateOfComplete setup.algorithm43FixedDomainState?
    (fun st => st.xTilde ∈ setup.X) T i hcomplete hi ω

theorem algorithm43FixedDomainStateOfComplete_spec
    (T i : ℕ) (hcomplete : setup.Algorithm43FixedDomainComplete T)
    (hi : i ∈ Finset.Icc 1 T) (ω : Ω) :
    setup.algorithm43FixedDomainState? i ω =
        some (setup.algorithm43FixedDomainStateOfComplete T i hcomplete hi ω) ∧
      (setup.algorithm43FixedDomainStateOfComplete T i hcomplete hi ω).xTilde ∈ setup.X :=
  Classical.choose_spec (hcomplete i hi ω)

/-- One-step transport for the completed fixed-domain Algorithm 4.3 process.

This is the concrete equality bridge needed to move fixed-domain statements to
the generated-extension Lemma 4.9 route: once completion supplies
`\tilde x_i ∈ X`, the partial fixed-domain transition is exactly
`stepFromGeneratedAx` driven by the fixed-domain `sampledAx` call at that
selected extrapolate. -/
theorem algorithm43FixedDomainStateOfComplete_succ_eq_stepFromGeneratedAx
    (T i : ℕ) (hcomplete : setup.Algorithm43FixedDomainComplete T)
    (hi : i ∈ Finset.Icc 1 T) (hi_next : i + 1 ∈ Finset.Icc 1 T)
    (hi_pos : 1 ≤ i) (ω : Ω) :
    let st := setup.algorithm43FixedDomainStateOfComplete T i hcomplete hi ω
    let hxtilde := (setup.algorithm43FixedDomainStateOfComplete_spec T i hcomplete hi ω).2
    setup.algorithm43FixedDomainStateOfComplete T (i + 1) hcomplete hi_next ω =
      setup.stepFromGeneratedAx i hi_pos
        (setup.sampledAx i ⟨st.xTilde, hxtilde⟩ ω) st ω := by
  exact
    SOptLib.partialProcessStateOfComplete_succ_eq_generatedStep
      setup.algorithm43FixedDomainState?
      (fun st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y =>
        st.xTilde ∈ setup.X)
      (fun st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y => st.xTilde)
      setup.sampledAx
      (fun _ st ω => setup.stepFromFixedDomainAx? i hi_pos st ω)
      (fun _ ax st ω => setup.stepFromGeneratedAx i hi_pos ax st ω)
      (fun _ hst => hst)
      T i hcomplete hi hi_next ω
      (by simpa using setup.algorithm43FixedDomainState?_step i hi_pos ω)
      (by
        intro st hst
        exact setup.stepFromFixedDomainAx?_eq_some_of_mem i hi_pos st ω hst)

/-- Generated `A_hat_x(\tilde x_i)` stream induced by a completed fixed-domain
Algorithm 4.3 run.

No SOptLib match: searched recursive iterate/staged-oracle process primitives
when defining the fixed-domain partial process; the reusable process views do
not encode Lan Eq. (4.4.6)/(4.4.56)'s completion-dependent extrapolated-query
oracle stream. This is an internal corrected bridge, not paper-facing data. -/
noncomputable def algorithm43FixedDomainGeneratedAxSampleOfComplete
    (T : ℕ) (hcomplete : setup.Algorithm43FixedDomainComplete T) :
    ℕ → Ω → SapdDualSpace m :=
  SOptLib.completedPartialProcessGeneratedOracleSample T
    (fun i hi ω => setup.algorithm43FixedDomainStateOfComplete T i hcomplete hi ω)
    (fun st => st.xTilde)
    (fun i hi ω => (setup.algorithm43FixedDomainStateOfComplete_spec T i hcomplete hi ω).2)
    setup.sampledAx

theorem algorithm43FixedDomainGeneratedAxSampleOfComplete_eq
    (T i : ℕ) (hcomplete : setup.Algorithm43FixedDomainComplete T)
    (hi : i ∈ Finset.Icc 1 T) (ω : Ω) :
    setup.algorithm43FixedDomainGeneratedAxSampleOfComplete T hcomplete i ω =
      setup.sampledAx i
        ⟨(setup.algorithm43FixedDomainStateOfComplete T i hcomplete hi ω).xTilde,
          (setup.algorithm43FixedDomainStateOfComplete_spec T i hcomplete hi ω).2⟩ ω := by
  simp [algorithm43FixedDomainGeneratedAxSampleOfComplete, hi]

/-- Completed fixed-domain states advance by the generated transition driven by
the induced completed fixed-domain `A_x` sample stream. -/
theorem algorithm43FixedDomainStateOfComplete_succ_eq_generated_stepOfComplete
    (T i : ℕ) (hcomplete : setup.Algorithm43FixedDomainComplete T)
    (hi : i ∈ Finset.Icc 1 T) (hi_next : i + 1 ∈ Finset.Icc 1 T)
    (hi_pos : 1 ≤ i) (ω : Ω) :
    setup.algorithm43FixedDomainStateOfComplete T (i + 1) hcomplete hi_next ω =
      setup.stepFromGeneratedAx i hi_pos
        (setup.algorithm43FixedDomainGeneratedAxSampleOfComplete T hcomplete i ω)
        (setup.algorithm43FixedDomainStateOfComplete T i hcomplete hi ω) ω := by
  simpa [algorithm43FixedDomainGeneratedAxSampleOfComplete] using
    (SOptLib.completedPartialProcess_state_succ_eq_generated_step
      T i
      (fun j hj ω => setup.algorithm43FixedDomainStateOfComplete T j hcomplete hj ω)
      (fun st : StochasticAcceleratedPrimalDualState n m setup.X setup.Y => st.xTilde)
      (fun j hj ω => (setup.algorithm43FixedDomainStateOfComplete_spec T j hcomplete hj ω).2)
      setup.sampledAx
      (fun _ st ax ω => setup.stepFromGeneratedAx i hi_pos ax st ω)
      hi hi_next ω
      (by
        simpa using
          setup.algorithm43FixedDomainStateOfComplete_succ_eq_stepFromGeneratedAx
            T i hcomplete hi hi_next hi_pos ω))

/-- Corrected fixed-domain output `\bar z_{t+1}` when the partial
source-domain Algorithm 4.3 process completes through state `t+1`.

This deliberately differs from the paper theorem surface by requiring
`Algorithm43FixedDomainComplete (t+1)`. The PDF/JSON do not state that
completion condition; therefore this object is a corrected non-original target,
not the canonical Algorithm 4.3 output promised by Theorem 4.8. -/
noncomputable def algorithm43FixedDomainOutputOfComplete
    (t : ℕ) (_ht : 1 ≤ t) (hcomplete : setup.Algorithm43FixedDomainComplete (t + 1))
    (ω : Ω) :
    {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
  let hlast : t + 1 ∈ Finset.Icc 1 (t + 1) :=
    Finset.mem_Icc.mpr ⟨Nat.succ_le_succ (Nat.zero_le t), le_rfl⟩
  let st := setup.algorithm43FixedDomainStateOfComplete (t + 1) (t + 1) hcomplete hlast ω
  ⟨(st.xBar.1, st.yBar.1), ⟨st.xBar.2, st.yBar.2⟩⟩

theorem algorithm43FixedDomainOutputOfComplete_eq_some
    (t : ℕ) (ht : 1 ≤ t) (hcomplete : setup.Algorithm43FixedDomainComplete (t + 1))
    (ω : Ω) :
    setup.algorithm43FixedDomainOutput? t ht ω =
      some (setup.algorithm43FixedDomainOutputOfComplete t ht hcomplete ω) := by
  let hlast : t + 1 ∈ Finset.Icc 1 (t + 1) :=
    Finset.mem_Icc.mpr ⟨Nat.succ_le_succ (Nat.zero_le t), le_rfl⟩
  let output : StochasticAcceleratedPrimalDualState n m setup.X setup.Y →
      {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
    fun st => ⟨(st.xBar.1, st.yBar.1), ⟨st.xBar.2, st.yBar.2⟩⟩
  have h :=
    SOptLib.partialProcessOutput_eq_some_of_complete
      (T := t + 1)
      (by omega)
      setup.algorithm43FixedDomainState?
      (fun i hi ω => setup.algorithm43FixedDomainStateOfComplete (t + 1) i hcomplete hi ω)
      output
      (fun i hi ω => (setup.algorithm43FixedDomainStateOfComplete_spec
        (t + 1) i hcomplete hi ω).1)
      ω
  convert h using 1
  · cases hstate : setup.algorithm43FixedDomainState? (t + 1) ω with
    | none =>
        simp [algorithm43FixedDomainOutput?, hstate]
    | some st =>
        simp [algorithm43FixedDomainOutput?, hstate, output]

