    setup.generatedDeltaXHatf_aestronglyMeasurable_of_realization_variational_stability
      generatedAxSample T hrealize hgrad_meas i hi |>.norm_sq

/-- The generated-oracle realization supplies the source-faithful
`Delta_{x,hat f}` moment step once the APD gradient-mismatch budget has been
proved.

This is the core compiled supplier: the mismatch budget is the only
deterministic APD burden, while the same-query oracle residual is supplied from
the generated realization and Assumption 8 via the finite-sum bridge above. -/
private theorem GeneratedDeltaXHatfSourceMomentStep_of_realization_and_mismatch_budget
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (T : ℕ) (M : ℕ → ℝ)
    (hrealize : setup.GeneratedAxOracleRealization generatedAxSample T)
    (hgrad_meas :
      Measurable (fun x : {x : SapdPrimalSpace n // x ∈ setup.X} =>
        setup.hatfGradient x.1))
    (hbudget : setup.GeneratedHatfGradientMismatchBudget generatedAxSample T M) :
    setup.GeneratedDeltaXHatfSourceMomentStep generatedAxSample T := by
  have hdelta_vec_aesm :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
        AEStronglyMeasurable
          (fun ω =>
            setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω)
          setup.P :=
    setup.generatedDeltaXHatf_aestronglyMeasurable_of_realization_variational_stability
      generatedAxSample T hrealize hgrad_meas
  have hdelta_aesm :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
        AEStronglyMeasurable
          (fun ω =>
            ‖setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2)
          setup.P :=
    setup.generatedDeltaXHatf_sqDeviation_aestronglyMeasurable_of_realization_variational_stability
      generatedAxSample T hrealize hgrad_meas
  have hquery_prefix :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
        Measurable[(setup.filtration).seq i]
          (fun ω => setup.generatedGQueryPoint generatedAxSample i
            (Finset.mem_Icc.mp hi).1 ω) :=
    setup.generatedGQueryPoint_prefix_measurable_of_realization_variational_stability
      generatedAxSample T hrealize
  have hper :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
        Integrable
            (fun ω =>
              ‖setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2)
            setup.P ∧
          ∫ ω,
              ‖setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2
              ∂setup.P ≤
            2 * setup.sigmaXHatf ^ 2 + 2 * M i := by
    intro i hi
    exact
      setup.generatedDeltaXHatf_sqDeviation_integrable_and_bound_of_prefix_query
        generatedAxSample i (Finset.mem_Icc.mp hi).1 (M i) hgrad_meas
        (hquery_prefix i hi) (hdelta_aesm i hi) (hbudget.1 i hi) (hbudget.2 i hi)
  exact
    mixed_center_residual_moment_step_of_realization_and_mismatch_budget
      (P := setup.P) (I := Finset.Icc 1 T)
      (delta := fun i hi ω =>
        setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω)
      (mismatchBudget := setup.GeneratedHatfGradientMismatchBudget generatedAxSample T)
      (sigma2 := setup.sigmaXHatf ^ 2) (M := M)
      hbudget hdelta_vec_aesm hper

