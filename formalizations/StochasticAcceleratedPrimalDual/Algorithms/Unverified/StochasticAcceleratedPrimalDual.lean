/-- Coverage of displayed generated queries follows from an explicit
fixed-domain realization. This is extension-only and is not used by the
source-boundary Theorem 4.8 obligations. -/
private theorem algorithm43SourceBoundary_displayedAx_coverage_of_realization
    (t : ℕ) (hrealize : setup.Algorithm43SourceBoundaryDisplayedAxSFORealization t)
    (i : ℕ) (hi : i ∈ Finset.Icc 1 t) (ω : Ω) :
    (setup.algorithm43SourceBoundaryState i ω).xTilde ∈ setup.X :=
  hrealize i hi ω

/-- Fixed-domain SFO identity for a displayed generated query, available only
inside the explicit extension realization predicate. -/
private theorem algorithm43SourceBoundaryAxTildeCall_sfo_realized_of_realization
    (t : ℕ) (hrealize : setup.Algorithm43SourceBoundaryDisplayedAxSFORealization t)
    (i : ℕ) (hi : i ∈ Finset.Icc 1 t) (ω : Ω) :
    setup.algorithm43SourceBoundaryAxTildeCall i ω =
      setup.sampledAx i
        ⟨(setup.algorithm43SourceBoundaryState i ω).xTilde,
          setup.algorithm43SourceBoundary_displayedAx_coverage_of_realization t hrealize i hi ω⟩ ω :=
  by
    simpa [sampledAx, SOptLib.oracleKernel] using
      (SOptLib.displayedOracleCall_eq_sampledOracle_of_mem
        setup.X setup.oracleAx setup.ξ
        (fun j ω => (setup.algorithm43SourceBoundaryState j ω).xTilde)
        setup.algorithm43SourceBoundaryAxTildeCall
        (by
          intro j ω
          rfl)
        i ω
        (setup.algorithm43SourceBoundary_displayedAx_coverage_of_realization t hrealize i hi ω))

/-- Measurability of the displayed source-boundary `A_hat_x(\tilde x_i)` call
when an explicit fixed-domain realization supplies feasibility and the current
state is already measurable.

This is the concrete bridge missing from the old opaque-call route: it reduces
the generated-query random variable to the jointly measurable fixed-domain
oracle kernel `sampledAx`, rather than assuming measurability of
`sourceBoundaryAxTildeValue` directly. -/
private theorem algorithm43SourceBoundaryAxTildeCall_measurable_of_realization_at
    (t : ℕ) (hrealize : setup.Algorithm43SourceBoundaryDisplayedAxSFORealization t)
    (i : ℕ) (hi : i ∈ Finset.Icc 1 t)
    (hstate :
      StochasticAcceleratedPrimalDualStateMapMeasurable
        (fun ω => setup.algorithm43SourceBoundaryState i ω)) :
    Measurable (fun ω => setup.algorithm43SourceBoundaryAxTildeCall i ω) := by
  let q : Ω → {x : SapdPrimalSpace n // x ∈ setup.X} := fun ω =>
    ⟨(setup.algorithm43SourceBoundaryState i ω).xTilde,
      setup.algorithm43SourceBoundary_displayedAx_coverage_of_realization t hrealize i hi ω⟩
  have hq : Measurable q := by
    exact hstate.2.2.2.2.subtype_mk
  have hsample : Measurable (fun ω => setup.sampledAx i (q ω) ω) := by
    simpa [sampledAx, SOptLib.oracleKernel, q] using
      SOptLib.sampledOracle_measurable
        (oracle := setup.oracleAx)
        (x := q)
        (ξ := setup.ξ i)
        setup.horacleAx_measurable
        hq
        (setup.hξ_measurable i)
  have hEq :
      (fun ω => setup.algorithm43SourceBoundaryAxTildeCall i ω) =
        fun ω => setup.sampledAx i (q ω) ω := by
    funext ω
    exact setup.algorithm43SourceBoundaryAxTildeCall_sfo_realized_of_realization
      t hrealize i hi ω
  simpa [hEq] using hsample

