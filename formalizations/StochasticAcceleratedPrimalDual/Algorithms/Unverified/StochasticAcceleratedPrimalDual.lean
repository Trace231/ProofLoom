    0 ≤ pFun u - pFun xHat +
      mu1 * ⟪gradient ν.potential xHat - gradient ν.potential xTilde, u - xHat⟫_ℝ +
      mu2 * ⟪gradient ν.potential xHat - gradient ν.potential yTilde, u - xHat⟫_ℝ := by
  rcases hArgmin with ⟨hxHat, hmin⟩
  simpa [SapdDistanceGeneratingFunction.bregman,
    SOptLib.DistanceGeneratingFunctionOn.bregman] using
    (SOptLib.two_center_bregman_residual_variational_of_isMinOn
      (ν := ν) (p := pFun) (xHat := xHat) (xTilde := xTilde)
      (yTilde := yTilde) (u := u) (mu1 := mu1) (mu2 := mu2)
      hp_convex hxHat hmin hu)

/-- The strictly smaller proof obligation left by the corrected Lemma 3.5:
derive the residual three-point inequality from the source hypotheses.

This is the nondifferentiable convex-`p` optimality bridge described in the PDF
proof of Lemma 3.5. It should be proved from Mathlib convex/subgradient
infrastructure plus the Bregman three-point identity, not turned into a setup
field. -/
private theorem lemma_3_5_residual_from_argmin
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {X : Set E} {pFun : E → ℝ}
    (ν : SapdDistanceGeneratingFunction E X)
    {xHat xTilde yTilde u : E} {mu1 mu2 : ℝ}
    (hp_convex : ConvexOn ℝ X pFun)
    (hxTilde : xTilde ∈ X) (hyTilde : yTilde ∈ X)
    (hmu1 : 0 ≤ mu1) (hmu2 : 0 ≤ mu2)
    (hArgmin :
      xHat ∈ X ∧
        IsMinOn
          (fun u => pFun u + mu1 * ν.bregman u xTilde + mu2 * ν.bregman u yTilde) X xHat)
    (hu : u ∈ X) :
    0 ≤ pFun u - pFun xHat +
      mu1 * (ν.bregman u xTilde - ν.bregman xHat xTilde - ν.bregman u xHat) +
      mu2 * (ν.bregman u yTilde - ν.bregman xHat yTilde - ν.bregman u xHat) := by
  simpa [SapdDistanceGeneratingFunction.bregman,
    SOptLib.DistanceGeneratingFunctionOn.bregman] using
    (SOptLib.two_center_bregman_residual_nonneg_of_isMinOn
      (ν := ν) (p := pFun) (xHat := xHat) (xTilde := xTilde)
      (yTilde := yTilde) (u := u) (mu1 := mu1) (mu2 := mu2)
      hp_convex hArgmin.1 hArgmin.2 hu)

/-- Paper Lemma 3.5, three-point prox inequality.

The source statement assumes `p` is convex on `X`, the two Bregman centers lie
in `X`, and the weights are nonnegative. Those hypotheses are part of the
paper lemma itself, not setup fields or downstream proof facts.

No SOptLib theorem is re-exported as this paper-facing head: checked prox-step
and three-point candidates such as `proxStep_minimizes_expanded`; they provide
compact-selector or expanded-objective bridges, while the book JSON records the
source lemma in its abstract Bregman form. The proof is intentionally left to
the proof phase. -/
theorem lemma_3_5_three_point
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {X : Set E} {pFun : E → ℝ}
    (ν : SapdDistanceGeneratingFunction E X)
    {xHat xTilde yTilde : E} {mu1 mu2 : ℝ}
    (hp_convex : ConvexOn ℝ X pFun)
    (hxTilde : xTilde ∈ X) (hyTilde : yTilde ∈ X)
    (hmu1 : 0 ≤ mu1) (hmu2 : 0 ≤ mu2)
    (hArgmin :
      xHat ∈ X ∧
        IsMinOn
          (fun u => pFun u + mu1 * ν.bregman u xTilde + mu2 * ν.bregman u yTilde) X xHat)
    (u : E) (hu : u ∈ X) :
    pFun xHat + mu1 * ν.bregman xHat xTilde + mu2 * ν.bregman xHat yTilde ≤
      pFun u + mu1 * ν.bregman u xTilde + mu2 * ν.bregman u yTilde -
        (mu1 + mu2) * ν.bregman u xHat := by
  simpa [SapdDistanceGeneratingFunction.bregman,
    SOptLib.DistanceGeneratingFunctionOn.bregman] using
    (two_center_bregman_three_point_of_isMinOn
      (ν := ν) (p := pFun) (xHat := xHat) (xTilde := xTilde)
      (yTilde := yTilde) (u := u) (mu1 := mu1) (mu2 := mu2)
      hp_convex hArgmin.1 hArgmin.2 hu)


