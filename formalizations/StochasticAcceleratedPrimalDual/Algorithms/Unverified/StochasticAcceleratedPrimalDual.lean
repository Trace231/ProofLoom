              (fun ω =>
                setup.gap (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω)) :=
          setup.gap_measurable_of_compact_value_function.comp hmeas
        obtain ⟨B, hBint', hdom⟩ :=
          GeneratedGapDescentEnvelope.of_eq4472_envelope (setup := setup)
