      (η := setup.eta i) (τ := setup.tau i) (L := setup.Lhatf)
      (gap := setup.Q (setup.generatedExtensionFeasibleOutput generatedAxSample i hi ω) z)
      (gapPrev := setup.Q zPrev z)
