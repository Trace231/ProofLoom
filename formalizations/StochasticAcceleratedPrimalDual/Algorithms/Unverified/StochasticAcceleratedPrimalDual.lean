    (axTildeCall : ℕ → Ω → SapdDualSpace m)
    (t : ℕ) (ht : 1 ≤ t) (ω : Ω) :
    setup.displayedAxExtensionState axTildeCall (t + 1) ω =
      setup.stepFromGeneratedAx t ht (axTildeCall t ω)
