/-- Dual prox objective from Eq. (4.4.56), over feasible previous and candidate
dual iterates and an explicit generated sample value for
`\hat A_x(\tilde x_t)`.

The source calls `\hat A_x(\tilde x_t)` after the affine extrapolation
Eq. (4.4.17), while Eq. (4.4.6) gives the SFO domain as `X × Y`; this objective
therefore consumes the generated sample as data for an explicit extension
realization instead of manufacturing a feasible `\tilde x_t` subtype. -/
noncomputable def dualProxParamObjective (t : ℕ)
    (axTildeSample : SapdDualSpace m)
    (yPrev y : {y : SapdDualSpace m // y ∈ setup.Y}) : ℝ :=
  ⟪-axTildeSample, y.1⟫_ℝ + setup.hatg y.1 +
    (setup.tau t)⁻¹ * setup.VY y.1 yPrev.1

/-- Dual prox objective from Eq. (4.4.56), kept with the historical `ω`
argument for stochastic-step compatibility.

The selected argmin is now driven by `dualProxParamObjective`, which is the
actual deterministic paper objective once the generated
`\hat A_x(\tilde x_t)` value has been supplied. -/
noncomputable def dualProxObjective (t : ℕ)
    (axTildeSample : SapdDualSpace m)
    (yPrev y : {y : SapdDualSpace m // y ∈ setup.Y}) (_ω : Ω) : ℝ :=
  setup.dualProxParamObjective t axTildeSample yPrev y

/-- Existence of the dual prox argmin in Eq. (4.4.56).

This is a theorem obligation, not a setup field: the paper defines
`y_{t+1}` by this argmin, while solvability is supplied by the prox geometry
and simple convex-conjugate assumptions. -/
theorem dualProxParam_exists (t : ℕ) (_ht : 1 ≤ t)
    (axTildeSample : SapdDualSpace m)
    (yPrev : {y : SapdDualSpace m // y ∈ setup.Y}) :
    ∃ y : {y : SapdDualSpace m // y ∈ setup.Y},
      ∀ v : {v : SapdDualSpace m // v ∈ setup.Y},
        setup.dualProxParamObjective t axTildeSample yPrev y ≤
          setup.dualProxParamObjective t axTildeSample yPrev v := by
  let F : SapdDualSpace m → ℝ :=
    fun y => ⟪-axTildeSample, y⟫_ℝ + setup.hatg y +
      (setup.tau t)⁻¹ * setup.VY y yPrev.1
  have hV_cont : ContinuousOn (fun y : SapdDualSpace m => setup.VY y yPrev.1) setup.Y := by
    have hmaps :
        Set.MapsTo
          (fun y : SapdDualSpace m => (y, yPrev.1))
          setup.Y (setup.Y ×ˢ setup.Y) := by
      intro y hy
      exact ⟨hy, yPrev.2⟩
    exact setup.VY_continuousOn.comp
      (continuous_id.prodMk continuous_const).continuousOn hmaps
  have hF_lsc : LowerSemicontinuousOn F setup.Y := by
    simpa [F] using
      (LowerSemicontinuousOn.inner_add_lsc_add_const_mul_continuousOn
        (s := setup.Y) (h := setup.hatg)
        (Vsec := fun y : SapdDualSpace m => setup.VY y yPrev.1)
        (-axTildeSample) ((setup.tau t)⁻¹) setup.hhatg_lsc hV_cont)
  obtain ⟨y, hy, hmin⟩ :=
    LowerSemicontinuousOn.exists_isMinOn
      ⟨setup.y₁, setup.hy₁_mem⟩ setup.Y_isCompact hF_lsc
  refine ⟨⟨y, hy⟩, ?_⟩
  intro v
  have hmin_v := hmin v.2
  simpa [F, dualProxParamObjective, add_assoc, add_left_comm, add_comm] using hmin_v

theorem dualProx_exists (t : ℕ) (ht : 1 ≤ t)
    (axTildeSample : SapdDualSpace m)
    (yPrev : {y : SapdDualSpace m // y ∈ setup.Y}) (ω : Ω) :
    ∃ y : {y : SapdDualSpace m // y ∈ setup.Y},
      ∀ v : {v : SapdDualSpace m // v ∈ setup.Y},
        setup.dualProxObjective t axTildeSample yPrev y ω ≤
          setup.dualProxObjective t axTildeSample yPrev v ω := by
  simpa [dualProxObjective] using
    setup.dualProxParam_exists t ht axTildeSample yPrev

/-- Dual proximal update `y_{t+1}` from Eq. (4.4.56), selected as an argmin of
the paper objective.

Considered `SOptLib.Model.Iterates.proxOracleStep`, but it only applies an
already-supplied prox map. Eq. (4.4.56) is an argmin subproblem over the
paper's feasible dual set, so the Lean object is the compact/lsc argmin
selector supplied by `dualProxParam_exists`; its measurability is kept as the
separate route-local selector theorem below. -/
noncomputable def dualProxSelector (t : ℕ) (_ht : 1 ≤ t)
    (axTildeSample : SapdDualSpace m)
    (yPrev : {y : SapdDualSpace m // y ∈ setup.Y}) :
    {y : SapdDualSpace m // y ∈ setup.Y} :=
  Classical.choose (setup.dualProxParam_exists t _ht axTildeSample yPrev)

noncomputable def dualProx (t : ℕ) (ht : 1 ≤ t)
    (axTildeSample : SapdDualSpace m)
    (yPrev : {y : SapdDualSpace m // y ∈ setup.Y}) (_ω : Ω) :
    {y : SapdDualSpace m // y ∈ setup.Y} :=
  setup.dualProxSelector t ht axTildeSample yPrev

theorem dualProx_mem (t : ℕ) (ht : 1 ≤ t)
    (axTildeSample : SapdDualSpace m)
    (yPrev : {y : SapdDualSpace m // y ∈ setup.Y}) (ω : Ω) :
    (setup.dualProx t ht axTildeSample yPrev ω).1 ∈ setup.Y :=
  (setup.dualProx t ht axTildeSample yPrev ω).2

theorem dualProx_min (t : ℕ) (ht : 1 ≤ t)
    (axTildeSample : SapdDualSpace m)
    (yPrev : {y : SapdDualSpace m // y ∈ setup.Y}) (_ω : Ω) :
    ∀ v : {v : SapdDualSpace m // v ∈ setup.Y},
      setup.dualProxObjective t axTildeSample yPrev
          (setup.dualProx t ht axTildeSample yPrev ω) ω ≤
        setup.dualProxObjective t axTildeSample yPrev v ω :=
  by
    intro v
    simpa [dualProx, dualProxSelector, dualProxObjective] using
      (Classical.choose_spec (setup.dualProxParam_exists t ht axTildeSample yPrev)) v

/-- Composition form of dual-prox measurability for the actual selector used in
`stepFromGeneratedAx`.

The remaining selector leaf is the parameterized compact-argmin map, not the
whole recursive stochastic step. This theorem consumes the actual
`dualProxSelector` definition introduced above. -/
theorem dualProx_measurable_of_selector_measurable
    (t : ℕ) (ht : 1 ≤ t)
    (hselector :
      Measurable (fun p : {y : SapdDualSpace m // y ∈ setup.Y} × SapdDualSpace m × ℝ =>
        setup.dualProxSelector t ht p.2.1 p.1))
    {axTildeSample : Ω → SapdDualSpace m}
    {yPrev : Ω → {y : SapdDualSpace m // y ∈ setup.Y}}
    (hax : Measurable axTildeSample) (hy : Measurable yPrev) :
    Measurable (fun ω => setup.dualProx t ht (axTildeSample ω) (yPrev ω) ω) := by
  have hparam :
      Measurable (fun ω : Ω =>
        (yPrev ω, axTildeSample ω, setup.tau t)) :=
    hy.prod (hax.prod measurable_const)
  simpa [dualProx] using hselector.comp hparam

/-- Primal prox objective from Eq. (4.4.57), over feasible paper-domain
arguments. -/
noncomputable def primalProxParamObjective
    (t : ℕ) (gSample aySample : SapdPrimalSpace n)
    (xPrev x : {x : SapdPrimalSpace n // x ∈ setup.X}) : ℝ :=
  SOptLib.primalTwoOracleProxObjective
    (fun x : {x : SapdPrimalSpace n // x ∈ setup.X} => x.1)
    setup.VX (setup.eta t) gSample aySample xPrev x

/-- Primal prox objective from Eq. (4.4.57), with stochastic oracle samples
composed into the deterministic parameterized objective. -/
noncomputable def primalProxObjective
    (t : ℕ) (xQuery xPrev x : {x : SapdPrimalSpace n // x ∈ setup.X})
    (yNext : {y : SapdDualSpace m // y ∈ setup.Y}) (ω : Ω) : ℝ :=
  setup.primalProxParamObjective t
    (setup.sampledG t xQuery ω) (setup.sampledAy t yNext ω) xPrev x

/-- Existence of the primal prox argmin in Eq. (4.4.57).

This is a theorem obligation, not a setup field: later proof work should derive
it from the stated prox geometry and domain assumptions rather than assuming an
abstract primal prox map. -/
theorem primalProxParam_exists (t : ℕ) (_ht : 1 ≤ t)
    (gSample aySample : SapdPrimalSpace n)
    (xPrev : {x : SapdPrimalSpace n // x ∈ setup.X}) :
    ∃ x : {x : SapdPrimalSpace n // x ∈ setup.X},
      ∀ v : {v : SapdPrimalSpace n // v ∈ setup.X},
        setup.primalProxParamObjective t gSample aySample xPrev x ≤
          setup.primalProxParamObjective t gSample aySample xPrev v := by
  simpa [primalProxParamObjective] using
    SOptLib.primalTwoOracleProxObjective_exists_of_compact_continuous
      setup.X setup.VX ⟨setup.x₁, setup.hx₁_mem⟩ setup.X_isCompact
      setup.VX_continuousOn (setup.eta t) gSample aySample xPrev

theorem primalProx_exists (t : ℕ) (ht : 1 ≤ t)
    (xQuery xPrev : {x : SapdPrimalSpace n // x ∈ setup.X})
    (yNext : {y : SapdDualSpace m // y ∈ setup.Y}) (ω : Ω) :
    ∃ x : {x : SapdPrimalSpace n // x ∈ setup.X},
      ∀ v : {v : SapdPrimalSpace n // v ∈ setup.X},
        setup.primalProxObjective t xQuery xPrev x yNext ω ≤
          setup.primalProxObjective t xQuery xPrev v yNext ω := by
  simpa [primalProxObjective] using
    setup.primalProxParam_exists t ht
      (setup.sampledG t xQuery ω) (setup.sampledAy t yNext ω) xPrev

/-- Primal proximal update `x_{t+1}` from Eq. (4.4.57), selected as the
canonical argmin of the paper objective.

Considered `SOptLib.Model.Iterates.proxOracleStep` and
`SOptLib.Layer0.ConvexFOC` prox bridges; those require an existing prox selector
or prove optimality facts, while Eq. (4.4.57) itself defines the selector. -/
noncomputable def primalProxSelector
    (t : ℕ) (ht : 1 ≤ t)
    (gSample aySample : SapdPrimalSpace n)
    (xPrev : {x : SapdPrimalSpace n // x ∈ setup.X}) :
    {x : SapdPrimalSpace n // x ∈ setup.X} :=
  Classical.choose (setup.primalProxParam_exists t ht gSample aySample xPrev)

noncomputable def primalProx
    (t : ℕ) (ht : 1 ≤ t)
    (xQuery xPrev : {x : SapdPrimalSpace n // x ∈ setup.X})
    (yNext : {y : SapdDualSpace m // y ∈ setup.Y}) (ω : Ω) :
    {x : SapdPrimalSpace n // x ∈ setup.X} :=
  setup.primalProxSelector t ht
    (setup.sampledG t xQuery ω) (setup.sampledAy t yNext ω) xPrev

theorem primalProx_mem (t : ℕ) (ht : 1 ≤ t)
    (xQuery xPrev : {x : SapdPrimalSpace n // x ∈ setup.X})
    (yNext : {y : SapdDualSpace m // y ∈ setup.Y}) (ω : Ω) :
    (setup.primalProx t ht xQuery xPrev yNext ω).1 ∈ setup.X :=
  (setup.primalProx t ht xQuery xPrev yNext ω).2

theorem primalProx_min (t : ℕ) (ht : 1 ≤ t)
    (xQuery xPrev : {x : SapdPrimalSpace n // x ∈ setup.X})
    (yNext : {y : SapdDualSpace m // y ∈ setup.Y}) (ω : Ω) :
    ∀ v : {v : SapdPrimalSpace n // v ∈ setup.X},
      setup.primalProxObjective t xQuery xPrev
          (setup.primalProx t ht xQuery xPrev yNext ω) yNext ω ≤
        setup.primalProxObjective t xQuery xPrev v yNext ω :=
  by
    simpa [primalProx, primalProxSelector, primalProxObjective] using
      Classical.choose_spec
        (setup.primalProxParam_exists t ht
          (setup.sampledG t xQuery ω) (setup.sampledAy t yNext ω) xPrev)

/-- Composition form of primal-prox measurability for the actual selector used
in `stepFromGeneratedAx`.

The stochastic oracle values are ordinary measurable inputs to the
parameterized Eq. (4.4.57) argmin selector. -/
theorem primalProx_measurable_of_selector_measurable
    (t : ℕ) (ht : 1 ≤ t)
    (hselector :
      Measurable
        (fun p :
          {x : SapdPrimalSpace n // x ∈ setup.X} ×
            (SapdPrimalSpace n × SapdPrimalSpace n) × ℝ =>
          setup.primalProxSelector t ht p.2.1.1 p.2.1.2 p.1))
    {xPrev : Ω → {x : SapdPrimalSpace n // x ∈ setup.X}}
    {gSample aySample : Ω → SapdPrimalSpace n}
    (hxPrev : Measurable xPrev)
    (hg : Measurable gSample) (hay : Measurable aySample) :
    Measurable
      (fun ω =>
        setup.primalProxSelector t ht (gSample ω) (aySample ω) (xPrev ω)) := by
  have hparam :
      Measurable (fun ω : Ω =>
        (xPrev ω, (gSample ω, aySample ω), setup.eta t)) :=
    hxPrev.prod ((hg.prod hay).prod measurable_const)
  simpa using hselector.comp hparam

/-- Internal regularity obligation for the dual prox argmin selector from
Eq. (4.4.56).

This is intentionally a named route-local obligation rather than a theorem:
the available compact/lsc existence theorem supplies pointwise minimizers only,
and the paper does not list Lean selector measurability as a setup assumption.
FILL should discharge this through the concrete continuity route below, using
variational-stability lemmas for the actual strongly convex Bregman prox
selector, not by unfolding `LowerSemicontinuousOn.exists_isMinOn`. -/
def DualProxSelectorMeasurableAt (t : ℕ) (ht : 1 ≤ t) : Prop :=
    Measurable
      (fun p : {y : SapdDualSpace m // y ∈ setup.Y} × SapdDualSpace m × ℝ =>
        setup.dualProxSelector t ht p.2.1 p.1)

/-- Route-local continuity boundary for the canonical dual prox selector.

The previous generic compact/lsc measurable-selection leaf was too broad and
not source-chain supported.  The source-specific route should instead prove
continuity of the actual Bregman prox selector from the variational-stability
lemmas for strongly convex prox subproblems, then use the bridge below to obtain
measurability. -/
def DualProxSelectorContinuousAt (t : ℕ) (ht : 1 ≤ t) : Prop :=
    Continuous
      (fun p : {y : SapdDualSpace m // y ∈ setup.Y} × SapdDualSpace m × ℝ =>
        setup.dualProxSelector t ht p.2.1 p.1)

/-- Internal regularity obligation for the canonical primal prox selector from
Eq. (4.4.57).

The primal objective is continuous in the candidate and measurable in its oracle
parameters once the sampled `G` and `A_y` values are supplied. This theorem is
kept parallel to the dual selector so the one-step APD measurability bridge
consumes actual selector maps instead of a whole-step regularity placeholder. -/
def PrimalProxSelectorMeasurableAt (t : ℕ) (ht : 1 ≤ t) : Prop :=
    Measurable
      (fun p :
        {x : SapdPrimalSpace n // x ∈ setup.X} ×
          (SapdPrimalSpace n × SapdPrimalSpace n) × ℝ =>
        setup.primalProxSelector t ht p.2.1.1 p.2.1.2 p.1)

/-- Source-boundary/generation one-step selector interface at one positive
Algorithm 4.3 index.

This packages the two selected-prox regularity obligations without moving them
into `Setup`. It is the explicit Lean boundary needed to turn the canonical
argmin-defined prox maps into measurable stochastic steps. -/
def SelectedProxSelectorsMeasurableAt (t : ℕ) (ht : 1 ≤ t) : Prop :=
  setup.DualProxSelectorMeasurableAt t ht ∧
    setup.PrimalProxSelectorMeasurableAt t ht

/-- Joint continuity leaf for the primal Eq. (4.4.57) argmin objective.

This is a derived theorem obligation from `VX_continuousOn` and continuity of
inner products. It is intentionally separated from selector measurability so the
measurable-selector proof can route through the compiled compact unique-argmin
API rather than package the whole prox step as a premise. -/
theorem primalProxParamObjective_joint_continuous (t : ℕ) :
    Continuous
      (fun q :
        (({x : SapdPrimalSpace n // x ∈ setup.X} ×
            (SapdPrimalSpace n × SapdPrimalSpace n) × ℝ) ×
          {x : SapdPrimalSpace n // x ∈ setup.X}) =>
        setup.primalProxParamObjective t q.1.2.1.1 q.1.2.1.2 q.1.1 q.2) := by
  simpa [primalProxParamObjective] using
    (SOptLib.primalTwoOracleProxObjective_joint_continuous
      (eval := fun x : {x : SapdPrimalSpace n // x ∈ setup.X} => x.1)
      (V := setup.VX) (S := setup.X)
      (by fun_prop) (fun x => x.2) setup.VX_continuousOn (setup.eta t))

/-- Scaled first-order variational inequality for a primal Eq. (4.4.57)
minimizer.

Chosen alignment: searched `prox minimizer variational Bregman objective` and
considered `prox_variational_inequality_of_isMinOn_linear_bregman`; that lemma
requires an `fderivWithin` identification on the closed carrier, while Lan
Eq. (4.4.57) is served here by the same ambient `HasGradientAt` segment route
used in the dual selector variational proof. -/
private theorem primal_prox_minimizer_scaled_variational (t : ℕ) (ht : 1 ≤ t)
    (xPrev z u : {x : SapdPrimalSpace n // x ∈ setup.X})
    (gSample aySample : SapdPrimalSpace n)
    (hmin :
      ∀ y : {x : SapdPrimalSpace n // x ∈ setup.X},
        setup.primalProxParamObjective t gSample aySample xPrev z ≤
          setup.primalProxParamObjective t gSample aySample xPrev y) :
    0 ≤
      ⟪(setup.eta t) • (gSample + aySample) +
          gradient setup.nuX z.1 - gradient setup.nuX xPrev.1,
        u.1 - z.1⟫_ℝ := by
  classical
  let P := {x : SapdPrimalSpace n // x ∈ setup.X}
  let eval : P → SapdPrimalSpace n := fun x => x.1
  let grad : P → SapdPrimalSpace n := fun x => gradient setup.nuX x.1
  let hcar : P → ℝ := fun _ => 0
  let Vcar : P → P → ℝ := fun x y => setup.VX y.1 x.1
  let c : SapdPrimalSpace n := gSample + aySample
  have hη : 0 < setup.eta t := setup.heta_pos t ht
  have hmin_obj :
      ∀ y : P,
        SOptLib.proxObjective Vcar hcar eval xPrev c (setup.eta t) z ≤
          SOptLib.proxObjective Vcar hcar eval xPrev c (setup.eta t) y := by
    intro y
    have hraw := hmin y
    calc
      SOptLib.proxObjective Vcar hcar eval xPrev c (setup.eta t) z =
          setup.primalProxParamObjective t gSample aySample xPrev z := by
        simp [Vcar, hcar, eval, primalProxParamObjective, c, SOptLib.proxObjective,
          inner_add_left, real_inner_comm, add_assoc]
      _ ≤ setup.primalProxParamObjective t gSample aySample xPrev y := hraw
      _ = SOptLib.proxObjective Vcar hcar eval xPrev c (setup.eta t) y := by
        simp [Vcar, hcar, eval, primalProxParamObjective, c, SOptLib.proxObjective,
          inner_add_left, real_inner_comm, add_assoc]
  let segment : ∀ s : ℝ, s ∈ Set.Icc (0 : ℝ) 1 → P :=
    fun s hs => ⟨AffineMap.lineMap z.1 u.1 s,
      setup.hX_convex.lineMap_mem z.2 u.2 hs⟩
  have hscaled :
      0 ≤
        setup.eta t * ⟪c, eval u - eval z⟫_ℝ +
          ⟪grad z - grad xPrev, eval u - eval z⟫_ℝ +
          setup.eta t * (hcar u - hcar z) := by
    refine
      SOptLib.prox_scaled_variational_of_minimizer_with_segment
        eval grad Vcar hcar xPrev z u c hη segment ?_ ?_ ?_ ?_ hmin_obj
    · intro h0
      apply Subtype.ext
      simp [segment, AffineMap.lineMap_apply_module']
    · intro s hs
      rfl
    · intro s hs
      simp [hcar]
    · have h :=
        bregman_segment_difference_hasDerivWithinAt_zero
          (v := setup.nuX) (grad := fun x : SapdPrimalSpace n => gradient setup.nuX x)
          (x := xPrev.1) (xp := z.1) (u := u.1)
          (setup.dgfX.hasGradientAt z.1 z.2)
      simpa [segment, Vcar, grad, eval, setup.VX_def, carrierBregmanFormula] using h
  have hscaled_eq :
      setup.eta t * ⟪c, eval u - eval z⟫_ℝ +
          ⟪grad z - grad xPrev, eval u - eval z⟫_ℝ +
          setup.eta t * (hcar u - hcar z) =
        ⟪(setup.eta t) • (gSample + aySample) +
            gradient setup.nuX z.1 - gradient setup.nuX xPrev.1,
          u.1 - z.1⟫_ℝ := by
    simp [eval, grad, hcar, c, inner_add_left, inner_sub_left,
      inner_smul_left, add_assoc]
    ring
  rwa [hscaled_eq] at hscaled

/-- Uniqueness leaf for the primal Eq. (4.4.57) argmin.

The source route is strong convexity of the Bregman term in the candidate,
scaled by the positive stepsize `eta_t`, plus linear oracle terms. This is the
remaining mathematical uniqueness proof needed before the compact unique-argmin
measurability theorem applies to the primal selector. -/
theorem primalProxSelector_argmin_unique (t : ℕ) (ht : 1 ≤ t) :
    ∀ p : {x : SapdPrimalSpace n // x ∈ setup.X} ×
        (SapdPrimalSpace n × SapdPrimalSpace n) × ℝ,
      ∀ z z',
      (∀ y : {x : SapdPrimalSpace n // x ∈ setup.X},
        setup.primalProxParamObjective t p.2.1.1 p.2.1.2 p.1 z ≤
          setup.primalProxParamObjective t p.2.1.1 p.2.1.2 p.1 y) →
      (∀ y : {x : SapdPrimalSpace n // x ∈ setup.X},
        setup.primalProxParamObjective t p.2.1.1 p.2.1.2 p.1 z' ≤
          setup.primalProxParamObjective t p.2.1.1 p.2.1.2 p.1 y) →
      z = z' := by
  classical
  intro p z z'
  let P := {x : SapdPrimalSpace n // x ∈ setup.X}
  let eval : P → SapdPrimalSpace n := fun x => x.1
  let grad : P → SapdPrimalSpace n := fun x => gradient setup.nuX x.1
  let V : P → P → ℝ := fun a b => setup.VX b.1 a.1
  let c : SapdPrimalSpace n := p.2.1.1 + p.2.1.2
  intro hzmin hz'min
  have hvar : ∀ {a b : P},
      (∀ y : P,
        setup.primalProxParamObjective t p.2.1.1 p.2.1.2 p.1 a ≤
          setup.primalProxParamObjective t p.2.1.1 p.2.1.2 p.1 y) →
      0 ≤ ⟪(setup.eta t) • c + grad a - grad p.1, eval b - eval a⟫_ℝ := by
    intro a b hmin
    simpa [c, grad, eval] using
      setup.primal_prox_minimizer_scaled_variational t ht p.1 a b
        p.2.1.1 p.2.1.2 hmin
  have hsymm : ∀ a b : P,
      V a b + V b a = ⟪grad b - grad a, eval b - eval a⟫_ℝ := by
    intro a b
    simp [V, grad, eval, setup.VX_def]
    simp only [inner_sub_left, inner_sub_right, real_inner_comm]
    ring
  have hlower : ∀ a b : P, ‖eval a - eval b‖ ^ 2 ≤ V a b + V b a := by
    intro a b
    have hba : (1 / 2 : ℝ) * ‖eval a - eval b‖ ^ 2 ≤ V a b := by
      have h := setup.VX_modulus_one b.1 a.1 b.2 a.2
      simpa [V, eval, norm_sub_rev b.1 a.1] using h
    have hab : (1 / 2 : ℝ) * ‖eval b - eval a‖ ^ 2 ≤ V b a := by
      have h := setup.VX_modulus_one a.1 b.1 a.2 b.2
      simpa [V, eval, norm_sub_rev a.1 b.1] using h
    exact sq_norm_le_bregman_add_swap_of_half_lower_bound V eval a b hba hab
  exact SOptLib.paperMirrorObjective_argmin_unique_of_strict_bregman
    (V := V) (eval := eval) (grad := grad)
    (obj := fun y : P => setup.primalProxParamObjective t p.2.1.1 p.2.1.2 p.1 y)
    (by intro a b h; exact Subtype.ext h) p.1 c (setup.eta t) z z'
    hvar hsymm hlower hzmin hz'min

/-- Primal selected-prox measurability from the compiled compact unique-argmin
continuity theorem.

Unlike the earlier whole-selector package, this theorem exposes the real API
path: compact feasible subtype, joint continuity of the primal objective, the
actual `Classical.choose` minimizer certificate, and uniqueness of the argmin. -/
theorem PrimalProxSelectorMeasurableAt_of_compact_continuous_unique
    (t : ℕ) (ht : 1 ≤ t) :
    setup.PrimalProxSelectorMeasurableAt t ht := by
  classical
  let Param :=
    {x : SapdPrimalSpace n // x ∈ setup.X} ×
      (SapdPrimalSpace n × SapdPrimalSpace n) × ℝ
  let Candidate := {x : SapdPrimalSpace n // x ∈ setup.X}
  let F : Param → Candidate → ℝ := fun p z =>
    setup.primalProxParamObjective t p.2.1.1 p.2.1.2 p.1 z
  let sel : Param → Candidate := fun p =>
    setup.primalProxSelector t ht p.2.1.1 p.2.1.2 p.1
  haveI : CompactSpace Candidate :=
    isCompact_iff_compactSpace.mp (by
      simpa [Candidate] using setup.X_isCompact)
  have hcont : Continuous sel := by
    refine continuous_argmin_of_compact_unique
      (F := F) (sel := sel) ?_ ?_ ?_
    · simpa [F, Param, Candidate] using
        setup.primalProxParamObjective_joint_continuous t
    · intro p y
      simpa [F, sel, primalProxSelector] using
        (Classical.choose_spec
          (setup.primalProxParam_exists t ht p.2.1.1 p.2.1.2 p.1)) y
    · intro p z z' hz hz'
      exact primalProxSelector_argmin_unique (setup := setup) t ht p z z' hz hz'
  simpa [PrimalProxSelectorMeasurableAt, Param, Candidate, sel] using hcont.measurable

/-- Joint measurability leaf for the dual Eq. (4.4.56) compact/lsc objective.

This is the concrete local premise needed by
the concrete dual selected-prox theorem: `hatg` contributes only
lower-semicontinuous/Borel measurability, while the affine and Bregman terms are
continuous in the finite-dimensional parameters and candidate. -/
theorem dualProxParamObjective_joint_measurable (t : ℕ) (ht : 1 ≤ t) :
    Measurable
      (fun q :
        (({y : SapdDualSpace m // y ∈ setup.Y} × SapdDualSpace m × ℝ) ×
          {y : SapdDualSpace m // y ∈ setup.Y}) =>
        setup.dualProxParamObjective t q.1.2.1 q.1.1 q.2) := by
  simpa [dualProxParamObjective, SOptLib.proxObjective, add_assoc, add_left_comm, add_comm]
    using
      (SOptLib.dualCompositeProxObjective_joint_measurable
        (Y := setup.Y) (h := setup.hatg) (V := setup.VY)
        (base := fun p :
          {y : SapdDualSpace m // y ∈ setup.Y} × SapdDualSpace m × ℝ => p.1)
        (oracle := fun p :
          {y : SapdDualSpace m // y ∈ setup.Y} × SapdDualSpace m × ℝ => -p.2.1)
        (γ := fun _ :
          {y : SapdDualSpace m // y ∈ setup.Y} × SapdDualSpace m × ℝ => setup.tau t)
        setup.hhatg_lsc (by fun_prop) (by fun_prop) measurable_const
        setup.VY_continuousOn)

/-- Candidate lower-semicontinuity leaf for the dual Eq. (4.4.56) objective.

This isolates the source-backed nonsmooth term `hatg`: for each fixed previous
dual iterate and generated `A_x(\tilde x_t)` value, the candidate objective is
lsc on the feasible dual subtype. -/
theorem dualProxParamObjective_lsc_candidate (t : ℕ) (ht : 1 ≤ t) :
    ∀ p : {y : SapdDualSpace m // y ∈ setup.Y} × SapdDualSpace m × ℝ,
      LowerSemicontinuous
        (fun z : {y : SapdDualSpace m // y ∈ setup.Y} =>
          setup.dualProxParamObjective t p.2.1 p.1 z) := by
  intro p
  have hh_lsc :
      LowerSemicontinuous
        (fun z : {y : SapdDualSpace m // y ∈ setup.Y} => setup.hatg z.1) := by
    simpa only [Set.restrict] using
      (lowerSemicontinuous_restrict_iff (s := setup.Y) (f := setup.hatg)).2
        setup.hhatg_lsc
  have hV_section :
      Continuous
        (fun z : {y : SapdDualSpace m // y ∈ setup.Y} => setup.VY z.1 p.1.1) := by
    have hmaps :
        Set.MapsTo
          (fun z : {y : SapdDualSpace m // y ∈ setup.Y} =>
            ((z.1 : SapdDualSpace m), (p.1.1 : SapdDualSpace m)))
          Set.univ (setup.Y ×ˢ setup.Y) := by
      intro z _hz
      exact ⟨z.2, p.1.2⟩
    have hpair_cont :
        Continuous
          (fun z : {y : SapdDualSpace m // y ∈ setup.Y} =>
            ((z.1 : SapdDualSpace m), (p.1.1 : SapdDualSpace m))) := by
      exact continuous_subtype_val.prodMk continuous_const
    have hcontOn :
        ContinuousOn
          (fun z : {y : SapdDualSpace m // y ∈ setup.Y} => setup.VY z.1 p.1.1)
          Set.univ := by
      simpa [Function.comp_def] using
        setup.VY_continuousOn.comp hpair_cont.continuousOn hmaps
    exact continuousOn_univ.mp hcontOn
  convert
    (SOptLib.dualCompositeProxObjective_lsc_candidate
      (Y := setup.Y) (h := setup.hatg) (V := setup.VY)
      setup.hhatg_lsc setup.VY_continuousOn p.1 (-p.2.1) (setup.tau t)) using 1
  ext z
  simp [dualProxParamObjective, SOptLib.proxObjective, add_assoc, add_left_comm, add_comm]

/-- The actual dual prox selector minimizes the parameterized Eq. (4.4.56)
objective at each parameter value. -/
theorem dualProxSelector_param_minimizes (t : ℕ) (ht : 1 ≤ t) :
    ∀ p : {y : SapdDualSpace m // y ∈ setup.Y} × SapdDualSpace m × ℝ,
      ∀ z : {y : SapdDualSpace m // y ∈ setup.Y},
        setup.dualProxParamObjective t p.2.1 p.1
            (setup.dualProxSelector t ht p.2.1 p.1) ≤
          setup.dualProxParamObjective t p.2.1 p.1 z := by
  intro p z
  let F :
      ({y : SapdDualSpace m // y ∈ setup.Y} × SapdDualSpace m × ℝ) →
        {y : SapdDualSpace m // y ∈ setup.Y} → ℝ :=
    fun p z => setup.dualProxParamObjective t p.2.1 p.1 z
  have h :=
    SOptLib.dualCompositeProxSelector_minimizes
      (F := F)
      (exists_min := fun p => setup.dualProxParam_exists t ht p.2.1 p.1) p z
  simpa [F, dualProxSelector] using h

/-- Variational inequality for the actual dual Eq. (4.4.56) selected prox point.

This is the source-derived first-order condition for the nonsmooth composite
argmin.  It is deliberately the small remaining proof leaf for the dual selector
regularity route: it must be proved from convexity of `hatg`, differentiability
of the DGF, and the selected minimizer certificate, not assumed as selector
measurability. -/
theorem dualProxSelector_variational (t : ℕ) (ht : 1 ≤ t)
    (yPrev : {y : SapdDualSpace m // y ∈ setup.Y})
    (axTildeSample : SapdDualSpace m)
    (u : {y : SapdDualSpace m // y ∈ setup.Y}) :
    0 ≤
      ⟪-axTildeSample,
        u.1 - (setup.dualProxSelector t ht axTildeSample yPrev).1⟫_ℝ +
        (setup.tau t)⁻¹ *
          ⟪gradient setup.nuY
              (setup.dualProxSelector t ht axTildeSample yPrev).1 -
              gradient setup.nuY yPrev.1,
            u.1 - (setup.dualProxSelector t ht axTildeSample yPrev).1⟫_ℝ +
        (setup.hatg u.1 -
          setup.hatg (setup.dualProxSelector t ht axTildeSample yPrev).1) := by
  classical
  let P := {y : SapdDualSpace m // y ∈ setup.Y}
  let Vcar : P → P → ℝ := fun x y => setup.dgfY.bregman y.1 x.1
  let hcar : P → ℝ := fun y => setup.hatg y.1
  let eval : P → SapdDualSpace m := fun y => y.1
  let selector : SapdDualSpace m → P → P :=
    fun g y => setup.dualProxSelector t ht (-g) y
  have hselector_min :
      ∀ (x : P) (g : SapdDualSpace m) (y : P),
        SOptLib.proxObjective Vcar hcar eval x g (setup.tau t) (selector g x) ≤
          SOptLib.proxObjective Vcar hcar eval x g (setup.tau t) y := by
    intro x g y
    have hraw :=
      setup.dualProxSelector_param_minimizes t ht (x, -g, setup.tau t) y
    calc
      SOptLib.proxObjective Vcar hcar eval x g (setup.tau t) (selector g x) =
          setup.dualProxParamObjective t (-g) x (selector g x) := by
        simp [Vcar, hcar, eval, selector, dualProxParamObjective, VY,
          SOptLib.proxObjective,
          add_assoc, add_left_comm, add_comm]
      _ ≤ setup.dualProxParamObjective t (-g) x y := hraw
      _ = SOptLib.proxObjective Vcar hcar eval x g (setup.tau t) y := by
        simp [Vcar, hcar, eval, dualProxParamObjective, VY, SOptLib.proxObjective,
          add_assoc, add_comm]
  have hvi :=
    SOptLib.dualCompositeProxSelector_variational
      (ν := setup.dgfY) (h := setup.hatg)
      (objective := fun x g γ y => SOptLib.proxObjective Vcar hcar eval x g γ y)
      (selector := selector) setup.hhatg_convex
      (by
        intro x g γ y
        rfl)
      (γ := setup.tau t)
      hselector_min
      (base := yPrev) (u := u) (g := -axTildeSample)
      (setup.htau_pos t ht)
  simpa [selector, nuY, add_assoc] using hvi

/-- Arbitrary-minimizer variational inequality for Lan Eq. (4.4.56).

Chosen alignment: considered `dualProxSelector_variational`, which proves the
same source first-order condition only for the selected minimizer, and
`prox_variational_inequality_of_isMinOn_linear_bregman`, whose closed-carrier
`fderivWithin` interface does not match this file's ambient `HasGradientAt`
DGF route. This helper preserves the Eq. (4.4.56) objective and replaces the
selector certificate by the supplied arbitrary minimizer certificate. -/
private theorem dual_prox_minimizer_variational (t : ℕ) (ht : 1 ≤ t)
    (yPrev z u : {y : SapdDualSpace m // y ∈ setup.Y})
    (axTildeSample : SapdDualSpace m)
    (hmin_param :
      ∀ y : {y : SapdDualSpace m // y ∈ setup.Y},
        setup.dualProxParamObjective t axTildeSample yPrev z ≤
          setup.dualProxParamObjective t axTildeSample yPrev y) :
    0 ≤
      ⟪-axTildeSample, u.1 - z.1⟫_ℝ +
        (setup.tau t)⁻¹ *
          ⟪gradient setup.nuY z.1 - gradient setup.nuY yPrev.1,
            u.1 - z.1⟫_ℝ +
        (setup.hatg u.1 - setup.hatg z.1) := by
  have hmin :
      ∀ y : {y : SapdDualSpace m // y ∈ setup.Y},
        SOptLib.proxObjective
            (fun p q : {w : SapdDualSpace m // w ∈ setup.Y} =>
              setup.dgfY.bregman q.1 p.1)
            (fun y : {w : SapdDualSpace m // w ∈ setup.Y} => setup.hatg y.1)
            (fun y : {w : SapdDualSpace m // w ∈ setup.Y} => y.1)
            yPrev (-axTildeSample) (setup.tau t) z ≤
          SOptLib.proxObjective
            (fun p q : {w : SapdDualSpace m // w ∈ setup.Y} =>
              setup.dgfY.bregman q.1 p.1)
            (fun y : {w : SapdDualSpace m // w ∈ setup.Y} => setup.hatg y.1)
            (fun y : {w : SapdDualSpace m // w ∈ setup.Y} => y.1)
            yPrev (-axTildeSample) (setup.tau t) y := by
    intro y
    calc
      SOptLib.proxObjective
            (fun p q : {w : SapdDualSpace m // w ∈ setup.Y} =>
              setup.dgfY.bregman q.1 p.1)
            (fun y : {w : SapdDualSpace m // w ∈ setup.Y} => setup.hatg y.1)
            (fun y : {w : SapdDualSpace m // w ∈ setup.Y} => y.1)
            yPrev (-axTildeSample) (setup.tau t) z =
          setup.dualProxParamObjective t axTildeSample yPrev z := by
        simp [dualProxParamObjective, VY, SOptLib.proxObjective, add_assoc]
        ring
      _ ≤ setup.dualProxParamObjective t axTildeSample yPrev y := hmin_param y
      _ =
          SOptLib.proxObjective
            (fun p q : {w : SapdDualSpace m // w ∈ setup.Y} =>
              setup.dgfY.bregman q.1 p.1)
            (fun y : {w : SapdDualSpace m // w ∈ setup.Y} => setup.hatg y.1)
            (fun y : {w : SapdDualSpace m // w ∈ setup.Y} => y.1)
            yPrev (-axTildeSample) (setup.tau t) y := by
        simp [dualProxParamObjective, VY, SOptLib.proxObjective, add_assoc]
        ring
  have hvi :=
    SOptLib.dualCompositeProx_minimizer_variational
      (ν := setup.dgfY) (h := setup.hatg) setup.hhatg_convex
      (base := yPrev) (z := z) (u := u) (g := -axTildeSample)
      (γ := setup.tau t) (setup.htau_pos t ht) hmin
  simpa [nuY, add_assoc] using hvi

/-- Strong monotonicity of the dual DGF gradient on the feasible carrier.

This is derived from the modulus-one Bregman lower bound in both directions;
it supplies the strong-monotonicity hypothesis required by the SOptLib prox
stability theorem. -/
theorem dualDgf_gradient_strongMonotone :
    ∀ y z : {y : SapdDualSpace m // y ∈ setup.Y},
      ‖y.1 - z.1‖ ^ 2 ≤
        ⟪y.1 - z.1,
          gradient setup.nuY y.1 - gradient setup.nuY z.1⟫_ℝ := by
  intro y z
  exact
    sq_norm_le_inner_gradient_sub_of_bregman_half_sq_lower_bound
      (v := fun p : {y : SapdDualSpace m // y ∈ setup.Y} => setup.nuY p.1)
      (eval := fun p : {y : SapdDualSpace m // y ∈ setup.Y} => p.1)
      (grad := fun p : {y : SapdDualSpace m // y ∈ setup.Y} => gradient setup.nuY p.1)
      y z
      (by simpa [setup.VY_def, carrierBregmanFormula] using
        setup.VY_modulus_one y.1 z.1 y.2 z.2)
      (by simpa [setup.VY_def, carrierBregmanFormula] using
        setup.VY_modulus_one z.1 y.1 z.2 y.2)

/-- State-oracle Lipschitz estimate for the actual selected dual prox point.

This is the quantitative variational-stability bridge used to prove continuity
of Eq. (4.4.56)'s `dualProxSelector`. -/
theorem dualProxSelector_state_oracle_distance_bound
    (t : ℕ) (ht : 1 ≤ t)
    (y₁ y₂ : {y : SapdDualSpace m // y ∈ setup.Y})
    (g₁ g₂ : SapdDualSpace m) :
    dist (setup.dualProxSelector t ht g₁ y₁)
        (setup.dualProxSelector t ht g₂ y₂) ≤
      setup.tau t * dist g₁ g₂ +
        dist (gradient setup.nuY y₁.1) (gradient setup.nuY y₂.1) := by
  change
    ‖(setup.dualProxSelector t ht g₁ y₁).1 -
        (setup.dualProxSelector t ht g₂ y₂).1‖ ≤
      setup.tau t * ‖g₁ - g₂‖ +
        ‖gradient setup.nuY y₁.1 - gradient setup.nuY y₂.1‖
  have hnegdist : ‖-g₁ + g₂‖ = ‖g₁ - g₂‖ := by
    have hrewrite : -g₁ + g₂ = -(g₁ - g₂) := by
      abel
    rw [hrewrite, norm_neg]
  simpa [dist_eq_norm, hnegdist] using
    (SOptLib.dualCompositeProxSelector_state_oracle_distance_bound
      (prox := fun y g => setup.dualProxSelector t ht (-g) y)
      (eval := fun y : {y : SapdDualSpace m // y ∈ setup.Y} => y.1)
      (grad := fun y : {y : SapdDualSpace m // y ∈ setup.Y} =>
        gradient setup.nuY y.1)
      (h := fun y : {y : SapdDualSpace m // y ∈ setup.Y} => setup.hatg y.1)
      (γ := setup.tau t) (setup.htau_pos t ht)
      (by
        intro y u g
        simpa using setup.dualProxSelector_variational t ht y (-g) u)
      (fun y z => setup.dualDgf_gradient_strongMonotone y z)
      y₁ y₂ (-g₁) (-g₂))

/-- Continuity supplier for the actual dual Eq. (4.4.56) selected prox map.

This is the source-specific replacement for the rejected generic compact/lsc
measurable-selection route.  The proof uses the selected prox variational
inequality, strong monotonicity of the DGF gradient, and the compiled SOptLib
state-oracle stability and continuity lemmas. -/
theorem DualProxSelectorContinuousAt_of_variational_stability
    (t : ℕ) (ht : 1 ≤ t) :
    setup.DualProxSelectorContinuousAt t ht := by
  simpa [DualProxSelectorContinuousAt] using
    SOptLib.dualProxSelectorContinuousAt_of_state_oracle_bound
      (prox := fun y : {y : SapdDualSpace m // y ∈ setup.Y} =>
        fun g : SapdDualSpace m => setup.dualProxSelector t ht g y)
      (grad := fun y : {y : SapdDualSpace m // y ∈ setup.Y} =>
        gradient setup.nuY y.1)
      (γ := setup.tau t)
      (hγ := setup.htau_pos t ht)
      (state := fun p : {y : SapdDualSpace m // y ∈ setup.Y} × SapdDualSpace m × ℝ =>
        p.1)
      (oracle := fun p : {y : SapdDualSpace m // y ∈ setup.Y} × SapdDualSpace m × ℝ =>
        p.2.1)
      (hstate := continuous_fst)
      (horacle := continuous_fst.comp continuous_snd)
      (hgrad := continuous_subtype_of_continuousOn_ambient
        (fun y : {y : SapdDualSpace m // y ∈ setup.Y} => gradient setup.nuY y.1)
        (fun y : SapdDualSpace m => gradient setup.nuY y)
        (by simpa [nuY] using setup.dgfY.gradient_continuousOn)
        (by
          intro y
          rfl))
      (hbound := fun y₁ y₂ g₁ g₂ =>
        setup.dualProxSelector_state_oracle_distance_bound t ht y₁ y₂ g₁ g₂)

/-- Uniqueness leaf for the dual Eq. (4.4.56) compact/lsc prox argmin.

The intended proof uses convexity/lsc of `hatg` plus the modulus-one Bregman
term scaled by the positive stepsize `tau_t`; it is separate from measurable
selection so FILL can attack the source convex-analytic argument directly. -/
theorem dualProxSelector_argmin_unique (t : ℕ) (ht : 1 ≤ t) :
    ∀ p : {y : SapdDualSpace m // y ∈ setup.Y} × SapdDualSpace m × ℝ,
      ∀ z z',
      (∀ y : {y : SapdDualSpace m // y ∈ setup.Y},
        setup.dualProxParamObjective t p.2.1 p.1 z ≤
          setup.dualProxParamObjective t p.2.1 p.1 y) →
      (∀ y : {y : SapdDualSpace m // y ∈ setup.Y},
        setup.dualProxParamObjective t p.2.1 p.1 z' ≤
          setup.dualProxParamObjective t p.2.1 p.1 y) →
      z = z' := by
  classical
  intro p z z' hzmin hz'min
  let P := {y : SapdDualSpace m // y ∈ setup.Y}
  let eval : P → SapdDualSpace m := fun y => y.1
  let grad : P → SapdDualSpace m := fun y => gradient setup.nuY y.1
  let hcar : P → ℝ := fun y => setup.hatg y.1
  let Vcar : P → P → ℝ := fun x y => setup.VY y.1 x.1
  have hvar :
      ∀ {a b : P},
        (∀ y : P,
          SOptLib.proxObjective Vcar hcar eval p.1 (-p.2.1) (setup.tau t) a ≤
            SOptLib.proxObjective Vcar hcar eval p.1 (-p.2.1) (setup.tau t) y) →
        0 ≤
          ⟪-p.2.1, eval b - eval a⟫_ℝ +
            (setup.tau t)⁻¹ * ⟪grad a - grad p.1, eval b - eval a⟫_ℝ +
            (hcar b - hcar a) := by
    intro a b hmin
    have hmin_param :
        ∀ y : P,
          setup.dualProxParamObjective t p.2.1 p.1 a ≤
            setup.dualProxParamObjective t p.2.1 p.1 y := by
      intro y
      have hy := hmin y
      simpa [Vcar, hcar, eval, dualProxParamObjective, SOptLib.proxObjective,
        add_assoc, add_left_comm, add_comm] using hy
    simpa [grad, eval, hcar] using
      setup.dual_prox_minimizer_variational t ht p.1 a b p.2.1 hmin_param
  have hzmin' :
      ∀ y : P,
        SOptLib.proxObjective Vcar hcar eval p.1 (-p.2.1) (setup.tau t) z ≤
          SOptLib.proxObjective Vcar hcar eval p.1 (-p.2.1) (setup.tau t) y := by
    intro y
    have hy := hzmin y
    simpa [Vcar, hcar, eval, dualProxParamObjective, SOptLib.proxObjective,
      add_assoc, add_left_comm, add_comm] using hy
  have hz'min' :
      ∀ y : P,
        SOptLib.proxObjective Vcar hcar eval p.1 (-p.2.1) (setup.tau t) z' ≤
          SOptLib.proxObjective Vcar hcar eval p.1 (-p.2.1) (setup.tau t) y := by
    intro y
    have hy := hz'min y
    simpa [Vcar, hcar, eval, dualProxParamObjective, SOptLib.proxObjective,
      add_assoc, add_left_comm, add_comm] using hy
  exact SOptLib.dualCompositeProxObjective_argmin_unique
    (V := Vcar) (eval := eval) (grad := grad) (h := hcar)
    (by intro a b h; exact Subtype.ext h)
    (base := p.1) (g := -p.2.1) (γ := setup.tau t) (setup.htau_pos t ht)
    z z' hvar
    (by simpa [eval, grad] using setup.dualDgf_gradient_strongMonotone z z')
    hzmin' hz'min'

/-- Boundary for directly supplying dual selector measurability for the
Eq. (4.4.56) argmin selector.

The earlier generic value-function/projection route tried to prove Borel
measurability from joint measurability plus compact lsc fibers. That is a
normal-integrand/descriptive-set-theory theorem, not a Mathlib/SOptLib terminal
available in this file, and it is too broad for the SAPD source object. The
source-boundary process therefore consumes the actual selector measurability
obligation directly through `DualProxSelectorMeasurableAt` rather than via an
