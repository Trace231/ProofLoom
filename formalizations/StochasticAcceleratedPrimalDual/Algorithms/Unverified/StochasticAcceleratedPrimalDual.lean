private noncomputable def algorithm43SourceBoundaryAxTildeCall (t : ℕ) (ω : Ω) : SapdDualSpace m :=
  setup.sourceBoundaryAxTildeCallAt t (setup.algorithm43SourceBoundaryState t ω).xTilde ω

/-- State-only projection of the Algorithm 4.3 source process semantics. -/
private def Algorithm43SourceBoundaryStateSemantics
    (state : ℕ → Ω → StochasticAcceleratedPrimalDualState n m setup.X setup.Y) : Prop :=
  setup.Algorithm43SourceBoundaryProcessSemantics state setup.algorithm43SourceBoundaryAxTildeCall

/-- Defining theorem for the source-boundary Algorithm 4.3 state and displayed
`\hat A_x(\tilde x_t)` call. -/
private theorem algorithm43SourceBoundaryProcess_semantics :
    setup.Algorithm43SourceBoundaryProcessSemantics setup.algorithm43SourceBoundaryState
      setup.algorithm43SourceBoundaryAxTildeCall := by
  unfold Algorithm43SourceBoundaryProcessSemantics
  change
    SOptLib.positiveTimeGeneratedProcessSemantics setup.initialState setup.stepFromGeneratedAx
      (SOptLib.warmStartedQueryDrivenStateProcess setup.initialState setup.stepFromGeneratedAx
        setup.sourceBoundaryAxTildeCallAt
        (fun state : StochasticAcceleratedPrimalDualState n m setup.X setup.Y => state.xTilde))
      (fun t ω =>
        setup.sourceBoundaryAxTildeCallAt t
          ((SOptLib.warmStartedQueryDrivenStateProcess setup.initialState setup.stepFromGeneratedAx
            setup.sourceBoundaryAxTildeCallAt
            (fun state : StochasticAcceleratedPrimalDualState n m setup.X setup.Y =>
              state.xTilde) t ω).xTilde)
          ω)
  exact SOptLib.recursiveGeneratedProcess_semantics setup.initialState setup.stepFromGeneratedAx
    setup.sourceBoundaryAxTildeCallAt
    (fun state : StochasticAcceleratedPrimalDualState n m setup.X setup.Y => state.xTilde)

/-- Extension-only fixed-domain realization predicate for the displayed
`\hat A_x(\tilde x_t)` calls in Algorithm 4.3.

PDF check: Eq. (4.4.6) gives the SFO domain as `(x_i,y_i) ∈ X × Y`, while
Algorithm 4.3 Eq. (4.4.56) queries `\hat A_x(\tilde x_t)`. The book JSON
explicitly does not add `\tilde x_t ∈ X`; this predicate is therefore internal
extension machinery, not a Setup field or paper theorem hypothesis. -/
private def Algorithm43SourceBoundaryDisplayedAxSFORealization (t : ℕ) : Prop :=
  ∀ i, ∀ _hi : i ∈ Finset.Icc 1 t, ∀ ω : Ω,
    (setup.algorithm43SourceBoundaryState i ω).xTilde ∈ setup.X

/-- A source-derived coverage invariant is now the only data needed to realize
the displayed `A_x(\tilde x_i)` calls as fixed-domain SFO calls.

Before the totalization refactor, the realization predicate also carried an
equality against an opaque private value.  The equality now follows from
`SOptLib.totalizeOn_of_mem`; the remaining mathematical burden is exactly the
paper-domain issue noted in the JSON, namely `\tilde x_i ∈ X`. -/
private theorem Algorithm43SourceBoundaryDisplayedAxSFORealization_of_coverage
    (t : ℕ)
    (hcoverage :
      ∀ i, ∀ _hi : i ∈ Finset.Icc 1 t, ∀ ω : Ω,
        (setup.algorithm43SourceBoundaryState i ω).xTilde ∈ setup.X) :
    setup.Algorithm43SourceBoundaryDisplayedAxSFORealization t := by
