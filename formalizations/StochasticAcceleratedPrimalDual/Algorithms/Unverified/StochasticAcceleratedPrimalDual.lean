/-- Martingale cancellation component of Eq. (4.4.73).

The intended proof uses the source statement following Eq. (4.4.72): the noises
are independent of the generated state/auxiliary prox history, so the finite sum
of inner products has zero expectation. -/
private def GeneratedEq4473MartingaleMeanNonpos
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) : Prop :=
  MartingaleResidualMeanNonpos setup.P
    (setup.generatedEq4471MartingaleU generatedAxSample t)

/-- Finite-sum assembly for the martingale cancellation component of
Eq. (4.4.73).

This bridge keeps the hard stochastic proof at the per-index conditional
expectation level.  Once each exact canonical martingale summand is integrable
and has nonpositive expectation, the finite-horizon `U_t` martingale component
has the required integrability and nonpositive mean. -/
private theorem GeneratedEq4473MartingaleMeanNonpos.of_per_index
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ)
    (hterm_int :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 t,
        Integrable
          (fun ω =>
            setup.gamma i *
              (⟪setup.deltaX generatedAxSample i (Finset.mem_Icc.mp hi).1 ω,
                  (setup.auxiliaryProcess generatedAxSample
                    (setup.generatedZ generatedAxSample 1 ω) i ω).1.1 -
                    (setup.generatedZ generatedAxSample i ω).1.1⟫_ℝ +
                ⟪setup.sapdDeltaY generatedAxSample i (Finset.mem_Icc.mp hi).1 ω,
                  (setup.auxiliaryProcess generatedAxSample
                    (setup.generatedZ generatedAxSample 1 ω) i ω).1.2 -
                    (setup.generatedZ generatedAxSample i ω).1.2⟫_ℝ))
          setup.P)
    (hterm_nonpos :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 t,
        ∫ ω,
            setup.gamma i *
              (⟪setup.deltaX generatedAxSample i (Finset.mem_Icc.mp hi).1 ω,
                  (setup.auxiliaryProcess generatedAxSample
                    (setup.generatedZ generatedAxSample 1 ω) i ω).1.1 -
                    (setup.generatedZ generatedAxSample i ω).1.1⟫_ℝ +
                ⟪setup.sapdDeltaY generatedAxSample i (Finset.mem_Icc.mp hi).1 ω,
                  (setup.auxiliaryProcess generatedAxSample
                    (setup.generatedZ generatedAxSample 1 ω) i ω).1.2 -
                    (setup.generatedZ generatedAxSample i ω).1.2⟫_ℝ)
          ∂setup.P ≤ 0) :
    GeneratedEq4473MartingaleMeanNonpos (setup := setup) generatedAxSample t := by
  classical
  let term : ℕ → Ω → ℝ := fun i ω =>
    if hi : 1 ≤ i then
      setup.gamma i *
        (⟪setup.deltaX generatedAxSample i hi ω,
            (setup.auxiliaryProcess generatedAxSample
              (setup.generatedZ generatedAxSample 1 ω) i ω).1.1 -
              (setup.generatedZ generatedAxSample i ω).1.1⟫_ℝ +
          ⟪setup.sapdDeltaY generatedAxSample i hi ω,
            (setup.auxiliaryProcess generatedAxSample
              (setup.generatedZ generatedAxSample 1 ω) i ω).1.2 -
              (setup.generatedZ generatedAxSample i ω).1.2⟫_ℝ)
    else 0
  have hterm_int' : ∀ i ∈ Finset.Icc 1 t, Integrable (term i) setup.P := by
    intro i hi
    have hi_pos : 1 ≤ i := (Finset.mem_Icc.mp hi).1
    have hterm_eq :
        term i =
          (fun ω =>
            setup.gamma i *
              (⟪setup.deltaX generatedAxSample i hi_pos ω,
                  (setup.auxiliaryProcess generatedAxSample
                    (setup.generatedZ generatedAxSample 1 ω) i ω).1.1 -
                    (setup.generatedZ generatedAxSample i ω).1.1⟫_ℝ +
                ⟪setup.sapdDeltaY generatedAxSample i hi_pos ω,
                  (setup.auxiliaryProcess generatedAxSample
                    (setup.generatedZ generatedAxSample 1 ω) i ω).1.2 -
                    (setup.generatedZ generatedAxSample i ω).1.2⟫_ℝ)) := by
      funext ω
      simp [term, hi_pos]
    simpa [hterm_eq] using hterm_int i hi
  have hterm_nonpos' :
      ∀ i ∈ Finset.Icc 1 t, ∫ ω, term i ω ∂setup.P ≤ 0 := by
    intro i hi
    have hi_pos : 1 ≤ i := (Finset.mem_Icc.mp hi).1
    have hterm_eq :
        term i =
          (fun ω =>
            setup.gamma i *
              (⟪setup.deltaX generatedAxSample i hi_pos ω,
                  (setup.auxiliaryProcess generatedAxSample
                    (setup.generatedZ generatedAxSample 1 ω) i ω).1.1 -
                    (setup.generatedZ generatedAxSample i ω).1.1⟫_ℝ +
                ⟪setup.sapdDeltaY generatedAxSample i hi_pos ω,
                  (setup.auxiliaryProcess generatedAxSample
                    (setup.generatedZ generatedAxSample 1 ω) i ω).1.2 -
                    (setup.generatedZ generatedAxSample i ω).1.2⟫_ℝ)) := by
      funext ω
      simp [term, hi_pos]
    simpa [hterm_eq] using hterm_nonpos i hi
  constructor
  · simpa [generatedEq4471MartingaleU, SOptLib.weightedTwoBlockMartingaleResidual, term] using
      (integrable_finset_sum (s := Finset.Icc 1 t) (f := term) hterm_int')
  · calc
      ∫ ω, setup.generatedEq4471MartingaleU generatedAxSample t ω ∂setup.P
          = Finset.sum (Finset.Icc 1 t) (fun i => ∫ ω, term i ω ∂setup.P) := by
            simp only [generatedEq4471MartingaleU, SOptLib.weightedTwoBlockMartingaleResidual,
              term]
            rw [integral_finset_sum (Finset.Icc 1 t) hterm_int']
      _ ≤ Finset.sum (Finset.Icc 1 t) (fun _i => 0) := by
            exact Finset.sum_le_sum hterm_nonpos'
      _ = 0 := by simp

/-- Source Eq. (4.4.69), specialized to the selected maximizer in
`g(\bar z_{t+1})`.

This is the pathwise part of the proof before the auxiliary sequence is used:
Lemma 4.9 gives the generated `B_t(z,z_[t])` term and the source `Λ_i(z)` sum.
Keeping this as a separate source leaf prevents the Eq. (4.4.72) supplier from
hiding all pathwise algebra in one opaque obligation. -/
private def GeneratedEq4469GapMaxLambdaBound
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t) : Prop :=
  ∀ᵐ ω ∂setup.P,
    let zOut := setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω
    let z := setup.gapMaximizer zOut
    setup.beta t * setup.gamma t * setup.gap zOut ≤
      setup.gamma t / setup.eta t * setup.D_X ^ 2 +
        setup.gamma t / setup.tau t * setup.D_Y ^ 2 +
        Finset.sum (Finset.Icc 1 t) (fun i =>
          if hi : 1 ≤ i then setup.LambdaTerm generatedAxSample i hi z ω else 0)

/-- Source Eq. (4.4.70)--(4.4.71), specialized to the selected gap maximizer.

The statement is the exact bridge from the `Λ_i(z)` sum left by Lemma 4.9 to
the auxiliary-process Bregman term plus the canonical `U_t` residual from
Eq. (4.4.71).  It is strictly smaller than the full Eq. (4.4.72) pathwise
envelope because it does not mention the saddle gap or domain-diameter bounds. -/
private def GeneratedEq4471LambdaAuxiliaryBound
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t) : Prop :=
  ∀ᵐ ω ∂setup.P,
    let zOut := setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω
    let z := setup.gapMaximizer zOut
    let z₁ := setup.generatedZ generatedAxSample 1 ω
    Finset.sum (Finset.Icc 1 t) (fun i =>
        if hi : 1 ≤ i then setup.LambdaTerm generatedAxSample i hi z ω else 0) ≤
      setup.auxiliaryBTerm generatedAxSample z₁ t z ω +
        setup.generatedEq4471U generatedAxSample t ω

/-- Auxiliary Bregman-domain diameter bound used after Eq. (4.4.71).

The generated-process boundary term has already been absorbed into the source
Eq. (4.4.69) display.  This helper supplies the remaining auxiliary-process
copy of the bounded-domain estimate, and the two copies together yield the
factor `2` in Eq. (4.4.72). -/
private def GeneratedEq4472BTermDiameterBound
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t) : Prop :=
  ∀ᵐ ω ∂setup.P,
    let zOut := setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω
    let z := setup.gapMaximizer zOut
    let z₁ := setup.generatedZ generatedAxSample 1 ω
    setup.auxiliaryBTerm generatedAxSample z₁ t z ω ≤
      setup.gamma t / setup.eta t * setup.D_X ^ 2 +
        setup.gamma t / setup.tau t * setup.D_Y ^ 2

/-- A single `B_t` boundary term is bounded by the paper's Bregman diameter
condition (4.4.34).

This is the deterministic telescope behind the factor `2` in Eq. (4.4.72):
one copy is applied to the generated APD sequence and one to the auxiliary prox
sequence. -/
private theorem BTerm_le_diameter_bound
    (t : ℕ) (ht : 1 ≤ t)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (zSeq : ℕ → Ω → {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z})
    (ω : Ω) :
    setup.BTerm t z zSeq ω ≤
      setup.gamma t / setup.eta t * setup.D_X ^ 2 +
        setup.gamma t / setup.tau t * setup.D_Y ^ 2 := by
  simpa [BTerm, SOptLib.twoBlockWeightedBregmanBoundary] using
    (sum_two_weighted_forward_diff_le_last_mul_bounds
      (ax := fun i => setup.gamma i / setup.eta i)
      (ay := fun i => setup.gamma i / setup.tau i)
      (vx := fun i => setup.VX z.1.1 (zSeq i ω).1.1)
      (vy := fun i => setup.VY z.1.2 (zSeq i ω).1.2)
      (DX := setup.D_X ^ 2) (DY := setup.D_Y ^ 2) (t := t) ht
      (by
        intro i hi2 _hit
        exact gamma_div_eta_mono setup i hi2)
      (by
        intro i hi2 _hit
        exact gamma_div_tau_mono setup i hi2)
      (by
        exact div_nonneg
          (le_of_lt (gamma_pos setup 1 le_rfl))
          (le_of_lt (setup.heta_pos 1 le_rfl)))
      (by
        exact div_nonneg
          (le_of_lt (gamma_pos setup 1 le_rfl))
          (le_of_lt (setup.htau_pos 1 le_rfl)))
      (by
        have hlower :
            (1 / 2 : ℝ) * ‖z.1.1 - (zSeq (t + 1) ω).1.1‖ ^ 2 ≤
              setup.VX z.1.1 (zSeq (t + 1) ω).1.1 :=
          setup.VX_modulus_one z.1.1 (zSeq (t + 1) ω).1.1
            z.2.1 (zSeq (t + 1) ω).2.1
        have hnonneg : 0 ≤ (1 / 2 : ℝ) *
            ‖z.1.1 - (zSeq (t + 1) ω).1.1‖ ^ 2 := by
          positivity
        exact le_trans hnonneg hlower)
      (by
        have hlower :
            (1 / 2 : ℝ) * ‖z.1.2 - (zSeq (t + 1) ω).1.2‖ ^ 2 ≤
              setup.VY z.1.2 (zSeq (t + 1) ω).1.2 :=
          setup.VY_modulus_one z.1.2 (zSeq (t + 1) ω).1.2
            z.2.2 (zSeq (t + 1) ω).2.2
        have hnonneg : 0 ≤ (1 / 2 : ℝ) *
            ‖z.1.2 - (zSeq (t + 1) ω).1.2‖ ^ 2 := by
          positivity
        exact le_trans hnonneg hlower)
      (by
        intro i _hi _hit
        exact setup.VX_bounded (zSeq i ω).1.1 (zSeq i ω).2.1 z.1.1 z.2.1)
      (by
        intro i _hi _hit
        exact setup.VY_bounded (zSeq i ω).1.2 (zSeq i ω).2.2 z.1.2 z.2.2))

/-- Eq. (4.4.72) follows from its three source-facing pathwise components.

The components are deliberately not theorem-head assumptions of Theorem 4.8;
they are internal source lemmas corresponding to Eq. (4.4.69),
Eq. (4.4.70)--(4.4.71), and the Bregman diameter sentence immediately before
Eq. (4.4.72). -/
private theorem GeneratedGapEq4472PathwiseCanonicalU.of_source_components
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t)
    (h4469 : setup.GeneratedEq4469GapMaxLambdaBound generatedAxSample t ht)
    (hlambda : setup.GeneratedEq4471LambdaAuxiliaryBound generatedAxSample t ht)
    (hdiam : setup.GeneratedEq4472BTermDiameterBound generatedAxSample t ht) :
    setup.GeneratedGapEq4472PathwiseCanonicalU generatedAxSample t ht := by
  filter_upwards [h4469, hlambda, hdiam] with ω hgap hlambda hdiam
  let zOut := setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω
  let z := setup.gapMaximizer zOut
  let z₁ := setup.generatedZ generatedAxSample 1 ω
  let lambdaSum : ℝ :=
    Finset.sum (Finset.Icc 1 t) (fun i =>
      if hi : 1 ≤ i then setup.LambdaTerm generatedAxSample i hi z ω else 0)
  have hgap' :
      setup.beta t * setup.gamma t * setup.gap zOut ≤
        setup.gamma t / setup.eta t * setup.D_X ^ 2 +
          setup.gamma t / setup.tau t * setup.D_Y ^ 2 + lambdaSum := by
    simpa [zOut, z, lambdaSum] using hgap
  have hlambda' :
      lambdaSum ≤
        setup.auxiliaryBTerm generatedAxSample z₁ t z ω +
          setup.generatedEq4471U generatedAxSample t ω := by
    simpa [zOut, z, z₁, lambdaSum] using hlambda
  have hdiam' :
      setup.auxiliaryBTerm generatedAxSample z₁ t z ω ≤
        setup.gamma t / setup.eta t * setup.D_X ^ 2 +
          setup.gamma t / setup.tau t * setup.D_Y ^ 2 := by
    simpa [zOut, z, z₁] using hdiam
  calc
    setup.beta t * setup.gamma t * setup.gap zOut
        ≤ setup.gamma t / setup.eta t * setup.D_X ^ 2 +
          setup.gamma t / setup.tau t * setup.D_Y ^ 2 + lambdaSum := hgap'
    _ ≤ setup.gamma t / setup.eta t * setup.D_X ^ 2 +
          setup.gamma t / setup.tau t * setup.D_Y ^ 2 +
          (setup.auxiliaryBTerm generatedAxSample z₁ t z ω +
            setup.generatedEq4471U generatedAxSample t ω) := by
          exact add_le_add le_rfl hlambda'
    _ = (setup.gamma t / setup.eta t * setup.D_X ^ 2 +
          setup.gamma t / setup.tau t * setup.D_Y ^ 2) +
          setup.auxiliaryBTerm generatedAxSample z₁ t z ω +
            setup.generatedEq4471U generatedAxSample t ω := by ring
    _ ≤
        (setup.gamma t / setup.eta t * setup.D_X ^ 2 +
          setup.gamma t / setup.tau t * setup.D_Y ^ 2) +
          (setup.gamma t / setup.eta t * setup.D_X ^ 2 +
            setup.gamma t / setup.tau t * setup.D_Y ^ 2) +
            setup.generatedEq4471U generatedAxSample t ω := by
          nlinarith [hdiam']
    _ =
        2 * setup.gamma t / setup.eta t * setup.D_X ^ 2 +
          2 * setup.gamma t / setup.tau t * setup.D_Y ^ 2 +
            setup.generatedEq4471U generatedAxSample t ω := by ring

/-- Pointwise Young absorption used in Lan Eq. (4.4.70).

This is the scalar/inner-product step that turns the APD displacement term
`gamma_i * <Delta_i, z_i - z_{i+1}>` plus the negative
`(1-q) gamma_i / (2 eta_i)` square penalty into the explicit
`eta_i gamma_i / (2 (1-q))` square-noise budget.  The same lemma is reused
with `tau_i` and `1-p` for the dual component. -/
private theorem generated_noise_step_young_absorption
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (gamma eta rho : ℝ) (hgamma : 0 < gamma) (heta : 0 < eta) (hrho : 0 < rho)
    (delta step : E) :
    gamma * ⟪delta, -step⟫_ℝ -
        rho * gamma / (2 * eta) * ‖step‖ ^ 2 ≤
      eta * gamma / (2 * rho) * ‖delta‖ ^ 2 := by
  have hinner :
      ⟪delta, -step⟫_ℝ ≤ ‖delta‖ * ‖step‖ := by
    simpa [norm_neg] using real_inner_le_norm delta (-step)
  have hscaled :
      gamma * ⟪delta, -step⟫_ℝ ≤ gamma * (‖delta‖ * ‖step‖) :=
    mul_le_mul_of_nonneg_left hinner (le_of_lt hgamma)
  let L : ℝ := rho / (gamma * eta)
  have hL : 0 < L := by
    exact div_pos hrho (mul_pos hgamma heta)
  have hyoung :=
    mul_mul_le_inv_two_mul_add_half_mul_sq
      (R := ℝ) gamma ‖delta‖ ‖step‖ L hL
  have hcoeff_left :
