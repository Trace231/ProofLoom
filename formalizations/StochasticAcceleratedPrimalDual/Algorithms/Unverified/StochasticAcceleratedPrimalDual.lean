/-- Attainment obligation for the gap maximum in Eq. (4.4.21) at feasible
`\tilde z ∈ Z`.

This bridges the paper's `max_{z ∈ Z}` notation to a selected maximizer. The PDF
notes that `g` may fail to be well-defined on unbounded `Z`; Theorem 4.8 uses
the bounded-domain setting, so attainment/well-definedness is left as a theorem
obligation from those source-backed assumptions rather than as a setup field. -/
theorem gapMaximizer_exists (zTilde : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    ∃ z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z},
      ∀ u : {u : SapdPrimalSpace n × SapdDualSpace m // u ∈ setup.Z},
        setup.Q zTilde u ≤ setup.Q zTilde z := by
  have hhatf_cont : ContinuousOn (fun x : SapdPrimalSpace n => setup.hatf x) setup.X := by
    intro x hx
    exact (setup.hatf_differentiableAt_on_X x hx).continuousAt.continuousWithinAt
  have hhatf_lsc : LowerSemicontinuousOn (fun x : SapdPrimalSpace n => setup.hatf x)
      setup.X :=
    hhatf_cont.lowerSemicontinuousOn
  simpa [Z, Q, Set.prod] using
    exists_isMaxOn_product_of_bregman_bounded_upperSemicontinuousOn
      (X := setup.X) (Y := setup.Y)
      (q := fun z : SapdPrimalSpace n × SapdDualSpace m =>
        SOptLib.saddleGapComparison setup.hatf
          (setup.A : SapdPrimalSpace n → SapdDualSpace m) setup.hatg zTilde.1 z)
      (x0 := setup.x₁) (y0 := setup.y₁) (DX := setup.D_X) (DY := setup.D_Y)
      (VX := setup.VX) (VY := setup.VY)
      setup.hX_closed setup.hY_closed setup.hx₁_mem setup.hy₁_mem
      (by
        intro x hx
        simpa [dist_eq_norm] using setup.VX_modulus_one x setup.x₁ hx setup.hx₁_mem)
      (by
        intro x hx
        exact setup.VX_bounded setup.x₁ setup.hx₁_mem x hx)
      (by
        intro y hy
        simpa [dist_eq_norm] using setup.VY_modulus_one y setup.y₁ hy setup.hy₁_mem)
      (by
        intro y hy
        exact setup.VY_bounded setup.y₁ setup.hy₁_mem y hy)
      (by
        simpa [Z] using
          SOptLib.upperSemicontinuousOn_saddleGapComparison_right
            (hatf := setup.hatf)
            (Aeval := (setup.A : SapdPrimalSpace n → SapdDualSpace m))
            (hatg := setup.hatg)
            hhatf_lsc setup.A.continuous.continuousOn setup.hhatg_lsc zTilde.1)
set_option maxHeartbeats 200000

