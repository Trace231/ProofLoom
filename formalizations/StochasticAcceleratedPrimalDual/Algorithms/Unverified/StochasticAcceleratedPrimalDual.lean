  let zSeq := setup.generatedZ generatedAxSample
  let stPrev := setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω
  let stNext := setup.generatedAxExtensionProcess generatedAxSample t ω
  let dx : SapdPrimalSpace n := stNext.x.1 - stPrev.x.1
  let dy : SapdDualSpace m := z.1.2 - stNext.y.1
  let tailY : ℝ := setup.VY z.1.2 stNext.y.1
  simpa [stPrev, stNext, dx, dy, tailY] using
    (bterm_add_terminal_coupling_le_diameter_bound
      (A := setup.A)
      (ax := fun i => setup.gamma i / setup.eta i)
      (ay := fun i => setup.gamma i / setup.tau i)
      (vx := fun i => setup.VX z.1.1 (zSeq i ω).1.1)
      (vy := fun i => setup.VY z.1.2 (zSeq i ω).1.2)
      (DX := setup.D_X ^ 2) (DY := setup.D_Y ^ 2) (t := t) ht
      (dx := dx) (dy := dy)
      (gamma := setup.gamma t) (tau := setup.tau t) (p := setup.p)
      (squareCoeff := setup.q / (2 * setup.eta t) - setup.Lhatf / (2 * setup.beta t))
      (tailY := tailY)
      (by
        intro i hi2 _hit
        exact gamma_div_eta_mono setup i hi2)
      (by
        intro i hi2 _hit
        exact gamma_div_tau_mono setup i hi2)
      (by
        exact div_nonneg
          (le_of_lt (gamma_pos setup 1 le_rfl))
          (le_of_lt (setup.heta_pos 1 le_rfl)))
      (by
        exact div_nonneg
          (le_of_lt (gamma_pos setup 1 le_rfl))
          (le_of_lt (setup.htau_pos 1 le_rfl)))
      (by
        have hmod :
            (1 / 2 : ℝ) *
                ‖z.1.1 - (zSeq (t + 1) ω).1.1‖ ^ 2 ≤
              setup.VX z.1.1 (zSeq (t + 1) ω).1.1 :=
          setup.VX_modulus_one z.1.1 (zSeq (t + 1) ω).1.1
            z.2.1 (zSeq (t + 1) ω).2.1
        have hnonneg : 0 ≤ (1 / 2 : ℝ) *
            ‖z.1.1 - (zSeq (t + 1) ω).1.1‖ ^ 2 := by
          positivity
        exact le_trans hnonneg hmod)
      (by
        intro i _hi _hit
        exact setup.VX_bounded (zSeq i ω).1.1 (zSeq i ω).2.1 z.1.1 z.2.1)
      (by
        intro i _hi _hit
        exact setup.VY_bounded (zSeq i ω).1.2 (zSeq i ω).2.2 z.1.2 z.2.2)
      (gamma_pos setup t ht)
      (setup.htau_pos t ht)
      setup.hp_mem.1
      (le_of_lt setup.hp_mem.2)
      rfl
      (by simp [tailY, zSeq, generatedZ, stNext])
      (param_coupling_half_nonneg setup t ht)
      (by
        simpa [tailY, dy, stNext] using
          setup.VY_modulus_one z.1.2 stNext.y.1 z.2.2 stNext.y.2))

