/-- A sanity check for the compact/lsc selector boundary.

For merely lower-semicontinuous fibers, dense point evaluations do not determine
the minimum value. The function that is `0` at the origin and `1` off the origin
is lsc, and the punctured line is dense. Therefore the rejected generic
compact/lsc unique-argmin selector route cannot be proved by reducing its
minimization condition to a countable dense set of candidate evaluations. -/
private theorem lsc_dense_values_do_not_determine_minimum :
    ∃ f : ℝ → ℝ,
      LowerSemicontinuous f ∧ Dense ({0}ᶜ : Set ℝ) ∧
        (∀ x ∈ ({0}ᶜ : Set ℝ), f x = 1) ∧ f 0 = 0 := by
  refine ⟨Set.indicator ({0}ᶜ : Set ℝ) (fun _ => (1 : ℝ)), ?_, ?_, ?_, ?_⟩
  · simpa using
      (isOpen_compl_singleton.lowerSemicontinuous_indicator (show (0 : ℝ) ≤ 1 by norm_num))
  · simpa using (dense_compl_singleton (0 : ℝ))
  · intro x hx
    simp [Set.indicator, hx]
  · have h0 : (0 : ℝ) ∉ ({0}ᶜ : Set ℝ) := by simp
    simp [Set.indicator, h0]

