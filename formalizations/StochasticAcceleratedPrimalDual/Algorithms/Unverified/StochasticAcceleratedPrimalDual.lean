    (zeta : ℕ → Ω → ℝ) (sigma : ℕ → ℝ) (N t : ℕ) (theta : ℝ)
    (ht : t ∈ Finset.Icc 1 N)
    (hsigma : 0 < sigma t)
    (hsmall : ¬ (4 / 3 : ℝ) ≤ |theta * sigma t|)
    (hzeta_int : Integrable (zeta t) setup.P)
    (htilt_int : Integrable (fun ω => Real.exp (theta * zeta t ω)) setup.P)
    (hcond_mean_zero :
