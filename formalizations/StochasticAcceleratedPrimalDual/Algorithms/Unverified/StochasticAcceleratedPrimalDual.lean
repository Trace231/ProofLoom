    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) (ω : Ω) :
    setup.generatedBTerm generatedAxSample t z ω +
        setup.gamma t *
          ⟪setup.A ((setup.generatedAxExtensionProcess generatedAxSample t ω).x.1 -
              (setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω).x.1),
            z.1.2 - (setup.generatedAxExtensionProcess generatedAxSample t ω).y.1⟫_ℝ -
        setup.gamma t *
          (setup.q / (2 * setup.eta t) - setup.Lhatf / (2 * setup.beta t)) *
            ‖(setup.generatedAxExtensionProcess generatedAxSample t ω).x.1 -
              (setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω).x.1‖ ^ 2 ≤
