      (lagCross := lagCross) (xSq := xSq) (ySq := ySq) (noise := noise)
      hraw' hbreg' hcoupling'
      (by
        intro i hiIcc
        have hi : 1 ≤ i := (Finset.mem_Icc.mp hiIcc).1
        dsimp [raw, breg, couplingDiff, lagCross, xSq, ySq, noise]
        simp [hi]
        ring)

/-- Summed Young bound for Lan Eq. (4.4.62)'s generated lag-coupling term.

Chosen alignment with Lan Lemma 4.9 step 2: this applies the already proved
`generated_young_coupling_bound` pointwise on the `2 ≤ i` branch and leaves the
result as a raw finite sum, ready for the parameter-coupling absorption step. -/
private theorem generated_lag_cross_young_sum_bound
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (t : ℕ) (ω : Ω) :
    Finset.sum (Finset.Icc 1 t) (fun i =>
        if _hi : 1 ≤ i then
          let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
          let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
          if h2 : 2 ≤ i then
            -setup.gamma (i - 1) *
              ⟪setup.A
                  (stPrev.x.1 -
                    (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1),
                stPrev.y.1 - stNext.y.1⟫_ℝ
          else 0
        else 0) ≤
      Finset.sum (Finset.Icc 1 t) (fun i =>
        if _hi : 1 ≤ i then
          let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
          let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
          if h2 : 2 ≤ i then
            setup.gamma (i - 1) * setup.tau (i - 1) / (2 * setup.p) *
                (‖setup.A‖ ^ 2 *
                  ‖stPrev.x.1 -
                    (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1‖ ^ 2) +
              setup.p * setup.gamma i / (2 * setup.tau i) *
                ‖stPrev.y.1 - stNext.y.1‖ ^ 2
          else 0
        else 0) := by
  classical
  exact
    sum_lag_cross_young_bound (Finset.Icc 1 t) (fun i => 1 ≤ i)
      (fun i => 2 ≤ i)
      setup.A
      (fun i =>
        (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).x.1 -
          (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1)
      (fun i =>
        (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).y.1 -
          (setup.generatedAxExtensionProcess generatedAxSample i ω).y.1)
      (fun i => setup.gamma (i - 1)) (fun i => setup.gamma i)
      (fun i => setup.tau (i - 1)) (fun i => setup.tau i) (fun _ => setup.p)
      (fun i _hiIcc _hi h2 => gamma_pos setup (i - 1) (by omega))
      (fun i _hiIcc _hi h2 => setup.htau_pos (i - 1) (by omega))
      (fun i _hiIcc _hi h2 => setup.htau_pos i (by omega))
      (fun _i _hiIcc _hi _h2 => setup.hp_mem.1)
      (fun i _hiIcc _hi h2 => gamma_div_tau_mono setup i h2)

/-- Exact predecessor reindex for Lan Eq. (4.4.62)'s shifted x-square Young sum.

No SOptLib match: checked presearched `sum_active_triangular_predecessor_le_card_mul_sum`
and searched `Finset Icc predecessor sum if 2 <= i f i - 1 exact reindex`; the
SOptLib candidate is a nonnegative triangular upper bound, while Eq. (4.4.62)
requires this literal closed-interval equality with a false `i = 1` branch. -/
private theorem sum_Icc_two_predecessor {α : Type*} [AddCommMonoid α]
    (f : ℕ → α) (t : ℕ) :
    Finset.sum (Finset.Icc 1 t) (fun i => if 2 ≤ i then f (i - 1) else 0) =
      Finset.sum (Finset.Icc 1 (t - 1)) f := by
  exact sum_Icc_if_two_le_pred_eq_sum_Icc_pred f t

/-- Pointwise x-square absorption from Lan Eq. (4.4.58), in the half-coefficient
form needed by Lemma 4.9's Eq. (4.4.62) finite-window sum.

Chosen alignment: this specializes the local proved bridge
`param_coupling_half_nonneg`; SOptLib/Mathlib scalar candidates are generic
nonnegative-product facts and do not encode the SAPD parameter schedule. -/
private theorem generated_x_square_young_pointwise
    (i : ℕ) (hi : 1 ≤ i) (dx : SapdPrimalSpace n) :
    -setup.gamma i *
        (1 / (2 * setup.eta i) - setup.Lhatf / (2 * setup.beta i)) *
        ‖dx‖ ^ 2 +
      setup.gamma i * setup.tau i / (2 * setup.p) *
        (‖setup.A‖ ^ 2 * ‖dx‖ ^ 2) ≤
      -((1 - setup.q) * setup.gamma i / (2 * setup.eta i)) * ‖dx‖ ^ 2 := by
  exact x_square_young_absorb_of_param_coupling
    (setup.gamma i) (setup.eta i) (setup.beta i) (setup.tau i)
    setup.Lhatf ‖setup.A‖ setup.p setup.q dx
    (le_of_lt (gamma_pos setup i hi))
    (setup.hparam_coupling i hi)

/-- Pointwise y-square coefficient normalization in Lan Eq. (4.4.60).

Chosen alignment: this is the literal `p - 1 = -(1 - p)` scalar identity for
the `Λ_i(z)` y-square term; no SOptLib helper is needed beyond ring algebra. -/
private theorem generated_y_square_young_pointwise
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (ω : Ω) :
    let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
    let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
    setup.p * setup.gamma i / (2 * setup.tau i) *
        ‖stPrev.y.1 - stNext.y.1‖ ^ 2 -
      setup.gamma i / (2 * setup.tau i) *
        ‖stNext.y.1 - stPrev.y.1‖ ^ 2 =
      -((1 - setup.p) * setup.gamma i / (2 * setup.tau i)) *
        ‖stNext.y.1 - stPrev.y.1‖ ^ 2 := by
  dsimp
  simpa using
    (y_square_young_coeff_sub_eq (E := SapdDualSpace m) setup.p (setup.gamma i)
      (setup.tau i)
      ((setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).y.1)
      ((setup.generatedAxExtensionProcess generatedAxSample i ω).y.1))

/-- Branch-sensitive y-square absorption for the `2 ≤ i` Young window in
Lan Eq. (4.4.62).

Chosen alignment: this consumes the local coefficient identity
`generated_y_square_young_pointwise` and the setup membership `p ∈ (0,1)`;
generic finite-sum candidates do not account for the false `i = 1` Young branch. -/
private theorem generated_y_square_young_branch_pointwise
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (i : ℕ) (hi : 1 ≤ i) (ω : Ω) :
    let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
    let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
    (if _h2 : 2 ≤ i then
        setup.p * setup.gamma i / (2 * setup.tau i) *
          ‖stPrev.y.1 - stNext.y.1‖ ^ 2
      else 0) -
      setup.gamma i / (2 * setup.tau i) *
        ‖stNext.y.1 - stPrev.y.1‖ ^ 2 ≤
      -((1 - setup.p) * setup.gamma i / (2 * setup.tau i)) *
        ‖stNext.y.1 - stPrev.y.1‖ ^ 2 := by
  simpa [norm_sub_rev] using
    y_square_branch_absorb_of_p_mem_Ioo setup.p (setup.gamma i) (setup.tau i)
      ((setup.generatedAxExtensionProcess generatedAxSample i ω).y.1 -
        (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).y.1)
      (2 ≤ i) setup.hp_mem (le_of_lt (gamma_pos setup i hi))
      (setup.htau_pos i hi)

/-- Summed y-square absorption for the Young part of Lan Eq. (4.4.62).

Chosen alignment: applies the branch-sensitive pointwise helper over
`Finset.Icc 1 t`; SOptLib telescope/output-window lemmas do not include this
SAPD `Λ_i(z)` coefficient normalization. -/
private theorem generated_y_square_young_absorption
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (t : ℕ) (ω : Ω) :
    Finset.sum (Finset.Icc 1 t) (fun i =>
        if hi : 1 ≤ i then
          let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
          let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
          if _h2 : 2 ≤ i then
            setup.p * setup.gamma i / (2 * setup.tau i) *
              ‖stPrev.y.1 - stNext.y.1‖ ^ 2
          else 0
        else 0) -
      Finset.sum (Finset.Icc 1 t) (fun i =>
        if _hi : 1 ≤ i then
          let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
          let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
          setup.gamma i / (2 * setup.tau i) *
            ‖stNext.y.1 - stPrev.y.1‖ ^ 2
        else 0) ≤
      Finset.sum (Finset.Icc 1 t) (fun i =>
        if _hi : 1 ≤ i then
          let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
          let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
          (-((1 - setup.p) * setup.gamma i / (2 * setup.tau i)) *
            ‖stNext.y.1 - stPrev.y.1‖ ^ 2)
        else 0) := by
  let coeff : ℕ → ℝ := fun i => setup.gamma i / (2 * setup.tau i)
  let dy := fun i : ℕ =>
    (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).y.1 -
      (setup.generatedAxExtensionProcess generatedAxSample i ω).y.1
  have hgeneric :
      Finset.sum (Finset.Icc 1 t) (fun i =>
          if 2 ≤ i then setup.p * coeff i * ‖dy i‖ ^ 2 else 0) -
        Finset.sum (Finset.Icc 1 t) (fun i => coeff i * ‖dy i‖ ^ 2) ≤
        Finset.sum (Finset.Icc 1 t) (fun i =>
          -((1 - setup.p) * coeff i) * ‖dy i‖ ^ 2) := by
    exact
      sum_guarded_sq_absorb_of_nonneg
        (s := Finset.Icc 1 t)
        (dy := dy)
        (p := setup.p)
        (coeff := coeff)
        (active := fun i : ℕ => 2 ≤ i)
        (hp := le_of_lt setup.hp_mem.1)
        (hcoeff := fun i hiIcc =>
          div_nonneg
            (le_of_lt (gamma_pos setup i (Finset.mem_Icc.mp hiIcc).1))
            (mul_nonneg (by norm_num) (le_of_lt (setup.htau_pos i (Finset.mem_Icc.mp hiIcc).1))))
  have hfirst :
      Finset.sum (Finset.Icc 1 t) (fun i =>
          if hi : 1 ≤ i then
            let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
            let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
            if _h2 : 2 ≤ i then
              setup.p * setup.gamma i / (2 * setup.tau i) *
                ‖stPrev.y.1 - stNext.y.1‖ ^ 2
            else 0
          else 0) =
        Finset.sum (Finset.Icc 1 t) (fun i =>
          if 2 ≤ i then setup.p * coeff i * ‖dy i‖ ^ 2 else 0) := by
    refine Finset.sum_congr rfl ?_
    intro i hiIcc
    have hi : 1 ≤ i := (Finset.mem_Icc.mp hiIcc).1
    by_cases h2 : 2 ≤ i
    · have hscalar :
          setup.p * setup.gamma i / (2 * setup.tau i) =
            setup.p * (setup.gamma i / (2 * setup.tau i)) := by
        ring
      simp [hi, h2, coeff, dy, hscalar]
    · simp [hi, h2, coeff, dy]
  have hsecond :
      Finset.sum (Finset.Icc 1 t) (fun i =>
          if _hi : 1 ≤ i then
            let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
            let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
            setup.gamma i / (2 * setup.tau i) *
              ‖stNext.y.1 - stPrev.y.1‖ ^ 2
          else 0) =
        Finset.sum (Finset.Icc 1 t) (fun i => coeff i * ‖dy i‖ ^ 2) := by
    refine Finset.sum_congr rfl ?_
    intro i hiIcc
    have hi : 1 ≤ i := (Finset.mem_Icc.mp hiIcc).1
    have hnorm :
        ‖(setup.generatedAxExtensionProcess generatedAxSample i ω).y.1 -
            (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).y.1‖ ^ 2 =
          ‖(setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).y.1 -
            (setup.generatedAxExtensionProcess generatedAxSample i ω).y.1‖ ^ 2 := by
      rw [norm_sub_rev]
    simp [hi, coeff, dy, hnorm]
  have hthird :
      Finset.sum (Finset.Icc 1 t) (fun i =>
          if _hi : 1 ≤ i then
            let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
            let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
            (-((1 - setup.p) * setup.gamma i / (2 * setup.tau i)) *
              ‖stNext.y.1 - stPrev.y.1‖ ^ 2)
          else 0) =
        Finset.sum (Finset.Icc 1 t) (fun i =>
          -((1 - setup.p) * coeff i) * ‖dy i‖ ^ 2) := by
    refine Finset.sum_congr rfl ?_
    intro i hiIcc
    have hi : 1 ≤ i := (Finset.mem_Icc.mp hiIcc).1
    have hnorm :
        ‖(setup.generatedAxExtensionProcess generatedAxSample i ω).y.1 -
            (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).y.1‖ ^ 2 =
          ‖(setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).y.1 -
            (setup.generatedAxExtensionProcess generatedAxSample i ω).y.1‖ ^ 2 := by
      rw [norm_sub_rev]
    have hscalar :
        (1 - setup.p) * setup.gamma i / (2 * setup.tau i) =
          (1 - setup.p) * (setup.gamma i / (2 * setup.tau i)) := by
      ring
    simp [hi, coeff, dy, hnorm, hscalar]
  rw [hfirst, hsecond, hthird]
  exact hgeneric

/-- Reindex the x-square part of the Young bound in Lan Eq. (4.4.62).

Chosen alignment: this is a direct use of the exact local predecessor equality
`sum_Icc_two_predecessor`; the checked SOptLib triangular predecessor lemma is
only an upper bound and would lose the literal `Λ_i(z)` coefficients. -/
private theorem generated_young_x_predecessor_sum_eq
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (t : ℕ) (ω : Ω) :
    Finset.sum (Finset.Icc 1 t) (fun i =>
        if _hi : 1 ≤ i then
          let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
          if _h2 : 2 ≤ i then
            setup.gamma (i - 1) * setup.tau (i - 1) / (2 * setup.p) *
              (‖setup.A‖ ^ 2 *
                ‖stPrev.x.1 -
                  (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1‖ ^ 2)
          else 0
        else 0) =
      Finset.sum (Finset.Icc 1 (t - 1)) (fun i =>
        setup.gamma i * setup.tau i / (2 * setup.p) *
          (‖setup.A‖ ^ 2 *
            ‖(setup.generatedAxExtensionProcess generatedAxSample i ω).x.1 -
              (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).x.1‖ ^ 2)) := by
  classical
  let f : ℕ → ℕ → ℝ := fun i j =>
    setup.gamma i * setup.tau i / (2 * setup.p) *
      (‖setup.A‖ ^ 2 *
        ‖(setup.generatedAxExtensionProcess generatedAxSample i ω).x.1 -
          (setup.generatedAxExtensionProcess generatedAxSample j ω).x.1‖ ^ 2)
  simpa [f] using sum_young_x_predecessor_eq f t

/-- Summed x-square absorption with the terminal `t` split in Lan Lemma 4.9.

Chosen alignment: combines `generated_x_square_young_pointwise` over the
predecessor window `1..t-1` with the exact terminal decomposition of
`Λ_t(z)` from Eq. (4.4.60). This is not a wrapper for Lemma 4.9: it handles
only the x-square finite-window budget after Young reindexing. -/
private theorem generated_x_square_young_absorption
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (t : ℕ) (ht : 1 ≤ t) (ω : Ω) :
    Finset.sum (Finset.Icc 1 (t - 1)) (fun i =>
        setup.gamma i * setup.tau i / (2 * setup.p) *
          (‖setup.A‖ ^ 2 *
            ‖(setup.generatedAxExtensionProcess generatedAxSample i ω).x.1 -
              (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).x.1‖ ^ 2)) -
      Finset.sum (Finset.Icc 1 t) (fun i =>
        if _hi : 1 ≤ i then
          let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
          let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
          setup.gamma i *
            (1 / (2 * setup.eta i) - setup.Lhatf / (2 * setup.beta i)) *
              ‖stNext.x.1 - stPrev.x.1‖ ^ 2
        else 0) ≤
      -setup.gamma t *
        (setup.q / (2 * setup.eta t) - setup.Lhatf / (2 * setup.beta t)) *
        ‖(setup.generatedAxExtensionProcess generatedAxSample t ω).x.1 -
          (setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω).x.1‖ ^ 2 +
        Finset.sum (Finset.Icc 1 t) (fun i =>
          if _hi : 1 ≤ i then
            let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
            let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
            (-((1 - setup.q) * setup.gamma i / (2 * setup.eta i)) *
              ‖stNext.x.1 - stPrev.x.1‖ ^ 2)
          else 0) := by
  classical
  refine
    finite_window_young_absorption_with_terminal_split
      (young := fun i =>
        setup.gamma i * setup.tau i / (2 * setup.p) *
          (‖setup.A‖ ^ 2 *
            ‖(setup.generatedAxExtensionProcess generatedAxSample i ω).x.1 -
              (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).x.1‖ ^ 2))
      (square := fun i =>
        if _hi : 1 ≤ i then
          let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
          let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
          setup.gamma i *
            (1 / (2 * setup.eta i) - setup.Lhatf / (2 * setup.beta i)) *
              ‖stNext.x.1 - stPrev.x.1‖ ^ 2
        else 0)
      (absorbed := fun i =>
        if _hi : 1 ≤ i then
          let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
          let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
          (-((1 - setup.q) * setup.gamma i / (2 * setup.eta i)) *
            ‖stNext.x.1 - stPrev.x.1‖ ^ 2)
        else 0)
      (terminal :=
        -setup.gamma t *
          (setup.q / (2 * setup.eta t) - setup.Lhatf / (2 * setup.beta t)) *
          ‖(setup.generatedAxExtensionProcess generatedAxSample t ω).x.1 -
            (setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω).x.1‖ ^ 2)
      (t := t) ht ?_ ?_
  · intro i hi _hi_pred
    have hx :=
      generated_x_square_young_pointwise setup i hi
        ((setup.generatedAxExtensionProcess generatedAxSample i ω).x.1 -
          (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).x.1)
    simpa [hi, sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using hx
  · simp [ht]
    ring

/-- Raw lag/x/y/noise remainder absorption in Lan Lemma 4.9.

Chosen alignment with Lan Lemma 4.9 proof step 2: this is the finite-window
Young/parameter-coupling assembly following Eq. (4.4.61)--(4.4.62). It consumes
`generated_lag_cross_young_sum_bound`, `sum_Icc_two_predecessor` through
`generated_young_x_predecessor_sum_eq`, and the pointwise x/y coefficient
helpers; it does not alter the source-facing `Λ_i(z)` definition. -/
private theorem generated_square_young_absorption_bridge
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (t : ℕ) (ht : 1 ≤ t) (ω : Ω)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    let lagCross : ℕ → ℝ := fun i =>
      if _hi : 1 ≤ i then
        let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
        let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
        if _h2 : 2 ≤ i then
          setup.gamma (i - 1) *
            ⟪setup.A
                (stPrev.x.1 -
                  (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1),
              stPrev.y.1 - stNext.y.1⟫_ℝ
        else 0
      else 0;
    let xSq : ℕ → ℝ := fun i =>
      if _hi : 1 ≤ i then
        let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
        let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
        setup.gamma i *
          (1 / (2 * setup.eta i) - setup.Lhatf / (2 * setup.beta i)) *
            ‖stNext.x.1 - stPrev.x.1‖ ^ 2
      else 0;
    let ySq : ℕ → ℝ := fun i =>
      if _hi : 1 ≤ i then
        let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
        let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
        setup.gamma i / (2 * setup.tau i) * ‖stNext.y.1 - stPrev.y.1‖ ^ 2
      else 0;
    let noise : ℕ → ℝ := fun i =>
      if hi : 1 ≤ i then
        let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
        setup.gamma i *
          (⟪(setup.delta generatedAxSample i hi ω).1, stNext.x.1 - z.1.1⟫_ℝ +
            ⟪(setup.delta generatedAxSample i hi ω).2, stNext.y.1 - z.1.2⟫_ℝ)
      else 0;
    -Finset.sum (Finset.Icc 1 t) lagCross -
        Finset.sum (Finset.Icc 1 t) xSq -
        Finset.sum (Finset.Icc 1 t) ySq -
        Finset.sum (Finset.Icc 1 t) noise ≤
      -setup.gamma t *
        (setup.q / (2 * setup.eta t) - setup.Lhatf / (2 * setup.beta t)) *
        ‖(setup.generatedAxExtensionProcess generatedAxSample t ω).x.1 -
          (setup.generatedAxExtensionProcess generatedAxSample (t - 1) ω).x.1‖ ^ 2 +
        Finset.sum (Finset.Icc 1 t) (fun i =>
          if hi : 1 ≤ i then setup.LambdaTerm generatedAxSample i hi z ω else 0) := by
  classical
  let lagCross : ℕ → ℝ := fun i =>
    if _hi : 1 ≤ i then
      let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      if _h2 : 2 ≤ i then
        setup.gamma (i - 1) *
          ⟪setup.A
              (stPrev.x.1 -
                (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1),
            stPrev.y.1 - stNext.y.1⟫_ℝ
      else 0
    else 0
  let lagNeg : ℕ → ℝ := fun i =>
    if _hi : 1 ≤ i then
      let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      if _h2 : 2 ≤ i then
        -setup.gamma (i - 1) *
          ⟪setup.A
              (stPrev.x.1 -
                (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1),
            stPrev.y.1 - stNext.y.1⟫_ℝ
      else 0
    else 0
  let youngXShift : ℕ → ℝ := fun i =>
    if _hi : 1 ≤ i then
      let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      if _h2 : 2 ≤ i then
        setup.gamma (i - 1) * setup.tau (i - 1) / (2 * setup.p) *
          (‖setup.A‖ ^ 2 *
            ‖stPrev.x.1 -
              (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1‖ ^ 2)
      else 0
    else 0
  let youngYShift : ℕ → ℝ := fun i =>
    if _hi : 1 ≤ i then
      let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      if _h2 : 2 ≤ i then
        setup.p * setup.gamma i / (2 * setup.tau i) *
          ‖stPrev.y.1 - stNext.y.1‖ ^ 2
      else 0
    else 0
  let xSq : ℕ → ℝ := fun i =>
    if _hi : 1 ≤ i then
      let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      setup.gamma i *
        (1 / (2 * setup.eta i) - setup.Lhatf / (2 * setup.beta i)) *
          ‖stNext.x.1 - stPrev.x.1‖ ^ 2
    else 0
  let ySq : ℕ → ℝ := fun i =>
    if _hi : 1 ≤ i then
      let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      setup.gamma i / (2 * setup.tau i) * ‖stNext.y.1 - stPrev.y.1‖ ^ 2
    else 0
  let noise : ℕ → ℝ := fun i =>
    if hi : 1 ≤ i then
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      setup.gamma i *
        (⟪(setup.delta generatedAxSample i hi ω).1, stNext.x.1 - z.1.1⟫_ℝ +
          ⟪(setup.delta generatedAxSample i hi ω).2, stNext.y.1 - z.1.2⟫_ℝ)
    else 0
  let lambdaX : ℕ → ℝ := fun i =>
    if _hi : 1 ≤ i then
      let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      (-((1 - setup.q) * setup.gamma i / (2 * setup.eta i)) *
        ‖stNext.x.1 - stPrev.x.1‖ ^ 2)
    else 0
  let lambdaY : ℕ → ℝ := fun i =>
    if _hi : 1 ≤ i then
      let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      (-((1 - setup.p) * setup.gamma i / (2 * setup.tau i)) *
        ‖stNext.y.1 - stPrev.y.1‖ ^ 2)
    else 0
  let lambdaNoise : ℕ → ℝ := fun i =>
    if hi : 1 ≤ i then
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      (-setup.gamma i *
        (⟪(setup.delta generatedAxSample i hi ω).1, stNext.x.1 - z.1.1⟫_ℝ +
          ⟪(setup.delta generatedAxSample i hi ω).2, stNext.y.1 - z.1.2⟫_ℝ))
    else 0
  have hlag_neg :
      -Finset.sum (Finset.Icc 1 t) lagCross =
        Finset.sum (Finset.Icc 1 t) lagNeg := by
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl ?_
    intro i hiIcc
    have hi : 1 ≤ i := (Finset.mem_Icc.mp hiIcc).1
    by_cases h2 : 2 ≤ i <;> simp [lagCross, lagNeg, hi, h2]
  have hyoung_raw :=
    generated_lag_cross_young_sum_bound setup generatedAxSample t ω
  have hsplit_young :
      Finset.sum (Finset.Icc 1 t) (fun i =>
        if _hi : 1 ≤ i then
          let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
          let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
          if _h2 : 2 ≤ i then
            setup.gamma (i - 1) * setup.tau (i - 1) / (2 * setup.p) *
                (‖setup.A‖ ^ 2 *
                  ‖stPrev.x.1 -
                    (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1‖ ^ 2) +
              setup.p * setup.gamma i / (2 * setup.tau i) *
                ‖stPrev.y.1 - stNext.y.1‖ ^ 2
          else 0
        else 0) =
        Finset.sum (Finset.Icc 1 t) youngXShift +
          Finset.sum (Finset.Icc 1 t) youngYShift := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl ?_
    intro i hiIcc
    have hi : 1 ≤ i := (Finset.mem_Icc.mp hiIcc).1
    by_cases h2 : 2 ≤ i <;> simp [youngXShift, youngYShift, hi, h2]
  have hlag_le :
      -Finset.sum (Finset.Icc 1 t) lagCross ≤
        Finset.sum (Finset.Icc 1 t) youngXShift +
