  ∃ B : Ω → ℝ, Integrable B setup.P ∧
    (∀ᵐ ω ∂setup.P,
      ‖setup.gap (setup.algorithm43SourceBoundaryOutput t ht ω)‖ ≤ ‖B ω‖)

