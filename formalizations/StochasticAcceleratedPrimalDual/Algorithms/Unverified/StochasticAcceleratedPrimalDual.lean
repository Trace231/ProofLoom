    (zeta : ℕ → Ω → ℝ) (sigma : ℕ → ℝ) (N : ℕ) (theta : ℝ)
    (hN : 1 ≤ N)
    (htheta : 0 < theta)
    (hzeta_prefix_borel :
      ∀ t, t ∈ Finset.Icc 1 N →
        @Measurable Ω ℝ ((setup.paperPrefixFiltration).seq t) (borel ℝ) (zeta t))
    (hsigma_pos : ∀ t, t ∈ Finset.Icc 1 N → 0 < sigma t)
    (hcond_mean_zero :
      ∀ t, t ∈ Finset.Icc 1 N →
        setup.P[zeta t | (setup.paperPrefixFiltration).seq (t - 1)] =ᵐ[setup.P] 0)
    (hcond_light_tail :
      ∀ t, t ∈ Finset.Icc 1 N →
        SapdConditionalExpectationBound setup.P
          ((setup.paperPrefixFiltration).seq (t - 1))
          (fun ω => Real.exp ((zeta t ω) ^ 2 / (sigma t) ^ 2))
          (fun _ => Real.exp 1)) :
    Integrable
        (fun ω =>
          Real.exp
            (theta * Finset.sum (Finset.Icc 1 N) (fun t => zeta t ω)))
        setup.P ∧
    ∫ ω,
          Real.exp
            (theta * Finset.sum (Finset.Icc 1 N) (fun t => zeta t ω)) ∂setup.P ≤
        Real.exp
          (((3 * theta ^ 2) / 4) *
            Finset.sum (Finset.Icc 1 N) (fun t => sigma t ^ 2)) := by
    change setup.Lemma41PositiveHorizonMGFBound zeta sigma N theta
    haveI : IsProbabilityMeasure setup.P := setup.hP
    simpa [Lemma41PositiveHorizonMGFBound, SapdConditionalExpectationBound] using
      exp_supermartingale_mgf_bound_of_cond_mean_zero_exp_sq_bound
        (μ := setup.P) setup.paperPrefixFiltration zeta sigma N theta
        (le_of_lt htheta) hzeta_prefix_borel hsigma_pos hcond_mean_zero
        (fun t ht => by
          simpa [SapdConditionalExpectationBound] using hcond_light_tail t ht)

/-- Exponential supermartingale induction for the one-based Lemma 4.1
filtration.

This wrapper discharges the degenerate horizon/tilt cases directly, so the only
remaining source proof leaf is the genuine positive-horizon, positive-tilt
conditional-MGF induction. -/
private theorem lemma_4_1_light_tail_exponential_supermartingale_induction
    (zeta : ℕ → Ω → ℝ) (sigma : ℕ → ℝ) (N : ℕ) (theta : ℝ)
    (htheta : 0 ≤ theta)
    (hzeta_prefix_borel :
      ∀ t, t ∈ Finset.Icc 1 N →
        @Measurable Ω ℝ ((setup.paperPrefixFiltration).seq t) (borel ℝ) (zeta t))
    (hsigma_pos : ∀ t, t ∈ Finset.Icc 1 N → 0 < sigma t)
    (hcond_mean_zero :
      ∀ t, t ∈ Finset.Icc 1 N →
        setup.P[zeta t | (setup.paperPrefixFiltration).seq (t - 1)] =ᵐ[setup.P] 0)
    (hcond_light_tail :
      ∀ t, t ∈ Finset.Icc 1 N →
        SapdConditionalExpectationBound setup.P
          ((setup.paperPrefixFiltration).seq (t - 1))
          (fun ω => Real.exp ((zeta t ω) ^ 2 / (sigma t) ^ 2))
          (fun _ => Real.exp 1)) :
    Integrable
        (fun ω =>
          Real.exp
            (theta * Finset.sum (Finset.Icc 1 N) (fun t => zeta t ω)))
        setup.P ∧
      ∫ ω,
          Real.exp
            (theta * Finset.sum (Finset.Icc 1 N) (fun t => zeta t ω)) ∂setup.P ≤
        Real.exp
          (((3 * theta ^ 2) / 4) *
            Finset.sum (Finset.Icc 1 N) (fun t => sigma t ^ 2)) := by
  classical
  by_cases hN0 : N = 0
  · subst N
    have hfun :
        (fun ω =>
          Real.exp
            (theta * Finset.sum (Finset.Icc 1 0) (fun t => zeta t ω))) =
          (fun _ω : Ω => 1) := by
      funext ω
      simp
    haveI : IsProbabilityMeasure setup.P := setup.hP
    constructor
    · simpa [hfun] using (integrable_const (c := (1 : ℝ)) (μ := setup.P))
    · simp [hfun]
  by_cases htheta0 : theta = 0
  · subst theta
    have hfun :
        (fun ω =>
          Real.exp
            (0 * Finset.sum (Finset.Icc 1 N) (fun t => zeta t ω))) =
          (fun _ω : Ω => 1) := by
      funext ω
      simp
    haveI : IsProbabilityMeasure setup.P := setup.hP
    constructor
    · simpa [hfun] using (integrable_const (c := (1 : ℝ)) (μ := setup.P))
    · simp [hfun]
  have hNpos : 1 ≤ N := by omega
  have htheta_pos : 0 < theta := lt_of_le_of_ne htheta (Ne.symm htheta0)
  exact
    setup.lemma_4_1_light_tail_exponential_supermartingale_induction_positive
      zeta sigma N theta hNpos htheta_pos
      hzeta_prefix_borel hsigma_pos hcond_mean_zero hcond_light_tail

/-- Helper form of Lemma 4.1 over the paper's one-based prefix filtration.

  Candidate audit: searched filtration, independence, martingale, and tail-bound
  primitives. Existing SOptLib results give probability wrappers and conditional
expectation bridges, while this paper lemma is the named exponential
supermartingale bound used by Theorem 4.8(b). This helper is not the
paper-facing head because it omits the source's iid-prefix Borel-function
premise, but it now uses the one-based `paperPrefixFiltration` matching
`ξ_[t]` rather than the zero-based implementation filtration. -/
theorem lemma_4_1_light_tail_martingale_bound_filtration_extension
    (zeta : ℕ → Ω → ℝ) (sigma : ℕ → ℝ) (N : ℕ) (lambda : ℝ)
    (hlambda : 0 ≤ lambda)
    (hzeta_prefix_borel :
      ∀ t, t ∈ Finset.Icc 1 N →
        @Measurable Ω ℝ ((setup.paperPrefixFiltration).seq t) (borel ℝ) (zeta t))
    (hsigma_pos : ∀ t, t ∈ Finset.Icc 1 N → 0 < sigma t)
    (hcond_mean_zero :
      ∀ t, t ∈ Finset.Icc 1 N →
        setup.P[zeta t | (setup.paperPrefixFiltration).seq (t - 1)] =ᵐ[setup.P] 0)
    (hcond_light_tail :
      ∀ t, t ∈ Finset.Icc 1 N →
        SapdConditionalExpectationBound setup.P
          ((setup.paperPrefixFiltration).seq (t - 1))
          (fun ω => Real.exp ((zeta t ω) ^ 2 / (sigma t) ^ 2))
          (fun _ => Real.exp 1)) :
    setup.P
        {ω : Ω |
          Finset.sum (Finset.Icc 1 N) (fun t => zeta t ω) >
            lambda * Real.sqrt (Finset.sum (Finset.Icc 1 N) (fun t => sigma t ^ 2))} ≤
      ENNReal.ofReal (Real.exp (-(lambda ^ 2) / 3)) := by
  haveI : IsProbabilityMeasure setup.P := setup.hP
  exact
    measure_sum_gt_sqrt_variance_le_of_cond_mean_zero_exp_sq_bound_filtration
      (μ := setup.P) (filt := setup.paperPrefixFiltration)
      (zeta := zeta) (sigma := sigma) (N := N) (lambda := lambda)
      hlambda hzeta_prefix_borel hsigma_pos hcond_mean_zero
      (by
        intro t ht
        simpa [SapdConditionalExpectationBound] using hcond_light_tail t ht)

/-- Paper Lemma 4.1, light-tail martingale large-deviation bound.

PDF Lemma 4.1 states that `ξ_[t]` is an iid prefix, `ζ_t = ζ_t(ξ_[t])`
is a deterministic Borel function of that prefix, the conditional mean is zero,
the conditional exponential moment is bounded by `exp 1`, and deterministic
`σ_t > 0` scales are used. This head keeps those source objects explicit
instead of replacing them with an arbitrary filtration-level martingale lemma. -/
theorem lemma_4_1_light_tail_martingale_bound
    (zeta : ℕ → Ω → ℝ) (sigma : ℕ → ℝ) (N : ℕ) (lambda : ℝ)
    (hlambda : 0 ≤ lambda)
    (hzeta_prefix_borel :
      ∀ t, t ∈ Finset.Icc 1 N →
        ∃ phi : (Fin t → S) → ℝ,
          Measurable phi ∧
            zeta t = fun ω => phi (fun j : Fin t => setup.ξ (j.1 + 1) ω))
    (hsigma_pos : ∀ t, t ∈ Finset.Icc 1 N → 0 < sigma t)
    (hcond_mean_zero :
      ∀ t, t ∈ Finset.Icc 1 N →
        setup.P[zeta t | (setup.paperPrefixFiltration).seq (t - 1)] =ᵐ[setup.P] 0)
    (hcond_light_tail :
      ∀ t, t ∈ Finset.Icc 1 N →
        SapdConditionalExpectationBound setup.P
          ((setup.paperPrefixFiltration).seq (t - 1))
          (fun ω => Real.exp ((zeta t ω) ^ 2 / (sigma t) ^ 2))
          (fun _ => Real.exp 1)) :
    setup.P
        {ω : Ω |
          Finset.sum (Finset.Icc 1 N) (fun t => zeta t ω) >
            lambda * Real.sqrt (Finset.sum (Finset.Icc 1 N) (fun t => sigma t ^ 2))} ≤
      ENNReal.ofReal (Real.exp (-(lambda ^ 2) / 3)) := by
  classical
  haveI : IsProbabilityMeasure setup.P := setup.hP
  have hzeta_meas :
      ∀ t, t ∈ Finset.Icc 1 N →
        @Measurable Ω ℝ ((setup.paperPrefixFiltration).seq t) (borel ℝ) (zeta t) := by
    intro t ht
    rcases hzeta_prefix_borel t ht with ⟨phi, hphi, hzetat⟩
    rw [hzetat]
    exact setup.prefixBorel_measurable_paperPrefixFiltration t phi hphi
  exact
    measure_sum_gt_sqrt_variance_le_of_cond_mean_zero_exp_sq_bound_filtration
      (μ := setup.P) setup.paperPrefixFiltration zeta sigma N lambda
      hlambda hzeta_meas hsigma_pos
      (by
        intro t ht
        simpa [paperPrefixFiltration] using hcond_mean_zero t ht)
      (by
        intro t ht
        simpa [SapdConditionalExpectationBound, paperPrefixFiltration] using
          hcond_light_tail t ht)

/-- High-probability rate term `Q_1(t)` from Theorem 4.8(b). -/
noncomputable def Q1 (t : ℕ) : ℝ :=
  primalDualTailDeviationBudget setup.beta setup.gamma setup.eta setup.tau
    setup.D_X setup.D_Y setup.sigmaX setup.sigmaY setup.p setup.q t

