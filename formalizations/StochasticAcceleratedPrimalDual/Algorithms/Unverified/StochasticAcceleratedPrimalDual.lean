/-!
# Stochastic Accelerated Primal-Dual Method

Object-layer scaffold for Lan's stochastic accelerated primal-dual method for
stochastic bilinear saddle-point problems, Algorithm 4.3 and Theorem 4.8.

The algorithmic spine is defined from the paper's canonical objects: a bounded
linear map `A`, the generated sample-prefix filtration, stochastic oracle
kernels evaluated on sampled randomness, Bregman divergences generated by
distance-generating functions, argmin-defined primal/dual prox points, and the
recursive APD iterate process.
-/

open MeasureTheory ProbabilityTheory
open SOptLib (PrimalDualAcceleratedState primalDualAcceleratedStateMapMeasurable
  secondMoment secondMomentWellDefined fixedQueryStagedOracleVarianceBound
  fixedQueryExponentialMoment fixedQueryStagedOracleLightTailBound
  threeStagedOracleLightTailBounds
  isCompact_of_closed_of_bregman_half_sq_le_bounded_at_base
  exists_isMaxOn_product_of_bregman_bounded_upperSemicontinuousOn
  generatedDriverAcceleratedPrimalDualStep_measurable_of_components
  acceleratedPrimalDualStep)
open scoped BigOperators InnerProductSpace

namespace SOptLib

/-- Terminal output measurability follows from totalized calls and
variational-stability selector suppliers. -/
theorem recursiveProcess_outputMeasurable_of_totalizedCall_and_variationalStability
    {Ω State Call Output : Type*} [MeasurableSpace Ω] [MeasurableSpace Output]
    (stateRegular : (Ω → State) → Prop)
    (callRegular : (Ω → Call) → Prop)
    (state : ℕ → Ω → State)
    (call : ℕ → Ω → Call)
    (output : (t : ℕ) → 1 ≤ t → Ω → Output)
    (SelectedSelectorMeasurableAt DualSelectorMeasurableAt PrimalSelectorMeasurableAt :
      (i : ℕ) → 1 ≤ i → Prop)
    (T : ℕ) (hT : 1 ≤ T)
    (hinit : stateRegular (state 1))
    (hcall_of_state :
      ∀ i, stateRegular (state i) → callRegular (call i))
    (hstep_of_selectors :
      (∀ i, ∀ hi : 1 ≤ i, i ≤ T →
        SelectedSelectorMeasurableAt i hi) →
        RecursiveProcessOneStepMeasurableUpTo
          stateRegular callRegular state call T)
    (hdual_of_variational_stability :
      ∀ i, ∀ hi : 1 ≤ i, DualSelectorMeasurableAt i hi)
    (hprimal :
      ∀ i, ∀ hi : 1 ≤ i, PrimalSelectorMeasurableAt i hi)
    (hselected_of_components :
      ∀ i, ∀ hi : 1 ≤ i,
        DualSelectorMeasurableAt i hi →
        PrimalSelectorMeasurableAt i hi →
          SelectedSelectorMeasurableAt i hi)
    (houtput :
      stateRegular (state (T + 1)) →
        Measurable (output T hT)) :
    Measurable (output T hT) := by
  refine
    recursiveProcess_outputMeasurable_of_totalizedCallBoundary
      stateRegular
      callRegular
      state
      call
      output
      T
      hT
      hinit
      hcall_of_state
      ?_
      houtput
  exact hstep_of_selectors
    (fun i hi _hiT =>
      hselected_of_components i hi
        (hdual_of_variational_stability i hi)
        (hprimal i hi))

end SOptLib

/-!
The paper-facing object layer is finite-dimensional: Lan §4.4 states
`X ⊆ ℝ^n` and `Y ⊆ ℝ^m`.  These aliases make that realization explicit instead
of exporting Theorem 4.8 over arbitrary Hilbert spaces.
-/

/-- Paper primal ambient space `ℝ^n`.

No SOptLib match: searched `finite dimensional Euclidean real coordinate space`,
scanned `Model/Carrier.lean` finite-dimensional carrier primitives, and found
helpers over an abstract finite-dimensional `E`, not the source-facing
coordinate space required by Lan §4.4. -/
abbrev SapdPrimalSpace (n : ℕ) := EuclideanSpace ℝ (Fin n)

/-- Paper dual ambient space `ℝ^m`.

No SOptLib match: searched `finite dimensional Euclidean real coordinate space`,
scanned `Model/Carrier.lean` finite-dimensional carrier primitives, and found
helpers over an abstract finite-dimensional `E`, not the source-facing
coordinate space required by Lan §4.4. -/
abbrev SapdDualSpace (m : ℕ) := EuclideanSpace ℝ (Fin m)

noncomputable local instance SapdEuclideanSpace.measurableSpace (k : ℕ) :
    MeasurableSpace (EuclideanSpace ℝ (Fin k)) :=
  borel _

local instance SapdEuclideanSpace.borelSpace (k : ℕ) :
    BorelSpace (EuclideanSpace ℝ (Fin k)) :=
  ⟨rfl⟩

variable {n m : ℕ}
variable {S : Type*} [MeasurableSpace S]
variable {Ω : Type*} [MeasurableSpace Ω]

/-- Source-facing smooth convex primal function `\hat f` on the feasible carrier.

Lan §4.4 states that `\hat f` is a general smooth convex function satisfying
Eq. (4.4.2), and Eq. (4.4.6) uses unbiased estimators of its actual gradient.
Considered `SOptLib.Convex.carrier_smooth_quadratic_upper_bound` and
`SOptLib.Model.Carrier` gradient helpers; they are proof bridges from stronger
regularity data or abstract carrier-totalization tools, while this paper needs a
source-facing smooth-function object whose gradient is part of the mathematical
datum rather than Mathlib's totalized fallback. -/
structure SapdSmoothConvexFunction
    (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (X : Set E) (L : ℝ) where
  toFun : E → ℝ
  grad : E → E
  convexOn : ConvexOn ℝ X toFun
  gradient_at : ∀ x, x ∈ X → HasGradientAt toFun (grad x) x
  smooth_upper_bound :
    ∀ x, x ∈ X → ∀ u, u ∈ X →
      toFun u - toFun x - ⟪grad x, u - x⟫_ℝ ≤ (L / 2) * ‖u - x‖ ^ 2

instance SapdSmoothConvexFunction.instCoeFun
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {X : Set E} {L : ℝ} :
    CoeFun (SapdSmoothConvexFunction E X L) (fun _ => E → ℝ) where
  coe f := f.toFun

namespace SapdSmoothConvexFunction

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable {X : Set E} {L : ℝ} (f : SapdSmoothConvexFunction E X L)

/-- The paper gradient of a source-facing smooth function is a genuine gradient
on the feasible carrier. -/
theorem hasGradientAt (x : E) (hx : x ∈ X) :
    HasGradientAt f (f.grad x) x :=
  f.gradient_at x hx

/-- Differentiability on the feasible carrier follows from the source-facing
gradient semantics. -/
theorem differentiableAt (x : E) (hx : x ∈ X) :
    DifferentiableAt ℝ f x := by
  exact (f.gradient_at x hx).hasFDerivAt.differentiableAt

/-- Smoothness inequality Eq. (4.4.2), exposed as a theorem from the smooth
function carrier rather than a loose setup witness. -/
theorem smooth (x : E) (hx : x ∈ X) (u : E) (hu : u ∈ X) :
    f u - f x - ⟪f.grad x, u - x⟫_ℝ ≤ (L / 2) * ‖u - x‖ ^ 2 :=
  f.smooth_upper_bound x hx u hu

end SapdSmoothConvexFunction

/-- Source-facing distance-generating function on a feasible carrier.

This is the canonical object used for Lan Eq. (4.4.12)--(4.4.13): Sect. 3.2
defines a DGF as continuous/convex on the carrier, continuously differentiable
where its gradient is used, and strongly convex; §4.4 specializes `ν_X` and `ν_Y` to
modulus 1. Considered `SOptLib.bregmanDivergence`,
`SOptLib.carrierBregmanFormula`, and
`SOptLib.carrierBregmanDivergence_lower_bound_all_carrier_from_dense`; they
provide Bregman values and proof bridges, but not the paper-facing DGF carrier
datum that replaces the bare `ν` plus lower-bound witness fields. -/
abbrev SapdDistanceGeneratingFunction
    (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (X : Set E) :=
  SOptLib.DistanceGeneratingFunctionOn E X

namespace SapdDistanceGeneratingFunction

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable {X : Set E} (ν : SapdDistanceGeneratingFunction E X)

/-- Bregman divergence generated by a source-facing DGF.

Chosen alignment: specializes `SOptLib.carrierBregmanFormula` to the identity
carrier evaluation and Mathlib's canonical gradient, matching Lan
Eq. (4.4.12)--(4.4.13) while keeping DGF differentiability inside the DGF
object. -/
noncomputable def bregman (x u : E) : ℝ :=
  carrierBregmanFormula ν.potential (fun x : E => x)
    (fun x => gradient ν.potential x) u x

theorem bregman_def (x u : E) :
    ν.bregman x u =
      ν.potential x - ν.potential u - ⟪gradient ν.potential u, x - u⟫_ℝ := by
  rfl

/-- The DGF gradient used in the Bregman formula is a genuine gradient on the
paper carrier, not a silent use of Mathlib's totalized fallback. -/
theorem hasGradientAt (x : E) (hx : x ∈ X) :
    HasGradientAt ν.potential (gradient ν.potential x) x :=
  ν.gradient_at x hx

/-- The DGF gradient is continuous on the paper carrier, matching the
continuously differentiable DGF clause from Lan Sect. 3.2. -/
theorem gradient_continuousOn :
    ContinuousOn (fun x => gradient ν.potential x) X :=
  ν.grad_continuousOn

/-- Differentiability of the DGF on feasible points, derived from its
source-facing gradient semantics. -/
theorem differentiableAt (x : E) (hx : x ∈ X) :
    DifferentiableAt ℝ ν.potential x := by
  exact (ν.gradient_at x hx).hasFDerivAt.differentiableAt

/-- Joint carrier-continuity of the Bregman divergence generated by the
source-facing DGF. This is the concrete continuity bridge needed by prox-selector
regularity arguments; it is derived from the DGF object rather than assumed on
the selector. -/
theorem bregman_continuousOn :
    ContinuousOn (fun p : E × E => ν.bregman p.1 p.2) (X ×ˢ X) := by
  simpa [bregman] using
    (continuousOn_bregmanFormula_of_continuousOn
      (S := X) (v := ν.potential) (grad := fun x : E => gradient ν.potential x)
      (eval := fun x : E => x) ν.continuousOn ν.grad_continuousOn
      continuous_id.continuousOn)

/-- All-carrier Bregman lower bound derived from modulus-one strong convexity.

Chosen alignment: considered `bregman_lower_bound_of_strongConvexOn_intrinsicInterior`,
`carrierBregmanDivergence_lower_bound_of_strongConvexOn_intrinsicInterior`, and
`carrierBregmanDivergence_lower_bound_all_carrier_from_dense`; the first two
require intrinsic-interior membership and the last requires dense-extension
premises, while Lan Eq. (4.4.12)--(4.4.13) gives modulus-one strong convexity
on the feasible carrier and this paper-local DGF supplies a genuine ambient
gradient at the carrier base point. -/
private theorem bregman_lower_bound_of_strongConvexOn_all_carrier
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {X : Set E} {v : E → ℝ} {grad : E → E} {V : E → E → ℝ} {a b : E}
    (hV : V a b = v b - v a - ⟪grad a, b - a⟫_ℝ)
    (hstrong : StrongConvexOn X 1 v)
    (hgrad : HasGradientAt v (grad a) a)
    (ha : a ∈ X) (hb : b ∈ X) :
    (1 / 2 : ℝ) * ‖a - b‖ ^ 2 ≤ V a b := by
  have hcore :=
    bregman_lower_bound_of_strongConvexOn_hasGradientAt
      (X := X) (v := v) (grad := grad) (m := (1 : ℝ)) (a := a) (b := b)
      hstrong hgrad ha hb
  rw [hV]
  simpa [carrierBregmanFormula] using hcore

/-- Modulus-one DGF lower bound for the associated Bregman divergence.

This is a derived bridge from the source DGF object and the strong convexity
statement, not a setup witness. -/
theorem bregman_lower_bound (x u : E) (hx : x ∈ X) (hu : u ∈ X) :
    (1 / 2 : ℝ) * ‖x - u‖ ^ 2 ≤ ν.bregman x u := by
  have h :=
    bregman_lower_bound_of_strongConvexOn_all_carrier
      (v := ν.potential) (grad := fun y => gradient ν.potential y)
      (V := fun a b => ν.bregman b a) (a := u) (b := x)
      (by simp [SapdDistanceGeneratingFunction.bregman_def])
      ν.stronglyConvex_modulus_one (ν.gradient_at u hu) hu hx
  simpa [norm_sub_rev] using h

end SapdDistanceGeneratingFunction

/-- Source-facing simple dual function `\hat g` on the feasible dual carrier.

Lan §4.4 states that `\hat g : Y → ℝ` is relatively simple, proper, convex, and
lower semicontinuous.  This structure keeps those stated properties attached to
the function object itself, instead of storing a raw function together with
parallel witness fields in the SAPD setup. -/
abbrev SapdSimpleConvexFunction
    (E : Type*) [TopologicalSpace E] [AddCommMonoid E] [Module ℝ E]
    (Y : Set E) :=
  SOptLib.SimpleConvexFunctionOn E Y

instance SapdSimpleConvexFunction.instCoeFun
    {E : Type*} [TopologicalSpace E] [AddCommMonoid E] [Module ℝ E]
    {Y : Set E} :
    CoeFun (SapdSimpleConvexFunction E Y) (fun _ => E → ℝ) where
  coe f := f.toFun

namespace SapdSimpleConvexFunction

variable {E : Type*} [TopologicalSpace E] [AddCommMonoid E] [Module ℝ E]
variable {Y : Set E}

/-- Properness/nonemptiness component of Lan's simple dual function datum. -/
theorem proper (g : SapdSimpleConvexFunction E Y) : ∃ y, y ∈ Y :=
  SOptLib.SimpleConvexFunctionOn.proper g

/-- Convexity component of Lan's simple dual function datum. -/
theorem convex (g : SapdSimpleConvexFunction E Y) : ConvexOn ℝ Y g :=
  SOptLib.SimpleConvexFunctionOn.convex g

/-- Lower-semicontinuity component of Lan's simple dual function datum. -/
theorem lsc (g : SapdSimpleConvexFunction E Y) : LowerSemicontinuousOn g Y :=
  SOptLib.SimpleConvexFunctionOn.lsc g

end SapdSimpleConvexFunction

/-- State of Algorithm 4.3 after one paper-indexed APD state has been generated.

Chosen alignment: considered `SOptLib.iterateProcess_mem`,
`SOptLib.recursiveIterateProcess`, and `SOptLib.positiveTimeIterateView`; those
provide generic process and subtype membership bridges, while Lan Algorithm 4.3
has a paper-specific APD state carrying `x_t`, `y_t`, aggregates, and
`\tilde x_t`. The extrapolated `\tilde x_t` is intentionally ambient, not a
feasible subtype: book/FOML/StochasticAcceleratedPrimalDual.json#/source_scope_notes/4
records that the current source does not add `\tilde x_t ∈ X` or an ambient
oracle-domain assumption for the generated `A_hat_x(\tilde x_t)` call. -/
abbrev StochasticAcceleratedPrimalDualState (n m : ℕ)
    (X : Set (SapdPrimalSpace n)) (Y : Set (SapdDualSpace m)) :=
  PrimalDualAcceleratedState (SapdPrimalSpace n) (SapdDualSpace m) X Y

/-- Componentwise measurability for a stochastic APD state map.

The state record itself is paper-local; downstream probability statements only
need measurability of its coordinate fields and aggregate projections. -/
def StochasticAcceleratedPrimalDualStateMapMeasurable
    {X : Set (SapdPrimalSpace n)} {Y : Set (SapdDualSpace m)}
    (state : Ω → StochasticAcceleratedPrimalDualState n m X Y) : Prop :=
  primalDualAcceleratedStateMapMeasurable state

/-- Componentwise adaptedness of an APD state map to a chosen sigma algebra.

This is the filtration-relative analogue of
`StochasticAcceleratedPrimalDualStateMapMeasurable`.  It is not a new source
assumption: generated-process variance bridges use it only as a local proof
interface for Lan's sample-prefix adaptedness semantics. -/
def StochasticAcceleratedPrimalDualStateMapMeasurableAt
    {X : Set (SapdPrimalSpace n)} {Y : Set (SapdDualSpace m)}
    (mΩ : MeasurableSpace Ω)
    (state : Ω → StochasticAcceleratedPrimalDualState n m X Y) : Prop :=
  @Measurable Ω {x : SapdPrimalSpace n // x ∈ X} mΩ (by infer_instance)
      (fun ω => (state ω).x) ∧
    @Measurable Ω {y : SapdDualSpace m // y ∈ Y} mΩ (by infer_instance)
      (fun ω => (state ω).y) ∧
    @Measurable Ω {x : SapdPrimalSpace n // x ∈ X} mΩ (by infer_instance)
      (fun ω => (state ω).xBar) ∧
    @Measurable Ω {y : SapdDualSpace m // y ∈ Y} mΩ (by infer_instance)
      (fun ω => (state ω).yBar) ∧
    @Measurable Ω (SapdPrimalSpace n) mΩ (by infer_instance)
      (fun ω => (state ω).xTilde)

/-- Ambient measurability follows from adaptedness to any sub-sigma algebra
below the ambient measurable space. -/
theorem StochasticAcceleratedPrimalDualStateMapMeasurableAt.to_measurable
    {X : Set (SapdPrimalSpace n)} {Y : Set (SapdDualSpace m)}
    {mΩ : MeasurableSpace Ω}
    {state : Ω → StochasticAcceleratedPrimalDualState n m X Y}
    (hstate : StochasticAcceleratedPrimalDualStateMapMeasurableAt (n := n) (m := m)
      mΩ state)
    (hmΩ : mΩ ≤ (by infer_instance : MeasurableSpace Ω)) :
    StochasticAcceleratedPrimalDualStateMapMeasurable state :=
  ⟨hstate.1.mono hmΩ le_rfl, hstate.2.1.mono hmΩ le_rfl,
    hstate.2.2.1.mono hmΩ le_rfl, hstate.2.2.2.1.mono hmΩ le_rfl,
    hstate.2.2.2.2.mono hmΩ le_rfl⟩

/-- Adaptedness is monotone in the sigma algebra. -/
theorem StochasticAcceleratedPrimalDualStateMapMeasurableAt.mono
    {X : Set (SapdPrimalSpace n)} {Y : Set (SapdDualSpace m)}
    {mΩ mΩ' : MeasurableSpace Ω}
    {state : Ω → StochasticAcceleratedPrimalDualState n m X Y}
    (hstate : StochasticAcceleratedPrimalDualStateMapMeasurableAt (n := n) (m := m)
      mΩ state)
    (hmΩ : mΩ ≤ mΩ') :
    StochasticAcceleratedPrimalDualStateMapMeasurableAt (n := n) (m := m)
      mΩ' state :=
  ⟨hstate.1.mono hmΩ le_rfl, hstate.2.1.mono hmΩ le_rfl,
    hstate.2.2.1.mono hmΩ le_rfl, hstate.2.2.2.1.mono hmΩ le_rfl,
    hstate.2.2.2.2.mono hmΩ le_rfl⟩

/-- Source expectation of a fixed-query oracle output in Eq. (4.4.6).

Chosen alignment: reuses `SOptLib.stagedOracleValue` and
`SOptLib.stagedOracleMean` after checking `SOptLib.oracleWellDefined`,
`SOptLib.oracleVarianceWellDefined`, and `SOptLib.stagedOracleMean`; the paper
states the expectation identity itself, and `SapdOracleUnbiased` includes
integrability as part of that displayed expectation's semantics rather than as a
separate theorem-head assumption. -/
noncomputable def SapdOracleExpectation
    {X E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (P : Measure Ω) (oracle : X → S → E) (ξ : ℕ → Ω → S)
    (x : X) (t : ℕ) : E :=
  ∫ ω, SOptLib.stagedOracleValue oracle ξ t x ω ∂P

/-- Well-definedness of the fixed-query expectation displayed in Eq. (4.4.6).

Chosen alignment: considered `SOptLib.oracleWellDefined` and
`SOptLib.stagedOracleMean`; this paper-local predicate specializes the generic
well-definedness condition to Lan's staged sample process and keeps it inside
the semantics of the displayed expectation rather than as an extra theorem-head
assumption. -/
def SapdOracleExpectationWellDefined
    {X E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (P : Measure Ω) (oracle : X → S → E) (ξ : ℕ → Ω → S)
    (x : X) (t : ℕ) : Prop :=
  Integrable (fun ω => SOptLib.stagedOracleValue oracle ξ t x ω) P

/-- Fixed-query unbiased oracle statement for Eq. (4.4.6).

The predicate records the source expectation as a well-defined expectation,
rather than an equality between totalized Bochner integrals.  This follows the
paper notation `E[...] = ...` in Eq. (4.4.6): integrability is part of the
meaning of the displayed expectation, while later random-query regularity
obligations remain derived theorems and do not appear in Theorem 4.8 heads. -/
noncomputable def SapdOracleUnbiased
    {X E : Type*} [MeasurableSpace Ω] [MeasurableSpace E]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (P : Measure Ω) (oracle : X → S → E) (ξ : ℕ → Ω → S)
    (target : X → E) (x : X) (t : ℕ) : Prop :=
  SapdOracleExpectationWellDefined P oracle ξ x t ∧
    SapdOracleExpectation P oracle ξ x t = target x

/-- Source expectation of a fixed-query squared oracle error.

No SOptLib match: checked `SOptLib.oracleVarianceKernel`,
`SOptLib.oracleSampleVarianceWellDefined`, and
`SOptLib.oracleRandomIterateVarianceBound`; they center errors at a mean oracle
or package random-iterate transfer hypotheses, while Lan Assumption 8 states a
fixed-query expectation against the displayed deterministic targets
`∇\hat f(x)`, `Ax`, and `Aᵀy`. This local wrapper names the displayed second
moment; `SapdOracleVarianceBound` includes integrability as part of the
displayed second-moment semantics. -/
noncomputable def SapdSecondMoment
    {E : Type*} [MeasurableSpace Ω] [MeasurableSpace E]
    [NormedAddCommGroup E]
    (P : Measure Ω) (error : Ω → E) : ℝ :=
  secondMoment P error

/-- Well-definedness of the fixed-query second moment in Assumption 8.

Chosen alignment: considered `SOptLib.oracleVarianceWellDefined` and
`SOptLib.oracleSampleVarianceWellDefined`; they center their kernels at an
oracle mean, while Assumption 8 centers at the displayed deterministic targets,
so this local predicate records integrability of Lan's target-centered squared
error. -/
def SapdSecondMomentWellDefined
    {E : Type*} [MeasurableSpace Ω] [MeasurableSpace E]
    [NormedAddCommGroup E]
    (P : Measure Ω) (error : Ω → E) : Prop :=
  secondMomentWellDefined P error

/-- Fixed-query variance statement for Assumption 8.

Chosen alignment: considered `SOptLib.oracleVarianceKernel` and
`SOptLib.oracleSampleVarianceWellDefined`; they measure deviation from an oracle
mean, while Assumption 8 states the squared deviation from the source target
`∇\hat f(x)`, `Ax`, or `Aᵀy`. This predicate keeps the paper target explicit;
integrability is included as part of the displayed expectation semantics, so the
assumption cannot be satisfied only by Lean's totalized integral fallback. -/
noncomputable def SapdOracleVarianceBound
    {X E : Type*} [MeasurableSpace Ω] [MeasurableSpace E]
    [NormedAddCommGroup E]
    (P : Measure Ω) (oracle : X → S → E) (ξ : ℕ → Ω → S)
    (target : X → E) (sigma : ℝ) (x : X) (t : ℕ) : Prop :=
  fixedQueryStagedOracleVarianceBound P oracle ξ target sigma x t

/-- Extension-side expectation for Assumption 9's fixed-query exponential error
under an explicit nonzero variance scale.

No SOptLib match: searched `exponential moment light tail stochastic oracle` and
checked the filtration/oracle candidates; SOptLib supplies independence and
variance-transfer primitives but no fixed-query light-tail expectation matching
Lan Assumption 9. This is not a paper-canonical object because the current
source does not state the denominator nonzero regime. -/
noncomputable def SapdExponentialMoment
    {E : Type*} [MeasurableSpace Ω] [MeasurableSpace E]
    [NormedAddCommGroup E]
    (P : Measure Ω) (error : Ω → E) (sigma : ℝ) (hSigma : sigma ≠ 0) : ℝ :=
  SOptLib.fixedQueryExponentialMoment P error sigma hSigma

/-- Extension-side fixed-query exponential-moment statement for Assumption 9.

Chosen alignment: considered the Assumption 9 pre-search candidates
`SOptLib.filtration`, `SOptLib.samplePrefixFiltration_indep_current`, and the
oracle variance kernels; they provide history/variance machinery but no
source-facing light-tail primitive with the missing denominator semantics. The
current source gives no separate positivity/nonzero assumption for the displayed
variance scales, so this wrapper is explicitly extension-only. It records the
random-variable and Bochner-integrability facts implicit in the source
expectation notation, while the displayed quotient remains guarded by a
nonzero-scale argument rather than exported as paper-canonical Assumption 9. -/
noncomputable def SapdOracleLightTailBoundExtension
    {X E : Type*} [MeasurableSpace Ω] [MeasurableSpace E]
    [NormedAddCommGroup E]
    (P : Measure Ω) (oracle : X → S → E) (ξ : ℕ → Ω → S)
    (target : X → E) (sigma : ℝ) (x : X) (t : ℕ) : Prop :=
  fixedQueryStagedOracleLightTailBound P oracle ξ target sigma x t

/-- Formal source predicate for Assumption 9's displayed light-tail inequality.

No SOptLib match: searched `exponential moment light tail stochastic oracle`,
checked the filtration/oracle candidates, scanned `SOptLib/Model/TailBounds.lean`,
`SOptLib/Model/TailProbability.lean`, and `SOptLib/Layer0/Oracle.lean`, and found
tail-event and variance-transfer tools but no primitive for Lan Assumption 9's
displayed quotient with an unstated denominator convention. This declaration is
therefore intentionally formal: it records the source assertion without using
Lean's totalized division when `sigma = 0`. Denominator-safe analytic realizations
remain in `SapdOracleLightTailBoundExtension`. -/
opaque SapdDisplayedLightTailBound
    {E : Type*} [MeasurableSpace Ω] [MeasurableSpace E]
    [NormedAddCommGroup E]
    (P : Measure Ω) (error : Ω → E) (sigma : ℝ) : Prop

/-- Assumption 9 as displayed in the source.

No SOptLib match: searched `exponential moment light tail stochastic oracle`,
checked the filtration/oracle candidates, and found independence/variance
transfer tools but no fixed-query exponential-moment primitive matching Lan
Assumption 9. The PDF displays quotients by the variance scales and gives no
separate zero-denominator convention; this predicate delegates to the formal
source predicate `SapdDisplayedLightTailBound` rather than Lean-dividing by
`sigma ^ 2`. -/
noncomputable def SapdOracleLightTailBoundAsDisplayed
    {X E : Type*} [MeasurableSpace Ω] [MeasurableSpace E]
    [NormedAddCommGroup E]
    (P : Measure Ω) (oracle : X → S → E) (ξ : ℕ → Ω → S)
    (target : X → E) (sigma : ℝ) (x : X) (t : ℕ) : Prop :=
  SapdDisplayedLightTailBound P
    (fun ω => target x - SOptLib.stagedOracleValue oracle ξ t x ω) sigma

/-- Source conditional-expectation inequality with Lean well-definedness.

Mathlib totalizes `μ[f | m]` to zero when `f` is not integrable.  Lan's
conditional-expectation notation in Lemma 4.1 is the source expectation, so a
Lean realization of a conditional light-tail inequality must record integrability
of the integrand together with the a.e. conditional bound. -/
def SapdConditionalExpectationBound
    {mΩ : MeasurableSpace Ω} (P : @Measure Ω mΩ) (m : MeasurableSpace Ω)
    (f bound : Ω → ℝ) : Prop :=
  condExpBound P m f bound

namespace SapdConditionalExpectationBound

variable {mΩ : MeasurableSpace Ω} {P : @Measure Ω mΩ} {m : MeasurableSpace Ω}
variable {f bound : Ω → ℝ}

/-- Integrability component of the source conditional-expectation bound. -/
theorem integrable (h : SapdConditionalExpectationBound P m f bound) :
    Integrable f P :=
  condExpBound.integrable h

/-- A.e. conditional-expectation inequality component of the source bound. -/
theorem ae_le (h : SapdConditionalExpectationBound P m f bound) :
    P[f | m] ≤ᵐ[P] bound :=
  condExpBound.ae_le h

end SapdConditionalExpectationBound

namespace SapdOracleLightTailBoundExtension

variable {S Ω X E : Type*} [MeasurableSpace Ω] [MeasurableSpace E]
variable [NormedAddCommGroup E]
variable {P : Measure Ω} {oracle : X → S → E} {ξ : ℕ → Ω → S}
variable {target : X → E} {sigma : ℝ} {x : X} {t : ℕ}

/-- Random-variable semantics for the Assumption 9 squared error. -/
theorem sqError_measurable
    (h : SapdOracleLightTailBoundExtension P oracle ξ target sigma x t) :
    Measurable (fun ω => ‖target x - SOptLib.stagedOracleValue oracle ξ t x ω‖ ^ 2) :=
  by
    exact h.1

/-- Extension-side denominator well-definedness for Assumption 9's displayed
quotient.

The PDF/JSON does not separately state a positivity clause for the variance
scale in Assumption 9. This theorem therefore takes the nonzero fact explicitly
and is extension/internal only. -/
theorem denominator_nonzero_extension
    (_h : SapdOracleLightTailBoundExtension P oracle ξ target sigma x t)
    (hSigma : sigma ≠ 0) :
    sigma ≠ 0 :=
  hSigma

/-- Extension-side Assumption 9 exponential-moment bound, with Lean regularity
obligations kept as derived facts rather than extra paper assumptions. -/
theorem expMoment_bound
    (h : SapdOracleLightTailBoundExtension P oracle ξ target sigma x t)
    (hSigma : sigma ≠ 0) :
    Measurable
        (fun ω => Real.exp
          (‖target x - SOptLib.stagedOracleValue oracle ξ t x ω‖ ^ 2 / sigma ^ 2)) ∧
      Integrable
        (fun ω => Real.exp
          (‖target x - SOptLib.stagedOracleValue oracle ξ t x ω‖ ^ 2 / sigma ^ 2)) P ∧
      ∫ ω, Real.exp
          (‖target x - SOptLib.stagedOracleValue oracle ξ t x ω‖ ^ 2 / sigma ^ 2) ∂P ≤
        Real.exp 1 := by
  exact ⟨Real.measurable_exp.comp (h.1.div_const (sigma ^ 2)),
    (h.2 hSigma).1, by simpa [SapdExponentialMoment] using (h.2 hSigma).2⟩

end SapdOracleLightTailBoundExtension

/-- Source-facing setup data and stated assumptions for Lan Eq. (4.4.1) and
Algorithm 4.3.

The stochastic APD prox maps and iterate sequence are deliberately not fields:
they are constructed below as canonical `argmin` selectors and a recursive
process. Fields here are limited to paper data, parameters, and assumptions
listed in the book JSON setup/assumptions/algorithm-parameter blocks. -/
structure StochasticAcceleratedPrimalDualSetup
    (n m : ℕ)
    (S : Type*) [MeasurableSpace S]
    (Ω : Type*) [MeasurableSpace Ω] where
  X : Set (SapdPrimalSpace n)
  Y : Set (SapdDualSpace m)
  x₁ : SapdPrimalSpace n
  y₁ : SapdDualSpace m
  A : SapdPrimalSpace n →L[ℝ] SapdDualSpace m
  Lhatf : ℝ
  hatf : SapdSmoothConvexFunction (SapdPrimalSpace n) X Lhatf
  hatg : SapdSimpleConvexFunction (SapdDualSpace m) Y
  dgfX : SapdDistanceGeneratingFunction (SapdPrimalSpace n) X
  dgfY : SapdDistanceGeneratingFunction (SapdDualSpace m) Y
  beta : ℕ → ℝ
  gamma : ℕ → ℝ
  theta : ℕ → ℝ
  eta : ℕ → ℝ
  tau : ℕ → ℝ
  p : ℝ
  q : ℝ
  sigmaXHatf : ℝ
  sigmaY : ℝ
  sigmaXA : ℝ
  D_X : ℝ
  D_Y : ℝ
  oracleG : {x : SapdPrimalSpace n // x ∈ X} → S → SapdPrimalSpace n
  oracleAx : {x : SapdPrimalSpace n // x ∈ X} → S → SapdDualSpace m
  oracleAy : {y : SapdDualSpace m // y ∈ Y} → S → SapdPrimalSpace n
  ξ : ℕ → Ω → S
  P : Measure Ω
  hP : IsProbabilityMeasure P
  hX_closed : IsClosed X
  hY_closed : IsClosed Y
  hX_convex : Convex ℝ X
  hY_convex : Convex ℝ Y
  hx₁_mem : x₁ ∈ X
  hy₁_mem : y₁ ∈ Y
  hbeta_one : beta 1 = 1
  hbeta_rec : ∀ t, 1 ≤ t → beta (t + 1) - 1 = beta t * theta (t + 1)
  hgamma_one : gamma 1 = 1
  hgamma_rec : ∀ t, 2 ≤ t → gamma t = (theta t)⁻¹ * gamma (t - 1)
  htheta_range :
    ∀ t, 2 ≤ t → 0 < theta t ∧ theta t ≤ min (eta (t - 1) / eta t) (tau (t - 1) / tau t)
  heta_pos : ∀ t, 1 ≤ t → 0 < eta t
  htau_pos : ∀ t, 1 ≤ t → 0 < tau t
  hp_mem : p ∈ Set.Ioo (0 : ℝ) 1
  hq_mem : q ∈ Set.Ioo (0 : ℝ) 1
  hparam_coupling :
    ∀ t, 1 ≤ t → 0 ≤ q / eta t - Lhatf / beta t - ‖A‖ ^ 2 * tau t / p
  hLhatf_nonneg : 0 ≤ Lhatf
  hsigmaXHatf_nonneg : 0 ≤ sigmaXHatf
  hsigmaY_nonneg : 0 ≤ sigmaY
  hsigmaXA_nonneg : 0 ≤ sigmaXA
  hD_X_pos : 0 < D_X
  hD_Y_pos : 0 < D_Y
  hVX_bounded : ∀ x₁, x₁ ∈ X → ∀ x₂, x₂ ∈ X →
    dgfX.bregman x₂ x₁ ≤ D_X ^ 2
  hVY_bounded : ∀ y₁, y₁ ∈ Y → ∀ y₂, y₂ ∈ Y →
    dgfY.bregman y₂ y₁ ≤ D_Y ^ 2
  hξ_indep : iIndepFun (β := fun _ => S) ξ P
  hξ_ident : ∀ t, IdentDistrib (ξ t) (ξ 0) P P
  hξ_measurable : ∀ t : ℕ, Measurable (ξ t)
  horacleG_measurable :
    Measurable (fun p : {x : SapdPrimalSpace n // x ∈ X} × S => oracleG p.1 p.2)
  horacleAx_measurable :
    Measurable (fun p : {x : SapdPrimalSpace n // x ∈ X} × S => oracleAx p.1 p.2)
  horacleAy_measurable :
    Measurable (fun p : {y : SapdDualSpace m // y ∈ Y} × S => oracleAy p.1 p.2)
  horacle_unbiased_G :
    ∀ x : {x : SapdPrimalSpace n // x ∈ X}, ∀ t, 1 ≤ t →
      SapdOracleUnbiased P oracleG ξ (fun x => hatf.grad x.1) x t
  horacle_unbiased_Ax :
    ∀ x : {x : SapdPrimalSpace n // x ∈ X}, ∀ t, 1 ≤ t →
      SapdOracleUnbiased P oracleAx ξ (fun x => A x.1) x t
  horacle_unbiased_Ay :
    ∀ y : {y : SapdDualSpace m // y ∈ Y}, ∀ t, 1 ≤ t →
      SapdOracleUnbiased P oracleAy ξ (fun y => A.adjoint y.1) y t
  horacle_variance_G :
    ∀ x : {x : SapdPrimalSpace n // x ∈ X}, ∀ t, 1 ≤ t →
      SapdOracleVarianceBound P oracleG ξ (fun x => hatf.grad x.1) sigmaXHatf x t
  horacle_variance_Ax :
    ∀ x : {x : SapdPrimalSpace n // x ∈ X}, ∀ t, 1 ≤ t →
      SapdOracleVarianceBound P oracleAx ξ (fun x => A x.1) sigmaY x t
  horacle_variance_Ay :
    ∀ y : {y : SapdDualSpace m // y ∈ Y}, ∀ t, 1 ≤ t →
      SapdOracleVarianceBound P oracleAy ξ (fun y => A.adjoint y.1) sigmaXA y t

/-- Extension-side Assumption 9 light-tail conditions for Theorem 4.8(b).

These fields are deliberately separate from `StochasticAcceleratedPrimalDualSetup`:
book/FOML/StochasticAcceleratedPrimalDual.json#/main_theorem states part (a)
under Assumption 8, while part (b) is the one that adds Assumption 9. Because
the JSON does not state denominator nonzero facts for Assumption 9's displayed
quotients, this structure is extension-only, not the paper-facing theorem
boundary. -/
structure StochasticAcceleratedPrimalDualLightTailExtension
    (setup : StochasticAcceleratedPrimalDualSetup n m S Ω) : Prop where
  hlight_tail_G :
    ∀ x : {x : SapdPrimalSpace n // x ∈ setup.X}, ∀ t, 1 ≤ t →
      SapdOracleLightTailBoundExtension setup.P setup.oracleG setup.ξ
        (fun x => setup.hatf.grad x.1) setup.sigmaXHatf x t
  hlight_tail_Ax :
    ∀ x : {x : SapdPrimalSpace n // x ∈ setup.X}, ∀ t, 1 ≤ t →
      SapdOracleLightTailBoundExtension setup.P setup.oracleAx setup.ξ
        (fun x => setup.A x.1) setup.sigmaY x t
  hlight_tail_Ay :
    ∀ y : {y : SapdDualSpace m // y ∈ setup.Y}, ∀ t, 1 ≤ t →
      SapdOracleLightTailBoundExtension setup.P setup.oracleAy setup.ξ
        (fun y => setup.A.adjoint y.1) setup.sigmaXA y t

namespace StochasticAcceleratedPrimalDualSetup

variable (setup : StochasticAcceleratedPrimalDualSetup n m S Ω)

/-- Properness/nonemptiness of the source-facing simple dual function `\hat g`. -/
theorem hhatg_proper : ∃ y, y ∈ setup.Y :=
  SapdSimpleConvexFunction.proper setup.hatg

/-- Convexity of the source-facing simple dual function `\hat g`. -/
theorem hhatg_convex : ConvexOn ℝ setup.Y setup.hatg :=
  SapdSimpleConvexFunction.convex setup.hatg

/-- Lower-semicontinuity of the source-facing simple dual function `\hat g`. -/
theorem hhatg_lsc : LowerSemicontinuousOn setup.hatg setup.Y :=
  SapdSimpleConvexFunction.lsc setup.hatg

/-- Paper Assumption 9 as displayed fixed-query exponential-moment inequalities.

This records the three source inequalities for `\hat G`, `\hat A_x`, and
`\hat A_y` through a formal displayed-light-tail predicate. The source still
does not state a nonzero-denominator convention for the variance scales, so this
definition does not unfold to Lean division by `sigma ^ 2`; denominator-safe
analytic bridges remain extension-only. -/
noncomputable def assumption9AsStated : Prop :=
  threeStagedOracleLightTailBounds setup.P
    (fun P error sigma => SapdDisplayedLightTailBound P error sigma)
    (fun P error sigma => SapdDisplayedLightTailBound P error sigma)
    (fun P error sigma => SapdDisplayedLightTailBound P error sigma)
    setup.oracleG setup.oracleAx setup.oracleAy setup.ξ
    (fun x => setup.hatf.grad x.1) (fun x => setup.A x.1)
    (fun y => setup.A.adjoint y.1)
    setup.sigmaXHatf setup.sigmaY setup.sigmaXA 1

/-- Measurability of the stochastic sample stream used to build the natural
filtration.

The book JSON states the samples are i.i.d.; in Lean this random-variable
interface includes coordinate measurability in addition to independence and
identical distribution. -/
theorem sample_measurable (t : ℕ) : Measurable (setup.ξ t) := by
  exact setup.hξ_measurable t

/-- Natural sample-prefix filtration generated by the oracle samples.

This reuses `SOptLib.Model.Filtration.filtration`, aligning the stochastic
oracle history with Lan's conditioning on the past sample prefix. -/
noncomputable def filtration : Filtration ℕ (by infer_instance : MeasurableSpace Ω) :=
  SOptLib.filtration setup.ξ (setup.sample_measurable)

/-- One-based sample-prefix filtration matching the paper notation `ξ_[t]`.

The ambient `filtration` above is the zero-based SOptLib stream filtration.
Lan's Lemma 4.1 is written with one-based prefixes `ξ_1, ..., ξ_t`; this
shifted filtration exposes that source object directly instead of asking
filtration proofs to bridge an off-by-one convention implicitly. -/
noncomputable def paperPrefixFiltration :
    Filtration ℕ (by infer_instance : MeasurableSpace Ω) :=
  SOptLib.filtration (fun j ω => setup.ξ (j + 1) ω)
    (fun j => setup.hξ_measurable (j + 1))

/-- Borel functions of the source one-based prefix are measurable for the
paper-prefix filtration.

This is the concrete bridge needed by Lemma 4.1's hypothesis
`ζ_t = ζ_t(ξ_[t])`: it is a Mathlib/SOptLib measurability fact for the
canonical shifted sample-prefix object, not a stochastic assumption. -/
theorem prefixBorel_measurable_paperPrefixFiltration
    (t : ℕ) (phi : (Fin t → S) → ℝ) (hphi : Measurable phi) :
    Measurable[(setup.paperPrefixFiltration).seq t]
      (fun ω => phi (fun j : Fin t => setup.ξ (j.1 + 1) ω)) := by
  simpa [paperPrefixFiltration] using
    SOptLib.measurable_borel_finPrefix_shiftedPrefixFiltration
      setup.ξ setup.hξ_measurable 1 t phi hphi

/-- Product feasible set `Z = X × Y` for Eq. (4.4.20). -/
def Z : Set (SapdPrimalSpace n × SapdDualSpace m) :=
  Set.prod setup.X setup.Y

/-- Linear adjoint `Aᵀ`, derived canonically from the bounded linear map `A`.

This uses Mathlib's Hilbert-space adjoint instead of storing the transpose as a
separate witness field. -/
noncomputable def ATranspose : SapdDualSpace m →L[ℝ] SapdPrimalSpace n :=
  setup.A.adjoint

/-- Operator norm `‖A‖` from Eq. (4.4.2), derived from Mathlib's norm on the
bounded linear map instead of stored as a primitive real witness. -/
noncomputable def normA : ℝ :=
  ‖setup.A‖

theorem normA_def : setup.normA = ‖setup.A‖ := by
  rfl

theorem normA_nonneg : 0 ≤ setup.normA := by
  simp [normA]

/-- Operator-norm Lipschitz bound for the bilinear map in Eq. (4.4.2), derived
from the canonical bounded-linear-map norm. -/
theorem A_bound (x : SapdPrimalSpace n) (_hx : x ∈ setup.X)
    (u : SapdPrimalSpace n) (_hu : u ∈ setup.X) :
    ‖setup.A u - setup.A x‖ ≤ setup.normA * ‖u - x‖ := by
  simpa [normA, map_sub] using setup.A.le_opNorm (u - x)

/-- Canonical smooth primal gradient `∇ \hat f(x)` from Eq. (4.4.2).

This projects the gradient from the source-facing smooth-convex carrier, so the
paper gradient is not Mathlib's totalized fallback outside differentiability. -/
noncomputable def hatfGradient (x : SapdPrimalSpace n) : SapdPrimalSpace n :=
  SOptLib.smoothConvexFunctionGradient
    ({ toFun := setup.hatf.toFun,
       grad := setup.hatf.grad,
       convexOn := setup.hatf.convexOn,
       gradient_at := setup.hatf.gradient_at,
       smooth_upper_bound := setup.hatf.smooth_upper_bound } :
      SOptLib.SmoothConvexFunction (SapdPrimalSpace n) setup.X setup.Lhatf) x

theorem hatfGradient_def (x : SapdPrimalSpace n) :
    setup.hatfGradient x = setup.hatf.grad x := by
  rfl

/-- Source-gradient well-definedness obligation for Eq. (4.4.2).

The PDF states `\hat f` is a smooth convex function and writes `∇\hat f(x)`.
This theorem is now projected from the smooth-function carrier rather than left
as a later unconstrained bridge. -/
theorem hatf_hasGradientAt_on_X (x : SapdPrimalSpace n) (hx : x ∈ setup.X) :
    HasGradientAt setup.hatf (setup.hatfGradient x) x := by
  exact setup.hatf.hasGradientAt x hx

/-- Differentiability of `\hat f` on the feasible carrier. -/
theorem hatf_differentiableAt_on_X (x : SapdPrimalSpace n) (hx : x ∈ setup.X) :
    DifferentiableAt ℝ setup.hatf x := by
  simpa using
    SOptLib.SmoothConvexFunction.differentiableAt_on
      ({ toFun := setup.hatf.toFun,
         grad := setup.hatf.grad,
         convexOn := setup.hatf.convexOn,
         gradient_at := setup.hatf.gradient_at,
         smooth_upper_bound := setup.hatf.smooth_upper_bound } :
        SOptLib.SmoothConvexFunction (SapdPrimalSpace n) setup.X setup.Lhatf) x hx

/-- Smoothness inequality Eq. (4.4.2), stated with the canonical gradient. -/
theorem hatf_smooth (x : SapdPrimalSpace n) (hx : x ∈ setup.X)
    (u : SapdPrimalSpace n) (hu : u ∈ setup.X) :
    setup.hatf u - setup.hatf x - ⟪setup.hatfGradient x, u - x⟫_ℝ ≤
      (setup.Lhatf / 2) * ‖u - x‖ ^ 2 := by
  exact setup.hatf.smooth x hx u hu

/-- Corrected internal regularity predicate for routes that need a full ambient
gradient-Lipschitz estimate on the feasible carrier.

Lan Eq. (4.4.2) is kept as the source-facing smoothness assumption above.  In
the present Lean realization `X` may be lower-dimensional, and that displayed
quadratic model along `X` does not by itself control normal components of an
ambient `HasGradientAt` gradient.  Consequently this predicate is not a setup
field and is not used as evidence for the unqualified Theorem 4.8 route; it is
only an explicit condition for optional corrected/internal mismatch-budget
suppliers. -/
def HatfGradientLipschitzOnX : Prop :=
  GradientLipschitzOn setup.X setup.hatfGradient setup.Lhatf

/-- Primal distance-generating function potential `ν_X` from Eq. (4.4.12),
projected from the source-facing DGF carrier object. -/
noncomputable def nuX : SapdPrimalSpace n → ℝ :=
  setup.dgfX.potential

/-- Dual distance-generating function potential `ν_Y` from Eq. (4.4.13),
projected from the source-facing DGF carrier object. -/
noncomputable def nuY : SapdDualSpace m → ℝ :=
  setup.dgfY.potential

/-- Bregman divergence `V_X(x,u)` from Eq. (4.4.12).

Chosen alignment: specializes the local source-facing DGF carrier's
`bregman`, which itself is backed by `SOptLib.carrierBregmanFormula`. This
keeps the paper's literal formula while removing the previous lower-bound
witness field. -/
noncomputable def VX (x u : SapdPrimalSpace n) : ℝ :=
  setup.dgfX.bregman x u

/-- Bregman divergence `V_Y(y,v)` from Eq. (4.4.13).

Chosen alignment: specializes the local source-facing DGF carrier's
`bregman`, which itself is backed by `SOptLib.carrierBregmanFormula`. -/
noncomputable def VY (y v : SapdDualSpace m) : ℝ :=
  setup.dgfY.bregman y v

theorem VX_def (x u : SapdPrimalSpace n) :
    setup.VX x u = setup.nuX x - setup.nuX u - ⟪gradient setup.nuX u, x - u⟫_ℝ := by
  simp [VX, nuX, SapdDistanceGeneratingFunction.bregman, carrierBregmanFormula]

theorem VY_def (y v : SapdDualSpace m) :
    setup.VY y v = setup.nuY y - setup.nuY v - ⟪gradient setup.nuY v, y - v⟫_ℝ := by
  simp [VY, nuY, SapdDistanceGeneratingFunction.bregman, carrierBregmanFormula]

/-- Joint continuity of the primal Bregman divergence on `X × X`, derived from
the source-facing DGF regularity rather than from a prox-selector assumption. -/
theorem VX_continuousOn :
    ContinuousOn (fun p : SapdPrimalSpace n × SapdPrimalSpace n => setup.VX p.1 p.2)
      (setup.X ×ˢ setup.X) := by
  simpa [VX] using setup.dgfX.bregman_continuousOn

/-- Joint continuity of the dual Bregman divergence on `Y × Y`, derived from
the source-facing DGF regularity rather than from a prox-selector assumption. -/
theorem VY_continuousOn :
    ContinuousOn (fun p : SapdDualSpace m × SapdDualSpace m => setup.VY p.1 p.2)
      (setup.Y ×ˢ setup.Y) := by
  simpa [VY] using setup.dgfY.bregman_continuousOn

/-- Source-gradient well-definedness obligation for the DGF `ν_X` in Eq. (4.4.12).

The PDF defines `V_X` using `∇ν_X` and says `ν_X` is a distance-generating
function; differentiability of that gradient is therefore a derived bridge, not a
Setup witness field. -/
theorem nuX_differentiableAt_on_X (x : SapdPrimalSpace n) (hx : x ∈ setup.X) :
    DifferentiableAt ℝ setup.nuX x := by
  exact setup.dgfX.differentiableAt x hx

/-- Source-gradient well-definedness obligation for the DGF `ν_Y` in Eq. (4.4.13). -/
theorem nuY_differentiableAt_on_Y (y : SapdDualSpace m) (hy : y ∈ setup.Y) :
    DifferentiableAt ℝ setup.nuY y := by
  exact setup.dgfY.differentiableAt y hy

/-- The Mathlib gradient in `V_X` agrees with the source DGF gradient on `X`. -/
theorem nuX_hasGradientAt_on_X (x : SapdPrimalSpace n) (hx : x ∈ setup.X) :
    HasGradientAt setup.nuX (gradient setup.nuX x) x := by
  exact setup.dgfX.gradient_at x hx

/-- The Mathlib gradient in `V_Y` agrees with the source DGF gradient on `Y`. -/
theorem nuY_hasGradientAt_on_Y (y : SapdDualSpace m) (hy : y ∈ setup.Y) :
    HasGradientAt setup.nuY (gradient setup.nuY y) y := by
  exact setup.dgfY.gradient_at y hy

theorem VX_modulus_one (x u : SapdPrimalSpace n) (hx : x ∈ setup.X) (hu : u ∈ setup.X) :
    (1 / 2 : ℝ) * ‖x - u‖ ^ 2 ≤ setup.VX x u := by
  exact setup.dgfX.bregman_lower_bound x u hx hu

theorem VY_modulus_one (y v : SapdDualSpace m) (hy : y ∈ setup.Y) (hv : v ∈ setup.Y) :
    (1 / 2 : ℝ) * ‖y - v‖ ^ 2 ≤ setup.VY y v := by
  exact setup.dgfY.bregman_lower_bound y v hy hv

theorem VX_bounded (x₁ : SapdPrimalSpace n) (hx₁ : x₁ ∈ setup.X)
    (x₂ : SapdPrimalSpace n) (hx₂ : x₂ ∈ setup.X) :
    setup.VX x₂ x₁ ≤ setup.D_X ^ 2 := by
  exact BregmanDiameterBound.apply (V := setup.VX) (X := setup.X) (D := setup.D_X)
    (by simpa [VX] using setup.hVX_bounded) x₁ hx₁ x₂ hx₂

theorem VY_bounded (y₁ : SapdDualSpace m) (hy₁ : y₁ ∈ setup.Y)
    (y₂ : SapdDualSpace m) (hy₂ : y₂ ∈ setup.Y) :
    setup.VY y₂ y₁ ≤ setup.D_Y ^ 2 := by
  exact setup.hVY_bounded y₁ hy₁ y₂ hy₂

/-- The bounded Bregman-domain condition gives a primal squared-diameter
budget. -/
theorem primal_sqdist_le_two_DX_sq
    (x u : SapdPrimalSpace n) (hx : x ∈ setup.X) (hu : u ∈ setup.X) :
    ‖x - u‖ ^ 2 ≤ 2 * setup.D_X ^ 2 := by
  have hlower : (1 / 2 : ℝ) * ‖x - u‖ ^ 2 ≤ setup.VX x u :=
    setup.VX_modulus_one x u hx hu
  have hupper : setup.VX x u ≤ setup.D_X ^ 2 :=
    setup.VX_bounded u hu x hx
  nlinarith

/-- The bounded Bregman-domain condition gives a dual squared-diameter
budget. -/
theorem dual_sqdist_le_two_DY_sq
    (y v : SapdDualSpace m) (hy : y ∈ setup.Y) (hv : v ∈ setup.Y) :
    ‖y - v‖ ^ 2 ≤ 2 * setup.D_Y ^ 2 := by
  exact sq_norm_le_two_radius_sq_of_half_sq_le_bregman_le
    (setup.VY_modulus_one y v hy hv)
    (setup.VY_bounded v hv y hy)

/-- The primal feasible carrier is compact by the paper bounded-Bregman
diameter condition and finite-dimensional closed-ball compactness. -/
theorem X_isCompact : IsCompact setup.X := by
  exact isCompact_of_closed_of_bregman_half_sq_le_bounded_at_base
    setup.X setup.x₁ setup.VX setup.D_X setup.hX_closed
    (fun x hx => by
      simpa [dist_eq_norm] using setup.VX_modulus_one x setup.x₁ hx setup.hx₁_mem)
    (fun x hx => setup.VX_bounded setup.x₁ setup.hx₁_mem x hx)

/-- The dual feasible carrier is compact by the paper bounded-Bregman
diameter condition and finite-dimensional closed-ball compactness. -/
theorem Y_isCompact : IsCompact setup.Y := by
  let R : ℝ := ‖setup.y₁‖ + Real.sqrt (2 * setup.D_Y ^ 2)
  have hY_bound : ∀ y, y ∈ setup.Y → ‖y‖ ≤ R := by
    intro y hy
    have hlower : (1 / 2 : ℝ) * ‖y - setup.y₁‖ ^ 2 ≤ setup.VY y setup.y₁ :=
      setup.VY_modulus_one y setup.y₁ hy setup.hy₁_mem
    have hupper : setup.VY y setup.y₁ ≤ setup.D_Y ^ 2 :=
      setup.VY_bounded setup.y₁ setup.hy₁_mem y hy
    have hsq : ‖y - setup.y₁‖ ^ 2 ≤ 2 * setup.D_Y ^ 2 := by
      nlinarith
    simpa [R] using
      norm_le_norm_base_add_sqrt_of_sq_norm_sub_le y setup.y₁ hsq
  refine (ProperSpace.isCompact_closedBall (0 : SapdDualSpace m) R).of_isClosed_subset
    setup.hY_closed ?_
  intro y hy
  have hyR := hY_bound y hy
  simpa [Metric.mem_closedBall, dist_eq_norm] using hyR

/-- The product feasible carrier `Z = X × Y` is compact. -/
theorem Z_isCompact : IsCompact setup.Z := by
  simpa [Z] using setup.X_isCompact.prod setup.Y_isCompact

