        setup.gamma i *
          (⟪setup.hatfGradient (setup.midpoint i hi stPrev).1,
              stNext.x.1 - z.1.1⟫_ℝ +
            (setup.Lhatf / (2 * setup.beta i)) * ‖stNext.x.1 - stPrev.x.1‖ ^ 2 +
            (setup.hatg stNext.y.1 - setup.hatg z.1.2) +
            ⟪setup.A stNext.x.1, z.1.2⟫_ℝ -
            ⟪setup.A z.1.1, stNext.y.1⟫_ℝ) := by
