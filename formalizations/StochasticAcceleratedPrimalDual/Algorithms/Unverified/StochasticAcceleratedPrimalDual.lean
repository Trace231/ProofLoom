/-- Squared measurability of the deterministic mixed-center gradient mismatch.

This is a derived regularity fact for the actual generated APD process.  It
keeps the smooth bounded-domain supplier below from carrying a raw
measurability premise for the mismatch term. -/
private theorem
    generatedHatfGradientMismatch_sq_aestronglyMeasurable_of_realization_variational_stability
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (T : ℕ)
    (hrealize : setup.GeneratedAxOracleRealization generatedAxSample T)
    (hgrad_meas :
      Measurable (fun x : {x : SapdPrimalSpace n // x ∈ setup.X} =>
        setup.hatfGradient x.1)) :
    ∀ i, ∀ hi : i ∈ Finset.Icc 1 T,
      AEStronglyMeasurable
        (fun ω =>
          ‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i
              (Finset.mem_Icc.mp hi).1 ω).1 -
            setup.hatfGradient
              (setup.midpoint i (Finset.mem_Icc.mp hi).1
                (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1‖ ^ 2)
        setup.P := by
  intro i hi
  have hi_pos : 1 ≤ i := (Finset.mem_Icc.mp hi).1
  have hi_le : i ≤ T := (Finset.mem_Icc.mp hi).2
  have hstate :
      StochasticAcceleratedPrimalDualStateMapMeasurable
        (fun ω => setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω) :=
    setup.generatedAxExtensionProcess_measurable_of_realization_variational_stability
      generatedAxSample T hrealize (i - 1) (le_trans (Nat.sub_le i 1) hi_le)
  have hquery :
      Measurable
        (fun ω => setup.generatedGQueryPoint generatedAxSample i hi_pos ω) :=
    setup.generatedGQueryPoint_measurable_of_state generatedAxSample i hi_pos hstate
  have hgrad_query :
      Measurable
        (fun ω => setup.hatfGradient
          (setup.generatedGQueryPoint generatedAxSample i hi_pos ω).1) :=
    hgrad_meas.comp hquery
  have hmid_amb :
      Measurable
        (fun ω =>
          setup.midpointValue i
            (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)) := by
    have hxBar :
        Measurable
          (fun ω =>
            ((setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).xBar).1) :=
      hstate.2.2.1.subtype_coe
    have hx :
        Measurable
          (fun ω =>
            ((setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).x).1) :=
      hstate.1.subtype_coe
    simpa [midpointValue] using
      (hxBar.const_smul (1 - (setup.beta i)⁻¹)).add
        (hx.const_smul ((setup.beta i)⁻¹))
  have hmid :
      Measurable
        (fun ω =>
          setup.midpoint i hi_pos
            (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)) := by
    simpa [midpoint] using hmid_amb.subtype_mk
  have hgrad_mid :
      Measurable
        (fun ω =>
          setup.hatfGradient
            (setup.midpoint i hi_pos
              (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1) :=
    hgrad_meas.comp hmid
  have hsq :
      Measurable
        (fun ω =>
          ‖setup.hatfGradient (setup.generatedGQueryPoint generatedAxSample i hi_pos ω).1 -
            setup.hatfGradient
              (setup.midpoint i hi_pos
                (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω)).1‖ ^ 2) :=
    (hgrad_query.sub hgrad_mid).norm.pow_const 2
  simpa using hsq.aestronglyMeasurable

