/-- Succ-adaptedness of the realized generated `A_hat_x(\tilde x_t)` extension
process, placed before the Eq. (4.4.73) envelope call site.

The proof is the same source-derived variational-stability route used by the
later generated-process measurability suppliers: the realized sample at stage
`j+1` is prefix-measurable, and the selected prox maps are measurable by the
proved selector-stability bridges. -/
theorem generatedAxExtensionProcess_succ_adapted_of_realization
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (T : ℕ)
    (hrealize : setup.GeneratedAxOracleRealization generatedAxSample T) :
    ∀ j, j ≤ T →
      StochasticAcceleratedPrimalDualStateMapMeasurableAt (n := n) (m := m)
        ((setup.filtration).seq (j + 1))
        (fun ω => setup.generatedAxExtensionProcess generatedAxSample j ω) := by
  exact
    SOptLib.recursiveGeneratedProcess_succ_adapted_of_realization
      (filt := setup.filtration)
      (process := fun j ω => setup.generatedAxExtensionProcess generatedAxSample j ω)
      (sample := generatedAxSample)
      (fresh := setup.ξ)
      (stepProcess := fun i ω =>
        match i with
        | 0 => setup.initialState
        | k + 1 =>
            setup.stepFromGeneratedAx (k + 1) (Nat.succ_pos k)
              (generatedAxSample (k + 1) ω)
              (setup.generatedAxExtensionProcess generatedAxSample k ω) ω)
      (AdaptedAt := fun mΩ state =>
        StochasticAcceleratedPrimalDualStateMapMeasurableAt (n := n) (m := m) mΩ state)
      T
      (by
        intro mΩ mΩ' state hstate hmΩ
        exact hstate.mono hmΩ)
      ⟨measurable_const, measurable_const, measurable_const,
        measurable_const, measurable_const⟩
      (by
        intro k _hk hprev_at
        simpa [Nat.add_assoc] using
          setup.generatedAxSample_measurableAt_succ_of_realization_at
            generatedAxSample T hrealize (k + 1)
            (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)
            hprev_at)
      (by
        intro k s hs
        have hmeas :
            Measurable[(SOptLib.filtration setup.ξ setup.sample_measurable).seq (k + 2)]
              (setup.ξ (k + 1)) := by
          simpa [Nat.add_assoc] using
            SOptLib.measurable_sample_le_prefixFiltration setup.ξ setup.sample_measurable (k + 1)
        exact hmeas hs)
      (by
        intro k _hk hsample hξ hprev_lift
        simpa using
          setup.stepFromGeneratedAx_measurableAt_of_selector_measurable
            (k + 1) (Nat.succ_pos k) (k + 2)
            (setup.DualProxSelectorMeasurableAt_of_variational_stability (k + 1)
              (Nat.succ_pos k))
            (setup.PrimalProxSelectorMeasurableAt_of_compact_continuous_unique (k + 1)
              (Nat.succ_pos k))
            hξ hsample hprev_lift)
      (by
        intro k
        funext ω
        rfl)

