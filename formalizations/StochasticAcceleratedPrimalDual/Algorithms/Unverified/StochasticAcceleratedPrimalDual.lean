      SOptLib.stagedOracleValue, SOptLib.oracleKernel] using
      (setup.horacle_variance_Ay z i hi).2
  have hbase :
      Integrable
          (fun ω => ‖setup.oracleAy (query ω) (setup.ξ i ω) -
              setup.ATranspose (query ω).1‖ ^ 2) setup.P ∧
        ∫ ω, ‖setup.oracleAy (query ω) (setup.ξ i ω) -
              setup.ATranspose (query ω).1‖ ^ 2 ∂setup.P ≤
          setup.sigmaXA ^ 2 := by
    haveI : IsProbabilityMeasure (Measure.map (setup.ξ i) setup.P) :=
      Measure.isProbabilityMeasure_map (setup.hξ_measurable i).aemeasurable
    exact
      randomIterate_variance_bound_of_fixed_variance
        (G := setup.oracleAy)
