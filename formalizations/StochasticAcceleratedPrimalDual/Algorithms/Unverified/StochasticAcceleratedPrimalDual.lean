    ⟨((setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).xBar.1,
        (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).yBar.1),
      ⟨(setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).xBar.2,
        (setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω).yBar.2⟩⟩
  let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
  let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
  let γPrev : ℝ := if _h2 : 2 ≤ i then setup.gamma (i - 1) else 0
  let xLag : SapdPrimalSpace n :=
    stPrev.x.1 - (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1
  have hprop := proposition_4_12_generated_extension_gamma_step
    setup generatedAxSample i hi ω z
  have hpx := generated_primal_prox_gamma_bregman_bound
    setup generatedAxSample i hi ω z
  have hpy := generated_dual_prox_gamma_bregman_bound
