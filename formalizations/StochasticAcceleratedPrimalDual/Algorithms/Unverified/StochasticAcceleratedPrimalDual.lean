/-- Source semantics for the noise pair `Δ_i` in Lemma 4.9.

The `G_hat(x_i)` and `A_hat_y(y_{i+1})` components are tied to the fixed-domain
oracle kernels. The `A_hat_x(\tilde x_i)` component is recorded only as the
source-displayed stochastic call value at each point, not as a reusable
generated stream or as a fixed-domain oracle realization.
-/
private def Algorithm43SourceBoundaryDeltaSemantics
    (delta : ℕ → Ω → SapdPrimalSpace n × SapdDualSpace m) : Prop :=
  SOptLib.twoBlockOracleResidualPairComponentSemantics (fun i => 1 ≤ i) delta
    setup.algorithm43SourceBoundaryState
    (fun st => st.x) (fun st => st.y) (fun st => st.xTilde)
    setup.sampledG
    (fun i hi ω =>
      setup.hatfGradient (setup.midpoint i hi (setup.algorithm43SourceBoundaryState i ω)).1)
    setup.sampledAy
    (fun y => setup.ATranspose y.1)
    setup.algorithm43SourceBoundaryAxTildeCall
    (fun xTilde => setup.A xTilde)

/-- Source-boundary noise pair `Δ_i` used in the Lemma 4.9 boundary obligation.

The object is the displayed formula from Eq. (4.4.60)'s noise decomposition,
computed from the recursive Algorithm 4.3 state and the formal displayed
`\hat A_x(\tilde x_i)` call. It is not selected from an existential and it does
not export a generated fixed-domain oracle realization. -/
private noncomputable def algorithm43SourceBoundaryDelta :
    ℕ → Ω → SapdPrimalSpace n × SapdDualSpace m :=
  fun i ω =>
    if hi : 1 ≤ i then
      (setup.sampledG i (setup.algorithm43SourceBoundaryState i ω).x ω -
          setup.hatfGradient (setup.midpoint i hi (setup.algorithm43SourceBoundaryState i ω)).1 +
        (setup.sampledAy i (setup.algorithm43SourceBoundaryState (i + 1) ω).y ω -
          setup.ATranspose (setup.algorithm43SourceBoundaryState (i + 1) ω).y.1),
        -setup.algorithm43SourceBoundaryAxTildeCall i ω + setup.A (setup.algorithm43SourceBoundaryState i ω).xTilde)
    else 0

/-- Defining source-boundary semantics theorem for the Algorithm 4.3 noise. -/
private theorem algorithm43SourceBoundaryDelta_source_semantics :
    setup.Algorithm43SourceBoundaryDeltaSemantics setup.algorithm43SourceBoundaryDelta := by
  exact
    (SOptLib.twoBlockOracleResidualPairComponentSemantics_def
      (active := fun i => 1 ≤ i)
      (delta := setup.algorithm43SourceBoundaryDelta)
      (state := setup.algorithm43SourceBoundaryState)
      (primalQuery := fun st => st.x)
      (nextDualQuery := fun st => st.y)
      (forwardQuery := fun st => st.xTilde)
      (gradientSample := setup.sampledG)
      (gradientTarget := fun i hi ω =>
        setup.hatfGradient (setup.midpoint i hi (setup.algorithm43SourceBoundaryState i ω)).1)
      (adjointSample := setup.sampledAy)
      (adjointTarget := fun y => setup.ATranspose y.1)
      (forwardSample := setup.algorithm43SourceBoundaryAxTildeCall)
      (forwardTarget := fun xTilde => setup.A xTilde)).2
      (by
        intro i hi ω
        simp [algorithm43SourceBoundaryDelta, hi, SOptLib.twoBlockOracleResidualPair])

/-- Canonical displayed-run extension state for Algorithm 4.3.

The only external input is the paper-displayed value stream occupying the
`\hat A_x(\tilde x_t)` slot in Eq. (4.4.56). No SOptLib match: checked
`SOptLib.recursiveIterateProcess`, `SOptLib.stagedOracleValue`, and
`SOptLib.weightedOutputAverage`; the first is zero-indexed and generic, while
this source-boundary object must keep Lan's paper indexing with initialization
at `t = 1` and the displayed ambient `\tilde x_t` query. This replaces the old
`Algorithm43GeneratedAxExtensionRun` witness bundle: states are now computed by
the APD recurrence rather than supplied with proof fields. It remains
extension-only because the source does not identify the displayed stream with a
fixed-domain SFO value. -/
noncomputable def displayedAxExtensionState
    (axTildeCall : ℕ → Ω → SapdDualSpace m) :
    ℕ → Ω → StochasticAcceleratedPrimalDualState n m setup.X setup.Y :=
  Nat.rec (fun _ => setup.initialState)
    (fun k rec ω =>
      if hk0 : k = 0 then
        setup.initialState
      else
        setup.stepFromGeneratedAx k (Nat.pos_of_ne_zero hk0)
          (axTildeCall k ω) (rec ω) ω)

theorem displayedAxExtensionState_init
    (axTildeCall : ℕ → Ω → SapdDualSpace m) (ω : Ω) :
