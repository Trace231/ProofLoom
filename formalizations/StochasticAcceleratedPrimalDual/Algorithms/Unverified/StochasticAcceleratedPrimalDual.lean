/-- Random-query Assumption 8 bridge for the smooth-gradient oracle
`G_hat(x)`.

This is the smooth-gradient analogue of
`sampledAx_randomQuery_sqDeviation_integrable_and_bound` and
`sampledAy_randomQuery_sqDeviation_integrable_and_bound`. It only controls the
oracle residual centered at the same query, `G_hat(x)-∇hat_f(x)`; SAPD's
`Δ_{x,hat f}` has an additional deterministic gradient-mismatch term handled
separately below. -/
theorem sampledG_randomQuery_sqDeviation_integrable_and_bound
    {query : Ω → {x : SapdPrimalSpace n // x ∈ setup.X}}
    (t : ℕ) (ht : 1 ≤ t)
    (hgrad_meas :
      Measurable (fun x : {x : SapdPrimalSpace n // x ∈ setup.X} =>
        setup.hatfGradient x.1))
    (hquery : Measurable query)
    (hindep : IndepFun query (setup.ξ t) setup.P) :
    Integrable
        (fun ω => ‖setup.sampledG t (query ω) ω - setup.hatfGradient (query ω).1‖ ^ 2)
        setup.P ∧
      ∫ ω, ‖setup.sampledG t (query ω) ω - setup.hatfGradient (query ω).1‖ ^ 2
          ∂setup.P ≤ setup.sigmaXHatf ^ 2 := by
  classical
  haveI : IsProbabilityMeasure setup.P := setup.hP
  have hdev_meas :
      Measurable
        (fun p : {x : SapdPrimalSpace n // x ∈ setup.X} × S =>
          setup.oracleG p.1 p.2 - setup.hatfGradient p.1.1) := by
    have htarget :
        Measurable
          (fun p : {x : SapdPrimalSpace n // x ∈ setup.X} × S =>
            setup.hatfGradient p.1.1) := by
      exact hgrad_meas.comp
        (measurable_fst :
          Measurable (fun p : {x : SapdPrimalSpace n // x ∈ setup.X} × S => p.1))
    exact setup.horacleG_measurable.sub htarget
  have hfixed :
      ∀ z : {x : SapdPrimalSpace n // x ∈ setup.X},
        Integrable
            (fun ω => ‖setup.oracleG z (setup.ξ t ω) - setup.hatfGradient z.1‖ ^ 2)
            setup.P ∧
          ∫ ω, ‖setup.oracleG z (setup.ξ t ω) - setup.hatfGradient z.1‖ ^ 2
              ∂setup.P ≤ setup.sigmaXHatf ^ 2 := by
    intro z
    constructor
    · simpa [sampledG, hatfGradient, SapdOracleVarianceBound, SapdSecondMomentWellDefined,
        SOptLib.stagedOracleValue, SOptLib.oracleKernel] using
        (setup.horacle_variance_G z t ht).1
    · simpa [sampledG, hatfGradient, SapdOracleVarianceBound, SapdSecondMoment,
        SOptLib.stagedOracleValue, SOptLib.oracleKernel] using
        (setup.horacle_variance_G z t ht).2
  have htransfer :=
    oracleRandomIterateVarianceBound_of_fixedVariance
      (P := setup.P)
      (G := setup.oracleG)
      (g := fun x : {x : SapdPrimalSpace n // x ∈ setup.X} => setup.hatfGradient x.1)
      (x := fun _ : ℕ => query)
      (Y := setup.ξ)
      (normDual := fun e : SapdPrimalSpace n => ‖e‖)
      (σ2 := setup.sigmaXHatf ^ 2)
      (t := t)
      (by intro e; rfl)
      hdev_meas
      hquery
      (setup.hξ_measurable t)
      hindep
      (sq_nonneg setup.sigmaXHatf)
      (by
        intro z
        simpa using hfixed z)
  simpa [SOptLib.oracleRandomIterateVarianceBound, sampledG, SOptLib.stagedOracleValue,
    SOptLib.oracleKernel] using htransfer

