                ⟪(setup.delta generatedAxSample i hi ω).2, stNext.y.1 - z.1.2⟫_ℝ)
        else 0) := by
  classical
  let bar : ℕ → {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
