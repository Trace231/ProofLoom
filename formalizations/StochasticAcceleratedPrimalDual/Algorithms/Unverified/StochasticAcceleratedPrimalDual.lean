      (setup.generatedDeltaX_sqDeviation_integrable_and_bound_of_component_bounds
        generatedAxSample i (Finset.mem_Icc.mp hi).1
        (2 * setup.sigmaXHatf ^ 2 + 2 * M i) (setup.sigmaXA ^ 2)
        (hhatf_int i hi) (hhatf_bound i hi)
        (hdeltaXA.2.1 i hi) (hdeltaXA.2.2 i hi)
        (hdeltaX_sq_aesm i hi)).2
  refine ⟨M, hbudget, ?_⟩
  simpa [SX] using
    (GeneratedEq4473SquareNoiseMeanBoundWithPrimalBudget.of_component_moments
      (setup := setup) generatedAxSample t SX hdeltaX_int hdeltaX_bound
      hdeltaY_int hdeltaY_bound)

/-- Generic stage-separated Eq. (4.4.73) square-noise algebra with an explicit
primal square-noise budget.

This is the finite-sum integral consumer for
`generatedEq4471StageSeparatedSquareNoiseU`.  The stochastic content is only in
the per-index bounds supplied to the theorem; the proof is deterministic
integration and positivity algebra. -/
private theorem
    GeneratedEq4473StageSeparatedSquareNoiseMeanBoundWithPrimalBudget.of_component_moments
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (SX : ℕ → ℝ)
    (hdeltaX_int :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 t,
        Integrable
          (fun ω =>
            ‖setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω +
              setup.deltaXAStageSeparated generatedAxSample t i hi ω‖ ^ 2)
          setup.P)
    (hdeltaX_bound :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 t,
        ∫ ω,
            ‖setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω +
              setup.deltaXAStageSeparated generatedAxSample t i hi ω‖ ^ 2
            ∂setup.P ≤ SX i)
    (hdeltaY_int :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 t,
        Integrable
          (fun ω =>
            ‖setup.sapdDeltaY generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2)
          setup.P)
    (hdeltaY_bound :
      ∀ i, ∀ hi : i ∈ Finset.Icc 1 t,
        ∫ ω,
            ‖setup.sapdDeltaY generatedAxSample i (Finset.mem_Icc.mp hi).1 ω‖ ^ 2
            ∂setup.P ≤ setup.sigmaY ^ 2) :
    setup.GeneratedEq4473StageSeparatedSquareNoiseMeanBoundWithPrimalBudget
      generatedAxSample t SX := by
  classical
  have hcx_nonneg :
      ∀ i ∈ Finset.Icc 1 t,
        0 ≤ (2 - setup.q) * setup.eta i * setup.gamma i / (1 - setup.q) := by
    intro i hi_mem
    have hi_pos : 1 ≤ i := (Finset.mem_Icc.mp hi_mem).1
    exact div_nonneg
      (mul_nonneg
        (mul_nonneg (by linarith [setup.hq_mem.2]) (le_of_lt (setup.heta_pos i hi_pos)))
        (le_of_lt (gamma_pos setup i hi_pos)))
      (le_of_lt (sub_pos.mpr setup.hq_mem.2))
  have hcy_nonneg :
      ∀ i ∈ Finset.Icc 1 t,
        0 ≤ (2 - setup.p) * setup.tau i * setup.gamma i / (1 - setup.p) := by
    intro i hi_mem
    have hi_pos : 1 ≤ i := (Finset.mem_Icc.mp hi_mem).1
    exact div_nonneg
      (mul_nonneg
        (mul_nonneg (by linarith [setup.hp_mem.2]) (le_of_lt (setup.htau_pos i hi_pos)))
        (le_of_lt (gamma_pos setup i hi_pos)))
      (le_of_lt (sub_pos.mpr setup.hp_mem.2))
  simpa [GeneratedEq4473StageSeparatedSquareNoiseMeanBoundWithPrimalBudget,
    generatedEq4471StageSeparatedSquareNoiseU] using
    (weighted_two_noise_finset_sq_integrable_and_bound
      (μ := setup.P) (s := Finset.Icc 1 t)
      (xNoise := fun i hi ω =>
        setup.deltaXHatf generatedAxSample i (Finset.mem_Icc.mp hi).1 ω +
          setup.deltaXAStageSeparated generatedAxSample t i hi ω)
      (yNoise := fun i hi ω =>
        setup.sapdDeltaY generatedAxSample i (Finset.mem_Icc.mp hi).1 ω)
      (cx := fun i => (2 - setup.q) * setup.eta i * setup.gamma i / (1 - setup.q))
      (cy := fun i => (2 - setup.p) * setup.tau i * setup.gamma i / (1 - setup.p))
      (SX := SX) (SY := fun _ => setup.sigmaY ^ 2)
      hcx_nonneg hcy_nonneg hdeltaX_int hdeltaX_bound hdeltaY_int hdeltaY_bound)

/-- Eq. (4.4.73) from its two source components: finite-sum square-noise
moments and martingale cancellation. -/
private theorem GeneratedEq4473CanonicalUMeanBound.of_squareNoise_and_martingale
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ)
    (hsq : setup.GeneratedEq4473SquareNoiseMeanBound generatedAxSample t)
    (hmart : GeneratedEq4473MartingaleMeanNonpos (setup := setup) generatedAxSample t) :
    setup.GeneratedEq4473CanonicalUMeanBound generatedAxSample t := by
  exact SOptLib.sapdCanonicalResidualMeanBound
    (μ := setup.P)
    (s := Finset.Icc 1 t)
    (U := fun ω => setup.generatedEq4471U generatedAxSample t ω)
    (squareNoise := fun ω => setup.generatedEq4471SquareNoiseU generatedAxSample t ω)
    (martingale := fun ω => setup.generatedEq4471MartingaleU generatedAxSample t ω)
    (budget := fun i =>
        ((2 - setup.q) * setup.eta i * setup.gamma i / (1 - setup.q)) *
            setup.sigmaX ^ 2 +
          ((2 - setup.p) * setup.tau i * setup.gamma i / (1 - setup.p)) *
            setup.sigmaY ^ 2)
    (setup.generatedEq4471U_eq_squareNoise_add_martingale generatedAxSample t)
    hsq.1 hsq.2 hmart.1 hmart.2

/-- Canonical `U_t` obligations imply the existing Eq. (4.4.72)--(4.4.73)
envelope contract.

The theorem is deliberately just packaging: all substantive source work is now
visible in the pathwise canonical-`U_t` leaf and the Eq. (4.4.73) mean leaf. -/
private theorem GeneratedGapEq4472Envelope.of_canonical_U
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t)
    (hpath : setup.GeneratedGapEq4472PathwiseCanonicalU generatedAxSample t ht)
    (hmean : setup.GeneratedEq4473CanonicalUMeanBound generatedAxSample t) :
    setup.GeneratedGapEq4472Envelope generatedAxSample t ht := by
  exact ⟨setup.generatedEq4471U generatedAxSample t, hmean.1, hmean.2, hpath⟩

/-- The Eq. (4.4.72) pathwise envelope supplies the absolute integrability
envelope used by the generated-output integrability theorem.

The envelope is the scaled random variable obtained from the source's
`Bregman-bound + U_t` right-hand side.  All nontrivial source work is isolated
in `GeneratedGapEq4472Envelope`; this avoids the false stronger claim that
`Q0(t)` dominates the stochastic gap almost surely. -/
theorem GeneratedGapDescentEnvelope.of_eq4472_envelope
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t)
    (hpath : setup.GeneratedGapEq4472Envelope generatedAxSample t ht) :
    setup.GeneratedGapDescentEnvelope generatedAxSample t ht := by
  rcases hpath with ⟨U, hUint, _hUmean, hupper⟩
  let c : ℝ := setup.beta t * setup.gamma t
  let B0 : ℝ :=
    2 * setup.gamma t / setup.eta t * setup.D_X ^ 2 +
      2 * setup.gamma t / setup.tau t * setup.D_Y ^ 2
  haveI : IsProbabilityMeasure setup.P := setup.hP
  have hβpos : 0 < setup.beta t := lt_of_lt_of_le zero_lt_one (beta_ge_one setup t ht)
  have hγpos : 0 < setup.gamma t := gamma_pos setup t ht
  have hcpos : 0 < c := mul_pos hβpos hγpos
  exact
    SOptLib.GapDescentEnvelope.of_scaled_pathwise_upper_bound
      (μ := setup.P)
      (gap := fun ω : Ω =>
        setup.gap (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω))
      (U := U) (c := c) (B0 := B0)
      hUint hcpos
    (by
      filter_upwards with ω
      exact setup.gap_nonneg
        (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω))
      hupper

/-- The corrected explicit-budget Eq. (4.4.72) envelope still supplies the
absolute integrability descent envelope.

This proof is the same scaling argument as
`GeneratedGapDescentEnvelope.of_eq4472_envelope`; it only uses the pathwise
upper bound and integrability of `U_t`, not the particular expectation rate. -/
theorem GeneratedGapDescentEnvelope.of_eq4472_envelope_with_primal_budget
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t)
    (SX : ℕ → ℝ)
    (hpath :
      setup.GeneratedGapEq4472EnvelopeWithPrimalBudget generatedAxSample t ht SX) :
    setup.GeneratedGapDescentEnvelope generatedAxSample t ht := by
  rcases hpath with ⟨U, hUint, _hUmean, hupper⟩
  let c : ℝ := setup.beta t * setup.gamma t
  let B0 : ℝ :=
    2 * setup.gamma t / setup.eta t * setup.D_X ^ 2 +
      2 * setup.gamma t / setup.tau t * setup.D_Y ^ 2
  haveI : IsProbabilityMeasure setup.P := setup.hP
  have hβpos : 0 < setup.beta t := lt_of_lt_of_le zero_lt_one (beta_ge_one setup t ht)
  have hγpos : 0 < setup.gamma t := gamma_pos setup t ht
  have hcpos : 0 < c := mul_pos hβpos hγpos
  have hBint : Integrable (fun ω : Ω => c⁻¹ * (B0 + U ω)) setup.P := by
    have hconst : Integrable (fun _ : Ω => B0) setup.P := integrable_const B0
    simpa [B0] using (hconst.add hUint).const_mul c⁻¹
  exact GeneratedGapDescentEnvelope.of_nonnegative_upper_bound (setup := setup)
    generatedAxSample t ht (fun ω : Ω => c⁻¹ * (B0 + U ω)) hBint
    (by
      filter_upwards [hupper] with ω hle
      have hscaled :
          c⁻¹ *
              (c *
                setup.gap
                  (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω)) ≤
            c⁻¹ * (B0 + U ω) := by
        exact mul_le_mul_of_nonneg_left hle (inv_nonneg.mpr (le_of_lt hcpos))
      have hcne : c ≠ 0 := ne_of_gt hcpos
      calc
        setup.gap (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω) =
            c⁻¹ *
              (c *
                setup.gap
                  (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω)) := by
              rw [← mul_assoc, inv_mul_cancel₀ hcne, one_mul]
      _ ≤ c⁻¹ * (B0 + U ω) := hscaled)

/-- Eq. (4.4.72)--(4.4.73) imply the expected `Q_0(t)` bound for a generated
extension output.

This is the compiled consumer for the `U_t` mean component of
`GeneratedGapEq4472Envelope`.  It keeps the source work in the envelope
construction itself, while the expectation step is only integration,
positivity, and the rate-term algebra from Theorem 4.8(a). -/
theorem expected_gap_le_Q0_of_eq4472_envelope
    (generatedAxSample : ℕ → Ω → SapdDualSpace m) (t : ℕ) (ht : 1 ≤ t)
    (hstream : GeneratedAxStreamMeasurableUpTo generatedAxSample t)
    (hstep : GeneratedAxExtensionOneStepMeasurableUpTo setup generatedAxSample t)
    (hpath : setup.GeneratedGapEq4472Envelope generatedAxSample t ht) :
    ∫ ω, setup.gap (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω) ∂setup.P ≤
      setup.Q0 t := by
  rcases hpath with ⟨U, hUint, hUmean, hupper⟩
  haveI : IsProbabilityMeasure setup.P := setup.hP
  exact
    SOptLib.expected_gap_le_budget_of_scaled_envelope
      (μ := setup.P)
      (gap := setup.gap)
      (out := fun ω => setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω)
      (U := U)
      (beta := setup.beta)
      (gamma := setup.gamma)
      (eta := setup.eta)
      (tau := setup.tau)
      (D_X := setup.D_X)
      (D_Y := setup.D_Y)
      (sigmaX := setup.sigmaX)
      (sigmaY := setup.sigmaY)
      (p := setup.p)
      (q := setup.q)
      (t := t)
      (lt_of_lt_of_le zero_lt_one (beta_ge_one setup t ht))
      (gamma_pos setup t ht)
      (setup.heta_pos t ht)
      (setup.htau_pos t ht)
      (by
        have hmeas :
            Measurable
