/-- Raw finite-window generated Eq. (4.4.61) after beta-gamma output
telescoping, before Bregman/coupling/Young normalization.

Chosen alignment with Lan Lemma 4.9 step 2: this consumes the pointwise
`generated_eq_4461_one_step_bound` through `generated_eq_4461_sum_one_step_bound`
and the beta-gamma recurrence through `generated_q_bar_telescope`.  It is not
the final Lemma 4.9 bound: the right-hand side deliberately remains the raw
summed Eq. (4.4.61) expression so the subsequent `B_t`, coupling, and
`Λ_i(z)` absorption steps are still visible. -/
private theorem generated_eq_4461_terminal_le_sum_raw
    (generatedAxSample : ℕ → Ω → SapdDualSpace m)
    (t : ℕ) (ht : 1 ≤ t) (ω : Ω)
    (z : {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z}) :
    setup.beta t * setup.gamma t *
        setup.Q (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω) z ≤
      Finset.sum (Finset.Icc 1 t) (fun i =>
        if hi : 1 ≤ i then
          let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
          let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
          setup.gamma i / setup.eta i *
              (setup.VX z.1.1 stPrev.x.1 - setup.VX z.1.1 stNext.x.1) +
            setup.gamma i / setup.tau i *
              (setup.VY z.1.2 stPrev.y.1 - setup.VY z.1.2 stNext.y.1) +
            setup.gamma i *
              ⟪setup.A (stNext.x.1 - stPrev.x.1), z.1.2 - stNext.y.1⟫_ℝ -
            (if h2 : 2 ≤ i then
              setup.gamma (i - 1) *
                ⟪setup.A
                    (stPrev.x.1 -
                      (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1),
                  z.1.2 - stPrev.y.1⟫_ℝ
            else 0) -
            (if h2 : 2 ≤ i then
              setup.gamma (i - 1) *
                ⟪setup.A
                    (stPrev.x.1 -
                      (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1),
                  stPrev.y.1 - stNext.y.1⟫_ℝ
            else 0) -
            setup.gamma i *
              (1 / (2 * setup.eta i) - setup.Lhatf / (2 * setup.beta i)) *
                ‖stNext.x.1 - stPrev.x.1‖ ^ 2 -
            setup.gamma i / (2 * setup.tau i) *
              ‖stNext.y.1 - stPrev.y.1‖ ^ 2 -
            setup.gamma i *
              (⟪(setup.delta generatedAxSample i hi ω).1, stNext.x.1 - z.1.1⟫_ℝ +
                ⟪(setup.delta generatedAxSample i hi ω).2, stNext.y.1 - z.1.2⟫_ℝ)
        else 0) := by
  classical
  let bar : ℕ → {z : SapdPrimalSpace n × SapdDualSpace m // z ∈ setup.Z} :=
    fun k =>
      ⟨((setup.generatedAxExtensionProcess generatedAxSample k ω).xBar.1,
          (setup.generatedAxExtensionProcess generatedAxSample k ω).yBar.1),
        ⟨(setup.generatedAxExtensionProcess generatedAxSample k ω).xBar.2,
          (setup.generatedAxExtensionProcess generatedAxSample k ω).yBar.2⟩⟩
  let left : ℕ → ℝ := fun i =>
    setup.beta i * setup.gamma i * setup.Q (bar i) z -
      (setup.beta i - 1) * setup.gamma i * setup.Q (bar (i - 1)) z
  let raw : ℕ → ℝ := fun i =>
    if hi : 1 ≤ i then
      let stPrev := setup.generatedAxExtensionProcess generatedAxSample (i - 1) ω
      let stNext := setup.generatedAxExtensionProcess generatedAxSample i ω
      setup.gamma i / setup.eta i *
          (setup.VX z.1.1 stPrev.x.1 - setup.VX z.1.1 stNext.x.1) +
        setup.gamma i / setup.tau i *
          (setup.VY z.1.2 stPrev.y.1 - setup.VY z.1.2 stNext.y.1) +
        setup.gamma i *
          ⟪setup.A (stNext.x.1 - stPrev.x.1), z.1.2 - stNext.y.1⟫_ℝ -
        (if h2 : 2 ≤ i then
          setup.gamma (i - 1) *
            ⟪setup.A
                (stPrev.x.1 -
                  (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1),
              z.1.2 - stPrev.y.1⟫_ℝ
        else 0) -
        (if h2 : 2 ≤ i then
          setup.gamma (i - 1) *
            ⟪setup.A
                (stPrev.x.1 -
                  (setup.generatedAxExtensionProcess generatedAxSample (i - 2) ω).x.1),
              stPrev.y.1 - stNext.y.1⟫_ℝ
        else 0) -
        setup.gamma i *
          (1 / (2 * setup.eta i) - setup.Lhatf / (2 * setup.beta i)) *
            ‖stNext.x.1 - stPrev.x.1‖ ^ 2 -
        setup.gamma i / (2 * setup.tau i) *
          ‖stNext.y.1 - stPrev.y.1‖ ^ 2 -
        setup.gamma i *
          (⟪(setup.delta generatedAxSample i hi ω).1, stNext.x.1 - z.1.1⟫_ℝ +
            ⟪(setup.delta generatedAxSample i hi ω).2, stNext.y.1 - z.1.2⟫_ℝ)
    else 0
  have hsum := generated_eq_4461_sum_one_step_bound
    setup generatedAxSample t ht ω z
  have htel := generated_q_bar_telescope setup generatedAxSample t ht ω z
  exact
    terminal_le_sum_of_guarded_sum_le_and_sum_eq
      left raw
      (setup.beta t * setup.gamma t *
        setup.Q (setup.generatedExtensionFeasibleOutput generatedAxSample t ht ω) z)
      t
      (by simpa [left, raw, bar] using hsum)
      (by simpa [left, bar] using htel)

/-- The raw Bregman part of the summed Eq. (4.4.61) is exactly the generated
