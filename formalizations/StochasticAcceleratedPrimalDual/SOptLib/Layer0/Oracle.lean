theorem finset_importance_weighted_diff_mean_eq_uniform_mean
    {K ι E : Type*} [Field K] [AddCommGroup E] [Module K E]
    (s : Finset ι) (q : ι → K) (n : K) (a b : ι → E)
    (hq_ne : ∀ i ∈ s, q i ≠ 0) (hn_ne : n ≠ 0) :
    Finset.sum s
        (fun i : ι => q i • (((q i * n)⁻¹) • (a i - b i))) =
      n⁻¹ • Finset.sum s a -
        n⁻¹ • Finset.sum s b := by
  classical
  have hterm :
      ∀ i ∈ s,
        q i • (((q i * n)⁻¹) • (a i - b i)) =
          n⁻¹ • (a i - b i) := by
    intro i hi
    calc
      q i • (((q i * n)⁻¹) • (a i - b i))
          = (q i * (q i * n)⁻¹) • (a i - b i) := by
              rw [smul_smul]
      _ = n⁻¹ • (a i - b i) := by
              have hscalar : q i * (q i * n)⁻¹ = n⁻¹ := by
                field_simp [hq_ne i hi, hn_ne]
              rw [hscalar]
  calc
    Finset.sum s
        (fun i : ι => q i • (((q i * n)⁻¹) • (a i - b i)))
        =
      Finset.sum s (fun i : ι => n⁻¹ • (a i - b i)) := by
        exact Finset.sum_congr rfl (fun i hi => hterm i hi)
    _ = n⁻¹ • Finset.sum s (fun i : ι => a i - b i) := by
        rw [Finset.smul_sum]
    _ = n⁻¹ • Finset.sum s a -
        n⁻¹ • Finset.sum s b := by
        rw [Finset.sum_sub_distrib, smul_sub]

