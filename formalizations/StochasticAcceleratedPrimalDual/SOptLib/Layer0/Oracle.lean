      ∀ i, ∀ hi : i ∈ I,
        Integrable (fun ω => ‖v i hi ω‖ ^ 2) μ ∧
          ∫ ω, ‖v i hi ω‖ ^ 2 ∂μ ≤ sigma2)
    (hsum_aesm :
      ∀ i, ∀ hi : i ∈ I,
        AEStronglyMeasurable (fun ω => ‖u i hi ω + v i hi ω‖ ^ 2) μ) :
    ∃ M : ι → ℝ,
      budget M ∧
        ∀ i, ∀ hi : i ∈ I,
          Integrable (fun ω => ‖u i hi ω + v i hi ω‖ ^ 2) μ ∧
            ∫ ω, ‖u i hi ω + v i hi ω‖ ^ 2 ∂μ ≤
              2 * (2 * sigma1 + 2 * M i) + 2 * sigma2 := by
  rcases hfirst with ⟨M, hbudget, hfirst_bound⟩
  refine ⟨M, hbudget, ?_⟩
  intro i hi
  exact
    integrable_sq_norm_add_and_integral_le_two_mul_add
      (μ := μ) (u i hi) (v i hi) (2 * sigma1 + 2 * M i) sigma2
      (hfirst_bound i hi).1 (hfirst_bound i hi).2
      (hsecond i hi).1 (hsecond i hi).2 (hsum_aesm i hi)
