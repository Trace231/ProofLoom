    simpa [v, z] using maxLinearModel_bound_at
  have herr : -⟪G - grad x, v⟫_ℝ ≤ ‖G - grad x‖ * D := by
    have h_abs : -⟪G - grad x, v⟫_ℝ ≤ |⟪G - grad x, v⟫_ℝ| :=
      neg_le_abs _
    have h_cauchy :
