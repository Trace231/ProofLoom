    {Ω S Z E : Type*} [MeasurableSpace Ω] [MeasurableSpace S] [MeasurableSpace Z]
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (P : Measure Ω) (ν : Measure S) [IsFiniteMeasure P] [SFinite ν]
    (sample : Ω → S) (x y : Ω → Z) (d : Ω → E)
    (G : Z → S → E) (target : Z → E)
    (hG_meas : Measurable (fun p : Z × S => G p.1 p.2))
    (hquery : Measurable (fun ω : Ω => ((x ω, y ω), d ω)))
    (hsample : Measurable sample)
    (hindep : IndepFun (fun ω : Ω => ((x ω, y ω), d ω)) sample P)
    (hdist : Measure.map sample P = ν)
    (horacle_int :
      Integrable
        (fun ω =>
          ⟪d ω, G (x ω) (sample ω) - G (y ω) (sample ω)⟫_ℝ) P)
    (htarget_aesm :
      AEStronglyMeasurable
        (fun q : (Z × Z) × E => ⟪q.2, target q.1.1 - target q.1.2⟫_ℝ)
        (P.map (fun ω : Ω => ((x ω, y ω), d ω))))
    (htarget_int :
