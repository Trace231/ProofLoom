    wolfeGap grad maximizer x = ⟪grad x, v⟫_ℝ := by
      simp [wolfeGap, z, v]
    _ = ⟪G, v⟫_ℝ - ⟪G - grad x, v⟫_ℝ := by
      rw [sub_eq_add_neg, inner_sub_left]
      ring
