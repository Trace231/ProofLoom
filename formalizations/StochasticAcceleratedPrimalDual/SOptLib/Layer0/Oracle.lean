  refine measurable_countable_dispatch
    (idx := fun p : X × (S × ι) => p.2.2)
    (f := fun i p =>
      ⟪weight i •
          PiLp.single 2 i ((PiLp.proj (𝕜 := ℝ) 2 (fun i : ι => Block i) i) (grad p.1 p.2.1)) -
          mean p.1,
