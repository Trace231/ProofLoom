theorem bregman_lower_bound_of_strongConvexOn_hasGradientAt
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {X : Set E} {v : E → ℝ} {grad : E → E} {m : ℝ} {a b : E}
    (hstrong : StrongConvexOn X m v)
    (hgrad : HasGradientAt v (grad a) a)
    (ha : a ∈ X) (hb : b ∈ X) :
    (m / 2 : ℝ) * ‖a - b‖ ^ 2 ≤ carrierBregmanFormula v id grad a b := by
  let φ : E → ℝ := fun y => v y - (m / 2 : ℝ) * ‖y‖ ^ 2
  let line : ℝ → E := fun t => AffineMap.lineMap a b t
  have hφconv : ConvexOn ℝ X φ := by
    have hsc : StrongConvexOn X m v := hstrong
    rw [strongConvexOn_iff_convex] at hsc
    simpa [φ] using hsc
  have hline_mem : Set.Icc (0 : ℝ) 1 ⊆ line ⁻¹' X := by
    intro t ht
    have ht0 : 0 ≤ t := ht.1
    have ht1 : t ≤ 1 := ht.2
    have h1t : 0 ≤ 1 - t := sub_nonneg.mpr ht1
