      (fun t : ℝ => (v (line t) - v xp) - t * ⟪grad x, d⟫_ℝ) t := by
    intro t ht
    have htI : t ∈ Set.Icc (0 : ℝ) 1 := by simpa [s] using ht
    have hseg_sub : AffineMap.lineMap xp u t - xp = t • d := by
      simp [d, AffineMap.lineMap_apply_module']
    have hinner_diff :
        ⟪grad x, AffineMap.lineMap xp u t - x⟫_ℝ -
            ⟪grad x, xp - x⟫_ℝ =
          t * ⟪grad x, d⟫_ℝ := by
      calc
        ⟪grad x, AffineMap.lineMap xp u t - x⟫_ℝ -
            ⟪grad x, xp - x⟫_ℝ =
            ⟪grad x, (AffineMap.lineMap xp u t - x) - (xp - x)⟫_ℝ := by
          rw [← inner_sub_right]
        _ = ⟪grad x, AffineMap.lineMap xp u t - xp⟫_ℝ := by
          congr 1
          abel
        _ = ⟪grad x, t • d⟫_ℝ := by
          rw [hseg_sub]
        _ = t * ⟪grad x, d⟫_ℝ := by
          simp [inner_smul_right]
    calc
      β t =
          carrierBregmanFormula v id grad x (AffineMap.lineMap xp u t) -
            carrierBregmanFormula v id grad x xp := by
        simp only [β]
        rw [dif_pos htI]
      _ = (v (line t) - v xp) - t * ⟪grad x, d⟫_ℝ := by
        unfold carrierBregmanFormula
        rw [← hinner_diff]
        simp [line]
        ring
  have hβ : HasDerivWithinAt β
      (⟪grad xp, d⟫_ℝ - ⟪grad x, d⟫_ℝ) s 0 := by
    exact hderiv_expr.congr heq (heq 0 (by norm_num [s]))
  have hval : ⟪grad xp, d⟫_ℝ - ⟪grad x, d⟫_ℝ =
      ⟪grad xp - grad x, d⟫_ℝ := by
    rw [inner_sub_left]
  simpa [d, s, β, hval] using hβ

