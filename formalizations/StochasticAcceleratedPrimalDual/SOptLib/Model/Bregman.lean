  change SOptLib.carrierBregmanDivergence v grad z u =
    ν u.1 - (ν z.1 + ⟪gradientWithin ν X z.1, u.1 - z.1⟫_ℝ)
  rw [carrierBregmanDivergence_eq_of_gradient_pairing
    (v := v) (grad := grad)
    (grad' := fun y : {x : E // x ∈ X} => gradientWithin ν X y.1)
    (z := z) (x := u) hgrad]
