  Machine Learning, stochastic accelerated primal-dual -/
theorem apply {P : Type*} {V : P → P → ℝ} {X : Set P} {D : ℝ}
    (h : bregmanDiameterBound V X D) (x1 : P) (hx1 : x1 ∈ X)
    (x2 : P) (hx2 : x2 ∈ X) :
