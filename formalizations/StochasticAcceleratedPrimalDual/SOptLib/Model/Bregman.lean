Origin algorithm: Lan, First-order and Stochastic Optimization Methods for
  Machine Learning, stochastic block mirror descent -/
theorem weightedBlockBregmanPotential_nonneg
    {ι : Type*} {E : Type*} [Fintype ι]
    (B : ι → Type*) (p : ι → ℝ) (coord : ∀ i, E → B i)
    (V : ∀ i, B i → B i → ℝ) (z x : E)
    (hp_pos : ∀ i, 0 < p i)
    (hV_nonneg : ∀ i, 0 ≤ V i (coord i z) (coord i x)) :
    0 ≤ weightedBlockBregmanPotential B p coord V z x := by
  classical
  unfold weightedBlockBregmanPotential
  exact Finset.sum_nonneg fun i _ =>
    mul_nonneg (inv_nonneg.mpr (le_of_lt (hp_pos i))) (hV_nonneg i)

