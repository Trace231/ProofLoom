    (hdiam : ∀ z, z ∈ X → ∀ x, x ∈ X → V x z ≤ D ^ 2) :
    IsCompact X := by
  refine (ProperSpace.isCompact_closedBall x0 (Real.sqrt (2 * D ^ 2))).of_isClosed_subset
    hX_closed ?_
