/-- Natural filtration generated by the prefix of a measurable sample stream.

Layer: Model | Concept: Filtration
Proof: (definitional construction; sample-prefix-generated filtration on a stochastic stream)
Source: Mathlib filtration and generated sigma-algebra primitives
Used in: stochastic mirror descent sample filtration
Book citation: book/FOML/StochasticMirrorDescent.json#/algorithm_spec
Origin algorithm: Lan stochastic mirror descent -/
noncomputable def filtration
    {Ω S : Type*} [MeasurableSpace Ω] [MeasurableSpace S]
    (ξ : ℕ → Ω → S)
    (hξ_measurable : ∀ n, Measurable (ξ n)) :
    Filtration ℕ (by infer_instance : MeasurableSpace Ω) where
  seq t := ⨆ j < t, MeasurableSpace.comap (ξ j)
    (by infer_instance : MeasurableSpace S)
  mono' _ _ hij := iSup₂_mono' fun j hj => ⟨j, lt_of_lt_of_le hj hij, le_rfl⟩
  le' t := iSup₂_le fun j _ => (hξ_measurable j).comap_le

/-- Defining equation for the sample-prefix filtration.

Layer: Model | Gap: Level 0 (generated filtration field equation)
Proof: projection reduction
Source: Mathlib filtration and generated sigma-algebra primitives
Used in: stochastic mirror descent sample filtration
Book citation: book/FOML/StochasticMirrorDescent.json#/algorithm_spec
Origin algorithm: Lan stochastic mirror descent -/
@[simp]
theorem filtration_seq
    {Ω S : Type*} [MeasurableSpace Ω] [MeasurableSpace S]
    (ξ : ℕ → Ω → S)
    (hξ_measurable : ∀ n, Measurable (ξ n)) (t : ℕ) :
    (filtration ξ hξ_measurable).seq t =
      ⨆ j < t, MeasurableSpace.comap (ξ j)
        (by infer_instance : MeasurableSpace S) := by
  rfl

/-- A sample coordinate is measurable with respect to the generated prefix filtration
as soon as that prefix contains the coordinate.

Layer: Model | Gap: Level 0 (sample measurability in generated prefix filtration)
Proof: rewrite measurability as a `comap`-subspace inequality and include the
  coordinate generator into the finite prefix `iSup` using `le_iSup_of_le`.
Source: Mathlib measure-theory measurable-space comap and complete-lattice APIs
Used in: stochastic mirror descent proof that the sampled noise at step `s` is
  measurable with respect to the prefix filtration generated by past samples
Book citation: book/FOML/StochasticMirrorDescent.json#/algorithm_spec
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for Machine Learning, stochastic mirror descent -/
theorem measurable_sample_le_prefixFiltration
    {Ω S : Type*} [MeasurableSpace Ω] [MeasurableSpace S]
    (ξ : ℕ → Ω → S)
    (hξ : ∀ n, Measurable (ξ n))
    (n : ℕ) :
    Measurable[(SOptLib.filtration ξ hξ).seq (n + 1)] (ξ n) := by
  refine Measurable.of_comap_le ?_
  change
    MeasurableSpace.comap (ξ n) (by infer_instance : MeasurableSpace S) ≤
      ⨆ j < n + 1,
        MeasurableSpace.comap (ξ j) (by infer_instance : MeasurableSpace S)
  exact le_iSup_of_le n
    (le_iSup_of_le (Nat.lt_succ_self n) le_rfl)

/-- Finite block of all mini-batch sample coordinates before a strict time cutoff.

For a batch-size schedule, a run identifier, and a paper time `k`, this is the
finite set of triples `(run, t, r)` with `1 ≤ t ≤ k - 1` and
`1 ≤ r ≤ batchSize t`.

Layer: Model | Concept: Filtration
Proof: (definitional construction; finite bi-union of mini-batch coordinate intervals)
Source: Mathlib finite sets, interval finsets, and image/bi-union APIs
Used in: nonconvex stochastic mirror descent strict-past sample filtration for iterate measurability
Book citation: book/FOML/NonconvexStochasticMirrorDescent.json#/algorithm_spec
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for Machine Learning, nonconvex stochastic mirror descent -/
noncomputable def strictPastMiniBatchSampleBlock
    (batchSize : ℕ → ℕ) (run : ℕ) (k : ℕ) : Finset (ℕ × ℕ × ℕ) :=
  (Finset.Icc 1 (k - 1)).biUnion
    (fun t => (Finset.Icc 1 (batchSize t)).image (fun r => (run, t, r)))

/-- Membership in the strict-past mini-batch block is exactly the coordinate bounds.

The finite block contains precisely the samples from the selected run whose
paper time is between `1` and `k - 1`, and whose mini-batch coordinate is within
the batch size at that time.

Layer: Model | Gap: Level 0 (strict-past mini-batch block membership)
Proof: unfold the finite block, split `biUnion` and `image` membership, and
  repackage the interval bounds on the time and mini-batch coordinate.
Source: Mathlib finite sets, interval membership, and product-coordinate APIs
Used in: nonconvex stochastic mirror descent strict-past sample filtration for iterate measurability
Book citation: book/FOML/NonconvexStochasticMirrorDescent.json#/algorithm_spec
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for Machine Learning, nonconvex stochastic mirror descent -/
@[simp]
theorem mem_strictPastMiniBatchSampleBlock
    (batchSize : ℕ → ℕ) (run : ℕ) (k : ℕ) (q : ℕ × ℕ × ℕ) :
    q ∈ strictPastMiniBatchSampleBlock batchSize run k ↔
      q.1 = run ∧ 1 ≤ q.2.1 ∧ q.2.1 ≤ k - 1 ∧
        1 ≤ q.2.2 ∧ q.2.2 ≤ batchSize q.2.1 := by
  classical
  unfold strictPastMiniBatchSampleBlock
  constructor
  · intro hq
    rcases Finset.mem_biUnion.mp hq with ⟨t, ht, hqt⟩
    rcases Finset.mem_image.mp hqt with ⟨r, hr, rfl⟩
    simp only [Finset.mem_Icc] at ht hr
    exact ⟨rfl, ht.1, ht.2, hr.1, hr.2⟩
  · rintro ⟨hq₁, hqt₁, hqt₂, hqr₁, hqr₂⟩
    apply Finset.mem_biUnion.mpr
    refine ⟨q.2.1, ?_, ?_⟩
    · exact Finset.mem_Icc.mpr ⟨hqt₁, hqt₂⟩
    · apply Finset.mem_image.mpr
      refine ⟨q.2.2, Finset.mem_Icc.mpr ⟨hqr₁, hqr₂⟩, ?_⟩
      cases q
      simp_all

