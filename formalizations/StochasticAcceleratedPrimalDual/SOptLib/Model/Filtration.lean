/-- A measurable function of a finite shifted sample prefix is measurable for
the corresponding generated prefix filtration.

For a measurable sample stream `xi`, any offset, and any finite horizon `t`, the
map sending `omega` to the vector of samples `xi (j + offset) omega` for
`j : Fin t` is measurable with respect to the natural prefix filtration of the
shifted stream. Hence every measurable postprocessing of that vector is
prefix-measurable.

Layer: Model | Gap: Level 1 (finite shifted sample-prefix measurability)
Proof: each coordinate is one of the generators of the shifted prefix
  filtration; the finite product sigma-algebra is then controlled by the
  coordinate comap bounds, and measurable composition closes the result.
Source: Mathlib measure-theory measurable-space comap, finite product
  measurable-space, and SOptLib generated sample-prefix filtration APIs
Used in: stochastic accelerated primal-dual martingale-noise measurability from
  finite sample-prefix representations
Book citation: book/FOML/StochasticAcceleratedPrimalDual.json#/algorithm_spec
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for
  Machine Learning, stochastic accelerated primal-dual -/
theorem measurable_borel_finPrefix_shiftedPrefixFiltration
    {Ω S α : Type*} [MeasurableSpace Ω] [MeasurableSpace S] [MeasurableSpace α]
    (xi : ℕ → Ω → S) (hxi : ∀ t, Measurable (xi t))
    (offset t : ℕ) (phi : (Fin t → S) → α) (hphi : Measurable phi) :
    Measurable[(SOptLib.filtration (fun j ω => xi (j + offset) ω)
        (fun j => hxi (j + offset))).seq t]
      (fun ω => phi (fun j : Fin t => xi (j.1 + offset) ω)) := by
  let shifted : ℕ → Ω → S := fun j ω => xi (j + offset) ω
  have hshifted : ∀ j, Measurable (shifted j) := fun j => hxi (j + offset)
  have hprefix :
      @Measurable Ω (Fin t → S)
        ((SOptLib.filtration shifted hshifted).seq t) (by infer_instance)
        (fun ω => fun j : Fin t => shifted j.1 ω) := by
    refine measurable_iff_comap_le.mpr ?_
    rw [MeasurableSpace.pi, MeasurableSpace.comap_iSup]
    refine iSup_le ?_
    intro j
    have hcoord :
        Measurable[(SOptLib.filtration shifted hshifted).seq t]
          (fun ω => shifted j.1 ω) := by
      exact SOptLib.measurable_sample_of_lt_prefixFiltration shifted hshifted j.2
    simpa [Function.comp_def] using hcoord.comap_le
  simpa [shifted] using hphi.comp hprefix

