    simp [R]
  have hγ_nonneg : 0 ≤ γ.1 := le_of_lt γ.2
  have hγ_inv_nonneg : 0 ≤ (γ.1)⁻¹ := inv_nonneg.mpr hγ_nonneg
  have hp_nonneg : 0 ≤ pnorm := by
    exact apply_nonneg p (u - z)
  have hdist_lt : ρ < ‖u - z‖ := by
    have hnot : ¬ dist u z ≤ ρ := by
      simpa [Metric.mem_closedBall] using huBall
    have hlt : ρ < dist u z := lt_of_not_ge hnot
    simpa [dist_eq_norm, norm_sub_rev] using hlt
  have hnorm_le' : ‖u - z‖ ≤ C * pnorm := by
    simpa [pnorm] using hnorm_le (u - z)
  have hCmul_lt : C * R < C * pnorm := by
    have hρ_gt : C * R < ρ := by
      dsimp [ρ]
      linarith
    exact lt_of_lt_of_le (lt_trans hρ_gt hdist_lt) hnorm_le'
  have hR_le_p : R ≤ pnorm := by
    by_cases hCpos : 0 < C
    · nlinarith [hCmul_lt]
    · have hCzero : C = 0 := le_antisymm (le_of_not_gt hCpos) hC_nonneg
      exfalso
      have hnorm_le_zero : ‖u - z‖ ≤ 0 := by
        simpa [hCzero] using hnorm_le'
      have hρ_eq : ρ = 1 := by
        simp [ρ, hCzero]
      linarith
  have htwoγD_le_p : 2 * γ.1 * D ≤ pnorm := by
    exact le_trans (le_max_right 0 (2 * γ.1 * D)) hR_le_p
