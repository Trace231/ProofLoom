    have hp_mul : 2 * γ.1 * D * pnorm ≤ pnorm * pnorm := by
      exact mul_le_mul htwoγD_le_p le_rfl hp_nonneg
        (by positivity)
    have hγpos : 0 < γ.1 := γ.2
    have hscaled : γ.1 * (D * pnorm) ≤ (1 / 2 : ℝ) * pnorm ^ 2 := by
      nlinarith [hp_mul]
    rw [← div_eq_inv_mul]
    exact (le_div_iff₀ hγpos).mpr (by
      simpa [mul_assoc, mul_left_comm, mul_comm] using hscaled)
  have hquad_le_V :
      (γ.1)⁻¹ * ((1 / 2 : ℝ) * pnorm ^ 2) ≤ (γ.1)⁻¹ * V u :=
    mul_le_mul_of_nonneg_left (hV_lower u huX) hγ_inv_nonneg
