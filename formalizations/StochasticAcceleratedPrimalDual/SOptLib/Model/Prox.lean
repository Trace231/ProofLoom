theorem proxStep_state_oracle_distance_bound
    {P E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (prox : (x : P) → E → (γ : ℝ) → 0 < γ → P) (eval grad : P → E) (h : P → ℝ)
    (hvi :
      ∀ (x u : P) (g : E) (γ : ℝ) (hγ : 0 < γ),
        0 ≤
          ⟪g, eval u - eval (prox x g γ hγ)⟫_ℝ +
            γ⁻¹ * ⟪grad (prox x g γ hγ) - grad x,
              eval u - eval (prox x g γ hγ)⟫_ℝ +
            (h u - h (prox x g γ hγ)))
    (hstrong :
      ∀ y z : P,
        ‖eval y - eval z‖ ^ 2 ≤
          ⟪eval y - eval z, grad y - grad z⟫_ℝ)
    (x₁ x₂ : P) (g₁ g₂ : E) (γ : ℝ) (hγ : 0 < γ) :
    ‖eval (prox x₁ g₁ γ hγ) - eval (prox x₂ g₂ γ hγ)‖ ≤
      γ * ‖g₁ - g₂‖ + ‖grad x₁ - grad x₂‖ := by
  let xp₁ := prox x₁ g₁ γ hγ
  let xp₂ := prox x₂ g₂ γ hγ
  let δ : E := eval xp₁ - eval xp₂
  let C : ℝ := ⟪δ, grad xp₁ - grad xp₂⟫_ℝ
  let B : ℝ := ⟪grad x₁ - grad x₂, δ⟫_ℝ
  have hvi₁ := hvi x₁ xp₂ g₁ γ hγ
  have hvi₂ := hvi x₂ xp₁ g₂ γ hγ
  have hsum :
      0 ≤
        (⟪g₁, eval xp₂ - eval xp₁⟫_ℝ +
            γ⁻¹ * ⟪grad xp₁ - grad x₁, eval xp₂ - eval xp₁⟫_ℝ +
            (h xp₂ - h xp₁)) +
          (⟪g₂, eval xp₁ - eval xp₂⟫_ℝ +
            γ⁻¹ * ⟪grad xp₂ - grad x₂, eval xp₁ - eval xp₂⟫_ℝ +
            (h xp₁ - h xp₂)) := by
    dsimp [xp₁, xp₂] at hvi₁ hvi₂
    exact add_nonneg hvi₁ hvi₂
  have hcombine :
      (⟪g₁, eval xp₂ - eval xp₁⟫_ℝ +
            γ⁻¹ * ⟪grad xp₁ - grad x₁, eval xp₂ - eval xp₁⟫_ℝ +
            (h xp₂ - h xp₁)) +
          (⟪g₂, eval xp₁ - eval xp₂⟫_ℝ +
            γ⁻¹ * ⟪grad xp₂ - grad x₂, eval xp₁ - eval xp₂⟫_ℝ +
            (h xp₁ - h xp₂)) =
        ⟪g₂ - g₁, δ⟫_ℝ - γ⁻¹ * C + γ⁻¹ * B := by
    dsimp [δ, C, B]
    simp only [sub_eq_add_neg, inner_add_left, inner_add_right, inner_neg_left,
      inner_neg_right, real_inner_comm]
    ring
  have hsum' : 0 ≤ ⟪g₂ - g₁, δ⟫_ℝ - γ⁻¹ * C + γ⁻¹ * B := by
    rwa [hcombine] at hsum
  have hstrong' : ‖δ‖ ^ 2 ≤ C := by
    dsimp [δ, C]
    exact hstrong xp₁ xp₂
  have hγinv_nonneg : 0 ≤ γ⁻¹ := inv_nonneg.mpr (le_of_lt hγ)
  have hquad :
      γ⁻¹ * ‖δ‖ ^ 2 ≤
        ‖g₁ - g₂‖ * ‖δ‖ + γ⁻¹ * ‖grad x₁ - grad x₂‖ * ‖δ‖ := by
    have hmain :
        γ⁻¹ * ‖δ‖ ^ 2 ≤
          ⟪g₂ - g₁, δ⟫_ℝ + γ⁻¹ * B := by
      nlinarith
    have hg :
        ⟪g₂ - g₁, δ⟫_ℝ ≤ ‖g₁ - g₂‖ * ‖δ‖ := by
      calc
        ⟪g₂ - g₁, δ⟫_ℝ ≤ |⟪g₂ - g₁, δ⟫_ℝ| := le_abs_self _
        _ ≤ ‖g₂ - g₁‖ * ‖δ‖ := abs_real_inner_le_norm (g₂ - g₁) δ
        _ = ‖g₁ - g₂‖ * ‖δ‖ := by rw [norm_sub_rev]
    have hB :
        γ⁻¹ * B ≤ γ⁻¹ * ‖grad x₁ - grad x₂‖ * ‖δ‖ := by
      have hB_le :
          B ≤ ‖grad x₁ - grad x₂‖ * ‖δ‖ := by
        calc
          B ≤ |B| := le_abs_self _
          _ ≤ ‖grad x₁ - grad x₂‖ * ‖δ‖ := by
            simpa [B] using abs_real_inner_le_norm (grad x₁ - grad x₂) δ
      nlinarith
    nlinarith
  by_cases hδ : ‖δ‖ = 0
  · have hzero : ‖δ‖ ≤ γ * ‖g₁ - g₂‖ + ‖grad x₁ - grad x₂‖ := by
      rw [hδ]
      positivity
    simpa [δ] using hzero
  · have hδpos : 0 < ‖δ‖ := lt_of_le_of_ne (norm_nonneg δ) (Ne.symm hδ)
    have hquad' :
        γ⁻¹ * ‖δ‖ * ‖δ‖ ≤
          (‖g₁ - g₂‖ + γ⁻¹ * ‖grad x₁ - grad x₂‖) * ‖δ‖ := by
      nlinarith [hquad]
    have hdiv :
        γ⁻¹ * ‖δ‖ ≤
          ‖g₁ - g₂‖ + γ⁻¹ * ‖grad x₁ - grad x₂‖ :=
      le_of_mul_le_mul_right hquad' hδpos
    have hγ_nonneg : 0 ≤ γ := le_of_lt hγ
    have hscaled :
        γ * (γ⁻¹ * ‖δ‖) ≤
          γ * (‖g₁ - g₂‖ + γ⁻¹ * ‖grad x₁ - grad x₂‖) :=
      mul_le_mul_of_nonneg_left hdiv hγ_nonneg
    have hleft : γ * (γ⁻¹ * ‖δ‖) = ‖δ‖ := by
      field_simp [hγ.ne']
    have hright :
        γ * (‖g₁ - g₂‖ + γ⁻¹ * ‖grad x₁ - grad x₂‖) =
          γ * ‖g₁ - g₂‖ + ‖grad x₁ - grad x₂‖ := by
      field_simp [hγ.ne']
    simpa [δ, hleft, hright] using hscaled

/-- A fixed-stepsize prox selector is jointly continuous from a state-oracle distance bound.

If the prox selector is controlled by `γ` times oracle distance plus the
distance between gradients at the two states, then continuity of the gradient
map upgrades the bound to joint continuity in the state and oracle arguments.

Layer: Model | Gap: Level 1 (prox-step joint continuity from state-oracle stability)
Proof: use the metric epsilon-delta criterion. Split `ε` in half, use
  continuity of `grad` for the state contribution, and use the positive
  fixed stepsize bound to control the oracle contribution.
Source: Mathlib metric-space continuity and ordered-field algebra APIs
Used in: nonconvex stochastic mirror descent fixed-stepsize prox selector continuity
Book citation: book/FOML/StochasticMirrorDescent.json#/algorithm_spec
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for
  Machine Learning, randomized stochastic mirror descent -/
theorem continuous_proxStep_of_state_oracle_bound
    {P E : Type*} [PseudoMetricSpace P] [NormedAddCommGroup E]
    (prox : P → E → P) (grad : P → E) (γ : ℝ) (hγ : 0 < γ)
    (hgrad : Continuous grad)
    (hbound :
      ∀ (x₁ x₂ : P) (g₁ g₂ : E),
        dist (prox x₁ g₁) (prox x₂ g₂) ≤
          γ * dist g₁ g₂ + dist (grad x₁) (grad x₂)) :
    Continuous (fun p : P × E => prox p.1 p.2) := by
  refine continuous_iff_continuousAt.2 ?_
  intro p₀
  rw [Metric.continuousAt_iff]
  intro ε hε
  have hε2 : 0 < ε / 2 := half_pos hε
  rcases Metric.continuousAt_iff.1 (hgrad.continuousAt (x := p₀.1)) (ε / 2) hε2 with
    ⟨δν, hδν_pos, hδν⟩
  let δ : ℝ := min (ε / (2 * max γ 1)) δν
  have hmax_pos : 0 < max γ 1 :=
    lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1) (le_max_right γ 1)
  have hδ_pos : 0 < δ := by
    exact lt_min (div_pos hε (mul_pos (by norm_num) hmax_pos)) hδν_pos
  refine ⟨δ, hδ_pos, ?_⟩
  intro p hp
  rw [Prod.dist_eq] at hp
  have hp_fst_delta : dist p.1 p₀.1 < δ := (max_lt_iff.mp hp).1
  have hp_snd_delta : dist p.2 p₀.2 < δ := (max_lt_iff.mp hp).2
  have hp_fst : dist p.1 p₀.1 < δν := by
    have hle : δ ≤ δν := min_le_right _ _
    exact lt_of_lt_of_le hp_fst_delta hle
  have hp_snd : dist p.2 p₀.2 < ε / (2 * max γ 1) := by
    have hle : δ ≤ ε / (2 * max γ 1) := min_le_left _ _
    exact lt_of_lt_of_le hp_snd_delta hle
  have hνdist :
      dist (grad p.1) (grad p₀.1) < ε / 2 :=
    hδν hp_fst
  have hdist_bound :
      dist (prox p.1 p.2) (prox p₀.1 p₀.2) ≤
        γ * dist p.2 p₀.2 + dist (grad p.1) (grad p₀.1) :=
    hbound p.1 p₀.1 p.2 p₀.2
  have hγ_le_max : γ ≤ max γ 1 := le_max_left γ 1
  have hgsmall : γ * dist p.2 p₀.2 < ε / 2 := by
    calc
      γ * dist p.2 p₀.2 ≤ max γ 1 * dist p.2 p₀.2 :=
        mul_le_mul_of_nonneg_right hγ_le_max dist_nonneg
      _ < max γ 1 * (ε / (2 * max γ 1)) :=
        mul_lt_mul_of_pos_left hp_snd hmax_pos
      _ = ε / 2 := by
        field_simp [(ne_of_gt hmax_pos)]
  exact lt_of_le_of_lt hdist_bound (by linarith)

