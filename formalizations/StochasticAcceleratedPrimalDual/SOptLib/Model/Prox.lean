  Machine Learning, stochastic block mirror descent -/
theorem inverseStepsizeMirrorProx_zero_eq_self
    {E P : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (V : P → P → ℝ) (eval : P → E)
    (exists_min :
      ∀ (x : P) (g : E) (γ : {γ : ℝ // 0 < γ}),
        ∃ u : P,
          IsMinOn (SOptLib.proxObjective V (fun _ : P => 0) eval x g γ.1)
            Set.univ u)
    (p : Seminorm ℝ E) (hp : p.IsSeparating) (heval : Function.Injective eval)
    (x : P) (γ : {γ : ℝ // 0 < γ})
    (hV_self : V x x = 0)
    (hV_lower : ∀ u : P, (1 / 2 : ℝ) * p (eval u - eval x) ^ 2 ≤ V x u) :
    inverseStepsizeMirrorProx V eval exists_min x (0 : E) γ = x := by
  classical
  let y : P := inverseStepsizeMirrorProx V eval exists_min x (0 : E) γ
  have hx_obj :
      SOptLib.proxObjective V (fun _ : P => 0) eval x (0 : E) γ.1 x = 0 := by
    simp [SOptLib.proxObjective, hV_self]
  have hy_obj_nonneg :
      0 ≤ SOptLib.proxObjective V (fun _ : P => 0) eval x (0 : E) γ.1 y := by
    have hquad_nonneg : 0 ≤ (1 / 2 : ℝ) * p (eval y - eval x) ^ 2 := by
      nlinarith [sq_nonneg (p (eval y - eval x))]
    have hV_nonneg : 0 ≤ V x y := le_trans hquad_nonneg (hV_lower y)
    have hinv_nonneg : 0 ≤ γ.1⁻¹ := inv_nonneg.mpr (le_of_lt γ.2)
    simpa [SOptLib.proxObjective, y] using mul_nonneg hinv_nonneg hV_nonneg
  have hy_le_x :
      SOptLib.proxObjective V (fun _ : P => 0) eval x (0 : E) γ.1 y ≤
        SOptLib.proxObjective V (fun _ : P => 0) eval x (0 : E) γ.1 x := by
    have hmin :=
      inverseStepsizeMirrorProx_isMinOn V eval exists_min x (0 : E) γ
    simpa [y] using (isMinOn_univ_iff.mp hmin x)
  have hy_obj_zero :
      SOptLib.proxObjective V (fun _ : P => 0) eval x (0 : E) γ.1 y = 0 := by
    exact le_antisymm (by simpa [hx_obj] using hy_le_x) hy_obj_nonneg
  have hV_zero : V x y = 0 := by
    have hobj_eq :
        SOptLib.proxObjective V (fun _ : P => 0) eval x (0 : E) γ.1 y =
          γ.1⁻¹ * V x y := by
      simp [SOptLib.proxObjective]
    have hmul_zero : γ.1⁻¹ * V x y = 0 := by
      simpa [hobj_eq] using hy_obj_zero
    exact (mul_eq_zero.mp hmul_zero).resolve_left (inv_ne_zero γ.2.ne')
  have hlower := hV_lower y
  rw [hV_zero] at hlower
  have hp_zero : p (eval y - eval x) = 0 := by
    have hp_nonneg : 0 ≤ p (eval y - eval x) :=
      apply_nonneg p (eval y - eval x)
    nlinarith [sq_nonneg (p (eval y - eval x))]
  have heval_sub : eval y - eval x = 0 := (hp (eval y - eval x)).mp hp_zero
  have heval_eq : eval y = eval x := sub_eq_zero.mp heval_sub
  exact heval heval_eq

/-- A fixed-stepsize prox selector is continuous from a continuous dual-gauge
state-oracle bound.

The displacement estimate may use a dual norm or any continuous gauge on the
oracle space, provided the gauge vanishes at zero. Continuity of the gradient
map then makes the dual-gradient envelope vanish at the base state-oracle pair.

Layer: Model | Gap: Level 1 (prox-step continuity from dual-gauge stability)
Proof: build the continuous envelope supplied by the displacement bound, show
  it is zero at the base point using the gauge-zero hypothesis, and use metric
  neighborhoods to make the envelope smaller than the target radius.
Source: Mathlib metric-space continuity, product topology, and normed additive
  group subtraction APIs
Used in: stochastic block mirror descent selected-block prox-step continuity
Book citation: book/FOML/StochasticBlockMirrorDescent.json#/algorithm_spec/steps/2
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for
  Machine Learning, stochastic block mirror descent -/
theorem prox_continuous_state_oracle_of_dual_gradient_bound
    {P E : Type*} [PseudoMetricSpace P] [NormedAddCommGroup E]
    (prox : P → E → P) (grad : P → E) (dualGauge : E → ℝ)
    (γ C : ℝ)
    (hdual_cont : Continuous dualGauge)
    (hdual_zero : dualGauge 0 = 0)
    (hgrad : Continuous grad)
    (hbound :
      ∀ (x₁ x₂ : P) (g₁ g₂ : E),
        dist (prox x₁ g₁) (prox x₂ g₂) ≤
          C * (γ * dualGauge (g₁ - g₂) + dualGauge (grad x₁ - grad x₂))) :
    Continuous (fun p : P × E => prox p.1 p.2) := by
  refine continuous_iff_continuousAt.2 ?_
  intro p₀
  rw [Metric.continuousAt_iff]
  intro ε hε
  let envelope : P × E → ℝ := fun p =>
    C * (γ * dualGauge (p.2 - p₀.2) + dualGauge (grad p.1 - grad p₀.1))
  have henvelope_cont : Continuous envelope := by
    have hg :
        Continuous (fun p : P × E => dualGauge (p.2 - p₀.2)) :=
      hdual_cont.comp (continuous_snd.sub continuous_const)
    have hstate :
        Continuous (fun p : P × E => dualGauge (grad p.1 - grad p₀.1)) :=
      hdual_cont.comp ((hgrad.comp continuous_fst).sub continuous_const)
    exact continuous_const.mul ((continuous_const.mul hg).add hstate)
  have henvelope_zero : envelope p₀ = 0 := by
    dsimp [envelope]
    rw [sub_self, hdual_zero, sub_self, hdual_zero]
    ring
  have hevent :
      ∀ᶠ p in nhds p₀, envelope p < (fun _ => ε) p := by
    exact henvelope_cont.continuousAt.eventually_lt continuousAt_const
      (by simpa [henvelope_zero] using hε)
  rcases Metric.mem_nhds_iff.mp hevent with ⟨δ, hδpos, hδ⟩
  refine ⟨δ, hδpos, ?_⟩
  intro p hp
  have henv_lt : envelope p < ε := hδ hp
  calc
    dist (prox p.1 p.2) (prox p₀.1 p₀.2)
        ≤ envelope p := by
          simpa [envelope] using hbound p.1 p₀.1 p.2 p₀.2
    _ < ε := henv_lt

