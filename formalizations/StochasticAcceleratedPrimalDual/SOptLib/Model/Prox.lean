    calc
      γ * dist (oracle q) (oracle q₀) ≤
          max γ 1 * dist (oracle q) (oracle q₀) :=
        mul_le_mul_of_nonneg_right hγ_le_max dist_nonneg
      _ < max γ 1 * (ε / (2 * max γ 1)) :=
        mul_lt_mul_of_pos_left hq_oracle hmax_pos
      _ = ε / 2 := by
        field_simp [(ne_of_gt hmax_pos)]
  exact lt_of_le_of_lt hdist_bound (by linarith)

/-- A compact continuous primal two-oracle prox objective has a minimizer.

For a compact feasible carrier `X`, a Bregman-like kernel continuous on
`X × X`, and two sampled linear oracle vectors `g` and `ay`, the named
objective `SOptLib.primalTwoOracleProxObjective` attains its minimum over the
feasible subtype.

Layer: Model | Gap: Level 1 (compact two-oracle prox argmin existence)
Proof: build continuity of the two linear inner-product terms and the
  fixed-base kernel section, lower it to lower-semicontinuity, then apply
  Mathlib's compact lower-semicontinuous minimum theorem.
Source: Mathlib compact extrema, lower-semicontinuity, and real inner-product
  continuity APIs
Used in: stochastic accelerated primal-dual sampled primal prox subproblem
  existence before canonical argmin selection
Book citation: book/FOML/StochasticAcceleratedPrimalDual.json#/algorithm_spec
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for
  Machine Learning, stochastic accelerated primal-dual method -/
theorem primalTwoOracleProxObjective_exists_of_compact_continuous
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (X : Set E) (V : E → E → ℝ)
    (hX_nonempty : X.Nonempty) (hX_compact : IsCompact X)
    (hV_cont : ContinuousOn (fun p : E × E => V p.1 p.2) (X ×ˢ X))
    (eta : ℝ) (g ay : E) (xPrev : {x : E // x ∈ X}) :
    ∃ x : {x : E // x ∈ X},
      ∀ v : {v : E // v ∈ X},
        SOptLib.primalTwoOracleProxObjective
            (fun x : {x : E // x ∈ X} => x.1) V eta g ay xPrev x ≤
          SOptLib.primalTwoOracleProxObjective
            (fun x : {x : E // x ∈ X} => x.1) V eta g ay xPrev v := by
  let F : E → ℝ := fun x =>
    ⟪g, x⟫_ℝ + ⟪x, ay⟫_ℝ + eta⁻¹ * V x xPrev.1
  have hV_section : ContinuousOn (fun x : E => V x xPrev.1) X := by
    have hpair : Continuous (fun x : E => (x, xPrev.1)) := by
      fun_prop
    have hmaps : Set.MapsTo (fun x : E => (x, xPrev.1)) X (X ×ˢ X) := by
      intro x hx
      exact ⟨hx, xPrev.2⟩
    simpa [Function.comp_def] using hV_cont.comp hpair.continuousOn hmaps
  have hfirst_cont : ContinuousOn (fun x : E => ⟪g, x⟫_ℝ) X := by
    exact (continuous_const.inner continuous_id).continuousOn
  have hsecond_cont : ContinuousOn (fun x : E => ⟪x, ay⟫_ℝ) X := by
    exact (continuous_id.inner continuous_const).continuousOn
  have hscaled_cont : ContinuousOn (fun x : E => eta⁻¹ * V x xPrev.1) X := by
    exact hV_section.const_mul eta⁻¹
  have hF_lsc : LowerSemicontinuousOn F X := by
    have hF_cont : ContinuousOn F X := by
      have hsum := (hfirst_cont.add hsecond_cont).add hscaled_cont
      simpa [F, add_assoc] using hsum
    exact hF_cont.lowerSemicontinuousOn
  obtain ⟨x, hx, hmin⟩ :=
    LowerSemicontinuousOn.exists_isMinOn hX_nonempty hX_compact hF_lsc
  refine ⟨⟨x, hx⟩, ?_⟩
  intro v
  have hmin_v := hmin v.2
  simpa [F, SOptLib.primalTwoOracleProxObjective, add_assoc] using hmin_v

