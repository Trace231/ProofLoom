/-- A compact two-block linear plus Bregman-section objective has a minimizer.

For a compact nonempty feasible set `Z` in a product Hilbert space, two fixed
linear residual vectors, and two Bregman-like sections continuous along `Z`,
the objective
`z ↦ -η ⟪dₓ, z.1⟫ - τ ⟪dᵧ, z.2⟫ + VxSection z.1 + VySection z.2`
attains its minimum on the feasible subtype.

Layer: Model | Gap: Level 1 (two-block compact prox argmin existence)
Proof: compose the continuous inner-product projections and supplied Bregman
  sections, lower the resulting continuous objective to lower-semicontinuity,
  then apply Mathlib's compact lower-semicontinuous minimum theorem.
Source: Mathlib compact extrema, lower-semicontinuity, product topology, and
  real inner-product continuity APIs
Used in: stochastic accelerated primal-dual auxiliary product prox subproblem
  existence before canonical argmin selection
Book citation: book/FOML/StochasticAcceleratedPrimalDual.json#/algorithm_spec
Origin algorithm: Lan, First-order and Stochastic Optimization Methods for
  Machine Learning, stochastic accelerated primal-dual method -/
theorem exists_minOn_twoBlock_linear_bregman_objective_compact
    {E F : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F]
    (Z : Set (E × F)) (hZ_nonempty : Z.Nonempty) (hZ_compact : IsCompact Z)
    (VxSection : E → ℝ) (VySection : F → ℝ)
    (dx : E) (dy : F) (eta tau : ℝ)
    (hVX_cont_Z : ContinuousOn (fun z : E × F => VxSection z.1) Z)
    (hVY_cont_Z : ContinuousOn (fun z : E × F => VySection z.2) Z) :
    ∃ z : {z : E × F // z ∈ Z},
      ∀ v : {z : E × F // z ∈ Z},
        (-eta * ⟪dx, z.1.1⟫_ℝ - tau * ⟪dy, z.1.2⟫_ℝ) +
            (VxSection z.1.1 + VySection z.1.2) ≤
          (-eta * ⟪dx, v.1.1⟫_ℝ - tau * ⟪dy, v.1.2⟫_ℝ) +
            (VxSection v.1.1 + VySection v.1.2) := by
  let Fobj : E × F → ℝ := fun z =>
    (-eta * ⟪dx, z.1⟫_ℝ - tau * ⟪dy, z.2⟫_ℝ) +
      (VxSection z.1 + VySection z.2)
  have hinnerX_cont : ContinuousOn
      (fun z : E × F => ⟪dx, z.1⟫_ℝ) Z := by
    exact (continuous_const.inner continuous_fst).continuousOn
  have hinnerY_cont : ContinuousOn
      (fun z : E × F => ⟪dy, z.2⟫_ℝ) Z := by
    exact (continuous_const.inner continuous_snd).continuousOn
  have htermX_cont : ContinuousOn
      (fun z : E × F => -eta * ⟪dx, z.1⟫_ℝ) Z := by
    exact hinnerX_cont.const_mul (-eta)
  have htermY_cont : ContinuousOn
      (fun z : E × F => tau * ⟪dy, z.2⟫_ℝ) Z := by
    exact hinnerY_cont.const_mul tau
  have hBreg_cont : ContinuousOn
      (fun z : E × F => VxSection z.1 + VySection z.2) Z := by
    exact hVX_cont_Z.add hVY_cont_Z
  have hF_cont : ContinuousOn Fobj Z := by
    have hsum := (htermX_cont.sub htermY_cont).add hBreg_cont
    simpa [Fobj] using hsum
  obtain ⟨z, hz, hmin⟩ :=
    LowerSemicontinuousOn.exists_isMinOn hZ_nonempty hZ_compact
      hF_cont.lowerSemicontinuousOn
  refine ⟨⟨z, hz⟩, ?_⟩
  intro v
  have hmin_v := hmin v.2
  simpa [Fobj] using hmin_v

