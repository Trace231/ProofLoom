/-- Intrinsic-interior formula when the abstract carrier gradient agrees directionally
with Mathlib's `gradientWithin` selector.
Layer: Model | Gap: Level 1 (intrinsic-interior formula bridge)
Proof: Rewrite the carrier potential and directional gradient terms.
Source: Lan, First-order and Stochastic Optimization Methods for Machine Learning,
  Eq. (3.2.2).
Used in: `MirrorDescentSetup.V_eq_formula_of_intrinsicInterior`
Book citation: `book/FOML/StochasticMirrorDescent.json#/assumptions/5/math`
Origin algorithm: FOML stochastic mirror descent -/
theorem carrierBregmanDivergence_eq_intrinsic_formula
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {X : Set E} {v : {x : E // x ∈ X} → ℝ} {vInterior : E → ℝ}
    {grad : {x : E // x ∈ X} → E} {x z : {x : E // x ∈ X}}
    (hvx : v x = vInterior x.1) (hvz : v z = vInterior z.1)
    (hgrad :
      ⟪grad x, z.1 - x.1⟫_ℝ =
        ⟪gradientWithin vInterior (intrinsicInterior ℝ X) x.1, z.1 - x.1⟫_ℝ) :
    carrierBregmanDivergence v grad x z =
      vInterior z.1 - vInterior x.1 -
        ⟪gradientWithin vInterior (intrinsicInterior ℝ X) x.1, z.1 - x.1⟫_ℝ := by
  simp [carrierBregmanDivergence, hvx, hvz, hgrad]

/-- Strong convexity on the intrinsic interior gives the carrier Bregman lower bound.
Layer: Model | Gap: Level 2 (relative-interior Bregman lower bound)
Proof: Delegate to the ambient intrinsic-interior lower-bound theorem and rewrite the
  carrier realization.
Source: Lan, First-order and Stochastic Optimization Methods for Machine Learning,
  Proposition 3.1 / Bregman divergence lower bound.
Used in: `MirrorDescentSetup.V_lower_bound_of_intrinsicInterior_core`
Book citation: `book/FOML/StochasticMirrorDescent.json#/assumptions/5/math`
Origin algorithm: FOML stochastic mirror descent -/
theorem carrierBregmanDivergence_lower_bound_of_strongConvexOn_intrinsicInterior
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {X : Set E} {v : {x : E // x ∈ X} → ℝ} {vInterior : E → ℝ}
    {grad : {x : E // x ∈ X} → E} {x z : {x : E // x ∈ X}}
