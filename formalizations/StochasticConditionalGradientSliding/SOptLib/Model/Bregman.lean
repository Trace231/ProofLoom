noncomputable def carrierBregmanDivergence
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {X : Set E} (v : {x : E // x ∈ X} → ℝ)
    (grad : {x : E // x ∈ X} → E) (x z : {x : E // x ∈ X}) : ℝ :=
  v z - v x - ⟪grad x, z.1 - x.1⟫_ℝ

