def IsDistanceGeneratingFunctionOn
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (X : Set E) (nu : E → ℝ) (grad : E → E) : Prop :=
  ContinuousOn grad X ∧
  (∀ x, x ∈ X → HasGradientAt nu (grad x) x) ∧
  (∀ x, x ∈ X → ∀ z, z ∈ X →
    (1 / 2 : ℝ) * ‖x - z‖ ^ 2 ≤ carrierBregmanFormula nu id grad x z)

