  stochastic accelerated gradient descent -/
theorem bregman_segment_difference_hasDerivWithinAt_zero
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (v : E → ℝ) (grad : E → E) {x xp u : E}
    (hgrad_xp : HasGradientAt v (grad xp) xp) :
    let d : E := u - xp
    let β : ℝ → ℝ := fun t =>
      if _ht : t ∈ Set.Icc (0 : ℝ) 1 then
        carrierBregmanFormula v id grad x (AffineMap.lineMap xp u t) -
          carrierBregmanFormula v id grad x xp
      else 0
    HasDerivWithinAt β
      ⟪grad xp - grad x, d⟫_ℝ
      (Set.Icc (0 : ℝ) 1) 0 := by
  classical
  let d : E := u - xp
  let s : Set ℝ := Set.Icc (0 : ℝ) 1
  let line : ℝ → E := fun t => AffineMap.lineMap xp u t
  let β : ℝ → ℝ := fun t =>
    if _ht : t ∈ Set.Icc (0 : ℝ) 1 then
      carrierBregmanFormula v id grad x (AffineMap.lineMap xp u t) -
        carrierBregmanFormula v id grad x xp
    else 0
  have hline_deriv : HasDerivWithinAt line d s 0 := by
    simpa [line, d] using
      (AffineMap.hasDerivWithinAt_lineMap (a := xp) (b := u)
        (s := s) (x := (0 : ℝ)))
  have hvseg : HasDerivWithinAt (fun t => v (line t))
      ⟪grad xp, d⟫_ℝ s 0 := by
    have hcomp :=
      hgrad_xp.hasFDerivAt.comp_hasDerivWithinAt_of_eq
        (x := (0 : ℝ)) hline_deriv (by simp [line])
    simpa [Function.comp_def, line, d, InnerProductSpace.toDual_apply_apply] using hcomp
  have hlin : HasDerivWithinAt (fun t : ℝ => t * ⟪grad x, d⟫_ℝ)
      ⟪grad x, d⟫_ℝ s 0 := by
    simpa using (hasDerivWithinAt_id (x := (0 : ℝ)) (s := s)).mul_const
      ⟪grad x, d⟫_ℝ
  have hderiv_expr : HasDerivWithinAt
      (fun t : ℝ => (v (line t) - v xp) - t * ⟪grad x, d⟫_ℝ)
      (⟪grad xp, d⟫_ℝ - ⟪grad x, d⟫_ℝ) s 0 := by
    exact (hvseg.sub_const (v xp)).sub hlin
  have heq : ∀ t ∈ s, β t =
      (fun t : ℝ => (v (line t) - v xp) - t * ⟪grad x, d⟫_ℝ) t := by
    intro t ht
    have htI : t ∈ Set.Icc (0 : ℝ) 1 := by simpa [s] using ht
    have hseg_sub : AffineMap.lineMap xp u t - xp = t • d := by
      simp [d, AffineMap.lineMap_apply_module']
    have hinner_diff :
        ⟪grad x, AffineMap.lineMap xp u t - x⟫_ℝ -
            ⟪grad x, xp - x⟫_ℝ =
          t * ⟪grad x, d⟫_ℝ := by
      calc
        ⟪grad x, AffineMap.lineMap xp u t - x⟫_ℝ -
            ⟪grad x, xp - x⟫_ℝ =
            ⟪grad x, (AffineMap.lineMap xp u t - x) - (xp - x)⟫_ℝ := by
          rw [← inner_sub_right]
        _ = ⟪grad x, AffineMap.lineMap xp u t - xp⟫_ℝ := by
          congr 1
          abel
        _ = ⟪grad x, t • d⟫_ℝ := by
          rw [hseg_sub]
        _ = t * ⟪grad x, d⟫_ℝ := by
          simp [inner_smul_right]
    calc
      β t =
          carrierBregmanFormula v id grad x (AffineMap.lineMap xp u t) -
            carrierBregmanFormula v id grad x xp := by
        simp only [β]
        rw [dif_pos htI]
      _ = (v (line t) - v xp) - t * ⟪grad x, d⟫_ℝ := by
        unfold carrierBregmanFormula
        rw [← hinner_diff]
        simp [line]
        ring
  have hβ : HasDerivWithinAt β
      (⟪grad xp, d⟫_ℝ - ⟪grad x, d⟫_ℝ) s 0 := by
    exact hderiv_expr.congr heq (heq 0 (by norm_num [s]))
  have hval : ⟪grad xp, d⟫_ℝ - ⟪grad x, d⟫_ℝ =
      ⟪grad xp - grad x, d⟫_ℝ := by
    rw [inner_sub_left]
  simpa [d, s, β, hval] using hβ

