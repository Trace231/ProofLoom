theorem proxObjective_exists_isMinOn_compact
    {P E : Type*} [TopologicalSpace P] [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {V : P → P → ℝ} {eval : P → E}
    (hcompact : IsCompact (Set.univ : Set P))
    (heval : Continuous eval) (x : P)
    (hVx : Continuous (fun u : P => V x u)) (g : E) (γ : ℝ) :
