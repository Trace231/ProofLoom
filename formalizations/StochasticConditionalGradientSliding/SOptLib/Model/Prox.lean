      continuous_const.mul hVx
    have hzero : Continuous (fun _ : P => (0 : ℝ)) :=
      continuous_const
    simpa [SOptLib.proxObjective] using (hinner.add hprox).add hzero
  rcases hcompact.exists_isMinOn
      (⟨x, trivial⟩ : (Set.univ : Set P).Nonempty)
      hobjective.continuousOn with
    ⟨y, _hy, hymin⟩
  exact ⟨y, hymin⟩

