theorem positiveStepsizeMirrorProxBlock_isMinOn_unscaled
    {P E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (V : P → P → ℝ) (eval : P → E) (raw : P → E → ℝ → P)
    (hraw : ∀ (x : P) (g : E) (γ : ℝ) (y : P),
      SOptLib.paperMirrorObjective V eval x g γ (raw x g γ) ≤
        SOptLib.paperMirrorObjective V eval x g γ y)
    (x : P) (g : E) (γ : ℝ) (hγ : 0 < γ) :
    IsMinOn (SOptLib.proxObjective V (fun _ : P => 0) eval x g γ) Set.univ
      (positiveStepsizeMirrorProxBlock raw x g γ hγ) := by
  rw [isMinOn_univ_iff]
  intro y
  have hpaper :
      SOptLib.paperMirrorObjective V eval x g γ (raw x g γ) ≤
        SOptLib.paperMirrorObjective V eval x g γ y :=
    hraw x g γ y
  have hscaled :
      γ⁻¹ * (γ * ⟪g, eval (raw x g γ)⟫_ℝ + V x (raw x g γ)) ≤
        γ⁻¹ * (γ * ⟪g, eval y⟫_ℝ + V x y) := by
    refine mul_le_mul_of_nonneg_left ?_ (le_of_lt (inv_pos.mpr hγ))
    simpa [SOptLib.paperMirrorObjective] using hpaper
  have hne : γ ≠ 0 := ne_of_gt hγ
  simpa [positiveStepsizeMirrorProxBlock, SOptLib.proxObjective,
    SOptLib.paperMirrorObjective, mul_add, mul_assoc, hne] using hscaled

