    (law : SGSProbabilityModel (Ω := Ω) S)
    (queryFP : Ω → FeasiblePoint S)
    (k : PositiveTime) (i : ℕ)
    (hpast_le :
      sgsStrictPastSampleSpace (Ω := Ω) law.sample k i ≤
        (by infer_instance : MeasurableSpace Ω))
    (hquery_meas : Measurable queryFP)
