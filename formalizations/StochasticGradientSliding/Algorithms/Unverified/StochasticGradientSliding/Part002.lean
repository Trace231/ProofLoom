theorem theorem82DenominatorAdmissible_reverse_noHbetaInterface_beta_zero_impossible
    (beta gamma Gamma : PositiveTime → ℝ) (T : PositiveTime → InnerBudget)
    (hlower : outerLowerBoundCondition S beta gamma)
    (hGamma : outerWeightCondition gamma Gamma)
    (hmono : reverseMonotonicityCondition beta gamma Gamma (innerBudgetNat T)) :
    ¬ ∃ k : PositiveTime, beta k = 0 := by
  let hdenom := reverseMonotonicityCondition_denominators beta gamma Gamma
    (innerBudgetNat T) hmono
  let q : PositiveTime → ℝ := fun k =>
    checkedQuotient (gamma k * beta k)
      (Gamma k * (1 - psWeightProduct spsP (innerBudgetNat T k)))
      (hdenom k)
  have hq_one_pos : 0 < q oneTime := by
    have hbeta1_pos : 0 < beta oneTime := by
      have hlow := hlower.2 oneTime
      rw [hlower.1] at hlow
      nlinarith [S.L_pos, hlow]
    have hgap :
        0 < 1 - psWeightProduct spsP (innerBudgetNat T oneTime) :=
      one_sub_psWeightProduct_spsP_pos_of_pos (T oneTime).2
    have hden_pos :
        0 < Gamma oneTime *
          (1 - psWeightProduct spsP (innerBudgetNat T oneTime)) := by
      rw [hGamma.1]
      exact mul_pos zero_lt_one hgap
