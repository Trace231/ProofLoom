/-- Convexity of the feasible-domain `Φ` used by the formula-extension SPS bridge.

Aligns with Lan Proposition 8.3 proof step "use convexity of `Φ`", but at the
`spsPhiFormulaOnX` boundary required by Eq. (8.1.69).  Candidate audit:
considered source helper `spsPhi_sourceDomain_convexOn_totalized` and SOptLib
`convexOn_weighted_average_le_weighted_sum`; the former requires a
`ProxCorePoint`, while the latter consumes convexity and does not prove the
paper-specific `g + h + βV + χ` model convex. -/
theorem spsPhiFormulaOnX_convexOn_totalized
    (g : E → ℝ) (hg : IsAffineModel g) (x : FeasiblePoint S) {β : ℝ}
    (hβ : 0 ≤ β) :
    ConvexOn ℝ S.X
      (SOptLib.carrierTotalizeOn S.X
        (fun z : FeasiblePoint S => spsPhiFormulaOnX S g x β z)) := by
  classical
  rcases hg with ⟨c, a, hgdef⟩
  have hVconv := bregmanFormulaOnX_right_convexOn_totalized S x
  refine ⟨S.convex_X, ?_⟩
  intro y hy z hz α η hα hη hsum
  have hseg : α • y + η • z ∈ S.X :=
    S.convex_X hy hz hα hη hsum
  have hglinear :
      g (α • y + η • z) = α * g y + η * g z := by
    simp [hgdef, inner_add_right, inner_smul_right]
    ring_nf
    have hc : c = c * α + c * η := by
      calc
        c = c * (α + η) := by rw [hsum]; ring
        _ = c * α + c * η := by ring
    nlinarith
  have hh :
      S.h (α • y + η • z) ≤ α * S.h y + η * S.h z := by
    simpa [smul_eq_mul] using S.convex_h.2 hy hz hα hη hsum
  have hchi :
      S.chi (α • y + η • z) ≤ α * S.chi y + η * S.chi z := by
    simpa [smul_eq_mul] using S.convex_chi.2 hy hz hα hη hsum
  have hV :
      bregmanFormulaOnX S x ⟨α • y + η • z, hseg⟩ ≤
        α * bregmanFormulaOnX S x ⟨y, hy⟩ +
          η * bregmanFormulaOnX S x ⟨z, hz⟩ := by
    have h := hVconv.2 hy hz hα hη hsum
    simpa [SOptLib.carrierTotalizeOn, hseg, hy, hz, smul_eq_mul] using h
  have hβV := mul_le_mul_of_nonneg_left hV hβ
  simp [SOptLib.carrierTotalizeOn, hseg, hy, hz, spsPhiFormulaOnX, spsPhi]
  nlinarith [hglinear, hh, hchi, hβV, hsum]

/-- Feasible finite Jensen and baseline reduction for the averaged SPS iterate.

Aligns with Lan Proposition 8.3 proof step 3 at the formula-extension boundary.
Candidate audit: considered source helper `sps_phi_average_gap_le_weighted_gap_sum`
and SOptLib `convexOn_weighted_average_le_weighted_sum`; the source helper is
typed over `SPSSourceState`, while the reusable Jensen helper still requires
the local closed-form average and carrier-totalization simplifications that
this theorem packages for `spsPhiFormulaOnX`. -/
theorem sps_phiFormulaOnX_average_gap_le_weighted_gap_sum
    (g : E → ℝ) (x : FeasiblePoint S) (β : ℝ)
    (states : ℕ → Ω → SPSState S) (ω : Ω) (t : PositiveTime)
    (u : FeasiblePoint S)
    (havgClosed :
      (states t.1 ω).avg.1 =
        (psWeightProduct spsP t.1 *
            (1 - psWeightProduct spsP t.1)⁻¹) •
          (Finset.range t.1).sum (fun i =>
            ((spsP ⟨i + 1, Nat.succ_pos i⟩ * psWeightProduct spsP i)⁻¹) •
              (states (i + 1) ω).u.1))
    (hPhiConv :
      ConvexOn ℝ S.X
        (SOptLib.carrierTotalizeOn S.X
          (fun z : FeasiblePoint S => spsPhiFormulaOnX S g x β z))) :
    spsPhiFormulaOnX S g x β (states t.1 ω).avg -
        spsPhiFormulaOnX S g x β u ≤
      psWeightProduct spsP t.1 * (1 - psWeightProduct spsP t.1)⁻¹ *
        (Finset.range t.1).sum (fun i =>
          (spsP ⟨i + 1, Nat.succ_pos i⟩ * psWeightProduct spsP i)⁻¹ *
            (spsPhiFormulaOnX S g x β (states (i + 1) ω).u -
              spsPhiFormulaOnX S g x β u)) := by
  classical
  let C : ℝ := psWeightProduct spsP t.1 * (1 - psWeightProduct spsP t.1)⁻¹
  let w : ℕ → ℝ := fun i =>
    (spsP ⟨i + 1, Nat.succ_pos i⟩ * psWeightProduct spsP i)⁻¹
  let PhiE : E → ℝ :=
    SOptLib.carrierTotalizeOn S.X
      (fun z : FeasiblePoint S => spsPhiFormulaOnX S g x β z)
  have hqsum :
      (Finset.range t.1).sum (fun i => C * w i) = 1 := by
    simpa [C, w, mul_assoc] using sps_normalized_weight_sum_eq_one t.1 t.2
  have hq_nonneg : ∀ i ∈ Finset.range t.1, 0 ≤ C * w i := by
    intro i _hi
    have hnorm :
        C * w i =
          2 * ((i : ℝ) + 2) / ((t.1 : ℝ) * ((t.1 : ℝ) + 3)) := by
      simpa [C, w] using sps_normalized_weight_eq t.1 i t.2
    rw [hnorm]
    positivity
  have hp_mem : ∀ i ∈ Finset.range t.1, (states (i + 1) ω).u.1 ∈ S.X := by
    intro i _hi
    exact (states (i + 1) ω).u.2
  have hxbar :
      (states t.1 ω).avg.1 =
        (Finset.range t.1).sum (fun i => (C * w i) • (states (i + 1) ω).u.1) := by
    calc
      (states t.1 ω).avg.1 =
          C • (Finset.range t.1).sum (fun i => w i • (states (i + 1) ω).u.1) := by
            simpa [C, w] using havgClosed
      _ = (Finset.range t.1).sum (fun i => (C * w i) • (states (i + 1) ω).u.1) := by
            rw [Finset.smul_sum]
            refine Finset.sum_congr rfl ?_
            intro i _hi
            rw [smul_smul]
  have hJraw :=
    hPhiConv.map_sum_le (t := Finset.range t.1) (w := fun i => C * w i)
      (p := fun i => (states (i + 1) ω).u.1) hq_nonneg hqsum hp_mem
  have hJ :
      spsPhiFormulaOnX S g x β (states t.1 ω).avg ≤
        (Finset.range t.1).sum (fun i =>
          (C * w i) *
            spsPhiFormulaOnX S g x β (states (i + 1) ω).u) := by
    rw [← hxbar] at hJraw
    calc
      spsPhiFormulaOnX S g x β (states t.1 ω).avg =
          PhiE (states t.1 ω).avg.1 := by
            simp [PhiE, SOptLib.carrierTotalizeOn, (states t.1 ω).avg.2]
      _ ≤
          (Finset.range t.1).sum (fun i =>
            (C * w i) • PhiE (states (i + 1) ω).u.1) := hJraw
      _ =
          (Finset.range t.1).sum (fun i =>
            (C * w i) *
              spsPhiFormulaOnX S g x β (states (i + 1) ω).u) := by
            refine Finset.sum_congr rfl ?_
            intro i hi
            simp [PhiE, SOptLib.carrierTotalizeOn, hp_mem i hi, smul_eq_mul]
  have hbase :
      spsPhiFormulaOnX S g x β (states t.1 ω).avg -
          spsPhiFormulaOnX S g x β u ≤
        (Finset.range t.1).sum (fun i =>
          (C * w i) *
            (spsPhiFormulaOnX S g x β (states (i + 1) ω).u -
              spsPhiFormulaOnX S g x β u)) := by
    calc
      spsPhiFormulaOnX S g x β (states t.1 ω).avg -
          spsPhiFormulaOnX S g x β u
          ≤
        (Finset.range t.1).sum (fun i =>
          (C * w i) *
            spsPhiFormulaOnX S g x β (states (i + 1) ω).u) -
          spsPhiFormulaOnX S g x β u := by
          exact sub_le_sub_right hJ _
      _ =
        (Finset.range t.1).sum (fun i =>
          (C * w i) *
            (spsPhiFormulaOnX S g x β (states (i + 1) ω).u -
              spsPhiFormulaOnX S g x β u)) := by
          calc
            (Finset.range t.1).sum (fun i =>
                (C * w i) *
                  spsPhiFormulaOnX S g x β (states (i + 1) ω).u) -
                spsPhiFormulaOnX S g x β u
                =
              (Finset.range t.1).sum (fun i =>
                (C * w i) *
                  spsPhiFormulaOnX S g x β (states (i + 1) ω).u) -
                (Finset.range t.1).sum (fun i => C * w i) *
                  spsPhiFormulaOnX S g x β u := by
                  rw [hqsum]
                  ring
            _ =
              (Finset.range t.1).sum (fun i =>
                (C * w i) *
                  (spsPhiFormulaOnX S g x β (states (i + 1) ω).u -
                    spsPhiFormulaOnX S g x β u)) := by
                  rw [Finset.sum_mul, ← Finset.sum_sub_distrib]
                  refine Finset.sum_congr rfl ?_
                  intro i _hi
                  ring
  calc
    spsPhiFormulaOnX S g x β (states t.1 ω).avg -
        spsPhiFormulaOnX S g x β u
        ≤
      (Finset.range t.1).sum (fun i =>
        (C * w i) *
          (spsPhiFormulaOnX S g x β (states (i + 1) ω).u -
            spsPhiFormulaOnX S g x β u)) := hbase
    _ =
      C * (Finset.range t.1).sum (fun i =>
        w i *
          (spsPhiFormulaOnX S g x β (states (i + 1) ω).u -
            spsPhiFormulaOnX S g x β u)) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl ?_
        intro i _hi
        ring
    _ =
      psWeightProduct spsP t.1 * (1 - psWeightProduct spsP t.1)⁻¹ *
        (Finset.range t.1).sum (fun i =>
          (spsP ⟨i + 1, Nat.succ_pos i⟩ * psWeightProduct spsP i)⁻¹ *
            (spsPhiFormulaOnX S g x β (states (i + 1) ω).u -
              spsPhiFormulaOnX S g x β u)) := by
        rfl

/-- Formula-extension version of Lan Proposition 8.3 for a feasible SPS process.

Aligns with Lan Proposition 8.3 and Eq. (8.1.63), replacing the source-domain
`V : X^o × X → ℝ` terms by the feasible carrier formula `bregmanFormulaOnX`.
Candidate audit: `SPSInnerBound_Proposition8_3_sourceDomainProcess` and
`SPSInnerBound_Proposition8_3_formulaExtension` were considered, but both
require prox-core/source-domain SPS states. This helper consumes the feasible
one-step `Phi` recurrence, feasible average identity, and feasible Jensen
bridge directly. -/
theorem SPSInnerBound_Proposition8_3_formulaOnXProcess
    (g : E → ℝ) (hg : IsAffineModel g) (x : FeasiblePoint S) (β : ℝ)
    (sample : ℕ → Ω → Sample) (states : ℕ → Ω → SPSState S)
    (hprocess : IsSPSProcess S g x β sample states)
    (ω : Ω) (t : PositiveTime) (u : FeasiblePoint S) :
    β * (1 - psWeightProduct spsP t.1)⁻¹ *
        bregmanFormulaOnX S (states t.1 ω).u u +
      (spsPhiFormulaOnX S g x β (states t.1 ω).avg -
        spsPhiFormulaOnX S g x β u) ≤
      β * psWeightProduct spsP t.1 * (1 - psWeightProduct spsP t.1)⁻¹ *
          bregmanFormulaOnX S x u +
        psWeightProduct spsP t.1 * (1 - psWeightProduct spsP t.1)⁻¹ *
          (Finset.range t.1).sum (fun i =>
            let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
            let δ := oracleNoiseAt S ((states i ω).u.1) (sample i ω);
            (spsP ι * psWeightProduct spsP i)⁻¹ *
              (((S.mGrowth + dualNorm S δ) ^ 2) / (2 * β * spsP ι) +
                ⟪δ, u.1 - (states i ω).u.1⟫_ℝ)) := by
  classical
  have hstep :
      ∀ n : ℕ,
        let ι : PositiveTime := ⟨n + 1, Nat.succ_pos n⟩;
        let δ := oracleNoiseAt S ((states n ω).u.1) (sample n ω);
        let next : FeasiblePoint S := (states (n + 1) ω).u;
          spsPhiFormulaOnX S g x β next - spsPhiFormulaOnX S g x β u ≤
            β * spsP ι * bregmanFormulaOnX S (states n ω).u u -
              β * (1 + spsP ι) * bregmanFormulaOnX S (states (n + 1) ω).u u +
              ((S.mGrowth + dualNorm S δ) ^ 2) / (2 * β * spsP ι) +
              ⟪δ, u.1 - (states n ω).u.1⟫_ℝ := by
    intro n
    exact sps_formula_one_step_phi_bound S g hg x β sample states hprocess n ω u
  have havgClosed :
      (states t.1 ω).avg.1 =
        (psWeightProduct spsP t.1 *
            (1 - psWeightProduct spsP t.1)⁻¹) •
          (Finset.range t.1).sum (fun i =>
            ((spsP ⟨i + 1, Nat.succ_pos i⟩ * psWeightProduct spsP i)⁻¹) •
              (states (i + 1) ω).u.1) :=
    sps_avg_eq_weighted_sum S g x β sample states hprocess ω t
  have hPhiConv :
      ConvexOn ℝ S.X
        (SOptLib.carrierTotalizeOn S.X
          (fun z : FeasiblePoint S => spsPhiFormulaOnX S g x β z)) :=
    spsPhiFormulaOnX_convexOn_totalized S g hg x hprocess.1.le
  let C : ℝ := psWeightProduct spsP t.1 * (1 - psWeightProduct spsP t.1)⁻¹
  let gapSum : ℝ :=
    (Finset.range t.1).sum (fun i =>
      (spsP ⟨i + 1, Nat.succ_pos i⟩ * psWeightProduct spsP i)⁻¹ *
        (spsPhiFormulaOnX S g x β (states (i + 1) ω).u -
          spsPhiFormulaOnX S g x β u))
  have hJgap :
      spsPhiFormulaOnX S g x β (states t.1 ω).avg -
          spsPhiFormulaOnX S g x β u ≤ C * gapSum := by
    simpa [C, gapSum] using
      sps_phiFormulaOnX_average_gap_le_weighted_gap_sum S g x β states ω t u
        havgClosed hPhiConv
  have hScaledTel :
      β * (1 - psWeightProduct spsP t.1)⁻¹ *
          bregmanFormulaOnX S (states t.1 ω).u u +
        C * gapSum ≤
      β * psWeightProduct spsP t.1 * (1 - psWeightProduct spsP t.1)⁻¹ *
          bregmanFormulaOnX S x u +
        psWeightProduct spsP t.1 * (1 - psWeightProduct spsP t.1)⁻¹ *
          (Finset.range t.1).sum (fun i =>
            let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
            let δ := oracleNoiseAt S ((states i ω).u.1) (sample i ω);
            (spsP ι * psWeightProduct spsP i)⁻¹ *
              (((S.mGrowth + dualNorm S δ) ^ 2) / (2 * β * spsP ι) +
                ⟪δ, u.1 - (states i ω).u.1⟫_ℝ)) := by
    have hCoeffPrev : ∀ (i : ℕ) (V : ℝ),
        (spsP ⟨i + 1, Nat.succ_pos i⟩ * psWeightProduct spsP i)⁻¹ *
            (β * spsP ⟨i + 1, Nat.succ_pos i⟩ * V) =
          β * (psWeightProduct spsP i)⁻¹ * V := by
      intro i V
      have hp : spsP ⟨i + 1, Nat.succ_pos i⟩ ≠ 0 := by
        unfold spsP
        positivity
      have hP : psWeightProduct spsP i ≠ 0 := by
        rw [psWeightProduct_spsP_eq i]
        positivity
      field_simp [hp, hP]
    have hCoeffNext : ∀ (i : ℕ) (V : ℝ),
        (spsP ⟨i + 1, Nat.succ_pos i⟩ * psWeightProduct spsP i)⁻¹ *
            (β * (1 + spsP ⟨i + 1, Nat.succ_pos i⟩) * V) =
          β * (psWeightProduct spsP (i + 1))⁻¹ * V := by
      intro i V
      have hp : spsP ⟨i + 1, Nat.succ_pos i⟩ ≠ 0 := by
        unfold spsP
        positivity
      have hp1 : 1 + spsP ⟨i + 1, Nat.succ_pos i⟩ ≠ 0 := by
        unfold spsP
        positivity
      have hP : psWeightProduct spsP i ≠ 0 := by
        rw [psWeightProduct_spsP_eq i]
        positivity
      simp [psWeightProduct]
      field_simp [hp, hp1, hP]
    have hWeightedStep : ∀ i : ℕ,
        let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
        let δ := oracleNoiseAt S ((states i ω).u.1) (sample i ω);
        let next : FeasiblePoint S := (states (i + 1) ω).u;
        (spsP ι * psWeightProduct spsP i)⁻¹ *
            (spsPhiFormulaOnX S g x β next - spsPhiFormulaOnX S g x β u) ≤
          β * (psWeightProduct spsP i)⁻¹ * bregmanFormulaOnX S (states i ω).u u -
            β * (psWeightProduct spsP (i + 1))⁻¹ *
              bregmanFormulaOnX S (states (i + 1) ω).u u +
            (spsP ι * psWeightProduct spsP i)⁻¹ *
              (((S.mGrowth + dualNorm S δ) ^ 2) / (2 * β * spsP ι) +
                ⟪δ, u.1 - (states i ω).u.1⟫_ℝ) := by
      intro i
      let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩
      let δ := oracleNoiseAt S ((states i ω).u.1) (sample i ω)
      let next : FeasiblePoint S := (states (i + 1) ω).u
      let wi : ℝ := (spsP ι * psWeightProduct spsP i)⁻¹
      have hwi_nonneg : 0 ≤ wi := by
        have hwieq : wi = (i : ℝ) + 2 := by
          simpa [wi, ι] using sps_step_weight_inv_eq i
        rw [hwieq]
        positivity
      have hs := hstep i
      have hmul := mul_le_mul_of_nonneg_left hs hwi_nonneg
      have hprev :
          wi * (β * spsP ι * bregmanFormulaOnX S (states i ω).u u) =
            β * (psWeightProduct spsP i)⁻¹ *
              bregmanFormulaOnX S (states i ω).u u := by
        simpa [wi, ι] using
          hCoeffPrev i (bregmanFormulaOnX S (states i ω).u u)
      have hnext :
          wi * (β * (1 + spsP ι) *
              bregmanFormulaOnX S (states (i + 1) ω).u u) =
            β * (psWeightProduct spsP (i + 1))⁻¹ *
              bregmanFormulaOnX S (states (i + 1) ω).u u := by
        simpa [wi, ι] using
          hCoeffNext i (bregmanFormulaOnX S (states (i + 1) ω).u u)
      dsimp [ι, δ, next, wi] at hmul hprev hnext ⊢
      nlinarith
    let drop : ℕ → ℝ := fun i =>
      β * (psWeightProduct spsP i)⁻¹ * bregmanFormulaOnX S (states i ω).u u -
        β * (psWeightProduct spsP (i + 1))⁻¹ *
          bregmanFormulaOnX S (states (i + 1) ω).u u
    let noise : ℕ → ℝ := fun i =>
      let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩
      let δ := oracleNoiseAt S ((states i ω).u.1) (sample i ω)
      (spsP ι * psWeightProduct spsP i)⁻¹ *
        (((S.mGrowth + dualNorm S δ) ^ 2) / (2 * β * spsP ι) +
          ⟪δ, u.1 - (states i ω).u.1⟫_ℝ)
    have hSumStep :
        gapSum ≤
          (Finset.range t.1).sum (fun i => drop i) +
            (Finset.range t.1).sum (fun i => noise i) := by
      calc
        gapSum =
            (Finset.range t.1).sum (fun i =>
              (spsP ⟨i + 1, Nat.succ_pos i⟩ * psWeightProduct spsP i)⁻¹ *
                (spsPhiFormulaOnX S g x β (states (i + 1) ω).u -
                  spsPhiFormulaOnX S g x β u)) := by
              rfl
        _ ≤
            (Finset.range t.1).sum (fun i => drop i + noise i) := by
              refine Finset.sum_le_sum ?_
              intro i _hi
              simpa [drop, noise] using hWeightedStep i
        _ =
            (Finset.range t.1).sum (fun i => drop i) +
              (Finset.range t.1).sum (fun i => noise i) := by
              rw [Finset.sum_add_distrib]
    let A : ℕ → ℝ := fun i =>
      β * (psWeightProduct spsP i)⁻¹ * bregmanFormulaOnX S (states i ω).u u
    have hDropTel :
        (Finset.range t.1).sum (fun i => drop i) = A 0 - A t.1 := by
      simpa [drop, A] using Finset.sum_range_sub' A t.1
    have hA0 : A 0 = β * bregmanFormulaOnX S x u := by
      have hinit : states 0 ω = spsInitial S x := hprocess.2.1 ω
      simp [A, hinit, spsInitial, psWeightProduct]
    have hTelUnscaled :
        gapSum ≤
          β * bregmanFormulaOnX S x u -
            β * (psWeightProduct spsP t.1)⁻¹ *
              bregmanFormulaOnX S (states t.1 ω).u u +
            (Finset.range t.1).sum (fun i => noise i) := by
      calc
        gapSum ≤
            (Finset.range t.1).sum (fun i => drop i) +
              (Finset.range t.1).sum (fun i => noise i) := hSumStep
        _ = A 0 - A t.1 + (Finset.range t.1).sum (fun i => noise i) := by
            rw [hDropTel]
        _ =
            β * bregmanFormulaOnX S x u -
              β * (psWeightProduct spsP t.1)⁻¹ *
                bregmanFormulaOnX S (states t.1 ω).u u +
              (Finset.range t.1).sum (fun i => noise i) := by
            rw [hA0]
    have hTpos : 0 < t.1 := t.2
    have hPpos : 0 < psWeightProduct spsP t.1 := by
      rw [psWeightProduct_spsP_eq t.1]
      positivity
    have hOneSubpos : 0 < 1 - psWeightProduct spsP t.1 :=
      one_sub_psWeightProduct_spsP_pos_of_pos hTpos
    have hC_nonneg : 0 ≤ C := by
      dsimp [C]
      exact mul_nonneg (le_of_lt hPpos) (inv_nonneg.mpr (le_of_lt hOneSubpos))
    have hScaled := mul_le_mul_of_nonneg_left hTelUnscaled hC_nonneg
    calc
      β * (1 - psWeightProduct spsP t.1)⁻¹ *
          bregmanFormulaOnX S (states t.1 ω).u u +
        C * gapSum
          ≤
        β * (1 - psWeightProduct spsP t.1)⁻¹ *
            bregmanFormulaOnX S (states t.1 ω).u u +
          C *
            (β * bregmanFormulaOnX S x u -
              β * (psWeightProduct spsP t.1)⁻¹ *
                bregmanFormulaOnX S (states t.1 ω).u u +
              (Finset.range t.1).sum (fun i => noise i)) := by
            simpa [add_comm, add_left_comm, add_assoc, mul_assoc] using
              add_le_add_left hScaled
                (β * (1 - psWeightProduct spsP t.1)⁻¹ *
                  bregmanFormulaOnX S (states t.1 ω).u u)
      _ =
        β * psWeightProduct spsP t.1 * (1 - psWeightProduct spsP t.1)⁻¹ *
            bregmanFormulaOnX S x u +
          psWeightProduct spsP t.1 * (1 - psWeightProduct spsP t.1)⁻¹ *
            (Finset.range t.1).sum (fun i =>
              let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
              let δ := oracleNoiseAt S ((states i ω).u.1) (sample i ω);
              (spsP ι * psWeightProduct spsP i)⁻¹ *
                (((S.mGrowth + dualNorm S δ) ^ 2) / (2 * β * spsP ι) +
                  ⟪δ, u.1 - (states i ω).u.1⟫_ℝ)) := by
          calc
            β * (1 - psWeightProduct spsP t.1)⁻¹ *
                bregmanFormulaOnX S (states t.1 ω).u u +
              C *
                (β * bregmanFormulaOnX S x u -
                  β * (psWeightProduct spsP t.1)⁻¹ *
                    bregmanFormulaOnX S (states t.1 ω).u u +
                  (Finset.range t.1).sum (fun i => noise i))
                =
              β * C * bregmanFormulaOnX S x u +
                C * (Finset.range t.1).sum (fun i => noise i) := by
                dsimp [C]
                field_simp [ne_of_gt hPpos, ne_of_gt hOneSubpos]
                ring
            _ =
              β * psWeightProduct spsP t.1 * (1 - psWeightProduct spsP t.1)⁻¹ *
                  bregmanFormulaOnX S x u +
                psWeightProduct spsP t.1 * (1 - psWeightProduct spsP t.1)⁻¹ *
                  (Finset.range t.1).sum (fun i =>
                    let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
                    let δ := oracleNoiseAt S ((states i ω).u.1) (sample i ω);
                    (spsP ι * psWeightProduct spsP i)⁻¹ *
                      (((S.mGrowth + dualNorm S δ) ^ 2) / (2 * β * spsP ι) +
                        ⟪δ, u.1 - (states i ω).u.1⟫_ℝ)) := by
                dsimp [C, noise]
                rw [show
                  β * (psWeightProduct spsP t.1 *
                      (1 - psWeightProduct spsP t.1)⁻¹) *
