/-- Early normalized Eq. (8.1.24) coefficient for the SPS product schedule.

Aligns with Lan Eq. (8.1.24).  Candidate audit: considered the pre-searched
weighted-variance/algebra candidates and SOptLib weighted-output helpers; they
do not provide the concrete `P_t`/`p_t` normalization, so this paper-local
arithmetic bridge specializes `psWeightProduct_spsP_eq`. -/
theorem sps_normalized_weight_eq (n i : ℕ) (hn : 0 < n) :
    psWeightProduct spsP n * (1 - psWeightProduct spsP n)⁻¹ *
        (spsP ⟨i + 1, Nat.succ_pos i⟩ * psWeightProduct spsP i)⁻¹ =
      2 * ((i : ℝ) + 2) / ((n : ℝ) * ((n : ℝ) + 3)) := by
  rw [sps_step_weight_inv_eq i, psWeightProduct_spsP_eq n]
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hn)
  have hn1 : (n : ℝ) + 1 ≠ 0 := by positivity
  have hn2 : (n : ℝ) + 2 ≠ 0 := by positivity
  have hn3 : (n : ℝ) + 3 ≠ 0 := by positivity
  have hden : ((n : ℝ) + 1) * ((n : ℝ) + 2) ≠ 0 :=
    mul_ne_zero hn1 hn2
  have hgap : 1 - 2 / (((n : ℝ) + 1) * ((n : ℝ) + 2)) ≠ 0 := by
    have hpos : 0 < 1 - psWeightProduct spsP n :=
      one_sub_psWeightProduct_spsP_pos_of_pos hn
    rw [psWeightProduct_spsP_eq n] at hpos
    exact ne_of_gt hpos
  have hpoly : (n : ℝ) * 3 + (n : ℝ) ^ 2 ≠ 0 := by
    have hnpos : 0 < (n : ℝ) := by exact_mod_cast hn
    have hprod : 0 < (n : ℝ) * ((n : ℝ) + 3) := by positivity
    nlinarith
  field_simp [hn0, hn1, hn2, hn3, hden, hgap, hpoly]
  have hden2 :
      ((n : ℝ) + 1) * ((n : ℝ) + 2) - 2 =
        (n : ℝ) * ((n : ℝ) + 3) := by
    ring
  rw [hden2]
  field_simp [hn0, hn3]

/-- Early normalized Eq. (8.1.24) SPS coefficients sum to one.

Aligns with Lan Proposition 8.3 proof step 3.  Candidate audit: the
pre-searched SOptLib/Mathlib candidates and weighted-output helpers consume
normalized weights rather than proving this paper-specific `p_t=t/2`, `P_t`
arithmetic normalization, so this helper specializes `sps_normalized_weight_eq`. -/
theorem sps_normalized_weight_sum_eq_one (T : ℕ) (hT : 0 < T) :
    (Finset.range T).sum (fun i =>
        psWeightProduct spsP T * (1 - psWeightProduct spsP T)⁻¹ *
          (spsP ⟨i + 1, Nat.succ_pos i⟩ * psWeightProduct spsP i)⁻¹) = 1 := by
  classical
  have hT0 : (T : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hT)
  have hT3 : (T : ℝ) + 3 ≠ 0 := by positivity
  have hden_ne : (T : ℝ) * ((T : ℝ) + 3) ≠ 0 := mul_ne_zero hT0 hT3
  calc
    (Finset.range T).sum (fun i =>
        psWeightProduct spsP T * (1 - psWeightProduct spsP T)⁻¹ *
          (spsP ⟨i + 1, Nat.succ_pos i⟩ * psWeightProduct spsP i)⁻¹)
        =
      (Finset.range T).sum (fun i =>
        2 * ((i : ℝ) + 2) / ((T : ℝ) * ((T : ℝ) + 3))) := by
        refine Finset.sum_congr rfl ?_
        intro i _hi
        exact sps_normalized_weight_eq T i hT
    _ = 1 := by
        rw [← Finset.sum_div]
        field_simp [hden_ne]
        have hpoly : ∀ n : ℕ,
            (Finset.range n).sum (fun x => 2 * ((x : ℝ) + 2)) =
              (n : ℝ) * ((n : ℝ) + 3) := by
          intro n
          induction n with
          | zero =>
              simp
          | succ n ih =>
              rw [Finset.sum_range_succ, ih]
              norm_num
              ring
        exact hpoly T

