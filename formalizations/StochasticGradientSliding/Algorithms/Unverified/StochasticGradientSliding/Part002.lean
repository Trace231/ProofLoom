          one_sub_psWeightProduct_spsP_pos_of_pos (hTpos j)
        have hgamma_le : gamma j ≤ 1 := by
          by_contra hnotle
          have hgamma_gt : 1 < gamma j := lt_of_not_ge hnotle
          have hGamma_j_neg : Gamma j < 0 := by
            rw [hGamma.2 j hj2]
            exact mul_neg_of_neg_of_pos (sub_neg.mpr hgamma_gt) hGamma_pred_pos
          have hden_neg : Gamma j * (1 - psWeightProduct spsP (T j)) < 0 :=
            mul_neg_of_neg_of_pos hGamma_j_neg hgap
          have hnum_pos : 0 < gamma j * beta j :=
            mul_pos (lt_trans zero_lt_one hgamma_gt) (hbeta j)
          have hq_j_neg : q j < 0 := by
            dsimp [q]
            rw [checkedQuotient_def]
            exact div_neg_of_pos_of_neg hnum_pos hden_neg
          have hmono_step := reverseMonotonicityCondition_checked_spec beta gamma Gamma T
            hmono j hj2
          have hq_pred_le : q (predTime j hj2) ≤ q j := by
            simpa [q] using hmono_step
          exact not_lt_of_ge (le_trans hq_pred_nonneg hq_pred_le) hq_j_neg
        have hGamma_j_nonneg : 0 ≤ Gamma j := by
          rw [hGamma.2 j hj2]
          exact mul_nonneg (sub_nonneg.mpr hgamma_le) (le_of_lt hGamma_pred_pos)
        have hGamma_j_pos : 0 < Gamma j := by
          have hGamma_j_ne : Gamma j ≠ 0 :=
            (mul_ne_zero_iff.mp (hdenom j)).1
          exact lt_of_le_of_ne hGamma_j_nonneg (Ne.symm hGamma_j_ne)
        have hq_j_nonneg : 0 ≤ q j := by
          have hden_pos : 0 < Gamma j * (1 - psWeightProduct spsP (T j)) :=
            mul_pos hGamma_j_pos hgap
          have hnum_nonneg : 0 ≤ gamma j * beta j :=
            mul_nonneg (hgamma_nonneg j) (le_of_lt (hbeta j))
          dsimp [q]
          rw [checkedQuotient_def]
          exact div_nonneg hnum_nonneg (le_of_lt hden_pos)
        exact ⟨hGamma_j_pos, hgamma_le, hq_j_nonneg⟩)
  intro k
  exact ⟨hgamma_nonneg k, (hnat k.1 k.2 k rfl).2.1⟩

