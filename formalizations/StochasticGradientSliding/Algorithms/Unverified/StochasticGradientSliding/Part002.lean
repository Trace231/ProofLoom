      AEStronglyMeasurable (fun ω => objectiveOn S (states n ω).xbar) law.P :=
    hobj_aemeas.aestronglyMeasurable
  simpa [objectiveOn] using
    hobj_asm.sub
      (aestronglyMeasurable_const :
        AEStronglyMeasurable (fun _ : Ω => objective S xStar) law.P)

/-- Optimal-comparator objective-gap integrability from the generated one-step
recurrence.

Aligns with Lan Theorem 8.2 proof step 2: after taking `u = x^*`, optimality
makes the gap nonnegative and the one-step recurrence dominates the next gap by
an integrable right-hand side. Candidate audit: rejected the older
comparator-generic `_voucher_step_expected_hstep_integrability_4` objective-gap
branch because it did not use `hxStar` or the recurrence and is stronger than
the source step. -/
private theorem optimal_gap_integrable_from_hstep_recurrence
    [MeasurableSpace Ω] [MeasurableSpace Sample] [MeasurableSpace E] [BorelSpace E]
    (law : SGSProbabilityModel (Ω := Ω) S) (x0 : FeasiblePoint S) (xStar : E)
    (beta gamma : PositiveTime → ℝ) (T : PositiveTime → ℕ)
    (states : ℕ → Ω → SGSState S)
    (inner : PositiveTime → ℕ → Ω → SPSState S)
    (hrun : IsGeneratedSGSProcess_formulaExtension S x0 beta gamma T law.sample states inner)
    (hxStar : IsOptimalSolution S xStar)
    (hgap_asm :
      ∀ n,
        AEStronglyMeasurable
          (fun ω => objective S (states n ω).xbar.1 - objective S xStar) law.P)
    (hfirst_recurrence :
      ∀ k : PositiveTime, ∀ ω,
        let stPrev := states (k.1 - 1) ω
        let stCurr := states k.1 ω
        let δinner := inner k
        objective S stCurr.xbar.1 - objective S xStar ≤
          (1 - gamma k) *
              (objective S stPrev.xbar.1 - objective S xStar) +
            gamma k *
              (beta k * (1 - psWeightProduct spsP (T k))⁻¹ *
                  (bregmanFormulaOnX S stPrev.x ⟨xStar, hxStar.1⟩ -
                    bregmanFormulaOnX S stCurr.x ⟨xStar, hxStar.1⟩) +
                psWeightProduct spsP (T k) *
                  (1 - psWeightProduct spsP (T k))⁻¹ *
                    (Finset.range (T k)).sum (fun i =>
                      let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
                      let δ := oracleNoiseAt S ((δinner i ω).u.1) (law.sample k i ω);
                      (spsP ι * psWeightProduct spsP i)⁻¹ *
                        (((S.mGrowth + dualNorm S δ) ^ 2) /
                            (2 * beta k * spsP ι) +
                          ⟪δ, xStar - (δinner i ω).u.1⟫_ℝ))))
    (hstep_int :
      ∀ t (ht : 1 ≤ t),
        Integrable
          (fun ω =>
            let κ : PositiveTime := ⟨t, ht⟩
            gamma κ *
              (beta κ * (1 - psWeightProduct spsP (T κ))⁻¹ *
                  (bregmanFormulaOnX S (states (κ.1 - 1) ω).x ⟨xStar, hxStar.1⟩ -
                    bregmanFormulaOnX S (states κ.1 ω).x ⟨xStar, hxStar.1⟩) +
                psWeightProduct spsP (T κ) *
                  (1 - psWeightProduct spsP (T κ))⁻¹ *
                    (Finset.range (T κ)).sum (fun i =>
                      let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
                      let δ := oracleNoiseAt S ((inner κ i ω).u.1)
                        (law.sample κ i ω);
                      (spsP ι * psWeightProduct spsP i)⁻¹ *
                        (((S.mGrowth + dualNorm S δ) ^ 2) /
                            (2 * beta κ * spsP ι) +
                          ⟪δ, xStar - (inner κ i ω).u.1⟫_ℝ)))) law.P) :
    (∀ t, Integrable
      (fun ω => objective S (states t ω).xbar.1 - objective S xStar) law.P) ∧
    (∀ t, 1 ≤ t →
      Integrable
        (fun ω => objective S (states (t - 1) ω).xbar.1 -
          objective S xStar) law.P) := by
  classical
  have hinit : ∀ ω, states 0 ω = sgsInitial S x0 := hrun.1.1
  have hnonneg :
      ∀ n ω, 0 ≤ objective S (states n ω).xbar.1 - objective S xStar := by
    intro n ω
    exact sub_nonneg.mpr (hxStar.2 (states n ω).xbar.2)
  let gap : ℕ → Ω → ℝ := fun n ω =>
    objective S (states n ω).xbar.1 - objective S xStar
  have hgap_int_all : ∀ n, Integrable (gap n) law.P := by
    intro n
    induction n with
    | zero =>
        refine (integrable_const
          (c := objective S x0.1 - objective S xStar)).congr ?_
        filter_upwards with ω
        simp [gap, hinit ω, sgsInitial]
    | succ m ih =>
        let κ : PositiveTime := ⟨m + 1, Nat.succ_pos m⟩
        let step : Ω → ℝ := fun ω =>
          gamma κ *
            (beta κ * (1 - psWeightProduct spsP (T κ))⁻¹ *
                (bregmanFormulaOnX S (states (κ.1 - 1) ω).x ⟨xStar, hxStar.1⟩ -
                  bregmanFormulaOnX S (states κ.1 ω).x ⟨xStar, hxStar.1⟩) +
              psWeightProduct spsP (T κ) *
                (1 - psWeightProduct spsP (T κ))⁻¹ *
                  (Finset.range (T κ)).sum (fun i =>
                    let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
                    let δ := oracleNoiseAt S ((inner κ i ω).u.1)
                      (law.sample κ i ω);
                    (spsP ι * psWeightProduct spsP i)⁻¹ *
                      (((S.mGrowth + dualNorm S δ) ^ 2) /
                          (2 * beta κ * spsP ι) +
                        ⟪δ, xStar - (inner κ i ω).u.1⟫_ℝ)))
        let rhs : Ω → ℝ := fun ω => (1 - gamma κ) * gap m ω + step ω
        have hstep_m : Integrable step law.P := by
          simpa [step, κ] using hstep_int (m + 1) (Nat.succ_pos m)
        have hrhs_int : Integrable rhs law.P := by
          exact (ih.const_mul (1 - gamma κ)).add hstep_m
        refine MeasureTheory.Integrable.mono' hrhs_int (hgap_asm (m + 1)) ?_
        filter_upwards with ω
        have hle : gap (m + 1) ω ≤ rhs ω := by
          simpa [gap, rhs, step, κ] using hfirst_recurrence κ ω
        have hg_nonneg : 0 ≤ gap (m + 1) ω := by
          simpa [gap] using hnonneg (m + 1) ω
        have hrhs_nonneg : 0 ≤ rhs ω := le_trans hg_nonneg hle
        rw [Real.norm_of_nonneg hg_nonneg]
        exact hle
  refine ⟨?_, ?_⟩
  · intro t
    simpa [gap] using hgap_int_all t
  · intro t _ht
    simpa [gap] using hgap_int_all (t - 1)

