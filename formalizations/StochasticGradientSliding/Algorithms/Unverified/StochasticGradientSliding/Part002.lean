private theorem objectiveOn_measurable_of_setup
    [MeasurableSpace E] [BorelSpace E] :
    Measurable (fun x : FeasiblePoint S => objectiveOn S x) := by
  classical
  exact objectiveOn_measurable_of_relativelySimpleChi
    (S := S) S.relatively_simple_chi

/-- A.e. strong measurability of the optimal objective gap along generated
outer averages.

Aligns with Lan Theorem 8.2 proof step 2, where the expectation is taken after
