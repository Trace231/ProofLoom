theorem gammaRangeCondition_of_reverseMonotonicity_generated
    (beta gamma Gamma : PositiveTime → ℝ) (T : PositiveTime → ℕ)
    (hbeta : ∀ k : PositiveTime, 0 < beta k)
    (hgamma_nonneg : gammaNonnegativeCondition gamma)
    (hlower : outerLowerBoundCondition S beta gamma)
    (hGamma : outerWeightCondition gamma Gamma)
    (hmono : reverseMonotonicityCondition beta gamma Gamma T) :
    gammaRangeCondition gamma := by
  classical
  have hdenom :
      monotonicityQuotientDenominators Gamma T :=
    reverseMonotonicityCondition_denominators beta gamma Gamma T hmono
  have hTpos : ∀ k : PositiveTime, 0 < T k := by
    intro k
    by_contra hnot
    have hzero : T k = 0 := Nat.eq_zero_of_not_pos hnot
    have hfactor : 1 - psWeightProduct spsP (T k) = 0 := by
      simp [hzero, psWeightProduct]
    exact hdenom k (by simp [hfactor])
  let q : PositiveTime → ℝ := fun k =>
    checkedQuotient (gamma k * beta k)
      (Gamma k * (1 - psWeightProduct spsP (T k))) (hdenom k)
  have hq_one_nonneg : 0 ≤ q oneTime := by
    have hgap : 0 < 1 - psWeightProduct spsP (T oneTime) :=
      one_sub_psWeightProduct_spsP_pos_of_pos (hTpos oneTime)
    have hden_pos : 0 < Gamma oneTime * (1 - psWeightProduct spsP (T oneTime)) := by
      rw [hGamma.1]
      exact mul_pos zero_lt_one hgap
    have hnum_nonneg : 0 ≤ gamma oneTime * beta oneTime := by
      exact mul_nonneg (hgamma_nonneg oneTime) (le_of_lt (hbeta oneTime))
    exact div_nonneg hnum_nonneg (le_of_lt hden_pos)
  have hnat :
      ∀ n : ℕ, 1 ≤ n → ∀ j : PositiveTime, j.1 = n →
        0 < Gamma j ∧ gamma j ≤ 1 ∧ 0 ≤ q j := by
    intro n
    exact Nat.strong_induction_on n (fun n ih => by
      intro hn j hj
      by_cases hn1 : n = 1
      · have hj_one : j = oneTime := by
          apply Subtype.ext
          simpa [oneTime, hj, hn1]
        subst hj_one
        refine ⟨?_, ?_, hq_one_nonneg⟩
        · rw [hGamma.1]
          norm_num
        · rw [hlower.1]
      · have hj2 : 2 ≤ j.1 := by omega
        have hpred_lt : (predTime j hj2).1 < n := by
          simp [predTime, hj]
          omega
        have hpred_ge : 1 ≤ (predTime j hj2).1 := (predTime j hj2).2
        rcases ih (predTime j hj2).1 hpred_lt hpred_ge (predTime j hj2) rfl with
          ⟨hGamma_pred_pos, _hgamma_pred_le, hq_pred_nonneg⟩
