    (queryFP : Ω → FeasiblePoint S)
    (k : PositiveTime) (i : ℕ)
    (hquery_meas : Measurable queryFP)
    (hcurrent_indep : IndepFun queryFP (sample k i) P)
    (hpositive_meas :
