  let telescopedRHS : ℝ :=
    (if ht : 1 ≤ N.1 then Gamma ⟨N.1, ht⟩ else 1) *
      Finset.sum (Finset.Icc 1 N.1) (fun t =>
        (if ht : 1 ≤ t then
