          (fun ω =>
            let κ : PositiveTime := ⟨t, ht⟩
            gamma κ *
              (beta κ * (1 - psWeightProduct spsP (T κ))⁻¹ *
                  (bregmanFormulaOnX S (states (κ.1 - 1) ω).x uStar -
                    bregmanFormulaOnX S (states κ.1 ω).x uStar) +
                psWeightProduct spsP (T κ) *
                  (1 - psWeightProduct spsP (T κ))⁻¹ *
                    (Finset.range (T κ)).sum (fun i =>
                      let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
                      let δ := oracleNoiseAt S ((inner κ i ω).u.1)
                        (law.sample κ i ω);
                      (spsP ι * psWeightProduct spsP i)⁻¹ *
                        (((S.mGrowth + dualNorm S δ) ^ 2) /
                            (2 * beta κ * spsP ι) +
                          ⟪δ, uStar.1 - (inner κ i ω).u.1⟫_ℝ)))) law.P) :
    ∀ t, 1 ≤ t →
      (∫ ω, objective S (states t ω).xbar.1 - objective S uStar.1 ∂law.P) ≤
        (1 - (if ht : 1 ≤ t then gamma ⟨t, ht⟩ else 0)) *
            (∫ ω, objective S (states (t - 1) ω).xbar.1 -
              objective S uStar.1 ∂law.P) +
          (if ht : 1 ≤ t then
            let κ : PositiveTime := ⟨t, ht⟩
            ∫ ω,
              gamma κ *
                (beta κ * (1 - psWeightProduct spsP (T κ))⁻¹ *
                    (bregmanFormulaOnX S (states (κ.1 - 1) ω).x uStar -
                      bregmanFormulaOnX S (states κ.1 ω).x uStar) +
                  psWeightProduct spsP (T κ) *
                    (1 - psWeightProduct spsP (T κ))⁻¹ *
                      (Finset.range (T κ)).sum (fun i =>
                        let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
                        let δ := oracleNoiseAt S ((inner κ i ω).u.1)
                          (law.sample κ i ω);
                        (spsP ι * psWeightProduct spsP i)⁻¹ *
                          (((S.mGrowth + dualNorm S δ) ^ 2) /
                              (2 * beta κ * spsP ι) +
                            ⟪δ, uStar.1 - (inner κ i ω).u.1⟫_ℝ))) ∂law.P
            else 0) := by
  intro t ht
  let κ : PositiveTime := ⟨t, ht⟩
  let lhs : Ω → ℝ := fun ω =>
    objective S (states t ω).xbar.1 - objective S uStar.1
  let prev : Ω → ℝ := fun ω =>
    objective S (states (t - 1) ω).xbar.1 - objective S uStar.1
  let step : Ω → ℝ := fun ω =>
    gamma κ *
      (beta κ * (1 - psWeightProduct spsP (T κ))⁻¹ *
          (bregmanFormulaOnX S (states (κ.1 - 1) ω).x uStar -
            bregmanFormulaOnX S (states κ.1 ω).x uStar) +
        psWeightProduct spsP (T κ) *
          (1 - psWeightProduct spsP (T κ))⁻¹ *
            (Finset.range (T κ)).sum (fun i =>
              let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
              let δ := oracleNoiseAt S ((inner κ i ω).u.1) (law.sample κ i ω);
              (spsP ι * psWeightProduct spsP i)⁻¹ *
                (((S.mGrowth + dualNorm S δ) ^ 2) /
                    (2 * beta κ * spsP ι) +
                  ⟪δ, uStar.1 - (inner κ i ω).u.1⟫_ℝ)))
  let rhs : Ω → ℝ := fun ω => (1 - gamma κ) * prev ω + step ω
  have hlhs_int : Integrable lhs law.P := by
    simpa [lhs] using hgap_int t ht
  have hprev_int : Integrable prev law.P := by
    simpa [prev] using hprev_gap_int t ht
  have hstep_int_t : Integrable step law.P := by
    simpa [step, κ] using hstep_int t ht
  have hrhs_int : Integrable rhs law.P := by
    exact (hprev_int.const_mul (1 - gamma κ)).add hstep_int_t
  have hpoint : lhs ≤ rhs := by
    intro ω
    simpa [lhs, rhs, prev, step, κ] using hfirst_recurrence κ ω
  have hmono_int : (∫ ω, lhs ω ∂law.P) ≤ ∫ ω, rhs ω ∂law.P :=
    MeasureTheory.integral_mono hlhs_int hrhs_int hpoint
  have hrhs_eval :
      (∫ ω, rhs ω ∂law.P) =
        (1 - gamma κ) * (∫ ω, prev ω ∂law.P) + ∫ ω, step ω ∂law.P := by
    calc
      (∫ ω, rhs ω ∂law.P)
          = ∫ ω, (1 - gamma κ) * prev ω + step ω ∂law.P := by
              rfl
      _ = (∫ ω, (1 - gamma κ) * prev ω ∂law.P) + ∫ ω, step ω ∂law.P := by
              exact integral_add (hprev_int.const_mul (1 - gamma κ)) hstep_int_t
      _ = (1 - gamma κ) * (∫ ω, prev ω ∂law.P) + ∫ ω, step ω ∂law.P := by
              rw [integral_const_mul]
  calc
    (∫ ω, objective S (states t ω).xbar.1 - objective S uStar.1 ∂law.P)
        = ∫ ω, lhs ω ∂law.P := rfl
    _ ≤ ∫ ω, rhs ω ∂law.P := hmono_int
    _ = (1 - gamma κ) * (∫ ω, prev ω ∂law.P) + ∫ ω, step ω ∂law.P := hrhs_eval
    _ =
        (1 - (if ht : 1 ≤ t then gamma ⟨t, ht⟩ else 0)) *
            (∫ ω, objective S (states (t - 1) ω).xbar.1 -
              objective S uStar.1 ∂law.P) +
          (if ht : 1 ≤ t then
            let κ : PositiveTime := ⟨t, ht⟩
            ∫ ω,
              gamma κ *
                (beta κ * (1 - psWeightProduct spsP (T κ))⁻¹ *
                    (bregmanFormulaOnX S (states (κ.1 - 1) ω).x uStar -
                      bregmanFormulaOnX S (states κ.1 ω).x uStar) +
                  psWeightProduct spsP (T κ) *
                    (1 - psWeightProduct spsP (T κ))⁻¹ *
                      (Finset.range (T κ)).sum (fun i =>
                        let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
                        let δ := oracleNoiseAt S ((inner κ i ω).u.1)
                          (law.sample κ i ω);
                        (spsP ι * psWeightProduct spsP i)⁻¹ *
                          (((S.mGrowth + dualNorm S δ) ^ 2) /
                              (2 * beta κ * spsP ι) +
                            ⟪δ, uStar.1 - (inner κ i ω).u.1⟫_ℝ))) ∂law.P
          else 0) := by
            simp [κ, prev, step, ht]

/-- Expected forward Bregman-drop telescope for the post-telescope Theorem 8.2
aggregation.

Aligns with Lan Eq. (8.1.69), proof step 2: the forward monotonicity condition
collapses the weighted Bregman-drop window to the initial
`β₁ (1 - P_{T₁})⁻¹ V(x₀,u)` boundary term. Candidate audit: considered
SOptLib `accelerated_bregman_window_le_initial_budget` and
`weighted_output_gap_le_initial_potential_add_noise`; those package other
algorithm-level windows, while the target file already has the exact scalar
specialization `sum_weighted_sub_le_first_of_forward_mono_beforeMaster`, which
this helper applies to the expected SGS Bregman sequence. -/
private theorem theorem82_forward_bregman_drop_expectation_le_initial_preSourceTyped
    [MeasurableSpace Ω] [MeasurableSpace Sample] [MeasurableSpace E] [BorelSpace E]
    (law : SGSProbabilityModel (Ω := Ω) S) (x0 uStar : FeasiblePoint S)
    (beta gamma Gamma : PositiveTime → ℝ) (T : PositiveTime → ℕ)
    (N : PositiveTime) (states : ℕ → Ω → SGSState S)
    (hinitial : ∀ ω, states 0 ω = sgsInitial S x0)
    (hbeta : ∀ k : PositiveTime, 0 < beta k)
    (hgamma : gammaRangeCondition gamma)
    (hlower : outerLowerBoundCondition S beta gamma)
    (hGamma : outerWeightCondition gamma Gamma)
    (hmono : forwardMonotonicityCondition beta gamma Gamma T)
    (hTpos : ∀ k : PositiveTime, 0 < T k)
    (hGamma_pos : ∀ k : PositiveTime, 0 < Gamma k) :
    let c : ℕ → ℝ := fun n =>
      if hn : 1 ≤ n then
        gamma ⟨n, hn⟩ * beta ⟨n, hn⟩ /
          (Gamma ⟨n, hn⟩ *
            (1 - psWeightProduct spsP (T ⟨n, hn⟩)))
      else 0;
    let V : ℕ → ℝ := fun n =>
      ∫ ω, bregmanFormulaOnX S (states n ω).x uStar ∂law.P;
    Finset.sum (Finset.Icc 1 N.1) (fun t => c t * (V (t - 1) - V t)) ≤
      beta oneTime * (1 - psWeightProduct spsP (T oneTime))⁻¹ *
        bregmanFormulaOnX S x0 uStar := by
  classical
  haveI : IsProbabilityMeasure law.P := law.isProbability
  intro c V
  have hV_nonneg_window : ∀ n, 1 ≤ n → n ≤ N.1 → 0 ≤ V n := by
    intro n _hn _hnN
    have hpoint : ∀ ω, 0 ≤ bregmanFormulaOnX S (states n ω).x uStar := by
      intro ω
      have hB := bregmanFormulaOnX_lower_bound_from_prox_geometry S (states n ω).x uStar
      have hsq : 0 ≤ S.primalNorm (uStar.1 - (states n ω).x.1) ^ 2 := sq_nonneg _
      nlinarith
    simpa [V] using (integral_nonneg hpoint : 0 ≤ ∫ ω,
      bregmanFormulaOnX S (states n ω).x uStar ∂law.P)
  have hc_mono : ∀ n, 1 ≤ n → n < N.1 → c (n + 1) ≤ c n := by
    intro n hn _hnN
    have h :=
      forwardMonotonicity_nat_coeff_mono_beforeMaster beta gamma Gamma T hmono n hn
    simpa [c, hn] using h
  have hc_nonneg : ∀ n, 1 ≤ n → 0 ≤ c n := by
    intro n hn
    let κ : PositiveTime := ⟨n, hn⟩
    have hOneSub : 0 < 1 - psWeightProduct spsP (T κ) :=
      one_sub_psWeightProduct_spsP_pos_of_pos (hTpos κ)
    have hden : 0 < Gamma κ * (1 - psWeightProduct spsP (T κ)) :=
      mul_pos (hGamma_pos κ) hOneSub
    have hnum : 0 ≤ gamma κ * beta κ :=
      mul_nonneg (hgamma κ).1 (le_of_lt (hbeta κ))
    have hcκ :
        0 ≤ gamma κ * beta κ /
          (Gamma κ * (1 - psWeightProduct spsP (T κ))) :=
      div_nonneg hnum (le_of_lt hden)
    simpa [c, κ, hn] using hcκ
