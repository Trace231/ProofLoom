          ⟪δ, uStar.1 - (inner κ i ω).u.1⟫_ℝ)) ?_ ?_ ?_
    · intro i _hi
      let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩
      have hquad_part :
          Integrable
            (fun ω =>
              (S.mGrowth ^ 2 +
                  dualNorm S
                    (oracleNoiseAt S (sgsGeneratedOracleQuery S inner κ i ω)
