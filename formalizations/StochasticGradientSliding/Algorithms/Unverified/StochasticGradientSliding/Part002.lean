      inv_nonneg.mpr (le_of_lt (mul_pos (hbeta κ) hspsP_pos))
    simpa [ι] using
      theorem82_expected_single_noise_bracket_le_preSourceTyped
        (μ := law.P) (M := S.mGrowth ^ 2) (σ := S.sigmaSq)
        (betaP := beta κ * spsP ι)
