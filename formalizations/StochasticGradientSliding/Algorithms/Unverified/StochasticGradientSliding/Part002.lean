          dualNorm S
            (oracleNoiseAt S (sgsGeneratedOracleQuery S inner κ i ω)
              (law.sample κ i ω)) ^ 2)
        (lin := fun ω =>
          ⟪oracleNoiseAt S (sgsGeneratedOracleQuery S inner κ i ω)
