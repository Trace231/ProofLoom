    sps_source_bregman_young_absorption_before_stability
      (a := β * spsP ι) (b := S.mGrowth + dualNorm S δ)
      (V := bregmanFormulaOnX S prev next)
      (r := S.primalNorm (next.1 - prev.1)) ha hr hV
