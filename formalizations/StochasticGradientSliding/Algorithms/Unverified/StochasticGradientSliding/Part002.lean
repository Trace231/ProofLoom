/-- Convexity in the second argument of the feasible Bregman formula.

Aligns with the convexity part of Lan Proposition 8.3 after replacing the
source-typed `V : X^o × X` by the formula-extension kernel on `X × X`.
Candidate audit: considered source helper `bregmanOn_right_convexOn_totalized`
and SOptLib carrier Bregman formula lemmas; the source helper requires a
`ProxCorePoint`, while the SOptLib lemmas expose formula/derivative bridges
rather than this paper-local `Setup` specialization with `boundarySafeCarrierGradient`. -/
theorem bregmanFormulaOnX_right_convexOn_totalized (x : FeasiblePoint S) :
    ConvexOn ℝ S.X
      (SOptLib.carrierTotalizeOn S.X
        (fun z : FeasiblePoint S => bregmanFormulaOnX S x z)) := by
  classical
  letI : FiniteDimensional ℝ E := S.finiteDimensional_ambient
  rcases S.prox_geometry with
    ⟨_hcont, _hdiffX, _hcore_convex, _hdiffCore, hnu_conv, _hstrong⟩
  refine ⟨S.convex_X, ?_⟩
  intro y hy z hz α η hα hη hsum
  have hseg : α • y + η • z ∈ S.X :=
    S.convex_X hy hz hα hη hsum
  have hnu :
      S.proxPotential (α • y + η • z) ≤
        α * S.proxPotential y + η * S.proxPotential z := by
    simpa [smul_eq_mul] using hnu_conv.2 hy hz hα hη hsum
  have hvec :
      α • y + η • z - x.1 = α • (y - x.1) + η • (z - x.1) := by
    have hx : x.1 = α • x.1 + η • x.1 := by
      rw [← add_smul, hsum, one_smul]
    calc
      α • y + η • z - x.1 = α • y + η • z - (α • x.1 + η • x.1) := by
        conv_lhs => rw [hx]
      _ = α • (y - x.1) + η • (z - x.1) := by
        module
  have hinner :
      ⟪boundarySafeCarrierGradient S.X S.proxPotential x,
          α • y + η • z - x.1⟫_ℝ =
        α * ⟪boundarySafeCarrierGradient S.X S.proxPotential x, y - x.1⟫_ℝ +
          η * ⟪boundarySafeCarrierGradient S.X S.proxPotential x, z - x.1⟫_ℝ := by
    rw [hvec]
    simp [inner_add_right, inner_smul_right]
  have hVraw :
      S.proxPotential (α • y + η • z) - S.proxPotential x.1 -
          ⟪boundarySafeCarrierGradient S.X S.proxPotential x,
            α • y + η • z - x.1⟫_ℝ ≤
        α * (S.proxPotential y - S.proxPotential x.1 -
            ⟪boundarySafeCarrierGradient S.X S.proxPotential x, y - x.1⟫_ℝ) +
          η * (S.proxPotential z - S.proxPotential x.1 -
            ⟪boundarySafeCarrierGradient S.X S.proxPotential x, z - x.1⟫_ℝ) := by
    calc
      S.proxPotential (α • y + η • z) - S.proxPotential x.1 -
          ⟪boundarySafeCarrierGradient S.X S.proxPotential x,
            α • y + η • z - x.1⟫_ℝ
          =
        S.proxPotential (α • y + η • z) - S.proxPotential x.1 -
          (α * ⟪boundarySafeCarrierGradient S.X S.proxPotential x, y - x.1⟫_ℝ +
            η * ⟪boundarySafeCarrierGradient S.X S.proxPotential x, z - x.1⟫_ℝ) := by
            rw [hinner]
      _ ≤
        α * S.proxPotential y + η * S.proxPotential z - S.proxPotential x.1 -
          (α * ⟪boundarySafeCarrierGradient S.X S.proxPotential x, y - x.1⟫_ℝ +
            η * ⟪boundarySafeCarrierGradient S.X S.proxPotential x, z - x.1⟫_ℝ) := by
            nlinarith [hnu]
      _ =
        α * (S.proxPotential y - S.proxPotential x.1 -
            ⟪boundarySafeCarrierGradient S.X S.proxPotential x, y - x.1⟫_ℝ) +
          η * (S.proxPotential z - S.proxPotential x.1 -
            ⟪boundarySafeCarrierGradient S.X S.proxPotential x, z - x.1⟫_ℝ) := by
            have hconst :
                S.proxPotential x.1 =
                  α * S.proxPotential x.1 + η * S.proxPotential x.1 := by
              calc
                S.proxPotential x.1 = (α + η) * S.proxPotential x.1 := by
                  rw [hsum]
                  ring
                _ = α * S.proxPotential x.1 + η * S.proxPotential x.1 := by
                  ring
            nlinarith [hconst]
  simpa [SOptLib.carrierTotalizeOn, hseg, hy, hz,
    bregmanFormulaOnX_boundary_carrier_formula S x ⟨α • y + η • z, hseg⟩,
    bregmanFormulaOnX_boundary_carrier_formula S x ⟨y, hy⟩,
    bregmanFormulaOnX_boundary_carrier_formula S x ⟨z, hz⟩] using hVraw

