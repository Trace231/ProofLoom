    [MeasurableSpace Ω] [MeasurableSpace Sample] [MeasurableSpace E] [BorelSpace E]
    (law : SGSProbabilityModel (Ω := Ω) S) (uStar : FeasiblePoint S)
    (inner : PositiveTime → ℕ → Ω → SPSState S)
    (hindep : sfoIndependent S law.P law.sample (sgsGeneratedOracleQuery S inner))
    (hdet : coordinateSFOLightTailDeterministic S law.P law.sample)
    (hcompact : IsCompact S.X)
    (k : PositiveTime) (i : ℕ)
    (hadapted :
      Measurable[sgsStrictPastSampleSpace (Ω := Ω) law.sample k i]
        (fun ω =>
          (⟨sgsGeneratedOracleQuery S inner k i ω,
            (Classical.choose hindep) k i ω⟩ : FeasiblePoint S))) :
    let ζ : Ω → ℝ := fun ω =>
      ⟪oracleNoiseAt S (sgsGeneratedOracleQuery S inner k i ω)
          (law.sample k i ω),
        uStar.1 - sgsGeneratedOracleQuery S inner k i ω⟫_ℝ
    let lightScale : ℝ :=
      2 * bregmanEnvelope_formulaExtension S uStar hcompact * S.sigmaSq
    Integrable (fun ω => Real.exp (ζ ω ^ 2 / lightScale)) law.P ∧
      law.P[(fun ω => Real.exp (ζ ω ^ 2 / lightScale)) |
            sgsStrictPastSampleSpace (Ω := Ω) law.sample k i] ≤ᵐ[law.P]
        fun _ => Real.exp 1 := by
  classical
  letI : FiniteDimensional ℝ E := S.finiteDimensional_ambient
  let queryFP : Ω → FeasiblePoint S :=
    fun ω =>
      ⟨sgsGeneratedOracleQuery S inner k i ω,
        (Classical.choose hindep) k i ω⟩
  have hpast_le :
      sgsStrictPastSampleSpace (Ω := Ω) law.sample k i ≤
        (by infer_instance : MeasurableSpace Ω) := by
    simpa using
      sgsStrictPastSampleSpace_le (Ω := Ω) law.sample law.sample_measurable k i
  have hquery_meas : Measurable queryFP := hadapted.mono hpast_le le_rfl
  have hcurrent_indep : IndepFun queryFP (law.sample k i) law.P :=
    sgsStrictPast_adapted_indep_current_sample (S := S) law k i hadapted
  rcases Seminorm.exists_norm_le_mul_self_of_finiteDimensional_separating
      S.primalNorm (primalNorm_isSeparating S) with ⟨C, hC_nonneg, hC⟩
  have hdual_meas : Measurable (fun z : E => dualNorm S z) := by
    have hunit : ∀ x : E, S.primalNorm x ≤ 1 → ‖x‖ ≤ C := by
      intro x hx
      have hmul : C * S.primalNorm x ≤ C * 1 :=
        mul_le_mul_of_nonneg_left hx hC_nonneg
      exact (hC x).trans (by simpa using hmul)
    simpa [dualNorm] using
      (SOptLib.canonicalDualNorm_continuous
        (p := S.primalNorm) (C := C) hunit).measurable
  let R : FeasiblePoint S → Sample → Prop :=
    fun u xi => dualNorm S (oracleNoiseAt S u.1 xi) = 0
  have hR : MeasurableSet {p : FeasiblePoint S × Sample | R p.1 p.2} := by
    have hnoise :
        Measurable (fun p : FeasiblePoint S × Sample =>
          dualNorm S (oracleNoiseAt S p.1.1 p.2)) :=
      hdual_meas.comp law.oracle_residual_measurable
    simpa [R] using zero_noise_event_measurable_of_noise_norm_measurable
      (S := S) hnoise
  haveI : IsProbabilityMeasure (Measure.map (law.sample k i) law.P) :=
    Measure.isProbabilityMeasure_map (law.sample_measurable k i).aemeasurable
  have hfixed_ae :
      ∀ u : FeasiblePoint S,
        ∀ᵐ xi ∂Measure.map (law.sample k i) law.P, R u xi := by
    intro u
    have hRu : MeasurableSet {xi : Sample | R u xi} := by
      have hpair : Measurable (fun xi : Sample => (u, xi)) :=
        (measurable_const : Measurable (fun _ : Sample => u)).prod measurable_id
      simpa [R] using hR.preimage hpair
    exact (ae_map_iff (law.sample_measurable k i).aemeasurable hRu).mpr
      (by simpa [R, oracleNoiseDualNorm, oracleNoiseAt] using hdet.2 k i u.1 u.2)
  have hzero_dual :
      ∀ᵐ ω ∂law.P,
        dualNorm S
          (oracleNoiseAt S (sgsGeneratedOracleQuery S inner k i ω)
            (law.sample k i ω)) = 0 := by
    simpa [R, queryFP] using
      ae_comp_of_indep_fixed_ae
        (P := law.P) (ν := Measure.map (law.sample k i) law.P) (R := R)
        (X := queryFP) (Y := law.sample k i) hR hquery_meas
        (law.sample_measurable k i) hcurrent_indep rfl hfixed_ae
  have hζ_zero :
      (fun ω =>
        ⟪oracleNoiseAt S (sgsGeneratedOracleQuery S inner k i ω)
            (law.sample k i ω),
          uStar.1 - sgsGeneratedOracleQuery S inner k i ω⟫_ℝ) =ᵐ[law.P]
        fun _ => 0 := by
    filter_upwards [hzero_dual] with ω hzero
    have habs :=
      abs_inner_le_dualNorm_mul_primalNorm S
        (oracleNoiseAt S (sgsGeneratedOracleQuery S inner k i ω)
          (law.sample k i ω))
        (uStar.1 - sgsGeneratedOracleQuery S inner k i ω)
    have hle0 :
        |⟪oracleNoiseAt S (sgsGeneratedOracleQuery S inner k i ω)
            (law.sample k i ω),
          uStar.1 - sgsGeneratedOracleQuery S inner k i ω⟫_ℝ| ≤ 0 := by
      simpa [hzero] using habs
    have habs0 :
        |⟪oracleNoiseAt S (sgsGeneratedOracleQuery S inner k i ω)
            (law.sample k i ω),
          uStar.1 - sgsGeneratedOracleQuery S inner k i ω⟫_ℝ| = 0 :=
      le_antisymm hle0 (abs_nonneg _)
    exact abs_eq_zero.mp habs0
  have hf_eq_one :
      (fun ω =>
        Real.exp
          ((⟪oracleNoiseAt S (sgsGeneratedOracleQuery S inner k i ω)
                (law.sample k i ω),
              uStar.1 - sgsGeneratedOracleQuery S inner k i ω⟫_ℝ) ^ 2 /
            (2 * bregmanEnvelope_formulaExtension S uStar hcompact * S.sigmaSq))) =ᵐ[law.P]
        fun _ => (1 : ℝ) := by
    filter_upwards [hζ_zero] with ω hζ
    simp [hζ]
  have hcond_eq :
      law.P[(fun ω =>
        Real.exp
          ((⟪oracleNoiseAt S (sgsGeneratedOracleQuery S inner k i ω)
                (law.sample k i ω),
              uStar.1 - sgsGeneratedOracleQuery S inner k i ω⟫_ℝ) ^ 2 /
            (2 * bregmanEnvelope_formulaExtension S uStar hcompact * S.sigmaSq))) |
          sgsStrictPastSampleSpace (Ω := Ω) law.sample k i] =ᵐ[law.P]
        law.P[(fun _ : Ω => (1 : ℝ)) |
          sgsStrictPastSampleSpace (Ω := Ω) law.sample k i] :=
    MeasureTheory.condExp_congr_ae (m := sgsStrictPastSampleSpace (Ω := Ω) law.sample k i)
      hf_eq_one
  have hconst :
      law.P[(fun _ : Ω => (1 : ℝ)) |
          sgsStrictPastSampleSpace (Ω := Ω) law.sample k i] =
        fun _ : Ω => (1 : ℝ) :=
    MeasureTheory.condExp_const
      (μ := law.P) (m := sgsStrictPastSampleSpace (Ω := Ω) law.sample k i)
      hpast_le (1 : ℝ)
  refine ⟨?_, ?_⟩
  · exact (integrable_const (1 : ℝ)).congr hf_eq_one.symm
  · filter_upwards [hcond_eq] with ω hω
    rw [hω, hconst]
    simpa using (Real.exp_le_exp.mpr zero_le_one : Real.exp 0 ≤ Real.exp 1)

/-- Part002-local conditional exponential-square leaf for the linear MDS
increment.

Candidate audit: searched Part002/SOptLib for this strict-past conditional
light-tail interface.  Existing `generatedSFOLightTail` gives only
unconditional generated-query moments, while downstream Part003 has the
matching theorem but cannot be imported here.  This helper consumes
strict-past adaptedness, current-sample freshness, Lan Eq. (8.1.57), and the
compact Bregman envelope scalar domination required by Theorem 8.2 step 3. -/
private theorem theorem82_part002_linear_tail_condExp_light_of_strictPast_adapted
    [MeasurableSpace Ω] [MeasurableSpace Sample] [MeasurableSpace E] [BorelSpace E]
    (law : SGSProbabilityModel (Ω := Ω) S) (uStar : FeasiblePoint S)
    (inner : PositiveTime → ℕ → Ω → SPSState S)
    (hindep : sfoIndependent S law.P law.sample (sgsGeneratedOracleQuery S inner))
    (hcoordinate_light : coordinateSFOLightTail S law.P law.sample)
    (hcompact : IsCompact S.X)
    (k : PositiveTime) (i : ℕ)
    (hadapted :
      Measurable[sgsStrictPastSampleSpace (Ω := Ω) law.sample k i]
        (fun ω =>
          (⟨sgsGeneratedOracleQuery S inner k i ω,
            (Classical.choose hindep) k i ω⟩ : FeasiblePoint S))) :
    let ζ : Ω → ℝ := fun ω =>
      ⟪oracleNoiseAt S (sgsGeneratedOracleQuery S inner k i ω)
          (law.sample k i ω),
        uStar.1 - sgsGeneratedOracleQuery S inner k i ω⟫_ℝ
    let lightScale : ℝ :=
      2 * bregmanEnvelope_formulaExtension S uStar hcompact * S.sigmaSq
    Integrable (fun ω => Real.exp (ζ ω ^ 2 / lightScale)) law.P ∧
      law.P[(fun ω => Real.exp (ζ ω ^ 2 / lightScale)) |
            sgsStrictPastSampleSpace (Ω := Ω) law.sample k i] ≤ᵐ[law.P]
        fun _ => Real.exp 1 := by
  classical
  let queryFP : Ω → FeasiblePoint S :=
    fun ω =>
      ⟨sgsGeneratedOracleQuery S inner k i ω,
        (Classical.choose hindep) k i ω⟩
  have hpast_le :
      sgsStrictPastSampleSpace (Ω := Ω) law.sample k i ≤
        (by infer_instance : MeasurableSpace Ω) := by
    simpa using
      sgsStrictPastSampleSpace_le (Ω := Ω) law.sample law.sample_measurable k i
  have hquery_meas : Measurable queryFP := hadapted.mono hpast_le le_rfl
  have hcurrent_indep : IndepFun queryFP (law.sample k i) law.P :=
    sgsStrictPast_adapted_indep_current_sample (S := S) law k i hadapted
  have hcurrent_indep_set :
      ∀ s : Set Ω,
        @MeasurableSet Ω (sgsStrictPastSampleSpace (Ω := Ω) law.sample k i) s →
        IndepFun (fun ω => (s.indicator (fun _ => (1 : ℝ)) ω, queryFP ω))
          (law.sample k i) law.P := by
    intro s hs
    have hindicator :
        Measurable[sgsStrictPastSampleSpace (Ω := Ω) law.sample k i]
          (s.indicator (fun _ : Ω => (1 : ℝ))) :=
      measurable_const.indicator hs
    have hpair_past :
        Measurable[sgsStrictPastSampleSpace (Ω := Ω) law.sample k i]
          (fun ω => (s.indicator (fun _ : Ω => (1 : ℝ)) ω, queryFP ω)) :=
      hindicator.prod hadapted
    exact sgsStrictPast_adapted_indep_current_sample
      (S := S) law k i hpair_past
  rcases hcoordinate_light with hcoord_pos | hcoord_det
  · have hpositive_meas :
        Measurable (fun p : FeasiblePoint S × Sample =>
          Real.exp (lightTailExponent S
            (dualNorm S (oracleNoiseAt S p.1.1 p.2) ^ 2))) :=
      theorem82_part002_oracle_light_tail_exp_measurable_of_residual_measurable
        (S := S) law.oracle_residual_measurable
    have hpositive_int :
        Integrable
          (fun ω =>
            Real.exp (lightTailExponent S
              (dualNorm S
                (oracleNoiseAt S (queryFP ω).1 (law.sample k i ω)) ^ 2)))
          law.P :=
      theorem82_part002_generated_query_light_tail_exp_integrable_of_coordinate_positive
        (S := S) law.P law.sample law.sample_measurable queryFP k i
        hquery_meas hcurrent_indep hpositive_meas hcoord_pos
    have hsource_cond :
        law.P[(fun ω =>
              Real.exp (lightTailExponent S
                (dualNorm S (oracleNoiseAt S (queryFP ω).1 (law.sample k i ω)) ^ 2))) |
              sgsStrictPastSampleSpace (Ω := Ω) law.sample k i] ≤ᵐ[law.P]
          fun _ => Real.exp 1 := by
      simpa [queryFP] using
        theorem82_part002_coordinate_light_tail_condExp_bound_of_strictPast_indep
          (S := S) law queryFP k i hpast_le hquery_meas hcurrent_indep_set
          hpositive_meas hpositive_int
          hcoord_pos
    have hscalar_le :
        (fun ω =>
          Real.exp
            ((⟪oracleNoiseAt S (sgsGeneratedOracleQuery S inner k i ω)
                  (law.sample k i ω),
                uStar.1 - sgsGeneratedOracleQuery S inner k i ω⟫_ℝ) ^ 2 /
              (2 * bregmanEnvelope_formulaExtension S uStar hcompact * S.sigmaSq))) ≤ᵐ[law.P]
          fun ω =>
            Real.exp (lightTailExponent S
              (dualNorm S
                (oracleNoiseAt S (queryFP ω).1 (law.sample k i ω)) ^ 2)) := by
      refine Filter.Eventually.of_forall ?_
      intro ω
      have henv_nonneg :
          0 ≤ bregmanEnvelope_formulaExtension S uStar hcompact :=
        theorem82_part002_bregmanEnvelope_formulaExtension_nonneg S uStar hcompact
      have hdisp :
          S.primalNorm (uStar.1 - (queryFP ω).1) ^ 2 ≤
            2 * bregmanEnvelope_formulaExtension S uStar hcompact :=
        theorem82_part002_primal_displacement_sq_le_two_bregmanEnvelope_formulaExtension
          S uStar (queryFP ω) hcompact
      simpa [queryFP] using
        theorem82_part002_linear_tail_scalar_exp_le_oracle_exp_of_envelope_nonneg
          (S := S) uStar (queryFP ω) hcompact
          (oracleNoiseAt S (sgsGeneratedOracleQuery S inner k i ω)
            (law.sample k i ω))
          hcoord_pos.1 henv_nonneg hdisp
    have hleft_int :
        Integrable
          (fun ω =>
            Real.exp
              ((⟪oracleNoiseAt S (sgsGeneratedOracleQuery S inner k i ω)
                  (law.sample k i ω),
                  uStar.1 - sgsGeneratedOracleQuery S inner k i ω⟫_ℝ) ^ 2 /
                (2 * bregmanEnvelope_formulaExtension S uStar hcompact * S.sigmaSq)))
          law.P := by
      have hpair_meas :
          Measurable (fun ω => (queryFP ω, law.sample k i ω)) :=
        hquery_meas.prod (law.sample_measurable k i)
      have hinner_meas :
          Measurable (fun ω =>
            ⟪oracleNoiseAt S (sgsGeneratedOracleQuery S inner k i ω)
                (law.sample k i ω),
              uStar.1 - sgsGeneratedOracleQuery S inner k i ω⟫_ℝ) :=
        by
          have htarget :=
            oracle_residual_target_inner_measurable_of_residual_measurable
              (S := S) (x := uStar) law.oracle_residual_measurable
          simpa [queryFP, real_inner_comm] using htarget.comp hpair_meas
      have hleft_meas :
          Measurable
            (fun ω =>
              Real.exp
                ((⟪oracleNoiseAt S (sgsGeneratedOracleQuery S inner k i ω)
                      (law.sample k i ω),
                    uStar.1 - sgsGeneratedOracleQuery S inner k i ω⟫_ℝ) ^ 2 /
                  (2 * bregmanEnvelope_formulaExtension S uStar hcompact *
                    S.sigmaSq))) := by
        have hsq :
            Measurable
              (fun ω =>
                (⟪oracleNoiseAt S (sgsGeneratedOracleQuery S inner k i ω)
                    (law.sample k i ω),
                  uStar.1 - sgsGeneratedOracleQuery S inner k i ω⟫_ℝ) ^ 2) := by
          simpa [pow_two] using hinner_meas.mul hinner_meas
        exact Real.measurable_exp.comp
          (hsq.div_const
            (2 * bregmanEnvelope_formulaExtension S uStar hcompact * S.sigmaSq))
      refine Integrable.mono hpositive_int hleft_meas.aestronglyMeasurable ?_
      filter_upwards [hscalar_le] with ω hle
      rw [Real.norm_eq_abs, Real.norm_eq_abs]
      rw [abs_of_nonneg (Real.exp_nonneg _), abs_of_nonneg (Real.exp_nonneg _)]
      exact hle
    have hright_int :
        Integrable
          (fun ω =>
            Real.exp (lightTailExponent S
              (dualNorm S
                (oracleNoiseAt S (queryFP ω).1 (law.sample k i ω)) ^ 2)))
          law.P := by
      exact hpositive_int
    have hcond_mono :=
      MeasureTheory.condExp_mono
        (m := sgsStrictPastSampleSpace (Ω := Ω) law.sample k i)
        hleft_int hright_int hscalar_le
    exact ⟨hleft_int, by simpa [queryFP] using hcond_mono.trans hsource_cond⟩
  · simpa [queryFP] using
      theorem82_part002_linear_tail_condExp_light_deterministic_of_zero_noise
        (S := S) law uStar inner hindep hcoord_det hcompact k i hadapted

/-- Internal prox-core supremum envelope.

This is not the paper object `\bar V`, because the source text states
`max_{x∈X} V(x,u)` rather than an `sSup` over the Section 3.2 prox-core.  It is
retained only as a domain-bridge helper for future proof work. -/
noncomputable def proxCoreBregmanEnvelope (u : FeasiblePoint S) : ℝ :=
  sSup (Set.range fun x : ProxCorePoint S => bregmanOn S x u)

/-- The internal prox-core envelope is the least upper bound of `V(x,u)` over
`X^o`, under the standard real `sSup` side conditions. -/
theorem proxCoreBregmanEnvelope_isLUB (u : FeasiblePoint S)
    (hne : (Set.range fun x : ProxCorePoint S => bregmanOn S x u).Nonempty)
    (hbdd : BddAbove (Set.range fun x : ProxCorePoint S => bregmanOn S x u)) :
    IsLUB (Set.range fun x : ProxCorePoint S => bregmanOn S x u)
      (proxCoreBregmanEnvelope S u) := by
  unfold proxCoreBregmanEnvelope
  refine ⟨?_, ?_⟩
  · intro y hy
    exact le_csSup hbdd hy
  · intro z hz
    exact csSup_le hne hz

/-- Domain condition needed to read the paper's displayed
`\bar V(u)=max_{x∈X}V(x,u)` literally with the Section 3.2 type
`V : X^o × X → R_+`.

This is not a source assumption.  It records the source-boundary gap: the PDF
maximizes over `x ∈ X`, while its earlier definition of `V` requires the first
argument to lie in `X^o`. -/
def bregmanEnvelopeSourceDomainResolved : Prop :=
  ∀ x : FeasiblePoint S, x.1 ∈ proxCore S.X S.proxPotential

/-- Maximum-attainment obligation for the source-typed envelope, conditional on
resolving the PDF's `x ∈ X` versus `x ∈ X^o` boundary.

Checked SOptLib `bregmanValueSet` and `bregmanDiameterSq`: they model a two-sided
carrier diameter over a homogeneous carrier, while the paper fixes `u` and varies
only the first argument of a heterogeneously typed `V : X^o × X → R_+`. -/
theorem bregmanEnvelope_sourceTyped_max_exists_obligation (u : FeasiblePoint S)
    (hcompact : IsCompact S.X) (hdomain : bregmanEnvelopeSourceDomainResolved S) :
    ∃ xMax : FeasiblePoint S,
      ∀ x : FeasiblePoint S,
        bregmanOn S ⟨x.1, hdomain x⟩ u ≤ bregmanOn S ⟨xMax.1, hdomain xMax⟩ u := by
  classical
  let f : FeasiblePoint S → ℝ := fun x => bregmanOn S ⟨x.1, hdomain x⟩ u
  have hcompact_feasible : IsCompact (Set.univ : Set (FeasiblePoint S)) := by
    simpa using (isCompact_iff_isCompact_univ.mp hcompact)
  have htoCore :
      Continuous (fun x : FeasiblePoint S => (⟨x.1, hdomain x⟩ : ProxCorePoint S)) := by
    exact Continuous.subtype_mk
      (by
        simpa using
          (continuous_subtype_val :
            Continuous (fun x : FeasiblePoint S => (x : E))))
      (fun x => hdomain x)
  have hcont : Continuous f := by
    simpa [f] using
      (bregmanOn_left_section_continuous (S := S) u).comp htoCore
  have hne : (Set.univ : Set (FeasiblePoint S)).Nonempty := ⟨u, by simp⟩
  rcases hcompact_feasible.exists_isMaxOn hne hcont.continuousOn with
    ⟨xMax, _hxMax, hxMax⟩
  refine ⟨xMax, ?_⟩
  intro x
  simpa [f] using (isMaxOn_iff.mp hxMax) x (by simp)

/-- Conditional source-domain reading of the displayed envelope
`\bar V(u)=max_{x∈X}V(x,u)`.

Under `hdomain`, every feasible maximization center is source-admissible, so the
envelope is the least upper bound of the Section 3.2 source kernel
`bregmanOn : X^o × X → ℝ` over the displayed feasible centers.  The bridge to the
feasible formula-extension envelope is kept as a separate theorem below; this
definition deliberately does not alias the all-feasible fallback kernel. -/
noncomputable def bregmanEnvelope_sourceTyped (u : FeasiblePoint S)
    (hcompact : IsCompact S.X) (hdomain : bregmanEnvelopeSourceDomainResolved S) : ℝ :=
  sSup (Set.range fun x : FeasiblePoint S => bregmanOn S ⟨x.1, hdomain x⟩ u)

/-- The source-typed envelope maximizes the Section 3.2 Bregman function over the
displayed feasible set after the domain boundary is resolved. -/
theorem bregmanEnvelope_sourceTyped_isMax (u : FeasiblePoint S)
    (hcompact : IsCompact S.X) (hdomain : bregmanEnvelopeSourceDomainResolved S) :
    ∀ x : FeasiblePoint S,
      bregmanOn S ⟨x.1, hdomain x⟩ u ≤
        bregmanEnvelope_sourceTyped S u hcompact hdomain := by
  intro x
  rcases bregmanEnvelope_sourceTyped_max_exists_obligation S u hcompact hdomain with
    ⟨xMax, hmax⟩
  have hbdd :
      BddAbove
        (Set.range fun x : FeasiblePoint S => bregmanOn S ⟨x.1, hdomain x⟩ u) :=
    ⟨bregmanOn S ⟨xMax.1, hdomain xMax⟩ u, by
      rintro y ⟨x, rfl⟩
      exact hmax x⟩
  simpa [bregmanEnvelope_sourceTyped] using
    (le_csSup hbdd (Set.mem_range_self x))

/-- Public source-typed compact-envelope domination bridge.

This is the formal correction boundary for the paper's displayed
`\bar V(u)=max_{x in X} V(x,u)`: once the Section 3.2 domain mismatch is
resolved by `bregmanEnvelopeSourceDomainResolved`, the bound uses the canonical
`bregmanOn : X^o x X -> R` envelope and no longer depends on the all-feasible
formula-extension `sSup` max obligation. -/
theorem bregmanEnvelope_sourceTyped_domination (u : FeasiblePoint S)
    (hcompact : IsCompact S.X) (hdomain : bregmanEnvelopeSourceDomainResolved S) :
    ∀ x : FeasiblePoint S,
      bregmanOn S ⟨x.1, hdomain x⟩ u ≤
        bregmanEnvelope_sourceTyped S u hcompact hdomain :=
  bregmanEnvelope_sourceTyped_isMax S u hcompact hdomain

/-- Source-typed generic expected bound `\tilde B_d(N)` for the original
Section 3.2 Bregman domain.

Book/PDF citations: Theorem 8.2 Eq. (8.1.66) displays the first term with
`V(x_0,x^*)`; Section 3.2 Eq. (3.2.2) types `V : X^o × X → R_+`.  No SOptLib
match: the available telescope/budget helpers consume already-formed scalar
bounds, while this declaration names the paper's concrete SGS bound with the
heterogeneous `X^o × X` Bregman object. -/
noncomputable def genericExpectedBound_sourceTyped (x0 : ProxCorePoint S)
    (xStar : FeasiblePoint S) (N : PositiveTime)
    (beta gamma Gamma : PositiveTime → ℝ) (T : PositiveTime → ℕ) : ℝ :=
  Gamma N * beta oneTime * (1 - psWeightProduct spsP (T oneTime))⁻¹ *
      bregmanOn S x0 xStar +
    Gamma N *
      (Finset.range N.1).sum (fun k =>
        let κ : PositiveTime := ⟨k + 1, Nat.succ_pos k⟩;
        (Finset.range (T κ)).sum (fun i =>
          let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
          (S.mGrowth ^ 2 + S.sigmaSq) * gamma κ * psWeightProduct spsP (T κ) /
            (beta κ * Gamma κ * (1 - psWeightProduct spsP (T κ)) *
              spsP ι ^ 2 * psWeightProduct spsP i)))

/-- Conditional source-typed high-probability scale `\tilde B_p(N)` for
Theorem 8.2.

This is not part of the active public theorem surface: it records what the
source-typed probability scale becomes after the explicit envelope domain bridge
`bregmanEnvelopeSourceDomainResolved` is supplied.  The active public compact
boundary remains `genericProbabilityScale_formulaExtension`. -/
noncomputable def genericProbabilityScale_sourceTyped (xStar : FeasiblePoint S)
    (hcompact : IsCompact S.X) (hdomain : bregmanEnvelopeSourceDomainResolved S)
    (N : PositiveTime)
