              bregCoeff t * (expectedBregman (t - 1) - expectedBregman t) +
                (if ht : 1 ≤ t then
                  let κ : PositiveTime := ⟨t, ht⟩
                  gamma κ * psWeightProduct spsP (T κ) /
                    (Gamma κ * (1 - psWeightProduct spsP (T κ))) *
                    (∫ ω,
                      (Finset.range (T κ)).sum (fun i =>
                        let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
                        let δ := oracleNoiseAt S ((inner κ i ω).u.1)
                          (law.sample κ i ω);
                        (spsP ι * psWeightProduct spsP i)⁻¹ *
                          (((S.mGrowth + dualNorm S δ) ^ 2) /
                              (2 * beta κ * spsP ι) +
                            ⟪δ, uStar.1 - (inner κ i ω).u.1⟫_ℝ)) ∂law.P)
                else 0) := by
        intro t htmem
        have ht1 : 1 ≤ t := (Finset.mem_Icc.mp htmem).1
        have htN : t ≤ N.1 := (Finset.mem_Icc.mp htmem).2
        simpa [rawStep, ht1] using hcompact_step_split_expected t ht1 htN
      dsimp [telescopedRHS]
      rw [hGamma_if]
      rw [← mul_add]
      apply congrArg (fun z : ℝ => Gamma N * z)
      dsimp [bregmanDropWindow]
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl ?_
      intro t htmem
      exact hIcc_step_split t htmem
    calc
      telescopedRHS
          = Gamma N * bregmanDropWindow +
              Gamma N * (∫ ω, rawOuterNoise ω ∂law.P) := hraw_split
      _ ≤ Gamma N * bregmanDropWindow +
            Gamma N * (∫ ω, relaxedOuterNoise ω ∂law.P) := by
        simpa [add_comm, add_left_comm, add_assoc] using
          add_le_add_left
            (mul_le_mul_of_nonneg_left hraw_integral_le (le_of_lt (hGamma_pos N)))
            (Gamma N * bregmanDropWindow)
  have hbudget_assembled :
      Gamma N * bregmanDropWindow +
          Gamma N * (∫ ω, relaxedOuterNoise ω ∂law.P) ≤
        Gamma N * initialBregmanBudget + Gamma N * deterministicNoiseBudget := by
    have hbreg_scaled :
        Gamma N * bregmanDropWindow ≤ Gamma N * initialBregmanBudget :=
      mul_le_mul_of_nonneg_left hbregman_drop_bound (le_of_lt (hGamma_pos N))
    nlinarith [hbreg_scaled, hnoise_scaled]
  have hleft_rewrite :
      (∫ ω, objectiveOn S (sgsGeneratedOutput S states N.1 ω) -
          objectiveOn S uStar ∂law.P) =
        (∫ ω, objective S (states N.1 ω).xbar.1 - objective S uStar.1 ∂law.P) := by
    simp [sgsGeneratedOutput, objectiveOn]
  calc
    (∫ ω, objectiveOn S (sgsGeneratedOutput S states N.1 ω) -
        objectiveOn S uStar ∂law.P)
        = (∫ ω, objective S (states N.1 ω).xbar.1 -
            objective S uStar.1 ∂law.P) := hleft_rewrite
    _ ≤ telescopedRHS := by
      simpa [telescopedRHS] using htelescope_attempt
    _ ≤ Gamma N * bregmanDropWindow +
          Gamma N * (∫ ω, relaxedOuterNoise ω ∂law.P) :=
      htelescoped_split_relax
    _ ≤ Gamma N * initialBregmanBudget + Gamma N * deterministicNoiseBudget :=
      hbudget_assembled
    _ = theorem82ExpectedBound_formulaExtension S x0 uStar N beta gamma Gamma T :=
      hdeterministic_formula

/-- Reverse expected post-telescope aggregation after the common split/relax
step.

Aligns with Lan Theorem 8.2 proof steps 2 and 5: after the finite expected
telescope has been split into a Bregman-drop window and a relaxed stochastic
oracle-noise window, the SFO moment package gives the displayed nested variance
budget and Eq. (8.1.38) gives the reverse compact Bregman envelope term. This
helper deliberately stops after consuming a supplied split/relax inequality; the
remaining split is pure integral/finite-sum bookkeeping shared with the forward
post-telescope proof above. -/
private theorem theorem82_reverse_expected_post_telescope_sfo_aggregation_from_split_preSourceTyped
    [MeasurableSpace Ω] [MeasurableSpace Sample] [MeasurableSpace E] [BorelSpace E]
    (law : SGSProbabilityModel (Ω := Ω) S) (uStar : FeasiblePoint S)
    (beta gamma Gamma : PositiveTime → ℝ) (T : PositiveTime → ℕ)
    (N : PositiveTime)
    (states : ℕ → Ω → SGSState S)
    (inner : PositiveTime → ℕ → Ω → SPSState S)
    (hcompact : IsCompact S.X)
    (hbeta : ∀ k : PositiveTime, 0 < beta k)
    (hgamma : gammaRangeCondition gamma)
    (hGamma : outerWeightCondition gamma Gamma)
    (hmono : reverseMonotonicityCondition beta gamma Gamma T)
    (hTpos : ∀ k : PositiveTime, 0 < T k)
    (hGamma_pos : ∀ k : PositiveTime, 0 < Gamma k)
    (hendpoint_int :
      ∀ t, t < N.1 →
        Integrable (fun ω => bregmanFormulaOnX S (states t ω).x uStar) law.P)
    (hdual_sq_int :
      ∀ κ i,
        Integrable
          (fun ω =>
            dualNorm S
              (oracleNoiseAt S (sgsGeneratedOracleQuery S inner κ i ω)
                (law.sample κ i ω)) ^ 2) law.P)
    (hlinear_int :
      ∀ κ i,
        Integrable
          (fun ω =>
            ⟪oracleNoiseAt S (sgsGeneratedOracleQuery S inner κ i ω)
                (law.sample κ i ω),
              uStar.1 - sgsGeneratedOracleQuery S inner κ i ω⟫_ℝ) law.P)
    (hquad :
      ∀ κ i,
        (∫ ω,
          dualNorm S
            (oracleNoiseAt S (sgsGeneratedOracleQuery S inner κ i ω)
              (law.sample κ i ω)) ^ 2 ∂law.P) ≤ S.sigmaSq)
    (hlinear_zero :
      ∀ κ i,
        (∫ ω,
          ⟪oracleNoiseAt S (sgsGeneratedOracleQuery S inner κ i ω)
              (law.sample κ i ω),
            uStar.1 - sgsGeneratedOracleQuery S inner κ i ω⟫_ℝ ∂law.P) = 0)
    (htelescope_attempt :
      (∫ ω, objective S (states N.1 ω).xbar.1 - objective S uStar.1 ∂law.P) ≤
        (if ht : 1 ≤ N.1 then Gamma ⟨N.1, ht⟩ else 1) *
          Finset.sum (Finset.Icc 1 N.1) (fun t =>
            (if ht : 1 ≤ t then
              let κ : PositiveTime := ⟨t, ht⟩
              ∫ ω,
                gamma κ *
                  (beta κ * (1 - psWeightProduct spsP (T κ))⁻¹ *
                      (bregmanFormulaOnX S (states (κ.1 - 1) ω).x uStar -
                        bregmanFormulaOnX S (states κ.1 ω).x uStar) +
                    psWeightProduct spsP (T κ) *
                      (1 - psWeightProduct spsP (T κ))⁻¹ *
                        (Finset.range (T κ)).sum (fun i =>
                          let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
                          let δ := oracleNoiseAt S ((inner κ i ω).u.1)
                            (law.sample κ i ω);
                          (spsP ι * psWeightProduct spsP i)⁻¹ *
                            (((S.mGrowth + dualNorm S δ) ^ 2) /
                                (2 * beta κ * spsP ι) +
                              ⟪δ, uStar.1 - (inner κ i ω).u.1⟫_ℝ))) ∂law.P
            else 0) /
              (if ht : 1 ≤ t then Gamma ⟨t, ht⟩ else 1)))
    (hsplit :
      let bregCoeff : ℕ → ℝ := fun n =>
        if hn : 1 ≤ n then
          gamma ⟨n, hn⟩ * beta ⟨n, hn⟩ /
            (Gamma ⟨n, hn⟩ *
              (1 - psWeightProduct spsP (T ⟨n, hn⟩)))
        else 0;
      let expectedBregman : ℕ → ℝ := fun n =>
        ∫ ω, bregmanFormulaOnX S (states n ω).x uStar ∂law.P;
      let bregmanDropWindow : ℝ :=
        Finset.sum (Finset.Icc 1 N.1) (fun t =>
          bregCoeff t * (expectedBregman (t - 1) - expectedBregman t));
      let relaxedOuterNoise : Ω → ℝ := fun ω =>
        (Finset.range N.1).sum (fun k =>
          let κ : PositiveTime := ⟨k + 1, Nat.succ_pos k⟩;
          gamma κ * psWeightProduct spsP (T κ) /
            (Gamma κ * (1 - psWeightProduct spsP (T κ))) *
              (Finset.range (T κ)).sum (fun i =>
                let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
                let δ := oracleNoiseAt S ((inner κ i ω).u.1) (law.sample κ i ω);
                (spsP ι * psWeightProduct spsP i)⁻¹ *
                  ((S.mGrowth ^ 2 + dualNorm S δ ^ 2) / (beta κ * spsP ι) +
                    ⟪δ, uStar.1 - (inner κ i ω).u.1⟫_ℝ)));
      let telescopedRHS : ℝ :=
        (if ht : 1 ≤ N.1 then Gamma ⟨N.1, ht⟩ else 1) *
          Finset.sum (Finset.Icc 1 N.1) (fun t =>
            (if ht : 1 ≤ t then
              let κ : PositiveTime := ⟨t, ht⟩
              ∫ ω,
                gamma κ *
                  (beta κ * (1 - psWeightProduct spsP (T κ))⁻¹ *
                      (bregmanFormulaOnX S (states (κ.1 - 1) ω).x uStar -
                        bregmanFormulaOnX S (states κ.1 ω).x uStar) +
                    psWeightProduct spsP (T κ) *
                      (1 - psWeightProduct spsP (T κ))⁻¹ *
                        (Finset.range (T κ)).sum (fun i =>
                          let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
                          let δ := oracleNoiseAt S ((inner κ i ω).u.1)
                            (law.sample κ i ω);
                          (spsP ι * psWeightProduct spsP i)⁻¹ *
                            (((S.mGrowth + dualNorm S δ) ^ 2) /
                                (2 * beta κ * spsP ι) +
                              ⟪δ, uStar.1 - (inner κ i ω).u.1⟫_ℝ))) ∂law.P
            else 0) /
              (if ht : 1 ≤ t then Gamma ⟨t, ht⟩ else 1));
      telescopedRHS ≤
        Gamma N * bregmanDropWindow +
          Gamma N * (∫ ω, relaxedOuterNoise ω ∂law.P)) :
    (∫ ω, objectiveOn S (sgsGeneratedOutput S states N.1 ω) -
        objectiveOn S uStar ∂law.P) ≤
      gamma N * beta N * bregmanEnvelope_formulaExtension S uStar hcompact *
          (1 - psWeightProduct spsP (T N))⁻¹ +
        Gamma N *
          (Finset.range N.1).sum (fun k =>
            let κ : PositiveTime := ⟨k + 1, Nat.succ_pos k⟩;
            (Finset.range (T κ)).sum (fun i =>
              let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
              (S.mGrowth ^ 2 + S.sigmaSq) * gamma κ * psWeightProduct spsP (T κ) /
                (beta κ * Gamma κ * (1 - psWeightProduct spsP (T κ)) *
                  spsP ι ^ 2 * psWeightProduct spsP i))) := by
  classical
  have hnoise_bound :=
    theorem82_expected_nested_noise_aggregation_le_preSourceTyped
      S law uStar beta gamma Gamma T N inner hbeta hgamma hTpos hGamma_pos
      hdual_sq_int hlinear_int hquad hlinear_zero
  let bregCoeff : ℕ → ℝ := fun n =>
    if hn : 1 ≤ n then
      gamma ⟨n, hn⟩ * beta ⟨n, hn⟩ /
        (Gamma ⟨n, hn⟩ *
          (1 - psWeightProduct spsP (T ⟨n, hn⟩)))
    else 0
  let expectedBregman : ℕ → ℝ := fun n =>
    ∫ ω, bregmanFormulaOnX S (states n ω).x uStar ∂law.P
  let bregmanDropWindow : ℝ :=
    Finset.sum (Finset.Icc 1 N.1) (fun t =>
      bregCoeff t * (expectedBregman (t - 1) - expectedBregman t))
  let relaxedOuterNoise : Ω → ℝ := fun ω =>
    (Finset.range N.1).sum (fun k =>
      let κ : PositiveTime := ⟨k + 1, Nat.succ_pos k⟩;
      gamma κ * psWeightProduct spsP (T κ) /
        (Gamma κ * (1 - psWeightProduct spsP (T κ))) *
          (Finset.range (T κ)).sum (fun i =>
            let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
            let δ := oracleNoiseAt S ((inner κ i ω).u.1) (law.sample κ i ω);
            (spsP ι * psWeightProduct spsP i)⁻¹ *
              ((S.mGrowth ^ 2 + dualNorm S δ ^ 2) / (beta κ * spsP ι) +
                ⟪δ, uStar.1 - (inner κ i ω).u.1⟫_ℝ)))
  let deterministicNoiseBudget : ℝ :=
    (Finset.range N.1).sum (fun k =>
      let κ : PositiveTime := ⟨k + 1, Nat.succ_pos k⟩;
      gamma κ * psWeightProduct spsP (T κ) /
        (Gamma κ * (1 - psWeightProduct spsP (T κ))) *
          (Finset.range (T κ)).sum (fun i =>
            let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
            (spsP ι * psWeightProduct spsP i)⁻¹ *
              ((S.mGrowth ^ 2 + S.sigmaSq) / (beta κ * spsP ι))))
  let reverseBoundary : ℝ :=
    gamma N * beta N * bregmanEnvelope_formulaExtension S uStar hcompact *
      (1 - psWeightProduct spsP (T N))⁻¹
  let displayedNoise : ℝ :=
    (Finset.range N.1).sum (fun k =>
      let κ : PositiveTime := ⟨k + 1, Nat.succ_pos k⟩;
      (Finset.range (T κ)).sum (fun i =>
        let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
        (S.mGrowth ^ 2 + S.sigmaSq) * gamma κ * psWeightProduct spsP (T κ) /
          (beta κ * Gamma κ * (1 - psWeightProduct spsP (T κ)) *
            spsP ι ^ 2 * psWeightProduct spsP i)))
  have hbregman_scaled :
      Gamma N * bregmanDropWindow ≤ reverseBoundary := by
    simpa [bregmanDropWindow, bregCoeff, expectedBregman, reverseBoundary] using
      theorem82_reverse_bregman_drop_expectation_scaled_le_envelope_preSourceTyped
        (S := S) law uStar beta gamma Gamma T N states hcompact hbeta hgamma
        hGamma hmono hendpoint_int
  have hnoise_scaled :
      Gamma N * (∫ ω, relaxedOuterNoise ω ∂law.P) ≤
        Gamma N * deterministicNoiseBudget := by
    exact mul_le_mul_of_nonneg_left
      (by simpa [relaxedOuterNoise, deterministicNoiseBudget] using hnoise_bound)
      (le_of_lt (hGamma_pos N))
  have houter_normalize :
      deterministicNoiseBudget = displayedNoise := by
    simp [deterministicNoiseBudget, displayedNoise]
    refine Finset.sum_congr rfl ?_
    intro k _hk
    let κ : PositiveTime := ⟨k + 1, Nat.succ_pos k⟩
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl ?_
    intro i _hi
    let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩
    have hbeta_ne : beta κ ≠ 0 := ne_of_gt (hbeta κ)
    have hGamma_ne : Gamma κ ≠ 0 := ne_of_gt (hGamma_pos κ)
    have hOneSub_ne : 1 - psWeightProduct spsP (T κ) ≠ 0 :=
      ne_of_gt (one_sub_psWeightProduct_spsP_pos_of_pos (hTpos κ))
    have hspsP_ne : spsP ι ≠ 0 := by
      unfold spsP
      positivity
    have hprod_ne : psWeightProduct spsP i ≠ 0 := by
      rw [psWeightProduct_spsP_eq i]
      positivity
    field_simp [κ, ι, hbeta_ne, hGamma_ne, hOneSub_ne, hspsP_ne,
      hprod_ne, pow_two]
  let telescopedRHS : ℝ :=
    (if ht : 1 ≤ N.1 then Gamma ⟨N.1, ht⟩ else 1) *
      Finset.sum (Finset.Icc 1 N.1) (fun t =>
        (if ht : 1 ≤ t then
          let κ : PositiveTime := ⟨t, ht⟩
          ∫ ω,
            gamma κ *
              (beta κ * (1 - psWeightProduct spsP (T κ))⁻¹ *
                  (bregmanFormulaOnX S (states (κ.1 - 1) ω).x uStar -
                    bregmanFormulaOnX S (states κ.1 ω).x uStar) +
                psWeightProduct spsP (T κ) *
                  (1 - psWeightProduct spsP (T κ))⁻¹ *
                    (Finset.range (T κ)).sum (fun i =>
                      let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
                      let δ := oracleNoiseAt S ((inner κ i ω).u.1)
                        (law.sample κ i ω);
                      (spsP ι * psWeightProduct spsP i)⁻¹ *
                        (((S.mGrowth + dualNorm S δ) ^ 2) /
                            (2 * beta κ * spsP ι) +
                          ⟪δ, uStar.1 - (inner κ i ω).u.1⟫_ℝ))) ∂law.P
        else 0) /
          (if ht : 1 ≤ t then Gamma ⟨t, ht⟩ else 1))
  have hbudget_assembled :
      Gamma N * bregmanDropWindow +
          Gamma N * (∫ ω, relaxedOuterNoise ω ∂law.P) ≤
        reverseBoundary + Gamma N * deterministicNoiseBudget := by
    nlinarith [hbregman_scaled, hnoise_scaled]
  have hleft_rewrite :
      (∫ ω, objectiveOn S (sgsGeneratedOutput S states N.1 ω) -
          objectiveOn S uStar ∂law.P) =
        (∫ ω, objective S (states N.1 ω).xbar.1 - objective S uStar.1 ∂law.P) := by
    simp [sgsGeneratedOutput, objectiveOn]
  calc
    (∫ ω, objectiveOn S (sgsGeneratedOutput S states N.1 ω) -
        objectiveOn S uStar ∂law.P)
        = (∫ ω, objective S (states N.1 ω).xbar.1 -
            objective S uStar.1 ∂law.P) := hleft_rewrite
    _ ≤ telescopedRHS := by
      simpa [telescopedRHS] using htelescope_attempt
    _ ≤ Gamma N * bregmanDropWindow +
          Gamma N * (∫ ω, relaxedOuterNoise ω ∂law.P) := by
      simpa [bregCoeff, expectedBregman, bregmanDropWindow, relaxedOuterNoise,
        telescopedRHS] using hsplit
    _ ≤ reverseBoundary + Gamma N * deterministicNoiseBudget := hbudget_assembled
    _ = reverseBoundary + Gamma N * displayedNoise := by
      rw [houter_normalize]
    _ = gamma N * beta N * bregmanEnvelope_formulaExtension S uStar hcompact *
          (1 - psWeightProduct spsP (T N))⁻¹ +
        Gamma N *
          (Finset.range N.1).sum (fun k =>
            let κ : PositiveTime := ⟨k + 1, Nat.succ_pos k⟩;
            (Finset.range (T κ)).sum (fun i =>
              let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
              (S.mGrowth ^ 2 + S.sigmaSq) * gamma κ * psWeightProduct spsP (T κ) /
                (beta κ * Gamma κ * (1 - psWeightProduct spsP (T κ)) *
                  spsP ι ^ 2 * psWeightProduct spsP i))) := by
      simp [reverseBoundary, displayedNoise]

/-- Reverse expected formula-extension implementation after the post-telescope
helper cone.

Aligns with Lan Theorem 8.2(c), proof steps 2 and 5: Eq. (8.1.69) is
integrated and telescoped, the common split/relax helper separates the
Bregman-drop and SFO terms, and the reverse aggregation helper applies
Eq. (8.1.38). Candidate audit: considered the SOptLib output-window telescope
lemmas listed in the planner digest, but the route needs the target-file
generated SGS one-step recurrence, `finite_window_weighted_recurrence_telescope_no_source_beforeMaster`,
`theorem82_post_telescope_split_relax_preSourceTyped`, and
`theorem82_reverse_expected_post_telescope_sfo_aggregation_from_split_preSourceTyped`
because they expose the paper's exact Eq. (8.1.69) integrand and reverse
Bregman-envelope replacement. -/
private theorem reverse_expected_formula_extension_impl_after_post_telescope_helpers
    [MeasurableSpace Ω] [MeasurableSpace Sample] [MeasurableSpace E] [BorelSpace E]
    (law : SGSProbabilityModel (Ω := Ω) S) (x0 : FeasiblePoint S) (xStar : E)
    (beta gamma Gamma : PositiveTime → ℝ) (T : PositiveTime → ℕ)
    (N : PositiveTime)
    (states : ℕ → Ω → SGSState S)
    (inner : PositiveTime → ℕ → Ω → SPSState S)
    (hrun : IsGeneratedSGSProcess_formulaExtension S x0 beta gamma T law.sample states inner)
    (hindep : sfoIndependent S law.P law.sample (sgsGeneratedOracleQuery S inner))
    (hxStar : IsOptimalSolution S xStar)
    (hcompact : IsCompact S.X)
    (hlower : outerLowerBoundCondition S beta gamma)
    (hGamma : outerWeightCondition gamma Gamma)
    (hmono : reverseMonotonicityCondition beta gamma Gamma T) :
    expectedOutputGap S law x0 beta gamma T states inner N xStar hxStar hrun.1 hindep ≤
      gamma N * beta N * bregmanEnvelope_formulaExtension S ⟨xStar, hxStar.1⟩
          hcompact * (1 - psWeightProduct spsP (T N))⁻¹ +
        Gamma N *
          (Finset.range N.1).sum (fun k =>
            let κ : PositiveTime := ⟨k + 1, Nat.succ_pos k⟩;
            (Finset.range (T κ)).sum (fun i =>
              let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
              (S.mGrowth ^ 2 + S.sigmaSq) * gamma κ * psWeightProduct spsP (T κ) /
                (beta κ * Gamma κ * (1 - psWeightProduct spsP (T κ)) *
                  spsP ι ^ 2 * psWeightProduct spsP i))) := by
  classical
  have hrun_core : IsGeneratedSGSProcess S x0 beta gamma T law.sample states inner := hrun.1
  have hbeta : ∀ k : PositiveTime, 0 < beta k :=
    IsGeneratedSGSProcess_beta_pos S x0 beta gamma T law.sample states inner hrun_core
  have hgamma_nonneg : gammaNonnegativeCondition gamma :=
    IsGeneratedSGSProcess_gamma_nonnegative S x0 beta gamma T law.sample states inner
      hrun_core
  have hgamma_range : gammaRangeCondition gamma :=
    gammaRangeCondition_of_reverseMonotonicity_generated
      S beta gamma Gamma T hbeta hgamma_nonneg hlower hGamma hmono
  have hinner_proc :
      ∀ k : PositiveTime,
        IsGeneratedSPSProcess S
          (fun ω u =>
            smoothLinearization S
              (outerExtrapolation S gamma k (states (k.1 - 1) ω)) u)
          (fun ω => (states (k.1 - 1) ω).x)
          (beta k) (law.sample k) (inner k) := hrun_core.2.1
  have houter_update :
      ∀ k : PositiveTime, ∀ ω,
        (states k.1 ω).x = (inner k (T k) ω).u ∧
          (states k.1 ω).xbar.1 =
            (1 - gamma k) • (states (k.1 - 1) ω).xbar.1 +
              gamma k • (inner k (T k) ω).avg.1 := hrun_core.2.2.1
  have hTpos : ∀ k : PositiveTime, 0 < T k :=
    positive_inner_budget_of_reverseMonotonicity_beforeMaster beta gamma Gamma T hmono
  have hGamma_pos : ∀ k : PositiveTime, 0 < Gamma k :=
    outer_gamma_positive_of_weight_condition_and_reverse_denom_beforeMaster
      beta gamma Gamma T hgamma_range hGamma hmono
  let uStar : FeasiblePoint S := ⟨xStar, hxStar.1⟩
  have hfirst_recurrence :
      ∀ k : PositiveTime, ∀ ω,
        let stPrev := states (k.1 - 1) ω
        let stCurr := states k.1 ω
        let δinner := inner k
        objective S stCurr.xbar.1 - objective S uStar.1 ≤
          (1 - gamma k) *
              (objective S stPrev.xbar.1 - objective S uStar.1) +
            gamma k *
              (beta k * (1 - psWeightProduct spsP (T k))⁻¹ *
                  (bregmanFormulaOnX S stPrev.x uStar -
                    bregmanFormulaOnX S stCurr.x uStar) +
                psWeightProduct spsP (T k) *
                  (1 - psWeightProduct spsP (T k))⁻¹ *
                    (Finset.range (T k)).sum (fun i =>
                      let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
                      let δ := oracleNoiseAt S ((δinner i ω).u.1) (law.sample k i ω);
                      (spsP ι * psWeightProduct spsP i)⁻¹ *
                        (((S.mGrowth + dualNorm S δ) ^ 2) /
                            (2 * beta k * spsP ι) +
                          ⟪δ, uStar.1 - (δinner i ω).u.1⟫_ℝ))) := by
    intro k ω
    simpa using
      generated_sgs_one_step_gap_recurrence_formulaExtension_preSourceTyped
        (S := S) beta gamma T law.sample hbeta hgamma_range hlower
        k (hTpos k) states inner (hinner_proc k) ω (houter_update k ω)
