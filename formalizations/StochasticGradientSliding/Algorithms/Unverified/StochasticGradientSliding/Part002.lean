    exact integral_map hX_meas.aemeasurable
      (measurable_fst : Measurable (fun z : ℝ × FeasiblePoint S => z.1)).aestronglyMeasurable
  rw [← MeasureTheory.integral_indicator (μ := law.P) (f := f) hs_top]
  calc
    ∫ ω, s.indicator f ω ∂law.P =
