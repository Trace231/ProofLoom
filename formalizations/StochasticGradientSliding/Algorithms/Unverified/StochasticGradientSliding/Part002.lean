/-!
Stochastic gradient sliding.

Phase 0 object layer for Lan's stochastic gradient sliding method.  The
declarations below encode the paper-facing mathematical objects as definitions:
the composite objective, Bregman prox geometry, stochastic oracle samples, SPS
inner update, and the outer SGS recursion.
-/

open scoped BigOperators Gradient InnerProductSpace
open MeasureTheory ProbabilityTheory

set_option maxHeartbeats 800000

namespace StochasticGradientSliding


universe u v w z

variable {E : Type u} {Sample : Type v} {Ω : Type w}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable (S : Setup.{u, v, w} E Sample)

/-- Supplied-minorant explicit version of the feasible-domain `Phi` gap envelope.

This is the selected-SGS random-center API: the affine model slope and the
chosen affine minorant for `chi` are explicit inputs, so the resulting random
constant can be inspected for integrability instead of hidden behind an
existential choice. -/
theorem spsPhiFormulaOnX_gap_le_eps_bregman_add_explicit_const_of_minorant
    (g : E → ℝ) (center u : FeasiblePoint S)
    {β eps : ℝ} (hβ : 0 ≤ β) (heps : 0 < eps)
    (gc : ℝ) (gb : E) (χa : ℝ) (χb : E)
    (hgdef : ∀ y, g y = gc + ⟪gb, y⟫_ℝ)
    (hχminor : ∀ y : {x : E // x ∈ S.X}, χa + ⟪χb, y.1⟫_ℝ ≤ S.chi y.1) :
    ∀ z : FeasiblePoint S,
      spsPhiFormulaOnX S g center β u -
          spsPhiFormulaOnX S g center β z ≤
        eps * bregmanFormulaOnX S z u +
          dualNorm S (gb + S.hSubgradient u.1 + χb) ^ 2 / (2 * eps) +
            |β * bregmanFormulaOnX S center u +
              (S.chi u.1 - χa - ⟪χb, u.1⟫_ℝ)| := by
  classical
  intro z
  let slope : E := gb + S.hSubgradient u.1 + χb
  let A : ℝ := β * bregmanFormulaOnX S center u +
    (S.chi u.1 - χa - ⟪χb, u.1⟫_ℝ)
  have hg_gap : g u.1 - g z.1 = ⟪gb, u.1 - z.1⟫_ℝ := by
    simp [hgdef, inner_sub_right]
  have hh_support :
      S.h z.1 ≥
        S.h u.1 + ⟪S.hSubgradient u.1, z.1 - u.1⟫_ℝ := by
    have hmem := (setup_hSubgradientMem S) u.1 u.2
    exact (SOptLib.mem_carrierSubdifferential_iff.mp hmem) z
  have hh_gap :
      S.h u.1 - S.h z.1 ≤
        ⟪S.hSubgradient u.1, u.1 - z.1⟫_ℝ := by
    have hinner :
        ⟪S.hSubgradient u.1, z.1 - u.1⟫_ℝ =
          -⟪S.hSubgradient u.1, u.1 - z.1⟫_ℝ := by
      simp [inner_sub_right]
    nlinarith
  have hχz : χa + ⟪χb, z.1⟫_ℝ ≤ S.chi z.1 := hχminor z
  have hχ_gap :
      S.chi u.1 - S.chi z.1 ≤
        (S.chi u.1 - χa - ⟪χb, u.1⟫_ℝ) +
          ⟪χb, u.1 - z.1⟫_ℝ := by
    have hinner : ⟪χb, u.1 - z.1⟫_ℝ =
        ⟪χb, u.1⟫_ℝ - ⟪χb, z.1⟫_ℝ := by
      simp [inner_sub_right]
    nlinarith
  have hVcenter_z_nonneg : 0 ≤ bregmanFormulaOnX S center z := by
    have hlower := bregmanFormulaOnX_lower_bound_from_prox_geometry S center z
    nlinarith [sq_nonneg (S.primalNorm (z.1 - center.1))]
  have hβ_gap :
      β * bregmanFormulaOnX S center u -
          β * bregmanFormulaOnX S center z ≤
        β * bregmanFormulaOnX S center u := by
    nlinarith [hβ, hVcenter_z_nonneg]
  have hinner_sum :
      ⟪gb, u.1 - z.1⟫_ℝ +
          ⟪S.hSubgradient u.1, u.1 - z.1⟫_ℝ +
          ⟪χb, u.1 - z.1⟫_ℝ =
        ⟪slope, u.1 - z.1⟫_ℝ := by
    simp [slope, inner_add_left]
  have hphi_affine :
      spsPhiFormulaOnX S g center β u -
          spsPhiFormulaOnX S g center β z ≤
        A + ⟪slope, u.1 - z.1⟫_ℝ := by
    unfold spsPhiFormulaOnX spsPhi
    nlinarith [hg_gap, hh_gap, hχ_gap, hβ_gap, hinner_sum]
  have hpair_z :
      ⟪slope, u.1 - z.1⟫_ℝ ≤
        eps * bregmanFormulaOnX S z u + dualNorm S slope ^ 2 / (2 * eps) :=
    fixed_linear_pairing_bregman_absorb_with_epsilon_explicit
      (S := S) u slope heps z
  have hA_le_abs : A ≤ |A| := le_abs_self A
  nlinarith

/-- Scalar half-absorption for a one-step `Φ`/Bregman recurrence.

This is the algebraic core of the Proposition 8.3 successor transfer after the
source recurrence and an `eps = coeff / 2` `Φ`-gap bound have both been exposed.
Candidate audit: searched the target and SOptLib for telescope/descent scalar
absorption helpers; existing telescope lemmas aggregate finite sums, while this
route-local lemma is the one-step ordered-field rearrangement needed before
measure-theoretic domination. -/
theorem successor_bregman_le_of_phi_gap_absorption
    {βp coeff Vprev Vnext R C Φnext Φu : ℝ}
    (hcoeff : 0 < coeff)
    (hrec : Φnext - Φu ≤ βp * Vprev - coeff * Vnext + R)
    (hgap : Φu - Φnext ≤ (coeff / 2) * Vnext + C) :
    Vnext ≤ (2 / coeff) * (βp * Vprev + R + C) := by
  have hhalf : (coeff / 2) * Vnext ≤ βp * Vprev + R + C := by
    nlinarith
  have hscale_nonneg : 0 ≤ 2 / coeff := by
    positivity
  have hscaled :=
    mul_le_mul_of_nonneg_left hhalf hscale_nonneg
  calc
    Vnext = (2 / coeff) * ((coeff / 2) * Vnext) := by
      field_simp [ne_of_gt hcoeff]
    _ ≤ (2 / coeff) * (βp * Vprev + R + C) := hscaled

/-- Integrability transfer after the selected one-step Phi gap has been
replaced by an integrable envelope.

Aligns with the post-Eq. (8.1.61) absorption step on the way to Lan
Proposition 8.3 Eq. (8.1.63). Candidate audit: considered SOptLib
`integrable_terminal_state_sq_of_gamma_telescope_envelope` and
`finite_window_state_sq_integrable_of_source_bregman_recurrence`; those live in
`Layer1.Telescope` and package finite-window/two-component telescopes, while
this route-local helper isolates the one-step domination needed by the selected
successor transfer. -/
theorem selected_successor_bregman_integrable_of_gap_envelope
    [MeasurableSpace Ω] {P : Measure Ω} [IsFiniteMeasure P]
    {βp coeff : ℝ} {Vprev Vnext R C Φnext Φu : Ω → ℝ}
    (hcoeff : 0 < coeff)
    (hVprev_int : Integrable Vprev P)
    (hR_int : Integrable R P)
    (hC_int : Integrable C P)
    (hVnext_aestrong : AEStronglyMeasurable Vnext P)
    (hVnext_nonneg : ∀ᵐ ω ∂P, 0 ≤ Vnext ω)
    (hrec :
      ∀ ω, Φnext ω - Φu ω ≤ βp * Vprev ω - coeff * Vnext ω + R ω)
    (hgap :
      ∀ᵐ ω ∂P, Φu ω - Φnext ω ≤ (coeff / 2) * Vnext ω + C ω) :
    Integrable Vnext P := by
  classical
  have hupper_int :
      Integrable
        (fun ω => (2 / coeff) * (βp * Vprev ω + R ω + C ω)) P := by
    exact (((hVprev_int.const_mul βp).add hR_int).add hC_int).const_mul (2 / coeff)
  refine hupper_int.mono' hVnext_aestrong ?_
  filter_upwards [hVnext_nonneg, hgap] with ω hVnext_nonneg_ω hgap_ω
  have hle :
      Vnext ω ≤ (2 / coeff) * (βp * Vprev ω + R ω + C ω) :=
    successor_bregman_le_of_phi_gap_absorption
      (βp := βp) (coeff := coeff) (Vprev := Vprev ω)
      (Vnext := Vnext ω) (R := R ω) (C := C ω)
      (Φnext := Φnext ω) (Φu := Φu ω) hcoeff (hrec ω) hgap_ω
  have hupper_nonneg :
      0 ≤ (2 / coeff) * (βp * Vprev ω + R ω + C ω) :=
    le_trans hVnext_nonneg_ω hle
  simpa [Real.norm_of_nonneg hVnext_nonneg_ω,
    Real.norm_of_nonneg hupper_nonneg] using hle

/-- Integrability transfer for the source-shaped Proposition 8.3 combined
terminal-Bregman/averaged-Phi inequality.

Unlike `selected_successor_bregman_integrable_of_gap_envelope`, this helper is
typed for Eq. (8.1.61): the recurrence controls
`coeff * V(u_t,u) + (Phi(tilde u_t) - Phi(u))`.  The only reverse-gap envelope it
needs is therefore for the averaged output `tilde u_t`, not for the terminal
iterate `u_t`. -/
theorem terminal_bregman_integrable_of_average_phi_envelope
    [MeasurableSpace Ω] {P : Measure Ω} [IsFiniteMeasure P]
    {coeff : ℝ} {Vnext RHS C Φavg Φu : Ω → ℝ}
    (hcoeff : 0 < coeff)
    (hRHS_int : Integrable RHS P)
    (hC_int : Integrable C P)
    (hVnext_aestrong : AEStronglyMeasurable Vnext P)
    (hVnext_nonneg : ∀ᵐ ω ∂P, 0 ≤ Vnext ω)
    (hprop :
      ∀ ω, coeff * Vnext ω + (Φavg ω - Φu ω) ≤ RHS ω)
    (havg_gap :
      ∀ᵐ ω ∂P, Φu ω - Φavg ω ≤ (coeff / 2) * Vnext ω + C ω) :
    Integrable Vnext P := by
  classical
  have hupper_int :
      Integrable (fun ω => (2 / coeff) * (RHS ω + C ω)) P :=
    (hRHS_int.add hC_int).const_mul (2 / coeff)
  refine hupper_int.mono' hVnext_aestrong ?_
  filter_upwards [hVnext_nonneg, havg_gap] with ω hV_nonneg hgapω
  have hhalf : (coeff / 2) * Vnext ω ≤ RHS ω + C ω := by
    have hp := hprop ω
    nlinarith
  have hle : Vnext ω ≤ (2 / coeff) * (RHS ω + C ω) := by
    calc
      Vnext ω = (2 / coeff) * ((coeff / 2) * Vnext ω) := by
        field_simp [ne_of_gt hcoeff]
      _ ≤ (2 / coeff) * (RHS ω + C ω) := by
        exact mul_le_mul_of_nonneg_left hhalf (by positivity)
  have hupper_nonneg : 0 ≤ (2 / coeff) * (RHS ω + C ω) :=
    le_trans hV_nonneg hle
  simpa [Real.norm_of_nonneg hV_nonneg,
    Real.norm_of_nonneg hupper_nonneg] using hle

/-- Fixed-center reverse-`Phi` gap envelope.

This is the proved non-random-center branch of the absorption infrastructure:
for a fixed affine model and fixed prox center, the affine-minorant/Young
argument gives a deterministic constant, hence an integrable envelope on any
finite measure space.  The selected SGS successor proof cannot use this lemma
directly for its random outer center; the remaining finite telescope must still
come from Proposition 8.3/Eq. (8.1.63), not by choosing a random constant from
this existential result. -/
theorem fixed_spsPhiFormulaOnX_reverse_gap_integrable_envelope
    [MeasurableSpace Ω] {P : Measure Ω} [IsFiniteMeasure P]
    (g : E → ℝ) (hg : IsAffineModel g) (center x : FeasiblePoint S)
    {β coeff : ℝ} (hβ : 0 ≤ β) (hcoeff : 0 < coeff)
    (z : Ω → FeasiblePoint S) :
    ∃ Cgap : Ω → ℝ,
      Integrable Cgap P ∧
        (∀ᵐ ω ∂P,
          spsPhiFormulaOnX S g center β x -
              spsPhiFormulaOnX S g center β (z ω) ≤
            (coeff / 2) * bregmanFormulaOnX S (z ω) x + Cgap ω) := by
  classical
  have heps : 0 < coeff / 2 := by positivity
  rcases
      spsPhiFormulaOnX_gap_le_eps_bregman_add_const
        (S := S) g hg center x (β := β) (eps := coeff / 2) hβ heps
    with ⟨C, _hC_nonneg, hC⟩
  refine ⟨fun _ => C, integrable_const (c := C), ?_⟩
  exact Filter.Eventually.of_forall (fun ω => hC (z ω))

/-- Source-faithful selected-step stability before process stability.

The declaration keeps its historical private name because downstream generated
proof plans refer to it, but the statement has been reconstructed away from the
unsupported square-only noncompact budget.  It now exposes exactly the
Proposition 8.3 one-step `Φ`/Bregman recurrence for the selected
formula-extension solver.  Any later square estimate must either consume these
terms through a telescope or add compact/envelope hypotheses at the compact
corollary boundary. -/
theorem selected_formula_extension_step_square_budget_before_stability
    (x : FeasiblePoint S) (β : {β : ℝ // 0 < β}) (t : PositiveTime) :
    ∀ (center prev xUnder : FeasiblePoint S) (xi : Sample),
      let δ := oracleNoiseAt S prev.1 xi
      let next : FeasiblePoint S :=
        (spsStep_formulaExtensionSelector S (smoothLinearization S xUnder.1)
          (smoothLinearization_isAffineModel S xUnder.1) center β t prev xi).1
      spsPhiFormulaOnX S (smoothLinearization S xUnder.1) center β.1 next -
          spsPhiFormulaOnX S (smoothLinearization S xUnder.1) center β.1 x ≤
        β.1 * spsP t * bregmanFormulaOnX S prev x -
          β.1 * (1 + spsP t) * bregmanFormulaOnX S next x +
          ((S.mGrowth + dualNorm S δ) ^ 2) / (2 * β.1 * spsP t) +
          ⟪δ, x.1 - prev.1⟫_ℝ := by
  classical
  intro center prev xUnder xi
  let δ := oracleNoiseAt S prev.1 xi
  let next : FeasiblePoint S :=
    (spsStep_formulaExtensionSelector S (smoothLinearization S xUnder.1)
      (smoothLinearization_isAffineModel S xUnder.1) center β t prev xi).1
  have hphi :=
    spsStep_formulaExtensionSelector_one_step_phi_bound_before_stability
      (S := S) (g := smoothLinearization S xUnder.1)
      (hg := smoothLinearization_isAffineModel S xUnder.1)
      (x := center) (β := β) (t := t) (prev := prev) (xi := xi) (u := x)
  simpa [δ, next, add_assoc, add_left_comm, add_comm] using hphi

/-- The zero-th selected SGS oracle query in an inner call is the outer center
for that call.

This exposes the base case needed by the finite selected-query integrability
induction.  It is only a recursion-unfolding bridge for the canonical selected
process; it does not assert any square envelope for later selected minimizers. -/
theorem sgsOracleQuery_zero_eq_outer_center
    (x0 : FeasiblePoint S)
    (beta gamma : PositiveTime → ℝ) (T : PositiveTime → ℕ)
    (sample : PositiveTime → ℕ → Ω → Sample)
    (hbeta : ∀ k : PositiveTime, 0 < beta k)
    (hgamma : gammaRangeCondition gamma)
    (κ : PositiveTime) (ω : Ω) :
    sgsOracleQuery S x0 beta hbeta gamma hgamma T sample κ 0 ω =
      (sgsProcess_formulaExtensionSelector S x0 beta hbeta gamma hgamma T sample
        (κ.1 - 1) ω).x.1 := by
  simp [sgsOracleQuery, sgsInnerProcess_formulaExtensionSelector, spsProcess,
    SOptLib.recursiveIterateProcess, spsInitial]

/-- A successor selected SGS oracle query is exactly the selected SPS prox step
from the previous inner state.

This is the concrete recursion bridge that lets the Proposition 8.3 one-step
bound be applied to the actual generated query `u_{k,i+1}` rather than to an
unrelated selected minimizer. -/
theorem sgsOracleQuery_succ_eq_selected_spsStep
    (x0 : FeasiblePoint S)
    (beta gamma : PositiveTime → ℝ) (T : PositiveTime → ℕ)
    (sample : PositiveTime → ℕ → Ω → Sample)
    (hbeta : ∀ k : PositiveTime, 0 < beta k)
    (hgamma : gammaRangeCondition gamma)
    (κ : PositiveTime) (i : ℕ) (ω : Ω) :
    sgsOracleQuery S x0 beta hbeta gamma hgamma T sample κ (i + 1) ω =
      (spsStep_formulaExtensionSelector S
        (fun y =>
          smoothLinearization S
            (outerExtrapolation S gamma κ
              (sgsProcess_formulaExtensionSelector S x0 beta hbeta gamma hgamma T sample
                (κ.1 - 1) ω)) y)
        (smoothLinearization_isAffineModel S
          (outerExtrapolation S gamma κ
            (sgsProcess_formulaExtensionSelector S x0 beta hbeta gamma hgamma T sample
              (κ.1 - 1) ω)))
        (sgsProcess_formulaExtensionSelector S x0 beta hbeta gamma hgamma T sample
          (κ.1 - 1) ω).x
        ⟨beta κ, hbeta κ⟩ ⟨i + 1, Nat.succ_pos i⟩
        (sgsInnerProcess_formulaExtensionSelector S x0 beta hbeta gamma hgamma T sample
          κ i ω).u
        (sample κ i ω)).1.1 := by
  simp [sgsOracleQuery, sgsInnerProcess_formulaExtensionSelector, spsProcess,
    spsTransition, spsTransition_formulaExtensionSelector, SOptLib.recursiveIterateProcess]

/-- Successor selected SGS oracle queries inherit a supplied source-domain
prox-core invariant for the nested SPS process.

This is intentionally a projection from `hinner`, not a consequence of the
feasible Eq. (8.1.58) solver.  It is the bridge used when the selected
formula-extension run has been lifted to the source-domain `X^o × X` view. -/
theorem sgsOracleQuery_succ_mem_proxCore_of_inner
    (x0 : FeasiblePoint S)
    (beta gamma : PositiveTime → ℝ) (T : PositiveTime → ℕ)
    (sample : PositiveTime → ℕ → Ω → Sample)
    (hbeta : ∀ k : PositiveTime, 0 < beta k)
    (hgamma : gammaRangeCondition gamma)
    (hinner :
      ∀ k i ω,
        ((sgsInnerProcess_formulaExtensionSelector S x0 beta hbeta gamma hgamma T sample
          k i ω).u).1 ∈
            proxCore S.X S.proxPotential)
    (κ : PositiveTime) (i : ℕ) (ω : Ω) :
    sgsOracleQuery S x0 beta hbeta gamma hgamma T sample κ (i + 1) ω ∈
      proxCore S.X S.proxPotential := by
  simpa [sgsOracleQuery] using hinner κ (i + 1) ω

/-- The selected outer center before call `κ ≥ 2` is the previous call's
terminal selected SPS query.

Aligns with Algorithm 8.1/8.2, steps 6-7: the outer transition stores the SPS
output `out.u` as the next center. Candidate audit: the pre-searched selection
and stationarity candidates concern output expectations/certificates rather
than this pathwise recursion; searched target/SOptLib for recursive iterate
transport and used `SOptLib.recursiveIterateProcess_succ` specialized to the
selected SGS transition. -/
theorem selected_outer_center_eq_previous_terminal_query
    (x0 : FeasiblePoint S)
    (beta gamma : PositiveTime → ℝ) (T : PositiveTime → ℕ)
    (sample : PositiveTime → ℕ → Ω → Sample)
    (hbeta : ∀ k : PositiveTime, 0 < beta k)
    (hgamma : gammaRangeCondition gamma)
    (κ : PositiveTime) (hκ : 2 ≤ κ.1) (ω : Ω) :
    (sgsProcess_formulaExtensionSelector S x0 beta hbeta gamma hgamma T sample
        (κ.1 - 1) ω).x.1 =
      sgsOracleQuery S x0 beta hbeta gamma hgamma T sample
        (predTime κ hκ) (T (predTime κ hκ)) ω := by
  classical
  let prev : PositiveTime := predTime κ hκ
  have hraw : κ.1 - 1 = prev.1 := rfl
  rw [hraw]
  rcases prev with ⟨m, hm⟩
  have hmpos : 0 < m := lt_of_lt_of_le Nat.zero_lt_one hm
  obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hmpos)
  subst hn
  have hprev_eq : predTime κ hκ = (⟨n + 1, hm⟩ : PositiveTime) := by
    ext
    exact hraw
  rw [hprev_eq]
  dsimp [sgsProcess_formulaExtensionSelector]
  rw [SOptLib.recursiveIterateProcess_succ
    (SOptLib.recursiveIterateProcess (sgsInitial S x0)
      (sgsTransition_formulaExtensionSelector S (positiveBetaSchedule beta hbeta) gamma T sample hgamma))
    (sgsInitial S x0)
    (sgsTransition_formulaExtensionSelector S (positiveBetaSchedule beta hbeta) gamma T sample hgamma)
    rfl n ω]
  simp [sgsOracleQuery, sgsProcess_formulaExtensionSelector,
    sgsInnerProcess_formulaExtensionSelector, spsProcess,
    sgsTransition_formulaExtensionSelector, spsOutput, positiveBetaSchedule]

/-- Voucher step V4.3 for the selected-query L2 leaf.

For every successor query in the canonical selected SGS/SPS recursion, this
compiled bridge simultaneously exposes the recursion identity and applies the
source Proposition 8.3 one-step Phi/Bregman recurrence to that exact query.
The remaining L2 integrability proof must integrate/telescope these displayed
terms; this theorem intentionally stops before any unsupported noncompact
square-only domination. -/
theorem _voucher_step_sgsOracleQuery_successor_exposes_selected_phi_bregman_18
    (x0 x : FeasiblePoint S)
    (beta gamma : PositiveTime → ℝ) (T : PositiveTime → ℕ)
    (sample : PositiveTime → ℕ → Ω → Sample)
    (hbeta : ∀ k : PositiveTime, 0 < beta k)
    (hgamma : gammaRangeCondition gamma)
    (κ : PositiveTime) (i : ℕ) (ω : Ω) :
    let outerPrev :=
      sgsProcess_formulaExtensionSelector S x0 beta hbeta gamma hgamma T sample
        (κ.1 - 1) ω;
    let xUnder := outerExtrapolation S gamma κ outerPrev;
    let prev :=
      (sgsInnerProcess_formulaExtensionSelector S x0 beta hbeta gamma hgamma T sample
        κ i ω).u;
    let βκ : {β : ℝ // 0 < β} := ⟨beta κ, hbeta κ⟩;
    let t : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
    let next : FeasiblePoint S :=
      (spsStep_formulaExtensionSelector S (smoothLinearization S xUnder)
        (smoothLinearization_isAffineModel S xUnder) outerPrev.x βκ t prev
        (sample κ i ω)).1;
    sgsOracleQuery S x0 beta hbeta gamma hgamma T sample κ (i + 1) ω = next.1 ∧
      (let δ := oracleNoiseAt S prev.1 (sample κ i ω);
        spsPhiFormulaOnX S (smoothLinearization S xUnder) outerPrev.x (beta κ) next -
            spsPhiFormulaOnX S (smoothLinearization S xUnder) outerPrev.x (beta κ) x ≤
          beta κ * spsP t * bregmanFormulaOnX S prev x -
            beta κ * (1 + spsP t) * bregmanFormulaOnX S next x +
            ((S.mGrowth + dualNorm S δ) ^ 2) / (2 * beta κ * spsP t) +
            ⟪δ, x.1 - prev.1⟫_ℝ) := by
  classical
  dsimp
  constructor
  · simpa [smoothLinearization] using
      sgsOracleQuery_succ_eq_selected_spsStep
        (S := S) x0 beta gamma T sample hbeta hgamma κ i ω
  · simpa [smoothLinearization] using
      spsStep_formulaExtensionSelector_one_step_phi_bound_before_stability
        (S := S)
        (g := smoothLinearization S
          (outerExtrapolation S gamma κ
            (sgsProcess_formulaExtensionSelector S x0 beta hbeta gamma hgamma T sample
              (κ.1 - 1) ω)))
        (hg := smoothLinearization_isAffineModel S
          (outerExtrapolation S gamma κ
            (sgsProcess_formulaExtensionSelector S x0 beta hbeta gamma hgamma T sample
              (κ.1 - 1) ω)))
        (x :=
          (sgsProcess_formulaExtensionSelector S x0 beta hbeta gamma hgamma T sample
            (κ.1 - 1) ω).x)
        (β := ⟨beta κ, hbeta κ⟩)
        (t := ⟨i + 1, Nat.succ_pos i⟩)
        (prev :=
          (sgsInnerProcess_formulaExtensionSelector S x0 beta hbeta gamma hgamma T sample
            κ i ω).u)
        (xi := sample κ i ω)
        (u := x)

/-- Voucher step V4.4 for the selected-query L2 leaf.

This strengthens the successor recurrence voucher by applying the already
compiled Bregman lower-bound bridge to the actual selected SGS query.  The
remaining L2 proof still has to integrate the displayed right-hand side and
