    (m : MeasurableSpace Ω) (hm : m ≤ mΩ) {f : Ω → ℝ} {C : ℝ}
    (hf : Integrable f P)
    (hset :
      ∀ s : Set Ω, @MeasurableSet Ω m s →
        ∫ ω in s, f ω ∂P ≤ C * P.real s) :
    P[f | m] ≤ᵐ[P] fun _ => C := by
