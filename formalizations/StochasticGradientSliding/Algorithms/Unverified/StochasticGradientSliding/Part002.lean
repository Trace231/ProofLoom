    -β * spsP ι * bregmanFormulaOnX S prev next +
        (S.mGrowth + dualNorm S δ) * S.primalNorm (next.1 - prev.1)
        = -(β * spsP ι) * bregmanFormulaOnX S prev next +
            (S.mGrowth + dualNorm S δ) * S.primalNorm (next.1 - prev.1) := by
          ring
      _ ≤ (S.mGrowth + dualNorm S δ) ^ 2 / (2 * (β * spsP ι)) := hyoung
      _ = (S.mGrowth + dualNorm S δ) ^ 2 / (2 * β * spsP ι) := by
            ring

/-- One-step feasible-domain Phi recurrence used in the formula-extension
Proposition 8.3 telescope.

Aligns with Lan Proposition 8.3 proof lines 29580-29606. Candidate audit:
`sps_source_one_step_phi_bound` is the source-domain analogue, but it is typed
over `SPSSourceState` and `bregmanOn`; SOptLib accelerated recurrence helpers
package related two-Bregman algebra but not the paper's SPS stochastic
`h`-growth and `dualNorm` displacement absorption. This helper consumes the
formula-extension two-Bregman descent and absorption facts proved above. -/
theorem sps_formula_one_step_phi_bound
    (g : E → ℝ) (hg : IsAffineModel g) (x : FeasiblePoint S) (β : ℝ)
    (sample : ℕ → Ω → Sample) (states : ℕ → Ω → SPSState S)
    (hprocess : IsSPSProcess S g x β sample states)
    (n : ℕ) (ω : Ω) (u : FeasiblePoint S) :
    let ι : PositiveTime := ⟨n + 1, Nat.succ_pos n⟩;
    let δ := oracleNoiseAt S ((states n ω).u.1) (sample n ω);
    let next : FeasiblePoint S := (states (n + 1) ω).u;
      spsPhiFormulaOnX S g x β next - spsPhiFormulaOnX S g x β u ≤
        β * spsP ι * bregmanFormulaOnX S (states n ω).u u -
          β * (1 + spsP ι) * bregmanFormulaOnX S (states (n + 1) ω).u u +
          ((S.mGrowth + dualNorm S δ) ^ 2) / (2 * β * spsP ι) +
          ⟪δ, u.1 - (states n ω).u.1⟫_ℝ := by
  classical
  let ι : PositiveTime := ⟨n + 1, Nat.succ_pos n⟩
  let prev : FeasiblePoint S := (states n ω).u
  let next : FeasiblePoint S := (states (n + 1) ω).u
  let q : E := S.oracle prev.1 (sample n ω)
  let δ : E := oracleNoiseAt S prev.1 (sample n ω)
  let r : ℝ := S.primalNorm (next.1 - prev.1)
  have hβpos : 0 < β := hprocess.1
  have hq_decomp : q = S.hSubgradient prev.1 + δ := by
    simp [q, δ, oracleNoiseAt]
  have hprevX : prev.1 ∈ S.X := prev.2
  have hnextX : next.1 ∈ S.X := next.2
  have hgrowth :
      S.h next.1 ≤
        S.h prev.1 + ⟪q, next.1⟫_ℝ - ⟪q, prev.1⟫_ℝ -
          ⟪δ, next.1 - prev.1⟫_ℝ + S.mGrowth * r := by
    have hgrowth0 :=
      S.nonsmooth_growth (x := next.1) (y := prev.1) hnextX hprevX
    calc
      S.h next.1
          ≤ S.h prev.1 + ⟪S.hSubgradient prev.1, next.1 - prev.1⟫_ℝ +
              S.mGrowth * r := by
            simpa [r] using hgrowth0
      _ = S.h prev.1 + ⟪q, next.1⟫_ℝ - ⟪q, prev.1⟫_ℝ -
              ⟪δ, next.1 - prev.1⟫_ℝ + S.mGrowth * r := by
            rw [hq_decomp]
            simp [inner_add_left, inner_sub_right]
            ring
  have hsub_le :
      S.h prev.1 + ⟪q, u.1⟫_ℝ - ⟪q, prev.1⟫_ℝ ≤
        S.h u.1 + ⟪δ, u.1 - prev.1⟫_ℝ := by
    have hmem := (setup_hSubgradientMem S) prev.1 hprevX
    have hsupport :=
      (SOptLib.mem_carrierSubdifferential_iff.mp hmem) ⟨u.1, u.2⟩
    calc
      S.h prev.1 + ⟪q, u.1⟫_ℝ - ⟪q, prev.1⟫_ℝ
          = S.h prev.1 + ⟪q, u.1 - prev.1⟫_ℝ := by
              simp [inner_sub_right]
              ring
      _ = S.h prev.1 + ⟪S.hSubgradient prev.1, u.1 - prev.1⟫_ℝ +
            ⟪δ, u.1 - prev.1⟫_ℝ := by
              rw [hq_decomp]
              simp [inner_add_left]
              ring
      _ ≤ S.h u.1 + ⟪δ, u.1 - prev.1⟫_ℝ := by
              nlinarith [hsupport]
  have hnoise_step :
      -⟪δ, next.1 - prev.1⟫_ℝ ≤ dualNorm S δ * r := by
    have hneg_abs : -⟪δ, next.1 - prev.1⟫_ℝ ≤
        |⟪δ, next.1 - prev.1⟫_ℝ| := neg_le_abs _
    have hdual :=
      abs_inner_le_dualNorm_mul_primalNorm S δ (next.1 - prev.1)
    exact hneg_abs.trans (by simpa [r] using hdual)
  have hdescent0 :=
    sps_step_two_bregman_descent S g hg x β sample states hprocess n ω u
  have hdescent :
      (g next.1 + ⟪q, next.1⟫_ℝ + S.chi next.1) +
          β * bregmanFormulaOnX S x next ≤
        (g u.1 + ⟪q, u.1⟫_ℝ + S.chi u.1) +
          β * bregmanFormulaOnX S x u +
          β * spsP ι * bregmanFormulaOnX S prev u -
            (β + β * spsP ι) * bregmanFormulaOnX S next u -
            β * spsP ι * bregmanFormulaOnX S prev next := by
    have hdescent1 :
        (g next.1 + ⟪q, next.1⟫_ℝ + S.chi next.1) +
            β * bregmanFormulaOnX S x next +
            β * spsP ι * bregmanFormulaOnX S prev next ≤
          (g u.1 + ⟪q, u.1⟫_ℝ + S.chi u.1) +
            β * bregmanFormulaOnX S x u +
            β * spsP ι * bregmanFormulaOnX S prev u -
              (β + β * spsP ι) * bregmanFormulaOnX S next u := by
      simpa [ι, prev, next, q, add_assoc, add_left_comm, add_comm] using
        hdescent0
    nlinarith
  have hraw :
      spsPhiFormulaOnX S g x β next - spsPhiFormulaOnX S g x β u ≤
        β * spsP ι * bregmanFormulaOnX S prev u -
          (β + β * spsP ι) * bregmanFormulaOnX S next u -
          β * spsP ι * bregmanFormulaOnX S prev next +
          ⟪δ, u.1 - prev.1⟫_ℝ +
          (S.mGrowth + dualNorm S δ) * r := by
    unfold spsPhiFormulaOnX spsPhi
    nlinarith [hdescent, hgrowth, hsub_le, hnoise_step]
  have habsorb :=
    sps_formula_displacement_absorption S β ι prev next δ hβpos
  have habsorb' :
      -β * spsP ι * bregmanFormulaOnX S prev next +
          (S.mGrowth + dualNorm S δ) * r ≤
        (S.mGrowth + dualNorm S δ) ^ 2 / (2 * β * spsP ι) := by
    simpa [r] using habsorb
  have hraw' :
      spsPhiFormulaOnX S g x β next - spsPhiFormulaOnX S g x β u ≤
        β * spsP ι * bregmanFormulaOnX S prev u -
          β * (1 + spsP ι) * bregmanFormulaOnX S next u -
          β * spsP ι * bregmanFormulaOnX S prev next +
          ⟪δ, u.1 - prev.1⟫_ℝ +
          (S.mGrowth + dualNorm S δ) * r := by
    nlinarith [hraw]
  have hfinal :
      spsPhiFormulaOnX S g x β next - spsPhiFormulaOnX S g x β u ≤
        β * spsP ι * bregmanFormulaOnX S prev u -
          β * (1 + spsP ι) * bregmanFormulaOnX S next u +
          ((S.mGrowth + dualNorm S δ) ^ 2) / (2 * β * spsP ι) +
          ⟪δ, u.1 - prev.1⟫_ℝ := by
    nlinarith [hraw', habsorb']
  simpa [ι, prev, next, δ, add_assoc, add_left_comm, add_comm] using hfinal

