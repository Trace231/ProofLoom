            let ι : PositiveTime := ⟨i + 1, Nat.succ_pos i⟩;
            let δ := oracleNoiseAt S ((inner κ i ω).u.1) (law.sample κ i ω);
            ((S.mGrowth ^ 2 + dualNorm S δ ^ 2) / (beta κ * spsP ι) +
