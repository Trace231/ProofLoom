theorem inverse_linear_add_linear_at_clipped_sqrt_le
    {A B noise T cap alpha : Real}
    (hA : 0 < A) (hB : 0 < B) (hnoise : 0 < noise)
    (hT : 0 < T) (hcap : 0 < cap)
