    (hq_nonneg : 0 ≤ q) (hq_ne_one : q ≠ 1) (ht : 1 ≤ t)
    (hinitial : q * m0 ≤ m 1)
    (hstep : ∀ n, 1 ≤ n → n < t → q * m n + b ≤ m (n + 1)) :
