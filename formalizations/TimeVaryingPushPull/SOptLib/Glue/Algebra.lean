    {ι κ : Type*} [Fintype ι] [Fintype κ] [DecidableEq ι]
    (u : ι → κ → R) (x y : ι → R)
    (horth : ∀ a a' : ι, ∑ k : κ, u a k * u a' k = if a = a' then 1 else 0) :
    ∑ k : κ, (∑ a : ι, u a k * x a) * (∑ a' : ι, u a' k * y a') =
