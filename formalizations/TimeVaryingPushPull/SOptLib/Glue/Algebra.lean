    rw [halpha_min]
    rcases le_total cap beta with hle | hle
    · rw [min_eq_left hle]
      linarith [(one_div_pos).2 hbeta_pos]
    · rw [min_eq_right hle]
      linarith [(one_div_pos).2 hcap]
