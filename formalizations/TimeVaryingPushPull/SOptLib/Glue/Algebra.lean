    calc
      M⁻¹ * Q = ((M + P)⁻¹ * (M + P)) * (M⁻¹ * Q) := by
        rw [Matrix.nonsing_inv_mul (M + P) hshiftUnit]
        simp
      _ = (M + P)⁻¹ * ((M + P) * (M⁻¹ * Q)) := by
        rw [Matrix.mul_assoc]
      _ = (M + P)⁻¹ * Q := by rw [hshifted_mul]
  have hdecomp : M⁻¹ - a⁻¹ • P = M⁻¹ * Q := by
    calc
      M⁻¹ - a⁻¹ • P = M⁻¹ - M⁻¹ * P := by rw [hleft_pole]
      _ = M⁻¹ * (1 - P) := by rw [mul_sub, Matrix.mul_one]
      _ = M⁻¹ * Q := rfl
  simpa [Q] using hdecomp.trans hshift

