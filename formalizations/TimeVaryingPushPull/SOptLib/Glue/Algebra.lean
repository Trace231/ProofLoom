    rw [hone_minus]
    field_simp [hm_ne, hD_ne]
    dsimp [D]
    ring
  have heta_eq : a / (1 - a) * mu = a * D * mu := by
    rw [hone_minus]
    field_simp [hD_ne]
  have haD_eq : a * D = D - 1 := by
    have ha_eq' : a = 1 - D⁻¹ := by linarith [hone_minus]
    rw [ha_eq']
    field_simp [hD_ne]
