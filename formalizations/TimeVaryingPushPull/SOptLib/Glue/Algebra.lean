        alpha ^ 2 * dD * L ^ 2 * D + alpha ^ 2 * dQL * L ^ 2 * Q := by
    calc
      D ≤ kappa * Q + alpha ^ 2 *
          (UD + dD * L ^ 2 * D + dQL * L ^ 2 * Q) := hrawD
      _ = kappa * Q + alpha ^ 2 * UD +
