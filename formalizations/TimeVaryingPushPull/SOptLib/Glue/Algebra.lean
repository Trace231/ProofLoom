      have hxy_val : p (x : V) = p (y : V) := by
        exact congrArg (fun z : LinearMap.range p => (z : V)) hxy
      simp [v, map_sub, hxy_val]
    have hvq : q v = v := by
      exact hfix_q (show v ∈ LinearMap.range q from
