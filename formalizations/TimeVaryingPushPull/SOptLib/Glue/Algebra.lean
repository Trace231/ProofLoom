          (hstep k hk ((Nat.lt_succ_self k).trans_le hkt))
      calc
        q ^ (k + 1) * m0 + b * (1 - q ^ (k + 1 - 1)) / (1 - q) =
            q * (q ^ k * m0 + b * (1 - q ^ (k - 1)) / (1 - q)) + b := by
