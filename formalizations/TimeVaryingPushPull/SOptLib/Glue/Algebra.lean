      B * beta * noise ^ 2 = noise * Real.sqrt (A * B / T) := by
    have hleft : 0 ≤ B * beta * noise ^ 2 := by positivity
    have hright : 0 ≤ noise * Real.sqrt (A * B / T) := by positivity
