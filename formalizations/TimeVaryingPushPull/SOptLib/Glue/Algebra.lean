      intro r hr
      rcases Finset.mem_image.mp hr with ⟨i, hi, hir⟩
      have hi' : i ∈ Finset.Icc 2 j := hi
      have hij : i ≤ j := (Finset.mem_Icc.mp hi').2
      have hji : j ∈ Finset.Icc 1 T ∧ P j := (hactive j).mp hj
