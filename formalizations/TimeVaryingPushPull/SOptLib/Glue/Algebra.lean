theorem min_one_clamp_pos_quadratic_le
    {R : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]
    {den q a : R} (hden : 0 < den) (ha : a ∈ Set.Icc (0 : R) 1) :
    (den / 2) * (min 1 q) ^ 2 - den * q * (min 1 q) ≤
      (den / 2) * a ^ 2 - den * q * a := by
