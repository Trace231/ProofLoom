        ∫ s, ((innerSL ℝ) d) (φ s) ∂ν := by
          rfl
    _ = ((innerSL ℝ) d) (∫ s, φ s ∂ν) := hlin
    _ = ⟪d, target x - target y⟫_ℝ := by
      simp [hφ_mean]



