      P.map (fun ω => (query ω, sample ω)) = (P.map query).prod ν := by
    rw [(indepFun_iff_map_prod_eq_prod_map_map hquery.aemeasurable
      hsample.aemeasurable).mp hindep, hdist]
  have h_int_prod : Integrable oracleScalar ((P.map query).prod ν) := by
    have h_on_joint :
        Integrable oracleScalar (P.map (fun ω => (query ω, sample ω))) :=
      (integrable_map_measure h_oracle_meas.aestronglyMeasurable h_joint_meas).mpr
        (by simpa [oracleScalar, query] using horacle_int)
