theorem random_pair_oracle_difference_second_moment_le_of_indep
    {Ω S Z E : Type*} [MeasurableSpace Ω] [MeasurableSpace S] [MeasurableSpace Z]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    {P : Measure Ω} {ν : Measure S} [IsProbabilityMeasure P] [IsProbabilityMeasure ν]
    (Y : Ω → S) (Zpair : Ω → Z × Z) (G : Z → S → E)
    (feasible : Set (Z × Z)) (dist : Z → Z → ℝ) (L : ℝ)
    (hGdiff_meas : Measurable (fun p : (Z × Z) × S => G p.1.1 p.2 - G p.1.2 p.2))
    (hbudget_meas : Measurable (fun z : Z × Z => L ^ 2 * dist z.1 z.2 ^ 2))
    (hdist_sq_meas : Measurable (fun z : Z × Z => dist z.1 z.2 ^ 2))
    (hZpair_meas : Measurable Zpair) (hY_meas : Measurable Y)
    (h_indep : IndepFun Zpair Y P)
    (h_dist_law : Measure.map Y P = ν)
    (hZpair_mem : ∀ᵐ z ∂Measure.map Zpair P, z ∈ feasible)
    (hdist_sq_int : Integrable (fun ω => dist (Zpair ω).1 (Zpair ω).2 ^ 2) P)
    (hfixed_int :
      ∀ z : Z × Z, z ∈ feasible →
        Integrable (fun s => ‖G z.1 s - G z.2 s‖ ^ 2) ν)
    (hfixed_bound :
      ∀ z : Z × Z, z ∈ feasible →
        ∫ s, ‖G z.1 s - G z.2 s‖ ^ 2 ∂ν ≤ L ^ 2 * dist z.1 z.2 ^ 2) :
    Integrable (fun ω => ‖G (Zpair ω).1 (Y ω) - G (Zpair ω).2 (Y ω)‖ ^ 2) P ∧
      ∫ ω, ‖G (Zpair ω).1 (Y ω) - G (Zpair ω).2 (Y ω)‖ ^ 2 ∂P ≤
        L ^ 2 * ∫ ω, dist (Zpair ω).1 (Zpair ω).2 ^ 2 ∂P := by
  classical
  let moment : Z × Z → S → ℝ := fun z s => ‖G z.1 s - G z.2 s‖ ^ 2
  have hmoment_meas : Measurable (Function.uncurry moment) := by
    simpa [moment, Function.uncurry] using hGdiff_meas.norm.pow_const 2
  have h_joint_meas : AEMeasurable (fun ω => (Zpair ω, Y ω)) P :=
    (hZpair_meas.prodMk hY_meas).aemeasurable
  have h_prod_eq :
      P.map (fun ω => (Zpair ω, Y ω)) = (P.map Zpair).prod ν := by
    rw [(indepFun_iff_map_prod_eq_prod_map_map hZpair_meas.aemeasurable
      hY_meas.aemeasurable).mp h_indep, h_dist_law]
  haveI : IsProbabilityMeasure (P.map Zpair) :=
    Measure.isProbabilityMeasure_map hZpair_meas.aemeasurable
  have hbudget_int :
      Integrable (fun z : Z × Z => L ^ 2 * dist z.1 z.2 ^ 2) (P.map Zpair) :=
    (integrable_map_measure hbudget_meas.aestronglyMeasurable
      hZpair_meas.aemeasurable).mpr (hdist_sq_int.const_mul (L ^ 2))
  have h_int :
      Integrable (fun ω => moment (Zpair ω) (Y ω)) P := by
    suffices h_prod :
        Integrable (Function.uncurry moment) ((P.map Zpair).prod ν) by
      have h_on_map :
          Integrable (Function.uncurry moment)
            (P.map (fun ω => (Zpair ω, Y ω))) :=
        h_prod_eq ▸ h_prod
      exact (integrable_map_measure hmoment_meas.aestronglyMeasurable h_joint_meas).mp
        h_on_map
    rw [integrable_prod_iff hmoment_meas.aestronglyMeasurable]
    refine ⟨hZpair_mem.mono (fun z hz => hfixed_int z hz), ?_⟩
    refine Integrable.mono hbudget_int
      ((hmoment_meas.norm.stronglyMeasurable.integral_prod_right').aestronglyMeasurable)
      (hZpair_mem.mono fun z hz => ?_)
    have h_eq :
        (∫ y, ‖Function.uncurry moment (z, y)‖ ∂ν) = ∫ s, moment z s ∂ν := by
      refine integral_congr_ae (Filter.Eventually.of_forall ?_)
      intro s
      have hnon : 0 ≤ Function.uncurry moment (z, s) := by
        simp [moment, Function.uncurry]
      exact Real.norm_of_nonneg hnon
    have h_nonneg : 0 ≤ ∫ s, moment z s ∂ν :=
      integral_nonneg fun s => sq_nonneg _
    have h_rhs_nonneg : 0 ≤ L ^ 2 * dist z.1 z.2 ^ 2 := by positivity
    rw [h_eq, Real.norm_eq_abs, abs_of_nonneg h_nonneg,
      Real.norm_eq_abs, abs_of_nonneg h_rhs_nonneg]
    simpa [moment] using hfixed_bound z hz
  have h_int_prod :
      Integrable (Function.uncurry moment) ((P.map Zpair).prod ν) := by
    have h_on_map :
        Integrable (Function.uncurry moment)
          (P.map (fun ω => (Zpair ω, Y ω))) :=
      (integrable_map_measure hmoment_meas.aestronglyMeasurable h_joint_meas).mpr h_int
    exact h_prod_eq ▸ h_on_map
  refine ⟨by simpa [moment] using h_int, ?_⟩
  calc
    ∫ ω, ‖G (Zpair ω).1 (Y ω) - G (Zpair ω).2 (Y ω)‖ ^ 2 ∂P
        = ∫ p : (Z × Z) × S, Function.uncurry moment p
            ∂P.map (fun ω => (Zpair ω, Y ω)) := by
          exact (integral_map h_joint_meas hmoment_meas.aestronglyMeasurable).symm
    _ = ∫ p : (Z × Z) × S, Function.uncurry moment p ∂(P.map Zpair).prod ν := by
          rw [h_prod_eq]
    _ = ∫ z : Z × Z, ∫ s : S, moment z s ∂ν ∂P.map Zpair := by
          simpa [Function.uncurry] using integral_prod (Function.uncurry moment) h_int_prod
    _ ≤ ∫ z : Z × Z, L ^ 2 * dist z.1 z.2 ^ 2 ∂P.map Zpair := by
          exact integral_mono_ae h_int_prod.integral_prod_left hbudget_int
            (hZpair_mem.mono fun z hz => hfixed_bound z hz)
    _ = L ^ 2 * ∫ z : Z × Z, dist z.1 z.2 ^ 2 ∂P.map Zpair := by
          rw [integral_const_mul]
    _ = L ^ 2 * ∫ ω, dist (Zpair ω).1 (Zpair ω).2 ^ 2 ∂P := by
          rw [integral_map hZpair_meas.aemeasurable hdist_sq_meas.aestronglyMeasurable]



