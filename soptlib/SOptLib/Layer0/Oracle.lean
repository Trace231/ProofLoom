theorem oracle_scalar_deviation_kernel_measurable_of_finite_dispatch
    {ι X S : Type*} [Fintype ι] [DecidableEq ι] [MeasurableSpace ι]
    [MeasurableSingletonClass ι] [MeasurableSpace X] [MeasurableSpace S]
    {Block : ι → Type*}
    [∀ i, NormedAddCommGroup (Block i)] [∀ i, InnerProductSpace ℝ (Block i)]
    [∀ i, MeasurableSpace (Block i)] [∀ i, BorelSpace (Block i)]
    [MeasurableSpace (PiLp 2 Block)] [BorelSpace (PiLp 2 Block)]
    [OpensMeasurableSpace (PiLp 2 Block × PiLp 2 Block)]
    [MeasurableSub₂ (PiLp 2 Block)]
    (grad : X → S → PiLp 2 Block) (mean eval : X → PiLp 2 Block)
    (weight : ι → ℝ) (target : PiLp 2 Block)
    (hgrad : Measurable (fun p : X × S => grad p.1 p.2))
    (hmean : Measurable mean) (heval : Measurable eval) :
    Measurable
      (fun p : X × (S × ι) =>
        ⟪weight p.2.2 •
            PiLp.single 2 p.2.2
              ((PiLp.proj (𝕜 := ℝ) 2 (fun i : ι => Block i) p.2.2) (grad p.1 p.2.1)) -
            mean p.1,
          target - eval p.1⟫_ℝ) := by
