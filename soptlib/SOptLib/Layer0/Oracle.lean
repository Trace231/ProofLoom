    ?hidx ?hf
  · exact measurable_snd.snd
  · intro i
    have hraw :
        Measurable (fun p : X × (S × ι) => grad p.1 p.2.1) :=
      hgrad.comp (measurable_fst.prodMk measurable_snd.fst)
    have hcoord :
        Measurable
          (fun p : X × (S × ι) =>
            (PiLp.proj (𝕜 := ℝ) 2 (fun i : ι => Block i) i) (grad p.1 p.2.1)) :=
      (PiLp.proj (𝕜 := ℝ) 2 (fun i : ι => Block i) i).continuous.measurable.comp hraw
    have hsingle_cont :
        Continuous (fun u : Block i => PiLp.single 2 i u) := by
      rw [Metric.continuous_iff]
      intro u ε hε
      refine ⟨ε, hε, ?_⟩
      intro v hv
      have hnorm : ‖PiLp.single 2 i v - PiLp.single 2 i u‖ = ‖v - u‖ := by
        simp [← PiLp.single_sub, PiLp.norm_single]
      simpa [dist_eq_norm, hnorm] using hv
    have hsampled :
        Measurable
          (fun p : X × (S × ι) =>
            weight i •
              PiLp.single 2 i
                ((PiLp.proj (𝕜 := ℝ) 2 (fun i : ι => Block i) i) (grad p.1 p.2.1))) :=
      (hsingle_cont.measurable.comp hcoord).const_smul (weight i)
    have hmean' : Measurable (fun p : X × (S × ι) => mean p.1) :=
      hmean.comp measurable_fst
    have hdev :
        Measurable
          (fun p : X × (S × ι) =>
            weight i •
              PiLp.single 2 i
                ((PiLp.proj (𝕜 := ℝ) 2 (fun i : ι => Block i) i) (grad p.1 p.2.1)) -
              mean p.1) :=
      hsampled.sub hmean'
    have hdisp :
        Measurable (fun p : X × (S × ι) => target - eval p.1) :=
      measurable_const.sub (heval.comp measurable_fst)
    exact continuous_inner.measurable.comp (hdev.prodMk hdisp)

